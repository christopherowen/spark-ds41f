+++ b/tests/tokenizers_/test_deepseek_v41.py
@@ -1456,3 +1456,53 @@ def test_none_text_in_content_blocks_and_tool_references():
         thinking_mode="chat",
     )
     assert "ok" in rendered
+def test_completed_tool_turns_without_reasoning_avoid_empty_think_blocks():
+    tools = [
+        {
+            "type": "function",
+            "function": {
+                "name": "bash",
+                "description": "Run a shell command",
+                "parameters": {
+                    "type": "object",
+                    "properties": {"command": {"type": "string"}},
+                    "required": ["command"],
+                },
+            },
+        }
+    ]
+    messages = [
+        {"role": "user", "content": "Run checks."},
+        {
+            "role": "assistant",
+            "content": "Checking.\n\n",
+            "tool_calls": [
+                {
+                    "id": "c1",
+                    "type": "function",
+                    "function": {"name": "bash", "arguments": '{"command":"ls"}'},
+                }
+            ],
+        },
+        {"role": "tool", "tool_call_id": "c1", "content": "src"},
+        {
+            "role": "assistant",
+            "reasoning": None,
+            "reasoning_content": "Inspect src.",
+            "content": "Listing src.\n\n",
+            "tool_calls": [
+                {
+                    "id": "c2",
+                    "type": "function",
+                    "function": {"name": "bash", "arguments": '{"command":"ls src"}'},
+                }
+            ],
+        },
+        {"role": "tool", "tool_call_id": "c2", "content": "index.ts"},
+    ]
+    prompt = render(messages, tools=tools, add_generation_prompt=True)
+    assert "<think></think>" not in prompt
+    assert "<｜Assistant｜></think>Checking.\n\n<｜DSML｜ calls>" in prompt
+    assert "<｜Assistant｜><think>Inspect src.</think>Listing src.\n\n<｜DSML｜ calls>" in prompt
+    assert "\n\n\n\n<｜DSML｜ calls>" not in prompt
+    assert prompt.endswith("<｜Assistant｜><think>")
