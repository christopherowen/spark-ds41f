diff --git a/vllm/tokenizers/deepseek_v41_encoding.py b/vllm/tokenizers/deepseek_v41_encoding.py
index a5ea571db6..4193aeec3a 100644
--- a/vllm/tokenizers/deepseek_v41_encoding.py
+++ b/vllm/tokenizers/deepseek_v41_encoding.py
@@ -572,6 +572,28 @@ def find_last_user_index(messages: List[Dict[str, Any]]) -> int:
     return last_user_index
 
 
+def _assistant_opens_thinking(msg: Dict[str, Any]) -> bool:
+    """Whether an assistant turn renders `<think>{rc}</think>` vs `</think>`.
+
+    Completed assistant messages (`not wo_eos`) without `reasoning_content`
+    render `<｜Assistant｜></think>` like dropped-thinking history turns rather
+    than empty `<｜Assistant｜><think></think>`, while preserving `wo_eos`
+    prefix continuations.
+    """
+    return bool(msg.get("reasoning_content")) or bool(msg.get("wo_eos"))
+
+
+def _next_turn_opens_thinking(index: int, messages: List[Dict[str, Any]]) -> bool:
+    for follow_idx in range(index + 1, len(messages)):
+        follow_role = messages[follow_idx].get("role")
+        if follow_role == "latest_reminder":
+            continue
+        if follow_role == "assistant":
+            return _assistant_opens_thinking(messages[follow_idx])
+        return True
+    return True
+
+
 def render_message(
     index: int,
     messages: List[Dict[str, Any]],
@@ -708,18 +730,24 @@ def render_message(
             )
 
         summary_content = content or ""
+        if tool_calls and summary_content.endswith("\n\n"):
+            summary_content = summary_content[:-2]
         rc = reasoning_content or ""
 
         # Check if previous message has a task - if so, this is a task output (no thinking)
         prev_has_task = index - 1 >= 0 and messages[index - 1].get("task") is not None
 
-        if thinking_mode == "thinking" and not prev_has_task:
-            if not drop_thinking or index > last_user_idx:
-                thinking_part = (
-                    thinking_template.format(reasoning_content=rc) + thinking_end_token
-                )
-            else:
-                thinking_part = ""
+        if (
+            thinking_mode == "thinking"
+            and not prev_has_task
+            and (not drop_thinking or index > last_user_idx)
+            and _assistant_opens_thinking(messages[index])
+        ):
+            thinking_part = (
+                thinking_template.format(reasoning_content=rc) + thinking_end_token
+            )
+        else:
+            thinking_part = ""
 
         if wo_eos:
             prompt += assistant_msg_wo_eos_template.format(
@@ -768,9 +796,11 @@ def render_message(
         # Normal generation: append Assistant + thinking token
         # (mid-conversation system messages also trigger the assistant header)
         prompt += ASSISTANT_SP_TOKEN
-        if not drop_thinking and thinking_mode == "thinking":
-            prompt += thinking_start_token
-        elif drop_thinking and thinking_mode == "thinking" and index >= last_user_idx:
+        if (
+            thinking_mode == "thinking"
+            and (not drop_thinking or index >= last_user_idx)
+            and _next_turn_opens_thinking(index, messages)
+        ):
             prompt += thinking_start_token
         else:
             prompt += thinking_end_token
