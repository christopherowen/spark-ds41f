{
  "notes": "Round 2 pp2-tp2-ring: VLLM_PP_FAST_P2P=1 + async zero-sync PP adaptive verification (rc=0.045, tau=0.2, engine reqs) + sink rejection",
  "extends": {
    "config": "experiments/2026-10-26-spark-ds41f-candidate/candidate-70/pp2-tp2-ring.json"
  },
  "set": {
    "speculative": {
      "enable_adaptive_verification": true,
      "adaptive_verification_row_cost": 0.045
    },
    "container": {
      "mounts": [
        [
          "{checkout}/cache",
          "/cache",
          "rw"
        ],
        [
          "{checkout}/experiments/2026-11-23-tp1-tp2-pp2-round2/overlays/adaptive_verification.py",
          "/opt/spark-ds41f/candidate/vllm/vllm/v1/worker/gpu/spec_decode/adaptive_verification.py",
          "ro"
        ],
        [
          "{checkout}/experiments/2026-11-23-tp1-tp2-pp2-round2/overlays/gpu_worker.py",
          "/opt/spark-ds41f/candidate/vllm/vllm/v1/worker/gpu_worker.py",
          "ro"
        ],
        [
          "{checkout}/experiments/2026-11-23-tp1-tp2-pp2-round2/overlays/model_runner.py",
          "/opt/spark-ds41f/candidate/vllm/vllm/v1/worker/gpu/model_runner.py",
          "ro"
        ]
      ]
    },
    "environment": {
      "VLLM_PP_FAST_P2P": "1",
      "VLLM_SINK_REJECTION": "1",
      "SPARK_DS41F_DSPARK_DEAD_ROWS_TAU": "0.2",
      "SPARK_DS41F_PP_USE_ENGINE_REQS": "1"
    },
    "deployment": {
      "branch": "tp1-tp2-pp2-round2"
    }
  },
  "serve_options": {
    "--speculative-config": "{\"method\":\"dspark\",\"num_speculative_tokens\":5,\"draft_tensor_parallel_size\":2,\"attention_backend\":\"TILELANG\",\"draft_sample_method\":\"greedy\",\"rejection_sample_method\":\"block\",\"enable_adaptive_verification\":true,\"adaptive_verification_row_cost\":0.045}"
  }
}
