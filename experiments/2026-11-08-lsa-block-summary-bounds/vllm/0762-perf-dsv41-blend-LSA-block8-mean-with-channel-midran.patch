From 6a90f17c111b7d0bf45b3650e3f8bc77065f2a5f Mon Sep 17 00:00:00 2001
From: Christopher Owen <christopherowen@users.noreply.github.com>
Date: Sun, 8 Nov 2026 23:38:48 +0000
Subject: [PATCH] perf(dsv41): blend LSA block8 mean with channel midrange for
 needle recall

Blend the 8-key arithmetic mean in summarize_blocks with the per-channel
midrange (0.75 * mean + 0.25 * 0.5 * (max + min) = 3/32 * sum + 1/8 * (max + min))
using three scalar float32 local accumulators per (group, lane) thread.

Why:
- Under pure 1/8 block averaging (0741), an isolated 1-token needle key inside an
  8-key block is diluted by 1/8 and subject to pre-ReLU sign cancellation across
  neighboring RoPE-rotated keys before QueryReusePlan.prepared_scores applies
  T.max(..., 0.).
- Reweighting the per-channel block summary to 3/32 on interior tokens and 7/32 on
  the per-channel min and max (dyadic weights 0.09375 and 0.125) preserves a single
  128 x BF16 summary per 8-key block (STATE_BYTES = 100) and leaves prepared_scores
  (single T.gemm) unchanged, while cancelling zero-mean symmetric oscillations and
  boosting isolated needle amplitude by 1.75x.
- Accumulating acc, hi, and lo as scalar local registers inside the parallel
  (group, lane) loop reduces live float32 accumulator registers per thread from 8
  to 3 and preserves or improves summarize_blocks kernel latency at page=128 and
  page=256.

Upstream-base: 19f2c20ed4d64ae22bd009ceacadd85e2a81e354
Quality: default-off path (VLLM_DS41_LSA=0/unset) is 100% unchanged; opt-in
VLLM_DS41_LSA=1 improves 1-token needle recall by +9.3% to +17.1% at 32K-128K
dense (budget=64) and +1.6% to +3.9% at 64K-256K source (budget=512..1024),
and improves top-64, top-512, top-2048, score-weighted, and softmax-mass recall
across 32K-256K with zero scoring overhead.
Tests: pytest -v -p tests.kernels.deepseek_v41_pdl_sources
tests/models/test_deepseek_v4_1_lsa.py
tests/models/test_deepseek_v4_1_attention.py (74 passed across 2 container
boots) and 7 GPU correctness, sanitizer, and CUDA-graph determinism gates.
Upstream-status: local
---
 tests/models/test_deepseek_v4_1_lsa.py        | 135 +++++++++++++++++-
 .../deepseek_v4_1/tilelang/block_shortlist.py |  28 ++--
 2 files changed, 152 insertions(+), 11 deletions(-)

diff --git a/tests/models/test_deepseek_v4_1_lsa.py b/tests/models/test_deepseek_v4_1_lsa.py
index f78607017a..74ca05bc1c 100644
--- a/tests/models/test_deepseek_v4_1_lsa.py
+++ b/tests/models/test_deepseek_v4_1_lsa.py
@@ -685,8 +685,16 @@ def _decode_mxfp4_pages_reference(pool: torch.Tensor, page: int) -> torch.Tensor
     sign = torch.where((codes & 8) != 0, -1.0, 1.0)
     scale_f32 = torch.bitwise_left_shift(scales, 23).view(torch.float32)
     scale_expanded = scale_f32.repeat_interleave(32, dim=-1)
-    decoded = sign * lut[mag] * scale_expanded
-    return decoded.view(pages, page // 8, 8, 128).mean(dim=2).to(torch.bfloat16)
+    decoded = (sign * lut[mag] * scale_expanded).view(pages, page // 8, 8, 128)
+    acc = decoded[:, :, 0].clone()
+    hi = decoded[:, :, 0].clone()
+    lo = decoded[:, :, 0].clone()
+    for k in range(1, 8):
+        val = decoded[:, :, k]
+        acc = acc + val
+        hi = torch.maximum(hi, val)
+        lo = torch.minimum(lo, val)
+    return (acc * 0.09375 + (hi + lo) * 0.125).to(torch.bfloat16)
 
 
 @pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA required")
@@ -993,3 +1001,126 @@ def test_lsa_gpu_index_chunk_and_cudagraph_replay(
     graph.replay()
     torch.cuda.synchronize()
     assert torch.equal(out_lsa, eager_out)
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA required")
+def test_lsa_gpu_block_summary_needle_retention():
+    from vllm.models.deepseek_v4_1.tilelang.block_shortlist import (
+        STATE_BYTES,
+        summarize_blocks,
+    )
+    from vllm.models.deepseek_v4_1.tilelang.indexer import (
+        quantize_mxfp4,
+        write_index_keys,
+    )
+    from vllm.models.deepseek_v4_1.tilelang.query_reuse import QueryReusePlan
+
+    width, seq_len, page, budget = 32768, 16384, 128, 64
+    num_pages = seq_len // page
+    num_blocks = seq_len // 8
+    rows = 4
+    gen = torch.Generator(device="cuda").manual_seed(20261108)
+
+    direction = torch.randn((128,), generator=gen, device="cuda", dtype=torch.float32)
+    direction = direction / direction.norm()
+
+    # Coherent distractor blocks with mild correlation (0.38 < 3.5 needle key, but > 0.328 diluted mean)
+    keys_f32 = (
+        0.38 * direction.view(1, 1, 128)
+        + 0.15 * torch.randn((num_blocks, 8, 128), generator=gen, device="cuda")
+    )
+    # Inject 32 isolated 1-token needles in early blocks (surrounded by 7 counter-phase tokens)
+    needle_blocks = torch.arange(16, 48, device="cuda", dtype=torch.int64)
+    for b in needle_blocks.tolist():
+        keys_f32[b, :, :64] = -0.25 * direction[:64].unsqueeze(0)
+        keys_f32[b, 1:, 64:] = 0.0
+        keys_f32[b, 0] = 3.5 * direction
+
+    pool = torch.zeros(
+        (num_pages, page * STATE_BYTES), dtype=torch.uint8, device="cuda"
+    )
+    slots = torch.arange(seq_len, dtype=torch.int64, device="cuda")
+    write_index_keys(
+        keys_f32.view(seq_len, 128).to(torch.bfloat16), pool, slots, page
+    )
+
+    complete_slots = (
+        torch.arange(num_pages, dtype=torch.int64, device="cuda") * page + page - 1
+    )
+    summarize_blocks(page)(pool, pool.view(torch.bfloat16), complete_slots)
+
+    q_f32 = direction.view(1, 1, 128).expand(rows, 32, 128).contiguous()
+    q_mxfp4 = torch.empty((rows, 32, 64), dtype=torch.uint8, device="cuda")
+    q_scales_u8 = torch.empty((rows, 32, 4), dtype=torch.uint8, device="cuda")
+    quantize_mxfp4(
+        q_f32.view(rows * 32, 128).to(torch.bfloat16), q_mxfp4, q_scales_u8
+    )
+    q_scales = q_scales_u8.view(torch.float32).reshape(rows, 32)
+    weights = torch.full((rows, 32), 1.0 / 64.0, dtype=torch.bfloat16, device="cuda")
+    table = (
+        torch.arange(num_pages, dtype=torch.int32, device="cuda")
+        .unsqueeze(0)
+        .expand(rows, num_pages)
+        .contiguous()
+    )
+    pad_table = torch.full((rows, width // page), -1, dtype=torch.int32, device="cuda")
+    pad_table[:, :num_pages] = table
+    lengths = torch.full((rows,), seq_len, dtype=torch.int32, device="cuda")
+    active = torch.tensor([width], dtype=torch.int32, device="cuda")
+
+    plan = QueryReusePlan(width, page, candidate_blocks=False, budget=budget, row_cap=64)
+    scratch = [
+        torch.empty(sh, dtype=dt, device="cuda") for sh, dt in plan.scratch_specs(rows)
+    ]
+    out_blend = torch.full((rows, 512), -1, dtype=torch.int32, device="cuda")
+    plan.run(
+        q_mxfp4,
+        q_scales,
+        weights,
+        pool,
+        pad_table,
+        lengths,
+        active,
+        out=out_blend,
+        scratch=scratch,
+    )
+    blend_selected = set((out_blend[0] // 8).tolist())
+    blend_hits = sum(1 for b in needle_blocks.tolist() if b in blend_selected)
+
+    # Compare against uniform 8-key arithmetic mean on the same pool
+    lut = torch.tensor(
+        [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0], dtype=torch.float32, device="cuda"
+    )
+    raw_bytes = pool[:, : page * 64].view(num_pages, page, 64).to(torch.int32)
+    scales = pool[:, page * 64 : page * 68].view(num_pages, page, 4).to(torch.int32)
+    codes = torch.stack((raw_bytes & 15, (raw_bytes >> 4) & 15), dim=-1).view(
+        num_pages, page, 128
+    )
+    decoded = (
+        torch.where((codes & 8) != 0, -1.0, 1.0)
+        * lut[codes & 7]
+        * torch.bitwise_left_shift(scales, 23)
+        .view(torch.float32)
+        .repeat_interleave(32, dim=-1)
+    ).view(num_pages, page // 8, 8, 128)
+    pool.view(torch.bfloat16)[:, page * 68 // 2 : page * 100 // 2].view(
+        num_pages, page // 8, 128
+    ).copy_(decoded.mean(dim=2).to(torch.bfloat16))
+
+    out_mean = torch.full((rows, 512), -1, dtype=torch.int32, device="cuda")
+    plan.run(
+        q_mxfp4,
+        q_scales,
+        weights,
+        pool,
+        pad_table,
+        lengths,
+        active,
+        out=out_mean,
+        scratch=scratch,
+    )
+    mean_selected = set((out_mean[0] // 8).tolist())
+    mean_hits = sum(1 for b in needle_blocks.tolist() if b in mean_selected)
+
+    assert blend_hits == len(needle_blocks)
+    assert blend_hits > mean_hits
diff --git a/vllm/models/deepseek_v4_1/tilelang/block_shortlist.py b/vllm/models/deepseek_v4_1/tilelang/block_shortlist.py
index 9e65f0ff81..d04845bc20 100644
--- a/vllm/models/deepseek_v4_1/tilelang/block_shortlist.py
+++ b/vllm/models/deepseek_v4_1/tilelang/block_shortlist.py
@@ -29,19 +29,29 @@ def summarize_blocks(page: int, slot_dtype: str = 'int64'):
                Slots: T.Tensor([rows],slot_dtype)):
         with T.Kernel(rows,threads=512) as row:
             pdl.chain()
-            means = T.alloc_fragment([groups,32],T.float32)
+            acc = T.alloc_local([1],T.float32)
+            hi = T.alloc_local([1],T.float32)
+            lo = T.alloc_local([1],T.float32)
             slot = Slots[row]
             if (slot >= 0) & (slot%page == page-1) & (slot//page < pool_pages):
                 physical = slot//page
-                T.fill(means,0.)
-                for k in T.serial(8):
-                    for g,i in T.Parallel(groups,32):
-                        d = (g%4)*32+i
-                        token = (g//4)*8+k
-                        means[g,i] += decode(Pool[physical,token*64+d//2],
-                            Pool[physical,page*64+token*4+g%4],d)*.125
                 for g,i in T.Parallel(groups,32):
-                    Half[physical,page*68//2+g*32+i] = T.cast(means[g,i],T.bfloat16)
+                    d = (g%4)*32+i
+                    tok0 = (g//4)*8
+                    v0 = decode(Pool[physical,tok0*64+d//2],
+                        Pool[physical,page*64+tok0*4+g%4],d)
+                    acc[0] = v0
+                    hi[0] = v0
+                    lo[0] = v0
+                    for k in T.serial(1,8):
+                        token = tok0+k
+                        val = decode(Pool[physical,token*64+d//2],
+                            Pool[physical,page*64+token*4+g%4],d)
+                        acc[0] += val
+                        hi[0] = T.max(hi[0],val)
+                        lo[0] = T.min(lo[0],val)
+                    Half[physical,page*68//2+g*32+i] = T.cast(
+                        acc[0]*.09375+(hi[0]+lo[0])*.125,T.bfloat16)
     return update
 
 
