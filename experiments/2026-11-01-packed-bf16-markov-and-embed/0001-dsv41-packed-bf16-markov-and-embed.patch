+            T.copy(C_local, C_shared)
+            T.call_extern(
+                "handle",
+                f"vllm_vocab_tile_argmax<{block_M}, {block_N}, {threads}>",
+                T.address_of(C_shared[0, 0]),
+                T.address_of(partial_vals[0, 0]),
+                T.address_of(partial_idxs[0, 0]),
+                by,
+                bx,
+                M,
+                vocab,
+                num_tiles,
+                tx,
+            )
+
+    return vocab_bf16_markov_greedy_partials
