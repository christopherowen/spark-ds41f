+    assert out.index('.wait(') < out.index('bar.sync 15') < out.index('tl::tma_load')
     assert out.index('warpgroup_reg_dealloc') < out.index('bar.sync 15')
     assert iket._synchronize_vision_producers(VISION_PRODUCERS.replace(
-        'vision_swiglu_linear_kernel', 'other_kernel')) == VISION_PRODUCERS.replace(
-            'vision_swiglu_linear_kernel', 'other_kernel')
