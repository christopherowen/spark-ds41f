@@ -340,13 +340,38 @@ def test_vision_producer_barrier_refuses_conflicts_and_unknown_layout():
 
 def test_vision_attention_dynamic_producer_loop_rendezvous():
     code = VISION_PRODUCERS.replace(
-        "vision_swiglu_linear_kernel", "vision_attention_kernel"
+        "vision_linear_kernel", "vision_attention_kernel"
     ).replace("ko < 16", "ko < ((M + 63) >> 6)")
+    code = code.replace(
+        '        tl::tma_load(A_desc, mbarrier[(ko & 1)], A_shared, 0, 0);\n      }',
+        '        tl::tma_load(A_desc, mbarrier[(ko & 1)], A_shared, 0, 0);\n      }\n'
+        '      mbarrier[((ko & 1) + 6)].wait((((ko & 3) >> 1) ^ 1));\n'
+        '      if (tl::tl_shuffle_elect<128>()) {\n'
+        '        tl::tma_load(V_desc, mbarrier[(ko & 1)], V_shared, 0, 0);\n      }',
+    )
     out = iket._synchronize_vision_producers(code)
-    assert 'bar.sync 15, 128;' in out
+    assert out.count('bar.sync 15, 128;') == 2
+    assert out.index('bar.sync 15') < out.index('tl::tma_load(A_desc')
+    assert out.rindex('bar.sync 15') < out.index('tl::tma_load(V_desc')
     assert 'ko < ((M + 63) >> 6)' in out
 
 
+def test_swiglu_producers_rendezvous_after_all_three_input_waits():
+    code = VISION_PRODUCERS.replace(
+        "vision_linear_kernel", "vision_swiglu_linear_kernel"
+    )
+    for offset, desc in [(8, "G_desc"), (10, "U_desc")]:
+        extra = (
+            f'      mbarrier[((ko & 1) + {offset})].wait((((ko & 3) >> 1) ^ 1));\n'
+            '      if (tl::tl_shuffle_elect<128>()) {\n'
+            f'        tl::tma_load({desc}, mbarrier[0], W_shared, 0, 0);\n      }}\n'
+        )
+        code = code.replace('    }\n  } else', extra + '    }\n  } else')
+    out = iket._synchronize_vision_producers(code)
+    assert out.count('bar.sync 15, 128;') == 3
+    assert out.rindex('bar.sync 15') < out.index('tl::tma_load(U_desc')
+
+
 def test_module_without_kernels_is_unchanged():
     code = (
         "#include <tl_templates/cuda/copy.h>\n__device__ int f(int x) { return x; }\n"
