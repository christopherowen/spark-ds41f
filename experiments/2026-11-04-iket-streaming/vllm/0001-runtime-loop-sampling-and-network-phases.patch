+  roce_wait_peers(C);
+  roce_reduce_pack_f32(A, C);
+  roce_exchange_pack(A, C);
+  roce_tail(C);
+}
+"""
+    sites = iket.annotate(code, _token, iters=1)[1]
+    assert {s["range"] for s in sites} == {
+        "store.stage", "signal.proxy", "wait.flags", "compute.reduce",
