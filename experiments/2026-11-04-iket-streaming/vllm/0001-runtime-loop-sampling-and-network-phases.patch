+_RUNTIME_FOR = re.compile(
+    r"for\s*\(unsigned long long (__tl_iket_while_\d+) = 0;.*; "
+    r"\1 \+= \(\1 < (\d+)ULL\)\)", re.S
+)
+
+
+def _sample_runtime_loops(code: str, iters: int) -> str:
+    """Give while loops a saturating observation counter without changing their test."""
+    if not iters:
+        return code
+    changes = []
+
+    def visit(nodes):
+        for node in nodes:
+            if node.text.startswith("while"):
+                position = code.index(node.text, node.start, node.end)
+                test = node.text[node.text.index("(") + 1 : -1]
+                counter = f"__tl_iket_while_{len(changes)}"
+                header = (f"for (unsigned long long {counter} = 0; ({test}); "
+                          f"{counter} += ({counter} < {iters}ULL))")
+                changes.append((position, position + len(node.text), header))
+            visit(node.body or [])
+            visit(node.orelse or [])
+
+    for _, _, start, end in _kernels(code):
+        if not _CONDITIONAL.search(code, start, end):
+            visit(_Parser(code).block(start)[0])
+    for start, end, text in sorted(changes, reverse=True):
+        code = code[:start] + text + code[end:]
+    return code
+
+
 def _iterations(header: str, iters: int) -> str | None:
     """True in at most ``iters`` iterations of a TVM ``for`` loop (``for (int v =
     start; v < bound; ++v)``), each in the middle of its share of the loop, so one
     sample is the middle iteration, not the pipeline's fill; None for another header."""
+    runtime = _RUNTIME_FOR.fullmatch(header)
+    if runtime is not None:
+        return f"({runtime.group(1)} < {iters}ULL)"
     loop = _FOR.match(header)
     if loop is None:
         return None
@@ -520,7 +556,7 @@ def annotate(
     CTA, evenly spread across warp groups, record their ranges so trace stores do
     not contend across every warp of a CTA. With ``iters`` > 0 a range inside a
     ``for`` loop records in at most that many of its iterations, evenly spread
-    (a ``while`` loop has no variable to sample: its site lists it, unsampled):
+    (a ``while`` loop uses a saturating counter and records its first sampled iterations):
     run-iket reserves the run's largest warp record for every warp of every
     instrumented launch, so one long kernel sizes the whole run's buffer. With
     ``granularity="phase"``, consecutive waits and same-phase siblings separated
@@ -532,6 +568,7 @@ def annotate(
     preprocessor conditional in its body is left as it is."""
     if granularity not in _GRANULARITIES:
         raise ValueError(f"unknown IKET granularity: {granularity!r}")
+    code = _sample_runtime_loops(code, iters)
