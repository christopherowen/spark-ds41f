From 44b0dbde2430b11026ca8f4009d6d6f2471aed2f Mon Sep 17 00:00:00 2001
From: Christopher Owen <root@your.mom>
Date: Wed, 4 Nov 2026 03:51:26 +0100
Subject: [PATCH] [DS4.1] synchronize profiled vision TMA producers across
 reused barriers

Base: candidate-38 on upstream 19f2c20ed4d64ae22bd009ceacadd85e2a81e354, after the runtime-loop and flag-wait profiling fixes.

Rationale: all four generated producer warps wait on two reused TMA barriers, but only the elected first warp issues copies. Trace backpressure can leave another producer more than one generation behind; parity waits cannot recover that older phase. An isolated candidate-38 SwiGLU replay stopped in mbarrier_wait with only a non-copy producer warp active after the consumers exited. Rendezvous all 128 producers before each iteration, using unused named barrier 15, in these two known vision kernels only. Refuse conflicts and unfamiliar producer layouts.

Quality: profiling off is unchanged. Profiling on deliberately adds producer synchronization; use separate uninstrumented runs for performance timing. No arithmetic or transfer is removed.

Tests: 18 CPU phase-pass cases pass. GPU repeat-boot and full-workload validation is recorded in the deployment experiment. Upstream status: local experiment, not submitted.
---
 .../test_deepseek_v41_tilelang_iket.py        | 38 +++++++++++++++++++
 vllm/models/deepseek_v4_1/tilelang/iket.py    | 37 ++++++++++++++++++
 2 files changed, 75 insertions(+)

diff --git a/tests/kernels/test_deepseek_v41_tilelang_iket.py b/tests/kernels/test_deepseek_v41_tilelang_iket.py
index 4b15422185..eadf0947d8 100644
--- a/tests/kernels/test_deepseek_v41_tilelang_iket.py
+++ b/tests/kernels/test_deepseek_v41_tilelang_iket.py
@@ -298,6 +298,44 @@ def test_sampled_global_flag_loop_remains_a_wait_phase():
     assert [(s["phase"], s["kinds"]) for s in sites] == [("wait", ["spin"])]
 
 
+VISION_PRODUCERS = """extern "C" __global__ void vision_swiglu_linear_kernel() {
+  if (((int)threadIdx.x) < 128) {
+    tl::warpgroup_reg_dealloc<24>();
+    for (int ko = 0; ko < 16; ++ko) {
+      mbarrier[((ko & 1) + 2)].wait((((ko & 3) >> 1) ^ 1));
+      if (tl::tl_shuffle_elect<128>()) {
+        tl::tma_load(A_desc, mbarrier[(ko & 1)], A_shared, 0, 0);
+      }
+    }
+  } else {
+    tl::warpgroup_reg_alloc<240>();
+  }
+}
+"""
+
+
+def test_vision_producers_rendezvous_before_each_reused_barrier_wait():
+    out = iket._synchronize_vision_producers(VISION_PRODUCERS)
+    assert out.count('bar.sync 15, 128;') == 1
+    assert out.index('for (int ko') < out.index('bar.sync 15') < out.index('.wait(')
+    assert out.index('warpgroup_reg_dealloc') < out.index('bar.sync 15')
+    assert iket._synchronize_vision_producers(VISION_PRODUCERS.replace(
+        'vision_swiglu_linear_kernel', 'other_kernel')) == VISION_PRODUCERS.replace(
+            'vision_swiglu_linear_kernel', 'other_kernel')
+    annotated, sites = iket.annotate(VISION_PRODUCERS, _token, iters=1)
+    assert 'bar.sync 15, 128;' in annotated and sites
+
+
+def test_vision_producer_barrier_refuses_conflicts_and_unknown_layout():
+    with pytest.raises(ValueError, match='unused barrier 15'):
+        iket._synchronize_vision_producers(VISION_PRODUCERS.replace(
+            'tl::warpgroup_reg_dealloc<24>();',
+            'asm volatile("bar.sync 15, 128;" ::: "memory");'))
+    with pytest.raises(ValueError, match='unrecognized'):
+        iket._synchronize_vision_producers(VISION_PRODUCERS.replace(
+            'tl::tl_shuffle_elect<128>()', 'other()'))
+
+
 def test_module_without_kernels_is_unchanged():
     code = (
         "#include <tl_templates/cuda/copy.h>\n__device__ int f(int x) { return x; }\n"
diff --git a/vllm/models/deepseek_v4_1/tilelang/iket.py b/vllm/models/deepseek_v4_1/tilelang/iket.py
index 5adaf672ab..f8eba3222d 100644
--- a/vllm/models/deepseek_v4_1/tilelang/iket.py
+++ b/vllm/models/deepseek_v4_1/tilelang/iket.py
@@ -487,6 +487,42 @@ def _sample_runtime_loops(code: str, iters: int) -> str:
     return code
 
 
+def _synchronize_vision_producers(code: str) -> str:
+    """Keep all 128 TMA producers within one generation of their reused barriers.
+
+    Only the elected warp issues copies, but all four generated producer warps
+    wait on the two-stage pipeline. Tracing can delay a non-copy warp past two
+    barrier generations. A producer-only rendezvous prevents that parity ABA.
+    Barrier 15 is reserved here only for these two known generated kernels.
+    """
+    changes = []
+    for name, _, start, end in _kernels(code):
+        if name not in ("vision_linear_kernel", "vision_swiglu_linear_kernel"):
+            continue
+        if _CONDITIONAL.search(code, start, end):
+            continue
+        nodes, _ = _Parser(code).block(start)
+        for node in nodes:
+            if not re.fullmatch(r"if\s*\(\(\(int\)threadIdx\.x\)\s*<\s*128\)", node.text):
+                continue
+            if re.search(r"bar\.sync\s+15\b", code[start:end]):
+                raise ValueError("vision producer rendezvous needs unused barrier 15")
+            loops = [child for child in node.body or []
+                     if child.text.startswith("for")
+                     and "tl::tl_shuffle_elect<128>()" in code[child.start:child.end]
+                     and re.search(r"mbarrier\[.*\]\.wait\(", code[child.start:child.end])]
+            if len(loops) != 1:
+                raise ValueError("unrecognized vision TMA producer loop")
+            loop = loops[0]
+            brace = code.index("{", loop.start, loop.end) + 1
+            changes.append(brace)
+    for position in sorted(changes, reverse=True):
+        code = (code[:position]
+                + '\n      asm volatile("bar.sync 15, 128;" ::: "memory");'
+                + code[position:])
+    return code
+
+
 def _iterations(header: str, iters: int) -> str | None:
     """True in at most ``iters`` iterations of a TVM ``for`` loop (``for (int v =
     start; v < bound; ++v)``), each in the middle of its share of the loop, so one
@@ -569,6 +605,7 @@ def annotate(
     if granularity not in _GRANULARITIES:
         raise ValueError(f"unknown IKET granularity: {granularity!r}")
     code = _sample_runtime_loops(code, iters)
+    code = _synchronize_vision_producers(code)
     found: list[_Range] = []
     sites: list[dict] = []
     bodies: dict[str, int] = {}
