{
  "experiment": "experiments/2026-10-09-tilelang-migration",
  "run": "migration-w5",
  "jobs": [
    {
      "kind": "sync"
    },
    {
      "kind": "kernel",
      "bundles": [
        {
          "node": "dgx1",
          "bundle": "experiments/2026-10-09-tilelang-migration/bundles/collectives"
        },
        {
          "node": "dgx2",
          "bundle": "experiments/2026-10-09-tilelang-migration/bundles/compressor-projection"
        }
      ]
    },
    {
      "kind": "measure",
      "profile": "lean",
      "bracket": true,
      "extras": [
        [
          "token_determinism.py",
          [
            "--tokens",
            "192"
          ],
          "determinism"
        ],
        [
          "scripts/distinct_streams.py",
          [
            "--streams",
            "1",
            "--samples",
            "3",
            "--tokens",
            "256"
          ],
          "c1-distinct"
        ],
        [
          "scripts/distinct_streams.py",
          [
            "--streams",
            "8",
            "--samples",
            "3",
            "--tokens",
            "256"
          ],
          "c8-distinct"
        ],
        [
          "experiments/2026-09-29-determinism/mixed_latency.py",
          [
            "--rounds",
            "3"
          ],
          "mixed"
        ]
      ],
      "arms": [
        {
          "config": "control.json",
          "label": "control"
        },
        {
          "config": "oneshot-dispatch.json",
          "label": "oneshot-dispatch"
        },
        {
          "config": "collectives.json",
          "label": "collectives"
        },
        {
          "config": "compressor-projection.json",
          "label": "compressor-projection"
        },
        {
          "config": "deterministic.json",
          "label": "deterministic"
        }
      ]
    }
  ]
}
