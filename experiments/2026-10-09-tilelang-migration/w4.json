{
  "experiment": "experiments/2026-10-09-tilelang-migration",
  "run": "migration-w4",
  "jobs": [
    {
      "kind": "sync"
    },
    {
      "kind": "kernel",
      "bundles": [
        {
          "node": "dgx1",
          "bundle": "experiments/2026-10-09-tilelang-migration/bundles/compressor-projection"
        },
        {
          "node": "dgx1",
          "bundle": "experiments/2026-10-09-tilelang-migration/bundles/engram-hash"
        },
        {
          "node": "dgx2",
          "bundle": "experiments/2026-10-09-tilelang-migration/bundles/context-kv"
        },
        {
          "node": "dgx3",
          "bundle": "experiments/2026-10-09-tilelang-migration/bundles/wo-projection"
        },
        {
          "node": "dgx3",
          "bundle": "experiments/2026-10-09-tilelang-migration/bundles/index-weights"
        },
        {
          "node": "dgx4",
          "bundle": "experiments/2026-10-09-tilelang-migration/bundles/decode-rows"
        },
        {
          "node": "dgx4",
          "bundle": "experiments/2026-10-09-tilelang-migration/bundles/rope"
        },
        {
          "node": "dgx4",
          "bundle": "experiments/2026-10-09-tilelang-migration/bundles/engram-gate"
        }
      ]
    },
    {
      "kind": "measure",
      "profile": "lean",
      "bracket": true,
      "extras": [
        [
          "token_determinism.py",
          [
            "--tokens",
            "192"
          ],
          "determinism"
        ],
        [
          "scripts/distinct_streams.py",
          [
            "--streams",
            "1",
            "--samples",
            "3",
            "--tokens",
            "256"
          ],
          "c1-distinct"
        ],
        [
          "scripts/distinct_streams.py",
          [
            "--streams",
            "8",
            "--samples",
            "3",
            "--tokens",
            "256"
          ],
          "c8-distinct"
        ],
        [
          "scripts/distinct_streams.py",
          [
            "--streams",
            "16",
            "--samples",
            "3",
            "--tokens",
            "256"
          ],
          "c16-distinct"
        ]
      ],
      "arms": [
        {
          "config": "control.json",
          "label": "control"
        },
        {
          "config": "decode-rows.json",
          "label": "decode-rows"
        },
        {
          "config": "engram-gate.json",
          "label": "engram-gate"
        },
        {
          "config": "engram-hash.json",
          "label": "engram-hash"
        },
        {
          "config": "rope.json",
          "label": "rope"
        },
        {
          "config": "index-weights.json",
          "label": "index-weights"
        }
      ]
    }
  ]
}
