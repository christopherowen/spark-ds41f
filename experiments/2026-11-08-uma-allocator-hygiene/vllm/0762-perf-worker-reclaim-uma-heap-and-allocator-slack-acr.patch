+def test_trim_host_heap_reclaims_cpu_tensor_and_glibc_arenas():
+    import gc
+    import sys
+
+    if sys.platform != "linux":
+        pytest.skip("Linux-only host arena trim test")
+
+    def read_rss_kib() -> int:
+        with open("/proc/self/status") as f:
+            for line in f:
+                if line.startswith("VmRSS:"):
+                    return int(line.split()[1])
+        return 0
+
+    trim_host_heap()
+    t = torch.ones((32 * 1024 * 1024,), dtype=torch.float32, device="cpu")
+    buf = bytearray(64 * 1024 * 1024)
+    buf[0 : len(buf) : 4096] = b"\x01" * (len(buf) // 4096)
+    rss_peak = read_rss_kib()
+    del t, buf
+    gc.collect()
+    assert trim_host_heap() is True
+    rss_after = read_rss_kib()
+    if _get_c10_mi_collect() is not None:
+        assert rss_after < rss_peak - 64 * 1024
