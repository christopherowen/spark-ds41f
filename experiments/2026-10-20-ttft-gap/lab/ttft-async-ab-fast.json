{
 "experiment": "results/private/lab/ttft-gap",
 "run": "ttft-async-ab-fast",
 "jobs": [
  {
   "kind": "sync"
  },
  {
   "kind": "measure",
   "bench": false,
   "bracket": false,
   "extras": [
    [
     "ttft_trace.py",
     [
      "--repo",
      ".",
      "--output",
      "results/private/lab/ttft-gap/trace-{run}-{label}.json",
      "--analyze"
     ],
     "trace"
    ],
    [
     "scripts/servebench_run.py",
     [
      "--mode",
      "closed",
      "--concurrency",
      "4",
      "--warmup",
      "30",
      "--duration",
      "120",
      "--extra-body",
      "{\"chat_template_kwargs\": {\"thinking\": false}}",
      "--label",
      "{label}",
      "--output",
      "results/private/lab/ttft-gap/c4-{run}-{label}.json"
     ],
     "c4"
    ],
    [
     "scripts/servebench_run.py",
     [
      "--mode",
      "closed",
      "--concurrency",
      "8",
      "--warmup",
      "30",
      "--duration",
      "120",
      "--extra-body",
      "{\"chat_template_kwargs\": {\"thinking\": false}}",
      "--label",
      "{label}",
      "--output",
      "results/private/lab/ttft-gap/c8-{run}-{label}.json"
     ],
     "c8"
    ],
    [
     "experiments/2026-10-12-r6g/token_determinism_text.py",
     [
      "--tokens",
      "192",
      "--long-lines",
      "700",
      "--wide"
     ],
     "determinism"
    ]
   ],
   "arms": [
    {
     "config": "async-off.json",
     "label": "async-off"
    },
    {
     "config": "r6x.json",
     "label": "r6x"
    }
   ]
  }
 ]
}