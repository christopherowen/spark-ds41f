--- a/tests/v1/spec_decode/test_adaptive_verification.py
+++ b/tests/v1/spec_decode/test_adaptive_verification.py
@@ -746,3 +746,63 @@ def test_marginal_rate_never_falls_below_the_no_draft_rate():
     # At the floor (1 token / 10 ms) a 0.2-survival draft costing 1 ms pays.
     assert manager.get_num_tokens({"low": 3}, {"low": [1, 2]}) == 2
     assert manager._rates[1] >= 0.1
+
+
+def _profiling_manager() -> AdaptiveVerificationManager:
+    manager = _pinning_manager()
+    manager.req_states = SimpleNamespace(max_num_reqs=8, max_num_batched_tokens=16)
+    manager.set_cost_curves = lambda draft, verify, **kwargs: None
+    return manager
+
+
+def test_pinned_profile_runs_one_timed_round(monkeypatch, tmp_path):
+    """With curves pinned for the shape set, the remaining rounds are skipped."""
+    monkeypatch.setattr(adaptive_module, "_COST_DIR", str(tmp_path))
+    monkeypatch.setattr(adaptive_module, "_PROFILE_REPLAYS", 5)
+    monkeypatch.setattr(
+        adaptive_module,
+        "get_tp_group",
+        lambda: SimpleNamespace(
+            rank_in_group=0, world_size=3, broadcast_object=lambda obj, src: obj
+        ),
+    )
+    timed = []
+
+    class TimingCollector:
+        samples = None
+
+        @contextmanager
+        def collect(self):
+            self.samples = []
+            try:
+                yield self.samples
+            finally:
+                self.samples = None
+
+    timing = TimingCollector()
+
+    def run_dummy(num_tokens, context_len, profile_num_reqs=2):
+        if timing.samples is not None:
+            timed.append((num_tokens, profile_num_reqs))
+            cost = float(num_tokens + profile_num_reqs)
+            timing.samples.append(
+                StepTimingSample(cost, cost, num_tokens, profile_num_reqs, num_tokens <= 8)
+            )
+
+    shapes = [(1, 1), (8, 1), (8, 2)]
+    _profiling_manager().profile_costs(run_dummy, timing, [1, 8], shapes)
+    full_profile = len(timed)
+    assert len(list(tmp_path.glob("dspark-costs-*.json"))) == 1
+    timed.clear()
+    _profiling_manager().profile_costs(run_dummy, timing, [1, 8], shapes)
+    assert len(timed) * 5 == full_profile
+
+
+def test_completed_profile_continues_the_shape_order():
+    manager = _profiling_manager()
+    manager._cudagraph_limit = 8
+    one_block = list(manager.batches_to_profile([1, 8], [(1, 1), (8, 1)], replays=5))
+    split = list(manager.batches_to_profile([1, 8], [(1, 1), (8, 1)], replays=1)) + list(
+        manager.batches_to_profile([1, 8], [(1, 1), (8, 1)], replays=4, start=1)
+    )
+    assert split == one_block
