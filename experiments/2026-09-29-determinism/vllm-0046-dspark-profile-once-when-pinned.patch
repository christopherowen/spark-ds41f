+    def _complete_profile(
+        self,
+        timings: list[StepTimingSample],
+        run_dummy: Callable[..., object],
+        step_timing: StepTimingCollector,
+        capture_sizes: list[int],
+        full_batch_shapes: list[tuple[int, int]],
+        done: int,
+        rows: str = "padded",
+    ) -> list[StepTimingSample]:
+        """Run the remaining timed rounds unless pinned curves cover this shape set.
+
+        Rank 0 decides and broadcasts, so every rank runs the same steps (and
+        collectives). The rounds continue the alternating shape order, so a
+        completed profile equals one taken in a single block.
+        """
+        if done >= _PROFILE_REPLAYS or self._pinned_curves_exist(timings, rows):
+            return timings
+        with step_timing.collect() as more:
+            for batch in self.batches_to_profile(
+                capture_sizes,
+                full_batch_shapes,
+                replays=_PROFILE_REPLAYS - done,
+                start=done,
+                tail=rows == "padded",
+            ):
+                run_dummy(**batch)
+        return [*timings, *more]
+
+    def _pinned_curves_exist(
+        self, samples: list[StepTimingSample], rows: str = "padded"
+    ) -> bool:
+        tp_group = get_tp_group()
+        found = None
+        if tp_group.rank_in_group == 0:
+            by_num_reqs = verify_curves_by_num_reqs_from(samples)
+            if rows == "padded":
+                draft = median_curve(
+                    (s.num_reqs, s.drafter_ms) for s in samples if s.full_cudagraph
+                )
+                verify = median_curve((s.num_target_tokens, s.forward_ms) for s in samples)
+            else:
+                draft, verify = [], []
+            key, path = self._pin_key(draft, verify, by_num_reqs, rows)
+            found = False
+            if os.path.exists(path):
+                with open(path) as f:
+                    found = json.load(f).get("key") == key
+        return bool(tp_group.broadcast_object(found, src=0))
+
+    def _pin_key(
+        self,
+        draft_curve: list[tuple[int, float]],
+        verify_curve: list[tuple[int, float]],
+        verify_curves_by_num_reqs: Mapping[int, list[tuple[int, float]]],
+        rows: str,
+    ) -> tuple[dict, str]:
+        """The shape-set key of a cost profile and the file its pinned curves live in."""
+        key = {
+            "tp": get_tp_group().world_size,
+            "num_speculative_steps": self.num_speculative_steps,
+            "max_num_reqs": self.req_states.max_num_reqs,
+            "max_num_batched_tokens": self.req_states.max_num_batched_tokens,
+            "cudagraph_limit": self._cudagraph_limit,
+            "profile_context_len": envs.VLLM_ADAPTIVE_VERIFICATION_PROFILE_CONTEXT_LEN,
+            "draft_sizes": [int(x) for x, _ in draft_curve],
+            "verify_sizes": [int(x) for x, _ in verify_curve],
+            "full_shapes": {
+                str(n): [int(x) for x, _ in curve]
+                for n, curve in sorted(verify_curves_by_num_reqs.items())
+            },
+        }
+        if rows != "padded":
+            key["rows"] = rows
+        digest = hashlib.sha256(json.dumps(key, sort_keys=True).encode()).hexdigest()[:16]
+        return key, os.path.join(_COST_DIR, f"dspark-costs-{digest}.json")
+
