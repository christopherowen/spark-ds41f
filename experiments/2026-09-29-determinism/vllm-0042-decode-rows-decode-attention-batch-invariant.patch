             kernel_mode = "extend" if single_pass else mode
             caps = mla.Caps(
                 device=device,
@@ -1671,6 +1671,19 @@ class DeepseekV4Attention(nn.Module, AttentionLayerBase):
                     )
                 self.topk_indices_buffer[:rows].copy_(split.gather(selected))
 
+        # Batch-invariant mode: a step that holds prompt rows still gives its
+        # decode rows (the leading decode_rows, by request state; CED decoder
+        # rows keep them first) the decode kernel, as a decode-only step does,
+        # so a generated row rounds the same whatever shares its step.
