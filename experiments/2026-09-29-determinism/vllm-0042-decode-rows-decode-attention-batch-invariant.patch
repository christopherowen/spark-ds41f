+++ b/tests/models/test_deepseek_v4_1_attention_batch_invariant.py
@@ -0,0 +1,43 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Batch-invariant mode: step kind and decode rows come from request state."""
+
+import types
+
+import pytest
+import torch
+
+pytest.importorskip("b12x")
+
+from vllm.models.deepseek_v4_1.sparse_mla import _batch_invariant_decode_rows  # noqa: E402
+
+
+def _cm(prefilling, query_lens):
+    starts = [0]
+    for n in query_lens:
+        starts.append(starts[-1] + n)
+    return types.SimpleNamespace(
+        is_prefilling=torch.tensor(prefilling, dtype=torch.bool),
+        num_reqs=len(query_lens),
+        query_start_loc_cpu=torch.tensor(starts, dtype=torch.int32),
+    )
+
+
+def test_decode_only_step_keeps_its_kind():
+    assert _batch_invariant_decode_rows(_cm([False, False], [6, 4]), 6, True) == (True, 0)
+
+
+def test_prompt_tail_as_short_as_a_decode_query_is_not_a_decode_step():
+    # The last token of a fully cached prompt, alone in its step.
+    assert _batch_invariant_decode_rows(_cm([True], [1]), 6, True) == (False, 0)
+
+
+def test_mixed_step_reports_its_leading_decode_rows():
+    cm = _cm([False, False, True, True], [6, 3, 2706, 1])
+    assert _batch_invariant_decode_rows(cm, 6, False) == (False, 9)
+
+
+def test_missing_request_state_keeps_the_query_length_rule():
+    cm = _cm([False], [6])
+    cm.is_prefilling = None
+    assert _batch_invariant_decode_rows(cm, 6, True) == (True, 0)
