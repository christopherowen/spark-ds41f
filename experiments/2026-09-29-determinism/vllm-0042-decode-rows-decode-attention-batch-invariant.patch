+            decode_rows=decode_rows,
         )
 
 
+def _batch_invariant_decode_rows(cm, threshold, is_decode):
+    """Step kind from request state, not query length (batch-invariant mode).
+
+    A prompt tail no longer than a decode step's query (the last token of a
+    fully cached prompt, a short final chunk) is still prompt work: the step is
+    not a decode step. A step holding prompt rows reports how many leading
+    rows belong to decoding requests (vLLM orders decodes first), so attention
+    can give them the decode kernel a decode-only step would use.
+    """
+    prefilling = cm.is_prefilling
+    if prefilling is None or threshold is None:
+        return is_decode, 0
+    prefilling = prefilling[: cm.num_reqs].tolist()
+    if not any(prefilling):
+        return is_decode, 0
+    starts = cm.query_start_loc_cpu[: cm.num_reqs + 1].tolist()
+    decodes = 0
+    for index, is_prefill in enumerate(prefilling):
+        if is_prefill or starts[index + 1] - starts[index] > threshold:
+            break
+        decodes += 1
+    return False, int(starts[decodes])
+
+
 class DeepseekV41B12xBackend(AttentionBackend):
     supported_dtypes = [torch.bfloat16]
     supported_kv_cache_dtypes = ["auto", "fp8", "fp8_ds_mla"]
