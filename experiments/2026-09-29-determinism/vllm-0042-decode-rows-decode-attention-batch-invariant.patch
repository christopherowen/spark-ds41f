+            int(getattr(swa, "decode_rows", 0))
+            if _BATCH_INVARIANT and mode == "extend"
+            else 0
+        )
+        if decode_rows:
+            self._run_split_rows(q, output, swa, main, owner, plan, state, rows, decode_rows)
+            return
+
         # Reuse the shared arena only after indexing completes. Keep full-batch
         # metadata beside, not overlapping, the native attention scratch.
         metadata_specs = self._attention_workspace_specs[mode]
@@ -1736,6 +1749,64 @@ class DeepseekV4Attention(nn.Module, AttentionLayerBase):
             cache_format="deepseek_v41",
         )
 
+    def _run_split_rows(self, q, output, swa, main, owner, plan, state, rows, decode_rows):
+        """Batch-invariant mode: decode rows on the decode plan, the rest single-pass."""
+        from b12x.preparation import require_prepared
+
+        decode_plan = self._attention_plan("decode")
+        decode_state = require_prepared(decode_plan, "attention.compressed_sparse_mla")
+        if decode_rows > decode_state.query.query_rows:
+            raise ValueError(
+                f"V4.1 decode rows {decode_rows} exceed prepared capacity "
+                f"{decode_state.query.query_rows}"
+            )
+        metadata_specs = self._attention_workspace_specs["extend"]
+        extend_specs = tuple((s.shape, s.dtype) for s in state.scratch_plan.scratch_specs())
+        decode_specs = tuple((s.shape, s.dtype) for s in decode_state.scratch_plan.scratch_specs())
+        arena = current_workspace_manager().get_simultaneous(
+            *metadata_specs, *extend_specs, *decode_specs
+        )
+        metadata_count = len(metadata_specs)
+        self._write_decode_metadata(arena, swa, main, rows)
+        swa_indices, swa_lengths, top_lengths = arena[:3]
+        scratch = {
+            "extend": arena[metadata_count : metadata_count + len(extend_specs)],
+            "decode": arena[metadata_count + len(extend_specs) :],
+        }
+        for part_plan, part, rows_slice in (
+            (decode_plan, "decode", slice(0, decode_rows)),
+            (plan, "extend", slice(decode_rows, rows)),
+        ):
+            if rows_slice.start == rows_slice.stop:
+                continue
+            kwargs = {}
+            if main is not None:
+                kwargs = dict(
+                    indexed_indices=owner.topk_indices_buffer[rows_slice],
+                    indexed_lengths=top_lengths[rows_slice],
+                    indexed_page_table=arena[3][rows_slice],
+                )
+            binding = mla.bind(
+                part_plan,
+                scratch=scratch[part],
+                q=q[rows_slice],
+                swa_indices=swa_indices[rows_slice],
+                swa_lengths=swa_lengths[rows_slice],
+                **kwargs,
+            )
+            mla.run(
+                binding=binding,
+                swa_k_cache=self.swa_cache_layer.kv_cache,
+                indexed_k_cache=self._owner().kv_cache if main is not None else None,
+                swa_page_size=self.swa_cache_layer.block_size,
+                indexed_page_size=self._main_page,
+                sm_scale=512**-0.5,
+                attn_sink=self.attn_sink,
+                out=output[rows_slice],
+                cache_format="deepseek_v41",
+            )
+        retain_cuda_graph_capture_resource(arena)
+
     def _write_decode_metadata(self, buffers, swa, main, rows):
         swa_indices, swa_lengths, top_lengths = buffers[:3]
         visible = main.cache_lengths if main is not None else swa.cache_lengths
