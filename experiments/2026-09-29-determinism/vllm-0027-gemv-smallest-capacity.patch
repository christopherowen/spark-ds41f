             graph.reset()
 
 
+def test_projections_take_the_smallest_prepared_capacity(monkeypatch):
+    """Rows between prepared capacities use the next larger plan, not the largest."""
+    from b12x.gemm import bf16_gemv
+
+    from vllm.models.deepseek_v4_1.b12x_layers import B12xLinearMethod
+    from vllm.models.deepseek_v4_1.compressor import DeepseekCompressor
+
+    used = []
+    monkeypatch.setattr(
+        bf16_gemv, "mm", lambda x, weight, *, plan, **kwargs: used.append(plan)
+    )
+    capacities = (1, 2, 4, 8, 12, 48, 4096)
+    layer = torch.nn.Module()
+    layer.weight = torch.nn.Parameter(torch.empty(384, 16), requires_grad=False)
+    layer.b12x_linear_capacities = capacities
+    layer.b12x_linear_plans = {(torch.bfloat16, rows): rows for rows in capacities}
+    module = DeepseekCompressor.__new__(DeepseekCompressor)
+    torch.nn.Module.__init__(module)
+    module.compress_ratio = 2
+    module.fused_wkv_wgate = SimpleNamespace(weight=torch.empty(1024, 16))
+    module._values = module._gates = torch.empty(4096, 512)
+    module._projection_capacities = capacities
+    module._projection_plans = {rows: rows for rows in capacities}
+    expected = {1: 1, 3: 4, 5: 8, 9: 12, 13: 48, 48: 48, 49: 4096, 4096: 4096}
+    for rows, capacity in expected.items():
+        source = torch.empty(rows, 16, dtype=torch.bfloat16)
+        B12xLinearMethod().apply(layer, source)
+        module._project(source)
+        assert used[-3:] == [capacity] * 3, rows
+    with pytest.raises(ValueError, match="exceed planned capacity"):
+        B12xLinearMethod().apply(layer, torch.empty(4097, 16, dtype=torch.bfloat16))
+
+
 @torch.no_grad()
 def test_mhc_weighted_collapse_and_mean_use_prepared_plans(monkeypatch):
     from b12x.preparation import PreparationSession
diff --git a/vllm/models/deepseek_v4_1/b12x_layers.py b/vllm/models/deepseek_v4_1/b12x_layers.py
index 18391a5c9..e5f09353b 100644
--- a/vllm/models/deepseek_v4_1/b12x_layers.py
+++ b/vllm/models/deepseek_v4_1/b12x_layers.py
@@ -215,9 +215,24 @@ class B12xEmbeddingMethod(UnquantizedEmbeddingMethod):
         return out
 
 
+def _smallest_capacity(capacities: tuple[int, ...], rows: int) -> int:
+    """The smallest prepared row capacity that holds ``rows``.
+
+    Each capacity selects its own projection backend, so a row must not fall
+    back to the largest plan between capture sizes: it would round differently
+    than the same row padded into a captured batch. A loop, not ``bisect``,
+    which ``torch.compile(fullgraph=True)`` cannot trace.
+    """
+    for capacity in capacities:
+        if rows <= capacity:
+            return capacity
+    raise ValueError("V4.1 linear rows exceed planned capacity")
+
+
 class B12xLinearMethod(UnquantizedLinearMethod):
     def process_weights_after_loading(self, layer: nn.Module) -> None:
         layer.b12x_linear_plans = {}
+        layer.b12x_linear_capacities = ()
         set_b12x_preparation_provider(layer, self)
 
     def get_b12x_preparation_units(
@@ -227,7 +242,9 @@ class B12xLinearMethod(UnquantizedLinearMethod):
             return ()
         weight = layer.weight
         capacities = tuple(sorted({workload.max_tokens, *workload.token_counts}))
-        layer.b12x_linear_capacity = workload.max_tokens
+        layer.b12x_linear_capacities = tuple(
+            sorted({*layer.b12x_linear_capacities, *capacities})
+        )
 
         def make_call(state):
             query = state.query
@@ -290,9 +307,8 @@ class B12xLinearMethod(UnquantizedLinearMethod):
     ) -> torch.Tensor:
         if bias is not None:
             raise ValueError("V4.1 native projections require bias-free weights")
-        plan = layer.b12x_linear_plans.get((x.dtype, x.shape[0]))
-        if plan is None:
-            plan = layer.b12x_linear_plans[(x.dtype, layer.b12x_linear_capacity)]
+        capacity = _smallest_capacity(layer.b12x_linear_capacities, x.shape[0])
+        plan = layer.b12x_linear_plans[(x.dtype, capacity)]
         return bf16_gemv.mm(
             x,
             layer.weight,
