+@pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA is required")
+@pytest.mark.parametrize("m", [3, 6, 40])
+def test_w4a8_deterministic_slice_partials_match_oracle_and_repeat(
+    monkeypatch: pytest.MonkeyPatch,
+    m: int,
+) -> None:
+    """Deterministic fused decode keeps one task per slice and repeats exactly."""
+
+    require_b12x()
+    from b12x.moe.fused_moe._impl import b12x_moe_fp4, clear_tp_moe_caches
+
+    monkeypatch.setenv("B12X_DYNAMIC_DETERMINISTIC_OUTPUT", "1")
+    monkeypatch.delenv("B12X_DYNAMIC_TILE_MN", raising=False)
+    clear_tp_moe_caches()
+    device = torch.device("cuda")
+    weights = _weights(seed=3_100 + m)
+    x, topk_ids, topk_weights = _routed_inputs(m, 3_200 + m)
+    reference = moe_reference_w4a8_mx(
+        x.float(),
+        weights["w13_fp4"],
+        weights["w13_mx"],
+        None,
+        weights["alphas"],
+        weights["w2_fp4"],
+        weights["w2_mx"],
+        None,
+        weights["alphas"],
+        topk_ids,
+        topk_weights,
+        _E,
+        _K,
+        _N,
+        activation="silu",
+    )
+    prepared = _prepare(weights)
+    output = torch.zeros(m, _K, dtype=torch.bfloat16, device=device)
+    with make_tp_moe_fp4_binding(
+        a=x,
+        experts=prepared,
+        topk_weights=topk_weights.contiguous(),
+        topk_ids=topk_ids.contiguous(),
+        output=output,
+        input_scales_static=True,
+        quant_mode="w4a8_mx",
+    ) as binding:
+        assert binding.deterministic_output
+        # One route-output row per (routed pair, N128 intermediate slice).
+        assert tuple(binding.route_output.shape) == (m * _TOPK * (_N // 128), _K)
+
+        def launch() -> None:
+            b12x_moe_fp4(binding=binding)
+
+        launch()
+        torch.cuda.synchronize()
+        _assert_dynamic_oracle(output, reference, context=("slice-partials", m))
+        first = output.clone()
+        for _ in range(3):
+            output.fill_(float("nan"))
+            launch()
+            torch.cuda.synchronize()
+            assert torch.equal(output, first)
+        graph = _capture_and_replay(launch)
+        for sentinel in (float("nan"), 997.0):
+            output.fill_(sentinel)
+            graph.replay()
+            torch.cuda.synchronize()
+            assert torch.equal(output, first)
+        del graph
