@@ -2131,6 +2131,68 @@ def _w4a8_dynamic_materialized_enabled(
     )
 
 
+# Bound on the route-output rows slice partials may use (routed pairs times
+# intermediate slices), so the partials never outgrow a prefill-sized plan.
+_DETERMINISTIC_SLICE_PARTIAL_MAX_ROWS = 8192
+
+
+def _dynamic_deterministic_route_slices(
+    *,
+    quant_mode: str,
+    activation: str,
+    num_experts: int,
+    k: int,
+    n: int,
+    num_topk: int,
+    planned_num_tokens: int,
+    w4a8_repacked: bool,
+    w4a8_n64_repacked: bool,
+    share_input_across_experts: bool,
+    deterministic_output: bool,
+    planned_tile_m: int | None,
+) -> int:
+    """Route-output rows per routed pair for one dynamic launch.
+
+    Deterministic fused FC2 either collapses every intermediate slice of an M
+    tile into one task (one row per pair) or, for W4A8 SiLU launches small
+    enough that the collapse starves the grid, keeps one task per slice and
+    stores each slice's partial in its own row: ``pair * slices + slice``.
+    The fixed-order top-k sum then reduces ``num_topk * slices`` rows per
+    token.  Launches with a materialized intermediate (split, M=1, or the
+    fused phase B) already compute FC2 once per output location and keep one
+    row per pair.  Planning, the kernel and the top-k sum all resolve the
+    count here.
+    """
+    if not deterministic_output:
+        return 1
+    quant_mode = _normalize_quant_mode(quant_mode)
+    activation = _get_activation_kernel_spec(activation, quant_mode=quant_mode).activation
+    if quant_mode != "w4a8_mx" or activation != "silu" or not w4a8_repacked:
+        return 1
+    if int(n) % 128 != 0 and not w4a8_n64_repacked:
+        n = _dynamic_kernel_intermediate_size(n, quant_mode)
+    routed_rows = int(planned_num_tokens) * int(num_topk)
+    materialize = bool(w4a8_n64_repacked) or _w4a8_dynamic_materialized_enabled(
+        quant_mode=quant_mode,
+        activation=activation,
+        num_tokens=int(planned_num_tokens),
+        routed_rows=routed_rows,
+        num_experts=num_experts,
+        k=k,
+        n=n,
+        w4a8_repacked=w4a8_repacked,
+        share_input_across_experts=share_input_across_experts or bool(w4a8_n64_repacked),
+        deterministic_output=deterministic_output,
+        planned_tile_m=planned_tile_m,
+    )
+    if materialize:
+        return 1
+    slices = max(1, (int(n) + _LEVEL_TILE_N - 1) // _LEVEL_TILE_N)
+    if slices == 1 or routed_rows * slices > _DETERMINISTIC_SLICE_PARTIAL_MAX_ROWS:
+        return 1
+    return slices
+
+
