+    def _probe_query_projection(self, qr):
+        """Debug probe: the served wq_b beside three recomputations (tags 25-27).
+
+        25: the same call again (shared preallocated workspace); 26: the same
+        rows with a private scratch; 27: the rows behind a copy of row 0, so the
+        batch grows by one and every row moves down one position.
+        """
+        from bisect import bisect_left
+
+        layer = self.wq_b
+        again = self.wq_b(qr)
+        checksum_debug.record_attn(self, 25, again)
+        rows = qr.shape[0]
+        (spec,) = layer.b12x_plans[bisect_left(layer.b12x_capacities, rows)].scratch_specs()
+        private = torch.empty(spec.shape, dtype=spec.dtype, device=qr.device)
+        out = torch.empty((rows, layer.weight.shape[0]), dtype=torch.bfloat16, device=qr.device)
+        torch.ops.vllm.dsv41_block32_linear(qr, out, layer.b12x_key, private)
+        checksum_debug.record_attn(self, 26, out)
+        shifted = self.wq_b(torch.cat([qr[:1], qr]))[1:]
+        checksum_debug.record_attn(self, 27, shifted)
