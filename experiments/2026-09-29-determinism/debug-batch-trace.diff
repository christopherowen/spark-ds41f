+        checksum_debug.record_tag(self, 7, second[rows])
+        if capture:
+            checksum_debug.capture_first_mismatch(
+                self, down, second[rows],
+                {"act": act, "first": down, "second": second[rows],
+                 "first_scratch": self._first_scratch, "second_scratch": scratch},
+                {"values": self.down_proj.b12x_weight.weight.values,
+                 "scale_rows": self.down_proj.b12x_weight.weight.scale_rows},
+            )
+        checksum_debug.record_tag(self, 8, act)
+        checksum_debug.record_tag(self, 9, down)
+        alpha = dense_gemm._ALPHA_ONE_CACHE.get(("cuda", act.device.index))
+        if alpha is not None:
+            checksum_debug.record_tag(self, 10, alpha.view(1, -1))
