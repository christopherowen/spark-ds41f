+
+        views = self.__dict__.get("_down_state_views")
+        if views is None:
+            def bytes64(tensor):
+                if tensor is None:
+                    return None
+                flat = torch.empty(0, dtype=torch.uint8, device=tensor.device)
+                flat.set_(tensor.untyped_storage())
+                usable = flat.numel() // 64 * 64
+                return flat[:usable].view(64, -1)
+
+            packed = self.down_proj.b12x_weight.weight
+            views = self._down_state_views = (
+                bytes64(packed.values),
+                bytes64(packed.scale_mma),
+                bytes64(getattr(packed, "values_tiled", None)),
+            )
+        for tag, view in zip((4, 5, 6), views):
+            if view is not None:
