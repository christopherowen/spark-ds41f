+def _fingerprint_torch(flat: torch.Tensor, out: torch.Tensor) -> None:
+    """Reference fingerprint in torch ops (any dtype)."""
+    if flat.dtype == torch.bool:
+        flat = flat.to(torch.uint8)
+    size = flat.element_size()
+    if flat.is_floating_point():
+        bits = flat.contiguous().view({2: torch.int16, 4: torch.int32}[size]).long()
+        bits &= 0xFFFF if size == 2 else 0xFFFFFFFF
+    else:
+        bits = flat.long()
+    bits = torch.remainder(bits, _HASH_PRIME)
+    weights = torch.remainder(
+        torch.arange(1, bits.shape[1] + 1, dtype=torch.int64, device=flat.device) * 40503 + 7,
+        1048573,
+    )
+    out.copy_(torch.remainder((bits * weights).sum(dim=1), _HASH_PRIME))
+
+
+@triton.jit
+def _fingerprint_rows(bits, out, width, BITS16: tl.constexpr, BLOCK: tl.constexpr):
+    """out[row] = sum_j (bits[row, j] mod P) * w_j mod P, w_j = ((j+1)*40503+7) mod 1048573."""
+    row = tl.program_id(0)
+    acc = tl.zeros([BLOCK], dtype=tl.int64)
+    for start in range(0, width, BLOCK):
+        cols = start + tl.arange(0, BLOCK)
+        mask = cols < width
+        value = tl.load(bits + row.to(tl.int64) * width + cols, mask=mask, other=0).to(tl.int64)
+        if BITS16:
+            value = value & 0xFFFF
+        else:
+            value = value & 0xFFFFFFFF
+        value = value % 16777213
+        weight = ((cols + 1).to(tl.int64) * 40503 + 7) % 1048573
+        acc += tl.where(mask, (value * weight) % 16777213, 0)
+    total = tl.sum(acc, axis=0) % 16777213
+    tl.store(out + row, total.to(tl.float32))
