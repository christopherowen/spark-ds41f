+def record_attn_values(owner, tag: int, values: torch.Tensor, offset: int = 0) -> None:
+    """Append one attention record of per-row values, stored as they are.
+
+    The values are exact integers below 2**24 in float32 (index sums modulo the
+    prime, lengths, step labels), so they compare as exactly as fingerprints.
+    """
+    rows = values.shape[0]
+    log, _ = _log_for("attn", rows, values.device)
+    if log is None:
+        return
+    slot = log.slot(owner)
+    stage = log.stage[slot]
+    stage.zero_()
+    stage[0].fill_(slot)
+    stage[1].fill_(rows)
+    stage[2].fill_(tag)
+    stage[3].fill_(offset)
+    stage[4 : 4 + rows].copy_(values.reshape(rows))
+    log.append(slot)
 
 
