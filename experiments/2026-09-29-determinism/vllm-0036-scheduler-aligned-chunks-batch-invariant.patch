From 2a0ed4c0bbaea559a79fcd908fbfba2acf0f8a8e Mon Sep 17 00:00:00 2001
From: Christopher Owen <christopherowen@users.noreply.github.com>
Date: Thu, 1 Oct 2026 09:46:16 +0200
Subject: [PATCH] feat(scheduler): threshold-aligned prefill chunks in
 batch-invariant mode

A prefill chunk takes whatever token budget the step's other requests
leave, so where a prompt splits, and with it which rows each step
computes (and DeepSeek V4.1's CED decoder windows at a chunk end),
depends on the other requests. With VLLM_DS41_BATCH_INVARIANT=1 and a
long-prefill threshold, a chunk ends at the next absolute multiple of
the threshold (prefix-cache hits counted), and a chunk that does not fit
waits for a step that has room for all of it.
---
 tests/v1/core/test_batch_invariant_chunks.py | 64 ++++++++++++++++++++
 vllm/v1/core/sched/scheduler.py              | 43 +++++++++++++
 2 files changed, 107 insertions(+)
 create mode 100644 tests/v1/core/test_batch_invariant_chunks.py

diff --git a/tests/v1/core/test_batch_invariant_chunks.py b/tests/v1/core/test_batch_invariant_chunks.py
new file mode 100644
index 000000000..dbf9226a9
--- /dev/null
+++ b/tests/v1/core/test_batch_invariant_chunks.py
@@ -0,0 +1,64 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Batch-invariant mode: prefill chunks end at absolute multiples of the threshold."""
+
+from types import SimpleNamespace
+
+from vllm.v1.core.sched import scheduler as scheduler_module
+
+
+def _chunk(threshold, computed, remaining):
+    owner = SimpleNamespace(
+        scheduler_config=SimpleNamespace(long_prefill_token_threshold=threshold)
+    )
+    return scheduler_module.Scheduler._aligned_prefill_chunk(owner, computed, remaining)
+
+
+def test_chunks_end_at_multiples_of_the_threshold(monkeypatch):
+    monkeypatch.setattr(scheduler_module, "_BATCH_INVARIANT", True)
+    assert _chunk(400, 0, 800) == 400
+    assert _chunk(400, 400, 400) == 400
+    assert _chunk(400, 0, 150) == 150  # the prompt ends first
+    # A prefix-cache hit of 1536 tokens: the first chunk ends at 4000, as in a
+    # cold run, not 4000 tokens later.
+    assert _chunk(4000, 1536, 5000) == 2464
+    assert _chunk(0, 1536, 5000) == 5000  # no threshold: unchanged
+
+
+def test_off_by_default(monkeypatch):
+    monkeypatch.setattr(scheduler_module, "_BATCH_INVARIANT", False)
+    assert _chunk(400, 100, 800) == 800
+
+
+# A minimal OPT-125m configuration, so the scheduler builds without the hub.
+_OPT_CONFIG = {
+    "architectures": ["OPTForCausalLM"], "model_type": "opt", "hidden_size": 768,
+    "num_attention_heads": 12, "num_hidden_layers": 12, "ffn_dim": 3072,
+    "max_position_embeddings": 2048, "vocab_size": 50272, "word_embed_proj_dim": 768,
+    "torch_dtype": "float16", "do_layer_norm_before": True, "pad_token_id": 1,
+    "bos_token_id": 2, "eos_token_id": 2,
+}
+
+
+def test_no_partial_chunk_when_the_budget_is_short(monkeypatch, tmp_path):
+    import json
+
+    from tests.v1.core.utils import create_requests, create_scheduler
+
+    monkeypatch.setattr(scheduler_module, "_BATCH_INVARIANT", True)
+    (tmp_path / "config.json").write_text(json.dumps(_OPT_CONFIG))
+    scheduler = create_scheduler(
+        model=str(tmp_path),
+        max_num_batched_tokens=1024,
+        long_prefill_token_threshold=400,
+        skip_tokenizer_init=True,
+        device="cpu",
+    )
+    requests = create_requests(num_requests=3, num_tokens=800)
+    for request in requests:
+        scheduler.add_request(request)
+    output = scheduler.schedule()
+    # Without batch invariance the third request takes the 224 tokens left.
+    assert output.num_scheduled_tokens[requests[0].request_id] == 400
+    assert output.num_scheduled_tokens[requests[1].request_id] == 400
+    assert requests[2].request_id not in output.num_scheduled_tokens
