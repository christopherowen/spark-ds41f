+                    )
+                    num_new_tokens = aligned_chunk
                 if request.is_prefill_chunk and prefill_interleave_step is not None:
                     num_new_tokens = min(
                         num_new_tokens,
@@ -1062,6 +1091,11 @@ class Scheduler(SchedulerInterface):
                 num_new_tokens = min(
