+# Opt-in batch-invariant mode (DeepSeek V4.1): prefill chunks end at absolute
+# multiples of long_prefill_token_threshold, whatever else the step holds.
+_BATCH_INVARIANT = os.environ.get("VLLM_DS41_BATCH_INVARIANT") == "1"
+
 class Scheduler(SchedulerInterface):
     def __init__(
         self,
@@ -792,6 +798,23 @@ class Scheduler(SchedulerInterface):
             and (request.num_stale_output_tokens == 0 or request.drop_stale_output)
         )
 
+    def _aligned_prefill_chunk(
+        self, num_computed_tokens: int, num_new_tokens: int
+    ) -> int:
+        """Batch-invariant mode: the prefill chunk that ends at the next multiple of
+        the long-prefill threshold (or the prompt end).
+
+        Otherwise a chunk takes whatever budget the step's other requests leave,
+        so where a prompt splits, and with it which rows a step computes and the
+        CED decoder windows, would depend on the other requests. Counting from
+        the computed tokens (prefix-cache hits included) keeps the boundaries
+        absolute.
+        """
+        threshold = self.scheduler_config.long_prefill_token_threshold
+        if not _BATCH_INVARIANT or threshold <= 0:
+            return num_new_tokens
+        return min(num_new_tokens, threshold - num_computed_tokens % threshold)
+
     def schedule(self, throttle_prefills: bool = False) -> SchedulerOutput:
         self.current_step += 1
         # NOTE(woosuk) on the scheduling algorithm:
@@ -1052,6 +1075,12 @@ class Scheduler(SchedulerInterface):
