             raise ValueError(f"unsupported element_dtype {element_dtype!r}")
         if topk <= 0 or hidden_size <= 0:
             raise ValueError("topk and hidden_size must be positive")
+        # Masked slice sum (deterministic dynamic MoE with slice partials): the
+        # route output holds route_slices rows per (token, route); rows of
+        # routes whose expert id is outside [0, route_num_experts) were never
