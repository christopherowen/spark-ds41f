+@dsl_user_op
+def _pack_f32x2_to_bfloat2_rn(x0, x1, *, loc=None, ip=None) -> Uint32:
+    """Pack two FP32 values into BF16x2, round to nearest, no saturation.
+
+    Same rounding as the plain top-k sum's scalar ``cutlass.BFloat16(x)``
+    (unlike the intrinsics' ``satfinite`` pack), so both paths agree bitwise.
+    """
+    return Uint32(
+        llvm.inline_asm(
+            T.i32(),
+            [
+                cutlass.Float32(x0).ir_value(loc=loc, ip=ip),
+                cutlass.Float32(x1).ir_value(loc=loc, ip=ip),
+            ],
+            "cvt.rn.bf16x2.f32 $0, $2, $1;",
+            "=r,f,f",
+            has_side_effects=False,
+            is_align_stack=False,
+            asm_dialect=llvm.AsmDialect.AD_ATT,
+        )
+    )
+
+
 def _covering_count(total: int, quantum: int) -> int:
     return (total + quantum - 1) // quantum
 
