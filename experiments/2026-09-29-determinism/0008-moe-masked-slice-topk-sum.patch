 b12x/moe/_shared/kernels/dynamic.py      |  21 +----
 b12x/moe/_shared/kernels/w4a16/kernel.py | 103 +++++++++++++++++++++++
 b12x/moe/fused_moe/_impl.py              |  20 +++++
 tests/moe/test_w4a8_dynamic_kernel.py    |  35 ++++++--
 4 files changed, 156 insertions(+), 23 deletions(-)

