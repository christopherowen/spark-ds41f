+        self.route_slices = int(route_slices)
+        self.mask_invalid_routes = bool(mask_invalid_routes)
+        if self.mask_invalid_routes and (
+            element_dtype != "bf16" or full_rotation or use_expert_map or float32_output
+            or apply_topk_weights or hidden_size % 8 or topk % self.route_slices
+        ):
+            raise ValueError(
+                "masked top-k sum requires BF16 routes and output, no rotation, "
+                "expert map or router weights, hidden_size % 8 == 0 and whole slices"
+            )
         if apply_topk_weights and full_rotation:
             raise ValueError("full-rotation top-k sum already applies router weights")
         # Plain path: multiply each route by its FP32 router weight (FC2 then
@@ -8823,6 +8863,9 @@ class W4A16TopKSumKernel:
             # consequently launched only 28 active warps and serialized all
             # 16 routes in each of them.
             grid = (total, 1, 1)
+        elif cutlass.const_expr(self.mask_invalid_routes):
