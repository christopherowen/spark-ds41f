             return scatter_output, reference, _relaunch, state
         return scatter_output, reference, _relaunch
     if deterministic_slice_partials:
-        # The fixed-order top-k sum: routes, then slices, in FP32.
-        reduced = (
-            scatter_output.view(m, top_k * gate_tile_cnt, K).float().sum(dim=1)
-        ).to(torch.bfloat16)
+        # The masked fixed-order top-k sum: routes, then slices, in FP32,
+        # skipping routes to no expert (their rows stay NaN-poisoned: the
+        # kernel no longer clears them). Checked bitwise against the same
+        # order computed here.
+        from b12x.moe.fused_moe._impl import _launch_dynamic_topk_sum
+
+        reduced = torch.empty(m, K, dtype=torch.bfloat16, device=device)
+        _launch_dynamic_topk_sum(
+            route_output=scatter_output,
+            output=reduced,
+            m=m,
+            num_topk=top_k * gate_tile_cnt,
+            k=K,
+            stream=torch.cuda.current_stream().cuda_stream,
+            route_ids=flat_ids,
+            route_slices=gate_tile_cnt,
+            num_experts=E,
+        )
+        torch.cuda.synchronize()
+        live = (topk_ids >= 0) & (topk_ids < E)
+        parts = scatter_output.view(m, top_k, gate_tile_cnt, K).float()
+        expected = torch.zeros(m, K, dtype=torch.float32, device=device)
+        for route in range(top_k):
+            for part in range(gate_tile_cnt):
+                expected = expected + torch.where(
+                    live[:, route, None].to(device), parts[:, route, part], 0.0
+                )
+        assert torch.equal(reduced, expected.to(torch.bfloat16)), "masked sum differs"
         return reduced, reference
     return scatter_output, reference
 
