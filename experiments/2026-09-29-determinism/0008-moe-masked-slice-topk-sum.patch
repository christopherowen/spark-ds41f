         # coverage verifies that phase 2 really overwrites the full domain.
         if cutlass.const_expr(self.deterministic_slice_partials):
             # Every valid (pair, slice, column) location has exactly one
-            # producer.  Rows of pairs routed to no local expert are never
-            # produced, so zero those; the top-k sum reads every live row.
-            partial_row_vecs = cols_u32 // Int32(4)
-            partial_vecs = total_pairs * route_gate_tile_cnt * partial_row_vecs
-            zero_u32 = Uint32(0)
-            zv = flat_tid
-            while zv < partial_vecs:
-                partial_row = zv // partial_row_vecs
-                zero_expert = topk_ids[partial_row // route_gate_tile_cnt].to(Int32)
-                if zero_expert < Int32(0) or zero_expert >= num_experts:
-                    st_global_v4_u32(
-                        scatter_base + Int64(zv) * Int64(16),
-                        zero_u32,
-                        zero_u32,
-                        zero_u32,
