             grid = (_covering_count(total, self.cta_threads), 1, 1)
@@ -8857,6 +8900,53 @@ class W4A16TopKSumKernel:
     ):
         tidx, _, _ = cute.arch.thread_idx()
         bidx, _, _ = cute.arch.block_idx()
+        if cutlass.const_expr(self.mask_invalid_routes):
+            vecs_per_row = Int32(self.hidden_size // 8)
+            idx = Int32(bidx) * Int32(self.cta_threads) + Int32(tidx)
+            if idx < active_m * vecs_per_row:
+                token = idx // vecs_per_row
+                col = (idx - token * vecs_per_row) * Int32(8)
+                fc2_base = get_ptr_as_int64(fc2_flat, Int32(0))
+                one = cutlass.Float32(1.0)
+                a0 = cutlass.Float32(0.0)
+                a1 = cutlass.Float32(0.0)
+                a2 = cutlass.Float32(0.0)
+                a3 = cutlass.Float32(0.0)
+                a4 = cutlass.Float32(0.0)
+                a5 = cutlass.Float32(0.0)
+                a6 = cutlass.Float32(0.0)
+                a7 = cutlass.Float32(0.0)
+                routes = self.topk // self.route_slices
+                for route in cutlass.range_constexpr(routes):
+                    expert = route_expert_ids_flat[token * Int32(routes) + Int32(route)].to(Int32)
+                    if expert >= Int32(0) and expert < route_num_experts:
+                        for s in cutlass.range_constexpr(self.route_slices):
+                            row = token * Int32(self.topk) + Int32(route * self.route_slices + s)
+                            w0, w1, w2, w3 = ld_global_v4_u32(
+                                fc2_base
+                                + (Int64(row) * Int64(self.hidden_size) + Int64(col)) * Int64(2)
+                            )
+                            f0, f1 = bfloat2_to_float2_scaled(w0, one)
+                            f2, f3 = bfloat2_to_float2_scaled(w1, one)
+                            f4, f5 = bfloat2_to_float2_scaled(w2, one)
+                            f6, f7 = bfloat2_to_float2_scaled(w3, one)
+                            a0 += f0
+                            a1 += f1
+                            a2 += f2
+                            a3 += f3
+                            a4 += f4
+                            a5 += f5
+                            a6 += f6
+                            a7 += f7
+                st_global_v4_u32(
+                    get_ptr_as_int64(output_flat, Int32(0))
+                    + (Int64(token) * Int64(self.hidden_size) + Int64(col)) * Int64(2),
+                    _pack_f32x2_to_bfloat2_rn(a0, a1),
+                    _pack_f32x2_to_bfloat2_rn(a2, a3),
+                    _pack_f32x2_to_bfloat2_rn(a4, a5),
+                    _pack_f32x2_to_bfloat2_rn(a6, a7),
+                )
+            return
         if cutlass.const_expr(
             self.intermediate_hadamard and self.broadcast_svh
         ):
@@ -10657,6 +10747,8 @@ def compile_w4a16_topk_sum(
