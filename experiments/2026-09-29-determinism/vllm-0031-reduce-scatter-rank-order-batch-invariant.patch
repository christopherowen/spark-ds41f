@@ -588,6 +596,32 @@ class CudaCommunicator(DeviceCommunicatorBase):
         # Reshape before returning
         return output.movedim(0, dim).contiguous()
 
+    def _reduce_scatter_rank_order(self, input_tensor: torch.Tensor) -> torch.Tensor:
+        """Reduce-scatter that adds each row's partials in rank order.
+
+        NCCL's reduce-scatter adds the ranks' partials in an order that depends
+        on which rank receives the chunk and on the message size (ring rotation,
+        channel split), so a row's bits change with the row count of the batch
+        and the row's position in it. Exchanging the chunks (an all-to-all over
+        the same communicator, the same bytes as the reduce-scatter) and adding
+        them locally in rank order gives every row one order.
+        """
+        pynccl_comm = self.pynccl_comm
+        rank = self.rank_in_group
+        chunks = input_tensor.view(self.world_size, -1, *input_tensor.shape[1:])
+        parts = torch.empty_like(chunks)
+        pynccl_comm.group_start()
+        for peer in range(self.world_size):
+            if peer != rank:
+                pynccl_comm.send(chunks[peer], peer)
+                pynccl_comm.recv(parts[peer], peer)
+        pynccl_comm.group_end()
+        parts[rank].copy_(chunks[rank])
+        output = parts[0].clone()
+        for part in parts[1:]:
+            output.add_(part)
+        return output
+
     def reduce_scatterv(
         self, input_: torch.Tensor, dim: int = -1, sizes: list[int] | None = None
     ):
