+#pragma unroll
+    for (int first = 0; first < ROCE_WORLD - 1; first += ROCE_GATHER_GROUP) {
+        roce_pack p[ROCE_GATHER_GROUP];
+#pragma unroll
+        for (int k = 0; k < ROCE_GATHER_GROUP; k++) {
