From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Mon, 26 Oct 2026 07:21:28 +0100
Subject: [PATCH 560/560] DS4.1 IKET: sampled events in loops of zero or one
 iterations, which ptxas does not predicate

---
 .../test_deepseek_v41_tilelang_iket.py        | 24 ++++++++++-----
 vllm/models/deepseek_v4_1/tilelang/iket.py    | 29 +++++++++++++++----
 2 files changed, 39 insertions(+), 14 deletions(-)

diff --git a/tests/kernels/test_deepseek_v41_tilelang_iket.py b/tests/kernels/test_deepseek_v41_tilelang_iket.py
index ee534cf0e..6955d33eb 100644
--- a/tests/kernels/test_deepseek_v41_tilelang_iket.py
+++ b/tests/kernels/test_deepseek_v41_tilelang_iket.py
@@ -132,9 +132,15 @@ def test_sampled_ctas_guard_every_event():
     assert "gridDim.x * gridDim.y * gridDim.z / 8u" in lines[body + 1]
     events = [line.strip() for line in lines if "TL_IKET_EVENT(" in line]
     assert len(events) == 2 * len(sites)
-    assert all(e.startswith("if (__tl_iket_cta) TL_IKET_EVENT(") for e in events)
-    # Unsampled, the kernel declares nothing.
-    assert "__tl_iket_cta" not in iket.annotate(KERNEL, _token)[0]
+    # Each in a loop of zero or one iterations, which ptxas does not predicate.
+    assert all(
+        e.startswith("TL_IKET_WHEN(__tl_iket_cta) TL_IKET_EVENT(") for e in events
+    )
+    assert "#define TL_IKET_WHEN(C) " in out
+    # Unsampled, the kernel declares nothing and its events need no loop.
+    unsampled = iket.annotate(KERNEL, _token)[0]
+    assert "__tl_iket_cta" not in unsampled
+    assert "TL_IKET_WHEN" not in unsampled
 
 
 def test_sampled_iterations_guard_loop_ranges():
@@ -145,15 +151,17 @@ def test_sampled_iterations_guard_loop_ranges():
     lines = [line.strip() for line in out.splitlines()]
     in_loop = [s["range"] for s in sites if s["loops"]]
     assert in_loop == ["wait.cp_async", "wait.sync#2", "compute.mma"]
-    guarded = [line for line in lines if line.startswith(f"if ({stride}) ")]
-    # Each in-loop range: its start, its settle and its end.
-    assert len(guarded) == 3 * len(in_loop)
+    # Each in-loop range: its start and end events, and its settle.
+    events = [line for line in lines if line.startswith(f"TL_IKET_WHEN({stride}) ")]
+    assert len(events) == 2 * len(in_loop)
+    settles = [line for line in lines if line == f"if ({stride}) TL_IKET_SETTLE();"]
+    assert len(settles) == len(in_loop)
     # Ranges outside the loop, and the unrolled loop wrapped whole, have no condition;
-    # none depends on the lane (a lane's guard would leave ptxas predicating events).
+    # none depends on the lane.
     assert 'TL_IKET_EVENT(1, "__tl_iket_v1_load.cp_async");' in lines
     assert "laneid" not in out
     both = iket.annotate(KERNEL, _token, ctas=4, iters=2)[0]
-    assert f"if (__tl_iket_cta && {stride}) TL_IKET_EVENT(1," in both
+    assert f"TL_IKET_WHEN(__tl_iket_cta && {stride}) TL_IKET_EVENT(1," in both
 
 
 def test_while_loop_ranges_have_no_bound():
diff --git a/vllm/models/deepseek_v4_1/tilelang/iket.py b/vllm/models/deepseek_v4_1/tilelang/iket.py
index 2d11979cc..4da4fd41c 100644
--- a/vllm/models/deepseek_v4_1/tilelang/iket.py
+++ b/vllm/models/deepseek_v4_1/tilelang/iket.py
@@ -75,6 +75,20 @@ _SETTLE = (
     "mov.u32 a, 0x20;\\n\\t"  # ptxas takes no immediate shared address
     'ld.volatile.shared.u32 s, [a];\\n\\t}" ::: "memory")\n'
 )
+# run-iket gives every event a warp issues a slot in the warp's record, predicated off
+# or not, and ptxas predicates a short guarded block whatever its condition (the
+# sampled sparse MLA: 26 of its 64 events, so warps took 109 slots for 42 records). It
+# does not predicate a loop: a sampled event runs in a loop of zero or one iterations,
+# whose count an asm hides from the compilers.
+_WHEN = (
+    "__device__ __forceinline__ int __tl_iket_count(bool c) {\n"
+    "  int n;\n"
+    '  asm volatile("mov.b32 %0, %1;" : "=r"(n) : "r"((int)c));\n'
+    "  return n;\n"
+    "}\n"
+    '#define TL_IKET_WHEN(C) _Pragma("unroll 1") '
+    "for (int __tl_iket_n = __tl_iket_count(C); __tl_iket_n > 0; --__tl_iket_n)\n"
+)
 
 # (phase, kind, patterns): the first kind a statement matches names its phase.
 _PATTERNS = [
@@ -444,9 +458,8 @@ def annotate(
             inserts.append((code.index("\n", bodies[kernel]) + 1, 0, sample))
     for item in found:
         # Each condition holds through a range: the CTA's and its loops' iterations (a
-        # loop variable does not change inside one iteration). All are uniform in a
-        # warp: run-iket gives a slot to every event a warp issues, and ptxas branches
-        # around a uniform guard but predicates the events behind a lane's.
+        # loop variable does not change inside one iteration). Both are uniform in a
+        # warp, so a range opens and closes in a warp's every lane or in none.
         conditions = ["__tl_iket_cta"] if ctas else []
         unsampled = []
         for header in item.loops if iters else ():
@@ -455,7 +468,9 @@ def annotate(
                 unsampled.append(" ".join(header.split()))
             else:
                 conditions.append(condition)
-        guard = f"if ({' && '.join(conditions)}) " if conditions else ""
+        condition = " && ".join(conditions)
+        guard = f"if ({condition}) " if conditions else ""
+        when = f"TL_IKET_WHEN({condition}) " if conditions else ""
         sites.append(
             {
                 "kernel": item.kernel,
@@ -478,14 +493,14 @@ def annotate(
             (
                 item.first.start,
                 1,
-                f'{indent}{guard}TL_IKET_EVENT(1, "{token(item.name, range_id)}");\n',
+                f'{indent}{when}TL_IKET_EVENT(1, "{token(item.name, range_id)}");\n',
             )
         )
         # Settled: a barrier inside the range (a block sync, TileLang's AllReduce)
         # holds the range's end, not the next statement's.
         end = (
             f"{indent}{guard}TL_IKET_SETTLE();\n"
-            f"{indent}{guard}TL_IKET_EVENT({RANGE_END});\n"
+            f"{indent}{when}TL_IKET_EVENT({RANGE_END});\n"
         )
         inserts.append((item.last.end, 0, end))
     # The events a warp can record, with the loops sampled: each range opens and closes
@@ -509,6 +524,8 @@ def annotate(
         out += [code[last:offset], text]
         last = offset
     annotated = "".join(out) + code[last:]
+    if "TL_IKET_WHEN(" in annotated:
+        annotated = _WHEN + annotated
     if "TL_IKET_SETTLE();" in annotated:
         annotated = _SETTLE + annotated
     return annotated, sites
