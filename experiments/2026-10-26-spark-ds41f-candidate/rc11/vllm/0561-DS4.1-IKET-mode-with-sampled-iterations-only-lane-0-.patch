Subject: [PATCH 561/561] [DS4.1] IKET mode: with sampled iterations only lane
 0 records (divergent lanes multiply a warp's records)

---
 .../test_deepseek_v41_tilelang_iket.py        | 13 ++++--
 vllm/models/deepseek_v4_1/tilelang/iket.py    | 41 ++++++++++++-------
 2 files changed, 36 insertions(+), 18 deletions(-)

diff --git a/tests/kernels/test_deepseek_v41_tilelang_iket.py b/tests/kernels/test_deepseek_v41_tilelang_iket.py
index 4837d69da..f980646e1 100644
--- a/tests/kernels/test_deepseek_v41_tilelang_iket.py
+++ b/tests/kernels/test_deepseek_v41_tilelang_iket.py
@@ -145,13 +145,18 @@ def test_sampled_iterations_guard_loop_ranges():
     lines = [line.strip() for line in out.splitlines()]
     in_loop = [s["range"] for s in sites if s["loops"]]
     assert in_loop == ["wait.cp_async", "wait.sync#2", "compute.mma"]
-    guarded = [line for line in lines if line.startswith(f"if ({stride}) ")]
+    guarded = [
+        line for line in lines if line.startswith(f"if (__tl_iket_lane0 && {stride}) ")
+    ]
     # Each in-loop range: its start, its settle and its end.
     assert len(guarded) == 3 * len(in_loop)
-    # Ranges outside the loop, and the unrolled loop wrapped whole, are not guarded.
-    assert 'TL_IKET_EVENT(1, "__tl_iket_v1_load.cp_async");' in lines
+    # Lane 0 alone records; ranges outside the loop, and the unrolled loop wrapped
+    # whole, have no iteration condition.
+    assert "const bool __tl_iket_lane0 = __tl_iket_laneid == 0u;" in lines
+    load = 'if (__tl_iket_lane0) TL_IKET_EVENT(1, "__tl_iket_v1_load.cp_async");'
+    assert load in lines
     both = iket.annotate(KERNEL, _token, ctas=4, iters=2)[0]
-    assert f"if (__tl_iket_cta && {stride}) TL_IKET_EVENT(1," in both
+    assert f"if (__tl_iket_cta && __tl_iket_lane0 && {stride}) TL_IKET_EVENT(1," in both
 
 
 def test_module_without_kernels_is_unchanged():
diff --git a/vllm/models/deepseek_v4_1/tilelang/iket.py b/vllm/models/deepseek_v4_1/tilelang/iket.py
index 696211bf3..cd406599d 100644
--- a/vllm/models/deepseek_v4_1/tilelang/iket.py
+++ b/vllm/models/deepseek_v4_1/tilelang/iket.py
@@ -393,9 +393,10 @@ def annotate(
     spread, record their ranges (run-iket still records every warp's lifetime):
     a kernel with many CTAs and loop-carried ranges otherwise writes millions of
     records a launch. With ``iters`` > 0 a range inside a ``for`` loop records in
-    at most that many of its iterations, evenly spread: run-iket reserves the
-    run's largest warp record for every warp of every instrumented launch, so a
-    long loop of ranges in one kernel sizes the whole run's buffer. A module with
+    at most that many of its iterations, evenly spread, and only lane 0 of a warp
+    records (where lanes diverge each group of them would record): run-iket
+    reserves the run's largest warp record for every warp of every instrumented
+    launch, so one long or divergent kernel sizes the whole run's buffer. A module with
     no ``__global__`` definition comes back unchanged; a kernel with a
     preprocessor conditional in its body is left as it is."""
     found: list[_Range] = []
@@ -430,19 +431,31 @@ def annotate(
     traced = list(dict.fromkeys(item.name for item in found))[:MAX_EVENTS]
     inserts: list[tuple[int, int, str]] = []
     for kernel in dict.fromkeys(item.kernel for item in found if item.name in traced):
-        if not ctas:
-            break
-        # Uniform in a CTA, so a range opens and closes in every warp or in none.
-        sample = (
-            f"  const bool __tl_iket_cta = (((blockIdx.z * gridDim.y + blockIdx.y) * "
-            "gridDim.x + blockIdx.x) % max(1u, gridDim.x * gridDim.y * gridDim.z / "
-            f"{ctas}u)) == 0u;\n"
-        )
-        inserts.append((code.index("\n", bodies[kernel]) + 1, 0, sample))
+        sample = ""
+        if ctas:
+            # Uniform in a CTA, so a range opens and closes in every warp or in none.
+            sample += (
+                f"  const bool __tl_iket_cta = (((blockIdx.z * gridDim.y + blockIdx.y) * "
+                "gridDim.x + blockIdx.x) % max(1u, gridDim.x * gridDim.y * gridDim.z / "
+                f"{ctas}u)) == 0u;\n"
+            )
+        if iters:
+            # A warp records an event each time a group of its lanes runs it; where its
+            # lanes diverge that is many records for one statement. Lane 0 alone keeps
+            # a warp's record within the sites' bound.
+            sample += (
+                "  unsigned __tl_iket_laneid;\n"
+                '  asm volatile("mov.u32 %0, %%laneid;" : "=r"(__tl_iket_laneid));\n'
+                "  const bool __tl_iket_lane0 = __tl_iket_laneid == 0u;\n"
+            )
+        if sample:
+            inserts.append((code.index("\n", bodies[kernel]) + 1, 0, sample))
     for item in found:
-        # Each condition holds through a range: the CTA's, and its loops' iterations
-        # (a loop variable does not change inside one iteration).
+        # Each condition holds through a range: the CTA's, lane 0's, and its loops'
+        # iterations (a loop variable does not change inside one iteration).
         conditions = ["__tl_iket_cta"] if ctas else []
+        if iters:
+            conditions.append("__tl_iket_lane0")
         unsampled = []
         for header in item.loops if iters else ():
             condition = _iterations(header, iters)
