+    def _scratch_stats(
+        self, num_tokens: int, num_blocks: int
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        buf_max = getattr(self, "_local_max_buf", None)
+        buf_sumexp = getattr(self, "_local_sumexp_buf", None)
+        if (
+            buf_max is None
+            or buf_sumexp is None
+            or buf_max.shape[0] < num_tokens
+            or buf_max.shape[1] != num_blocks
+        ):
+            rows = max(num_tokens, self.features.shape[0])
+            buf_max = torch.empty(
+                rows, num_blocks, dtype=torch.float32, device=self.device
+            )
+            buf_sumexp = torch.empty_like(buf_max)
+            self._local_max_buf = buf_max
+            self._local_sumexp_buf = buf_sumexp
+        return buf_max[:num_tokens], buf_sumexp[:num_tokens]
