+            # sparse SWA (is_sparse=True) so SWA checkpoints are not evicted first.
+            assert sparse_a <= sparse_b, (
+                f"At end_token={end_a}, sparse SWA block (group {gid_a}) precedes "
+                f"dense MLA block (group {gid_b}) in eviction order!"
+            )
