+    model_out1 = ModelRunnerOutput(
+        req_ids=[req1.request_id],
+        req_id_to_index={req1.request_id: 0},
+        sampled_token_ids=[[0]],
+        logprobs=None,
+        prompt_logprobs_dict={},
+        pooler_output=[],
+    )
+    scheduler.update_from_output(sched_out1, model_out1)
+    assert req1.num_computed_tokens == 0
