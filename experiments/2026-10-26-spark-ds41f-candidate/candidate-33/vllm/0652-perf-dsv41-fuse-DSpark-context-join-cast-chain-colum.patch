     """``dst.copy_(src)`` for 2-D views of 16-byte aligned rows."""
     if src.shape != dst.shape:
@@ -242,6 +384,41 @@ def join_columns(parts: list[torch.Tensor], out: torch.Tensor) -> torch.Tensor:
