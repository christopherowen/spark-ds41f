From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Sat, 31 Oct 2026 14:53:02 +0100
Subject: [PATCH] Compact int32 HostEngramHash token_map and pin Engram worker
 to max-L2 CPUs

---
 ...test_deepseek_v41_engram_host_placement.py |  50 ++++++++
 .../deepseek_v4_1/engram_rows/_reader.c       |  54 ++++++++-
 .../deepseek_v4_1/engram_rows/host_hash.py    | 109 +++++++++++++++++-
 3 files changed, 205 insertions(+), 8 deletions(-)

diff --git a/tests/kernels/test_deepseek_v41_engram_host_placement.py b/tests/kernels/test_deepseek_v41_engram_host_placement.py
index 94ad78943..fc58c53a9 100644
--- a/tests/kernels/test_deepseek_v41_engram_host_placement.py
+++ b/tests/kernels/test_deepseek_v41_engram_host_placement.py
@@ -71,3 +71,53 @@ def test_dropped_rows_stay_unknown_in_the_step_ids():
     assert (ids[:6] == UNKNOWN).all()
     assert (ids[6:8] == 0).all()
     assert (ids[8:] == -1).all()
+
+
+def test_compact_int32_token_map_matches_int64_reference():
+    from vllm.models.deepseek_v4_1.engram_rows import host_hash
+
+    rng = np.random.default_rng(7)
+    vocab = 129_280
+    token_map = rng.integers(0, 96_000, size=vocab, dtype=np.int64)
+    multipliers = rng.integers(1, 10_000_000, size=(2, 4), dtype=np.int64) | 1
+    primes = rng.integers(100_003, 500_009, size=(2, host_hash.HEADS), dtype=np.int64)
+    offsets = np.arange(host_hash.HEADS, dtype=np.int64) * 500_000
+    offsets = np.broadcast_to(offsets, (2, host_hash.HEADS)).copy()
+
+    host = host_hash.HostEngramHash(token_map, multipliers, primes, offsets)
+    assert host.token_map.dtype == np.int32
+    assert host.token_map.nbytes == vocab * 4
+
+    tokens = rng.integers(-2, vocab + 10, size=512, dtype=np.int64)
+    tokens[17] = host_hash.IMAGE_SENTINEL
+    positions = np.arange(512, dtype=np.int64)
+
+    compressed = host.compress(tokens)
+    assert compressed.dtype == np.int64
+    got = host.hash_positions(tokens, positions)
+
+    # Compare against an explicit int64 token_map copy.
+    host.token_map = token_map.astype(np.int64)
+    host.pad = host.token_map[host_hash.PAD_TOKEN]
+    expected_compressed = host.compress(tokens)
+    expected = host.hash_positions(tokens, positions)
+
+    np.testing.assert_array_equal(compressed, expected_compressed)
+    np.testing.assert_array_equal(got, expected)
+
+
+def test_max_l2_cpus_selects_big_l2_cores(tmp_path, monkeypatch):
+    from vllm.models.deepseek_v4_1.engram_rows import host_hash
+
+    for cpu in range(20):
+        size_dir = tmp_path / f"cpu{cpu}" / "cache" / "index2"
+        size_dir.mkdir(parents=True)
+        is_x925 = (5 <= cpu <= 9) or (15 <= cpu <= 19)
+        (size_dir / "size").write_text("2048K\n" if is_x925 else "512K\n", encoding="utf-8")
+
+    expected = [5, 6, 7, 8, 9, 15, 16, 17, 18, 19]
+    assert host_hash.max_l2_cpus(tmp_path, allowed=set(range(20))) == expected
+    assert host_hash.max_l2_cpus(tmp_path, allowed={0, 1, 5, 15}) == [5, 15]
+
+    monkeypatch.setenv("SPARK_DS41F_ENGRAM_CPU_AFFINITY", "0")
+    assert host_hash.pin_to_max_l2_cpus(sysfs_root=tmp_path) == []
diff --git a/vllm/models/deepseek_v4_1/engram_rows/_reader.c b/vllm/models/deepseek_v4_1/engram_rows/_reader.c
index 110d705d0..04eb3f64d 100644
--- a/vllm/models/deepseek_v4_1/engram_rows/_reader.c
+++ b/vllm/models/deepseek_v4_1/engram_rows/_reader.c
@@ -35,6 +35,7 @@
 #include <errno.h>
 #include <liburing.h>
 #include <pthread.h>
+#include <sched.h>
 #include <stdbool.h>
 #include <stdint.h>
 #include <stdio.h>
@@ -495,10 +496,58 @@ static void queue_init(void) {
     pthread_condattr_destroy(&monotonic);
 }
 
+static unsigned worker_l2_kib;
+
+static unsigned read_cpu_l2_kib(int cpu) {
+    char path[128], buf[32];
+    snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%d/cache/index2/size", cpu);
+    FILE *f = fopen(path, "r");
+    if (!f) return 0;
+    size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+    fclose(f);
+    if (n == 0) return 0;
+    buf[n] = '\0';
+    char *end = NULL;
+    unsigned long val = strtoul(buf, &end, 10);
+    if (end == buf || val == 0) return 0;
+    while (*end == ' ' || *end == '\t') end++;
+    if (*end == 'M' || *end == 'm') return (unsigned)(val * 1024ul);
+    if (*end == 'G' || *end == 'g') return (unsigned)(val * 1024ul * 1024ul);
+    return (unsigned)val;
+}
+
+static void pin_worker_to_max_l2_cpus(void) {
+    const char *env = getenv("SPARK_DS41F_ENGRAM_CPU_AFFINITY");
+    if (env && strcmp(env, "0") == 0) return;
+    cpu_set_t allowed;
+    CPU_ZERO(&allowed);
+    if (sched_getaffinity(0, sizeof(allowed), &allowed) != 0) return;
+    unsigned max_kib = 0;
+    cpu_set_t best;
+    CPU_ZERO(&best);
+    for (int cpu = 0; cpu < CPU_SETSIZE; cpu++) {
+        if (!CPU_ISSET(cpu, &allowed)) continue;
+        unsigned kib = read_cpu_l2_kib(cpu);
+        if (kib > max_kib) {
+            max_kib = kib;
+            CPU_ZERO(&best);
+            CPU_SET(cpu, &best);
+        } else if (kib > 0 && kib == max_kib) {
+            CPU_SET(cpu, &best);
+        }
+    }
+    if (max_kib > 0 && CPU_COUNT(&best) > 0) {
+        if (sched_setaffinity(0, sizeof(best), &best) == 0) {
+            __atomic_store_n(&worker_l2_kib, max_kib, __ATOMIC_RELAXED);
+        }
+    }
+}
+
 static void *worker_main(void *arg) {
     (void)arg;
     /* Sleep as asked: the default 50 us timer slack would stretch every 10 us poll. */
     prctl(PR_SET_TIMERSLACK, 1UL, 0, 0, 0);
+    pin_worker_to_max_l2_cpus();
     pthread_mutex_lock(&queue.mutex);
     for (;;) {
         while (queue.head == queue.tail) pthread_cond_wait(&queue.wake, &queue.mutex);
@@ -780,12 +829,13 @@ static PyObject *py_status(PyObject *self, PyObject *capsule) {
     Py_END_ALLOW_THREADS
     PyObject *message = failure.message[0] ? PyUnicode_FromString(failure.message) : Py_NewRef(Py_None);
     if (!message) return NULL;
-    PyObject *result = Py_BuildValue("{s:N,s:K,s:K,s:K,s:K,s:d,s:d,s:d,s:d}", "failure", message, "steps",
+    unsigned l2_kib = __atomic_load_n(&worker_l2_kib, __ATOMIC_RELAXED);
+    PyObject *result = Py_BuildValue("{s:N,s:K,s:K,s:K,s:K,s:d,s:d,s:d,s:d,s:I}", "failure", message, "steps",
                                      (unsigned long long)steps, "lookups", (unsigned long long)lookups,
                                      "early_lookups", (unsigned long long)early, "queued",
                                      (unsigned long long)queued, "ids_wait_seconds", ids_wait,
                                      "read_seconds", read, "consumed_wait_seconds", consumed_wait,
-                                     "early_read_seconds", early_read);
+                                     "early_read_seconds", early_read, "worker_l2_kib", l2_kib);
     return result;
 }
 
diff --git a/vllm/models/deepseek_v4_1/engram_rows/host_hash.py b/vllm/models/deepseek_v4_1/engram_rows/host_hash.py
index dd52a77fa..234868358 100644
--- a/vllm/models/deepseek_v4_1/engram_rows/host_hash.py
+++ b/vllm/models/deepseek_v4_1/engram_rows/host_hash.py
@@ -14,6 +14,9 @@ reader can be handed those rows early and the GPU's ids for them are never neede
 row" (a padding token past the step's live tokens), as the GPU writes it.
 """
 
+import os
+from pathlib import Path
+
 import numpy as np
 
 HEADS = 24
@@ -23,11 +26,92 @@ IMAGE_SENTINEL = 129264
 UNKNOWN = np.iinfo(np.int64).min
 
 
+def _parse_cache_kib(raw: str) -> int:
+    text = raw.strip().upper()
+    if not text:
+        return 0
+    if text.endswith("K"):
+        return int(text[:-1])
+    if text.endswith("M"):
+        return int(text[:-1]) * 1024
+    if text.endswith("G"):
+        return int(text[:-1]) * 1024 * 1024
+    return max(1, int(text) // 1024)
+
+
+def max_l2_cpus(
+    sysfs_root: str | os.PathLike[str] = "/sys/devices/system/cpu",
+    allowed: set[int] | None = None,
+) -> list[int]:
+    """Return the online CPUs with the largest private L2 cache (`cache/index2/size`).
+
+    On GB10's 20-core Grace CPU, `cpu0..4` and `cpu10..14` are Cortex-A725 cores with a
+    512 KiB L2, while `cpu5..9` and `cpu15..19` are Cortex-X925 cores with a 2048 KiB L2.
+    """
+    root = Path(sysfs_root)
+    if allowed is None and hasattr(os, "sched_getaffinity"):
+        try:
+            allowed = set(os.sched_getaffinity(0))
+        except OSError:
+            allowed = None
+    best_kib = 0
+    best_cpus: list[int] = []
+    if not root.is_dir():
+        return sorted(allowed) if allowed else []
+    for entry in root.iterdir():
+        name = entry.name
+        if not (name.startswith("cpu") and name[3:].isdigit()):
+            continue
+        cpu = int(name[3:])
+        if allowed is not None and cpu not in allowed:
+            continue
+        size_path = entry / "cache" / "index2" / "size"
+        try:
+            kib = _parse_cache_kib(size_path.read_text(encoding="utf-8"))
+        except OSError:
+            continue
+        if kib > best_kib:
+            best_kib = kib
+            best_cpus = [cpu]
+        elif kib == best_kib and kib > 0:
+            best_cpus.append(cpu)
+    best_cpus.sort()
+    if best_cpus:
+        return best_cpus
+    return sorted(allowed) if allowed else []
+
+
+def pin_to_max_l2_cpus(
+    pid: int = 0,
+    sysfs_root: str | os.PathLike[str] = "/sys/devices/system/cpu",
+) -> list[int]:
+    """Pin thread/process `pid` to the allowed CPUs with the largest L2 cache."""
+    if os.environ.get("SPARK_DS41F_ENGRAM_CPU_AFFINITY") == "0":
+        return []
+    cpus = max_l2_cpus(sysfs_root=sysfs_root)
+    if cpus and hasattr(os, "sched_setaffinity"):
+        try:
+            os.sched_setaffinity(pid, set(cpus))
+        except OSError:
+            return []
+    return cpus
+
+
 class HostEngramHash:
     """The hash geometry and tokenizer map of a model's Engram layers, on the host."""
 
     def __init__(self, token_map, multipliers, primes, offsets):
-        self.token_map = np.asarray(token_map, dtype=np.int64)
+        token_map_arr = np.asarray(token_map)
+        if (
+            token_map_arr.size == 0
+            or (
+                int(token_map_arr.min()) >= np.iinfo(np.int32).min
+                and int(token_map_arr.max()) <= np.iinfo(np.int32).max
+            )
+        ):
+            self.token_map = np.asarray(token_map_arr, dtype=np.int32)
+        else:
+            self.token_map = np.asarray(token_map_arr, dtype=np.int64)
         self.multipliers = np.asarray(multipliers, dtype=np.int64)  # [layers, 4]
         self.primes = np.asarray(primes, dtype=np.int64)  # [layers, 24]
         self.offsets = np.asarray(offsets, dtype=np.int64)  # [layers, 24]
@@ -42,13 +126,19 @@ class HostEngramHash:
             )
         self.pad = self.token_map[PAD_TOKEN]
         self.vocab = self.token_map.shape[0]
+        if os.environ.get("SPARK_DS41F_ENGRAM_HOST_HASH_AFFINITY", "1") != "0":
+            pin_to_max_l2_cpus(0)
+
+    def _compress_compact(self, raw: np.ndarray) -> np.ndarray:
+        raw = np.asarray(raw, dtype=np.int64)
+        valid = (raw >= 0) & (raw < self.vocab) & (raw != IMAGE_SENTINEL)
+        missing = self.token_map.dtype.type(-1)
+        return np.where(valid, self.token_map[np.where(valid, raw, 0)], missing)
 
     def compress(self, raw: np.ndarray) -> np.ndarray:
         """Compressed ids of raw token ids; -1 for a missing token (negative), an
         image token or one outside the tokenizer map."""
-        raw = np.asarray(raw, dtype=np.int64)
-        valid = (raw >= 0) & (raw < self.vocab) & (raw != IMAGE_SENTINEL)
-        return np.where(valid, self.token_map[np.where(valid, raw, 0)], -1)
+        return self._compress_compact(raw).astype(np.int64, copy=False)
 
     def hash_positions(self, tokens: np.ndarray, positions: np.ndarray) -> np.ndarray:
         """Row ids ``[len(positions), layers, 24]`` of the tokens at ``positions``
@@ -57,7 +147,7 @@ class HostEngramHash:
         positions = np.asarray(positions, dtype=np.int64)
         lags = positions[:, None] - np.arange(LAGS, dtype=np.int64)[None, :]  # [T, 4]
         raw = np.where(lags >= 0, tokens[np.maximum(lags, 0)], -1)
-        sources = self.compress(raw)
+        sources = self._compress_compact(raw)
         # From the first missing source on, every lag takes the pad id.
         blocked = np.logical_or.accumulate(sources == -1, axis=1)
         values = np.where(blocked, self.pad, sources)
@@ -122,4 +212,11 @@ def placed_by_host(requests: list, drafts: np.ndarray | None) -> list:
     ]
 
 
-__all__ = ["HEADS", "UNKNOWN", "HostEngramHash", "placed_by_host"]
+__all__ = [
+    "HEADS",
+    "UNKNOWN",
+    "HostEngramHash",
+    "max_l2_cpus",
+    "pin_to_max_l2_cpus",
+    "placed_by_host",
+]
