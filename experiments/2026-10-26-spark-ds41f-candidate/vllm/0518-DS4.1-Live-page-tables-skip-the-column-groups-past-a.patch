From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Sun, 25 Oct 2026 23:18:11 +0100
Subject: [PATCH 518/518] [DS4.1] Live-page tables: skip the column groups past
 a row's live pages

decode_metadata's page part checks each group of four of a thread's columns
against the row's live pages once, with a check the block shares, in both the
load and the store pass. A long context's loads still issue back to back; a
short row's threads skip most of the table, as a loop over its live pages did.

A new test covers rows whose live pages span several column groups, up to a 1M
context's 4,096-column table.
---
 .../test_deepseek_v41_tilelang_metadata.py    | 47 +++++++++++++++++++
 .../models/deepseek_v4_1/tilelang/metadata.py | 36 +++++++++-----
 2 files changed, 71 insertions(+), 12 deletions(-)

diff --git a/tests/kernels/test_deepseek_v41_tilelang_metadata.py b/tests/kernels/test_deepseek_v41_tilelang_metadata.py
index 91535a489..9f3b02999 100644
--- a/tests/kernels/test_deepseek_v41_tilelang_metadata.py
+++ b/tests/kernels/test_deepseek_v41_tilelang_metadata.py
@@ -308,6 +308,53 @@ def test_decode_metadata_equals_chunk_and_pages(lengths, draft, replay, main_pag
     _live_equal(main_pages, pages, live, rows)
 
 
+@pytest.mark.parametrize(
+    "main_width, read_width", [(1100, 1100), (4096, 4096), (4096, 2500)]
+)
+@pytest.mark.parametrize("main_page", [64, 256])
+def test_decode_metadata_wide_tables(main_width, read_width, main_page):
+    """Rows whose live pages span several of the page part's column groups, up to the
+    4,096 columns of a 1M context's table (the other tests' tables fit in one)."""
+    page, window, width, rows = 64, 128, 128, 64
+    g = torch.Generator().manual_seed(main_width + read_width + main_page)
+    reqs = torch.randint(-1, R, (rows,), generator=g, dtype=torch.int32)
+    # Visible entries from none to past the table's width: full, partial and empty
+    # groups, and rows without a request.
+    visible = torch.randint(
+        -3, (read_width + 2) * main_page, (rows,), generator=g, dtype=torch.int32
+    )
+    pos = torch.randint(0, 2000, (rows,), generator=g)
+    table = torch.randint(
+        0, 1 << 20, (R, read_width + 8), generator=g, dtype=torch.int32
+    )
+    table[:, 3] = 0  # holes
+    qsl = torch.arange(R + 1, dtype=torch.int32)
+    request_positions = torch.randint(-5, 900, (R,), generator=g)
+    reqs, visible, pos, qsl, request_positions = (
+        t.to(DEVICE) for t in (reqs, visible, pos, qsl, request_positions)
+    )
+    table = table.to(DEVICE)[:, :read_width]
+    swa = torch.full((rows, width), 7, dtype=torch.int32, device=DEVICE)
+    lengths_out = torch.full((rows,), 7, dtype=torch.int32, device=DEVICE)
+    top = torch.full((rows,), 7, dtype=torch.int32, device=DEVICE)
+    main_pages = torch.full((rows, main_width), 7, dtype=torch.int32, device=DEVICE)
+    metadata.decode_metadata(
+        pos, reqs, table, swa, lengths_out, top, visible, qsl, request_positions,
+        reqs, table, main_pages, 0, rows, read_width, page=page, window=window,
+        draft=False, main_page=main_page,
+    )  # fmt: skip
+    expected = _ref_chunk(
+        pos, reqs, table, visible, qsl, request_positions, 0, rows, width, page,
+        window, False, None,
+    )  # fmt: skip
+    for actual, reference in zip((swa, lengths_out, top), expected):
+        _rows_equal(actual, reference, rows)
+    pages = _ref_pages(reqs, table, 0, rows, main_width, read_width)
+    live = _live_columns(reqs, visible, 0, rows, main_page, read_width, main_width)
+    assert int(live.max()) > 4 * 128, "no row spans more than one column group"
+    _live_equal(main_pages, pages, live, rows)
+
+
 @torch.inference_mode()
 def test_metadata_refresh_preserves_padded_graph_domain_and_addresses():
     from vllm.models.deepseek_v4_1.sparse_mla import DeepseekV41B12xMetadataBuilder
diff --git a/vllm/models/deepseek_v4_1/tilelang/metadata.py b/vllm/models/deepseek_v4_1/tilelang/metadata.py
index 38af81b9a..4459317e1 100644
--- a/vllm/models/deepseek_v4_1/tilelang/metadata.py
+++ b/vllm/models/deepseek_v4_1/tilelang/metadata.py
@@ -34,6 +34,7 @@ import tilelang.language as T
 _PASS = {tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True}
 _BLOCK = 128
 _TOP = 512  # top-k length cap
+_GROUP = 4  # decode_metadata's page columns a thread takes per live-page check
 
 
 def _search_steps(requests: int) -> int:
@@ -278,10 +279,13 @@ def decode_metadata_kernel(
     # (idle threads cost the prefill rows' blocks). It loads the thread's columns
     # first, each load a select (predicated, no branch), then stores the live ones,
     # so a long context's loads issue back to back as the full-width kernel's did. A
-    # load and its store under one branch per column wait a round trip each.
+    # load and its store under one branch per column wait a round trip each. Both
+    # passes skip each group of _GROUP columns a thread past the row's live pages
+    # with one check the block shares, so a short row's threads skip most of the
+    # table as a loop over its live pages would.
     threads, per_thread = _threads(width)
     window_row = _window_macro(page, window, width, draft, replay, threads, per_thread)
-    main_per_thread = (main_width + threads - 1) // threads
+    groups = (main_width + _GROUP * threads - 1) // (_GROUP * threads)
 
     @T.prim_func
     def metadata_decode(
@@ -306,7 +310,7 @@ def decode_metadata_kernel(
             tx = T.get_thread_binding()
             info = T.alloc_local((2,), T.int64)  # window start, clamped length
             live = T.alloc_var(T.int32)  # the page part's columns
-            entries = T.alloc_local((main_per_thread,), T.int32)
+            entries = T.alloc_local((groups * _GROUP,), T.int32)
             if part == 0:
                 window_row(
                     row, tx, info, positions, reqs, table, swa, lengths, top_lengths,
@@ -319,15 +323,23 @@ def decode_metadata_kernel(
                 )
                 if req < 0:
                     live = 0
-                for k in T.unroll(main_per_thread):
-                    entries[k] = T.if_then_else(
-                        k * threads + tx < live, main_table[req, k * threads + tx], 0
-                    )
-                for k in T.unroll(main_per_thread):
-                    if k * threads + tx < live:
-                        main_pages[row, k * threads + tx] = T.if_then_else(
-                            entries[k] > 0, entries[k], -1
-                        )
+                for g in T.unroll(groups):
+                    if g * _GROUP * threads < live:
+                        for k in T.unroll(_GROUP):
+                            col = (g * _GROUP + k) * threads + tx
+                            entries[g * _GROUP + k] = T.if_then_else(
+                                col < live, main_table[req, col], 0
+                            )
+                for g in T.unroll(groups):
+                    if g * _GROUP * threads < live:
+                        for k in T.unroll(_GROUP):
+                            col = (g * _GROUP + k) * threads + tx
+                            if col < live:
+                                main_pages[row, col] = T.if_then_else(
+                                    entries[g * _GROUP + k] > 0,
+                                    entries[g * _GROUP + k],
+                                    -1,
+                                )
 
     return metadata_decode
 
