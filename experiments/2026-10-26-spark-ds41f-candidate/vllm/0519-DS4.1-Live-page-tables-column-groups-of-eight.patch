From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Sun, 25 Oct 2026 23:24:19 +0100
Subject: [PATCH 519/519] [DS4.1] Live-page tables: column groups of eight

Diagnostics round 3 timed groups of 1, 4 and 8 of a thread's columns: eight is
level or faster than four at every shape (a 16K prefill chunk 46 against 54 us,
c1 at a 1M context 2.0 against 2.2). The wide-table test now forces a row past
the table's width, so it spans several groups whatever the group size.
---
 tests/kernels/test_deepseek_v41_tilelang_metadata.py | 3 ++-
 vllm/models/deepseek_v4_1/tilelang/metadata.py       | 2 +-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/tests/kernels/test_deepseek_v41_tilelang_metadata.py b/tests/kernels/test_deepseek_v41_tilelang_metadata.py
index 9f3b02999..9222f3c17 100644
--- a/tests/kernels/test_deepseek_v41_tilelang_metadata.py
+++ b/tests/kernels/test_deepseek_v41_tilelang_metadata.py
@@ -323,6 +323,7 @@ def test_decode_metadata_wide_tables(main_width, read_width, main_page):
     visible = torch.randint(
         -3, (read_width + 2) * main_page, (rows,), generator=g, dtype=torch.int32
     )
+    reqs[0], visible[0] = 0, (read_width + 2) * main_page  # past the table's width
     pos = torch.randint(0, 2000, (rows,), generator=g)
     table = torch.randint(
         0, 1 << 20, (R, read_width + 8), generator=g, dtype=torch.int32
@@ -351,7 +352,7 @@ def test_decode_metadata_wide_tables(main_width, read_width, main_page):
         _rows_equal(actual, reference, rows)
     pages = _ref_pages(reqs, table, 0, rows, main_width, read_width)
     live = _live_columns(reqs, visible, 0, rows, main_page, read_width, main_width)
-    assert int(live.max()) > 4 * 128, "no row spans more than one column group"
+    assert int(live.max()) > metadata._GROUP * 128, "no row spans two column groups"
     _live_equal(main_pages, pages, live, rows)
 
 
diff --git a/vllm/models/deepseek_v4_1/tilelang/metadata.py b/vllm/models/deepseek_v4_1/tilelang/metadata.py
index 4459317e1..179405a01 100644
--- a/vllm/models/deepseek_v4_1/tilelang/metadata.py
+++ b/vllm/models/deepseek_v4_1/tilelang/metadata.py
@@ -34,7 +34,7 @@ import tilelang.language as T
 _PASS = {tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True}
 _BLOCK = 128
 _TOP = 512  # top-k length cap
-_GROUP = 4  # decode_metadata's page columns a thread takes per live-page check
+_GROUP = 8  # decode_metadata's page columns a thread takes per live-page check
 
 
 def _search_steps(requests: int) -> int:
