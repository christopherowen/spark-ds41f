+    if dead_rows:
+        # The draft combine's cut: a request's live drafts, or for one it does not
+        # clamp its block of eight plus one. Row j is draft j - 1's input.
+        live = torch.randint(0, 1 << 30, (reqs,), generator=g, device="cuda")
