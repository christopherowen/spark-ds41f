+    weight_map = {name: "a.safetensors" for name in mixed}
+    weight_map.update({name: "b.safetensors" for name in tables})
+    weight_map.update({name: "c.safetensors" for name in plain})
+    index = tmp_path / "model.safetensors.index.json"
