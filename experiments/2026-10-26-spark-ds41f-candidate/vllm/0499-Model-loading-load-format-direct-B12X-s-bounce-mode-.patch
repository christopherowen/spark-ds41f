+            "model.c": torch.ones(6),
+        },
+    )
+    (tmp_path / "other.safetensors").write_bytes(b"")
+    index = tmp_path / "model.safetensors.index.json"
+    index.write_text(
+        json.dumps(
+            {
+                "weight_map": {
+                    "mtp.a": "model.safetensors",
+                    "mtp.b": "model.safetensors",
+                    "mtp.skipped": "model.safetensors",
