+        if source.device.type != "meta":
+            if (
+                source.device.type == "cpu"
+                and source.dtype == destination.dtype
+                and (
+                    source.shape == destination.shape
+                    or source.numel() == destination.numel() == 1
+                )
+                and source.is_contiguous()
