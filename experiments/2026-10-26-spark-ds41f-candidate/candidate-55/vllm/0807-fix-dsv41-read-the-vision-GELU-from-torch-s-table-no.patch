+def gelu_table(device) -> torch.Tensor:
+    """DeepSeek's reference GELU of every BF16 value: ``F.gelu`` as torch evaluates
+    it on ``device``, indexed by the value's 16 bits read as an unsigned integer
+    (NaN and the infinities included; the GELU epilogues' ``Gelu`` operand)."""
+    bits = torch.arange(GELU_TABLE_SIZE, dtype=torch.int32, device=device)
+    signed = torch.where(bits < 1 << 15, bits, bits - GELU_TABLE_SIZE)
+    return F.gelu(signed.to(torch.int16).view(torch.bfloat16))
+
+
+def _gelu(value, table):
+    """DeepSeek's reference GELU of a BF16 value: its entry of ``gelu_table``."""
+    return table[T.reinterpret(value, T.uint16)]
 
 
