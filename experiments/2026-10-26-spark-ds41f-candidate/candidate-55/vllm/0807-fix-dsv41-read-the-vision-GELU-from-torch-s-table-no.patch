     out = torch.empty(rows, aligner.out_dim, dtype=torch.bfloat16, device=DEVICE)
-    vision.resolve(call)(merged, aligner.w1.weight, aligner.w1.bias, out)
+    table = (vision.gelu_table(DEVICE),) if gelu else ()
