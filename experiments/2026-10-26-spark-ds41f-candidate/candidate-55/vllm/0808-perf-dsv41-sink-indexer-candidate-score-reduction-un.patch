From b210993fd700754d0eeaaabe0713e9de08c53ed9 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Sat, 14 Nov 2026 07:16:11 +0100
Subject: [PATCH] perf(dsv41): sink indexer candidate score reduction under
 valid slot check

Upstream base: 95364cdf77d063e5fb992ba7830633efce0c3243

Rationale: With CUDA 13.5 nvcc, candidate-mode indexer_score_v41 hoists and predicates the [64, 32] shared-memory reduction and bfloat16 score store out of the valid-block check, adding ~0.28 ms to 16384x256 candidate scoring (-1.02% 256K prefill regression on tp4-ring). Sinking the block reduction and bf16 store into __tl_reduce_store_scores_candidates with an asm memory barrier inside if (blk >= 0) prevents hoisting when use_vec128 and candidates is true, cutting kernel time from 0.9028 ms to 0.6246 ms while leaving dense and non-vec128 paths unchanged.

Quality implications: None; outputs are bit-identical and arithmetic order across the 32 heads is unchanged.

Tests: pytest --noconftest tests/kernels/attention/test_deepseek_v41_tilelang.py (65 passed, 1 skipped, 1 xfailed in candidate-55-b6).

Upstream status: local candidate-55 patch
---
 .../attention/test_deepseek_v41_tilelang.py   | 12 ++--
 vllm/models/deepseek_v4_1/tilelang/indexer.py | 66 ++++++++++++++++---
 2 files changed, 64 insertions(+), 14 deletions(-)

diff --git a/tests/kernels/attention/test_deepseek_v41_tilelang.py b/tests/kernels/attention/test_deepseek_v41_tilelang.py
index 53cd29825..3ba57c9f9 100644
--- a/tests/kernels/attention/test_deepseek_v41_tilelang.py
+++ b/tests/kernels/attention/test_deepseek_v41_tilelang.py
@@ -1364,9 +1364,13 @@ def test_indexer_score_vectorizes_kpool_loads_and_coschedules_dense_rows():
     from vllm.models.deepseek_v4_1.tilelang.indexer import indexer_score_v41
 
     dense_src = indexer_score_v41(32768, 256, candidates=False).get_kernel_source()
-    assert "__tl_load_k_shared_dense(" in dense_src
-    assert "(((int)blockIdx.y) * 128 + ((int)blockIdx.x)) / rows" in dense_src or "/ rows" in dense_src
-    assert "% rows" in dense_src
+    dense_body = dense_src.split("__global__", 1)[1]
+    assert "__tl_load_k_shared_dense(" in dense_body
+    assert "(((int)blockIdx.y) * 128 + ((int)blockIdx.x)) / rows" in dense_body or "/ rows" in dense_body
+    assert "% rows" in dense_body
+    assert "__tl_reduce_store_scores_candidates(" not in dense_body
 
     cand_src = indexer_score_v41(16384, 256, candidates=True).get_kernel_source()
-    assert "__tl_load_k_shared_candidates(" in cand_src
+    cand_body = cand_src.split("__global__", 1)[1]
+    assert "__tl_load_k_shared_candidates(" in cand_body
+    assert "__tl_reduce_store_scores_candidates(" in cand_body
diff --git a/vllm/models/deepseek_v4_1/tilelang/indexer.py b/vllm/models/deepseek_v4_1/tilelang/indexer.py
index c67fe24a7..dd7d3408d 100644
--- a/vllm/models/deepseek_v4_1/tilelang/indexer.py
+++ b/vllm/models/deepseek_v4_1/tilelang/indexer.py
@@ -253,6 +253,38 @@ __device__ __forceinline__ void __tl_load_k_shared_candidates(
     }
     __syncthreads();
 }
+
+__device__ __forceinline__ void __tl_reduce_store_scores_candidates(
+    const float* __restrict__ contrib,
+    const int* __restrict__ Candidates,
+    bfloat16_t* __restrict__ Scores,
+    int row,
+    int p0,
+    int extent,
+    int width,
+    int blocks
+) {
+    int tx = threadIdx.x;
+    __syncthreads();
+    if (tx < 64) {
+        int j = p0 + tx;
+        if (j < extent && j < width) {
+            int blk = Candidates[(int64_t)row * blocks + (j >> 3)];
+            if (blk >= 0) {
+                asm volatile("" ::: "memory");
+                float s = 0.0f;
+                const float* c_row = contrib + tx * 32;
+                #pragma unroll
+                for (int h = 0; h < 32; ++h) {
+                    s += c_row[h];
+                }
+                Scores[(int64_t)row * width + j] = (bfloat16_t)s;
+            } else {
+                Scores[(int64_t)row * width + j] = (std::numeric_limits<bfloat16_t>::infinity() * bfloat16_t(-1.0f));
+            }
+        }
+    }
+}
 """
 
 
@@ -478,17 +510,31 @@ def indexer_score_v41(
                     contrib[p, h] = T.cast(
                         T.cast(T.fmul(dot, W_shared[h]), T.bfloat16), accum_dtype
                     )
-                T.fill(total, 0)
-                for h in T.serial(heads):  # increasing head order, FP32
+                if use_vec128 and candidates:
+                    T.call_extern(
+                        "handle",
+                        "__tl_reduce_store_scores_candidates",
+                        T.address_of(contrib[0, 0]),
+                        T.address_of(Candidates[0, 0]),
+                        T.address_of(Scores[0, 0]),
+                        row,
+                        p0,
+                        extent,
+                        width,
+                        blocks,
+                    )
+                else:
+                    T.fill(total, 0)
+                    for h in T.serial(heads):  # increasing head order, FP32
+                        for p in T.Parallel(block_P):
+                            total[p] += contrib[p, h]
                     for p in T.Parallel(block_P):
-                        total[p] += contrib[p, h]
-                for p in T.Parallel(block_P):
-                    if p0 + p < extent:
-                        Scores[row, p0 + p] = T.if_then_else(
-                            slot_valid(p0, p),
-                            T.cast(total[p], T.bfloat16),
-                            -T.infinity(T.bfloat16),
-                        )
+                        if p0 + p < extent:
+                            Scores[row, p0 + p] = T.if_then_else(
+                                slot_valid(p0, p),
+                                T.cast(total[p], T.bfloat16),
+                                -T.infinity(T.bfloat16),
+                            )
 
     if not candidates:
 
-- 
