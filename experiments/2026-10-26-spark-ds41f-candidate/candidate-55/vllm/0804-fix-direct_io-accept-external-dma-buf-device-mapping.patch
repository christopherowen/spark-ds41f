@@ -432,6 +432,68 @@ def test_expandable_weights_span_cuda_mappings_and_reject_unmapped_tail(tmp_path
     )
 
 
+def test_external_dmabuf_carveout_loads_and_rejects_out_of_bounds(
+    tmp_path, monkeypatch
+):
+    """Imported DRM dma-buf weights (display_carveout) must pass device_range
+    including under CUDA 13.5 forward compatibility, while still rejecting
+    out-of-bounds extents and pinned host buffers."""
+    from vllm.v1.worker import display_carveout
+
+    if not Path(display_carveout._DRM_NODE).exists():
+        pytest.skip("requires /dev/dri/card0")
+    torch.cuda.set_device(0)
+    monkeypatch.setattr(display_carveout, "_REQUIRED", True)
+    monkeypatch.setattr(display_carveout, "_carveouts", [])
+    expected = torch.arange((64 << 20) // 2, dtype=torch.int32).to(
+        torch.bfloat16
+    ).reshape(8192, 4096)
+    path = tmp_path / "carveout.safetensors"
+    save_file({"weight": expected}, path)
+    try:
+        target = display_carveout.allocate(
+            expected.shape, expected.dtype, "cuda:0"
+        )
+    except RuntimeError as exc:
+        pytest.skip(f"display carve-out unavailable: {exc}")
+    assert target is not None
+    carve_bytes = display_carveout._carveouts[0].nbytes
+    try:
+        with DirectWeightSession() as session:
+            source = dict(session.weights([path]))["weight"]
+            assert session(target, source)
+            session.flush()
+            torch.testing.assert_close(target.cpu(), expected, rtol=0, atol=0)
+            with pytest.raises(RuntimeError, match="CUDA device allocation"):
+                session._execute(
+                    array(
+                        "Q",
+                        (
+                            session.files[0],
+                            0,
+                            carve_bytes + 4096,
+                            target.data_ptr(),
+                            0,
+                            1,
+                            0,
+                            0,
+                        ),
+                    )
+                )
+            pinned = torch.empty(8192, dtype=torch.uint8, pin_memory=True)
+            with pytest.raises(RuntimeError, match="CUDA device allocation"):
+                session._execute(
+                    array(
+                        "Q",
+                        (session.files[0], 0, 4096, pinned.data_ptr(), 0, 1, 0, 0),
+                    )
+                )
+    finally:
+        for carveout in list(display_carveout._carveouts):
+            carveout.close()
+        display_carveout._carveouts.clear()
+
+
