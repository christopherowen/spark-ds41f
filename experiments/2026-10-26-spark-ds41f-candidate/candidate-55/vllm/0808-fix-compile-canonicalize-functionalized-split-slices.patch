+            raw_dim = self._get_arg(node, 2, "dim", 0)
+            dim = self._normalize_dim(raw_dim, source_val.dim())
+            candidates = split_nodes[(source, dim)]
             canonical = next(
                 (
-                    n
-                    for n in split_nodes[arg_node]
-                    if list(n.args[1]) == list(split_sizes)
+                    candidate
+                    for candidate in candidates
+                    if list(candidate.args[1]) == list(split_sizes)
                 ),
                 None,
             )
@@ -65,6 +210,16 @@ class SplitCoalescingPass(VllmInductorPass):
                 graph.erase_node(node)
                 count += 1
             else:
-                split_nodes[arg_node].append(node)
+                candidates.append(node)
+
+        return count
 
-        logger.debug("Coalesced %d duplicate split_with_sizes nodes", count)
+    @VllmInductorPass.time_and_log
+    def __call__(self, graph: fx.Graph) -> None:
+        canonicalized = self._canonicalize_slices(graph)
+        coalesced = self._coalesce_splits(graph)
