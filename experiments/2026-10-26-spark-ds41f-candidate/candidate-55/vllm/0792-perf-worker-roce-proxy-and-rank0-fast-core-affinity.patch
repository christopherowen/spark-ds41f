index 000000000..bf37805ea
--- /dev/null
+++ b/tests/v1/worker/test_roce_cpu_affinity.py
@@ -0,0 +1,199 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Tests for GB10 heterogeneous CPU topology discovery and RoCE proxy / worker /
+Rank-0 API server deterministic core affinity partitioning."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from vllm.models.deepseek_v4_1.engram_rows import host_hash
+from vllm.utils import cpu_affinity
+
+
+def _populate_gb10_sysfs(
+    root: Path,
+    *,
+    with_cpufreq: bool = True,
+    with_capacity: bool = True,
+    with_l2: bool = True,
+) -> None:
+    """Create a synthetic 20-core NVIDIA GB10 sysfs CPU hierarchy."""
+    for cpu in range(20):
+        is_x925 = (5 <= cpu <= 9) or (15 <= cpu <= 19)
+        cpu_dir = root / f"cpu{cpu}"
+        cpu_dir.mkdir(parents=True, exist_ok=True)
+        if with_cpufreq:
+            freq_dir = cpu_dir / "cpufreq"
+            freq_dir.mkdir(exist_ok=True)
+            (freq_dir / "cpuinfo_max_freq").write_text(
+                "3900000\n" if is_x925 else "2808000\n",
+                encoding="utf-8",
+            )
+        if with_capacity:
+            (cpu_dir / "cpu_capacity").write_text(
+                "1024\n" if is_x925 else "725\n",
+                encoding="utf-8",
+            )
+        if with_l2:
+            l2_dir = cpu_dir / "cache" / "index2"
+            l2_dir.mkdir(parents=True, exist_ok=True)
+            (l2_dir / "size").write_text(
+                "2048K\n" if is_x925 else "512K\n",
+                encoding="utf-8",
+            )
+
+
+def test_parse_and_format_cpu_list_round_trip():
+    cpus = [5, 6, 7, 8, 9, 15, 16, 17, 18, 19]
+    assert cpu_affinity.format_cpu_list(cpus) == "5-9,15-19"
+    assert cpu_affinity.parse_cpu_list("5-9,15-19") == cpus
+    assert cpu_affinity.parse_cpu_list("19") == [19]
+    assert cpu_affinity.format_cpu_list([19]) == "19"
+    with pytest.raises(ValueError):
+        cpu_affinity.parse_cpu_list("9-5")
+
+
+@pytest.mark.parametrize(
+    "flags",
+    [
+        {"with_cpufreq": True, "with_capacity": True, "with_l2": True},
+        {"with_cpufreq": False, "with_capacity": True, "with_l2": False},
+        {"with_cpufreq": False, "with_capacity": False, "with_l2": True},
+    ],
+)
+def test_discover_gb10_topology_across_metric_sources(tmp_path: Path, flags: dict):
+    _populate_gb10_sysfs(tmp_path, **flags)
+    fast, eff = cpu_affinity.discover_cpu_topology(
+        sysfs_root=tmp_path, allowed=set(range(20))
+    )
+    assert fast == (5, 6, 7, 8, 9, 15, 16, 17, 18, 19)
+    assert eff == (0, 1, 2, 3, 4, 10, 11, 12, 13, 14)
+
+    # Even when the container cpuset only exposes the 10 Cortex-X925 cores,
+    # host-wide threshold discovery still classifies all 10 as fast cores.
+    fast_cpuset, eff_cpuset = cpu_affinity.discover_cpu_topology(
+        sysfs_root=tmp_path, allowed={5, 6, 7, 8, 9, 15, 16, 17, 18, 19}
+    )
+    assert fast_cpuset == (5, 6, 7, 8, 9, 15, 16, 17, 18, 19)
+    assert eff_cpuset == ()
+
+
+def test_partition_gb10_cpuset_produces_strictly_disjoint_roles(tmp_path: Path):
+    _populate_gb10_sysfs(tmp_path)
+
+    # 1. Container cpuset = 5-9,15-19 (the promoted cluster.json cpuset)
+    plan_10 = cpu_affinity.partition_cpu_affinity(
+        allowed={5, 6, 7, 8, 9, 15, 16, 17, 18, 19},
+        sysfs_root=tmp_path,
+        proxy_cpu_spec="big",
+    )
+    assert plan_10.proxy_cpus == (19,)
+    assert plan_10.worker_main_cpus == (18,)
+    assert plan_10.engine_core_cpus == (17,)
+    assert plan_10.api_server_cpus == (15, 16)
+    assert plan_10.worker_aux_cpus == (5, 6, 7, 8, 9)
+
+    roles_10 = [
+        set(plan_10.proxy_cpus),
+        set(plan_10.worker_main_cpus),
+        set(plan_10.engine_core_cpus),
+        set(plan_10.api_server_cpus),
+        set(plan_10.worker_aux_cpus),
+    ]
+    for i, a in enumerate(roles_10):
+        for j, b in enumerate(roles_10):
+            if i != j:
+                assert a.isdisjoint(b), f"role {i} ({a}) overlaps role {j} ({b})"
+
+    # 2. Full 20-core host cpuset = 0-19 (API server also gets efficiency cores)
+    plan_20 = cpu_affinity.partition_cpu_affinity(
+        allowed=set(range(20)),
+        sysfs_root=tmp_path,
+        proxy_cpu_spec="big",
+    )
+    assert plan_20.proxy_cpus == (19,)
+    assert plan_20.worker_main_cpus == (18,)
+    assert plan_20.engine_core_cpus == (17,)
+    assert plan_20.worker_aux_cpus == (5, 6, 7, 8, 9)
+    assert plan_20.api_server_cpus == (0, 1, 2, 3, 4, 10, 11, 12, 13, 14, 15, 16)
+    assert set(plan_20.proxy_cpus).isdisjoint(plan_20.api_server_cpus)
+    assert set(plan_20.worker_main_cpus).isdisjoint(plan_20.api_server_cpus)
+
+
+def test_configure_and_apply_worker_and_role_thread_affinity(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+):
+    sysfs = tmp_path / "sysfs"
+    _populate_gb10_sysfs(sysfs)
+    task_dir = tmp_path / "task"
+    for tid, comm in [
+        (100, "VLLM::Worker_TP"),
+        (101, "gloo_tcp_loop"),
+        (102, "pt_nccl_watchdg"),
+        (103, "sparknet-proxy"),
+        (104, "engram-reader"),
+    ]:
+        td = task_dir / str(tid)
+        td.mkdir(parents=True)
+        (td / "comm").write_text(f"{comm}\n", encoding="utf-8")
+
+    calls: dict[int, set[int]] = {}
+    monkeypatch.setattr(
+        cpu_affinity.os,
+        "sched_getaffinity",
+        lambda pid: {5, 6, 7, 8, 9, 15, 16, 17, 18, 19},
+    )
+    monkeypatch.setattr(
+        cpu_affinity.os,
+        "sched_setaffinity",
+        lambda pid, cpus: calls.__setitem__(int(pid), set(cpus)),
+    )
+    monkeypatch.delenv(cpu_affinity.ENV_CONTAINER_CPUSET, raising=False)
+    monkeypatch.setenv(cpu_affinity.ENV_SPARKNET_PROXY_CPU, "big")
+    monkeypatch.delenv(cpu_affinity.ENV_ENGRAM_CPU_AFFINITY, raising=False)
+
+    plan = cpu_affinity.configure_worker_cpu_affinity(0, sysfs_root=sysfs)
+    assert plan is not None
+    assert cpu_affinity.os.environ[cpu_affinity.ENV_SPARKNET_PROXY_CPU] == "19"
+    assert cpu_affinity.os.environ[cpu_affinity.ENV_ENGRAM_CPU_AFFINITY] == "5-9"
+    assert calls[0] == {5, 6, 7, 8, 9}
+
+    applied = cpu_affinity.apply_worker_thread_affinity(
+        plan, sysfs_root=sysfs, task_root=task_dir, main_tid=100
+    )
+    assert calls[100] == {18}
+    assert calls[103] == {19}
+    assert calls[101] == {5, 6, 7, 8, 9}
+    assert calls[102] == {5, 6, 7, 8, 9}
+    assert calls[104] == {5, 6, 7, 8, 9}
+    assert applied["worker-main:100"] == (18,)
+    assert applied["sparknet-proxy:103"] == (19,)
+
+    # EngineCore and APIServer roles use the saved container cpuset and pin to
+    # disjoint cores (17 and 15-16).
+    ec_cpus = cpu_affinity.apply_role_cpu_affinity(
+        "engine_core", sysfs_root=sysfs, task_root=tmp_path / "no-task"
+    )
+    assert ec_cpus == (17,)
+    assert calls[0] == {17}
+
+    api_cpus = cpu_affinity.apply_role_cpu_affinity(
+        "api_server", sysfs_root=sysfs, task_root=tmp_path / "no-task"
+    )
+    assert api_cpus == (15, 16)
+    assert calls[0] == {15, 16}
+
+    # HostEngramHash instantiated after worker main thread is pinned to {18}
+    # keeps {18} instead of widening back to all 10 fast cores.
+    monkeypatch.setattr(host_hash.os, "sched_getaffinity", lambda pid: {18})
+    monkeypatch.setattr(
+        host_hash.os,
+        "sched_setaffinity",
+        lambda pid, cpus: calls.__setitem__(int(pid), set(cpus)),
+    )
+    pinned = host_hash.pin_to_max_l2_cpus(0, sysfs_root=sysfs)
+    assert pinned == [18]
+    assert calls[0] == {18}
