+    buddy_4k = tmp_path / "buddy_4k"
+    buddy_4k.write_text(
+        "Node 0, zone   Normal   100 50 20 10  64 0 0 0 0  64 0 0 0 0\n",
+        encoding="utf-8",
+    )
+    torch.cuda.synchronize()
+    torch.cuda.empty_cache()
+    before_alloc = torch.cuda.memory_allocated()
+    sponge = direct_loader._allocate_order13_sponge(
+        torch.device("cuda"),
+        required_bytes=4 << 20,
+        buddyinfo_path=buddy_4k,
+        page_bytes=4096,
+        headroom_bytes=0,
+        chunk_bytes=2 << 20,
+    )
+    # 64 * 64 KiB = 4 MiB sub-2M + 1 extra 2 MiB margin chunk = 3 chunks of 2 MiB
+    assert len(sponge) == 3
+    sponge.clear()
+    torch.cuda.empty_cache()
+    assert torch.cuda.memory_allocated() == before_alloc
