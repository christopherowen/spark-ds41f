@@ -890,6 +890,98 @@ class MultiModalKwargsItem(UserDict[str, MultiModalFieldElem]):
     [`MultiModalDataItems`][vllm.multimodal.parse.MultiModalDataItems].
     """
 
+    def __init__(
+        self,
+        dict: Mapping[str, MultiModalFieldElem] | None = None,
+        /,
+        *,
+        lazy_materializer: Callable[[], Mapping[str, MultiModalFieldElem]] | None = None,
+        lazy_mm_hash: str | None = None,
+        keep_on_cpu_elems: Mapping[str, MultiModalFieldElem] | None = None,
+    ) -> None:
+        self._lazy_materializer = None
+        super().__init__(dict)
+        self._lazy_materializer = lazy_materializer
+        self._lazy_mm_hash = lazy_mm_hash
+        self._keep_on_cpu_elems = (
+            {k: v for k, v in keep_on_cpu_elems.items()}
+            if keep_on_cpu_elems is not None
+            else None
+        )
+
+    @property
+    def is_lazy(self) -> bool:
+        return self._lazy_materializer is not None
+
+    def materialize(self) -> None:
+        materializer = self._lazy_materializer
+        if materializer is not None:
+            self._lazy_materializer = None
+            self.data.update(materializer())
+
+    def materialize_and_get(self) -> "MultiModalKwargsItem":
+        self.materialize()
+        return self
+
+    def get_stripped_for_prefix_cache(
+        self, uses_mrope: bool = False
+    ) -> "MultiModalKwargsItem | None":
+        if not uses_mrope:
+            return None
+        if self._keep_on_cpu_elems is not None:
+            return MultiModalKwargsItem(self._keep_on_cpu_elems)
+        self.materialize()
+        return MultiModalKwargsItem(
+            {k: elem for k, elem in self.data.items() if elem.field.keep_on_cpu}
+        )
+
+    def __getitem__(self, key: str) -> MultiModalFieldElem:
+        if self._lazy_materializer is not None:
+            self.materialize()
+        return super().__getitem__(key)
+
+    def __iter__(self):
+        if self._lazy_materializer is not None:
+            self.materialize()
+        return super().__iter__()
+
+    def __len__(self) -> int:
+        if self._lazy_materializer is not None:
+            self.materialize()
+        return super().__len__()
+
+    def __contains__(self, key: object) -> bool:
+        if self._lazy_materializer is not None:
+            self.materialize()
+        return super().__contains__(key)
+
+    def keys(self):
+        if self._lazy_materializer is not None:
+            self.materialize()
+        return super().keys()
+
+    def items(self):
+        if self._lazy_materializer is not None:
+            self.materialize()
+        return super().items()
+
+    def values(self):
+        if self._lazy_materializer is not None:
+            self.materialize()
+        return super().values()
+
+    def get(self, key: str, default: Any = None) -> Any:
+        if self._lazy_materializer is not None:
+            self.materialize()
+        return super().get(key, default)
+
