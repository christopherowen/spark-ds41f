+def test_buddy_sponge_retention_buddy_cap_refresh_views_and_dummy_zeroing(tmp_path):
+    from vllm.model_executor.model_loader.weight_utils import (
+        initialize_single_dummy_weight,
+    )
+
+    packed = torch.full((256, 64), 173, dtype=torch.uint8, device="cuda")
+    initialize_single_dummy_weight(packed)
+    assert int(packed.max().item()) == 0
+    del packed
+
+    # 1. Verify buddy_cap keeps >= required_bytes + reserve_high in >= 64 KiB pools
+    # when high_target_bytes < required_bytes so allocations never fall into order-4 reclaim.
+    buddy_4k = tmp_path / "buddy_4k"
+    buddy_4k.write_text(
+        "Node 0, zone   Normal   100 50 20 10  64 0 0 0 32  8 0 0 0 0\n",
+        encoding="utf-8",
+    )
+    torch.cuda.synchronize()
+    torch.cuda.empty_cache()
+    before_alloc = torch.cuda.memory_allocated()
+    sponge = direct_loader._allocate_order13_sponge(
+        torch.device("cuda"),
+        required_bytes=24 << 20,
+        buddyinfo_path=buddy_4k,
+        page_bytes=4096,
+        headroom_bytes=0,
+        chunk_bytes=2 << 20,
+    )
+    assert len(sponge) == 12
+    sponge.clear()
+    torch.cuda.empty_cache()
+    assert torch.cuda.memory_allocated() == before_alloc
+
+    # 2. Verify retain_sponge=True + release_weight_arena_sponge + _refresh_views.
+    class _WithShardView(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.weight = torch.nn.Parameter(
+                torch.empty((64, 64), dtype=torch.bfloat16, device="cuda")
+            )
+            self._refresh_views()
+
+        def _refresh_views(self):
+            self.shard_weight = self.weight[:32]
+
+    m = _WithShardView()
+    buddy_big = tmp_path / "buddy_big"
+    buddy_big.write_text(
+        "Node 0, zone   Normal   10 10 10 10  64 0 0 0 0  64 0 0 0 0\n",
+        encoding="utf-8",
+    )
+    arena = direct_loader.bind_weight_arena(
+        m,
+        torch.device("cuda"),
+        order13_sponge=True,
+        sponge_min_model_bytes=0,
+        buddyinfo_path=buddy_big,
+        page_bytes=4096,
+        retain_sponge=True,
+    )
+    assert arena is not None
+    assert hasattr(m, "_direct_buddy_sponge") and len(m._direct_buddy_sponge) > 0
+    assert (
+        m.shard_weight.untyped_storage().data_ptr()
+        == arena.untyped_storage().data_ptr()
+    )
+    direct_loader.release_weight_arena_sponge(m, torch.device("cuda"))
+    assert not hasattr(m, "_direct_buddy_sponge")
