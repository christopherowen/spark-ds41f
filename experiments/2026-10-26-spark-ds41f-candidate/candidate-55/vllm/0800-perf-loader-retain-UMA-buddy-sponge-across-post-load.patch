+def test_select_buddy_sponge_target_covers_both_4k_and_64k_kernels():
+    buddy_4k = (
+        "Node 0, zone   Normal   1000 500 200 100  512 256 128 64 32  400 10 0 0 0\n"
+    )
+    target, sub_b, high_b = direct_loader.select_buddy_sponge_target(
+        buddy_4k, required_bytes=512 << 20, page_bytes=4096
+    )
+    assert target == 2 << 20
+    assert sub_b == 160 << 20
+    assert high_b == (400 * (2 << 20)) + (10 * (4 << 20))
+
+    buddy_64k_no13 = (
+        "Node 0, zone   Normal     32 16 0 0 0 200 50 0 0 0 0 0 0 0\n"
+    )
+    target64, sub64, high64 = direct_loader.select_buddy_sponge_target(
+        buddy_64k_no13, required_bytes=512 << 20, page_bytes=65536
+    )
+    assert target64 == 2 << 20
+    assert sub64 == (32 * 65536) + (16 * 131072)
+    assert high64 == (200 * (2 << 20)) + (50 * (4 << 20))
