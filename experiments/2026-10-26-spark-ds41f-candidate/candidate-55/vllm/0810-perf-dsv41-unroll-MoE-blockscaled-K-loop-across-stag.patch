+    @T.macro
+    def expand_wide_sfb(SFC_shared, SFB_shared, base_word, s, j):
+        """Expand four packed 4-bit scale deltas into one uint32 scale word."""
+        code = T.cast(SFC_shared[s, j], T.uint32)
+        SFB_shared[s, j, 0] = (
+            (code & T.uint32(0xF))
+            | ((code >> 4) & T.uint32(0xF)) << 8
+            | ((code >> 8) & T.uint32(0xF)) << 16
+            | ((code >> 12) & T.uint32(0xF)) << 24
+        ) + base_word
