+    @T.macro
+    def k_step(A, SFA, B, BT, SFB, SFB8, SFC8, SFC_shared, A_shared, B_shared,
+               SFA_shared, SFB_shared, sf_dest, base_words, a_row, sfa_row,
+               loaded, expert, bx, tx, C_local, Narrow_flag, code_base,
+               ko, s, phase, nxt_s, do_load, max_ko):  # fmt: skip
+        """Execute one K-loop pipeline step with compile-time stage and phase."""
+        # The stage loaded next was last read by iteration ko - 1.
+        T.sync_threads()
+        nxt = ko + stages - 1
+        max_nxt = max_ko + stages - 1
+        if do_load:
+            if max_nxt < k_blocks:
+                load_k_tile(
+                    A, SFA, B, BT, SFB, SFB8, SFC8, A_shared, B_shared,
+                    SFA_shared, SFB_shared, sf_dest, a_row, sfa_row, loaded,
+                    expert, bx, tx, nxt, nxt_s, Narrow_flag, code_base, max_nxt,
+                )
+            else:
+                if nxt < k_blocks:
+                    load_k_tile(
+                        A, SFA, B, BT, SFB, SFB8, SFC8, A_shared, B_shared,
+                        SFA_shared, SFB_shared, sf_dest, a_row, sfa_row,
+                        loaded, expert, bx, tx, nxt, nxt_s, Narrow_flag,
+                        code_base, max_nxt,
+                    )
+                else:
+                    T.ptx_commit_group()
+        else:
+            T.ptx_commit_group()
+        T.ptx_wait_group(stages - 1)
+        T.barrier_wait(loaded[s], phase)
+        if coded_scales:
+            # Every thread expands its own rows: the stage's barrier waited for
+            # every thread's copies. A narrow expert's row is one byte of four
+            # 2-bit deltas; the expert is one per CTA, so the branch is uniform.
+            for c in T.unroll(sfb_copies):
+                j = c * threads + tx
+                if j < block_N:
+                    if narrow_codes:
+                        if Narrow_flag != 0:
+                            code8 = T.cast(SFC8[s, j], T.uint32)
+                            SFB_shared[s, j, 0] = (
+                                (code8 & T.uint32(0x3))
+                                | ((code8 >> 2) & T.uint32(0x3)) << 8
+                                | ((code8 >> 4) & T.uint32(0x3)) << 16
+                                | ((code8 >> 6) & T.uint32(0x3)) << 24
+                            ) + base_words[c]
+                        else:
+                            expand_wide_sfb(
+                                SFC_shared, SFB_shared, base_words[c], s, j
+                            )
+                    else:
+                        expand_wide_sfb(
+                            SFC_shared, SFB_shared, base_words[c], s, j
+                        )
+        T.sync_threads()
+        if max_ko < k_full:
+            mma_full_k_tile(
+                A_shared, B_shared, C_local, SFA_shared, SFB_shared, s
+            )
+        else:
+            if ko < k_full:
