+def test_negative_slot_bounds_guard_in_alloc_and_apply():
+    """Negative entries in idx_mapping never read or write slot -1 of history,
+    total_len, int_state, or float_state, and fall back to DSpark proposals."""
+    rng = np.random.default_rng(20261108)
+    width = 256
+    # Allocate with a leading canary row at index 0, and pass slices starting at
+    # row 1 so any out-of-bounds access at slot = -1 hits row 0 of the base tensor.
+    history_base = _history(5, width)
+    history_base[0].fill_(777777)
+    history = history_base[1:]
+
+    total_len_base = torch.full((5,), 999999, dtype=torch.int32, device=DEVICE)
+    total_len = total_len_base[1:]
+
+    int_state_base = torch.full(
+        (5, tlc.STATE_COLUMNS), 888888, dtype=torch.int32, device=DEVICE
+    )
+    float_state_base = torch.full(
+        (5, tlc.STATE_COLUMNS), 555555.0, dtype=torch.float32, device=DEVICE
+    )
+    int_state = int_state_base[1:]
+    float_state = float_state_base[1:]
+    int_state.zero_()
+    float_state.zero_()
+    total_len.zero_()
+
+    repeated = np.tile(rng.integers(10, VOCAB, 32, dtype=np.int32), 4)
+    slot = 2
+    history[slot, :96] = torch.from_numpy(repeated[:96]).to(DEVICE)
+    total_len[slot] = 96
+
+    idx_mapping = torch.tensor([-1, slot, -1], dtype=torch.int64, device=DEVICE)
+    sources = _run_match(history, total_len, idx_mapping)
+    assert (sources[0] == -1).all()
+    assert (sources[2] == -1).all()
+
+    sampled = torch.tensor([4, 1, 4], dtype=torch.int32, device=DEVICE)
+    verified = torch.tensor([8, 0, 8], dtype=torch.int32, device=DEVICE)
+    dspark = (
+        torch.arange(3 * BLOCK, dtype=torch.int64, device=DEVICE).view(3, BLOCK) + 500,
+        torch.full((3, BLOCK), 0.6, dtype=torch.float32, device=DEVICE),
+    )
+    drafts, confs, planned, alloc, _ = _propose(
+        history,
+        total_len,
+        idx_mapping,
+        sources,
+        int_state,
+        float_state,
+        sampled,
+        verified,
+        verified,
+        dspark=dspark,
+    )
+    # Canary row 0 (index -1 of the sliced views) must be completely untouched.
+    assert (history_base[0] == 777777).all()
+    assert int(total_len_base[0]) == 999999
+    assert (int_state_base[0] == 888888).all()
+    assert (float_state_base[0] == 555555.0).all()
+
+    # Negative slots fall back to DSpark and report BLOCK allocation.
+    for neg_row in (0, 2):
+        assert int(alloc[neg_row]) == BLOCK
+        assert drafts[neg_row, :BLOCK].tolist() == dspark[0][neg_row].tolist()
+        assert drafts[neg_row, BLOCK:].tolist() == [-1] * (LOOKAHEAD - BLOCK)
+        torch.testing.assert_close(confs[neg_row, :BLOCK], dspark[1][neg_row])
+    assert int(alloc[1]) == 2 * INITIAL
+    assert int(int_state[slot, 1]) == INITIAL
+
+    # Even if copy_apply is invoked directly with a positive chosen source on a
+    # negative slot, slot < 0 guards both history reads and int_state resets.
+    forged_chosen = torch.tensor(
+        [[16, 8, 16], [32, 8, 16], [16, 8, 16]], dtype=torch.int32, device=DEVICE
+    )
+    low_estimates = torch.tensor([0.1, 0.95, 0.99], dtype=torch.float32, device=DEVICE)
+    tlc.copy_apply(
+        idx_mapping,
+        history,
+        forged_chosen,
+        low_estimates,
+        int_state,
+        dspark[0],
+        dspark[1],
+        drafts,
+        confs,
+        planned,
+    )
+    assert (history_base[0] == 777777).all()
+    assert (int_state_base[0] == 888888).all()
+    for neg_row in (0, 2):
+        assert drafts[neg_row, :BLOCK].tolist() == dspark[0][neg_row].tolist()
+
+
+def test_partial_acceptance_steps_down_cap_doublings_gently():
+    """Accepting at least initial_drafts of a wider copy proposal steps doublings
+    down by 1 instead of resetting to 0, while shorter acceptances reset to 0."""
+    rng = np.random.default_rng(42)
+    S = np.tile(rng.integers(10, VOCAB, 80, dtype=np.int32), 6)
+    slot = 1
+    history = _history(4, len(S) + 64)
+    history[slot, : len(S)] = torch.from_numpy(S).to(DEVICE)
+    total_len = torch.tensor([0, len(S), 0, 0], dtype=torch.int32, device=DEVICE)
+    idx_mapping = torch.tensor([slot], dtype=torch.int64, device=DEVICE)
+    lookahead = 31
+    sources = _run_match(history, total_len, idx_mapping, lookahead=lookahead)
+    dspark = (
+        torch.zeros((1, BLOCK), dtype=torch.int64, device=DEVICE),
+        torch.full((1, BLOCK), 0.3, dtype=torch.float32, device=DEVICE),
+    )
+    chosen = torch.empty((1, tlc.CHOSEN_COLUMNS), dtype=torch.int32, device=DEVICE)
+    estimates = torch.empty((1,), dtype=torch.float32, device=DEVICE)
+    alloc = torch.empty((1,), dtype=torch.int32, device=DEVICE)
+    drafts = torch.empty((1, lookahead), dtype=torch.int64, device=DEVICE)
+    confs = torch.empty((1, lookahead), dtype=torch.float32, device=DEVICE)
+    planned = torch.empty((1, lookahead), dtype=torch.float32, device=DEVICE)
+    int_state, float_state = _state(4)
+
+    def step(num_sampled, verified):
+        s_t = torch.tensor([num_sampled], dtype=torch.int32, device=DEVICE)
+        v_t = torch.tensor([verified], dtype=torch.int32, device=DEVICE)
+        tlc.copy_alloc(
+            idx_mapping,
+            total_len,
+            sources,
+            s_t,
+            v_t,
+            v_t,
+            int_state,
+            float_state,
+            chosen,
+            estimates,
+            alloc,
+            MIN_MATCH,
+            lookahead,
+            BLOCK,
+            INITIAL,
+        )
+        tlc.copy_apply(
+            idx_mapping,
+            history,
+            chosen,
+            estimates,
+            int_state,
+            dspark[0],
+            dspark[1],
+            drafts,
+            confs,
+            planned,
+        )
+        return int(int_state[slot, 0]), int(int_state[slot, 1])
+
+    # Initial copy step: doublings=0, offered=8.
+    assert step(1, 0) == (0, 8)
+    # Full 8 accepted (num_sampled=9): doublings=1, offered=16.
+    assert step(9, 8) == (1, 16)
+    # Full 16 accepted (num_sampled=17): doublings=2, offered=31.
+    assert step(17, 16) == (2, 31)
+    # Partial acceptance of 20/31 drafts (accepted=20 >= INITIAL=8): steps down
+    # doublings from 2 to 1 (offered=16) rather than collapsing to 0 (offered=8).
+    assert step(21, 31) == (1, 16)
+    # Full 16 accepted again: doublings returns to 2 (offered=31) in a single step.
+    assert step(17, 16) == (2, 31)
+    # Short partial acceptance of 5/31 drafts (accepted=5 < INITIAL=8): resets to 0.
+    assert step(6, 31) == (0, 8)
+
+
+@pytest.mark.parametrize("wide_lookahead", [31, 63])
+def test_wide_lookahead_31_and_63_greedy_verification_and_ramp(wide_lookahead):
+    """CopyDrafter and greedy_rejection_sample operate across 31-draft (32-row
+    decode_32 MMA tile) and 63-draft (64-row decode_64 MMA tile) lookaheads while
+    producing bit-identical temperature-0 target text."""
+    rng = np.random.default_rng(700 + wide_lookahead)
+    states = RequestState(
+        max_num_reqs=MAX_REQS,
+        max_model_len=8192,
+        max_num_batched_tokens=4096,
+        num_speculative_steps=wide_lookahead,
+        vocab_size=VOCAB,
+        device=DEVICE,
+    )
+    config = CopyDraftsConfig(
+        min_match=MIN_MATCH, max_drafts=wide_lookahead, initial_drafts=INITIAL
+    )
+    drafter = CopyDrafter(config, states, num_draft_steps=BLOCK, device=DEVICE)
+    target = ToyTarget(1, order=2, table=97)
+    prompt = np.tile(rng.integers(1, VOCAB, 32), 4).tolist()
+    slot = _set_history(states, "wide_req", prompt)
+    drafter.add_request(slot)
+    drafter.apply_staged_writes()
+
+    idx = torch.tensor([slot], dtype=torch.int64, device=DEVICE)
+    text = list(prompt)
+    out = []
+    num_sampled = torch.ones(1, dtype=torch.int32, device=DEVICE)
+    verified = torch.zeros(1, dtype=torch.int32, device=DEVICE)
+    max_offered = 0
+
+    from vllm.v1.worker.gpu.spec_decode.greedy_verification import (
+        greedy_rejection_sample,
+        vocab_parallel_pairs,
+    )
+
+    while len(out) < 400:
+        _set_history(states, "wide_req", text)
+        dspark_drafts = torch.zeros((1, BLOCK), dtype=torch.int64, device=DEVICE)
+        dspark_conf = torch.full((1, BLOCK), 0.5, device=DEVICE)
+        drafter.prepare_alloc(idx, num_sampled, verified, None)
+        drafts, confs, _ = drafter.propose(idx, dspark_drafts, dspark_conf)
+        width = int((confs[0] > 0).sum())
+        max_offered = max(max_offered, int(drafter.int_state[slot, 1]))
+        proposal = drafts[0, :width].tolist()
+        ctx = list(text)
+        row_targets = [target.next(ctx)]
+        for tok in proposal:
+            ctx.append(tok)
+            row_targets.append(target.next(ctx))
+        rows = len(row_targets)
+        logits = torch.zeros((rows, VOCAB), dtype=torch.float32, device=DEVICE)
+        logits[
+            torch.arange(rows, device=DEVICE),
+            torch.tensor(row_targets, dtype=torch.int64, device=DEVICE),
+        ] = 1.0
+        inputs = torch.tensor(
+            [text[-1], *proposal], dtype=torch.int32, device=DEVICE
+        )
+        cu = torch.tensor([0, rows], dtype=torch.int32, device=DEVICE)
+        pairs = vocab_parallel_pairs(logits, VOCAB, 0, 1)
+        sampled, n_sampled = greedy_rejection_sample(
+            pairs, inputs, cu, wide_lookahead
+        )
+        committed = sampled[0, : int(n_sampled[0])].tolist()
+        text.extend(committed)
+        out.extend(committed)
+        num_sampled = torch.tensor([len(committed)], dtype=torch.int32, device=DEVICE)
+        verified = torch.tensor([width], dtype=torch.int32, device=DEVICE)
+
+    assert max_offered == wide_lookahead
+    assert out[:400] == target.greedy(prompt, 400)
