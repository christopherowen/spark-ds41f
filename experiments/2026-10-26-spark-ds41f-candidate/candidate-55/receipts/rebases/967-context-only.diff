+def test_sparse_mla_vectorizes_swa_dequant_and_merges_readstate_segment_ifs():
+    """``sparse_mla`` vectorizes ``dequant_swa``'s ``T.reinterpret`` scale path
+    and merges adjacent ``seg_active`` ``IfThenElse`` blocks in Stage 1 and Stage 2."""
+    from tvm.ir import Op
+
+    assert bool(Op.get("tirx.reinterpret").get_attr("TVectorizable")) is True
+    assert getattr(tilelang.transform.MergeIfStmt, "_dsv41_readstate_merge_if", False)
+
+    routes = SparseMlaV41Plan.routes(
+        heads=40, swa_width=128, idx_width=512, idx_page_size=64, max_rows=32
+    )
+    fn, args, kwargs = routes.kernels["decode"]
+    kernel = fn.compile(*args, **kwargs)
+    src = kernel.get_kernel_source()
+    stage1, stage2 = src.split("__launch_bounds__(128, 1) sparse_mla_kernel_1", 1)
+
+    # dequant_swa vectorizes 8 elements into 2 x float4 iterations instead of vec < 8.
+    assert "for (int vec = 0; vec < 8; ++vec)" not in stage1, stage1
+    assert "for (int vec = 0; vec < 2; ++vec)" in stage1, stage1
+    # Stage 1 merges the 10 split seg_active guards into 2 (separated only by syncs),
+    # and Stage 2 merges the 6 per-segment guards into 1 per segment (5 total).
+    assert stage1.count("if (swa_seg_active |") == 2, stage1
+    assert stage2.count("if (swa_seg_active |") == 1, stage2
