      "VLLM_DS41_L2_PREFETCH_FFN_MB": "12",
      "VLLM_DS41_L2_PREFETCH_NEXT_MB": "12"
    },
    "container": {
      "extra_mounts": [
        {
          "source": "{repo}/experiments/2026-10-26-spark-ds41f-candidate/candidate-55/grid-attribution/pdlpostwait/overlay/sparknet/oneshot/_oneshot_tilelang.py",
          "target": "/usr/local/lib/python3.12/dist-packages/sparknet/oneshot/_oneshot_tilelang.py",
          "read_only": true
        },
        {
          "source": "{repo}/experiments/2026-10-26-spark-ds41f-candidate/candidate-55/grid-attribution/pdlpostwait/overlay/sparknet/oneshot/_allgather_tilelang.py",
          "target": "/usr/local/lib/python3.12/dist-packages/sparknet/oneshot/_allgather_tilelang.py",
          "read_only": true
        },
        {
          "source": "{repo}/experiments/2026-10-26-spark-ds41f-candidate/candidate-55/grid-attribution/pdlpostwait/overlay/sparknet/oneshot/_reducescatter_tilelang.py",
          "target": "/usr/local/lib/python3.12/dist-packages/sparknet/oneshot/_reducescatter_tilelang.py",
          "read_only": true
        },
        {
          "source": "{repo}/experiments/2026-10-26-spark-ds41f-candidate/candidate-55/grid-attribution/pdlpostwait/overlay/sparknet/oneshot/_exchange_tilelang.py",
          "target": "/usr/local/lib/python3.12/dist-packages/sparknet/oneshot/_exchange_tilelang.py",
