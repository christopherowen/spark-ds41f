{
  "notes": "candidate-55 build 4 at tp4-switched with pdlpostwait/overlay/ (T.pdl_trigger after roce_wait_peers) and L2 prefetch windows capped at 15/12/12 MB",
  "extends": {
    "config": "experiments/2026-10-26-spark-ds41f-candidate/candidate-55/grid-attribution/tp4-switched-b4-dev.json"
