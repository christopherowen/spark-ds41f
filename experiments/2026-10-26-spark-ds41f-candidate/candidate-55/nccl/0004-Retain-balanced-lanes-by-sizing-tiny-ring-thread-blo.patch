From d39a5a7bf7f15d04c47b2a185f30d1c5cf91baf7 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Sat, 3 Oct 2026 07:46:00 +0000
Subject: [PATCH 4/4] Retain balanced lanes by sizing tiny ring thread blocks
 first

Upstream-base: 12df1a11afad322be5a204a2db890161cbf8131d
Patch-base: 8bd7e984eb4d08134f0e9fd4bf4d182ab083b254

In bidirectional mode 2, try fewer threads down to 128 before dropping
channels for tiny Ring calls. Large calls and other modes keep upstream
thread selection. This avoids the measured penalty from globally forcing
128 threads while allowing four active direction/root lanes at 128 bytes
per rank with the fine-allocation policy.

Quality: no new arithmetic implementation; channel partitioning may alter
reduction rounding. Tests extract the helper from the prepared source;
full GPU and serving validation remains required.
Rebase: from v2.30.7-1 onto v2.32.3-1. 2.31's tuning rework moved the channel and thread sizing from
topoGetAlgoInfo in src/enqueue.cc to ncclTuningGetChannels in src/tuning/tuning_general.cc; the helper and
its call move there unchanged, on the same channel count, thread count, threshold and byte count.
Upstream-status: local experiment, not submitted.
---
 src/tuning/tuning_general.cc | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/tuning/tuning_general.cc b/src/tuning/tuning_general.cc
index 3f5ac05e..a8fab35d 100644
--- a/src/tuning/tuning_general.cc
+++ b/src/tuning/tuning_general.cc
@@ -138,6 +138,15 @@ ncclResult_t ncclTuningSetThreadThresholds(struct ncclComm* comm) {
   return ncclSuccess;
 }
 
+int64_t ncclParamSwitchlessBidirectional();
+
+// Preserve the four direction/root lanes by shrinking a tiny Ring's blocks
+// before shrinking its channel count. Larger messages keep upstream threads.
+static void balanceSwitchlessThreads(int64_t mode, size_t nBytes, int nc, int threshold, int* nt) {
+  if (mode != 2 || nc < 4) return;
+  while (*nt > 128 && nBytes < (size_t)nc * (size_t)*nt * (size_t)threshold) *nt /= 2;
+}
+
 ncclResult_t ncclTuningGetChannels(struct ncclTuningInput_t* const input, struct ncclTuningResult_t* const result) {
   int nc = input->comm->nChannels;
   int nt = input->comm->tuningContext.maxThreads[result->algo][result->proto];
@@ -166,6 +175,8 @@ ncclResult_t ncclTuningGetChannels(struct ncclTuningInput_t* const input, struct
     nc = input->comm->nvlsChannels;
   } else {
     // Ring/Tree/one-RPN PAT channel tuning
+    if (result->algo == NCCL_ALGO_RING)
+      balanceSwitchlessThreads(ncclParamSwitchlessBidirectional(), input->nBytes, nc, threadThreshold, &nt);
     while (input->nBytes < nc * nt * threadThreshold) {
       if (nc >= 2) nc--;
       else break;
