+                            shared[key] = (im, page_table)
                     candidate_args = {}
                     if self.layer_id == self.candidate_source_layer:
                         candidate_args = dict(
@@ -1192,7 +1225,7 @@ class DeepseekV4Attention(nn.Module, AttentionLayerBase):
                         q_mxfp4=iq_data[offset:end],
