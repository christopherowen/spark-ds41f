+def test_tilelang_prefetch_64k_paced_default():
+    from vllm.models.glm5next.nvidia import l2_prefetch
+    from vllm.models.glm5next.nvidia.tilelang.l2_prefetch import compile_launcher
+
+    assert l2_prefetch._CHUNK_BYTES == 65536
+    launch = compile_launcher(
+        grid=l2_prefetch._GRID, block=l2_prefetch._BLOCK, chunk=l2_prefetch._CHUNK_BYTES
+    )
+    a = torch.randn(2 * 1024 * 1024 + 19, device="cuda")
+    b = torch.randint(0, 255, (65536 * 3 + 48,), dtype=torch.uint8, device="cuda")
+    before = [t.clone() for t in (a, b)]
+    plan = _plan(a, b)
+    side = torch.cuda.Stream()
+    side.wait_stream(torch.cuda.current_stream())
+    launch(plan.segs, side.cuda_stream)
+    torch.cuda.current_stream().wait_stream(side)
+    torch.cuda.synchronize()
+    for t, ref in zip((a, b), before):
+        assert torch.equal(t, ref)
