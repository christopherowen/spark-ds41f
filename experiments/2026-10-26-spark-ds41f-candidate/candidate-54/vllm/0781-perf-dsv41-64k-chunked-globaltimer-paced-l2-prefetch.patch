@@ -57,8 +57,11 @@ from vllm.logger import init_logger
 logger = init_logger(__name__)
 
 _MIN_BYTES = 64 * 1024
-_CHUNK_BYTES = 4096
-_BLOCK = 128
+_SLICE_BYTES = 4096
+_CHUNK_BYTES = 65536
+_BURST_CHUNKS = 2
+_PACE_DELAY_NS = 200
+_BLOCK = 32
 # Caches and lookup tables are either written immediately before use or read
 # sparsely. Streaming them into L2 would evict projection weights without
 # shortening their own critical path.
@@ -93,12 +96,12 @@ def _mb(name: str, default: str) -> int:
         return int(float(default) * 1e6)
 
 
-# Fewer issuing CTAs throttle the fill rate, leaving device-memory headroom
-# for latency-bound kernels running beside the prefetch. GB10 (SM121) decode
-# measured best with 4.
+# A single issuing CTA with 64 KiB bulk-prefetch chunks and %globaltimer pacing
+# avoids overflowing GB10's hardware TMA prefetch FIFO while leaving device-memory
+# headroom for latency-bound kernels running beside the prefetch.
 _GRID = _int_env(
     "VLLM_L2_PREFETCH_GRID",
-    4
+    1
     if torch.cuda.is_available() and torch.cuda.get_device_capability() == (12, 1)
     else 16,
 )
@@ -192,24 +195,43 @@ if _CUTE_OK:
             ip=ip,
         )
 
+    @dsl_user_op
+    def _globaltimer_ns(*, loc=None, ip=None):
+        i64 = _ir.IntegerType.get_signless(64)
+        res = _llvm.inline_asm(
+            i64,
+            [],
+            "mov.u64 $0, %globaltimer;",
+            "=l",
+            has_side_effects=True,
+            loc=loc,
+            ip=ip,
+        )
+        return cutlass.Int64(res)
+
     class L2PrefetchKernel:
-        """grid x block threads walk the (ptr, bytes) segment table and issue
-        one bulk L2 prefetch per 4 KB chunk (fire-and-forget)."""
+        """CTA 0 lane 0 walks the (ptr, bytes) segment table and issues one
+        64 KiB bulk L2 prefetch per chunk, paced by %globaltimer after an
+        initial 128 KiB burst."""
 
         def __init__(
             self,
             chunk_bytes: int = _CHUNK_BYTES,
             grid: int = _GRID,
             block: int = _BLOCK,
+            burst_chunks: int = _BURST_CHUNKS,
+            delay_ns: int = _PACE_DELAY_NS,
         ):
-            self.chunk_bytes = int(chunk_bytes)
+            self.chunk_bytes = max(int(chunk_bytes), _CHUNK_BYTES)
             self.grid = int(grid)
             self.block = int(block)
+            self.burst_chunks = int(burst_chunks)
+            self.delay_ns = int(delay_ns)
 
         @cute.jit
         def __call__(self, gSegs: cute.Tensor, stream: CUstream) -> None:
             self.kernel(gSegs).launch(
-                grid=[self.grid, 1, 1],
+                grid=[1, 1, 1],
                 block=[self.block, 1, 1],
                 stream=stream,
             )
@@ -219,27 +241,38 @@ if _CUTE_OK:
             tidx, _, _ = cute.arch.thread_idx()
             bidx, _, _ = cute.arch.block_idx()
             chunk: cutlass.Constexpr = self.chunk_bytes
-            stride = cutlass.Int64(self.grid * self.block)
-            tid = cutlass.Int64(bidx) * cutlass.Int64(self.block) + cutlass.Int64(tidx)
-            nseg = cutlass.Int32(cute.size(gSegs, mode=[0]) // 2)
-            policy = _createpolicy_evict_last()
-            s = cutlass.Int32(0)
-            while s < nseg:
-                base = cutlass.Int64(gSegs[2 * s])
-                nbytes = cutlass.Int64(gSegs[2 * s + 1])
-                nchunks = (nbytes + cutlass.Int64(chunk - 1)) // cutlass.Int64(chunk)
-                c = tid
-                while c < nchunks:
-                    off = c * cutlass.Int64(chunk)
-                    rem = nbytes - off
-                    size = cutlass.Int32(chunk)
-                    if rem < cutlass.Int64(chunk):
-                        size = cutlass.Int32(rem)
-                    size = (size // cutlass.Int32(16)) * cutlass.Int32(16)
-                    if size > cutlass.Int32(0):
-                        _bulk_prefetch_l2(base + off, size, policy)
-                    c = c + stride
-                s = s + cutlass.Int32(1)
+            burst: cutlass.Constexpr = self.burst_chunks
+            pace_ns: cutlass.Constexpr = self.delay_ns
+            if bidx == cutlass.Int32(0) and tidx == cutlass.Int32(0):
+                nseg = cutlass.Int32(cute.size(gSegs, mode=[0]) // 2)
+                policy = _createpolicy_evict_last()
+                issued = cutlass.Int32(0)
+                s = cutlass.Int32(0)
+                while s < nseg:
+                    base = cutlass.Int64(gSegs[2 * s])
+                    nbytes = cutlass.Int64(gSegs[2 * s + 1])
+                    off = cutlass.Int64(0)
+                    while off < nbytes:
+                        rem = nbytes - off
+                        size = cutlass.Int32(chunk)
+                        if rem < cutlass.Int64(chunk):
+                            size = cutlass.Int32(rem)
+                        size = (size // cutlass.Int32(16)) * cutlass.Int32(16)
+                        if size > cutlass.Int32(0):
+                            _bulk_prefetch_l2(base + off, size, policy)
+                            issued = issued + cutlass.Int32(1)
+                            if pace_ns > 0 and issued >= cutlass.Int32(burst):
+                                if (
+                                    off + cutlass.Int64(chunk) < nbytes
+                                    or s + cutlass.Int32(1) < nseg
+                                ):
+                                    t0 = _globaltimer_ns()
+                                    while _globaltimer_ns() - t0 < cutlass.Int64(
+                                        pace_ns
+                                    ):
