+                        off = off + cutlass.Int64(chunk)
+                    s = s + cutlass.Int32(1)
 
 
 _compiled = None
@@ -417,7 +450,7 @@ def take_budget(
             taken.append((name, ptr, nbytes))
             used += nbytes
         else:
-            head = room - (room % _CHUNK_BYTES)
