 vllm/models/deepseek_v4_1/tilelang/gemm.py    |  9 ++--
 vllm/models/deepseek_v4_1/tilelang/wo.py      |  2 +-
 3 files changed, 51 insertions(+), 4 deletions(-)

diff --git a/tests/kernels/quantization/test_deepseek_v41_tilelang_linear.py b/tests/kernels/quantization/test_deepseek_v41_tilelang_linear.py
index 07e9f9152..14f651a41 100644
--- a/tests/kernels/quantization/test_deepseek_v41_tilelang_linear.py
+++ b/tests/kernels/quantization/test_deepseek_v41_tilelang_linear.py
@@ -1002,3 +1002,47 @@ def test_hw_e2m1x2_codegen_in_gemm_and_indexer_quantizers():
         src = nrq_kernel.get_kernel_source()
         assert "cvt.rn.satfinite.e2m1x2.f32" in src
         assert "dsv41_store_e2m1x8(" in src
+
+
+@pytest.mark.parametrize("k", [3072, 2048, 1024])
+def test_wo_b_wide_decode_128_rows_matches_prefill(default_vllm_config, k):
+    """WO-B shapes ((5120, 3072), (5120, 2048), (5120, 1024)) extend WIDE_DECODE
+    to 128 rows (128x128 decode tile) and match the prefill GEMM bit for bit
+    across 64..128 rows (including 104, 112, 120, 128 with poisoned padding)."""
+    from vllm.models.deepseek_v4_1.tilelang.gemm import WIDE_DECODE, decode_tile_rows
+
+    n = 5120
+    assert WIDE_DECODE[(n, k)] == {96: 96, 128: 128}
+    assert decode_tile_rows(96, WIDE_DECODE[(n, k)]) == 96
+    for rows in (97, 104, 112, 120, 128):
+        assert decode_tile_rows(rows, WIDE_DECODE[(n, k)]) == 128
+
+    weight, exps, _ = _block32_weight(n, k, 53 + k)
+    weight_sf = pack_scale_words(exps)
+    x = torch.randn((128, k), generator=_gen(59 + k), device=DEVICE).bfloat16()
+    xq, sf, _ = _mxfp8(x)
+    words = sf.contiguous().view(torch.uint32)
+
+    prefill_kernel = mxfp8_gemm(n, k, **fp8_prefill_config(n, k))
+    decode_96 = mxfp8_gemm_decode(n, k, **fp8_decode_config(n, k, 96), padded_rows=True)
+    decode_128 = mxfp8_gemm_decode(
+        n, k, **fp8_decode_config(n, k, 128), padded_rows=True
+    )
+    full_ref = torch.empty((128, n), dtype=torch.bfloat16, device=DEVICE)
+    prefill_kernel(xq, weight, words, weight_sf, full_ref)
+
+    for rows, kernel in (
+        (96, decode_96),
+        (104, decode_128),
+        (112, decode_128),
+        (120, decode_128),
+        (128, decode_128),
+    ):
+        xq_pad = xq.clone()
+        words_pad = words.clone()
+        if rows < 128:
+            xq_pad[rows:].view(torch.uint8).fill_(0x7F)
+            words_pad[rows:].fill_(0xFFFFFFFF)
+        out = torch.empty((rows, n), dtype=torch.bfloat16, device=DEVICE)
+        kernel(xq_pad, weight, words_pad, weight_sf, out)
+        assert torch.equal(out, full_ref[:rows]), f"k={k} rows={rows}"
