+    def run(h, out, out_sf, psum, weights, _scale=1.0, _limit=None):
+        n = int(psum[-1].item())
+        if n <= 0:
+            return
+        hf = h[:n].float()
+        gate = hf[:, :intermediate].clamp(max=LIMIT)
+        up = hf[:, intermediate:].clamp(-LIMIT, LIMIT)
+        act = (gate / (1.0 + torch.exp(-gate)) * up * weights[:n, None]).bfloat16()
+        xq, sf = tile_kernels.quant.per_token_cast(
+            act, "e4m3", 32, round_sf=True, use_packed_ue8m0=True
+        )
+        out[:n].copy_(xq)
+        cols = intermediate // 32
+        out_sf[:n, :cols].copy_(sf.contiguous().view(torch.uint8)[:, :cols])
 
