+def test_remaining_max_tokens_clamps_decode_rows_and_copy_widening(
+    monkeypatch, tmp_path
+):
+    """A decode request near ``max_tokens`` caps its scheduled draft rows and
+    copy-placeholder widening to the tokens that can still be committed, leaving
+    unused copy rows in the envelope for other copying requests."""
+    utils, scheduler = _scheduler(
+        monkeypatch, tmp_path, copy_drafts=True, max_num_seqs=4
+    )
+    requests = utils.create_requests(num_requests=4, num_tokens=20, max_tokens=500)
+    # Give the first request a tight max_tokens cap so its final decode step
+    # needs fewer than BLOCK drafts while a step is in flight.
+    finishing = requests[0]
+    finishing.max_tokens = 10
+    alloc = {request.request_id: LOOKAHEAD for request in requests}
+    for request in requests:
+        scheduler.add_request(request)
+
+    queue: deque[SchedulerOutput] = deque()
+    seen_finishing_widths: list[int] = []
+    seen_other_max_widths: list[int] = []
+    for _ in range(6):
+        scheduled = scheduler.schedule()
+        if finishing.request_id in scheduled.scheduled_spec_decode_tokens:
+            fin_drafts = len(
+                scheduled.scheduled_spec_decode_tokens[finishing.request_id]
+            )
+            seen_finishing_widths.append(fin_drafts)
+            assert (
+                scheduled.num_scheduled_tokens[finishing.request_id] == 1 + fin_drafts
+            )
+            other_widths = [
+                len(scheduled.scheduled_spec_decode_tokens[r.request_id])
+                for r in requests[1:]
+                if r.request_id in scheduled.scheduled_spec_decode_tokens
+            ]
+            if other_widths:
+                seen_other_max_widths.append(max(other_widths))
+        queue.append(scheduled)
+        if len(queue) == 2:
+            done = queue.popleft()
+            # Reject all drafts on finishing's steps so it approaches max_tokens
+            # one token at a time and exercises partial-draft clamping.
+            req_ids = list(done.num_scheduled_tokens)
+            sampled = []
+            for req_id in req_ids:
+                if req_id == finishing.request_id:
+                    sampled.append([7])
+                else:
+                    drafts = len(done.scheduled_spec_decode_tokens.get(req_id, ()))
+                    sampled.append([7] * (drafts + 1))
+            scheduler.update_from_output(
+                done,
+                ModelRunnerOutput(
+                    req_ids=req_ids,
+                    req_id_to_index={req_id: i for i, req_id in enumerate(req_ids)},
+                    sampled_token_ids=sampled,
+                    logprobs=None,
+                    prompt_logprobs_dict={},
+                    pooler_output=[],
+                    copy_draft_alloc=[alloc[req_id] for req_id in req_ids],
+                ),
+            )
+
+    # Once finishing is within LOOKAHEAD tokens of max_tokens, it no longer
+    # consumes the full 11 extra copy rows, allowing the next copying request
+    # in the 4-request batch to widen to LOOKAHEAD.
+    assert any(w < BLOCK for w in seen_finishing_widths)
+    assert LOOKAHEAD in seen_other_max_widths
+
+
+def test_remaining_max_tokens_with_sink_rejection_preserves_last_token_row(
+    monkeypatch, tmp_path
+):
+    """With sink rejection on, the ``max_tokens``-th output token is kept as a
+    draft row so the sink detector inspects its residual column, while drafts
+    strictly past ``max_tokens`` are trimmed."""
+    monkeypatch.setenv("VLLM_SINK_DETECTOR_COLUMN", "2455")
+    monkeypatch.setenv("VLLM_SINK_DETECTOR_THRESHOLD", "85000")
+    monkeypatch.setenv("VLLM_SINK_REJECTION", "1")
+    utils, scheduler = _scheduler(
+        monkeypatch, tmp_path, copy_drafts=True, max_num_seqs=4
+    )
+    assert scheduler.sink_rejection
+    request = utils.create_requests(num_requests=1, num_tokens=20, max_tokens=4)[0]
+    scheduler.add_request(request)
+
+    # Step 1: prefill (20 prompt tokens), samples token #1 as provisional.
+    s1 = scheduler.schedule()
+    assert s1.num_scheduled_tokens[request.request_id] == 20
+    # Step 2 (in flight after prefill): 4 output tokens total -> draft zero (#1)
+    # plus 3 drafter tokens (#2, #3, #4) = 4 rows total (clamped from 6).
+    s2 = scheduler.schedule()
+    assert s2.num_scheduled_tokens[request.request_id] == 4
+    assert len(s2.scheduled_spec_decode_tokens[request.request_id]) == 4
