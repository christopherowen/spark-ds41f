+    def _max_decode_new_tokens(self, request: Request) -> int | None:
+        """Maximum decode rows ``request`` can use before reaching ``max_tokens``.
+
+        With adaptive verification (variable-length decode CUDA graphs), partial
+        drafts do not break decode graph dispatch. Under async scheduling,
+        ``num_computed_tokens`` includes in-flight ``num_output_placeholders``;
+        subtracting ``max(0, num_output_placeholders - 1)`` retains only the
+        single token an in-flight step is guaranteed to commit when all of its
+        drafts reject. With sink rejection, the last output token is verified
+        as a draft row so the sink detector inspects its residual column.
+        """
+        if (
+            not self.enable_adaptive_verification
+            or request.is_prefill_chunk
+            or getattr(request, "max_tokens", None) is None
+            or getattr(request, "num_prompt_tokens", None) is None
+        ):
+            return None
+        min_computed_tokens = request.num_computed_tokens - max(
+            0, request.num_output_placeholders - 1
+        )
+        max_model_tokens = (
+            self.max_model_len
+            - request.num_computed_tokens
+            - self.num_sampled_tokens_per_step
+        )
+        max_output_tokens = (
+            request.num_prompt_tokens
+            + request.max_tokens
+            - min_computed_tokens
+            - (0 if self.sink_rejection else self.num_sampled_tokens_per_step)
+        )
+        return max(1, min(max_model_tokens, max_output_tokens))
+
     def _widen_copy_placeholders(self, request: Request, rows_left: int) -> int:
         """Lay out a decoding request's draft placeholders for the copy drafts its
         last output asked for (``copy_draft_alloc``): DSpark's block and at most
@@ -1146,7 +1187,11 @@ class Scheduler(SchedulerInterface):
             or placeholders[-1] != -1
         ):
             return 0
-        rows = max(0, min(request.copy_draft_alloc - self.num_spec_tokens, rows_left))
+        alloc = request.copy_draft_alloc
+        max_new_tokens = self._max_decode_new_tokens(request)
+        if max_new_tokens is not None:
+            alloc = min(alloc, max_new_tokens - 1)
+        rows = max(0, min(alloc - self.num_spec_tokens, rows_left))
         if len(placeholders) != base + rows:
             request.spec_token_ids = [-1] * (base + rows)
         return rows
@@ -1580,6 +1625,9 @@ class Scheduler(SchedulerInterface):
                     - request.num_computed_tokens
                     - self.num_sampled_tokens_per_step,
                 )
+                max_decode_new_tokens = self._max_decode_new_tokens(request)
+                if max_decode_new_tokens is not None:
+                    num_new_tokens = min(num_new_tokens, max_decode_new_tokens)
 
                 # Apply Mamba alignment before encoder caps.
