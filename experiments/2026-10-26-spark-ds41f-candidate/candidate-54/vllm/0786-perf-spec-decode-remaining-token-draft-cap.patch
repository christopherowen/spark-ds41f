@@ -413,3 +413,100 @@ def test_active_prefill_chunk_keeps_decode_requests_at_the_block(monkeypatch, tm
         if len(queue) == 2:
             done = queue.popleft()
             scheduler.update_from_output(done, _output(done, alloc))
