### apply_stack.sh
#!/usr/bin/env bash
# candidate-54: apply the series entries after 1107's 641 (0762..) on a tree at base-1107, in
# series order (or the order of the entries given as extra arguments), as bin/spark build prepare
# applies them: git apply --check --verbose (offsets logged), then git am --committer-date-is-author-date.
# usage: apply_stack.sh REPO SERIES LOG [entry ...]
set -u
REPO=$1; SERIES=$2; LOG=$3; shift 3
DIR=$(cd "$(dirname "$SERIES")" && pwd)
cd "$REPO"
git am --abort >/dev/null 2>&1
git checkout -q --detach base-1107 && git reset -q --hard base-1107 && git clean -qfd
{
echo "base-1107 patch_head $(git rev-parse base-1107) tree $(git rev-parse 'base-1107^{tree}')"
} >> "$LOG"
if [ $# -gt 0 ]; then entries=("$@"); else
  mapfile -t entries < <(grep -v '^#' "$SERIES" | grep -v '^\s*$' | tail -n +642)
fi
for p in "${entries[@]}"; do
  f="$DIR/$p"; name=$(basename "$p")
  sha=$(sha256sum "$f" | cut -c1-64)
  out=$(git apply --check --verbose "$f" 2>&1); rc=$?
  if [ $rc -ne 0 ]; then
    echo "FAIL  $name sha256=$sha  git apply --check rc=$rc  ($p)" >> "$LOG"; echo "$out" | sed 's/^/      /' >> "$LOG"; break
  fi
  am=$(git -c user.name="Christopher Owen" -c user.email=3221756+christopherowen@users.noreply.github.com am --quiet --committer-date-is-author-date "$f" 2>&1); rc=$?
  if [ $rc -ne 0 ]; then
    echo "FAIL  $name sha256=$sha  git am rc=$rc  ($p)" >> "$LOG"; echo "$am" | sed 's/^/      /' >> "$LOG"; git am --abort; break
  fi
  files=$(git diff --name-only HEAD~1 HEAD | wc -l)
  echo "OK    $name sha256=$sha  commit=$(git rev-parse HEAD) tree=$(git rev-parse 'HEAD^{tree}') files=$files" >> "$LOG"
  echo "$out" | grep -E "offset|fuzz" | sed 's/^/      git apply: /' >> "$LOG"
  [ -n "$am" ] && echo "$am" | sed 's/^/      git am: /' >> "$LOG"
done
echo "head $(git rev-parse HEAD) tree $(git rev-parse 'HEAD^{tree}') patches_after_base $(git rev-list --count base-1107..HEAD)" >> "$LOG"
if git diff --check 19f2c20ed4d64ae22bd009ceacadd85e2a81e354 HEAD >/dev/null; then echo "git diff --check 19f2c20ed4d6..HEAD: clean" >> "$LOG"; else echo "git diff --check 19f2c20ed4d6..HEAD: PROBLEMS" >> "$LOG"; fi

### cross_check.sh
#!/usr/bin/env bash
# candidate-54: per-candidate stacks on the round-2 base (candidate-50 without #1009, tree 14c5a2dc),
# to compare each file the round-2 patches touch with the tree its candidate (or rework) measured,
# and the order checks for #984, which candidate-54 leaves out (candidate-53's 0784).
set -u
REPO=$1; C54=$2; OUT=$3
C50=$C54/../candidate-50/vllm
P984=$C54/../candidate-53/vllm/0784-perf-worker-reclaim-uma-heap-and-allocator-slack-acr.patch
cd "$REPO"
apply() {  # apply <label> <patch>...  from base-1107; prints the tree
  local label=$1; shift
  git checkout -q --detach base-1107 && git reset -q --hard base-1107 && git clean -qfd
  for p in "$@"; do
    if ! git -c user.name="Christopher Owen" -c user.email=3221756+christopherowen@users.noreply.github.com am --quiet --committer-date-is-author-date "$p" >/dev/null 2>&1; then
      git am --abort; echo "$label FAIL at $(basename "$p")"; return 1; fi
  done
  echo "$label head $(git rev-parse HEAD) tree $(git rev-parse 'HEAD^{tree}')"
  git tag -f "c54-$label" >/dev/null
}
BASE14=()
for n in 0762 0763 0764 0765 0766 0767 0768 0769 0770 0771 0772 0773 0774 0775 0776 0777 0779 0780; do BASE14+=($(ls $C50/$n-*.patch)); done
p() { ls $C54/vllm/$1-*.patch; }
{
apply base14 "${BASE14[@]}"
apply c51r "${BASE14[@]}" $(p 0781) $(p 0782) $(p 0783) $(p 0784)
apply c52 "${BASE14[@]}" $(p 0785) $(p 0786) $(p 0787)
# candidate-53 with its three reworks, without #984: as candidate-54 carries it
apply c53r-no984 "${BASE14[@]}" $(p 0788) $(p 0789) $(p 0790) $(p 0791)
# with #984 in candidate-53's order (#984 before #998 round 1), and after it
apply c53r-c53order "${BASE14[@]}" $(p 0788) $(p 0789) $(p 0790) $P984 $(p 0791)
apply c53r-984last "${BASE14[@]}" $(p 0788) $(p 0789) $(p 0790) $(p 0791) $P984
# every round-2 patch without #1009 round 1, in candidate-54's order
apply all-no1009 "${BASE14[@]}" $(for n in 0781 0782 0783 0784 0785 0786 0787 0788 0789 0790 0791; do p $n; done)
# candidate-54's series as committed (every entry after 1107's 641)
apply c54 $(grep -v '^#' $C54/vllm/series | grep -v '^\s*$' | tail -n +642 | sed "s#^#$C54/vllm/#")
} > "$OUT"

### file_identity.sh
#!/usr/bin/env bash
# candidate-54: each file a round-2 candidate's patches change over the round-2 base, compared
# with candidate-54's file; and candidate-54 against all round-2 patches without #1009 round 1.
# usage: file_identity.sh VLLM_REPO   (the tags cross_check.sh leaves; c54-c54 is the committed series)
set -u
cd "$1"
T54=$(git rev-parse 'c54-c54^{tree}')
echo "candidate-54 tree $T54"
echo "## candidate-54 against every round-2 patch without #1009 round 1 (c54-all-no1009): #1009 round 1's files only"
git diff --stat c54-all-no1009 c54-c54 | tail -8
for c in c51r c52 c53r-no984; do
  echo "## files $c changes over c54-base14: candidate-54's blob against $c's"
  for f in $(git diff --name-only c54-base14 "c54-$c"); do
    a=$(git rev-parse "$T54:$f" 2>/dev/null); b=$(git rev-parse "c54-$c:$f" 2>/dev/null)
    [ "$a" = "$b" ] && r=same || r=DIFFERENT
    echo "  $r $f"
  done
done
echo "## files each round-2 candidate stack changes, pairwise intersections (expect none)"
for x in c51r c52 c53r-no984; do for y in c51r c52 c53r-no984; do
  [[ "$x" < "$y" ]] || continue
  n=$(comm -12 <(git diff --name-only c54-base14 "c54-$x" | sort) <(git diff --name-only c54-base14 "c54-$y" | sort) | wc -l)
  echo "  $x & $y: $n common files"
done; done
echo "## #1009 round 1's files against the round-2 stacks (expect none)"
c778=$(git log --format=%H base-1107..c54-c54 --grep='^perf(dsv41): fuse SP prefill local attention front' | head -1)
git log -1 --format='  0778 is %h %s' "$c778"
r1=$(git diff --name-only "$c778~1" "$c778")
for x in c51r c52 c53r-no984; do
  n=$(comm -12 <(echo "$r1" | sort) <(git diff --name-only c54-base14 "c54-$x" | sort) | wc -l)
  echo "  0778 & $x: $n common files"
done
