 tests/kernels/deepseek_v41_pdl_sources.py   |   5 +
 vllm/models/deepseek_v4_1/tilelang/gemm.py  |  33 +--
 vllm/models/deepseek_v4_1/tilelang/vocab.py | 242 ++++++++++++--------
 3 files changed, 171 insertions(+), 109 deletions(-)

