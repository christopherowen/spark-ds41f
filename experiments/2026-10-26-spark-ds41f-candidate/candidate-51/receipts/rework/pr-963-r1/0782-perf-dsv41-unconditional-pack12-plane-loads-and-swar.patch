+@pytest.mark.parametrize(
+    "two,part_n", [(False, 4096), (False, 512), (True, 1024), (True, 256)]
+)
+def test_packed_bf16_gemm_wide_and_narrow_grids_exact(two, part_n, k=1280):
+    """``packed_bf16_gemm`` and ``packed_bf16_gemm_two`` read each row's exception
+    bounds directly and begin with ``pdl.chain()`` on grids of ``_PACKED_WIDE_TILES``
+    column tiles or more, and keep the bounds search and a plain launch below it; both
+    match ``bf16_gemm`` / ``bf16_gemm_two`` bit for bit (0 ULP) with exceptions."""
+    from vllm.models.deepseek_v4_1.tilelang import gemm
+    from vllm.models.deepseek_v4_1.tilelang.vocab import pack_bf16_weight
+
+    n = 2 * part_n if two else part_n
+    gen = _gen(43 + n)
+    weight = (torch.randn((n, k), generator=gen, device=DEVICE) * 0.02).bfloat16()
+    weight[::7, ::97] = torch.tensor(64.0, dtype=torch.bfloat16, device=DEVICE)
+    weight[1::5, 3::113] = torch.tensor(-1e-6, dtype=torch.bfloat16, device=DEVICE)
+    weight[2::9, 5::127] = torch.tensor(1e-40, dtype=torch.bfloat16, device=DEVICE)
+    packed = pack_bf16_weight(weight.clone())
+    assert packed.exceptions > 0
+
+    if two:
+        kernel = gemm.packed_bf16_gemm_two(part_n, k, packed.exponent_base)
+        ref = gemm.bf16_gemm_two(part_n, k)
+    else:
+        kernel = gemm.packed_bf16_gemm(part_n, k, packed.exponent_base)
+        ref = gemm.bf16_gemm(part_n, k)
+    wide = n // 64 >= gemm._PACKED_WIDE_TILES
+    source = kernel.get_kernel_source()
+    assert ("cudaGridDependencySynchronize()" in source) == wide
+    assert (source.count("vllm_packed_bf16_load_row_bounds(") > 1) == wide
+    assert (source.count("vllm_packed_bf16_filter_exc(") > 1) != wide
+
+    parts = 2 if two else 1
+    for rows in (1, 16, 64, 130):
+        x = torch.randn((rows, k), generator=gen, device=DEVICE).bfloat16()
+        outs = [
+            torch.empty((rows, part_n), dtype=torch.bfloat16, device=DEVICE)
+            for _ in range(parts)
+        ]
+        refs = [torch.empty_like(o) for o in outs]
+        kernel(x, packed.values, packed.exception_entries, packed.row_offsets, *outs)
+        ref(x, weight, *refs)
+        for out, expected in zip(outs, refs):
+            assert torch.equal(out, expected), (two, part_n, rows)
+
