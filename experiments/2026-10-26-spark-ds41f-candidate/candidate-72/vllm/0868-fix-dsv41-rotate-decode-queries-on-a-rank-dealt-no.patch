+    def _launch_pending_decode_aux(
+        self,
+        aux_stream,
+        q,
+        positions,
+        swa,
+        metadata,
+        rows,
+        decode_rows,
+        pad_mask,
+    ):
+        """Issue the overlapped decode path's deferred ``q`` RoPE and shared
+        decode metadata on ``aux_stream`` after synchronizing the current stream
+        with the prior aux-stream index-query work.
+
+        Must run once per overlapped decode forward before joining
+        ``aux_stream``, even when a rank-split index step deals this rank no
+        rows so ``select_rows`` scores no chunk.
+        """
+        main_stream = torch.cuda.current_stream(q.device)
+        main_stream.wait_stream(aux_stream)
+        if self.n_local_heads <= 0:
+            return
+        main_meta = (
+            self._query_metadata(metadata[self._owner().prefix])
+            if self.compress_ratio
+            else None
+        )
+        decode_specs = self._attention_workspace_specs["decode"]
+        q.record_stream(aux_stream)
+        with torch.cuda.stream(aux_stream):
+            self._rope(q, positions, "q")
+            if not decode_rows:
+                meta_bufs = self._shared_decode_metadata(
+                    swa,
+                    main_meta,
+                    rows,
+                    decode_specs,
+                    q.device,
+                    is_padding=pad_mask,
+                )
+            else:
+                meta_bufs = ()
+        for buf in meta_bufs:
+            buf.record_stream(main_stream)
+
     @eager_break_during_capture
     def forward_mqa(
         self,
@@ -1958,6 +2004,18 @@ class DeepseekV4Attention(nn.Module, AttentionLayerBase):
         # Only the score matrix needs row chunking. All selected positions
