         pad_mask = self._decode_is_padding(swa, rows)
+        pending_aux_to_issue = pending_aux
+
+        def issue_pending_aux():
+            nonlocal pending_aux_to_issue
+            aux = pending_aux_to_issue
+            if aux is None:
+                return
+            pending_aux_to_issue = None
+            self._launch_pending_decode_aux(
+                aux, q, positions, swa, metadata, rows, decode_rows, pad_mask
