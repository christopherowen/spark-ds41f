diff --git a/tests/models/test_deepseek_v4_1_attention.py b/tests/models/test_deepseek_v4_1_attention.py
index 8019f38a9..c04aea501 100644
--- a/tests/models/test_deepseek_v4_1_attention.py
+++ b/tests/models/test_deepseek_v4_1_attention.py
@@ -1901,6 +1901,93 @@ def test_decode_two_stream_overlap_schedules_disjoint_workspaces(monkeypatch):
     assert ("index_chunk", "main") in names_reidx
     assert ("attend", "main") in names_reidx
 
+    # A rank-split decode step (24 rows or more, or a long eager decode) deals
+    # index rows across TP ranks. The deferred rope(q) and shared decode
+    # metadata must still run once per forward on a rank dealt no rows (which
+    # scores no index chunk, e.g. rank 7 of 25..28 rows at TP8), issued before
+    # gather so they overlap with the all-gather; and must run only once across
+    # multiple index chunks and stay skipped on headless ranks (n_local_heads=0).
+    module.compressor = comp
+
+    class _FakeSplit:
+        local_rows = 2
+
+        def __init__(self, start, real_rows):
+            self.start, self.real_rows = start, real_rows
+
+        def gather(self, x):
+            events.append(("gather", active_stream[0].name))
+            return torch.zeros(4, 512, dtype=torch.int32)
+
+    def _reset_forward_state():
+        events.clear()
+        for key in [k for k in vars(ctx) if k != "attn_metadata"]:
+            delattr(ctx, key)
+
+    for split in (_FakeSplit(4, 0), _FakeSplit(0, 2)):
+        _reset_forward_state()
+        monkeypatch.setattr(
+            cls, "_decode_index_split", lambda self, *a, _split=split: _split
+        )
+        module._forward(
+            torch.arange(4, dtype=torch.int64),
+            torch.zeros(4, 32, dtype=torch.bfloat16),
+        )
+        real = split.real_rows
+        assert [e for e in events if e[:2] == ("rope", "q")] == [
+            ("rope", "q", "aux")
+        ], real
+        assert events.count(("decode_metadata", "aux")) == 1, real
+        assert events.count(("index_chunk", "main")) == (1 if real else 0), real
+        assert events.count(("gather", "main")) == 1, real
+        assert events.count(("attend", "main")) == 1, real
+        assert events.index(("rope", "q", "aux")) < events.index(("gather", "main")), real
+        assert events.index(("rope", "q", "aux")) < events.index(("attend", "main")), real
+
+    # Multi-chunk scoring with pending_aux issues deferred aux work once, not
+    # once per chunk (also guards reference-check passes with _INDEX_SPLIT_CHECK).
+    _reset_forward_state()
+    monkeypatch.setattr(module, "DECODE_CHUNK", 2)
+    module._pending_decode_aux = aux_s
+    q_multi = torch.zeros(4, 2, 512, dtype=torch.bfloat16)
+    out_multi = torch.empty_like(q_multi)
+    iq_multi = (
+        torch.zeros(4, 4, 64, dtype=torch.uint8),
+        torch.zeros(4, 4, 4, dtype=torch.uint8),
+        torch.ones(4, 4, dtype=torch.bfloat16),
+        None,
+        None,
+    )
+    module.forward_mqa(
+        q_multi,
+        None,
+        torch.arange(4, dtype=torch.int64),
+        out_multi,
+        index_query=iq_multi,
+    )
+    assert events.count(("index_chunk", "main")) == 2
+    assert [e for e in events if e[:2] == ("rope", "q")] == [("rope", "q", "aux")]
+    assert events.count(("decode_metadata", "aux")) == 1
+    assert events.count(("attend", "main")) == 1
+
+    # Headless rank dealt no index rows skips RoPE, decode metadata, and attend,
+    # while still completing the rank-split gather.
+    _reset_forward_state()
+    monkeypatch.setattr(module, "DECODE_CHUNK", 64)
+    monkeypatch.setattr(
+        cls, "_decode_index_split", lambda self, *a: _FakeSplit(4, 0)
+    )
+    module.n_local_heads = 0
+    module._forward(
+        torch.arange(4, dtype=torch.int64),
+        torch.zeros(4, 32, dtype=torch.bfloat16),
+    )
+    assert [e for e in events if e[:2] == ("rope", "q")] == []
+    assert events.count(("decode_metadata", "aux")) == 0
+    assert events.count(("index_chunk", "main")) == 0
+    assert events.count(("gather", "main")) == 1
+    assert events.count(("attend", "main")) == 0
+
 
 @pytest.mark.parametrize("is_decode", [False, True])
 @pytest.mark.parametrize("n_real", [4, 2, 0])
