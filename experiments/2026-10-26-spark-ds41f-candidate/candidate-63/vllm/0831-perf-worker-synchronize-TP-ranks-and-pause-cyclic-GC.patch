+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import ast
+from contextlib import contextmanager
+import gc
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any
+
+import pytest
+import torch
+
+
+def _load_engine_grid_fn():
+    """Import GPUModelRunner.engine_grid directly when the GPU runtime is present,
+    or compile the exact method from model_runner.py when running CPU-only."""
+    try:
+        from vllm.v1.worker.gpu import model_runner as mr_mod
+
+        return mr_mod.GPUModelRunner.engine_grid, mr_mod
+    except (ImportError, AttributeError):
+        src_path = (
+            Path(__file__).resolve().parents[3]
+            / "vllm"
+            / "v1"
+            / "worker"
+            / "gpu"
+            / "model_runner.py"
+        )
+        tree = ast.parse(src_path.read_text(encoding="utf-8"), filename=str(src_path))
+        method_node = None
+        for node in tree.body:
+            if isinstance(node, ast.ClassDef) and node.name == "GPUModelRunner":
+                for item in node.body:
+                    if isinstance(item, ast.FunctionDef) and item.name == "engine_grid":
+                        method_node = item
+                        break
+        assert method_node is not None
+        # Strip decorators (e.g. @torch.inference_mode()) so the unbound method runs directly.
+        method_node.decorator_list = []
+        mod_ast = ast.Module(body=[method_node], type_ignores=[])
+        ast.fix_missing_locations(mod_ast)
+        ns: dict[str, Any] = {
+            "Any": Any,
+            "gc": gc,
+            "torch": torch,
+            "get_tensor_model_parallel_world_size": lambda: 1,
+            "get_tp_group": lambda: SimpleNamespace(cpu_group=None),
+        }
+        exec(compile(mod_ast, str(src_path), "exec"), ns)
+        return ns["engine_grid"], ns
+
+
+class _FakeEvent:
+    def __init__(self, enable_timing: bool = False):
+        self.enable_timing = enable_timing
+
+    def record(self) -> None:
+        pass
+
+    def elapsed_time(self, other: "_FakeEvent") -> float:
+        return 12.5
+
+
+class _FakeStepTiming:
+    @contextmanager
+    def collect(self):
+        yield []
+
+
+class _FakeRunner:
+    def __init__(self, trace: list, *, fail_on_call: int | None = None):
+        self.trace = trace
+        self.fail_on_call = fail_on_call
+        self.calls = 0
+        self.step_timing = _FakeStepTiming()
+
+    def _fill_real_context(self, context_len: int) -> None:
+        self.trace.append(("fill", context_len))
+
+    def _dummy_run(self, **kwargs) -> None:
+        self.calls += 1
+        self.trace.append(("run", self.calls, gc.isenabled()))
+        if self.fail_on_call is not None and self.calls == self.fail_on_call:
+            raise RuntimeError("injected dummy failure")
+
+
+def _patch_target(monkeypatch, target, name: str, value: Any) -> None:
+    if isinstance(target, dict):
+        monkeypatch.setitem(target, name, value)
+    else:
+        monkeypatch.setattr(target, name, value)
+
+
+def test_engine_grid_synchronizes_tp_ranks_and_pauses_gc(monkeypatch):
+    engine_grid_fn, target = _load_engine_grid_fn()
+    trace: list = []
+    cpu_group = object()
+
+    monkeypatch.setattr(torch.cuda, "Event", _FakeEvent)
+    monkeypatch.setattr(
+        torch.cuda, "synchronize", lambda: trace.append(("cuda_sync", gc.isenabled()))
+    )
+    monkeypatch.setattr(
+        gc, "collect", lambda *a, **kw: trace.append(("gc_collect", gc.isenabled())) or 0
+    )
+    _patch_target(monkeypatch, target, "get_tensor_model_parallel_world_size", lambda: 4)
+    monkeypatch.setattr(torch.distributed, "is_initialized", lambda: True)
+    _patch_target(
+        monkeypatch, target, "get_tp_group", lambda: SimpleNamespace(cpu_group=cpu_group)
+    )
+    monkeypatch.setattr(
+        torch.distributed,
+        "barrier",
+        lambda group=None: trace.append(("barrier", group is cpu_group)),
+    )
+
+    was_enabled = gc.isenabled()
+    gc.enable()
+    try:
+        runner = _FakeRunner(trace)
+        spec = {
+            "shapes": [{"num_tokens": 6, "num_reqs": 1, "context_len": 4096}],
+            "replays": 2,
+            "warmup": 1,
+            "settle": 1,
+        }
+        out = engine_grid_fn(runner, spec)
+        assert out["replays"] == 2
+        assert len(out["shapes"][0]["step_ms"]) == 2
+        assert gc.isenabled() is True
+    finally:
+        if not was_enabled:
+            gc.disable()
+
+    assert trace == [
+        ("fill", 0),
+        ("run", 1, True),
+        ("cuda_sync", True),
+        ("gc_collect", True),
+        ("barrier", True),
+        ("run", 2, False),
+        ("run", 3, False),
+        ("run", 4, False),
+        ("run", 5, False),
+        ("cuda_sync", False),
+    ]
+
+
+def test_engine_grid_restores_gc_on_exception(monkeypatch):
+    engine_grid_fn, target = _load_engine_grid_fn()
+    trace: list = []
+    monkeypatch.setattr(torch.cuda, "Event", _FakeEvent)
+    monkeypatch.setattr(torch.cuda, "synchronize", lambda: None)
+    _patch_target(monkeypatch, target, "get_tensor_model_parallel_world_size", lambda: 1)
+
+    was_enabled = gc.isenabled()
+    gc.enable()
+    try:
+        runner = _FakeRunner(trace, fail_on_call=2)
+        spec = {
+            "shapes": [{"num_tokens": 6, "num_reqs": 1, "context_len": 4096}],
+            "replays": 1,
+            "warmup": 1,
+            "settle": 1,
+        }
+        with pytest.raises(RuntimeError, match="injected dummy failure"):
+            engine_grid_fn(runner, spec)
+        assert gc.isenabled() is True
+    finally:
+        if not was_enabled:
+            gc.disable()
