+def test_evacuate_and_restore_preserves_cuda_tensors_and_aliases():
+    if not torch.cuda.is_available():
+        pytest.skip("CUDA required")
+
+    worker = _make_worker()
+    torch.cuda.empty_cache()
+    # Allocate a real 64 MiB CUDA pool and place a tensor + aliased view inside it
+    pool = torch.empty((64 * 1024**2,), dtype=torch.uint8, device="cuda:0")
+    pool_ptr = int(pool.data_ptr())
+    pool_end = pool_ptr + 64 * 1024**2
+    del pool
+    anchor = torch.empty((2 * 1024**2,), dtype=torch.uint8, device="cuda:0")
+    worker._contiguous_pool_anchor = anchor
+    worker._contiguous_pool_range = (pool_ptr, pool_end)
+
+    base = torch.arange(2048 * 256, dtype=torch.float32, device="cuda:0").reshape(2048, 256)
+    view = base[10:20, :32]
+    assert pool_ptr <= int(base.untyped_storage().data_ptr()) < pool_end
+    expected_base = base.cpu().clone()
+    expected_view = view.cpu().clone()
+
+    evac_bytes, groups, snapshots = worker._evacuate_tensors_in_pool_range(pool_ptr, pool_end)
+    try:
+        assert evac_bytes >= base.element_size() * base.numel()
+        assert base.numel() == 0
+        assert view.numel() == 0
+        # Anchor must NOT be evacuated
+        assert anchor.numel() == 2 * 1024**2
+    finally:
+        worker._restore_evacuated_tensors(groups, snapshots)
+
+    assert torch.equal(base.cpu(), expected_base)
+    assert torch.equal(view.cpu(), expected_view)
+    assert base.untyped_storage().data_ptr() == view.untyped_storage().data_ptr()
+    del base, view, anchor
+    torch.cuda.empty_cache()
+
+
+def test_bind_weight_arena_invokes_resize_cb_and_skips_sponge(monkeypatch):
+    if not torch.cuda.is_available():
+        pytest.skip("CUDA required")
+
+    class TinyModel(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.dense = torch.nn.Parameter(
+                torch.empty((1024, 1024), dtype=torch.float32, device="cuda")
+            )
+            self.experts_w = torch.nn.Parameter(
+                torch.empty((1024, 1024), dtype=torch.float32, device="cuda")
+            )
+
+    model = TinyModel()
+    resize_calls: list[tuple[int, int]] = []
+
+    def fake_resize(total_bytes: int, max_moe_bytes: int):
+        resize_calls.append((total_bytes, max_moe_bytes))
+        direct_loader.set_preallocated_cuda_pool_bytes(64 * 1024**2, front_clean=True)
+        return 64 * 1024**2, True
+
+    monkeypatch.setattr(torch.cuda, "memory_reserved", lambda _dev=None: 64 * 1024**2)
+    monkeypatch.setattr(torch.cuda, "memory_allocated", lambda _dev=None: 2 * 1024**2)
+    direct_loader.set_preallocated_cuda_pool_bytes(
+        128 * 1024**2, front_clean=True, resize_cb=fake_resize
+    )
+    sponge_called = False
+
+    def fail_sponge(*args, **kwargs):
+        nonlocal sponge_called
+        sponge_called = True
+        return []
+
+    monkeypatch.setattr(direct_loader, "_allocate_order13_sponge", fail_sponge)
+    try:
+        arena = direct_loader.bind_weight_arena(
+            model,
+            device=torch.device("cuda:0"),
+            sponge_min_model_bytes=1024,
+        )
+        assert arena is not None
+        assert not sponge_called
+        assert len(resize_calls) == 1
+        assert resize_calls[0][0] == 8 * 1024**2
+        assert direct_loader._PREALLOCATED_CUDA_POOL_RESIZE_CB is None
+    finally:
+        direct_loader.set_preallocated_cuda_pool_bytes(0)
diff --git a/vllm/model_executor/model_loader/direct_loader.py b/vllm/model_executor/model_loader/direct_loader.py
index 66dfc925d..a1de477d0 100644
--- a/vllm/model_executor/model_loader/direct_loader.py
+++ b/vllm/model_executor/model_loader/direct_loader.py
@@ -81,6 +81,23 @@ _NVIDIA_MIN_SYS_ALLOC_BYTES = 65536
 _GPU_HUGEPAGE_BYTES = 1 << 21
 _HIGH_ORDER_SPONGE_TARGETS_64K = tuple(65536 << order for order in range(13, 5, -1))
 _HELD_SPONGE_STACK: list[list[torch.nn.Module]] = []
+_PREALLOCATED_CUDA_POOL_BYTES: int = 0
+_PREALLOCATED_CUDA_POOL_FRONT_CLEAN: bool = True
+_PREALLOCATED_CUDA_POOL_RESIZE_CB = None
+
+
+def set_preallocated_cuda_pool_bytes(
+    num_bytes: int, *, front_clean: bool = True, resize_cb=None
+) -> None:
+    """Record whether Worker.init_device pre-allocated a single contiguous CUDA
+    caching-allocator segment so bind_weight_arena skips redundant buddy soaking
+    and (when resize_cb is provided) sizes the permanent pool to the model."""
+    global _PREALLOCATED_CUDA_POOL_BYTES
+    global _PREALLOCATED_CUDA_POOL_FRONT_CLEAN
+    global _PREALLOCATED_CUDA_POOL_RESIZE_CB
+    _PREALLOCATED_CUDA_POOL_BYTES = max(0, int(num_bytes))
+    _PREALLOCATED_CUDA_POOL_FRONT_CLEAN = bool(front_clean)
+    _PREALLOCATED_CUDA_POOL_RESIZE_CB = resize_cb
 
 
 def _align_up(value: int, alignment: int) -> int:
@@ -669,6 +686,9 @@ def bind_weight_arena(
             )
