+def test_bind_weight_arena_skips_sponge_when_pool_covers_weights(monkeypatch):
+    class TinyModel(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.dense = torch.nn.Parameter(torch.empty((1024, 1024), dtype=torch.float32))
+            self.experts_w = torch.nn.Parameter(torch.empty((1024, 1024), dtype=torch.float32))
+
+    if not torch.cuda.is_available():
+        pytest.skip("CUDA required")
+    model = TinyModel().to("cuda")
+    monkeypatch.setattr(torch.cuda, "memory_reserved", lambda _dev=None: 64 * 1024**2)
+    monkeypatch.setattr(torch.cuda, "memory_allocated", lambda _dev=None: 2 * 1024**2)
+    direct_loader.set_preallocated_cuda_pool_bytes(64 * 1024**2, front_clean=True)
+
+    sponge_called = False
+
+    def fail_sponge(*args, **kwargs):
+        nonlocal sponge_called
+        sponge_called = True
+        return []
+
+    monkeypatch.setattr(direct_loader, "_allocate_order13_sponge", fail_sponge)
+    try:
+        arena = direct_loader.bind_weight_arena(
+            model,
+            device=torch.device("cuda:0"),
+            sponge_min_model_bytes=1024,
+        )
+        assert arena is not None
+        assert not sponge_called
+    finally:
+        direct_loader.set_preallocated_cuda_pool_bytes(0)
