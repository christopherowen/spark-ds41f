+    @staticmethod
+    def _parse_unmovable_sub_order13_bytes(pagetypeinfo_text: str) -> int:
+        """Sum free bytes in Zone Normal MIGRATE_UNMOVABLE orders < 13 (64 KiB pages)."""
+        total = 0
+        for line in pagetypeinfo_text.splitlines():
+            if "Normal" in line and "Unmovable" in line and "type" in line:
+                parts = line.split()
+                try:
+                    idx = parts.index("Unmovable")
+                    counts = [int(x) for x in parts[idx + 1 :]]
+                except (ValueError, IndexError):
+                    continue
+                if len(counts) >= 14:
+                    total += sum(c * (65536 << order) for order, c in enumerate(counts[:-1]))
+        return total
+
+    def _preallocate_contiguous_cuda_pool(self) -> int:
+        """Pre-allocate one contiguous PyTorch CUDA caching-allocator segment on
+        64 KiB UMA hosts when native cudaMalloc caching is active.
+
+        On ARM64 64 KiB unified-memory hosts with ``iommu.passthrough=0``,
+        hundreds of separate ``cudaMalloc`` or ``cuMemCreate`` calls interleave
+        immortal ARM SMMU L3 page-table pages (``SecPageTables``) inside freshly
+        converted ``MIGRATE_UNMOVABLE`` 512 MiB buddy pageblocks, permanently
+        shattering order-13 contiguity after a single boot.
+
+        Pre-reserving one weight-sized contiguous segment before model load
+        (excluding ``kv_cache_memory_bytes`` when configured, so KV cache claims
+        its own single contiguous segment without allocator-tail slack) and
+        soaking ``MIGRATE_UNMOVABLE`` sub-order-13 blocks beforehand with a
+        single transient ``cudaMalloc`` ensures both dense and MoE weights draw
+        100% from 512 MiB order-13 blocks across every boot without rebooting.
+        """
+        self._contiguous_pool_anchor: torch.Tensor | None = None
+        self._contiguous_pool_bytes = 0
+        raw_override = os.environ.get("VLLM_CUDA_PREALLOC_POOL_MIB", "").strip()
+        if raw_override.lower() in ("0", "false", "off", "no"):
+            return 0
+        if not current_platform.is_cuda():
+            return 0
+        conf = torch._C._accelerator_getAllocatorSettings()
+        if re.search(
+            r"(?:^|,)\s*(?:expandable_segments\s*:\s*True|backend\s*:\s*cudaMallocAsync)\s*(?:,|$)",
+            conf,
+        ):
+            return 0
+
+        override_mib: int | None = None
+        if raw_override:
+            try:
+                override_mib = int(raw_override)
+            except ValueError:
+                logger.warning(
+                    "Ignoring invalid VLLM_CUDA_PREALLOC_POOL_MIB=%r", raw_override
+                )
+                return 0
+            if override_mib <= 0:
