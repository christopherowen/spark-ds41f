+def test_preallocate_excludes_kv_and_soaks_unmovable_sub_o13(monkeypatch):
+    worker = _make_worker(requested_gib=101.5, kv_gib=4.90625, tp_size=3)
+    _patch_uma_64k(monkeypatch, o13_count=205, avail_gib=115.5, o12_unmov=32)
+
+    alloc_sizes: list[int] = []
+    monkeypatch.setattr(
+        torch, "empty", lambda shape, **kw: (alloc_sizes.append(int(shape[0])) or _FakeBuf())
+    )
+    monkeypatch.setattr("vllm.v1.worker.gpu_worker.torch.accelerator.empty_cache", lambda: None)
+    try:
+        got = worker._preallocate_contiguous_cuda_pool()
+        expected_pool = int(96.5 * (1024**3))
+        expected_soak = int(8.0 * (1024**3))
+        assert got == expected_pool
+        assert alloc_sizes == [expected_soak, expected_pool, 2 * 1024 * 1024]
+        assert worker._contiguous_pool_anchor is not None
+        assert direct_loader._PREALLOCATED_CUDA_POOL_BYTES == expected_pool
+        assert direct_loader._PREALLOCATED_CUDA_POOL_FRONT_CLEAN is True
+        assert direct_loader._PREALLOCATED_CUDA_POOL_RESIZE_CB is not None
+    finally:
+        direct_loader.set_preallocated_cuda_pool_bytes(0)
+
