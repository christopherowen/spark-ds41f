+    monkeypatch.setenv("VLLM_CUDA_PREALLOC_POOL_MIB", "0")
+    monkeypatch.setattr("vllm.v1.worker.gpu_worker.current_platform.is_cuda", lambda: True)
+    assert worker._preallocate_contiguous_cuda_pool() == 0
+
+
