+    def _preallocate_contiguous_cuda_pool(self) -> int:
+        """Pre-allocate one contiguous PyTorch CUDA caching-allocator segment on
+        64 KiB UMA hosts when native cudaMalloc caching is active.
+
+        On ARM64 64 KiB unified-memory hosts with ``iommu.passthrough=0``,
+        hundreds of separate ``cudaMalloc`` or ``cuMemCreate`` calls interleave
+        immortal ARM SMMU L3 page-table pages (``SecPageTables``) inside freshly
+        converted ``MIGRATE_UNMOVABLE`` 512 MiB buddy pageblocks, permanently
+        shattering order-13 contiguity after a single boot. Pre-reserving one
+        contiguous segment before model load and anchoring it with a 2 MiB
+        large-pool tensor keeps weights, draft weights, KV cache, and workspace
+        inside a single ``cudaMalloc`` segment and preserves order-13 blocks
+        across boots.
+        """
+        self._contiguous_pool_anchor: torch.Tensor | None = None
+        self._contiguous_pool_bytes = 0
+        raw_override = os.environ.get("VLLM_CUDA_PREALLOC_POOL_MIB", "").strip()
+        if raw_override.lower() in ("0", "false", "off", "no"):
+            return 0
+        if not current_platform.is_cuda():
+            return 0
+        conf = torch._C._accelerator_getAllocatorSettings()
+        if re.search(
+            r"(?:^|,)\s*(?:expandable_segments\s*:\s*True|backend\s*:\s*cudaMallocAsync)\s*(?:,|$)",
+            conf,
+        ):
+            return 0
+
+        override_mib: int | None = None
+        if raw_override:
+            try:
+                override_mib = int(raw_override)
+            except ValueError:
+                logger.warning(
+                    "Ignoring invalid VLLM_CUDA_PREALLOC_POOL_MIB=%r", raw_override
+                )
+                return 0
+            if override_mib <= 0:
+                return 0
+
+        if override_mib is None:
+            try:
+                page_bytes = os.sysconf("SC_PAGE_SIZE")
+            except (AttributeError, OSError, ValueError):
+                page_bytes = 0
+            if page_bytes < 65536:
+                return 0
+
+        block_bytes = 512 * 1024 * 1024
+        o13_bytes = 0
+        avail_bytes = 0
+        try:
+            from vllm.model_executor.model_loader.direct_loader import (
+                parse_buddyinfo_order13,
+            )
+
+            _, o13_bytes = parse_buddyinfo_order13(
+                Path("/proc/buddyinfo").read_text(encoding="utf-8"),
+                page_bytes=65536,
+            )
+        except OSError:
+            o13_bytes = 0
+        try:
+            for line in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines():
+                if line.startswith("MemAvailable:"):
+                    avail_bytes = int(line.split()[1]) * 1024
+                    break
+        except (OSError, ValueError, IndexError):
+            avail_bytes = 0
+
+        if override_mib is not None:
+            pool_bytes = (override_mib * 1024 * 1024 // block_bytes) * block_bytes
+            if pool_bytes <= 0:
+                pool_bytes = override_mib * 1024 * 1024
+        else:
+            # Auto-activate only when enough 512 MiB blocks exist to benefit;
+            # on an already-fragmented host, let direct_loader's buddy sponge run.
+            if o13_bytes < 32 * 1024**3:
+                return 0
+            headroom_bytes = 12 * 1024**3
+            cap_bytes = max(0, avail_bytes - headroom_bytes) if avail_bytes > 0 else self.requested_memory
+            target_bytes = min(int(self.requested_memory), cap_bytes)
+            pool_bytes = (target_bytes // block_bytes) * block_bytes
+            if pool_bytes < 16 * 1024**3:
+                return 0
+
+        t0 = time.perf_counter()
+        try:
+            pool = torch.empty((pool_bytes,), dtype=torch.uint8, device=self.device)
+            del pool
+            # A >= 2 MiB allocation lands in PyTorch's large_pool and splits off
+            # the front of the pre-allocated segment, preventing empty_cache()
+            # from releasing the segment back to cudaFree before weights bind.
+            self._contiguous_pool_anchor = torch.empty(
+                (2 * 1024 * 1024,), dtype=torch.uint8, device=self.device
+            )
+            self._contiguous_pool_bytes = pool_bytes
+            from vllm.model_executor.model_loader.direct_loader import (
+                set_preallocated_cuda_pool_bytes,
+            )
+
+            set_preallocated_cuda_pool_bytes(pool_bytes)
+        except torch.OutOfMemoryError:
+            self._contiguous_pool_anchor = None
+            self._contiguous_pool_bytes = 0
+            torch.accelerator.empty_cache()
+            logger.warning(
+                "Pre-allocation of %.1f GiB contiguous CUDA pool hit OOM; "
+                "falling back to standard allocator",
+                pool_bytes / (1024**3),
+            )
+            return 0
+
+        logger.info(
+            "Pre-allocated %.1f GiB single contiguous CUDA pool in %.2f s "
+            "(order-13 free was %.1f GiB, MemAvailable was %.1f GiB)",
+            pool_bytes / (1024**3),
+            time.perf_counter() - t0,
+            o13_bytes / (1024**3),
+            avail_bytes / (1024**3),
+        )
+        return pool_bytes
+
