+@pytest.mark.parametrize(
+    ("tp_size", "kv_gib", "weights_gib", "max_moe_gib", "has_spec", "expected_initial_gib", "expected_final_gib"),
+    [
+        # TP1 (EXPERT_SLOTS=96): 10.1 GiB + 1.5 ws + 8.0 draft(tp1) = 19.6 -> 20.0 GiB
+        (1, 8.0, 10.1, 0.0, True, 93.5, 20.0),
+        # TP2 (EXPERT_SLOTS=240): 10.1 GiB + 1.5 ws + 4.0 draft(tp2) = 15.6 -> 16.0 GiB
+        (2, 8.0, 10.1, 0.0, True, 93.5, 16.0),
+        # TP4: 70.5 GiB + 1.7 moe + 2.0 draft(tp4) = 74.2 -> 74.5 GiB (saves 10.5 GiB)
+        (4, 16.5, 70.5, 1.7, True, 85.0, 74.5),
+        # TP5: 58.5 GiB + 1.5 ws + 1.6 draft(tp5) = 61.6 -> 62.0 GiB (saves 15.5 GiB)
+        (5, 24.0, 58.5, 1.4, True, 77.5, 62.0),
+        # TP6 (device Engram): 81.0 GiB + 1.5 ws + 1.33 draft(tp6) = 83.83 -> 84.0 GiB
+        (6, 13.0, 81.0, 1.2, True, 88.5, 84.0),
+        # TP7 (device Engram): 70.0 GiB + 1.5 ws + 1.14 draft(tp7) = 72.64 -> 73.0 GiB
+        (7, 16.0, 70.0, 1.0, True, 85.5, 73.0),
+        # TP8 (device Engram): 61.5 GiB + 1.5 ws + 1.0 draft(tp8) = 64.0 -> 64.0 GiB
+        (8, 25.5, 61.5, 0.9, True, 76.0, 64.0),
+        # Small 14 GiB model without speculator: 14.0 + 1.5 + 1.0 = 16.5 GiB
+        (1, 8.0, 14.0, 0.5, False, 93.5, 16.5),
+    ],
+)
+def test_resize_shrinks_pool_universally_across_all_shapes(
+    monkeypatch,
+    tp_size,
+    kv_gib,
+    weights_gib,
+    max_moe_gib,
+    has_spec,
+    expected_initial_gib,
+    expected_final_gib,
+):
+    worker = _make_worker(
+        requested_gib=101.5, kv_gib=kv_gib, tp_size=tp_size, has_speculator=has_spec
+    )
+    _patch_uma_64k(monkeypatch, o13_count=205, avail_gib=115.5, o12_unmov=16)
+
+    alloc_sizes: list[int] = []
+    monkeypatch.setattr(
+        torch, "empty", lambda shape, **kw: (alloc_sizes.append(int(shape[0])) or _FakeBuf())
+    )
+    monkeypatch.setattr("vllm.v1.worker.gpu_worker.torch.accelerator.empty_cache", lambda: None)
+    # Simulate scratch segment releasing cleanly from initial+2G down to 2G runner buffers
+    reserved_seq = iter([int((expected_initial_gib + 2.0) * (1024**3)), int(2.0 * (1024**3))])
+    monkeypatch.setattr(torch.cuda, "memory_reserved", lambda _dev=None: next(reserved_seq, 0))
+    try:
+        got_init = worker._preallocate_contiguous_cuda_pool()
+        assert got_init == int(expected_initial_gib * (1024**3))
+        final_bytes, clean = worker._resize_contiguous_cuda_pool_for_model(
+            int(weights_gib * (1024**3)), max_moe_bytes=int(max_moe_gib * (1024**3))
+        )
+        assert final_bytes == int(expected_final_gib * (1024**3))
+        assert clean is True
+        assert direct_loader._PREALLOCATED_CUDA_POOL_BYTES == final_bytes
+        assert direct_loader._PREALLOCATED_CUDA_POOL_RESIZE_CB is None
+        # Second call (e.g. draft model load) is a no-op
+        assert worker._resize_contiguous_cuda_pool_for_model(int(2.5 * (1024**3))) == (
+            final_bytes,
+            True,
+        )
+    finally:
+        direct_loader.set_preallocated_cuda_pool_bytes(0)
+
+
+def test_resize_falls_back_gracefully_if_external_tensor_pins_scratch(monkeypatch):
+    worker = _make_worker(requested_gib=101.5, kv_gib=16.5, tp_size=4, has_speculator=True)
+    _patch_uma_64k(monkeypatch, o13_count=205, avail_gib=115.5, o12_unmov=8)
+
+    monkeypatch.setattr(torch, "empty", lambda shape, **kw: _FakeBuf())
+    monkeypatch.setattr("vllm.v1.worker.gpu_worker.torch.accelerator.empty_cache", lambda: None)
+    # Simulate an external CUDA allocation keeping the 85 GiB segment pinned across empty_cache()
+    monkeypatch.setattr(
+        torch.cuda, "memory_reserved", lambda _dev=None: int(85.0 * (1024**3))
+    )
+    try:
+        assert worker._preallocate_contiguous_cuda_pool() == int(85.0 * (1024**3))
+        final_bytes, clean = worker._resize_contiguous_cuda_pool_for_model(
+            int(70.5 * (1024**3)), max_moe_bytes=int(1.7 * (1024**3))
+        )
+        assert final_bytes == int(85.0 * (1024**3))
+        assert clean is True
+        assert worker._contiguous_pool_anchor is not None
+    finally:
+        direct_loader.set_preallocated_cuda_pool_bytes(0)
+
