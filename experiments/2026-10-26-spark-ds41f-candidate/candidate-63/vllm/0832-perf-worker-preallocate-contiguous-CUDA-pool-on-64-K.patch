+def test_resize_keeps_pool_on_tp3_exact_fit_fast_path(monkeypatch):
+    worker = _make_worker(requested_gib=101.5, kv_gib=4.90625, tp_size=3, has_speculator=True)
+    _patch_uma_64k(monkeypatch, o13_count=205, avail_gib=115.5, o12_unmov=16)
+
+    alloc_sizes: list[int] = []
+    monkeypatch.setattr(
+        torch, "empty", lambda shape, **kw: (alloc_sizes.append(int(shape[0])) or _FakeBuf())
+    )
+    monkeypatch.setattr("vllm.v1.worker.gpu_worker.torch.accelerator.empty_cache", lambda: None)
+    try:
+        assert worker._preallocate_contiguous_cuda_pool() == int(96.5 * (1024**3))
+        before_calls = len(alloc_sizes)
+        # TP3: 92.86 GiB weights + 2.3 GiB max_moe + 2.67 GiB draft -> clamped to 96.5 GiB
+        final_bytes, clean = worker._resize_contiguous_cuda_pool_for_model(
+            int(92.86 * (1024**3)), max_moe_bytes=int(2.3 * (1024**3))
+        )
+        assert final_bytes == int(96.5 * (1024**3))
+        assert clean is True
+        assert len(alloc_sizes) == before_calls
+    finally:
+        direct_loader.set_preallocated_cuda_pool_bytes(0)
+
