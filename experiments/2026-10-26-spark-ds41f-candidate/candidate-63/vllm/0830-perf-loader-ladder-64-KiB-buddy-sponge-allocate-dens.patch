+def test_select_buddy_sponge_target_ladders_intermediate_64k_orders():
+    # Aged 64 KiB GB10 node: 34 GiB in 512 MiB (order 13) + 50 GiB in 32..256 MiB
+    # (orders 9..12) = 84 GiB >= 75.5 GiB required, plus 8 GiB in 2..16 MiB.
+    # Must select 32 MiB (order 9) instead of dropping straight from 512 MiB to 2 MiB.
+    buddy_dgx_aged = (
+        "Node 0, zone   Normal   "
+        "0 0 0 0 0  512 256 256 256  "
+        "256 256 128 40 68\n"
+    )
+    target, sub_b, high_b = direct_loader.select_buddy_sponge_target(
+        buddy_dgx_aged, required_bytes=78 << 30, page_bytes=65536
+    )
+    assert target == 32 << 20
+    assert sub_b == 8 << 30
+    assert high_b == 84 << 30
+
+    # When 64..512 MiB alone covers required_bytes (76 GiB), target steps up to 64 MiB.
+    target64, sub64, high64 = direct_loader.select_buddy_sponge_target(
+        buddy_dgx_aged, required_bytes=76 << 30, page_bytes=65536
+    )
+    assert target64 == 64 << 20
+    assert sub64 == 16 << 30
+    assert high64 == 76 << 30
+
+    # On 4 KiB kernels, 2 MiB hugepages remain the ceiling (never soak 2 MiB for 4 MiB).
+    buddy_4k_order10 = (
+        "Node 0, zone   Normal   0 0 0 0  256 0 0 0 0  128 256 0 0 0\n"
+    )
+    t4k, sub4k, high4k = direct_loader.select_buddy_sponge_target(
+        buddy_4k_order10, required_bytes=512 << 20, page_bytes=4096
+    )
+    assert t4k == 2 << 20
+    assert sub4k == 16 << 20
+    assert high4k == (128 * (2 << 20)) + (256 * (4 << 20))
+
+
+def test_hold_weight_arena_sponge_defers_trims_and_releases(tmp_path, monkeypatch):
+    class _DummyModel(torch.nn.Module):
+        pass
+
+    reclaimed: list[bool] = []
+    monkeypatch.setattr(
+        direct_loader,
+        "reclaim_uma_memory",
+        lambda device, synchronize=False: reclaimed.append(synchronize),
+    )
+
+    m0 = _DummyModel()
+    m0._direct_buddy_sponge = [torch.empty((16,), dtype=torch.uint8)]
+    assert direct_loader.defer_weight_arena_sponge_release(m0) is False
+
+    m1 = _DummyModel()
+    m1._direct_buddy_sponge = [torch.empty((2 << 20,), dtype=torch.uint8) for _ in range(6)]
+    m1._direct_buddy_sponge_target_bsz = 2 << 20
+
+    buddy_ok = tmp_path / "buddy"
+    buddy_ok.write_text(
+        "Node 0, zone Normal 0 0 0 0 0 0 0 0 0 256 0 0 0 0\n", encoding="utf-8"
+    )
+    mem_tight = tmp_path / "meminfo"
+    mem_tight.write_text(f"MemAvailable: {12 << 10} kB\n", encoding="utf-8")
+    monkeypatch.setattr(
+        direct_loader,
+        "_available_uma_or_gpu_bytes",
+        lambda device, meminfo_path=None: 12 << 20,
+    )
+    monkeypatch.setattr(torch.accelerator, "empty_cache", lambda: None)
+
+    with direct_loader.hold_weight_arena_sponge(torch.device("cpu")):
+        assert direct_loader.defer_weight_arena_sponge_release(m1) is True
+        direct_loader.trim_held_weight_arena_sponges(
+            torch.device("cpu"),
+            buddyinfo_path=buddy_ok,
+            meminfo_path=mem_tight,
+            page_bytes=4096,
+            post_load_headroom_bytes=16 << 20,
+        )
+        assert len(m1._direct_buddy_sponge) == 4
+        assert len(reclaimed) == 0
+
+    assert not hasattr(m1, "_direct_buddy_sponge")
+    assert not hasattr(m1, "_direct_buddy_sponge_target_bsz")
+    assert len(reclaimed) == 1
+
+    m2 = _DummyModel()
+    m2._direct_buddy_sponge = [torch.empty((8,), dtype=torch.uint8)]
+    with pytest.raises(RuntimeError, match="boom"):
+        with direct_loader.hold_weight_arena_sponge(torch.device("cpu")):
+            assert direct_loader.defer_weight_arena_sponge_release(m2) is True
+            raise RuntimeError("boom")
+    assert not hasattr(m2, "_direct_buddy_sponge")
+
+
+def test_bind_weight_arena_allocates_moe_before_dense_arena(monkeypatch):
+    from vllm.model_executor.layers.fused_moe.fused_moe_method_base import (
+        FusedMoEMethodBase,
+    )
+
+    class _FakeMoEMethod(FusedMoEMethodBase):
+        def create_weights(self, *args, **kwargs):
+            pass
+
+        def apply(self, *args, **kwargs):
+            pass
+
+        def get_fused_moe_quant_config(self, layer):
+            return None
+
+    class _FakeDevice:
+        type = "cuda"
+        index = 0
+
+    class _FakeData:
+        def __init__(self, tensor: torch.Tensor):
+            self._t = tensor
+            self.device = _FakeDevice()
+
+        def numel(self):
+            return self._t.numel()
+
+        def untyped_storage(self):
+            return self._t.untyped_storage()
+
+        def element_size(self):
+            return self._t.element_size()
+
+        def storage_offset(self):
+            return self._t.storage_offset()
+
+        @property
+        def shape(self):
+            return self._t.shape
+
+        @property
+        def stride(self):
+            return self._t.stride
+
+    class _FakeParam:
+        def __init__(self, nbytes: int):
+            self.data = _FakeData(torch.empty((nbytes,), dtype=torch.uint8))
+            self.rebound: list[tuple] = []
+
+        def set_(self, storage, offset, shape, stride):
+            self.rebound.append((storage.data_ptr(), offset, shape, stride))
+
+    class _FakeMoE:
+        def __init__(self):
+            self.quant_method = _FakeMoEMethod(None)
+            self.w13 = _FakeParam(4096)
+
+        def parameters(self, recurse=True):
+            return [self.w13]
+
+    class _FakeModel:
+        def __init__(self):
+            self.dense = _FakeParam(1024)
+            self.experts = _FakeMoE()
+
+        def modules(self):
+            return [self, self.experts]
+
+        def parameters(self):
+            return [self.dense, self.experts.w13]
+
+    model = _FakeModel()
+    orig_empty = torch.empty
+    alloc_sizes: list[int] = []
+
+    def tracking_empty(size, *args, **kwargs):
+        kwargs.pop("device", None)
+        if len(size) == 1 and size[0] > 0:
+            alloc_sizes.append(size[0])
+        return orig_empty(size, *args, **kwargs)
+
+    monkeypatch.setattr(torch, "empty", tracking_empty)
+    monkeypatch.setattr(torch.accelerator, "empty_cache", lambda: None)
+    monkeypatch.setattr(torch.accelerator, "synchronize", lambda *_a, **_kw: None)
+    monkeypatch.setattr(direct_loader, "reclaim_uma_memory", lambda *_a, **_kw: None)
+    monkeypatch.setattr(direct_loader, "_PRESERVE_STORAGE_MAX_BYTES", 0)
+
+    arena = direct_loader.bind_weight_arena(
+        model, torch.device("cpu"), order13_sponge=False
+    )
+    assert arena is not None
+    assert alloc_sizes == [4096, 1024]
+    assert model.dense.rebound[-1][0] == arena.untyped_storage().data_ptr()
+    assert model.experts.w13.rebound[-1][0] != arena.untyped_storage().data_ptr()
