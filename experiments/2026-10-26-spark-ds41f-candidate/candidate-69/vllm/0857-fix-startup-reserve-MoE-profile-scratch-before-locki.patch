             else:
                 self._shared_experts(shared_experts_input, order, workspace=workspace)
 
+    def reserve_profile_scratch(self, max_num_tokens: int) -> None:
+        """Reserve worst-case MoE workspace and output buffers before locking
+        the workspace arena when profile_run is skipped under pinned
+        kv_cache_memory_bytes."""
+        if current_platform.is_cpu() or max_num_tokens <= 0:
+            return
+        from vllm.model_executor.layers.fused_moe import modular_kernel as mk
+        from vllm.v1.worker.workspace import (
+            current_workspace_manager,
+            is_workspace_manager_initialized,
+        )
+
+        if not is_workspace_manager_initialized():
+            return
+        kernel = getattr(self._quant_method, "moe_kernel", None)
+        impl = getattr(kernel, "impl", None)
+        if not isinstance(impl, mk.FusedMoEKernelModularImpl):
+            return
+        workspace_manager = current_workspace_manager()
+        device = workspace_manager._device
+        in_dtype = self.moe_config.in_dtype
+        out_dtype = impl.fused_experts.output_dtype
+        hidden_dim = self.moe_config.hidden_dim
+        alloc_hidden_dim = (
+            hidden_dim // 2
+            if impl.fused_experts.quant_dtype == "nvfp4"
+            and not impl.fused_experts.expects_unquantized_inputs
+            else hidden_dim
+        )
+        candidate_rows: set[int] = {max_num_tokens}
+        plan = getattr(impl.fused_experts, "_plan", None)
+        if plan is not None:
+            topk = getattr(plan, "topk", 0)
+            num_experts = getattr(plan, "num_experts", 0)
+            if topk > 0 and num_experts > 0:
+                for attr in ("decode_block_M", "block_M"):
+                    bm = getattr(plan, attr, 0)
+                    if bm > 0:
+                        tier_max = (bm * num_experts - 1) // topk
+                        if 0 < tier_max < max_num_tokens:
+                            candidate_rows.add(tier_max)
+        for rows in sorted(candidate_rows):
+            shared_size = 0
+            if self._shared_experts is not None:
+                shared_size = self._shared_experts.workspace_size(
+                    torch.empty((rows, hidden_dim), dtype=in_dtype, device="meta")
+                )
+            alloc_variants: list[tuple[int, tuple[int, ...] | None]] = [
+                (0, None),
+                (0, (rows, hidden_dim)),
+            ]
+            if shared_size:
+                alloc_variants.append((shared_size, (rows, hidden_dim)))
+            for shared_ws, out_shape in alloc_variants:
+                impl._allocate_buffers(
+                    in_dtype,
+                    out_dtype,
+                    device,
+                    rows,
+                    rows,
+                    self.moe_config.intermediate_size_per_partition,
+                    alloc_hidden_dim,
+                    self.moe_config.experts_per_token,
+                    self.moe_config.num_experts,
+                    self.moe_config.num_local_experts,
+                    None,
+                    self.moe_config.activation,
+                    shared_workspace_size=shared_ws,
+                    output_shape=out_shape,
+                )
+        workspace_manager.get_moe_output_buffer((max_num_tokens, hidden_dim), out_dtype)
+
     def _apply_quant_method(
         self,
         hidden_states: torch.Tensor,
