+def test_reserve_profile_scratch_sizes_moe_workspace_before_lock():
+    import pytest
+    import torch
+    from vllm.model_executor.layers.fused_moe import modular_kernel as mk
+    from vllm.model_executor.layers.fused_moe.activation import MoEActivation
+    from vllm.model_executor.layers.fused_moe.runner.moe_runner import MoERunner
+    from vllm.models.deepseek_v4_1.tilelang.moe import (
+        MoeExpertsV41Plan,
+        workspace_bytes,
+    )
+    from vllm.v1.worker.gpu.model_runner import GPUModelRunner
+    from vllm.v1.worker.workspace import (
+        current_workspace_manager,
+        init_workspace_manager,
+    )
+
+    if not torch.cuda.is_available():
+        pytest.skip("CUDA required for WorkspaceManager reservation test")
+
+    class FakeExperts:
+        def __init__(self, plan):
+            self._plan = plan
+            self.output_dtype = torch.bfloat16
+            self.quant_dtype = None
+            self.expects_unquantized_inputs = True
+
+        def workspace_dtype(self, in_dtype):
+            return in_dtype
+
+        def workspace_shapes(self, M, N, K, topk, g_exp, l_exp, meta, act):
+            nbytes = workspace_bytes(self._plan.workspace_specs(M))
+            return (0,), ((nbytes + 1) // 2,), (M, K)
+
+    class FakeImpl(mk.FusedMoEKernelModularImpl):
+        def __init__(self, experts):
+            self.fused_experts = experts
+
+    init_workspace_manager(torch.device("cuda:0"), num_ubatches=1, num_lanes=1)
+    plan = MoeExpertsV41Plan(num_experts=384, topk=6, hidden=5120, intermediate=1152)
+    impl = FakeImpl(FakeExperts(plan))
+
+    class FakeMoE(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self._quant_method = SimpleNamespace(moe_kernel=SimpleNamespace(impl=impl))
+            self._shared_experts = SimpleNamespace(
+                workspace_size=lambda x: x.shape[0] * 5120 * 2
+            )
+            self.moe_config = SimpleNamespace(
+                in_dtype=torch.bfloat16,
+                hidden_dim=5120,
+                intermediate_size_per_partition=1152,
+                experts_per_token=6,
+                num_experts=384,
+                num_local_experts=384,
+                activation=MoEActivation.SILU,
+            )
+
+        reserve_profile_scratch = MoERunner.reserve_profile_scratch
+
+    class FakeModel(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.moe = FakeMoE()
+
+    fake_model = FakeModel()
+    fake_runner = SimpleNamespace(
+        get_model=lambda: fake_model,
+        get_draft_model=lambda: None,
+        _draft_workspace_lane=0,
+        max_num_tokens=4096,
+        compilation_config=SimpleNamespace(static_forward_context={}),
+    )
+    GPUModelRunner._reserve_profile_scratch(fake_runner)
+    wm = current_workspace_manager()
+    wm.lock()
+    for rows in (1, 192, 1023, 2047, 4096):
+        impl._allocate_buffers(
+            torch.bfloat16,
+            torch.bfloat16,
+            torch.device("cuda:0"),
+            rows,
+            rows,
+            1152,
+            5120,
+            6,
+            384,
+            384,
+            None,
+            MoEActivation.SILU,
+            shared_workspace_size=rows * 5120 * 2,
+            output_shape=(rows, 5120),
+        )
+        buf = wm.get_moe_output_buffer((rows, 5120), torch.bfloat16)
+        assert buf.shape == (rows, 5120)
