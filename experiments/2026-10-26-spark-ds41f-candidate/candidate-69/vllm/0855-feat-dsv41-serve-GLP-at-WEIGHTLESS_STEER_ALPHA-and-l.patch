-        metadata.get("general.base_model.0.name"),
-        metadata.get("general.base_model.0.version"),
+        info["base_model"],
     )
-    return directions, alpha, hook
+    return directions, alpha, hook, info
+
+
+def _file_sha256(path: str) -> str:
+    digest = hashlib.sha256()
+    with open(path, "rb") as stream:
+        while chunk := stream.read(1 << 20):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _alpha_override(raw: str | None) -> float | None:
+    """The served alpha ``WEIGHTLESS_STEER_ALPHA`` asks for, or None when unset."""
+    if raw is None:
+        return None
+    try:
+        alpha = float(raw)
+    except ValueError:
+        raise ValueError(
+            f"WEIGHTLESS_STEER_ALPHA is not a number: {raw!r}"
+        ) from None
+    if not math.isfinite(alpha) or alpha <= 0:
+        raise ValueError(
+            f"WEIGHTLESS_STEER_ALPHA is {raw!r}; the served alpha must be a "
+            "positive finite number"
+        )
+    return alpha
 
 
