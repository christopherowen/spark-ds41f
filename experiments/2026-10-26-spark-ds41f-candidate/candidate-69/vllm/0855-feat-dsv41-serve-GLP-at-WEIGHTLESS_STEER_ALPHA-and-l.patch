+def test_the_alpha_override_replaces_the_file_default(tmp_path, monkeypatch, caplog):
+    path = glp_file(tmp_path)
+    steer(monkeypatch, path)
+    monkeypatch.setenv("WEIGHTLESS_STEER_ALPHA", "2")
+    with caplog.at_level("INFO", logger=glp.logger.name):
+        steering = glp.glp_steering(NUM_LAYERS, HIDDEN, STREAMS, MAX_TOKENS)
+    assert steering.alpha.item() == pytest.approx(2.0)
+    assert steering.layers == frozenset(LAYERS)
+    expected_sha = glp._file_sha256(path)[:16]
+    assert any(
+        "alpha=2.0 (alpha_default=0.75, source=override)" in rec.message
+        and f"file_sha256={expected_sha}" in rec.message
+        and "spec_version=1" in rec.message
+        and f"layers={len(LAYERS)}" in rec.message
+        for rec in caplog.records
+    )
+
