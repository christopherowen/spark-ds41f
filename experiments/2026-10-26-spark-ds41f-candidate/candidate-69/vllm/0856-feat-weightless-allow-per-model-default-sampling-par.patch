+def test_steered_generation_defaults_apply_only_to_steered_model(monkeypatch):
+    from vllm import weightless
+
+    monkeypatch.setenv("WEIGHTLESS_STEER_MODEL", "deepseek-v4.1-flash-weightless")
+    monkeypatch.setenv(
+        "WEIGHTLESS_STEER_GENERATION_DEFAULTS",
+        '{"temperature": 0.3, "top_p": 0.95}',
+    )
+    base = {"temperature": 1.0, "top_p": 1.0}
+    assert weightless.sampling_defaults("deepseek-v4.1-flash", base) == {
+        "temperature": 1.0,
+        "top_p": 1.0,
+    }
+    assert weightless.sampling_defaults("deepseek-v4.1-flash-weightless", base) == {
+        "temperature": 0.3,
+        "top_p": 0.95,
+    }
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "not-json",
+        "[1, 2]",
+        '{"temperature": -0.1}',
+        '{"top_p": 0}',
+        '{"top_p": 1.5}',
+        '{"unknown_key": 1}',
+    ],
+)
+def test_invalid_steered_generation_defaults_are_refused(monkeypatch, raw):
+    from vllm import weightless
+
+    monkeypatch.setenv("WEIGHTLESS_STEER_MODEL", "deepseek-v4.1-flash-weightless")
+    monkeypatch.setenv("WEIGHTLESS_STEER_GENERATION_DEFAULTS", raw)
+    with pytest.raises(ValueError, match="WEIGHTLESS_STEER_GENERATION_DEFAULTS"):
+        weightless.sampling_defaults("deepseek-v4.1-flash-weightless", {"temperature": 1.0})
+
