diff --git a/vllm/model_executor/model_loader/utils.py b/vllm/model_executor/model_loader/utils.py
index 3f0623f12..c76454313 100644
--- a/vllm/model_executor/model_loader/utils.py
+++ b/vllm/model_executor/model_loader/utils.py
@@ -149,11 +149,29 @@ def process_weights_after_loading(
                 module.update_param_tp_status()
             # Repacking transients above can leave large amounts of memory in
             # the caching allocator, which starves the OS on UMA devices.
-            if (
-                not track_cuda_reserved
-                or torch.cuda.memory_reserved(target_device) > reserved_before
-            ):
+            # Keep a bounded reusable working set (< 4 GiB) across identical
+            # layers while host memory still has >= 8 GiB available so
+            # back-to-back MoE layers reuse the same scratch blocks instead of
+            # unmapping and re-faulting them on every layer; reclaim once after
+            # the loop.
+            if not track_cuda_reserved:
                 release_device_memory_under_pressure(target_device)
+            else:
+                reserved_after = torch.cuda.memory_reserved(target_device)
+                if reserved_after > reserved_before:
+                    releasable = reserved_after - torch.cuda.memory_allocated(
+                        target_device
+                    )
+                    if releasable >= (4 << 30):
+                        release_device_memory_under_pressure(target_device)
+                    elif releasable >= (512 << 20):
+                        import psutil
+
+                        if psutil.virtual_memory().available < (8 << 30):
+                            release_device_memory_under_pressure(target_device)
+
+    if track_cuda_reserved:
+        release_device_memory_under_pressure(target_device)
 
     # Initialize post-load attention weights for any attention layer and MM
     # encoder. NOTE: Happens after other modules so we can easily decompress
