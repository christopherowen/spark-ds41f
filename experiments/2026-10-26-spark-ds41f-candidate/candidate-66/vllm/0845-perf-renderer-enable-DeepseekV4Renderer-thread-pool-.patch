             joined: list[int] = []
-            for sub in work_ids[start : start + count]:
-                joined.extend(sub)
-            ids_tuple = tuple(joined)
-        resolved[piece] = ids_tuple
-        cache[piece] = ids_tuple
+            for sub in subchunks:
+                hit = sub_cached.get(sub)
+                if hit is None:
+                    hit = tuple(work_ids[work_index[sub]])
+                    sub_cached[sub] = hit
+                    cache[sub] = hit
+                joined.extend(hit)
+            resolved[piece] = tuple(joined)
     return resolved
 
 
