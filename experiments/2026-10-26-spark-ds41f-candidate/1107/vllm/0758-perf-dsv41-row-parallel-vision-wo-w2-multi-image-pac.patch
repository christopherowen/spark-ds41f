+def test_multi_image_packing_and_collective_reduction(real, small, monkeypatch):
+    """Packing multiple images in encode_images matches per-image forward bit-for-bit
+    on GEMM-sized images, splits chunks when total patches exceed capacity, and
+    collapses 4 images into a single set of TP collectives."""
+    import threading
+    import vllm.distributed as distributed
+
+    ref_vit, ref_aligner = real
+    grids = [(9, 9), (9, 12), (7, 11), (12, 12)]
+    images = [
+        _patches(REAL, h * w, seed=500 + i) for i, (h, w) in enumerate(grids)
+    ]
+    packed_patches = torch.cat(images, dim=0)
+    expected = [
+        ref_aligner(ref_vit(img, h, w), h, w)
+        for img, (h, w) in zip(images, grids)
+    ]
+    got = tilelang_vision.encode_images(
+        ref_vit, ref_aligner, packed_patches, grids
+    )
+    assert len(got) == len(expected)
+    for idx, (g, e) in enumerate(zip(got, expected)):
+        _assert_bits(g, e, f"TP1 packed image {idx}")
+
+    # Multi-chunk splitting when total patches exceed SMALL.capacity (144).
+    small_vit, small_aligner = small
+    overflow_grids = [(10, 10), (9, 9), (6, 6)]  # 100 + 81 + 36 = 217 > 144 -> 2 chunks
+    overflow_imgs = [
+        _patches(SMALL, h * w, seed=700 + i)
+        for i, (h, w) in enumerate(overflow_grids)
+    ]
+    overflow_got = tilelang_vision.encode_images(
+        small_vit, small_aligner, torch.cat(overflow_imgs, dim=0), overflow_grids
+    )
+    for idx, (img, (h, w), g) in enumerate(
+        zip(overflow_imgs, overflow_grids, overflow_got)
+    ):
+        _assert_bits(
+            g,
+            small_aligner(small_vit(img, h, w), h, w),
+            f"multi-chunk image {idx}",
+        )
+
+    # TP4 packed 4-image pass: 1x collectives (2 * n_layers + 1) instead of 4x.
+    tp_size = 4
+    vits4, aligners4 = _build_tp_shards(ref_vit, ref_aligner, tp_size)
+    barrier = threading.Barrier(tp_size)
+    partials: list[torch.Tensor | None] = [None] * tp_size
+    local_rank = threading.local()
+    gather_calls = [0] * tp_size
+
+    def sync_all_gather(tensor: torch.Tensor, dim: int = -1) -> torch.Tensor:
+        r = local_rank.rank
+        gather_calls[r] += 1
+        partials[r] = tensor.clone()
+        barrier.wait()
+        gathered = torch.cat([partials[i] for i in range(tp_size)], dim=dim)
+        barrier.wait()
+        return gathered
+
+    monkeypatch.setattr(distributed, "tensor_model_parallel_all_gather", sync_all_gather)
+    rank_outputs: list[list[torch.Tensor] | None] = [None] * tp_size
+    errors: list[BaseException] = []
+
+    def worker(rank: int) -> None:
+        try:
+            local_rank.rank = rank
+            rank_outputs[rank] = tilelang_vision.encode_images(
+                vits4[rank], aligners4[rank], packed_patches, grids
+            )
+        except BaseException as exc:  # noqa: BLE001
+            errors.append(exc)
+            barrier.abort()
+
+    threads = [threading.Thread(target=worker, args=(r,)) for r in range(tp_size)]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join()
+    if errors:
+        raise errors[0]
+
+    expected_gathers = 2 * REAL.vision_n_layers + 1
+    assert gather_calls == [expected_gathers] * tp_size
+    for r in range(tp_size):
+        for idx in range(len(grids)):
+            _assert_bits(
+                rank_outputs[r][idx],
+                rank_outputs[0][idx],
+                f"TP4 packed rank {r} image {idx}",
+            )
+            assert _relative(rank_outputs[r][idx], expected[idx]) <= 2.0**-7
+
