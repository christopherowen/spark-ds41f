+def test_oversized_image_transparent_downscaling(monkeypatch):
+    """Oversized images (> VLLM_MAX_IMAGE_PIXELS) are transparently downscaled via
+    Pillow draft() + thumbnail() while preserving aspect ratio."""
+    from io import BytesIO
+    from PIL import Image
+    import vllm.envs as envs
+    from vllm.multimodal.media.image import ImageMediaIO
+
+    monkeypatch.setattr(envs, "VLLM_MAX_IMAGE_PIXELS", 40000)
+    img = Image.new("RGB", (600, 300), (120, 45, 200))
+    buf = BytesIO()
+    img.save(buf, format="JPEG")
+    loaded = ImageMediaIO().load_bytes(buf.getvalue())
+    w, h = loaded.media.size
+    assert w * h <= 40000
+    assert abs((w / h) - 2.0) < 0.05
+    assert loaded.io_config == {"max_pixels": 40000}
