+@run_async
+@pytest.mark.parametrize("repeats", [1, 3])
+async def test_repeated_cancellation_waits_for_abort(repeats):
+    request = Request()
+    started, abort_started, finish_abort, closed = (asyncio.Event() for _ in range(4))
+
+    @route
+    async def handle(_, raw_request):
+        started.set()
+        try:
+            await asyncio.Event().wait()
+        finally:
+            abort_started.set()
+            await finish_abort.wait()
+            closed.set()
+
+    parent = asyncio.create_task(handle(None, request))
+    await started.wait()
+    await request.listening.wait()
+    parent.cancel("first timeout")
+    await abort_started.wait()
+    for i in range(repeats):
+        parent.cancel(f"repeat timeout {i}")
+        await asyncio.sleep(0)
+    try:
+        await asyncio.sleep(0.01)
+        assert not parent.done(), "second cancellation interrupted owned abort cleanup"
+        finish_abort.set()
+        with pytest.raises(asyncio.CancelledError):
+            await parent
+        assert closed.is_set()
+        assert request.listener_closed.is_set()
+        assert request.app.state.server_load_metrics == 0
+    finally:
+        finish_abort.set()
+        await asyncio.gather(parent, return_exceptions=True)
+
+
+@run_async
+async def test_repeated_cancellation_during_response_handoff():
+    from fastapi.responses import JSONResponse
+
+    request = Request()
+    cleanup_started, finish_cleanup, closed = (asyncio.Event() for _ in range(3))
+
+    async def receive():
+        request.listening.set()
+        try:
+            await asyncio.Event().wait()
+        finally:
+            cleanup_started.set()
+            await finish_cleanup.wait()
+            closed.set()
+
+    request.receive = receive
+
+    @route
+    async def handle(_, raw_request):
+        await raw_request.listening.wait()
+        return JSONResponse({"ok": True})
+
+    parent = asyncio.create_task(handle(None, request))
+    await cleanup_started.wait()
+    try:
+        for i in range(3):
+            parent.cancel(f"handoff timeout {i}")
+            await asyncio.sleep(0)
+        await asyncio.sleep(0.01)
+        assert not parent.done()
+        finish_cleanup.set()
+        with pytest.raises(asyncio.CancelledError):
+            await parent
+        assert closed.is_set()
+        assert request.app.state.server_load_metrics == 0
+    finally:
+        finish_cleanup.set()
+        await asyncio.gather(parent, return_exceptions=True)
diff --git a/vllm/entrypoints/serve/utils/api_utils.py b/vllm/entrypoints/serve/utils/api_utils.py
index 90aa7398b..293469bda 100644
--- a/vllm/entrypoints/serve/utils/api_utils.py
+++ b/vllm/entrypoints/serve/utils/api_utils.py
@@ -93,7 +93,20 @@ def with_cancellation(handler_func):
                 # Starlette middleware may cancel an AnyIO scope. Keep asynchronous
                 # cleanup alive inside that scope, and retrieve both task outcomes.
                 with anyio.CancelScope(shield=True):
-                    await asyncio.gather(*tasks, return_exceptions=True)
+                    interrupted = None
+                    while True:
+                        try:
+                            # wait() does not cancel children when its caller is
+                            # cancelled again while their cleanup is running.
+                            await asyncio.wait(tasks)
+                            break
+                        except asyncio.CancelledError as exc:
+                            interrupted = exc
+                    for task in tasks:
+                        if not task.cancelled():
+                            task.exception()
+                    if interrupted is not None:
+                        raise interrupted
         except BaseException:
             # A response produced by the handler may be abandoned while we
             # join the listener. No response background task will release it.
