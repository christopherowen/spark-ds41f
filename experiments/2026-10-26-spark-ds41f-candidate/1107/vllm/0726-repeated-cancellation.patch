 async def test_cancel_during_response_handoff_releases_load():
     request = Request()
     cleanup_started = asyncio.Event()
+    finish_cleanup = asyncio.Event()
+    cleanup_closed = asyncio.Event()
 
     async def receive():
         request.listening.set()
@@ -320,7 +322,8 @@ async def test_cancel_during_response_handoff_releases_load():
             await asyncio.Event().wait()
         finally:
             cleanup_started.set()
-            await asyncio.Event().wait()
+            await finish_cleanup.wait()
+            cleanup_closed.set()
 
     request.receive = receive
 
@@ -332,6 +335,93 @@ async def test_cancel_during_response_handoff_releases_load():
     task = asyncio.create_task(handle(None, request))
     await cleanup_started.wait()
     task.cancel()
-    with pytest.raises(asyncio.CancelledError):
-        await task
-    assert request.app.state.server_load_metrics == 0
+    try:
+        await asyncio.sleep(0)
+        assert not task.done()
+        finish_cleanup.set()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+        assert cleanup_closed.is_set()
+        assert request.app.state.server_load_metrics == 0
