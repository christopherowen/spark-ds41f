+def test_native_score_inputs_work_after_startup_freeze(monkeypatch):
+    import importlib
+
+    import tilelang.cache
+
+    from vllm.model_executor.warmup.jit_warmup import JitWarmupRegistry
+    from vllm.models.deepseek_v4_1.tilelang import prepare
+    from vllm.v1.worker.gpu.sample import tilelang_topk_ids
+
+    cache_module = importlib.import_module(tilelang.cache.freeze.__module__)
+    monkeypatch.setattr(cache_module, "_frozen_reason", None)
+    monkeypatch.setattr(tls, "_KERNELS", {})
+    for kernel in (
+        tilelang_logprob.topk_log_softmax_kernel,
+        tilelang_logprob.ranks_kernel,
+        tilelang_topk_ids.topk_ids_kernel,
+    ):
+        monkeypatch.setattr(kernel, "_kernel_cache", {})
+        monkeypatch.setattr(kernel, "_call_form_cache", type(kernel._call_form_cache)())
+    pairs = [(dtype, 264) for dtype in (torch.float16, torch.bfloat16, torch.float32)]
+    registry = JitWarmupRegistry(None)
+    with registry.activate():
+        logprob.register_topk_scores_warmup(
+            logits=pairs, vocab_size=257, logits_mode=False
+        )
+    prepare.prepare_declared(registry)
+    prepare.freeze("native score inputs warmup test")
+    for dtype, _ in pairs:
+        logits = torch.randn(3, 264, device=DEVICE, dtype=dtype)[:, :257]
+        for id_dtype in (torch.int32, torch.int64):
+            ids = torch.randint(257, (3, 18), device=DEVICE, dtype=id_dtype)[:, ::2]
+            valid = ids % 3 != 0
+            for mask in (None, valid):
+                actual = logprob.compute_token_logprobs(logits, ids, mask)
+                assert actual.shape == ids.shape
+            for topk in (0, 5):
+                actual = logprob.compute_topk_scores(logits, topk, ids[:, 0])
+                assert torch.equal(actual.logprob_token_ids[:, 0], ids[:, 0])
