+@pytest.mark.parametrize("layout", ["dense", "sliced", "transposed"])
+@pytest.mark.parametrize("masked", [False, True])
+def test_logprobs_read_native_ids_and_masks(dtype, id_dtype, layout, masked):
+    """ID and mask strides change addressing, never log-softmax arithmetic."""
+    rows, cols, vocab = 5, 33, 8193
+    logits = torch.randn(rows, vocab + 7, device=DEVICE, dtype=dtype)[:, :vocab]
+    ids = torch.randint(vocab, (rows, cols), device=DEVICE, dtype=id_dtype)
+    valid = torch.rand(rows, cols, device=DEVICE) > 0.3
+    if layout == "sliced":
+        ids = torch.stack((ids, ids), dim=-1)[..., 0]
+        valid = torch.stack((valid, valid), dim=-1)[..., 0]
+    elif layout == "transposed":
+        ids = ids.t().contiguous().t()
+        valid = valid.t().contiguous().t()
+    before = ids.clone()
+    mask = valid if masked else None
+    expected = logprob.compute_token_logprobs(
+        logits, ids.long().contiguous(), valid.contiguous() if masked else None
+    )
+    actual = logprob.compute_token_logprobs(logits, ids, mask)
+    _assert_same(actual, expected, f"native {id_dtype} {layout} mask={masked}")
+    fp64 = logits.double().log_softmax(-1).gather(1, ids.long()).float()
+    if masked:
+        fp64.masked_fill_(~valid, -torch.inf)
+    torch.testing.assert_close(actual, fp64, rtol=2e-6, atol=1e-6)
+    assert torch.equal(ids, before)
+
+
+@pytest.mark.parametrize("id_dtype", [torch.int32, torch.int64])
+@pytest.mark.parametrize("logits_mode", [False, True])
+@pytest.mark.parametrize("topk", [0, 5])
+def test_native_sampled_ids_keep_score_values_and_wire_ids(id_dtype, logits_mode, topk):
+    logits = torch.randn(3, 257, device=DEVICE)
+    sampled = torch.tensor([0, -1, 256, -1, 17, -1], device=DEVICE, dtype=id_dtype)[::2]
+    actual = logprob.compute_topk_scores(logits, topk, sampled, logits_mode=logits_mode)
+    ids = actual.logprob_token_ids
+    assert torch.equal(ids[:, 0], sampled)
+    if topk == 0:
+        assert ids.data_ptr() == sampled.data_ptr()
+        assert ids.dtype == sampled.dtype
+    else:
+        assert ids.dtype == torch.int64
+    expected = (
+        logits.gather(1, ids.long())
+        if logits_mode
+        else logprob.compute_token_logprobs(logits, ids.long().contiguous())
+    )
+    _assert_same(actual.logprobs, expected, "native sampled ids")
+    assert torch.equal(
+        actual.selected_token_ranks,
+        (logits >= logits.gather(1, sampled[:, None].long())).sum(-1),
+    )
+    # The engine serializes either NumPy integer width to ordinary Python ints.
+    cpu = actual.to_cpu_nonblocking()
+    torch.cuda.synchronize()
+    wire = cpu.tolists().logprob_token_ids.tolist()
+    assert [row[0] for row in wire] == [0, 256, 17]
+    assert all(type(value) is int for row in wire for value in row)
+
