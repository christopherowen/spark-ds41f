+        ints[3, 0] = doublings
+        drafts, conf, planned, alloc, _ = _propose(
+            history,
+            total_len,
+            idx,
+            sources,
+            ints,
+            floats,
+            zero,
+            zero,
+            zero,
+            dspark=low_dspark,
