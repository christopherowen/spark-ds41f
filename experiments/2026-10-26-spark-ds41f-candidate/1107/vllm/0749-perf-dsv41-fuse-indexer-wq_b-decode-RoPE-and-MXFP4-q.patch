+def test_index_query_fuses_wqb_rope_mxfp4_decode(monkeypatch):
+    """At decode row counts (``rows <= tilelang_decode_rows``), ``_index_query`` runs
+    ``project_block32_rope_mxfp4_decode`` directly into ``(iq_data, iq_scale)`` without
+    allocating ``iq`` or launching ``_quantize_index_query``."""
+    from vllm.models.deepseek_v4_1.tilelang import linear as tl_linear
+    from vllm.models.deepseek_v4_1.tilelang.linear import MXFP8Rows
+
+    module = _tilelang_layer(layer_id=3)
+    fused_calls = []
+
+    def fake_wqb(x):
+        raise AssertionError("unfused wq_b should not be called on decode rows")
+
+    fake_wqb.tilelang_decode_rows = 64
+    fake_wqb.tilelang_decode_rope_mxfp4 = {16: object(), 32: object(), 64: object()}
+    module.indexer = SimpleNamespace(
+        heads=32,
+        wq_b=fake_wqb,
+        weights_proj=lambda h: torch.ones((h.shape[0], 32), dtype=torch.bfloat16),
+    )
+
+    def fake_fused(layer, qr_rows, pos_rows, cos_sin, iq_data, iq_scale):
+        provided = tl_linear.provided_mxfp8(qr_rows)
+        fused_calls.append(
+            (
+                layer is fake_wqb,
+                tuple(qr_rows.shape),
+                tuple(provided.values.shape),
+                pos_rows.tolist(),
+                tuple(iq_data.shape),
+                tuple(iq_scale.shape),
+            )
+        )
+        iq_data.fill_(7)
+        iq_scale.fill_(3)
+
+    monkeypatch.setattr(tl_linear, "project_block32_rope_mxfp4_decode", fake_fused)
+    qr = torch.zeros((6, 1280), dtype=torch.bfloat16)
+    q_cast = MXFP8Rows(
+        qr,
+        torch.zeros((64, 1280), dtype=torch.float8_e4m3fn),
+        torch.zeros((64, 40), dtype=torch.uint8),
+    )
+    positions = torch.arange(20, 26, dtype=torch.int64)
+    hidden = torch.zeros((6, 5120), dtype=torch.bfloat16)
+    swa = SimpleNamespace(is_decode=True)
+    iq_data, iq_scale, weights = module._index_query(
+        qr, positions, hidden, None, 0, 6, swa, q_cast
+    )
+    assert fused_calls == [
+        (True, (6, 1280), (64, 1280), [20, 21, 22, 23, 24, 25], (6, 32, 64), (6, 32, 4))
+    ]
+    assert int(iq_data.min()) == 7 and int(iq_scale.min()) == 3
+    assert weights.shape == (6, 32)
+
