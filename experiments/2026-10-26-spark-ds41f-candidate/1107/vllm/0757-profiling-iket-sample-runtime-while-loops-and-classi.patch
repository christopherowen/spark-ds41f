+@GPU
+def test_vision_and_multi_warp_tma_producers_synchronized_natively():
+    import re
+    import tilelang
+    import tilelang.language as T
+    from vllm.models.deepseek_v4_1.tilelang import vision
+
+    for fn, args in [
+        (vision.linear_kernel, (1152, 1152, False)),
+        (vision.swiglu_linear_kernel, (4352, 1152)),
+        (vision.attention_kernel, (16, 80)),
+    ]:
+        src = fn.compile(*args).get_kernel_source()
+        flat = " ".join(src.split())
+        producer = flat.split("if (((int)threadIdx.x) < 128) {", 1)[1].split("} else {", 1)[0]
+        assert "if (((int)threadIdx.x) < 32)" in producer, src
+        assert "tl::tl_shuffle_elect<32>()" in producer, src
+
+    @T.prim_func
+    def multi_group_tma(
+        A: T.Tensor((128, 256), T.float16),
+        B1: T.Tensor((256, 128), T.float16),
+        B2: T.Tensor((256, 128), T.float16),
+        I: T.Tensor((4,), T.int32),
+        C: T.Tensor((128, 128), T.float32),
+    ):
+        with T.Kernel(2, 2, threads=128) as (bx, by):
+            A_shared = T.alloc_shared((64, 64), T.float16)
+            B1_shared = T.alloc_shared((64, 64), T.float16)
+            B2_shared = T.alloc_shared((64, 64), T.float16)
+            C_frag = T.alloc_fragment((64, 64), T.float32)
+            T.clear(C_frag)
+            for k in T.Pipelined(4, num_stages=2):
+                idx = I[k] * 64
+                T.copy(A[by * 64, idx], A_shared)
+                T.copy(B1[idx, bx * 64], B1_shared)
+                T.gemm(A_shared, B1_shared, C_frag)
+                T.copy(B2[idx, bx * 64], B2_shared)
+                T.gemm(A_shared, B2_shared, C_frag)
+            T.copy(C_frag, C[by * 64, bx * 64])
+
+    mg_src = tilelang.compile(multi_group_tma, target="cuda", execution_backend="tvm_ffi").get_kernel_source()
+    mg_flat = " ".join(mg_src.split())
+    mg_producer = mg_flat.split("if (((int)threadIdx.x) < 128) {", 1)[1].split("} else {", 1)[0]
+    waits = re.findall(
+        r"mbarrier\[[^\]]+\]\.wait\([^;]+\);\s*tl::__sync_thread_partial\(\d+, 128\);",
+        mg_producer,
+    )
+    assert len(waits) == mg_producer.count(".wait(") >= 2, mg_src
