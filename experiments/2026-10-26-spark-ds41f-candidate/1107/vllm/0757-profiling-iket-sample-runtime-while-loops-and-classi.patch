+def test_vllm_gather_b128_classified_as_global_store():
+    src = """
+    __global__ void gather_columns_into(const bfloat16_t* __restrict__ src, bfloat16_t* __restrict__ out0, bfloat16_t* __restrict__ out1, int rows, int stride0, int stride1) {
+      int row = (int)blockIdx.x;
+      int col = ((((int)blockIdx.y) * 128) + ((int)threadIdx.x)) * 8;
+      if (col < 384) {
+        int source_row = (((col / 128) * 2) * rows) + row;
+        if ((col + 8) <= 384) {
+          vllm_gather_b128((&(out0[((row * stride0) + col)])), (&(src[((source_row * 128) + (col % 128))])));
+        } else {
+          for (int k = 0; k < 8; ++k) {
+            if ((col + k) < 384) {
+              out0[(((row * stride0) + col) + k)] = src[(((source_row * 128) + (col % 128)) + k)];
+            }
+          }
+        }
+      }
+    }
+    """
