 vllm/v1/engine/core_client.py                |  44 +++--
 2 files changed, 217 insertions(+), 13 deletions(-)
 create mode 100644 tests/v1/engine/test_utility_call_cleanup.py

diff --git a/tests/v1/engine/test_utility_call_cleanup.py b/tests/v1/engine/test_utility_call_cleanup.py
new file mode 100644
index 0000000000..5977cad87d
--- /dev/null
+++ b/tests/v1/engine/test_utility_call_cleanup.py
@@ -0,0 +1,186 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Every utility caller releases its slot, including when no reply can arrive."""
+
+import asyncio
+from concurrent.futures import Future
+from types import SimpleNamespace
+
+import pytest
+
+from vllm.v1.engine import UtilityOutput, UtilityResult
+from vllm.v1.engine.core_client import (
+    AsyncMPClient,
+    SyncMPClient,
+    _process_utility_output,
+)
+
+pytestmark = pytest.mark.cpu_test
+
+
+def reply(call_id, failure=False):
+    return UtilityOutput(
+        call_id=call_id,
+        failure_message="utility failed" if failure else None,
+        result=None if failure else UtilityResult("ok"),
+    )
+
+
+def make_client(asynchronous, stage=None, failure=False):
+    cls = AsyncMPClient if asynchronous else SyncMPClient
+    client = cls.__new__(cls)
+    client.resources = SimpleNamespace(engine_dead=False)
+    client.client_index = 0
+    client.core_engine = b"\x00\x00"
+    client.utility_results = {}
+    client.entered = asyncio.Event() if asynchronous else None
+    client.call_id = None
+
+    def encode(value):
+        client.call_id = value[1]
+        if stage == "encode":
+            raise ValueError("encode failed")
+        return [b"utility"]
+
+    client.encoder = SimpleNamespace(encode=encode)
+
+    async def send_async(message, engine):
+        if stage == "send":
+            raise RuntimeError("send failed")
+        if stage == "block_send":
+            client.entered.set()
+            await asyncio.Future()
+        if stage != "wait_reply" and stage != "output_task":
+            _process_utility_output(reply(client.call_id, failure), client.utility_results)
+
+    def send_sync(message, copy=False):
+        if stage == "send":
+            raise RuntimeError("send failed")
+        _process_utility_output(reply(client.call_id, failure), client.utility_results)
+
+    def ensure_output():
+        if stage == "output_task":
+            raise RuntimeError("output task failed")
+        client.entered.set()
+
+    client._send_input_message = send_async
+    client.input_socket = SimpleNamespace(send_multipart=send_sync)
+    client._ensure_output_queue_task = ensure_output
+    return client
+
+
+@pytest.mark.parametrize("stage", ["encode", "send", "output_task"])
+def test_async_utility_failure_releases_pending_future(stage):
+    async def run():
+        client = make_client(True, stage)
+        with pytest.raises((ValueError, RuntimeError), match="failed"):
+            await client.call_utility_async("echo", "payload")
+        assert not client.utility_results
+
+    asyncio.run(run())
+
+
+@pytest.mark.parametrize("stage", ["encode", "send"])
+def test_sync_utility_failure_releases_pending_future(stage):
+    client = make_client(False, stage)
+    with pytest.raises((ValueError, RuntimeError), match="failed"):
+        client.call_utility("echo", "payload")
+    assert not client.utility_results
+
+
+@pytest.mark.parametrize("stage", ["block_send", "wait_reply"])
+def test_cancellation_releases_slot_and_late_reply_is_harmless(stage):
+    async def run():
+        client = make_client(True, stage)
+        task = asyncio.create_task(client.call_utility_async("echo"))
+        await asyncio.wait_for(client.entered.wait(), 2)
+        call_id = client.call_id
+        task.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+        assert not client.utility_results
+        _process_utility_output(reply(call_id), client.utility_results)
+        assert not client.utility_results
+        # A delayed response must not kill the output receiver or another call.
+        healthy = make_client(True)
+        healthy.utility_results = client.utility_results
+        assert await healthy.call_utility_async("echo") == "ok"
+        assert not healthy.utility_results
+
+    asyncio.run(run())
+
+
+@pytest.mark.parametrize("asynchronous", [False, True])
+def test_repeated_failed_utility_calls_do_not_accumulate(asynchronous):
+    async def run():
+        client = make_client(asynchronous, "send")
+        for _ in range(64):
+            with pytest.raises(RuntimeError, match="send failed"):
+                if asynchronous:
+                    await client.call_utility_async("echo")
+                else:
+                    client.call_utility("echo")
+        assert not client.utility_results
+
+    asyncio.run(run())
+
+
+@pytest.mark.parametrize("asynchronous", [False, True])
+@pytest.mark.parametrize("failure", [False, True])
+def test_normal_utility_reply_keeps_result_and_cleanup(asynchronous, failure):
+    async def run():
+        client = make_client(asynchronous, failure=failure)
+
+        async def call():
+            if asynchronous:
+                return await client.call_utility_async("echo")
+            return client.call_utility("echo")
+
+        if failure:
+            with pytest.raises(Exception, match="utility failed"):
+                await call()
+        else:
+            assert await call() == "ok"
+        assert not client.utility_results
+
+    asyncio.run(run())
+
+
+@pytest.mark.parametrize("failure", [False, True])
+def test_unknown_or_duplicate_utility_reply_does_not_stop_receiver(failure):
+    _process_utility_output(reply(123, failure), {})
+
+
+@pytest.mark.parametrize("asynchronous", [False, True])
+@pytest.mark.parametrize("failure", [False, True])
+def test_reply_racing_with_cancelled_future_does_not_stop_receiver(asynchronous, failure):
+    async def run():
+        future = asyncio.get_running_loop().create_future() if asynchronous else Future()
+        results = {123: future}
+        future.cancel()
+        _process_utility_output(reply(123, failure), results)
+        assert not results
+
+    asyncio.run(run())
+
+
+def test_cancelling_one_utility_does_not_remove_another_pending_call():
+    async def run():
+        client = make_client(True, "wait_reply")
+        first = asyncio.create_task(client.call_utility_async("first"))
+        await asyncio.wait_for(client.entered.wait(), 2)
+        first_id = client.call_id
+        client.entered.clear()
+        second = asyncio.create_task(client.call_utility_async("second"))
+        await asyncio.wait_for(client.entered.wait(), 2)
+        second_id = client.call_id
+        first.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await first
+        assert set(client.utility_results) == {second_id}
+        _process_utility_output(reply(first_id), client.utility_results)
+        _process_utility_output(reply(second_id), client.utility_results)
+        assert await second == "ok"
+        assert not client.utility_results
+
+    asyncio.run(run())
