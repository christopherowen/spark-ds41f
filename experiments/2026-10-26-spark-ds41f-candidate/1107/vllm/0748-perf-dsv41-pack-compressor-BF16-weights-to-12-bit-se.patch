+    shard_cols = K // shards
+    row_bytes = K + K // 2
+    base_minus_one = exponent_base - 1
+    slices = _PACKED_HALF // _PACKED_VEC
+    items = block_N * slices
+    iters = tilelang.cdiv(items, threads)
