+def _bf16_shape(layer: nn.Module) -> tuple[int, int]:
+    """Logical ``(out_features, in_features)`` of an unpacked or 12-bit packed BF16 weight."""
+    return (
+        int(layer.weight.shape[0]),
+        int(getattr(layer, "packed_bf16_in_features", layer.weight.shape[1])),
+    )
+
+
+def pack_bf16_layer(layer: nn.Module, shards: int) -> None:
+    """Pack a contiguous CUDA BF16 weight in place when ``K`` and its shards are
+    multiples of ``GROUP`` (128)."""
+    if hasattr(layer, "packed_bf16_exponent_base"):
+        return
+    weight = layer.weight.data
+    if (
+        weight.ndim != 2
+        or weight.dtype != torch.bfloat16
+        or not weight.is_cuda
+        or not weight.is_contiguous()
+    ):
+        return
+    n, k = map(int, weight.shape)
+    if n == 0 or k == 0 or k % GROUP or (k // GROUP) % shards:
+        return
+    packed = pack_bf16_weight(weight, in_place=True)
+    layer.weight.data = packed.values
+    layer.packed_bf16_in_features = k
+    layer.packed_bf16_exponent_base = packed.exponent_base
+    layer.packed_bf16_exceptions = packed.exceptions
+    layer.weight_exception_entries = packed.exception_entries
+    layer.weight_row_offsets = packed.row_offsets
+
+
+def unpack_bf16_layer(layer: nn.Module) -> torch.Tensor:
+    """Return ``layer``'s logical ``[N, K]`` BF16 weight, unpacking 12-bit storage if packed."""
+    if not hasattr(layer, "packed_bf16_exponent_base"):
+        return layer.weight
+    n, k = _bf16_shape(layer)
+    packed = layer.weight
+    low = packed[:, :k].to(torch.int32)
+    codes = packed[:, k:].to(torch.int32)
+    code_a = codes & 0x0F
+    code_b = (codes >> 4) & 0x0F
+    exp_code = torch.stack(
+        (
+            code_a.view(n, k // GROUP, GROUP // 2),
+            code_b.view(n, k // GROUP, GROUP // 2),
+        ),
+        dim=2,
+    ).reshape(n, k)
+    base_minus_one = int(layer.packed_bf16_exponent_base) - 1
+    exp = torch.where(
+        exp_code > 0, exp_code + base_minus_one, torch.zeros_like(exp_code)
+    )
+    bits = ((low & 0x80) << 8) | (exp << 7) | (low & 0x7F)
+    entries = layer.weight_exception_entries
+    if entries.numel() > 0:
+        u = entries.to(torch.int64) & 0xFFFFFFFF
+        cols = u >> 16
+        exc_bits = (u & 0xFFFF).to(torch.int32)
+        offsets = layer.weight_row_offsets.to(torch.int64)
+        counts = offsets[1:] - offsets[:-1]
+        rows = torch.repeat_interleave(
+            torch.arange(n, device=bits.device, dtype=torch.int64), counts
+        )
+        bits[rows, cols] = exc_bits
+    return bits.to(torch.int16).view(torch.bfloat16)
