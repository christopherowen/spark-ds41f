+                    if (kg + 1) % shard_groups == 0:
+                        for i, j in T.Parallel(block_M, block_N):
+                            C_total[i, j] = T.if_then_else(
+                                kg + 1 == shard_groups,
+                                C_local[i, j],
+                                C_total[i, j] + C_local[i, j],
