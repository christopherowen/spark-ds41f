+                    T.copy(A[by * block_M, kg * _PACKED_GROUP], A0_shared)
+                    T.copy(
+                        A[by * block_M, kg * _PACKED_GROUP + _PACKED_HALF], A1_shared
+                    )
+                else:
+                    T.copy(A[by * block_M, kg * _PACKED_GROUP], A_shared)
+                T.copy(W[bx * block_N, kg * _PACKED_GROUP], low_shared)
