+@pytest.mark.parametrize(
+    "parts, part_n, out_dtype",
+    [
+        (2, 512, torch.float32),
+        (2, 256, torch.float32),
+        (2, 192, torch.float32),
+        (2, 128, torch.float32),
+        (2, 64, torch.float32),
+        (1, 512, torch.bfloat16),
+        (1, 256, torch.bfloat16),
