+    N: int,
+    K: int,
+    shards: int,
+    exponent_base: int,
+    block_M: int = 16,
+    block_N: int = 64,
+    num_stages: int = 2,
+    threads: int = 128,
+    out_dtype: T.dtype = T.float32,
+    parts: int = 1,
+    blocked: bool = False,
