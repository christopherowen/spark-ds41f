+@pytest.mark.skipif(not torch.cuda.is_available(), reason="Disk Engram needs CUDA")
+def test_disk_rows_pack_and_read_rank_compacted_files(monkeypatch):
+    import os
+    from vllm.models.deepseek_v4_1.common import engram as engram_mod
+    from vllm.models.deepseek_v4_1.engram_rows import packed_table_bytes
+
+    geometry = native.build_geometry(
+        layer_ids=(1, 14), base_table_size=19, compressed_vocab_size=32
+    )
+    caps = native.Caps(
+        device=torch.device("cuda"),
+        max_tokens=4,
+        max_seqs=2,
+        max_requests=2,
+        vocab_size=32,
+        layer_id=1,
+        tp_size=3,
+        tp_rank=1,
+    )
+    rows_total = geometry.num_embeddings[0]
+    weight_bytes = torch.randint(0, 120, (rows_total, 256), dtype=torch.uint8)
+    scale_bytes = torch.randint(120, 134, (rows_total, 8), dtype=torch.uint8)
+    base_dir = os.environ.get("ENGRAM_ROWS_TEST_DIR", "/cache/engram-rows-test")
+    os.makedirs(base_dir, exist_ok=True)
+    w_path = os.path.join(base_dir, "model_pack_w.bin")
+    s_path = os.path.join(base_dir, "model_pack_s.bin")
+    with open(w_path, "wb") as f:
+        f.write(weight_bytes.numpy().tobytes())
+    with open(s_path, "wb") as f:
+        f.write(scale_bytes.numpy().tobytes())
+
+    import shutil
+    packed_dir = os.path.join(base_dir, f"packed-{os.getpid()}")
+    shutil.rmtree(packed_dir, ignore_errors=True)
+    monkeypatch.setattr(engram_mod, "ENGRAM_PACKED_DIR", packed_dir)
+    embed = ParallelEngramEmbedding(None, caps, geometry, table_memory="disk")
+    embed._disk_sources = [(w_path, 0, False), (s_path, 0, True)]
+    embed.open_disk_rows()
+    try:
+        packed_file = os.path.join(packed_dir, "engram-layer1-tp3-rank1.packed")
+        assert os.path.exists(packed_file)
+        expected_rows = sum(geometry.primes[0][c] for c in range(1, 24, 3))
+        assert os.path.getsize(packed_file) == packed_table_bytes(expected_rows)
+
+        offsets = geometry.offsets[0]
+        primes = geometry.primes[0]
+        ids = torch.zeros((2, 24), dtype=torch.int64, device="cuda")
+        for c in range(24):
+            ids[0, c] = offsets[c] + (c % primes[c])
+            ids[1, c] = offsets[c] + ((c + 3) % primes[c])
+        hashes = torch.full((4, 24), -1, dtype=torch.int64, device="cuda")
+        hashes[:2].copy_(ids)
+        num_tokens = torch.tensor([2], dtype=torch.int32, device="cuda")
+        embed.share_hashes(hashes, num_tokens)
+        embed.stage_rows(2, torch.cuda.current_stream(), early=ids.cpu().numpy())
+        out_packed = torch.empty((2, 8 * 256), dtype=torch.bfloat16, device="cuda")
+        embed.gather_rows(out_packed)
+        torch.cuda.synchronize()
+    finally:
+        embed.close()
+
+    monkeypatch.setattr(engram_mod, "ENGRAM_PACKED_DIR", "")
+    embed_2p = ParallelEngramEmbedding(None, caps, geometry, table_memory="disk")
+    embed_2p._disk_sources = [(w_path, 0, False), (s_path, 0, True)]
+    embed_2p.open_disk_rows()
+    try:
+        embed_2p.share_hashes(hashes, num_tokens)
+        embed_2p.stage_rows(2, torch.cuda.current_stream(), early=ids.cpu().numpy())
+        out_2p = torch.empty((2, 8 * 256), dtype=torch.bfloat16, device="cuda")
+        embed_2p.gather_rows(out_2p)
+        torch.cuda.synchronize()
+    finally:
+        embed_2p.close()
+
+    assert torch.equal(out_packed, out_2p)
