+def test_routed_moe_pdl_preloads_before_wait():
+    """Routed MoE decode kernels overlap independent work before their PDL wait:
+    moe_dispatch clears warp_count in shared memory before waiting on TopkIdx;
+    early-trigger decode down GEMMs preload TileExpert, Order,
+    SFBase, and Narrow before waiting on moe_swiglu_cast; and moe_combine
+    preloads RoutePos, Weights, and Shared before waiting on the down GEMM."""
+    from vllm.models.deepseek_v4_1.tilelang.moe import (
+        moe_combine_v41,
+        moe_dispatch_v41,
+    )
+    from tilelang import language as T
+
+    for part in ("fused", "count"):
+        d_src = moe_dispatch_v41(384, 6, 16, part, T.int32).get_kernel_source()
+        clear_pos = d_src.index("((i * 512) + ((int)threadIdx.x))] = 0;")
+        wait_pos = d_src.index("cudaGridDependencySynchronize()")
+        topk_pos = d_src.index("TopkIdx[")
+        assert clear_pos < wait_pos < topk_pos
+
+    down_src = grouped_fp8_fp4_gemm(
+        384,
+        5120,
+        576,
+        6,
+        False,
+        16,
+        128,
+        num_stages=2,
+        coded_scales=True,
+        narrow_codes=True,
+        trigger_after_loop=False,
+    ).get_kernel_source()
+    wait_pos = down_src.index("cudaGridDependencySynchronize()")
+    assert down_src.index("TileExpert[") < wait_pos
+    assert down_src.index("Order[") < wait_pos
+    assert down_src.index("SFBase[") < wait_pos
+    assert down_src.index("Narrow[") < wait_pos
+
+    comb_src = moe_combine_v41(
+        5120, 6, shared=True, weighted=True, out_dtype=T.bfloat16
+    ).get_kernel_source()
+    wait_pos = comb_src.index("cudaGridDependencySynchronize()")
+    assert comb_src.index("RoutePos[") < wait_pos
+    assert comb_src.index("Weights[") < wait_pos
+    assert comb_src.index("*(uint4*)(Shared + ") < wait_pos
+    assert wait_pos < comb_src.index("*(uint4*)(Y + ")
