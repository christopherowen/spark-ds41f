From f39c334c62f4fca1744c6563f40226ec0e9a71aa Mon Sep 17 00:00:00 2001
From: Christopher Owen <root@your.mom>
Date: Thu, 5 Nov 2026 13:21:54 +0100
Subject: [PATCH] Validate fused score calls under startup kernel freeze

Upstream base: 73e25e5d5b68f9504760cc63bc8f018402668e5c. Rationale: startup must prepare both prompt-score variants with native ID types before cache freeze. Quality: test-only preparation/bitwise checks plus a sampler binding line split; GPU programs unchanged. Tests: existing startup-freeze case now executes both fused modes for native compact/padded IDs across three logits types and both ID widths; full two-boot suite pending. Upstream status: local experiment, not submitted.
---
 .../test_gpu_tilelang_logprob_softmax.py      | 21 +++++++++++++++++++
 .../v1/worker/gpu/sample/tilelang_sampling.py |  3 ++-
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/tests/v1/worker/test_gpu_tilelang_logprob_softmax.py b/tests/v1/worker/test_gpu_tilelang_logprob_softmax.py
index 7f7f47a92b..3aa34d0a44 100644
--- a/tests/v1/worker/test_gpu_tilelang_logprob_softmax.py
+++ b/tests/v1/worker/test_gpu_tilelang_logprob_softmax.py
@@ -826,6 +826,7 @@ def test_native_score_inputs_work_after_startup_freeze(monkeypatch):
         logprob.register_topk_scores_warmup(
             logits=pairs, vocab_size=257, logits_mode=False
         )
+        tilelang_logprob.register_ranks(pairs, 257, selected_scores=True)
     prepare.prepare_declared(registry)
     prepare.freeze("native score inputs warmup test")
     for dtype, _ in pairs:
@@ -847,6 +848,26 @@ def test_native_score_inputs_work_after_startup_freeze(monkeypatch):
                 for topk in (0, 5):
                     actual = logprob.compute_topk_scores(logits, topk, ids[:, 0])
                     assert torch.equal(actual.logprob_token_ids[:, 0], ids[:, 0])
+                if ids.stride(1) == 1:
+                    expected_ranks = torch.empty(3, device=DEVICE, dtype=torch.int64)
+                    tilelang_logprob.token_ranks(logits, ids[:, 0], expected_ranks)
+                    for logits_mode in (False, True):
+                        scores = torch.empty(
+                            ids.shape, device=DEVICE, dtype=torch.float32
+                        )
+                        ranks = torch.empty_like(expected_ranks)
+                        tilelang_logprob.prompt_scores_and_ranks(
+                            logits, ids, scores, ranks, logits_mode=logits_mode
+                        )
+                        expected = (
+                            logits.gather(1, ids.long()).float()
+                            if logits_mode
+                            else logprob.compute_token_logprobs(logits, ids)
+                        )
+                        assert torch.equal(
+                            scores.view(torch.uint8), expected.view(torch.uint8)
+                        )
+                        assert torch.equal(ranks, expected_ranks)
 
 
 @pytest.mark.parametrize("dtype", [torch.float16, torch.bfloat16, torch.float32])
diff --git a/vllm/v1/worker/gpu/sample/tilelang_sampling.py b/vllm/v1/worker/gpu/sample/tilelang_sampling.py
index 24b1e22430..106a146175 100644
--- a/vllm/v1/worker/gpu/sample/tilelang_sampling.py
+++ b/vllm/v1/worker/gpu/sample/tilelang_sampling.py
@@ -3506,7 +3506,8 @@ def copy_logits(logits: torch.Tensor) -> torch.Tensor:
             and logits.shape[1] >= 4096
             else 1024
         )
-        _kernel(copy_logits_kernel, _DTYPES[logits.dtype], vectorized, span)(logits, out)
+        kernel = _kernel(copy_logits_kernel, _DTYPES[logits.dtype], vectorized, span)
+        kernel(logits, out)
     return out
 
 
