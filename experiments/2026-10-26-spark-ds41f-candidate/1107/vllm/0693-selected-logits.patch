+@tilelang.jit(pass_configs=_PASS)
+def gather_logits_kernel(dtype: str, id_dtype: str, masked: bool):
+    rows, vocab, cols = T.dynamic("rows, vocab, cols")
+    logit_row, logit_col = T.dynamic("logit_row, logit_col", "int64")
+    id_row, id_col = T.dynamic("id_row, id_col", "int64")
+    valid_rows, valid_cols = T.dynamic("valid_rows, valid_cols")
+    valid_row, valid_col = T.dynamic("valid_row, valid_col", "int64")
+    block = 256
+
+    @T.prim_func
+    def gather_logits(
+        output: T.Tensor((rows, cols), "float32"),
+        logits: T.StridedTensor((rows, vocab), (logit_row, logit_col), dtype),
+        token_ids: T.StridedTensor((rows, cols), (id_row, id_col), id_dtype),
+        valid: T.StridedTensor(
+            (valid_rows, valid_cols), (valid_row, valid_col), "bool"
+        ),
+    ):
+        with T.Kernel(T.ceildiv(rows * cols, block), threads=block) as bx:
+            for lane in T.Parallel(block):
+                index = bx * block + lane
+                if index < rows * cols:
+                    row = T.cast(index // cols, "int64")
+                    col = T.cast(index % cols, "int64")
+                    take = T.alloc_var("bool", init=True)
+                    if masked:
+                        take = valid[row, col]
+                    value = T.alloc_var("float32", init=-T.infinity("float32"))
+                    if take:
+                        value = T.cast(logits[row, token_ids[row, col]], "float32")
+                    output[row, col] = value
+
+    return gather_logits
+
+
+def register_gather_logits(logits: Sequence[tuple[torch.dtype, int]]) -> None:
+    """Prepare both id types and validity layouts; shapes and strides are dynamic."""
+    dtypes = tuple(dict.fromkeys(dtype for dtype, _ in logits))
+    declare(
+        lambda: [
+            _call(gather_logits_kernel, _DTYPES[dtype], _DTYPES[id_dtype], masked)
+            for dtype in dtypes
+            for id_dtype in (torch.int32, torch.int64)
+            for masked in (False, True)
+        ]
+    )
+
+
+def gather_logits(
+    logits: torch.Tensor, token_ids: torch.Tensor, valid: torch.Tensor | None = None
+) -> torch.Tensor:
+    """Gather selected logits as FP32, storing -inf in invalid custom-id columns.
+
+    Invalid columns do not dereference their token ids. Valid ids have already
+    passed the request's vocabulary-bound validation.
+    """
+    if logits.ndim != 2 or token_ids.ndim != 2:
+        raise ValueError("logits and token_ids must be matrices")
+    if logits.shape[0] != token_ids.shape[0]:
+        raise ValueError("logits and token_ids must have the same row count")
+    if logits.dtype not in (torch.float16, torch.bfloat16, torch.float32):
+        raise TypeError("logits must be FP16, BF16 or FP32")
+    if token_ids.dtype not in (torch.int32, torch.int64):
+        raise TypeError("token_ids must be int32 or int64")
+    if not logits.is_cuda or token_ids.device != logits.device:
+        raise ValueError("logits and token_ids must be on the same CUDA device")
+    if valid is not None and (
+        valid.shape != token_ids.shape
+        or valid.dtype != torch.bool
+        or valid.device != logits.device
+    ):
+        raise ValueError("valid must be a boolean CUDA matrix matching token_ids")
+    output = torch.empty(token_ids.shape, dtype=torch.float32, device=logits.device)
+    if output.numel():
+        kernel = _kernel(
+            gather_logits_kernel,
+            _DTYPES[logits.dtype],
+            _DTYPES[token_ids.dtype],
+            valid is not None,
+        )
+        # The unmasked specialization never reads the dummy validity tensor.
+        kernel(
+            output,
+            logits,
+            token_ids,
+            output.view(torch.bool) if valid is None else valid,
+        )
+    return output
