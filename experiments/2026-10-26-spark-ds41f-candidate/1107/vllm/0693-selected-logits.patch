+@pytest.mark.parametrize("dtype", [torch.float16, torch.bfloat16, torch.float32])
+@pytest.mark.parametrize("id_dtype", [torch.int32, torch.int64])
+@pytest.mark.parametrize("masked", [False, True])
+@pytest.mark.parametrize("layout", ["dense", "padded", "strided"])
+def test_selected_logits_preserve_values_and_strides(dtype, id_dtype, masked, layout):
+    """Gather, FP32 conversion and invalid-column masking share one store."""
+    rows, vocab, cols = {
+        "dense": (1, VOCAB, 1),
+        "padded": (17, 8193, 21),
+        "strided": (3, VOCAB, 2100),
+    }[layout]
+    step = 2 if layout == "strided" else 1
+    backing = torch.randn(rows, vocab * step + 7, device=DEVICE, dtype=dtype)
+    logits = backing[:, 1 : 1 + vocab * step : step]
+    logits[:, :7] = torch.tensor(
+        [-0.0, 0.0, -torch.inf, torch.inf, torch.nan, 1.0, -1.0],
+        dtype=dtype,
+        device=DEVICE,
+    )
+    if dtype == torch.float32:
+        logits[:, 7] = 2.0**-149
+    before = backing.view(
+        torch.int16 if dtype != torch.float32 else torch.int32
+    ).clone()
+    raw_ids = torch.randint(
+        vocab, (rows, cols * step + 3), device=DEVICE, dtype=id_dtype
+    )
+    ids = raw_ids[:, 1 : 1 + cols * step : step]
+    ids[:, : min(cols, 8)] = torch.arange(min(cols, 8), device=DEVICE, dtype=id_dtype)
+    raw_valid = torch.rand(rows, cols * step + 3, device=DEVICE) > 0.3
+    valid = raw_valid[:, 1 : 1 + cols * step : step] if masked else None
+    expected = logits.gather(1, ids.long()).float()
+    if masked:
+        expected.masked_fill_(~valid, -torch.inf)
+        # Invalid slots may contain any bits: the kernel must not dereference them.
+        ids.masked_fill_(~valid, -2147483648)
+    ids_before = raw_ids.clone()
+    valid_before = raw_valid.clone()
+    actual = tilelang_logprob.gather_logits(logits, ids, valid)
+    assert actual.dtype == torch.float32 and actual.is_contiguous()
+    assert torch.equal(actual.isnan(), expected.isnan())
+    finite_or_inf = ~expected.isnan()
+    assert torch.equal(_bits(actual)[finite_or_inf], _bits(expected)[finite_or_inf])
+    assert torch.equal(backing.view(before.dtype), before)
+    assert torch.equal(raw_ids, ids_before)
+    assert torch.equal(raw_valid, valid_before)
+
+
+def test_selected_logits_graph_replays_new_values_ids_and_masks():
+    logits = torch.randn(96, VOCAB + 7, device=DEVICE)[:, :VOCAB]
+    ids = torch.randint(VOCAB, (96, 33), device=DEVICE)
+    valid = torch.rand(ids.shape, device=DEVICE) > 0.3
+    tilelang_logprob.gather_logits(logits, ids, valid)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        output = tilelang_logprob.gather_logits(logits, ids, valid)
+    logits.normal_()
+    ids.random_(VOCAB)
+    valid.logical_not_()
+    graph.replay()
+    expected = logits.gather(1, ids).masked_fill(~valid, -torch.inf)
+    assert torch.equal(output.view(torch.int32), expected.view(torch.int32))
+
+
