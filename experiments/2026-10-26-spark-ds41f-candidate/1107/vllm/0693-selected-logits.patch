+def test_selected_logits_are_prepared_before_cache_freeze(monkeypatch):
+    import importlib
+
+    import tilelang.cache
+
+    from vllm.model_executor.warmup.jit_warmup import JitWarmupRegistry
+    from vllm.models.deepseek_v4_1.tilelang import prepare
+
+    cache_module = importlib.import_module(tilelang.cache.freeze.__module__)
+    monkeypatch.setattr(cache_module, "_frozen_reason", None)
+    kernel = tilelang_logprob.gather_logits_kernel
+    monkeypatch.setattr(kernel, "_kernel_cache", {})
+    monkeypatch.setattr(kernel, "_call_form_cache", type(kernel._call_form_cache)())
+    monkeypatch.setattr(tls, "_KERNELS", {})
+    registry = JitWarmupRegistry(None)
+    pairs = [(dtype, VOCAB) for dtype in (torch.float16, torch.bfloat16, torch.float32)]
+    with registry.activate():
+        logprob.register_topk_scores_warmup(
+            logits=pairs, vocab_size=VOCAB, logits_mode=True
+        )
+    calls = [
+        call
+        for call in prepare.declared_calls(registry)
+        if call[0] is tilelang_logprob.gather_logits_kernel
+    ]
+    assert len(calls) == 12
+    prepare.prepare_declared(registry)
+    # The worker freezes this cache at startup: every runtime call must be declared.
+    prepare.freeze("selected logits warmup test")
+    for dtype, _ in pairs:
+        for id_dtype in (torch.int32, torch.int64):
+            logits = torch.randn(3, 257, device=DEVICE, dtype=dtype)
+            ids = torch.randint(257, (3, 9), device=DEVICE, dtype=id_dtype)
+            valid = torch.ones_like(ids, dtype=torch.bool)
+            for mask in (None, valid):
+                actual = tilelang_logprob.gather_logits(logits, ids, mask)
+                assert torch.equal(actual, logits.gather(1, ids.long()).float())
+
