+def _escape_image_token_literal(value: Any) -> Any:
+    """Escape the image token's literal spelling in request text to plain text.
+
+    The image token in the prompt comes only from image content blocks. The
+    token's literal spelling typed into a message, text part, tool result,
+    reasoning or tool-call arguments is ordinary text: escape it to the
+    ordinary-text spelling, which is in no added-token vocabulary, so the
+    encoder cannot mistake it for an image reference. The hosted DeepSeek API
+    passes the spelling through as text; rejecting it instead 400'd replayed
+    conversation history that clients cannot control (spark-ds41f issue #1031).
+    """
+    if isinstance(value, str):
+        return value.replace(IMAGE_PLACEHOLDER, IMAGE_PLACEHOLDER_TEXT)
+    if isinstance(value, list):
+        return [_escape_image_token_literal(item) for item in value]
+    if isinstance(value, dict):
+        return {key: _escape_image_token_literal(item) for key, item in value.items()}
+    return value
+
+
 def _normalize_messages(
     messages: list[ChatCompletionMessageParam],
 ) -> list[dict[str, Any]]:
     result = [dict(message) for message in copy.deepcopy(messages)]
+    # The image token in the prompt comes only from image parts, which the
+    # flattening below renders as IMAGE_PLACEHOLDER. A literal spelling typed
+    # into request text is ordinary text: escape it first.
+    result = [_escape_image_token_literal(message) for message in result]
     for message in result:
         role = message.get("role")
         if role not in (
@@ -176,30 +201,12 @@ def _normalize_messages(
