 def release_host_memory() -> None:
-    """Return the compile threads' freed heap to the system (glibc keeps a malloc
-    arena per thread), so memory profiling starts from what serving holds."""
+    """Return the compile threads' freed heap and warmup allocator blocks to the
+    system (glibc keeps a malloc arena per thread), so memory profiling starts
+    from what serving holds."""
     import contextlib
     import ctypes
+    import gc
 
+    import torch
+
+    gc.collect()
+    if torch.cuda.is_available():
+        torch.accelerator.synchronize()
+        torch.accelerator.empty_cache()
     with contextlib.suppress(OSError, AttributeError):
         ctypes.CDLL("libc.so.6").malloc_trim(0)
 
