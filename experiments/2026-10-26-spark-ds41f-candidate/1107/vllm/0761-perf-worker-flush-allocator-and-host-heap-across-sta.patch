+def test_capture_model_flushes_around_speculator_and_unfreezes_gc_before_tail_warmup(
+    monkeypatch,
+):
+    """Speculator capture is bracketed by allocator cache flushes so target
+    capture warmups do not remain reserved during draft graph capture, and
+    eager tail-shape warmup runs after freeze_gc_for_cudagraph_capture exits."""
+    runner = _make_capture_runner(captured=True)
+    runner._draft_workspace_lane = 1
+    monkeypatch.setattr(
+        runner.cudagraph_manager, "captured_token_counts", lambda: [1, 2], raising=False
+    )
+    events: list[str] = []
+
+    @contextlib.contextmanager
+    def _freeze_gc():
+        events.append("gc_freeze_enter")
+        yield
+        events.append("gc_freeze_exit")
+
+    runner.cudagraph_manager.capture = lambda *a, **kw: events.append("target_capture")
+    runner.speculator = SimpleNamespace(
+        capture=lambda: events.append("speculator_capture")
+    )
+    runner.adaptive_verification = SimpleNamespace(
+        warm_tail_shapes=lambda *a: events.append("warm_tail_shapes"),
+        load_draft_budget_kernels=lambda: events.append("load_draft_budget_kernels"),
+    )
+    monkeypatch.setattr(model_runner_module, "freeze_gc_for_cudagraph_capture", _freeze_gc)
+    monkeypatch.setattr(
+        model_runner_module, "use_workspace_lane", lambda _l: contextlib.nullcontext()
+    )
+    monkeypatch.setattr(
+        torch.accelerator, "empty_cache", lambda: events.append("empty_cache")
+    )
+    monkeypatch.setattr(
+        torch.accelerator, "get_memory_info", lambda: (16 << 30, 16 << 30)
+    )
+    monkeypatch.setattr(model_runner_module, "lock_workspace", lambda: None)
+
+    assert runner.capture_model(profile_only=False) == 0
+    assert events == [
+        "gc_freeze_enter",
+        "empty_cache",
+        "target_capture",
+        "empty_cache",
+        "speculator_capture",
+        "empty_cache",
+        "gc_freeze_exit",
+        "warm_tail_shapes",
+        "load_draft_budget_kernels",
+        "empty_cache",
+    ]
+
+
