+@pytest.mark.parametrize("packed", [False, True])
+@pytest.mark.parametrize("id_dtype", [torch.int32, torch.int64])
+@pytest.mark.parametrize("tokens", [0, 1, 17])
+@pytest.mark.parametrize("layout", ["flat", "strided", "matrix"])
+def test_tp1_native_ids_preserve_lookup_bits(packed, id_dtype, tokens, layout):
+    """The public TP1 path clamps negative IDs in its lookup and retains native
+    widths/strides, including empty/shifted/multidimensional graph inputs."""
+    rows, width = 2048, 256
+    original = _embedding_table_with_exceptions(rows, width, seed=72)
+    shard, _ = _shard_indices(rows, rows, 0, 1)
+    method = embedding.TileLangEmbeddingMethod()
+    layer = torch.nn.Module()
+    layer.weight = torch.nn.Parameter(original.clone(), requires_grad=False)
+    layer.shard_indices = shard
+    layer.tp_size = 1
+    layer.quant_method = method
+    if packed:
+        method.process_weights_after_loading(layer)
+    storage = torch.randint(-16, rows, (2 * tokens + 5,), device="cuda", dtype=id_dtype)
+    ids = storage[1 : 1 + 2 * tokens : 2]
+    if tokens:
+        ids[0] = -7
+    if layout == "flat":
+        ids = ids.contiguous()
+    elif layout == "matrix":
+        ids = ids.view(1, tokens)
+    expected = torch.nn.functional.embedding(ids.clamp_min(0).long(), original)
+    actual = VocabParallelEmbedding.forward(layer, ids)
+    assert actual.shape == expected.shape
+    assert torch.equal(_bits(actual), _bits(expected))
+    assert ids.dtype == id_dtype
+    if tokens:
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            replayed = VocabParallelEmbedding.forward(layer, ids)
+        graph.replay()
+        torch.cuda.synchronize()
+        assert torch.equal(_bits(replayed), _bits(expected))
