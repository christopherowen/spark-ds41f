@@ -3438,6 +3438,49 @@ def declare(calls: Callable[[], list]) -> None:
     prepare.declare(calls)
 
 
+@tilelang.jit(pass_configs=_PASS)
+def copy_logits_kernel(dtype: str):
+    """Own an FP32 logits copy, including cast and non-contiguous source rows."""
+    rows, cols, row_stride, col_stride = T.dynamic("rows, cols, row_stride, col_stride")
+
+    @T.prim_func
+    def copy_logits(
+        src: T.StridedTensor((rows, cols), (row_stride, col_stride), dtype),
+        dst: T.Tensor((rows, cols), T.float32),
+    ):
+        with T.Kernel(rows, T.ceildiv(cols, 1024), threads=256) as (row, block):
+            tx = T.get_thread_binding()
+            for j in T.unroll(4):
+                col = block * 1024 + j * 256 + tx
+                if col < cols:
+                    dst[row, col] = T.cast(src[row, col], T.float32)
+
+    return copy_logits
+
+
+def copy_logits(logits: torch.Tensor) -> torch.Tensor:
+    """FP32-owned logits for processing; leave the raw logits unchanged.
+
+    Dense FP32 is a device memcpy, which stays on PyTorch's DMA path. Casts and
+    strided sources otherwise launch generic ATen kernels; use TileLang for them.
+    Tensor allocation and views do not launch compute kernels.
+    """
+    if (
+        logits.ndim != 2
+        or not logits.is_cuda
+        or logits.dtype not in (torch.float16, torch.bfloat16, torch.float32)
+    ):
+        raise ValueError("copy_logits requires a 2-D CUDA floating-point tensor")
+    out = torch.empty(logits.shape, dtype=torch.float32, device=logits.device)
+    if not logits.numel():
+        return out
+    if logits.dtype == torch.float32 and logits.is_contiguous():
+        out.copy_(logits)
+    else:
+        _kernel(copy_logits_kernel, _DTYPES[logits.dtype])(logits, out)
+    return out
+
+
 def sampling_calls(
     logits_dtypes: Sequence[torch.dtype],
     temperature: bool = True,
@@ -3462,6 +3505,10 @@ def sampling_calls(
         for run in _runs(dtype, strides_by_dtype.get(dtype))
         for apply_temp in apply_temps
     ]
+    calls += [
+        _call(copy_logits_kernel, _DTYPES[dtype])
+        for dtype in dict.fromkeys(logits_dtypes)
+    ]
     if temperature:
         calls += [
             _call(temperature_kernel, _DTYPES[RUNNER_IDX_DTYPE], run, block)
