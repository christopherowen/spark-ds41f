--- a/tests/kernels/test_deepseek_v41_tilelang_pdl.py
+++ b/tests/kernels/test_deepseek_v41_tilelang_pdl.py
@@ -430,3 +430,82 @@ def test_bf16_partials_edges_are_programmatic():
         if target is None or source is None:
             continue
         assert kind == PROGRAMMATIC, f"expected programmatic edge {source} -> {target}, got {kind}"
+
+
+@pytest.mark.parametrize("ratio", [1, 2])
+def test_gather_columns_into_compress_edges_are_programmatic(ratio):
+    """gather_columns_into chains programmatically into compress_kernel (ratio 1)
+    and gather_partial_state_kernel -> compress_kernel (ratio 2)."""
+    from vllm.models.deepseek_v4_1.tilelang.compress import (
+        DIM,
+        STATE,
+        compress,
+        gather_partial_state,
+    )
+    from vllm.models.deepseek_v4_1.tilelang.gather import gather_columns_into
+
+    world, rows, max_reqs, page = 4, 6, 8, 4
+    local = DIM // world
+    gen = torch.Generator(device=DEVICE).manual_seed(100 + ratio)
+    val_dtype = torch.float32 if ratio == 2 else torch.bfloat16
+    parts = 2 if ratio == 2 else 1
+    src = torch.randn((world * parts * rows, local), generator=gen, dtype=val_dtype, device=DEVICE)
+    values = torch.empty((rows, DIM), dtype=val_dtype, device=DEVICE)
+    gates = torch.empty((rows, DIM), dtype=torch.float32, device=DEVICE)
+    outputs = (values, gates) if ratio == 2 else (values,)
+    weight = torch.rand((DIM,), generator=gen, dtype=torch.float32, device=DEVICE) + 0.5
+    starts = torch.zeros((max_reqs + 1,), dtype=torch.int32, device=DEVICE)
+    starts[1] = rows
+    positions = torch.zeros((max_reqs,), dtype=torch.int64, device=DEVICE)
+    positions[0] = 1
+    state_ids = torch.zeros((max_reqs,), dtype=torch.int64, device=DEVICE)
+    slots = torch.arange(rows, dtype=torch.int64, device=DEVICE)
+    state_slots = 2 * page + torch.arange(rows, dtype=torch.int64, device=DEVICE)
+    counts = torch.tensor([rows, 1], dtype=torch.int32, device=DEVICE)
+    pool = torch.randn((8, page * STATE), generator=gen, dtype=torch.float32, device=DEVICE)
+    table = torch.ones((max_reqs, 1), dtype=torch.int32, device=DEVICE)
+    pending_values = torch.empty((max_reqs, DIM), dtype=torch.float32, device=DEVICE)
+    pending_gates = torch.empty((max_reqs, DIM), dtype=torch.float32, device=DEVICE)
+    tags = torch.empty((max_reqs,), dtype=torch.int64, device=DEVICE)
+    local_ids = torch.empty((max_reqs,), dtype=torch.int64, device=DEVICE)
+    out = torch.empty((rows, DIM), dtype=torch.bfloat16, device=DEVICE)
+    emitted = torch.empty((rows,), dtype=torch.bool, device=DEVICE)
+    emitted_slots = torch.empty((rows,), dtype=torch.int64, device=DEVICE)
+
+    def run_chain():
+        gather_columns_into(src, outputs, world)
+        if ratio == 2:
+            gather_partial_state(
+                pool, table, starts, positions, counts,
+                pending_values, pending_gates, tags, local_ids, page=page,
+            )
+        compress(
+            rows, ratio, values, gates, weight, starts, positions,
+            local_ids if ratio == 2 else state_ids, slots, counts,
+            out, emitted, emitted_slots,
+            pending_values=pending_values, pending_gates=pending_gates,
+            tags=tags, pool=pool, state_slots=state_slots, page=page,
+        )
+
+    run_chain()
+    torch.cuda.synchronize()
+    expected_out = out.clone()
+    expected_emitted = emitted.clone()
+    expected_slots = emitted_slots.clone()
+
+    graph = _graph(run_chain, keep=True)
+    edges = _edges(graph)
+    assert len(edges) == (2 if ratio == 2 else 1), edges
+    for source, target, kind in edges:
+        assert source is not None and target is not None
+        assert kind == PROGRAMMATIC, f"expected programmatic edge {source} -> {target}, got {kind}"
+
+    for _ in range(5):
+        values.fill_(float("nan"))
+        gates.fill_(float("nan"))
+        out.fill_(float("nan"))
+        graph.replay()
+        torch.cuda.synchronize()
+        assert torch.equal(out.view(torch.int16), expected_out.view(torch.int16))
+        assert torch.equal(emitted, expected_emitted)
+        assert torch.equal(emitted_slots, expected_slots)
