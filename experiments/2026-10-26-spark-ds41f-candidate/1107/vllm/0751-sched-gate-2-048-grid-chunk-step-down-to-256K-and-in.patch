+def test_deep_context_chunk_grid_zero_extra_chunks_below_256k():
+    # For all contexts < 256K (0..262143), including the 128K (131072) grid and
+    # stall-* suites, chunks remain at full threshold even when decodes are active.
+    for threshold, expected_128k_chunks in ((6096, 22), (16288, 9)):
+        computed = 0
+        chunks = 0
+        while computed < 131072:
+            step = _chunk(
+                threshold,
+                computed,
+                131072 - computed,
+                num_runnable_decodes=15,
+                prefill_yield=True,
+            )
+            assert step == min(threshold, 131072 - computed)
+            computed += step
+            chunks += 1
+        assert chunks == expected_128k_chunks
+
+
+def test_deep_context_chunk_grid_steps_down_at_256k_and_512k_when_decodes_active():
+    # Solo prefill (num_runnable_decodes == 0) or prefill_yield="off": full threshold
+    # at all contexts up to 1M.
+    for context in (0, 131072, 262144, 524288, 900000):
+        for threshold in (6096, 16288):
+            assert (
+                _chunk(threshold, context, 32768, num_runnable_decodes=0)
+                == threshold - context % threshold
+            )
+            assert (
+                _chunk(
+                    threshold,
+                    context,
+                    32768,
+                    num_runnable_decodes=7,
+                    prefill_yield=False,
+                )
+                == threshold - context % threshold
+            )
+
+    # 256K <= context < 512K with active decodes: 4,096-token tier on 2,048 grid.
+    for context in (262144, 327680, 520192):
+        for threshold in (6096, 16288):
+            assert (
+                _chunk(threshold, context, 32768, num_runnable_decodes=7)
+                == 4096 - context % 4096
+            )
+
+    # context >= 512K with active decodes: 2,048-token tier on 2,048 grid.
+    for context in (524288, 655360, 901120):
+        for threshold in (6096, 16288):
+            assert (
+                _chunk(threshold, context, 32768, num_runnable_decodes=7)
+                == 2048 - context % 2048
+            )
+
+    # Crossing 256K from 44 full TP3 chunks (44 * 6096 = 268224) snaps onto
+    # the 4,096 / 2,048 grid in one transition chunk (2112 tokens -> 270336),
+    # then takes exact 4,096 chunks up to 524288 and 2,048 chunks thereafter.
+    c = 44 * 6096
+    transition = _chunk(6096, c, 900000 - c, num_runnable_decodes=7)
+    assert transition == 2112
+    assert (c + transition) % 4096 == 0
+    assert _chunk(6096, c + transition, 900000 - (c + transition), num_runnable_decodes=7) == 4096
+
+
+def test_deep_context_mixed_step_caps_total_prefill_tokens_to_active_tier(
+    monkeypatch, tmp_path
+):
+    utils = pytest.importorskip("tests.v1.core.utils")
+    monkeypatch.setattr(
+        utils,
+        "SchedulerConfig",
+        functools.partial(
+            utils.SchedulerConfig,
+            align_prefill_chunks=True,
+            prefill_yield="short",
+        ),
+    )
+    cfg = dict(_OPT_CONFIG, max_position_embeddings=600000)
+    (tmp_path / "config.json").write_text(json.dumps(cfg))
+    scheduler = utils.create_scheduler(
+        model=str(tmp_path),
+        max_num_seqs=16,
+        max_num_batched_tokens=6144,
+        long_prefill_token_threshold=6096,
+        max_model_len=600000,
+        num_blocks=40000,
+        skip_tokenizer_init=True,
+        device="cpu",
+    )
+    (dec,) = utils.create_requests(num_requests=1, num_tokens=32, req_ids=["dec"])
+    dec.max_tokens = 100
+    scheduler.add_request(dec)
+    out0 = scheduler.schedule()
+    assert out0.num_scheduled_tokens == {"dec": 32}
+    dec.append_output_token_ids(0)
+
+    # Admit a deep-context request and advance it to 262,144 computed tokens.
+    (deep,) = utils.create_requests(
+        num_requests=1, num_tokens=270336, req_ids=["deep"]
+    )
+    deep.max_tokens = 10
+    scheduler.add_request(deep)
+    # Schedule first chunk to move deep into running, then set computed to 262144
+    out1 = scheduler.schedule()
+    assert out1.num_scheduled_tokens["deep"] == 6096
+    dec.append_output_token_ids(0)
+    # Advance through the 2 interleaved decode steps after the 6,096 chunk
+    for _ in range(2):
+        out_i = scheduler.schedule()
+        assert out_i.num_scheduled_tokens == {"dec": 1}
+        dec.append_output_token_ids(0)
+
+    # Allocate blocks up to 262144 and set computed tokens to 262144 (256K).
+    scheduler.kv_cache_manager.allocate_slots(deep, 262144 - deep.num_computed_tokens)
+    deep.num_computed_tokens = 262144
+
+    # Also queue a second long prefill request (> long_prefill_token_threshold
+    # so short-prompt yield does not preempt deep); at 256K with decodes active,
+    # deep gets 4,096 tokens and the step prefill cap prevents extra_req from
+    # filling the remaining 2,047 tokens of max_num_batched_tokens.
+    (extra_req,) = utils.create_requests(
+        num_requests=1, num_tokens=20000, req_ids=["extra"]
+    )
+    scheduler.add_request(extra_req)
+    out_deep = scheduler.schedule()
+    assert out_deep.num_scheduled_tokens == {"dec": 1, "deep": 4096}
