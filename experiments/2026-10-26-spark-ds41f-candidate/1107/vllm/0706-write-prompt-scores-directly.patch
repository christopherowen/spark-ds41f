+++ b/vllm/v1/worker/gpu/sample/tilelang_logprob.py
@@ -529,7 +529,11 @@ def register_gather_logits(logits: Sequence[tuple[torch.dtype, int]]) -> None:
 
 
 def gather_logits(
-    logits: torch.Tensor, token_ids: torch.Tensor, valid: torch.Tensor | None = None
+    logits: torch.Tensor,
+    token_ids: torch.Tensor,
+    valid: torch.Tensor | None = None,
+    *,
+    out: torch.Tensor | None = None,
 ) -> torch.Tensor:
     """Gather selected logits as FP32, storing -inf in invalid custom-id columns.
 
@@ -552,7 +556,16 @@ def gather_logits(
         or valid.device != logits.device
     ):
         raise ValueError("valid must be a boolean CUDA matrix matching token_ids")
-    output = torch.empty(token_ids.shape, dtype=torch.float32, device=logits.device)
+    if out is None:
+        out = torch.empty(token_ids.shape, dtype=torch.float32, device=logits.device)
+    elif (
+        out.shape != token_ids.shape
+        or out.dtype != torch.float32
+        or out.device != logits.device
+        or not out.is_contiguous()
+    ):
+        raise ValueError("logits output must be contiguous FP32 matching token_ids")
+    output = out
     if output.numel():
         kernel = _kernel(
             gather_logits_kernel,
diff --git a/vllm/v1/worker/gpu/sample/tilelang_topk_ids.py b/vllm/v1/worker/gpu/sample/tilelang_topk_ids.py
index 3c9e1304b0..ffd42359b6 100644
--- a/vllm/v1/worker/gpu/sample/tilelang_topk_ids.py
+++ b/vllm/v1/worker/gpu/sample/tilelang_topk_ids.py
@@ -484,6 +484,8 @@ def logprob_token_ids(
     logits: torch.Tensor,  # [rows, vocab]
     num_logprobs: int,
     sampled: torch.Tensor,  # [rows]
+    *,
+    out: torch.Tensor | None = None,
 ) -> torch.Tensor:
     """``torch.cat((sampled[:, None], torch.topk(logits, num_logprobs).indices),
     1)``: ``[rows, 1 + num_logprobs]`` int64, ``num_logprobs`` at most
@@ -492,7 +494,18 @@ def logprob_token_ids(
     rows = logits.shape[0]
     if sampled.dtype not in (torch.int32, torch.int64):
         raise TypeError("sampled token ids must be int32 or int64")
-    out = torch.empty((rows, 1 + num_logprobs), dtype=torch.int64, device=logits.device)
+    shape = (rows, 1 + num_logprobs)
+    if out is None:
+        out = torch.empty(shape, dtype=torch.int64, device=logits.device)
+    elif (
+        out.shape != shape
+        or out.dtype != torch.int64
+        or out.device != logits.device
+        or not out.is_contiguous()
+    ):
+        raise ValueError(
+            "top-k ids output must be contiguous int64 with the selected shape"
+        )
     if rows:
         _launch(logits, out, sampled)
     return out
