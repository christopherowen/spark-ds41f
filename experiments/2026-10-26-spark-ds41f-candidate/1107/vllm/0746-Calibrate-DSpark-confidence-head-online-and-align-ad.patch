+# A trained scalar confidence head (e.g. DSpark's confidence_head) already
+# emits a probability in (0, 1); start at identity in log-odds space (slope 1,
+# intercept 0) so cold-start predictions match the raw head until the first
+# online IRLS refit calibrates the per-position decay and slope.
+_INIT_CONFIDENCE_HEAD_SLOPE = 1.0
+_INIT_CONFIDENCE_HEAD_BIAS = 0.0
