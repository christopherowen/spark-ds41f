index 9ce7963d1..ded920654 100644
--- a/tests/v1/spec_decode/test_acceptance_estimator.py
+++ b/tests/v1/spec_decode/test_acceptance_estimator.py
@@ -315,3 +315,166 @@ def test_refit_stays_bounded_after_a_confidently_wrong_draft():
     assert typical.item() > 0.05
     step = (estimator.intercepts - before).abs().max().item()
     assert step <= estimator.MAX_STEP + 1e-6
+
+
+
+def test_for_confidence_head_starts_as_identity_on_probabilities():
+    """Cold start for a trained confidence head must preserve its raw probabilities."""
+    device = torch.device("cuda")
+    estimator = OnlineAcceptanceEstimator.for_confidence_head(
+        MAX_NUM_REQS, NUM_STEPS, device
+    )
+    raw = torch.tensor(
+        [
+            [0.78, 0.72, 0.71, 0.73],
+            [0.92, 0.85, 0.64, 0.41],
+            [0.15, 0.08, 0.05, 0.02],
+        ],
+        device=device,
+        dtype=torch.float32,
+    )
+    probs = raw.clone()
+    slots = torch.tensor([3, 1, 7], device=device, dtype=torch.int32)
+    idx_mapping = slots.repeat_interleave(NUM_STEPS)
+    estimator.calibrate_confidence_probs(probs, idx_mapping)
+
+    torch.testing.assert_close(probs, raw, atol=1e-5, rtol=1e-5)
+    expected_features = torch.log(raw / (1.0 - raw))
+    torch.testing.assert_close(
+        estimator.features[slots.long()], expected_features, atol=1e-4, rtol=1e-4
+    )
+    torch.testing.assert_close(
+        estimator.predictions[slots.long()], raw, atol=1e-5, rtol=1e-5
+    )
+
+
+@pytest.mark.parametrize("per_token_idx", [False, True])
+def test_calibrate_confidence_probs_agrees_across_slot_and_batch_order(
+    per_token_idx: bool,
+):
+    """Calibrated confidence-head probabilities land in both batch and slot order."""
+    device = torch.device("cuda")
+    torch.manual_seed(17)
+    estimator = OnlineAcceptanceEstimator.for_confidence_head(
+        MAX_NUM_REQS, NUM_STEPS, device
+    )
+    estimator.slope.fill_(0.92)
+    estimator.intercepts[:] = torch.tensor(
+        [-0.42, -0.64, -1.25, -0.99], device=device
+    )
+
+    num_reqs = 5
+    slots = torch.randperm(MAX_NUM_REQS, device=device)[:num_reqs].to(torch.int32)
+    idx_mapping = slots.repeat_interleave(NUM_STEPS) if per_token_idx else slots
+
+    raw = torch.rand(num_reqs, NUM_STEPS, device=device) * 0.85 + 0.08
+    probs = raw.clone()
+    estimator.calibrate_confidence_probs(probs, idx_mapping)
+
+    expected_f = torch.log(raw.double() / (1.0 - raw.double()))
+    expected_p = torch.sigmoid(
+        estimator.slope.double() * expected_f
+        + estimator.intercepts.double()[None, :]
+    ).float()
+
+    torch.testing.assert_close(probs, expected_p, atol=1e-5, rtol=1e-5)
+    torch.testing.assert_close(
+        estimator.predictions[slots.long()], expected_p, atol=1e-5, rtol=1e-5
+    )
+    torch.testing.assert_close(
+        estimator.features[slots.long()], expected_f.float(), atol=1e-4, rtol=1e-4
+    )
+
+
+def test_calibrate_confidence_probs_skips_cudagraph_padded_rows():
+    """Padded rows carry slot -1 and must not overwrite any live slot's features."""
+    device = torch.device("cuda")
+    estimator = OnlineAcceptanceEstimator.for_confidence_head(
+        MAX_NUM_REQS, NUM_STEPS, device
+    )
+    estimator.features.fill_(-77.0)
+    estimator.predictions.fill_(-77.0)
+
+    idx_mapping = torch.tensor(
+        [2, 2, 2, 2, -1, -1, -1, -1], device=device, dtype=torch.int32
+    )
+    probs = torch.full((2, NUM_STEPS), 0.75, device=device)
+    estimator.calibrate_confidence_probs(probs, idx_mapping)
+
+    untouched = [i for i in range(MAX_NUM_REQS) if i != 2]
+    assert (estimator.features[untouched] == -77.0).all()
+    assert (estimator.predictions[untouched] == -77.0).all()
+    assert (estimator.features[2] != -77.0).all()
+
+
+def test_step_ignores_negative_idx_mapping_and_dead_row_cut():
+    """Copy-drafted/padded slots (-1) and dead rows past dead_row_cut must not be graded."""
+    device = torch.device("cuda")
+    estimator = OnlineAcceptanceEstimator.for_confidence_head(
+        MAX_NUM_REQS, NUM_STEPS, device
+    )
+    estimator.features[0] = torch.tensor([1.0, 1.0, 1.0, 1.0], device=device)
+    estimator.predictions[0] = torch.tensor([0.7, 0.7, 0.7, 0.7], device=device)
+
+    # Slot -1 (e.g. copy-drafted request) must not touch slot 0's accumulators.
+    estimator.step(
+        torch.tensor([-1], dtype=torch.int32, device=device),
+        torch.tensor([4], dtype=torch.int32, device=device),
+        torch.tensor([1], dtype=torch.int32, device=device),
+    )
+    assert float(estimator.counts.sum().item()) == 0.0
+
+    # Slot 0 with num_sampled=2 (1 accepted draft), num_rejected=3, but dead_row_cut=1:
+    # only position 0 was live and accepted; position 1 was dead and must not be graded.
+    estimator.step(
+        torch.tensor([0], dtype=torch.int32, device=device),
+        torch.tensor([2], dtype=torch.int32, device=device),
+        torch.tensor([3], dtype=torch.int32, device=device),
+        dead_row_cut=torch.tensor([1], dtype=torch.int32, device=device),
+    )
+    torch.testing.assert_close(
+        estimator.counts,
+        torch.tensor([1.0, 0.0, 0.0, 0.0], device=device),
+    )
+
+
+def test_confidence_head_online_irls_reduces_survival_mae():
+    """Online IRLS calibration of an overconfident confidence head recovers true survival."""
+    device = torch.device("cuda")
+    torch.manual_seed(42)
+    estimator = OnlineAcceptanceEstimator.for_confidence_head(
+        MAX_NUM_REQS, NUM_STEPS, device
+    )
+    estimator.REFIT_INTERVAL = 10
+
+    raw_row = torch.tensor([0.78, 0.72, 0.71, 0.71], device=device)
+    true_cond = torch.tensor([0.677, 0.556, 0.396, 0.460], device=device)
+    true_survival = torch.cumprod(true_cond, dim=0)
+    raw_survival = torch.cumprod(raw_row, dim=0)
+
+    num_reqs = 8
+    slots = torch.arange(num_reqs, device=device, dtype=torch.int32)
+    idx_mapping = slots.repeat_interleave(NUM_STEPS)
+
+    for _ in range(200):
+        probs = raw_row.unsqueeze(0).expand(num_reqs, NUM_STEPS).clone()
+        estimator.calibrate_confidence_probs(probs, idx_mapping)
+        draws = torch.rand(num_reqs, NUM_STEPS, device=device) < true_cond
+        all_ok = draws.all(dim=1)
+        first_fail = (~draws).int().argmax(dim=1)
+        accepted = torch.where(
+            all_ok, torch.full_like(first_fail, NUM_STEPS), first_fail
+        )
+        num_sampled = (accepted + 1).to(torch.int32)
+        num_rejected = (NUM_STEPS - accepted).to(torch.int32)
+        estimator.step(slots, num_sampled, num_rejected)
+
+    test_probs = raw_row.unsqueeze(0).clone()
+    estimator.calibrate_confidence_probs(test_probs, slots[:1])
+    calibrated_survival = torch.cumprod(test_probs[0], dim=0)
+
+    raw_mae = (raw_survival - true_survival).abs().mean().item()
+    cal_mae = (calibrated_survival - true_survival).abs().mean().item()
+    assert raw_mae > 0.15
+    assert cal_mae < 0.03
+    assert calibrated_survival[3].item() < 0.11
