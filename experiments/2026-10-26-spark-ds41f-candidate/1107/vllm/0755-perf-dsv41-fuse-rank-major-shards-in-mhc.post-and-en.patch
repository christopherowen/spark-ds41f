diff --git a/tests/kernels/test_deepseek_v41_tilelang_engram.py b/tests/kernels/test_deepseek_v41_tilelang_engram.py
index faa749257..803cc016b 100644
--- a/tests/kernels/test_deepseek_v41_tilelang_engram.py
+++ b/tests/kernels/test_deepseek_v41_tilelang_engram.py
@@ -216,3 +216,44 @@ def test_engram_post_gate_blocked_matches_packed_bits(images, blocks, block_cols
     )
     torch.cuda.synchronize()
     assert torch.equal(packed_out.view(torch.int16), blocked_out.view(torch.int16))
+
+
+@pytest.mark.parametrize("images", [False, True])
+@pytest.mark.parametrize("world, block_cols", [(2, 12800), (3, 8544), (4, 6400)])
+@pytest.mark.parametrize("rows", [6, 97])
+def test_engram_post_gate_rank_order_parts_matches_summed_bits(
+    images, world, block_cols, rows
+):
+    """Fused ``engram_post_gate`` and ``engram_post_gate_blocked`` with 3D
+    ``RankOrderParts.packed`` (`[world, rows, DIM]`) match pre-summed
+    ``RankOrderParts.sum()`` bit-for-bit."""
+    from vllm.models.deepseek_v4_1.tilelang.collectives import RankOrderParts
+
+    _, kv, weight, ids = _inputs(rows, seed=41 + world, images=images)
+    _, residual, post, comb = _post_inputs(rows, seed=47 + world)
+    gen = torch.Generator(device=DEVICE).manual_seed(53 + world)
+    packed_parts = torch.randn(
+        (world, rows, DIM), generator=gen, device=DEVICE
+    ).bfloat16()
+    summed = RankOrderParts(packed_parts).sum()
+    width = (HC + 1) * DIM
+    padded = torch.zeros((rows + 3, world * block_cols), device=DEVICE).bfloat16()
+    padded[:rows, :width] = kv
+    padded[rows:] = NAN
+    blocked = padded.view(rows + 3, world, block_cols).transpose(0, 1).contiguous()
+
+    expected = torch.empty_like(residual)
+    actual_packed = torch.empty_like(residual)
+    actual_blocked = torch.empty_like(residual)
+    engram_post_gate(
+        summed, residual, post, comb, kv, weight, ids, expected, EPS, HC
+    )
+    engram_post_gate(
+        packed_parts, residual, post, comb, kv, weight, ids, actual_packed, EPS, HC
+    )
+    engram_post_gate_blocked(
+        packed_parts, residual, post, comb, blocked, weight, ids, actual_blocked, EPS, HC
+    )
+    torch.cuda.synchronize()
+    assert torch.equal(actual_packed.view(torch.int16), expected.view(torch.int16))
+    assert torch.equal(actual_blocked.view(torch.int16), expected.view(torch.int16))
diff --git a/tests/models/test_deepseek_v4_1_engram.py b/tests/models/test_deepseek_v4_1_engram.py
