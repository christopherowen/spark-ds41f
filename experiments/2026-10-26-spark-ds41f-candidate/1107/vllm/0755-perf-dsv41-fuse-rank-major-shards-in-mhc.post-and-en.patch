@@ -1365,3 +1365,128 @@ def test_disk_rows_pack_and_read_rank_compacted_files(monkeypatch):
         embed_2p.close()
 
     assert torch.equal(out_packed, out_2p)
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA")
+@pytest.mark.parametrize("tp_size,block_cols", [(3, 8544), (4, 6400)])
+@torch.inference_mode()
+def test_engram_projection_tp_gathers_dim0_into_blocked_gate(
+    dist_init, monkeypatch, tp_size, block_cols
+):
+    """On non-SP steps with projection_tp=True, Engram all-gathers wkv's local
+    product along dim=0 into engram_gate_blocked / engram_post_gate_blocked
+    without launching concat_rank_shards along dim=-1."""
+    import vllm.models.deepseek_v4_1.common.engram as engram_module
+    from vllm.models.deepseek_v4_1.tilelang.engram_hash import IMAGE_SENTINEL
+
+    device = torch.device("cuda", torch.cuda.current_device())
+    capacity, hidden, streams = 9, HIDDEN, 4
+    geometry = native.build_geometry(base_table_size=19, compressed_vocab_size=32)
+    caps = native.Caps(
+        device=device,
+        max_tokens=capacity,
+        max_seqs=2,
+        max_requests=2,
+        vocab_size=32,
+        layer_id=1,
+        tp_size=1,
+        tp_rank=0,
+    )
+    layout = SimpleNamespace(
+        caps=(caps,),
+        lookup_plans=(None,),
+        geometry=geometry,
+        table_memory="device",
+        projection_tp=False,
+    )
+    config = SimpleNamespace(hidden_size=hidden, hc_mult=streams, rms_norm_eps=1e-3)
+    old_dtype = torch.get_default_dtype()
+    try:
+        torch.set_default_dtype(torch.bfloat16)
+        with torch.device(device):
+            module = Engram(config, None, layout, 0, False, "engram_tp_blocked_test")
+    finally:
+        torch.set_default_dtype(old_dtype)
+    module.q_weight.fill_(0.5)
+    module.k_weight.fill_(0.25)
+    module.wkv.weight.normal_(std=0.01)
+    module.embed_tokens.weight.fill_(2)
+    module.embed_tokens.weight_scale_inv.fill_(127)
+    module.process_weights_after_loading()
+
+    ids = torch.arange(24, device=device).expand(capacity, -1).contiguous()
+    module.prepare_embeddings(ids)
+    gen = torch.Generator(device=device).manual_seed(61 + tp_size)
+    layer_out = torch.randn(
+        (capacity, hidden), generator=gen, device=device, dtype=torch.bfloat16
+    )
+    residual = torch.randn(
+        (capacity, streams, hidden), generator=gen, device=device, dtype=torch.bfloat16
+    )
+    post_mix = torch.rand(
+        (capacity, streams), generator=gen, device=device, dtype=torch.float32
+    )
+    res_mix = torch.rand(
+        (capacity, streams, streams), generator=gen, device=device, dtype=torch.float32
+    )
+    token_ids = torch.full((capacity,), 7, dtype=torch.int32, device=device)
+    token_ids[4] = IMAGE_SENTINEL
+
+    expected_plain = module(residual, ids, token_ids)
+    expected_fused = module(
+        residual,
+        ids,
+        token_ids,
+        previous_output=layer_out,
+        post_mix=post_mix,
+        res_mix=res_mix,
+    )
+
+    orig_wkv = module.wkv
+    width = (streams + 1) * hidden
+    gather_dims = []
+
+    def fake_local_product(rows):
+        full_kv = orig_wkv(rows)
+        if isinstance(full_kv, tuple):
+            full_kv = full_kv[0]
+        padded = torch.zeros(
+            (rows.shape[0], tp_size * block_cols), dtype=full_kv.dtype, device=device
+        )
+        padded[:, :width] = full_kv
+        return padded.view(rows.shape[0], tp_size, block_cols)
+
+    def fake_all_gather(local_kv, dim=-1):
+        gather_dims.append(dim)
+        assert dim == 0
+        # local_kv is [rows, tp_size, block_cols] in our single-process mock;
+        # transpose to [tp_size, rows, block_cols] flattened along dim=0.
+        return local_kv.transpose(0, 1).contiguous().view(tp_size * local_kv.shape[0], block_cols)
+
+    class FakeWKV(engram_module._PaddedColumnParallelLinear):
+        def __init__(self):
+            torch.nn.Module.__init__(self)
+            self.gather_output = True
+            self.tp_size = tp_size
+            self.output_size_per_partition = block_cols
+
+        def local_product(self, r, *, out=None):
+            return fake_local_product(r)
+
+    module.wkv = FakeWKV()
+    monkeypatch.setattr(
+        engram_module, "tensor_model_parallel_all_gather", fake_all_gather
+    )
+
+    actual_plain = module(residual, ids, token_ids)
+    actual_fused = module(
+        residual,
+        ids,
+        token_ids,
+        previous_output=layer_out,
+        post_mix=post_mix,
+        res_mix=res_mix,
+    )
+    assert gather_dims == [0, 0]
+    assert torch.equal(actual_plain.view(torch.int16), expected_plain.view(torch.int16))
+    assert torch.equal(actual_fused.view(torch.int16), expected_fused.view(torch.int16))
