### apply_stack.sh
#!/usr/bin/env bash
# candidate-58: apply the series entries after 1107's 641 (0762..) on a tree at base-1107, in
# series order (or the order of the entries given as extra arguments), as bin/spark build prepare
# applies them: git apply --check --verbose (offsets logged), then git am --committer-date-is-author-date.
# (candidate-54's apply_stack.sh, unchanged but for this header.)
# usage: apply_stack.sh REPO SERIES LOG [entry ...]
set -u
REPO=$1; SERIES=$2; LOG=$3; shift 3
DIR=$(cd "$(dirname "$SERIES")" && pwd)
cd "$REPO"
git am --abort >/dev/null 2>&1
git checkout -q --detach base-1107 && git reset -q --hard base-1107 && git clean -qfd
{
echo "base-1107 patch_head $(git rev-parse base-1107) tree $(git rev-parse 'base-1107^{tree}')"
} >> "$LOG"
if [ $# -gt 0 ]; then entries=("$@"); else
  mapfile -t entries < <(grep -v '^#' "$SERIES" | grep -v '^\s*$' | tail -n +642)
fi
for p in "${entries[@]}"; do
  f="$DIR/$p"; name=$(basename "$p")
  sha=$(sha256sum "$f" | cut -c1-64)
  out=$(git apply --check --verbose "$f" 2>&1); rc=$?
  if [ $rc -ne 0 ]; then
    echo "FAIL  $name sha256=$sha  git apply --check rc=$rc  ($p)" >> "$LOG"; echo "$out" | sed 's/^/      /' >> "$LOG"; break
  fi
  am=$(git -c user.name="Christopher Owen" -c user.email=3221756+christopherowen@users.noreply.github.com am --quiet --committer-date-is-author-date "$f" 2>&1); rc=$?
  if [ $rc -ne 0 ]; then
    echo "FAIL  $name sha256=$sha  git am rc=$rc  ($p)" >> "$LOG"; echo "$am" | sed 's/^/      /' >> "$LOG"; git am --abort; break
  fi
  files=$(git diff --name-only HEAD~1 HEAD | wc -l)
  echo "OK    $name sha256=$sha  commit=$(git rev-parse HEAD) tree=$(git rev-parse 'HEAD^{tree}') files=$files" >> "$LOG"
  echo "$out" | grep -E "offset|fuzz" | sed 's/^/      git apply: /' >> "$LOG"
  [ -n "$am" ] && echo "$am" | sed 's/^/      git am: /' >> "$LOG"
done
echo "head $(git rev-parse HEAD) tree $(git rev-parse 'HEAD^{tree}') patches_after_base $(git rev-list --count base-1107..HEAD)" >> "$LOG"
if git diff --check 19f2c20ed4d64ae22bd009ceacadd85e2a81e354 HEAD >/dev/null; then echo "git diff --check 19f2c20ed4d6..HEAD: clean" >> "$LOG"; else echo "git diff --check 19f2c20ed4d6..HEAD: PROBLEMS" >> "$LOG"; fi

### cross_check.sh
#!/usr/bin/env bash
# candidate-58: each round-3 pass's own verified stack on candidate-54 (tag c54-c54, head 4e8133ff,
# tree 5f021d9a), to compare each file a round-3 patch touches with the tree its candidate (or
# rework) measured; then every ordered pair of round-3 patches, each alone and pairwise on candidate-54.
# usage: cross_check.sh REPO C58_DIR OUT
set -u
REPO=$1; C58=$2; OUT=$3
E=$C58/..
cd "$REPO"
apply() {  # apply <label> <patch>...  from c54-c54; prints the tree
  local label=$1; shift
  git am --abort >/dev/null 2>&1
  git checkout -q --detach c54-c54 && git reset -q --hard c54-c54 && git clean -qfd
  for p in "$@"; do
    if ! git -c user.name="Christopher Owen" -c user.email=3221756+christopherowen@users.noreply.github.com am --quiet --committer-date-is-author-date "$p" >/dev/null 2>&1; then
      git am --abort; echo "$label FAIL at $(basename "$p")"; return 1; fi
  done
  echo "$label head $(git rev-parse HEAD) tree $(git rev-parse 'HEAD^{tree}')"
  git tag -f "c58-$label" >/dev/null
}
p() { ls $C58/vllm/$1-*.patch; }
C55=$E/candidate-55/vllm
{
echo "c54 head $(git rev-parse c54-c54) tree $(git rev-parse 'c54-c54^{tree}')"
# candidate-55 as locked (0792 #1008, 0793 #978, 0794 #988 dead-row): its lock's tree e39b835c
apply c55 $C55/0792-*.patch $C55/0793-*.patch $C55/0794-*.patch
# candidate-55 without #978, the code its gate, screen and #1008's mark measured
apply c55-no978 $C55/0792-*.patch $C55/0794-*.patch
# #956 r4 on candidate-54 alone: the rework's tree 703f24a3
apply c56r4 $E/candidate-56/receipts/rework/pr-956-r4/0796-*.patch
# candidate-57 as locked (0797 #957 p2, 0798 #957 p4): its lock's tree 72b40d71
apply c57 $E/candidate-57/vllm/0797-*.patch $E/candidate-57/vllm/0798-*.patch
# candidate-58's copies on candidate-54, each alone
for n in 0792 0793 0794 0795 0796; do apply "alone-$n" $(p $n); done
# every ordered pair of candidate-58's copies on candidate-54
for a in 0792 0793 0794 0795 0796; do for b in 0792 0793 0794 0795 0796; do
  [ "$a" = "$b" ] && continue
  apply "pair-$a-$b" $(p $a) $(p $b) | sed 's/ head .* tree / tree /'
done; done
# candidate-58's round 3 in series order
apply c58r3 $(for n in 0792 0793 0794 0795 0796; do p $n; done)
} > "$OUT"

### file_identity.sh
#!/usr/bin/env bash
# candidate-58: each file a round-3 stack changes over candidate-54, compared with candidate-58's
# file; the no978 overlay against candidate-55 without #978; and the pairwise file intersections.
# usage: file_identity.sh VLLM_REPO C58_DIR   (the tags cross_check.sh leaves; c58-c58 is the committed series)
set -u
cd "$1"; C58=$2
T58=$(git rev-parse 'c58-c58^{tree}')
echo "candidate-58 tree $T58"
echo "## candidate-58 against candidate-54 + round 3 in series order (c58-c58r3): expect no difference"
git diff --stat c58-c58r3 c58-c58 | tail -3; [ -z "$(git diff --name-only c58-c58r3 c58-c58)" ] && echo "  identical"
for c in c55-no978 c56r4 c57; do
  echo "## files $c changes over candidate-54: candidate-58's blob against $c's"
  for f in $(git diff --name-only c54-c54 "c58-$c"); do
    a=$(git rev-parse "$T58:$f" 2>/dev/null); b=$(git rev-parse "c58-$c:$f" 2>/dev/null)
    [ "$a" = "$b" ] && r=same || r=DIFFERENT
    echo "  $r $f"
  done
done
echo "## candidate-55/no978/overlay (the files #978 changes, as candidate-55 without #978 measured them) against c55-no978"
O=$C58/../candidate-55/no978/overlay
for f in $(cd "$O" && find . -type f | sed 's#^\./##' | sort); do
  rel=${f#vllm/}
  for cand in "$f" "vllm/$f" "$rel"; do b=$(git rev-parse "c58-c55-no978:$cand" 2>/dev/null) && break; done
  a=$(git hash-object "$O/$f")
  [ "$a" = "$b" ] && r=same || r=DIFFERENT
  echo "  $r $f ($cand)"
done
echo "## files each round-3 stack changes over candidate-54, pairwise intersections (expect none)"
for x in c55-no978 c56r4 c57; do for y in c55-no978 c56r4 c57; do
  [[ "$x" < "$y" ]] || continue
  n=$(comm -12 <(git diff --name-only c54-c54 "c58-$x" | sort) <(git diff --name-only c54-c54 "c58-$y" | sort) | wc -l)
  echo "  $x & $y: $n common files"
done; done
echo "## files each of candidate-58's round-3 patches changes, pairwise intersections (expect none)"
for a in 0792 0793 0794 0795 0796; do for b in 0792 0793 0794 0795 0796; do
  [[ "$a" < "$b" ]] || continue
  n=$(comm -12 <(git diff --name-only c54-c54 "c58-alone-$a" | sort) <(git diff --name-only c54-c54 "c58-alone-$b" | sort))
  echo "  $a & $b: $(echo -n "$n" | grep -c .) common files ${n//$'\n'/ }"
done; done
