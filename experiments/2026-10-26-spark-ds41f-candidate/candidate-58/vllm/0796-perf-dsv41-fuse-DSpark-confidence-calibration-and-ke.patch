+@pytest.mark.parametrize("num_reqs", [1, 4, 8])
+def test_fused_confidence_calibration_matches_two_step_estimator(num_reqs):
+    """Fused ``probability_and_calibrate`` matches two-step ``probability`` plus
+    ``OnlineAcceptanceEstimator.calibrate_confidence_probs`` bit for bit."""
+    from vllm.v1.worker.gpu.spec_decode.acceptance_estimator import (
+        OnlineAcceptanceEstimator,
+    )
+
+    steps = 5
+    rows = num_reqs * steps
+    hidden, markov, weight = _inputs(rows, seed=31 + num_reqs)
+    head = confidence.TileLangConfidenceHead.__new__(confidence.TileLangConfidenceHead)
+    torch.nn.Module.__init__(head)
+    head.proj = SimpleNamespace(weight=weight.view(1, -1))
+    head.hidden_size, head.markov_rank = HIDDEN, RANK
+
+    est_ref = OnlineAcceptanceEstimator.for_confidence_head(16, steps, torch.device("cuda"))
+    est_fused = OnlineAcceptanceEstimator.for_confidence_head(
+        16, steps, torch.device("cuda")
+    )
+    est_ref.slope.fill_(1.35)
+    est_fused.slope.fill_(1.35)
+    intercepts = torch.tensor(
+        [0.15, -0.25, -0.85, -1.10, -0.55], dtype=torch.float32, device="cuda"
+    )
+    est_ref.intercepts.copy_(intercepts)
+    est_fused.intercepts.copy_(intercepts)
+
+    slots = torch.tensor(
+        [3, -1, 7, 1, 0, -1, 12, 5][:num_reqs], dtype=torch.int32, device="cuda"
+    )
+    idx_mapping = slots.repeat_interleave(steps).contiguous()
+
+    out_ref = torch.empty((num_reqs, steps), dtype=torch.float32, device="cuda")
+    head.probability(hidden, markov, out=out_ref.view(-1))
+    est_ref.calibrate_confidence_probs(out_ref, idx_mapping)
+
+    out_fused = torch.empty((num_reqs, steps), dtype=torch.float32, device="cuda")
+    head.probability_and_calibrate(
+        hidden,
+        markov,
+        out_fused.view(-1),
+        est_fused.slope,
+        est_fused.intercepts,
+        idx_mapping,
+        est_fused.features,
+        est_fused.predictions,
+    )
+
+    torch.testing.assert_close(out_fused, out_ref, atol=1e-6, rtol=1e-6)
+    torch.testing.assert_close(
+        est_fused.features, est_ref.features, atol=1e-5, rtol=1e-5
+    )
+    torch.testing.assert_close(
+        est_fused.predictions, est_ref.predictions, atol=1e-6, rtol=1e-6
+    )
