 @cache
 def _kernel(hidden: int, rank: int):
     return dspark_confidence_kernel(hidden, rank)
 
 
-def declare(hidden: int, rank: int) -> None:
+@cache
+def _calibrate_kernel(hidden: int, rank: int, steps: int):
