         orig_to_new_regex=base.orig_to_new_regex,
         orig_to_new_suffix={
             "head.weight": "language_model.lm_head.weight",
@@ -109,7 +117,7 @@ def _make_deepseek_v4_vl_weights_mapper(
             ".ffn.gate.bias": ".ffn.gate.e_score_correction_bias",
         },
         orig_to_new_substr={
-            ".shared_experts.w2": ".shared_experts.down_proj",
+            **_VL_MODULE_SUBSTRS,
             # The MTP/DSpark draft heads are not supported for the vision
             # variant; drop their weights.
             "mtp.": None,
@@ -136,6 +144,16 @@ class DeepseekV41ForCausalLM(nn.Module, SupportsMultiModal, SupportsPP, Supports
     # bias_vl.
     requires_raw_input_tokens = True
 
+    # configure_quant_config reads the class's mapper before any layer is built,
+    # to rename the modules a quantization config lists (its ignored layers) into
+    # this wrapper's namespace. __init__ installs the instance mapper, with the
+    # checkpoint's tensor and scale rules, only after the language model has
+    # chosen every layer's quantization method: too late for that list.
+    hf_to_vllm_mapper = WeightsMapper(
+        orig_to_new_prefix=dict(_VL_MODULE_PREFIXES),
+        orig_to_new_substr=dict(_VL_MODULE_SUBSTRS),
+    )
+
