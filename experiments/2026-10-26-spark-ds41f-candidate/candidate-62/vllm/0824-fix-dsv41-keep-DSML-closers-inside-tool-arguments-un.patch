@@ -1,16 +1,43 @@
 # SPDX-License-Identifier: Apache-2.0
 # SPDX-FileCopyrightText: Copyright contributors to the vLLM project
-"""DeepSeek V4.1 reasoning and spaced DSML tool calls."""
+"""DeepSeek V4.1 reasoning and spaced DSML tool calls.
+
+DSML has no escaping, so a tool argument that contains a DSML closer (a file *about*
+DSML) used to be cut at that closer: the argument was dropped or truncated, text after
+it vanished, and the streaming path emitted unterminated JSON.
+
+Rules (TOOL_ARGS state only; reasoning and content parsing are unchanged):
+  * a parameter closer ends a value only when what follows is whitespace and then a new
+    parameter head, or the end of the call's arguments.
+  * an invoke closer / calls closer ends a call only when its arguments are closed (they
+    end with a parameter closer, or hold no parameter). Otherwise the closer is held: it
+    becomes structure if the next thing is a calls closer, a new invoke head, or the end
+    of the stream (the open parameter is then closed, not dropped), and literal text
+    otherwise.
+  * candidate-60's token-provenance rule is kept unchanged: markup spelled in ordinary
+    pieces is text before the lookahead is asked, and only markup carrying the DSML token
+    is a candidate boundary at all. The lookahead additionally rejects a *genuine* closer
+    that is not followed by structure (the model can emit a quoted closer as the DSML
+    token itself, so provenance alone does not cover it).
+  * Every closer kept as text is logged.
+
+Kill switch: ``VLLM_DSV41_STRUCTURAL_DSML=0`` restores the previous behaviour. If the
+engine hooks this relies on change shape, the structural rule logs an error and stays
+off.
+"""
 
 from __future__ import annotations
 
 import functools
+import inspect
 import json
+import os
 from collections.abc import Iterable, Sequence
 from dataclasses import replace
 
 import regex as re
 
+from vllm.logger import init_logger
 from vllm.parser.abstract_parser import DelegatingParser
 from vllm.parser.deepseek_v4 import (
     DeepSeekV4Parser,
@@ -25,9 +52,11 @@ from vllm.parser.engine.adapters import (
     ParserEngineReasoningAdapter,
     ParserEngineToolAdapter,
 )
-from vllm.parser.engine.parser_engine_config import ParserEngineConfig
+from vllm.parser.engine.parser_engine_config import ArgValueExtender, ParserEngineConfig
 from vllm.parser.metrics import record_tool_parser_invocation
 
+logger = init_logger(__name__)
+
 DSML_ATOM = "｜DSML｜"
 
 DSML_TOOL_START = "<｜DSML｜ calls>"
@@ -42,6 +71,121 @@ _PARAM_HEAD_RE = re.compile(
     re.escape(DSML_PARAM_START) + r'\s+name="([^"]+)"(?:\s+string="([^"]*)")?\s*>'
 )
 
+OVERLAY_ID = "dsv41-structural-dsml-v1"
+
+# ── structural closers ──────────────────────────────────────
+
+# A complete next-parameter head start, as stock's missing-closer lookahead uses.
+_NEXT_HEAD_RE = re.compile(rf"{re.escape(DSML_PARAM_START)}\s+name=\"")
+# A parameter head still being written (partial mode only): starts with the tag and
+# has not reached its closing '>' yet.
+_HEAD_IN_PROGRESS_RE = re.compile(rf"{re.escape(DSML_PARAM_START)}(?:\s[^>]*)?$")
+# Offset of the DSML atom inside a parameter closer, for the synthetic closer below.
+_PARAM_CLOSE_ATOM = DSML_PARAM_CLOSE.find(DSML_ATOM)
+
+
+def _closer_is_structural(raw: str, after: int, partial: bool) -> bool:
+    follower = raw[after:].lstrip()
+    if not follower:
+        return True
+    if _NEXT_HEAD_RE.match(follower):
+        return True
+    if partial and (
+        DSML_PARAM_START.startswith(follower) or _HEAD_IN_PROGRESS_RE.match(follower)
+    ):
+        # Multi-token deltas can end a streaming tick inside the next head. Treat the
+        # closer as structure for this tick; if literal text follows later the value
+        # only grows, which keeps the streamed JSON prefix-stable.
+        return True
+    return False
+
+
+def _find_value_end(raw: str, vstart: int, partial: bool) -> tuple[int, int] | None:
+    """Return (value_end, resume_pos) for the value starting at vstart, or None
+    when the value is still open (no structural closer and no next head)."""
+    pos = vstart
+    head = _NEXT_HEAD_RE.search(raw, vstart)
+    while True:
+        c = raw.find(DSML_PARAM_CLOSE, pos)
+        if head is not None and (c < 0 or head.start() < c):
+            # Stock recovery: a value whose closer is missing ends at the next head.
+            return head.start(), head.start()
+        if c < 0:
+            return None
+        after = c + len(DSML_PARAM_CLOSE)
+        if _closer_is_structural(raw, after, partial):
+            return c, after
+        pos = after  # literal closer inside the value; keep scanning
+
+
+def _store(params: dict, name: str, is_str: str | None, value: str, partial: bool):
+    if is_str == "true":
+        params[name] = value
+        return
+    try:
+        params[name] = json.loads(value)
+    except (json.JSONDecodeError, ValueError):
