+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Structural DSML closer lookahead for DeepSeek V4.1 tool arguments."""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+import vllm.parser.deepseek_v41 as v41mod
+from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+from vllm.parser.engine.registered_adapters import (
+    DeepSeekV41ParserReasoningAdapter,
+)
+from vllm.tokenizers import get_tokenizer
+from vllm.tool_parsers.deepseekv41_engine_tool_parser import (
+    DeepSeekV41EngineToolParser,
+)
+
+pytestmark = pytest.mark.skip_global_cleanup
+
+MODEL = "deepseek-ai/DeepSeek-V4.1-Flash"
+TOOLS = [
+    {
+        "type": "function",
+        "function": {
+            "name": "write_file",
+            "description": "write a file",
+            "parameters": {
+                "type": "object",
+                "properties": {
+                    "path": {"type": "string"},
+                    "content": {"type": "string"},
+                },
+                "required": ["path", "content"],
+            },
+        },
+    },
+    {
+        "type": "function",
+        "function": {
+            "name": "set_cfg",
+            "description": "set config",
+            "parameters": {
+                "type": "object",
+                "properties": {
+                    "n": {"type": "integer"},
+                    "cfg": {"type": "object"},
+                    "tag": {"type": "string"},
+                },
+                "required": ["n"],
+            },
+        },
+    },
+]
+
+S, E = "<｜DSML｜ calls>", "</｜DSML｜ calls>"
+IS, IE = '<｜DSML｜ invoke name="', "</｜DSML｜ invoke>"
+PS, PE = "<｜DSML｜ parameter", "</｜DSML｜ parameter>"
+
+
+def _p(name: str, val: str, s: str | None = "true") -> str:
+    attr = f' string="{s}"' if s is not None else ""
+    return f'{PS} name="{name}"{attr}>{val}{PE}\n'
+
+
+def _wf(path: str, content: str) -> str:
+    return f'{IS}write_file">\n{_p("path", path)}{_p("content", content)}{IE}\n'
+
+
+CASES = {
+    "A_control": f"Writing it.\n\n{S}\n{_wf('a.txt', 'hello world')}{E}",
+    "B_value_holds_calls_closer": f"Writing it.\n\n{S}\n{_wf('dsml.md', 'The block ends with ' + E + ' on its own line.')}{E}",
+    "C_value_holds_param_closer": f"Writing it.\n\n{S}\n{_wf('dsml.md', 'A param ends with ' + PE + ' then more.')}{E}",
+    "D_value_holds_invoke_closer": f"Writing it.\n\n{S}\n{_wf('dsml.md', 'An invoke ends with ' + IE + ' then more.')}{E}",
+    "E_two_calls_first_holds_closer": f"{S}\n{_wf('one.md', 'see ' + E + ' here')}{_wf('two.txt', 'second')}{E}",
+    "E2_all_three_closers_multiline": f"{S}\n{_wf('doc.md', 'line1 ' + PE + chr(10) + 'line2 ' + IE + chr(10) + 'line3 ' + E + chr(10) + 'end')}{E}",
+    "F_orphan_closers_only": f"{IE}\n{E}",
+    "G_json_answer_with_tools": '{"city": "Paris", "temp_c": 21}',
+    "H_parallel_calls": f"{S}\n{_wf('a.txt', 'one')}{_wf('b.txt', 'two')}{E}",
+    "I_string_false_values": f'{S}\n{IS}set_cfg">\n{_p("n", "5", "false")}{_p("cfg", json.dumps({"a": [1, 2], "b": None}), "false")}{IE}\n{E}',
+    "J_string_false_json_holding_invoke_closer": f'{S}\n{IS}set_cfg">\n{_p("n", "7", "false")}{_p("cfg", json.dumps({"note": "a " + IE + " b"}, ensure_ascii=False), "false")}{IE}\n{E}',
+    "K_missing_string_attr": f'{S}\n{IS}set_cfg">\n{_p("n", "3", None)}{_p("tag", "plain", None)}{IE}\n{E}',
+    "L_omit_invoke_end": f'{S}\n{IS}write_file">\n{_p("path", "a.txt")}{_p("content", "hi")}{E}',
+    "M_omit_param_close_before_next_head": f'{S}\n{IS}write_file">\n{PS} name="path" string="true">a.txt\n{_p("content", "hi")}{IE}\n{E}',
+    "N_omit_param_close_then_invoke_end": f'{S}\n{IS}write_file">\n{_p("path", "a.txt")}{PS} name="content" string="true">hello\n{IE}\n{E}',
+    "N2_omit_param_close_then_invoke_end_eos": f'{S}\n{IS}write_file">\n{_p("path", "a.txt")}{PS} name="content" string="true">hello\n{IE}',
+    "O_truncated_mid_value": f'{S}\n{IS}write_file">\n{_p("path", "a.txt")}{PS} name="content" string="true">partial tex',
+    "O2_truncated_after_literal_closer": f'{S}\n{IS}write_file">\n{_p("path", "a.txt")}{PS} name="content" string="true">see {E} and then tru',
+    "Q_ambiguous_value_holds_closer_plus_head": f"{S}\n{_wf('x.md', 'a' + PE + chr(10) + PS + ' name=' + chr(34) + 'z' + chr(34) + ' string=' + chr(34) + 'true' + chr(34) + '>b')}{E}",
+    "R_value_ends_with_literal_param_closer": f"{S}\n{_wf('x.md', 'the tag is ' + PE)}{E}",
+    "T_text_after_block": f"{S}\n{_wf('a.txt', 'x')}{E}\ntrailing words",
+    "U_json_body": f'{S}\n{IS}write_file">\n{json.dumps({"path": "j.txt", "content": "json body"})}\n{IE}\n{E}',
+    "U2_json_body_holds_invoke_closer": f'{S}\n{IS}write_file">\n{json.dumps({"path": "j.txt", "content": "has " + IE + " inside"}, ensure_ascii=False)}\n{IE}\n{E}',
+}
+
+REASONING_CASES = {
+    "P_reasoning_mentions_closers": f"<think>I could write {E} or {IE} in prose here.</think>Plain answer, no tools.",
+    "P2_reasoning_then_call": f"<think>plan: use {PE} maybe</think>{S}\n{_wf('a.txt', 'ok')}{E}",
+}
+
+UNCHANGED = {
+    "A_control",
+    "F_orphan_closers_only",
+    "G_json_answer_with_tools",
+    "H_parallel_calls",
+    "I_string_false_values",
+    "K_missing_string_attr",
+    "L_omit_invoke_end",
+    "M_omit_param_close_before_next_head",
+    "O_truncated_mid_value",
+    "T_text_after_block",
+    "U_json_body",
+}
+TRUNCATION = {"O_truncated_mid_value", "O2_truncated_after_literal_closer"}
+FIXED = {
+    "B_value_holds_calls_closer": [
+        ("write_file", {"path": "dsml.md", "content": f"The block ends with {E} on its own line."})
+    ],
+    "C_value_holds_param_closer": [
+        ("write_file", {"path": "dsml.md", "content": f"A param ends with {PE} then more."})
+    ],
+    "D_value_holds_invoke_closer": [
+        ("write_file", {"path": "dsml.md", "content": f"An invoke ends with {IE} then more."})
+    ],
+    "E_two_calls_first_holds_closer": [
+        ("write_file", {"path": "one.md", "content": f"see {E} here"}),
+        ("write_file", {"path": "two.txt", "content": "second"}),
+    ],
+    "E2_all_three_closers_multiline": [
+        ("write_file", {"path": "doc.md", "content": f"line1 {PE}\nline2 {IE}\nline3 {E}\nend"})
+    ],
+    "J_string_false_json_holding_invoke_closer": [
+        ("set_cfg", {"n": 7, "cfg": {"note": f"a {IE} b"}})
+    ],
+}
+
+
+def _resolve_tokenizer_path() -> str | None:
+    hub = Path(os.environ.get("HF_HUB_CACHE", Path.home() / ".cache/huggingface/hub"))
+    snapshots = sorted(
+        hub.glob("models--deepseek-ai--DeepSeek-V4.1-Flash*/snapshots/*")
+    )
+    for candidate in (
+        *(["/models"] if Path("/models/tokenizer.json").is_file() else []),
+        *(str(s) for s in snapshots),
+        MODEL,
+    ):
+        try:
+            get_tokenizer(candidate, tokenizer_mode="deepseek_v41")
+            return candidate
+        except Exception:
+            if candidate == MODEL:
+                if os.environ.get("HF_HUB_OFFLINE") or os.environ.get(
+                    "TRANSFORMERS_OFFLINE"
+                ):
+                    return None
+                raise
+    return None
+
+
+@pytest.fixture(scope="module")
+def tokenizer():
+    path = _resolve_tokenizer_path()
+    if path is None:
+        pytest.skip(f"needs Hugging Face {MODEL} (offline)")
+    return get_tokenizer(path, tokenizer_mode="deepseek_v41")
+
+
+@pytest.fixture(scope="module")
+def tokenizer_path() -> str:
+    path = _resolve_tokenizer_path()
+    if path is None:
+        pytest.skip(f"needs Hugging Face {MODEL} (offline)")
+    return path
+
+
+def _req(stream: bool = False) -> ChatCompletionRequest:
+    return ChatCompletionRequest(
+        model="m",
+        messages=[{"role": "user", "content": "x"}],
+        tools=TOOLS,
+        stream=stream,
+    )
+
+
+def _parsed(args: str):
+    try:
+        return (json.loads(args) if args else None), True
+    except Exception:
+        return args, False
+
+
+def _run_nonstream(tok, text: str) -> dict:
+    r = _req()
+    tp = DeepSeekV41EngineToolParser(tok, r.tools, chat_template_kwargs={"thinking": False})
+    out = tp.extract_tool_calls(text, r)
+    calls = []
+    for c in out.tool_calls:
+        a, ok = _parsed(c.function.arguments)
+        calls.append({"name": c.function.name, "args": a, "json_ok": ok})
+    return {"tools_called": out.tools_called, "calls": calls, "content": out.content}
+
+
+def _run_stream(tok, text: str, chunk: int) -> dict:
+    r = _req(stream=True)
+    tp = DeepSeekV41EngineToolParser(tok, r.tools, chat_template_kwargs={"thinking": False})
+    ids = tok.encode(text, add_special_tokens=False)
+    prev_text, prev_ids, content, calls = "", [], "", {}
+
+    def absorb(d):
+        nonlocal content
+        if d is None:
+            return
+        if d.content:
+            content += d.content
+        for tc in d.tool_calls or []:
+            c = calls.setdefault(tc.index, {"name": None, "args": ""})
+            if tc.function and tc.function.name:
+                c["name"] = tc.function.name
+            if tc.function and tc.function.arguments:
+                c["args"] += tc.function.arguments
+
+    for i in range(0, len(ids), chunk):
+        cur_ids = ids[: i + chunk]
+        cur_text = tok.decode(cur_ids)
+        delta = cur_text[len(prev_text) :]
+        absorb(
+            tp.extract_tool_calls_streaming(
+                prev_text, cur_text, delta, prev_ids, cur_ids, ids[i : i + chunk], r
+            )
+        )
+        prev_text, prev_ids = cur_text, cur_ids
+    if hasattr(tp, "finish_streaming"):
+        absorb(tp.finish_streaming())
+    out = []
+    for k in sorted(calls):
+        a, ok = _parsed(calls[k]["args"])
+        out.append({"name": calls[k]["name"], "args": a, "json_ok": ok})
+    return {"calls": out, "content": content}
+
+
+def _calls_of(block: dict) -> list[tuple]:
+    return [(c["name"], c["args"]) for c in block.get("calls", [])]
+
+
+def test_structural_dsml_active_by_default() -> None:
+    assert v41mod._STRUCTURAL_ACTIVE is True
+
+
+@pytest.mark.parametrize("case_name", sorted(CASES))
+def test_structural_closer_matrix_case(tokenizer, case_name: str) -> None:
+    text = CASES[case_name]
+    ns = _run_nonstream(tokenizer, text)
+    for chunk in (1, 3, 7, 10**6):
+        st = _run_stream(tokenizer, text, chunk)
+        for call in st["calls"]:
+            if case_name in TRUNCATION:
+                continue
+            assert call["json_ok"], f"G1 {case_name} chunk={chunk}: {call['args']!r}"
+        if case_name not in TRUNCATION:
+            assert _calls_of(st) == _calls_of(ns), (
+                f"G2 {case_name} chunk={chunk}: stream {_calls_of(st)} != nonstream {_calls_of(ns)}"
+            )
+    if case_name in FIXED:
+        assert _calls_of(ns) == FIXED[case_name]
+    if case_name in ("N_omit_param_close_then_invoke_end", "N2_omit_param_close_then_invoke_end_eos"):
+        assert _calls_of(ns) == [("write_file", {"path": "a.txt", "content": "hello\n"})]
+    if case_name == "R_value_ends_with_literal_param_closer":
+        assert _calls_of(ns) == [("write_file", {"path": "x.md", "content": f"the tag is {PE}"})]
+
+
+@pytest.mark.parametrize("case_name", sorted(REASONING_CASES))
+def test_reasoning_unchanged_with_dsml_closers(tokenizer, case_name: str) -> None:
+    text = REASONING_CASES[case_name]
+    rp = DeepSeekV41ParserReasoningAdapter(
+        tokenizer, chat_template_kwargs={"thinking": True}
+    )
+    reasoning, content = rp.extract_reasoning(text, _req())
+    assert reasoning is not None
+    ns = _run_nonstream(tokenizer, text.split("</think>", 1)[1])
+    if case_name == "P_reasoning_mentions_closers":
+        assert "Plain answer" in (content or "")
+        assert _calls_of(ns) == []
+    else:
+        assert _calls_of(ns) == [("write_file", {"path": "a.txt", "content": "ok"})]
+
+
+def test_kill_switch_restores_previous_parser_and_fails_fixed(
+    tokenizer, tokenizer_path: str
+) -> None:
+    probe = f"""
+import json
+from vllm.tokenizers import get_tokenizer
+from tests.parser.test_deepseek_v41_structural_closers import (
+    CASES, UNCHANGED, FIXED, _run_nonstream, _run_stream, _calls_of,
+)
+tok = get_tokenizer({tokenizer_path!r}, tokenizer_mode="deepseek_v41")
+out = {{}}
+for k in sorted(UNCHANGED | set(FIXED)):
+    out[k] = {{
+        "ns": _run_nonstream(tok, CASES[k]),
+        "s1": _run_stream(tok, CASES[k], 1),
+    }}
+print(json.dumps(out))
+"""
+    env = dict(os.environ, VLLM_DSV41_STRUCTURAL_DSML="0")
+    proc = subprocess.run(
+        [sys.executable, "-c", probe],
+        env=env,
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    kill = json.loads(proc.stdout)
+    for k in UNCHANGED:
+        assert kill[k]["ns"] == _run_nonstream(tokenizer, CASES[k])
+        assert kill[k]["s1"] == _run_stream(tokenizer, CASES[k], 1)
+    for k, expected in FIXED.items():
+        assert _calls_of(kill[k]["ns"]) != expected, f"instrument check failed on {k}"
