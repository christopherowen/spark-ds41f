             current_waiter.set_result(False)
 
-    def _on_task_done(_: asyncio.Task[str]) -> None:
-        if current_waiter is not None and not current_waiter.done():
-            current_waiter.set_result(True)
-
     async def _run_cleanup() -> None:
         if next_task is not None:
             await _shield_wait(next_task)
@@ -155,20 +151,33 @@ async def _keep_alive_stream(
 
     try:
         while True:
-            if not next_task.done():
-                current_waiter = loop.create_future()
-                next_task.add_done_callback(_on_task_done)
-                if next_task.done():
-                    if not current_waiter.done():
-                        current_waiter.set_result(True)
+            while not next_task.done():
+                watched_task = next_task
+                waiter = loop.create_future()
+
+                def _on_task_done(
+                    done_task: asyncio.Task[str],
+                    w: asyncio.Future[bool] = waiter,
+                    expected: asyncio.Task[str] = watched_task,
+                ) -> None:
+                    # Bind callback state per wait so an already-queued callback
+                    # from a prior task can never resolve a newer wait future.
+                    if done_task is expected and not w.done():
+                        w.set_result(True)
+
+                watched_task.add_done_callback(_on_task_done)
+                current_waiter = waiter
+                if watched_task.done():
+                    if not waiter.done():
+                        waiter.set_result(True)
                 elif timer_handle is None:
                     timer_handle = loop.call_at(last_activity + interval, _on_timer)
                 try:
-                    ready = await current_waiter
+                    ready = await waiter
                 finally:
                     current_waiter = None
+                    watched_task.remove_done_callback(_on_task_done)
                 if not ready:
-                    next_task.remove_done_callback(_on_task_done)
                     last_activity = loop.time()
                     yield SSE_KEEP_ALIVE_COMMENT
                     if consumer_task is not None and consumer_task.cancelling():
