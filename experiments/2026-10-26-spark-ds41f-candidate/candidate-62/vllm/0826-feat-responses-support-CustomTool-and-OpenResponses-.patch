+def _make_tool_call(
+    index: int,
+    name: str | None = None,
+    arguments: str | None = None,
+    call_id: str | None = None,
+) -> DeltaToolCall:
+    return DeltaToolCall(
+        id=call_id,
+        index=index,
+        function=DeltaFunctionCall(name=name, arguments=arguments),
+    )
+
+
+def _run_processor(
+    processor: SimpleStreamingEventProcessor, delta_message: DeltaMessage
+) -> list:
+    events = []
+    for dm in split_delta(delta_message):
+        target_state, tool_call = processor.resolve_target_state(dm)
+        if target_state == _StateType.NONE:
+            continue
+        if processor.needs_transition(target_state, tool_call):
+            events.extend(processor.close_current())
+            events.extend(processor.open(target_state, tool_call))
+        events.extend(processor.emit_delta(dm, None))
+    return events
+
+
+def test_custom_tool_grammar_format_rejected_and_text_accepted() -> None:
+    grammar = {"type": "grammar", "syntax": "lark", "definition": 'start: "pwd"'}
+    with pytest.raises(VLLMValidationError) as exc_info:
+        ResponsesRequest(
+            input="hi",
+            tools=[{"type": "custom", "name": "emit", "format": grammar}],
+        )
+    assert exc_info.value.parameter == "tools"
+
+    request = ResponsesRequest(
+        input="hi",
+        tools=[{"type": "custom", "name": "emit", "format": {"type": "text"}}],
+        tool_choice={"type": "custom", "name": "emit"},
+    )
+    assert request.tools is not None and request.tools[0].type == "custom"
+    assert extract_function_tool_names(request.tools) == frozenset({"emit"})
+
+    with pytest.raises(VLLMValidationError):
+        ResponsesRequest(
+            input="hi",
+            tools=[{"type": "custom", "name": "emit"}],
+            tool_choice={"type": "custom", "name": "missing"},
+        )
+
+
+@pytest.mark.parametrize(
+    "tools",
+    [
+        "abc",
+        {"type": "custom"},
+        [None],
+        [{"type": "custom", "name": "x", "format": "text"}],
+    ],
+)
+def test_malformed_tools_rejected_by_field_validation(tools) -> None:
+    with pytest.raises(ValidationError):
+        ResponsesRequest(input="hi", tools=tools)
+
+
+def test_custom_tool_output_and_codex_compaction_replay() -> None:
+    tools = [
+        CustomTool(type="custom", name="apply_patch", format={"type": "text"}),
+        FunctionTool(
+            type="function", name="get_weather", parameters={}, strict=None
+        ),
+    ]
+    custom, function = build_response_output_items(
+        reasoning=None,
+        content=None,
+        tool_calls=[
+            FunctionCall(
+                id="call_1",
+                name="apply_patch",
+                arguments='{"input": "*** Begin Patch\\n*** End Patch"}',
+            ),
+            FunctionCall(
+                id="call_2", name="get_weather", arguments='{"city": "Paris"}'
+            ),
+        ],
+        tools=tools,
+    )
+    assert isinstance(custom, ResponseCustomToolCall)
+    assert (custom.call_id, custom.input) == (
+        "call_1",
+        "*** Begin Patch\n*** End Patch",
+    )
+    assert custom.id.startswith("ctc_")
+    assert isinstance(function, ResponseFunctionToolCall)
+    assert function.arguments == '{"city": "Paris"}'
+
+    # Exact #1206 Codex multi-turn custom_tool_call + custom_tool_call_output history
+    req = ResponsesRequest.model_validate(
+        {
+            "model": "deepseek-v41",
+            "tools": [{"type": "custom", "name": "apply_patch"}],
+            "input": [
+                {"role": "user", "content": "Patch the file"},
+                {
+                    "type": "reasoning",
+                    "summary": [],
+                    "encrypted_content": None,
+                },
+                {
+                    "type": "custom_tool_call",
+                    "call_id": "call_patch_1",
+                    "name": "apply_patch",
+                    "input": "*** Begin Patch\n*** End Patch",
+                },
+                {
+                    "type": "custom_tool_call_output",
+                    "call_id": "call_patch_1",
+                    "output": "Success. Updated 1 file.",
+                },
+                {
+                    "type": "message",
+                    "role": "assistant",
+                    "content": [{"type": "output_text", "text": "Done."}],
+                },
+                {"role": "user", "content": "Next step"},
+            ],
+        }
+    )
+    assert isinstance(req.input, list)
+    messages = construct_chat_messages_with_tool_call(req.input)
+    assert messages == [
+        {"role": "user", "content": "Patch the file"},
+        {
+            "role": "assistant",
+            "reasoning": "",
+            "tool_calls": [
+                {
+                    "id": "call_patch_1",
+                    "type": "function",
+                    "function": {
+                        "name": "apply_patch",
+                        "arguments": '{"input": "*** Begin Patch\\n*** End Patch"}',
+                    },
+                }
+            ],
+        },
+        {
+            "role": "tool",
+            "content": "Success. Updated 1 file.",
+            "tool_call_id": "call_patch_1",
+        },
+        {"role": "assistant", "content": "Done."},
+        {"role": "user", "content": "Next step"},
+    ]
