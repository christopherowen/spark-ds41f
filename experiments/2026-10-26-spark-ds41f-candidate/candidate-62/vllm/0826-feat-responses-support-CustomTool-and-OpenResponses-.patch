+def test_decode_custom_tool_input_and_prefix() -> None:
+    assert decode_custom_tool_input('{"input": "pwd"}') == "pwd"
+    assert decode_custom_tool_input('{"cmd": "pwd"}') == '{"cmd": "pwd"}'
+    assert decode_custom_tool_input('{"input": 7}') == '{"input": 7}'
+    assert decode_custom_tool_input("pwd") == "pwd"
+
+    assert decode_custom_tool_input_prefix('{"inp') == ""
+    assert decode_custom_tool_input_prefix('{"input": "ls \\"dir') == 'ls "dir'
+    assert decode_custom_tool_input_prefix('{"input": "a\\') == "a"
+    assert decode_custom_tool_input_prefix('{"input": "\\ud83d') == ""
+    assert (
+        decode_custom_tool_input_prefix('{"input": "\\ud83d\\ude00!"}')
+        == "\U0001f600!"
+    )
+
+
+def test_custom_tool_streaming_events_and_function_call_invariance() -> None:
+    # Custom tool streams response.custom_tool_call_input.{delta,done}
+    processor = SimpleStreamingEventProcessor(
+        tools=[CustomTool(type="custom", name="emit_command")]
+    )
+    events = _run_processor(
+        processor,
+        DeltaMessage(
+            tool_calls=[
+                _make_tool_call(0, name="emit_command", arguments='{"input": "ls ')
+            ]
+        ),
+    )
+    events += _run_processor(
+        processor,
+        DeltaMessage(tool_calls=[_make_tool_call(0, arguments='-la \\"x\\""}')]),
+    )
+    events += processor.close_current()
+    assert [e.type for e in events] == [
+        "response.output_item.added",
+        "response.custom_tool_call_input.delta",
+        "response.custom_tool_call_input.delta",
+        "response.custom_tool_call_input.done",
+        "response.output_item.done",
+    ]
+    done = events[-1].item
+    assert isinstance(done, ResponseCustomToolCall)
+    assert done.input == 'ls -la "x"'
+    assert "".join(e.delta for e in events[1:3]) == done.input
+    assert events[3].input == done.input
+    assert done.id.startswith("ctc_")
+
+    # Unrelated keys before "input" do not leak into deltas.
+    p2 = SimpleStreamingEventProcessor(
+        tools=[CustomTool(type="custom", name="emit_command")]
+    )
+    e2 = _run_processor(
+        p2,
+        DeltaMessage(
+            tool_calls=[_make_tool_call(0, name="emit_command", arguments='{"a": "xy"')]
+        ),
+    )
+    e2 += _run_processor(
+        p2,
+        DeltaMessage(tool_calls=[_make_tool_call(0, arguments=', "input": "hello"}')]),
+    )
+    e2 += p2.close_current()
+    assert "".join(
+        e.delta for e in e2 if e.type == "response.custom_tool_call_input.delta"
+    ) == "hello"
+
+    # Non-extension final payload resends authoritative payload on close.
+    p3 = SimpleStreamingEventProcessor(
+        tools=[CustomTool(type="custom", name="emit_command")]
+    )
+    p3.state.current_state = _StateType.TOOL_CALL
+    p3.state.tool_call_is_custom = True
+    p3.state.tool_call_payload = "xy"
+    p3.state.accumulated_text = '{"a": "xy", "input": "hello"}'
+    e3 = p3.close_current()
+    assert [
+        e.delta for e in e3 if e.type == "response.custom_tool_call_input.delta"
+    ] == ["hello"]
+    assert e3[-1].item.input == "hello"
+
+    # Regular function tool without deltas keeps 19f2c20ed4d6 shape (no empty arguments.done).
+    p4 = SimpleStreamingEventProcessor()
+    e4 = _run_processor(
+        p4, DeltaMessage(tool_calls=[_make_tool_call(0, name="noop")])
+    )
+    e4 += p4.close_current()
+    assert [e.type for e in e4] == [
+        "response.output_item.added",
+        "response.output_item.done",
+    ]
+
+
+def test_tool_schema_helpers_and_openresponses_normalization() -> None:
+    tool = CustomTool(type="custom", name="emit_command", description="Emit")
+    [tool_dict] = iter_response_function_tool_dicts([tool])
+    assert tool_dict == {
+        "type": "function",
+        "name": "emit_command",
+        "description": "Emit",
+        "parameters": custom_tool_parameters(),
+    }
+    assert find_tool_name([tool], "emit_command") is True
+    assert find_tool_properties([tool], "emit_command") == custom_tool_parameters()["properties"]
+    assert (
+        get_json_schema_from_tools(
+            ToolChoiceCustom(type="custom", name="emit_command"), [tool]
+        )
+        == custom_tool_parameters()
+    )
+    dumped_tool = _dump_tool_for_xgrammar(tool)
+    assert dumped_tool["type"] == "function"
+    assert dumped_tool["function"]["name"] == "emit_command"
+    assert _dump_tool_choice_for_xgrammar(
+        ToolChoiceCustom(type="custom", name="emit_command")
+    ) == {"type": "function", "function": {"name": "emit_command"}}
+
+    # Typeless assistant message without id/status survives OpenResponses normalization.
+    req = ResponsesRequest.model_validate(
+        {
+            "input": [
+                {
+                    "role": "assistant",
+                    "content": [{"type": "output_text", "text": "hi"}],
+                }
+            ]
+        }
+    )
+    assert isinstance(req.input, list) and len(req.input) == 1
+    assert isinstance(req.input[0], ResponseOutputMessage)
+    assert req.input[0].content[0].text == "hi"
+
+    # Empty ResponseOutputMessage.content does not crash message construction.
+    empty_msg = ResponseOutputMessage(
+        id="msg_empty",
+        content=[],
+        role="assistant",
+        status="completed",
+        type="message",
+    )
+    assert _construct_message_from_response_item(empty_msg) == {
+        "role": "assistant",
+        "content": "",
+    }
