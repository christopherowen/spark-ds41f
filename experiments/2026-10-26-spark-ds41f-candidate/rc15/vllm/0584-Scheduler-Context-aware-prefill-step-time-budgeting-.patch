+    # Calibrated step-time model parameters (DeepSeek V4.1 Flash, calibrate.py):
+    #   t_chunk(q, c) ~= F + alpha * t_dec(n_dec) + m0 * q + m1 * q * c
+    _PREFILL_FIXED_COST_S = 0.1535
+    _PREFILL_DECODE_ALPHA = 1.56
+    _PREFILL_M0_S_PER_TOK = 1.2532308400535526e-4
+    _PREFILL_M1_S_PER_TOK2 = 1.3289467958204244e-10
+    _DECODE_STEP_KNOTS: tuple[tuple[int, float], ...] = (
+        (1, 0.02983160068849846),
+        (8, 0.08379558412906112),
+        (16, 0.11908994468658608),
+    )
+
+    @staticmethod
+    def _estimate_decode_step_s(num_runnable_decodes: int) -> float:
+        if num_runnable_decodes <= 0:
+            return 0.0
+        knots = Scheduler._DECODE_STEP_KNOTS
+        if num_runnable_decodes <= knots[0][0]:
+            return knots[0][1]
+        for (n0, t0), (n1, t1) in zip(knots, knots[1:]):
+            if num_runnable_decodes <= n1:
+                return t0 + (t1 - t0) * (num_runnable_decodes - n0) / (n1 - n0)
+        (n0, t0), (n1, t1) = knots[-2], knots[-1]
+        return t1 + (num_runnable_decodes - n1) * (t1 - t0) / (n1 - n0)
+
+    def _context_aware_chunk_threshold(
+        self, num_computed_tokens: int, num_runnable_decodes: int = 0
+    ) -> int:
+        """Select the context-aware chunk threshold ``T(c)`` on the absolute
+        ``prefill_chunk_grid`` grid when decode requests are runnable.
+
+        When ``num_runnable_decodes == 0`` (solo prefill) or
+        ``prefill_step_target_s <= 0``, returns the full
+        ``long_prefill_token_threshold`` so solo prefill speed is unchanged.
+        When ``num_runnable_decodes > 0`` and ``prefill_step_target_s > 0``,
+        quantizes ``(tau_max - F - alpha * t_dec) / (m0 + m1 * c)`` onto
+        ``{grid, 2 * grid, 4 * grid, long_prefill_token_threshold}`` capped by
+        ``long_prefill_token_threshold``.
+        """
+        threshold = self.scheduler_config.long_prefill_token_threshold
+        step_target_s = getattr(self.scheduler_config, "prefill_step_target_s", 0.0)
+        if threshold <= 0 or num_runnable_decodes <= 0 or step_target_s <= 0.0:
+            return threshold
+        grid = max(int(getattr(self.scheduler_config, "prefill_chunk_grid", 2048)), 1)
+        t_dec = Scheduler._estimate_decode_step_s(num_runnable_decodes)
+        avail_s = max(
+            step_target_s
+            - Scheduler._PREFILL_FIXED_COST_S
+            - Scheduler._PREFILL_DECODE_ALPHA * t_dec,
+            0.0,
+        )
+        denom = (
+            Scheduler._PREFILL_M0_S_PER_TOK
+            + Scheduler._PREFILL_M1_S_PER_TOK2 * max(num_computed_tokens, 0)
+        )
+        q_raw = avail_s / denom if denom > 0.0 else float(threshold)
+        grid_units = max(1, int((q_raw + 0.75 * grid) // grid))
+        if grid_units <= 1:
+            tier = grid
+        elif grid_units == 2:
+            tier = 2 * grid
+        elif grid_units <= 4:
+            tier = 4 * grid
+            if tier > threshold >= 2 * grid:
+                tier = 2 * grid
+        else:
+            tier = threshold
+        return min(tier, threshold)
+
