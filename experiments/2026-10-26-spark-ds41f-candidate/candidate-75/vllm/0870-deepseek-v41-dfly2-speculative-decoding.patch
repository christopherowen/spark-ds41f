+
+
+class DFly2Speculator(DraftModelSpeculator):
+    """Speculator for DeepSeek-V4.1 DFly2 draft checkpoints."""
+
+    _speculator_name = "DFly2"
+    uses_target_attn_metadata = False
+
+    @property
