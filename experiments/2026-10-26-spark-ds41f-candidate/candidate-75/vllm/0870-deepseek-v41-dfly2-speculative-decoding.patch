+def _encode_swa_records(latents_bf16: torch.Tensor) -> torch.Tensor:
+    """Pack ``[N, 512]`` BF16 latents into ``[N, 528]`` uint8 (E4M3 + UE8M0) records."""
+    n = latents_bf16.shape[0]
+    x = latents_bf16.to(torch.float32).view(n, 512 // SWA_GROUP, SWA_GROUP)
+    amax = x.abs().amax(dim=-1).clamp(min=1e-12)
+    exp = torch.ceil(torch.log2(amax / 448.0)).to(torch.int32).clamp(-126, 127)
+    scale = torch.ldexp(torch.ones_like(amax), exp)
+    q = (x / scale.unsqueeze(-1)).clamp(-448.0, 448.0).to(torch.float8_e4m3fn)
+    out = torch.empty((n, SWA_RECORD_BYTES), dtype=torch.uint8)
+    out[:, :512] = q.reshape(n, 512).view(torch.uint8)
+    out[:, 512:] = (exp + 127).to(torch.uint8)
+    return out
+
+
+def _encode_idx_records(latents_bf16: torch.Tensor) -> torch.Tensor:
+    """Pack ``[N, 512]`` BF16 latents into ``[N, 288]`` uint8 (E2M1 + E4M3) records."""
+    lut_vals = torch.tensor(
+        [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0], dtype=torch.float32
+    )
+    n = latents_bf16.shape[0]
+    x = latents_bf16.to(torch.float32).view(n, 512 // IDX_GROUP, IDX_GROUP)
+    amax = x.abs().amax(dim=-1).clamp(min=1e-6)
+    scale_fp8 = (amax / 6.0).clamp(max=448.0).to(torch.float8_e4m3fn)
+    scale = scale_fp8.to(torch.float32).clamp(min=1e-6)
+    scaled = x / scale.unsqueeze(-1)
+    sign = (scaled < 0).to(torch.uint8) << 3
+    mag = scaled.abs().unsqueeze(-1)
+    code = (mag - lut_vals).abs().argmin(dim=-1).to(torch.uint8) | sign
+    code_flat = code.reshape(n, 256, 2)
+    packed = code_flat[:, :, 0] | (code_flat[:, :, 1] << 4)
+    out = torch.empty((n, IDX_RECORD_BYTES), dtype=torch.uint8)
+    out[:, :256] = packed
+    out[:, 256:] = scale_fp8.view(torch.uint8)
+    return out
