+    def load_draft_model(
+        self,
+        target_model: nn.Module,
+        target_attn_layer_names: set[str],
+    ) -> nn.Module:
+        model = load_dfly2_model(target_model, self.vllm_config)
+        self._target_index_attns = model.bind_target_layers(target_model)
+        if self.model_layers_exist(model):
+            self.swa_page_size = model.model.layers[0].attn._swa_page_size
+            self.main_page_size = model.model.layers[0].attn._main_page_size
+        if model.model.embed_tokens is not None:
+            model.model.cache_mask_embed(self.device)
+        return model
+
+    @staticmethod
+    def model_layers_exist(model: nn.Module) -> bool:
+        inner = getattr(model, "model", None)
+        layers = getattr(inner, "layers", None)
+        return bool(layers)
+
+    def load_model(self, target_model: nn.Module) -> None:
+        super().load_model(target_model)
+        if self.acceptance_estimator is not None and self.draft_logits is None:
+            self.acceptance_estimator.reset_for_confidence_head(
+                warm_start=True,
+                with_margin=False,
+                prior_intercepts=_DFLY2_MARGIN_PRIOR_INTERCEPTS,
+            )
+
+    def set_attn(
+        self,
+        model_state: ModelState,
+        kv_cache_config: KVCacheConfig,
+        block_tables: BlockTables,
+        target_input_buffers: InputBuffers,
+        target_attn_groups: list[list[AttentionGroup]],
+    ) -> None:
+        super().set_attn(
+            model_state,
+            kv_cache_config,
+            block_tables,
+            target_input_buffers,
+            target_attn_groups,
+        )
+        layer_to_gid: dict[str, int] = {}
+        for gid, group in enumerate(kv_cache_config.kv_cache_groups):
+            for lname in group.layer_names:
+                layer_to_gid[lname] = gid
+        swa_gids: list[int] = []
+        for draft_layer in self.model.model.layers:
+            swa_prefix = draft_layer.attn._target_swa_layer.prefix
+            swa_gids.append(layer_to_gid[swa_prefix])
+        self._swa_group_ids = tuple(swa_gids)
+        main_prefix = self.model.model.layers[0].attn._target_main_layer.prefix
+        self._main_group_id = layer_to_gid[main_prefix]
+
+    def register_warmups(self) -> None:
+        tp_size = (
+            get_tensor_model_parallel_world_size()
+            if model_parallel_is_initialized()
+            else 1
+        )
+        for i in range(self.num_speculative_steps):
+            register_select_first_argmax_warmup(
+                ranks=tp_size,
+                output_dtype=self.draft_tokens.dtype,
+                output_stride=self.draft_tokens.stride(0),
+                output_aligned=i * self.draft_tokens.element_size() % 16 == 0,
+                pair_width=4,
+                top2=True,
+            )
+        num_layers = len(self.target_kv_layers)
+        step_calls = {
+            idx_dtype: tl_dfly2.prepare_step_call(
+                num_layers,
+                self.block_size,
+                self.num_speculative_steps,
+                self.hidden_size,
+                self.window_size,
+                self.index_topk,
+                self.swa_page_size,
+                self.main_page_size,
+                idx_dtype,
+            )
+            for idx_dtype in ("int64", "int32")
+        }
+
+        def bind_step_kernels() -> None:
+            self._prepare_step_kernels = {
+                idx_dtype: prepare.launch(call_item)
+                for idx_dtype, call_item in step_calls.items()
+            }
+
+        prepare.declare(lambda: list(step_calls.values()), bind=bind_step_kernels)
+        tilelang_inputs.declare(tilelang_inputs.padding_rows_calls)
+
+    def init_cudagraph_manager(self, cudagraph_mode: CUDAGraphMode) -> None:
+        if not cudagraph_mode.has_full_cudagraphs() or self.device.type != "cuda":
+            self.cudagraph_manager = None
+            return
+        sizes = [
+            r * self.block_size for r in range(1, self.max_num_reqs + 1)
+        ]
+        cfg = copy.copy(self.vllm_config)
+        cfg.compilation_config = copy.copy(self.vllm_config.compilation_config)
+        cfg.compilation_config.cudagraph_capture_sizes = sizes
+        cfg.compilation_config.max_cudagraph_capture_size = sizes[-1]
+        self.cudagraph_manager = CudaGraphManager(
+            cfg,
+            self.device,
+            CUDAGraphMode.FULL_DECODE_ONLY,
+            decode_query_len=self.block_size,
+        )
+
+    def capture(self) -> None:
+        if self.cudagraph_manager is None:
+            return
+        self._is_padding.fill_(True)
+        self.ctx_swa_indices.fill_(-1)
+        self.ctx_swa_lengths.zero_()
+        self.ctx_topk_indices.fill_(-1)
+        self.ctx_top_lengths.zero_()
+        self.ctx_main_page_table.zero_()
+        self.req_idx_mapping.fill_(-1)
+        self.sample_idx_mapping.fill_(-1)
+        self.mtp_valid.zero_()
+
+        for num_tokens in reversed(
+            self.cudagraph_manager.compilation_config.cudagraph_capture_sizes
+        ):
+            n_reqs = num_tokens // self.block_size
+            self._run_draft_step(n_reqs, self.num_speculative_steps)
+        if torch.cuda.is_available():
+            torch.accelerator.synchronize()
+            torch.accelerator.empty_cache()
+
+        def create_forward_fn(desc, warmup):
+            n_reqs = desc.num_tokens // self.block_size
+            return lambda cg_mode: self._run_draft_step(
+                n_reqs, self.num_speculative_steps
+            )
+
+        self.cudagraph_manager.capture(
+            create_forward_fn, progress_bar_desc="Capturing DFly2 CUDA graphs"
+        )
+
+    def _prepare_step_inputs(
+        self,
+        input_batch: InputBatch,
+        last_hidden_states: torch.Tensor,
+        num_sampled: torch.Tensor,
+        num_rejected: torch.Tensor,
+        last_sampled: torch.Tensor,
+        next_prefill_tokens: torch.Tensor,
+        temperature: torch.Tensor,
+        seeds: torch.Tensor,
+        padded_reqs: int,
+    ) -> None:
+        num_reqs = input_batch.num_reqs
+        padded_rows = padded_reqs * self.block_size
+        ced_state = getattr(getattr(self, "model_state", None), "ced_state", None)
+        has_ced_compact = ced_state is not None and ced_state.plan is not None
+        dec_starts = (
+            ced_state.starts if has_ced_compact else input_batch.query_start_loc
+        )
+        has_replay = ced_state is not None
+        replay_start = (
+            ced_state.replay_start if has_replay else self._zero_replay_start
+        )
+
+        swa_tables = tuple(
+            self.block_tables.input_block_tables[gid] for gid in self._swa_group_ids
+        )
+        main_table = self.block_tables.input_block_tables[self._main_group_id]
+        src_topks = tuple(
+            attn.topk_indices_buffer for attn in self._target_index_attns
+        )
+
+        if self.device.type == "cuda":
+            if envs.VLLM_MOE_SKIP_PADDING:
+                tilelang_inputs.padding_rows(
+                    self._is_padding, num_reqs * self.block_size, padded_rows
+                )
+            self.temperature[: len(temperature)].copy_(temperature)
+            self.seeds[: len(seeds)].copy_(seeds)
+            idx_dtype = "int64" if input_batch.idx_mapping.dtype == torch.int64 else "int32"
+            kernel = self._prepare_step_kernels.get(idx_dtype)
+            if kernel is None:
+                kernel = prepare.launch(
+                    tl_dfly2.prepare_step_call(
+                        len(self.target_kv_layers),
+                        self.block_size,
+                        self.num_speculative_steps,
+                        self.hidden_size,
+                        self.window_size,
+                        self.index_topk,
+                        self.swa_page_size,
+                        self.main_page_size,
+                        idx_dtype,
+                    )
+                )
+                self._prepare_step_kernels[idx_dtype] = kernel
+            kernel(
+                self.block_input_ids[:padded_rows],
+                self.block_positions[:padded_rows],
+                self.anchor_tokens[:padded_reqs],
+                self.anchor_positions[:padded_reqs],
+                self.mtp_valid[:padded_reqs],
+                self.prev_hidden[:padded_reqs],
+                self.req_idx_mapping[:padded_reqs],
+                self.sample_idx_mapping[:padded_reqs],
+                self.ctx_swa_indices,
+                self.ctx_swa_lengths,
+                self.ctx_topk_indices,
+                self.ctx_top_lengths[:padded_reqs],
+                self.ctx_main_page_table[:padded_reqs],
+                input_batch.positions,
+                input_batch.query_start_loc,
+                dec_starts,
+                input_batch.idx_mapping,
+                last_sampled.view(-1),
+                next_prefill_tokens.view(-1),
+                num_sampled,
+                num_rejected,
+                last_hidden_states,
+                replay_start,
+                swa_tables[0],
+                swa_tables[1],
+                swa_tables[2],
+                main_table,
+                src_topks[0],
+                src_topks[1],
+                src_topks[2],
+                self.mask_token_id,
+                self.max_model_len,
+                num_reqs,
+                int(has_replay),
+            )
+            return
+
+        self._is_padding[: num_reqs * self.block_size].fill_(False)
+        self._is_padding[num_reqs * self.block_size : padded_rows].fill_(True)
+        self.temperature[: len(temperature)].copy_(temperature)
+        self.seeds[: len(seeds)].copy_(seeds)
+        tl_dfly2.dfly2_prepare_step_cpu(
+            self.block_input_ids,
+            self.block_positions,
+            self.anchor_tokens,
+            self.anchor_positions,
+            self.mtp_valid,
+            self.prev_hidden,
+            self.req_idx_mapping,
+            self.sample_idx_mapping,
+            self.ctx_swa_indices,
+            self.ctx_swa_lengths,
+            self.ctx_topk_indices,
+            self.ctx_top_lengths,
+            self.ctx_main_page_table,
+            input_batch.positions,
+            input_batch.query_start_loc,
+            dec_starts,
+            input_batch.idx_mapping,
+            last_sampled.view(-1),
+            next_prefill_tokens.view(-1),
+            num_sampled,
+            num_rejected,
+            last_hidden_states,
+            replay_start,
+            swa_tables,
+            main_table,
+            src_topks,
+            block_size=self.block_size,
+            window_size=self.window_size,
+            swa_page_size=self.swa_page_size,
+            mask_token_id=self.mask_token_id,
+            max_model_len=self.max_model_len,
+            num_reqs=num_reqs,
+            padded_reqs=padded_reqs,
+            has_replay=has_replay,
+        )
+
+    def _sample_step(
+        self,
+        h_step: torch.Tensor,
+        num_reqs: int,
+        step: int,
+        sample_pos: torch.Tensor,
+    ) -> torch.Tensor:
+        out_col = self.draft_tokens[:num_reqs, step]
+        if (
+            self.draft_logits is None
+            and h_step.is_cuda
+            and self.model.supports_vocab_parallel_greedy()
+        ):
+            _, row_topk = self.model.greedy_pairs_local(h_step, top_k=2)
+            assert row_topk is not None
+            pairs = self._greedy_pairs_buf[:num_reqs]
+            pairs[:, 0] = row_topk[:, 0]
+            pairs[:, 1] = row_topk[:, 2]
+            pairs[:, 2] = row_topk[:, 1]
+            pairs[:, 3] = torch.where(
+                torch.isfinite(row_topk[:, 1]),
+                row_topk[:, 3],
+                torch.full_like(row_topk[:, 3], float(1 << 30)),
+            )
+            gathered = tensor_model_parallel_all_gather(pairs, dim=-1)
+            select_first_argmax(
+                gathered,
+                out_col,
+                pair_width=4,
+                embed=None,
+                top2_branch=(
+                    None,
+                    self.draft_runner_up_tokens[:num_reqs, step],
+                    self.draft_top2_margins[:num_reqs, step],
+                    0.0,
+                    1.0,
+                ),
+            )
+            return out_col
+
+        logits = self.model.compute_logits(h_step)
+        assert logits is not None
+        idx_map = self.req_idx_mapping[:num_reqs]
+        if self.draft_logits is None:
+            if self.acceptance_estimator is not None:
+                top2_vals = torch.topk(logits.to(torch.float32), k=2, dim=-1).values
+                self.draft_top2_margins[:num_reqs, step] = (
+                    top2_vals[:, 0] - top2_vals[:, 1]
+                ).clamp(min=0.0)
+            out_col.copy_(logits.argmax(dim=-1))
+            return out_col
+
+        self._maybe_predict_acceptance(logits, idx_map, self._step_cols[step])
+        sampled = gumbel_sample(
+            logits,
+            idx_map,
+            self.temperature,
+            self.seeds,
+            sample_pos - 1,
+            apply_temperature=True,
+            is_drafting=True,
+            logits_cache=self.draft_logits,
+            logits_cache_col=self._step_cols[step],
+            use_fp64=self.use_fp64_gumbel,
+        )
+        if self.draft_watermarker is not None:
+            sampled = self.draft_watermarker.sample(
+                logits,
+                sampled,
+                idx_map,
+                self.temperature,
+            )
+        out_col.copy_(sampled)
+        return out_col
+
+    def _calibrate_greedy_margins(self, num_reqs: int, active_steps: int) -> None:
+        if self.draft_logits is not None:
+            return
+        margins = (
+            torch.nan_to_num(
+                self.draft_top2_margins[:num_reqs, :active_steps], nan=0.0
+            )
+            .clamp(0.0, _MARGIN_CAP)
+        )
+        raw_probs = torch.sigmoid(torch.log1p(margins))
+        conf = self.draft_token_confidence_probs[:num_reqs]
+        conf[:, :active_steps].copy_(raw_probs)
+        if active_steps < self.num_speculative_steps:
+            conf[:, active_steps:].zero_()
+        if self.acceptance_estimator is not None:
+            idx_map = self.sample_idx_mapping[:num_reqs]
+            if active_steps < self.num_speculative_steps:
+                idx_map = idx_map.clone()
+                idx_map[:, active_steps:].fill_(-1)
+            if self.device.type == "cuda":
+                self.acceptance_estimator.calibrate_confidence_probs(
+                    conf, idx_map.reshape(-1)
+                )
+            else:
+                eps = 1e-6
+                clamped = conf[:, :active_steps].clamp(eps, 1.0 - eps)
+                feat = torch.log(clamped / (1.0 - clamped))
+                slope = self.acceptance_estimator.slope
+                bias = self.acceptance_estimator.intercepts[:active_steps].unsqueeze(0)
+                pred = torch.sigmoid(slope * feat + bias)
+                conf[:, :active_steps].copy_(pred)
+                for r in range(num_reqs):
+                    slot = int(self.req_idx_mapping[r].item())
+                    if slot >= 0:
+                        self.acceptance_estimator.features[slot, :active_steps].copy_(
+                            feat[r]
+                        )
+                        self.acceptance_estimator.predictions[
+                            slot, :active_steps
+                        ].copy_(pred[r])
+
+    def _run_draft_step(self, num_reqs: int, active_steps: int) -> None:
+        rows = num_reqs * self.block_size
+        batch_desc = BatchDescriptor(num_tokens=rows, num_reqs=num_reqs)
+        with set_forward_context(
+            None,
+            self.vllm_config,
+            num_tokens=rows,
+            cudagraph_runtime_mode=CUDAGraphMode.NONE,
+            batch_descriptor=batch_desc,
+            is_padding=(
+                self._is_padding[:rows] if envs.VLLM_MOE_SKIP_PADDING else None
+            ),
+        ):
+            backbone_h, raw_anchor_embeds = self.model.model.forward_backbone(
+                self.block_input_ids[:rows],
+                self.block_positions[:rows],
+                self.prev_hidden[:num_reqs],
+                self.mtp_valid[:num_reqs],
+                self.ctx_swa_indices[:, :num_reqs],
+                self.ctx_swa_lengths[:, :num_reqs],
+                self.ctx_topk_indices[:, :num_reqs],
+                self.ctx_top_lengths[:num_reqs],
+                self.ctx_main_page_table[:num_reqs],
+                is_padding=self._is_padding[:rows],
+            )
+            pos_cols = (
+                self.block_positions[:rows]
+                .view(num_reqs, self.block_size)
+                .transpose(0, 1)
+                .contiguous()
+            )
+            backbone_cols = backbone_h.transpose(0, 1).contiguous()
+            hc = self.model.model.hidden_correction
+            if hc is None:
+                for step in range(active_steps):
+                    self._sample_step(
+                        backbone_cols[step + 1],
+                        num_reqs,
+                        step,
+                        pos_cols[step + 1],
+                    )
+            else:
+                src_i = (
+                    hc.attention.source_draft_layer
+                    if hc.attention is not None
+                    else -1
+                )
+                swa_idx = self.ctx_swa_indices[src_i, :num_reqs]
+                swa_len = self.ctx_swa_lengths[src_i, :num_reqs]
+                topk_idx = self.ctx_topk_indices[src_i, :num_reqs]
+                top_len = self.ctx_top_lengths[:num_reqs]
+                main_pt = self.ctx_main_page_table[:num_reqs]
+
+                e_norm_anchor = _rms_norm(hc.embed_norm, raw_anchor_embeds)
+                h_norm_01 = _rms_norm(
+                    hc.hidden_norm,
+                    backbone_cols[:2].view(2 * num_reqs, -1),
+                ).view(2, num_reqs, -1)
+                z_0 = torch.cat([h_norm_01[0], e_norm_anchor], dim=-1)
+                z_1 = torch.cat([h_norm_01[1], e_norm_anchor], dim=-1)
+                qkv_gate_1 = (
+                    hc.attention.record_slot0_and_project_slot1(
+                        z_0, z_1, pos_cols[0]
+                    )
+                    if hc.attention is not None
+                    else None
+                )
+
+                prev_tokens: torch.Tensor | None = None
+                for step in range(active_steps):
+                    j = step + 1
+                    if step == 0:
+                        h_corr = hc.forward_step(
+                            backbone_cols[1],
+                            e_norm_anchor,
+                            pos_cols[1],
+                            1,
+                            swa_idx,
+                            swa_len,
+                            topk_idx,
+                            top_len,
+                            main_pt,
+                            precomputed_h_norm=h_norm_01[1],
+                            precomputed_z=z_1,
+                            precomputed_qkv_gate=qkv_gate_1,
+                        )
+                    else:
+                        assert prev_tokens is not None
+                        e_prev = self.model.embed_input_ids(prev_tokens.contiguous())
+                        e_norm_prev = _rms_norm(hc.embed_norm, e_prev)
+                        h_corr = hc.forward_step(
+                            backbone_cols[j],
+                            e_norm_prev,
+                            pos_cols[j],
+                            j,
+                            swa_idx,
+                            swa_len,
+                            topk_idx,
+                            top_len,
+                            main_pt,
+                        )
+                    prev_tokens = self._sample_step(
+                        h_corr, num_reqs, step, pos_cols[j]
+                    )
+
+            if self.enable_adaptive_verification:
+                self._calibrate_greedy_margins(num_reqs, active_steps)
+
+    def propose(
+        self,
+        input_batch: InputBatch,
+        attn_metadata: dict[str, Any],
+        slot_mappings: dict[str, torch.Tensor],
+        last_hidden_states: torch.Tensor,
+        aux_hidden_states: list[torch.Tensor] | None,
+        num_sampled: torch.Tensor,
+        num_rejected: torch.Tensor,
+        last_sampled: torch.Tensor,
+        next_prefill_tokens: torch.Tensor,
+        temperature: torch.Tensor,
+        seeds: torch.Tensor,
+        dp_sync: DPSyncState | None = None,
+        num_speculative_tokens: int | None = None,
+        dummy_run: bool = False,
+        skip_attn_for_dummy_run: bool = False,
+        mm_inputs: tuple[list[torch.Tensor], torch.Tensor] | None = None,
+        is_profile: bool = False,
+    ) -> torch.Tensor:
+        num_reqs = input_batch.num_reqs
+        active_steps = (
+            self.num_speculative_steps
+            if num_speculative_tokens is None
+            else max(1, min(int(num_speculative_tokens), self.num_speculative_steps))
+        )
+        if num_reqs == 0 or skip_attn_for_dummy_run:
+            return self.draft_tokens[:num_reqs, :active_steps]
+
+        desc = None
+        padded_reqs = num_reqs
+        if (
+            self.cudagraph_manager is not None
+            and not dummy_run
+            and not is_profile
+        ):
+            candidate = self.cudagraph_manager.dispatch(
+                num_reqs, num_reqs * self.block_size, self.block_size, 0
+            )
+            if candidate in self.cudagraph_manager.graphs:
+                desc = candidate
+                padded_reqs = desc.num_tokens // self.block_size
+
+        self._prepare_step_inputs(
+            input_batch,
+            last_hidden_states,
+            num_sampled,
+            num_rejected,
+            last_sampled,
+            next_prefill_tokens,
+            temperature,
+            seeds,
+            padded_reqs,
+        )
+        if desc is not None:
+            self.cudagraph_manager.run_fullgraph(desc)
+            if (
+                active_steps < self.num_speculative_steps
+                and self.enable_adaptive_verification
+                and self.draft_logits is None
+            ):
+                self.draft_token_confidence_probs[:num_reqs, active_steps:].zero_()
+        else:
+            self._run_draft_step(padded_reqs, active_steps)
+        return self.draft_tokens[:num_reqs, :active_steps]
