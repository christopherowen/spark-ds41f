+    class _MinimalSpecStub:
+        def use_dspark(self) -> bool:
+            return False
+
+    assert _num_workspace_lanes(
+        SimpleNamespace(speculative_config=_MinimalSpecStub()), True
+    ) == 1
+
+    # Verify cached mask_embed produces bit-identical backbone output to full embed.
+    torch.manual_seed(11)
+    target_hf, draft_hf = _make_small_hf_configs()
+    vllm_cfg = _make_stub_vllm_config(target_hf, draft_hf)
+    vllm_cfg.additional_config = {}
+    vllm_cfg.optimization_level = 0
+    with set_current_vllm_config(vllm_cfg):
+        draft_lm = DFly2DeepseekV4ForCausalLM(vllm_config=vllm_cfg)
+        with torch.no_grad():
+            for pname, p in draft_lm.named_parameters():
+                if p.dtype.is_floating_point:
+                    p.normal_(0.0, 0.02)
+                else:
+                    p.fill_(127 if "scale" in pname else 0)
+        embed = nn.Embedding(target_hf.vocab_size, target_hf.hidden_size, dtype=torch.bfloat16)
+        draft_lm.model.embed_tokens = embed
+        swa_kv = torch.zeros((4, 16 * SWA_RECORD_BYTES), dtype=torch.uint8)
+        main_kv = torch.zeros((4, 16 * IDX_RECORD_BYTES), dtype=torch.uint8)
+        layer_stub = SimpleNamespace(kv_cache=swa_kv, block_size=16, _main_page=16)
+        main_stub = SimpleNamespace(kv_cache=main_kv, block_size=16, _main_page=16)
+        for lyr in draft_lm.model.layers:
+            lyr.attn.bind_target_layers(layer_stub, main_stub)
+        draft_lm.model.hidden_correction.attention.bind_target_layers(layer_stub, main_stub)
+        draft_lm.process_weights_after_loading()
+
+        bsz = 2
+        blk = draft_lm.dfly_cfg.block_size
+        mask_id = draft_lm.dfly_cfg.mask_token_id
+        block_ids = torch.full((bsz, blk), mask_id, dtype=torch.int32)
+        block_ids[:, 0] = torch.tensor([5, 9], dtype=torch.int32)
+        block_ids = block_ids.reshape(-1)
+        pos = torch.arange(blk, dtype=torch.int64).unsqueeze(0).repeat(bsz, 1).reshape(-1)
+        prev_h = torch.randn((bsz, target_hf.hidden_size), dtype=torch.bfloat16)
+        mtp_valid = torch.ones(bsz, dtype=torch.float32)
+        swa_idx = torch.full((3, bsz, 16), -1, dtype=torch.int32)
+        swa_len = torch.zeros((3, bsz), dtype=torch.int32)
+        topk_idx = torch.full((3, bsz, 8), -1, dtype=torch.int32)
+        top_len = torch.zeros(bsz, dtype=torch.int32)
+        pt = torch.zeros((bsz, 4), dtype=torch.int32)
+
+        h_uncached, e_uncached = draft_lm.model.forward_backbone(
+            block_ids, pos, prev_h, mtp_valid, swa_idx, swa_len, topk_idx, top_len, pt
+        )
+        draft_lm.model.cache_mask_embed()
+        h_cached, e_cached = draft_lm.model.forward_backbone(
+            block_ids, pos, prev_h, mtp_valid, swa_idx, swa_len, topk_idx, top_len, pt
+        )
+        assert torch.equal(h_uncached, h_cached)
+        assert torch.equal(e_uncached, e_cached)
+
+    # Verify propose() uses CUDA graph even when active_steps < num_speculative_steps.
+    spec = DFly2Speculator(vllm_cfg, torch.device("cpu"))
+    spec.draft_token_confidence_probs.fill_(0.8)
+    ran_graph = []
+
+    from vllm.forward_context import BatchDescriptor
+    fake_desc = BatchDescriptor(num_tokens=2 * spec.block_size, num_reqs=2)
+
+    class _FakeCGM:
+        def __init__(self):
+            self.graphs = {fake_desc: True}
+
+        def dispatch(self, *args):
+            return fake_desc
+
+        def run_fullgraph(self, desc):
+            ran_graph.append(desc)
+
+    spec.cudagraph_manager = _FakeCGM()
+    spec._prepare_step_inputs = lambda *args, **kwargs: None
+    spec.draft_tokens[:2, :3] = torch.tensor([[10, 11, 12], [20, 21, 22]])
+    out = spec.propose(
+        input_batch=SimpleNamespace(num_reqs=2),
+        attn_metadata={},
+        slot_mappings={},
+        last_hidden_states=torch.zeros((2, target_hf.hidden_size)),
+        aux_hidden_states=None,
+        num_sampled=torch.ones(2, dtype=torch.int32),
+        num_rejected=torch.zeros(2, dtype=torch.int32),
+        last_sampled=torch.zeros(2, dtype=torch.int64),
+        next_prefill_tokens=torch.zeros(2, dtype=torch.int32),
+        temperature=torch.zeros(2),
+        seeds=torch.zeros(2, dtype=torch.int64),
+        num_speculative_tokens=3,
+    )
+    assert ran_graph == [fake_desc]
+    assert out.shape == (2, 3)
+    assert torch.all(spec.draft_token_confidence_probs[:2, 3:] == 0.0)
