+        return True
+
+    def __init__(self, vllm_config: VllmConfig, device: torch.device) -> None:
+        super().__init__(vllm_config, device)
+        dfly_raw = (
+            getattr(self.draft_model_config.hf_config, "dfly_config", None) or {}
+        )
+        self.block_size = int(
