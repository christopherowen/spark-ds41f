+def _angelspec_reference_forward(
+    draft_lm: DFly2DeepseekV4ForCausalLM,
+    anchor_tokens: torch.Tensor,
+    prev_hidden: torch.Tensor,
+    mtp_valid: torch.Tensor,
+    anchor_positions: torch.Tensor,
+    swa_caches: list[torch.Tensor],
+    swa_indices: torch.Tensor,
+    swa_lengths: torch.Tensor,
+    swa_page_size: int,
+    main_cache: torch.Tensor,
+    topk_indices: torch.Tensor,
+    top_lengths: torch.Tensor,
+    main_page_table: torch.Tensor,
+    main_page_size: int,
+    mask_token_id: int,
+) -> torch.Tensor:
+    """Independent op-for-op AngelSpec DFly2 reference producing ``[B, 5]`` greedy ids."""
+    cfg = draft_lm.config
+    dfly = draft_lm.dfly_cfg
+    bsz = anchor_tokens.shape[0]
+    B_sz = dfly.block_size
+    n_spec = B_sz - 1
+    eps = cfg.rms_norm_eps
+
+    def rms(x: torch.Tensor, w: torch.Tensor) -> torch.Tensor:
+        xf = x.float()
+        return (w.float() * xf * torch.rsqrt(xf.pow(2).mean(-1, keepdim=True) + eps)).to(
+            x.dtype
+        )
+
+    embed_w = draft_lm.model.embed_tokens.weight[: cfg.vocab_size]
+    head_w = draft_lm.lm_head.weight[: cfg.vocab_size]
+
+    blk_ids = torch.full((bsz, B_sz), mask_token_id, dtype=torch.int64)
+    blk_ids[:, 0] = anchor_tokens
+    blk_pos = anchor_positions.unsqueeze(1) + torch.arange(B_sz).unsqueeze(0)
+    raw_embeds = F.embedding(blk_ids, embed_w)
+    raw_anchor = raw_embeds[:, 0].clone()
+
+    mtp = draft_lm.model.mtp_fusion
+    assert mtp is not None
+    fused = F.linear(
+        torch.cat([rms(raw_anchor, mtp.enorm.weight), rms(prev_hidden, mtp.hnorm.weight)], dim=-1),
+        mtp.eh_proj.weight[: cfg.hidden_size],
+    )
+    h = raw_embeds.clone()
+    h[:, 0] = h[:, 0] + (
+        mtp.gate.float() * fused.float() * mtp_valid.view(bsz, 1).float()
+    ).to(h.dtype)
+
+    residual = h.reshape(bsz * B_sz, 1, cfg.hidden_size).expand(
+        -1, cfg.hc_mult, -1
+    ).contiguous()
+    pre_mix = post_mix = res_mix = None
+    last_out = None
+    for li, layer in enumerate(draft_lm.model.layers):
+        if last_out is not None:
+            mixed = torch.einsum("...jk,...jd->...kd", res_mix, residual.float())
+            residual = (post_mix.unsqueeze(-1) * last_out.float().unsqueeze(-2) + mixed).to(
+                h.dtype
+            )
+        xf = residual.flatten(-2).float()
+        mixes = F.linear(xf, layer.hc_attn_fn.float()) * torch.rsqrt(
+            xf.pow(2).mean(-1, keepdim=True) + eps
+        )
+        sf, bf = layer.hc_attn_scale.float(), layer.hc_attn_base.float()
+        m = cfg.hc_mult
+        attn_pre = torch.sigmoid(mixes[..., :m] * sf[0] + bf[:m]) + cfg.hc_eps
+        post_mix = 2.0 * torch.sigmoid(mixes[..., m : 2 * m] * sf[1] + bf[m : 2 * m])
+        comb = (mixes[..., 2 * m :] * sf[2] + bf[2 * m :]).unflatten(-1, (m, m))
+        comb = comb.softmax(dim=-1) + cfg.hc_eps
+        comb = comb / (comb.sum(dim=-2, keepdim=True) + cfg.hc_eps)
+        for _ in range(cfg.hc_sinkhorn_iters - 1):
+            comb = comb / (comb.sum(dim=-1, keepdim=True) + cfg.hc_eps)
+            comb = comb / (comb.sum(dim=-2, keepdim=True) + cfg.hc_eps)
+        res_mix = comb
+
+        use_pre = attn_pre if pre_mix is None else pre_mix
+        x_in = rms(
+            torch.einsum("...k,...kd->...d", use_pre, residual.float()).to(h.dtype),
+            layer.attn_norm.weight,
+        )
+        attn = layer.attn
+        w_qkv = attn.fused_wqa_wkv.weight[: cfg.q_lora_rank + 512]
+        wq_a_w = w_qkv[: cfg.q_lora_rank]
+        wkv_w = w_qkv[cfg.q_lora_rank :]
+        cos_sin = attn.rotary_emb.cos_sin_cache
+        pos_flat = blk_pos.reshape(-1)
+        q = F.linear(rms(F.linear(x_in, wq_a_w), attn.q_norm.weight), attn.wq_b.weight)
+        q = q.view(bsz * B_sz, cfg.num_attention_heads, 512)
+        q = tl_dfly2.apply_rope_cpu(q, pos_flat, cos_sin, inverse=False)
+        k_blk = tl_dfly2.apply_rope_cpu(
+            rms(F.linear(x_in, wkv_w), attn.kv_norm.weight),
+            pos_flat,
+            cos_sin,
+            inverse=False,
+        ).view(bsz, B_sz, 512)
+
+        attn_raw = tl_dfly2.dfly2_attend_backbone_cpu(
+            q,
+            k_blk,
+            swa_caches[li],
+            swa_indices[li],
+            swa_lengths[li],
+            swa_page_size,
+            main_cache,
+            topk_indices[li],
+            top_lengths,
+            main_page_table,
+            main_page_size,
+            attn.attn_sink,
+            pos_flat,
+            cos_sin,
+        )
+        wo_w = attn.wo_a.weight.view(cfg.o_groups, cfg.o_lora_rank, -1)
+        wo_mid = torch.einsum(
+            "rgd,god->rgo", attn_raw.view(bsz * B_sz, cfg.o_groups, -1), wo_w
+        ).reshape(bsz * B_sz, -1)
+        attn_out = F.linear(wo_mid, attn.wo_b.weight)
+
+        mixed = torch.einsum("...jk,...jd->...kd", res_mix, residual.float())
+        residual = (post_mix.unsqueeze(-1) * attn_out.float().unsqueeze(-2) + mixed).to(
+            h.dtype
+        )
+        xf = residual.flatten(-2).float()
+        mixes = F.linear(xf, layer.hc_ffn_fn.float()) * torch.rsqrt(
+            xf.pow(2).mean(-1, keepdim=True) + eps
+        )
+        sf, bf = layer.hc_ffn_scale.float(), layer.hc_ffn_base.float()
+        ffn_pre = torch.sigmoid(mixes[..., :m] * sf[0] + bf[:m]) + cfg.hc_eps
+        post_mix = 2.0 * torch.sigmoid(mixes[..., m : 2 * m] * sf[1] + bf[m : 2 * m])
+        comb = (mixes[..., 2 * m :] * sf[2] + bf[2 * m :]).unflatten(-1, (m, m))
+        comb = comb.softmax(dim=-1) + cfg.hc_eps
+        comb = comb / (comb.sum(dim=-2, keepdim=True) + cfg.hc_eps)
+        for _ in range(cfg.hc_sinkhorn_iters - 1):
+            comb = comb / (comb.sum(dim=-1, keepdim=True) + cfg.hc_eps)
+            comb = comb / (comb.sum(dim=-2, keepdim=True) + cfg.hc_eps)
+        res_mix = comb
+
+        x_ffn = rms(
+            torch.einsum("...k,...kd->...d", attn_pre, residual.float()).to(h.dtype),
+            layer.ffn_norm.weight,
+        )
+        from vllm.models.deepseek_v4_1.nvidia.dfly2 import _moe_forward_cpu
+
+        last_out = _moe_forward_cpu(layer.ffn, x_ffn, None)
+        pre_mix = ffn_pre
+
+    mixed = torch.einsum("...jk,...jd->...kd", res_mix, residual.float())
+    residual = (post_mix.unsqueeze(-1) * last_out.float().unsqueeze(-2) + mixed).to(
+        h.dtype
+    )
+    collapsed = torch.einsum("...k,...kd->...d", pre_mix, residual.float()).to(h.dtype)
+    backbone_h = rms(collapsed, draft_lm.model.final_norm.weight).view(
+        bsz, B_sz, cfg.hidden_size
+    )
+
+    # Full AngelSpec 6-slot sequential teacher/self-forced correction reference
+    hc = draft_lm.model.hidden_correction
+    assert hc is not None and hc.attention is not None
+    ac = hc.attention
+    qkvg_w = ac.fused_qkv_gate.weight
+    q_in_w = qkvg_w[: cfg.q_lora_rank]
+    kv_in_w = qkvg_w[cfg.q_lora_rank : cfg.q_lora_rank + 512]
+    gate_w = qkvg_w[
+        cfg.q_lora_rank + 512 : cfg.q_lora_rank + 512 + cfg.num_attention_heads
+    ]
+    gu_w = hc.gate_up_proj.weight
+    inter = hc.intermediate_size
+    gate_proj_w = gu_w[:inter]
+    up_proj_w = gu_w[hc.padded_intermediate : hc.padded_intermediate + inter]
+    down_proj_w = hc.down_proj.weight[:, :inter]
+
+    # Slot 0 block key uses prev_token = anchor
+    z0 = torch.cat(
+        [rms(backbone_h[:, 0], hc.hidden_norm.weight), rms(raw_anchor, hc.embed_norm.weight)],
+        dim=-1,
+    )
+    k_list = [
+        tl_dfly2.apply_rope_cpu(
+            rms(F.linear(z0, kv_in_w), ac.kv_norm.weight),
+            blk_pos[:, 0],
+            ac.rotary_emb.cos_sin_cache,
+            inverse=False,
+        )
+    ]
+    sampled_tokens = []
+    prev_tok = anchor_tokens
+    for j in range(1, B_sz):
+        e_prev = F.embedding(prev_tok, embed_w)
+        zj = torch.cat(
+            [rms(backbone_h[:, j], hc.hidden_norm.weight), rms(e_prev, hc.embed_norm.weight)],
+            dim=-1,
+        )
+        mlp_delta = F.linear(
+            (F.silu(F.linear(zj, gate_proj_w).float()) * F.linear(zj, up_proj_w).float()).to(
+                zj.dtype
+            ),
+            down_proj_w,
+        )
+        qj = F.linear(rms(F.linear(zj, q_in_w), ac.q_norm.weight), ac.wq_b.weight).view(
+            bsz, cfg.num_attention_heads, 512
+        )
+        qj = tl_dfly2.apply_rope_cpu(
+            qj, blk_pos[:, j], ac.rotary_emb.cos_sin_cache, inverse=False
+        )
+        kj = tl_dfly2.apply_rope_cpu(
+            rms(F.linear(zj, kv_in_w), ac.kv_norm.weight),
+            blk_pos[:, j],
+            ac.rotary_emb.cos_sin_cache,
+            inverse=False,
+        )
+        k_list.append(kj)
+        k_stack = torch.stack(k_list, dim=1)
+        gate_logits = F.linear(zj, gate_w)
+        read_j = tl_dfly2.dfly2_attend_correction_cpu(
+            qj,
+            k_stack,
+            swa_caches[2],
+            swa_indices[2],
+            swa_lengths[2],
+            swa_page_size,
+            main_cache,
+            topk_indices[2],
+            top_lengths,
+            main_page_table,
+            main_page_size,
+            ac.attn_sink,
+            ac.block_sink,
+            ac.block_rel_bias,
+            gate_logits,
+            ac.block_gate_bias,
+            blk_pos[:, j],
+            ac.rotary_emb.cos_sin_cache,
+            j,
+        )
+        wo_w = ac.wo_a.weight.view(cfg.o_groups, cfg.o_lora_rank, -1)
+        wo_mid = torch.einsum(
+            "rgd,god->rgo", read_j.view(bsz, cfg.o_groups, -1), wo_w
+        ).reshape(bsz, -1)
+        attn_delta = F.linear(wo_mid, ac.wo_b.weight)
+        h_corr = backbone_h[:, j] + mlp_delta + attn_delta
+        logits = F.linear(h_corr.float(), head_w.float())
+        prev_tok = logits.argmax(dim=-1)
+        sampled_tokens.append(prev_tok)
+    return torch.stack(sampled_tokens, dim=1)
+
