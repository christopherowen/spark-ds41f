+@tilelang.jit(pass_configs={tilelang.PassConfigKey.TL_ENABLE_FAST_MATH: True})
+def dfly2_merge_backbone_kernel(
+    heads: int,
+    block_size: int,
+    segments: int,
+    sm_scale: float = HEAD_DIM**-0.5,
+):
+    """Fold context MLA partials + bidirectional BF16 block latents + inverse RoPE."""
+    rows = T.dynamic("rows")
+    num_reqs = T.dynamic("num_reqs")
+    positions_max = T.dynamic("positions_max")
+    D = HEAD_DIM
+    scale_log2 = sm_scale * LOG2E
+
+    @T.prim_func
+    def merge_backbone(
+        Q: T.Tensor([rows, heads, D], T.bfloat16),
+        Partial: T.Tensor([rows, segments, heads, D], T.float32),
+        PartialStats: T.Tensor([rows, segments, heads, 2], T.float32),
+        K_blk: T.Tensor([num_reqs, block_size, D], T.bfloat16),
+        Sinks: T.Tensor([heads], T.float32),
+        Positions: T.Tensor([rows], T.int64),
+        CosSin: T.Tensor([positions_max, ROPE_DIM], T.float32),
+        Output: T.Tensor([rows, heads, D], T.bfloat16),
+    ):
+        with T.Kernel(heads, rows, threads=128) as (hc, rc):
+            tx = T.get_thread_binding()
+            q_loc = T.alloc_local([4], T.float32)
+            k_loc = T.alloc_local([4], T.float32)
+            o_loc = T.alloc_local([4], T.float32)
+            dot_shared = T.alloc_shared([128], T.float32)
+            O_shared = T.alloc_shared([D], T.bfloat16)
+            cs_shared = T.alloc_shared([ROPE_DIM], T.float32)
+
+            M = T.alloc_var(T.float32)
+            L = T.alloc_var(T.float32)
+            a = T.alloc_var(T.float32)
+            b = T.alloc_var(T.float32)
+            m_new = T.alloc_var(T.float32)
+            s_k = T.alloc_var(T.float32)
+            p_sum = T.alloc_var(T.float32)
+
+            req = rc // block_size
+            pos = Positions[rc]
+            if tx < ROPE_DIM:
+                cs_shared[tx] = CosSin[pos, tx]
+            for v in T.unroll(4):
+                q_loc[v] = T.Cast(T.float32, Q[rc, hc, tx * 4 + v])
+                o_loc[v] = T.float32(0)
+
+            M = T.fmul(Sinks[hc], LOG2E)
+            L = T.float32(1.0)
+            pdl.chain()
+
+            for c in T.unroll(segments):
+                if PartialStats[rc, c, hc, 1] > 0:
+                    m_new = T.max(M, PartialStats[rc, c, hc, 0])
+                    a = T.exp2(M - m_new)
+                    b = T.exp2(PartialStats[rc, c, hc, 0] - m_new)
+                    L = T.fma(PartialStats[rc, c, hc, 1], b, T.fmul(L, a))
+                    M = m_new
+                    for v in T.unroll(4):
+                        o_loc[v] = T.fma(
+                            Partial[rc, c, hc, tx * 4 + v], b, T.fmul(o_loc[v], a)
+                        )
+
+            for k in T.serial(block_size):
+                p_sum = T.float32(0)
+                for v in T.unroll(4):
+                    k_loc[v] = T.Cast(T.float32, K_blk[req, k, tx * 4 + v])
+                    p_sum = T.fma(q_loc[v], k_loc[v], p_sum)
+                dot_shared[tx] = p_sum
+                T.sync_threads()
+                for stride in (64, 32, 16, 8, 4, 2, 1):
+                    if tx < stride:
+                        dot_shared[tx] = dot_shared[tx] + dot_shared[tx + stride]
+                    T.sync_threads()
+                s_k = T.fmul(dot_shared[0], scale_log2)
+                m_new = T.max(M, s_k)
+                a = T.exp2(M - m_new)
+                b = T.exp2(s_k - m_new)
+                L = T.fma(T.float32(1.0), b, T.fmul(L, a))
+                M = m_new
+                for v in T.unroll(4):
+                    o_loc[v] = T.fma(k_loc[v], b, T.fmul(o_loc[v], a))
+                T.sync_threads()
+
+            inv_L = T.float32(1.0) / L
+            for v in T.unroll(4):
+                O_shared[tx * 4 + v] = T.Cast(T.bfloat16, T.fmul(o_loc[v], inv_L))
+            T.sync_threads()
+
+            half = ROPE_DIM // 2
+            if tx < half:
+                first = T.Cast(T.float32, O_shared[NOPE_DIM + 2 * tx])
+                second = T.Cast(T.float32, O_shared[NOPE_DIM + 2 * tx + 1])
+                cosine = cs_shared[tx]
+                sine = cs_shared[half + tx]
+                O_shared[NOPE_DIM + 2 * tx] = T.Cast(
+                    T.bfloat16, T.ieee_fmaf(first, cosine, second * sine)
+                )
+                O_shared[NOPE_DIM + 2 * tx + 1] = T.Cast(
+                    T.bfloat16, T.ieee_fmaf(first, -sine, second * cosine)
+                )
+            T.sync_threads()
+
+            for v in T.vectorized(4):
+                Output[rc, hc, tx * 4 + v] = O_shared[tx * 4 + v]
+
+    return merge_backbone
+
+
+@tilelang.jit(pass_configs={tilelang.PassConfigKey.TL_ENABLE_FAST_MATH: True})
+def dfly2_merge_correction_kernel(
+    heads: int,
+    max_block_slots: int,
+    segments: int,
+    sm_scale: float = HEAD_DIM**-0.5,
+):
+    """Fold context MLA partials + gated causal block attention + inverse RoPE."""
+    num_reqs = T.dynamic("num_reqs")
+    positions_max = T.dynamic("positions_max")
+    D = HEAD_DIM
+
+    @T.prim_func
+    def merge_correction(
+        Q: T.Tensor([num_reqs, heads, D], T.bfloat16),
+        Partial: T.Tensor([num_reqs, segments, heads, D], T.float32),
+        PartialStats: T.Tensor([num_reqs, segments, heads, 2], T.float32),
+        SwaLengths: T.Tensor([num_reqs], T.int32),
+        IdxLengths: T.Tensor([num_reqs], T.int32),
+        K_corr: T.Tensor([num_reqs, max_block_slots, D], T.bfloat16),
+        AttnSink: T.Tensor([heads], T.float32),
+        BlockSink: T.Tensor([heads], T.float32),
+        BlockRelBias: T.Tensor([heads, max_block_slots], T.float32),
+        GateLogits: T.Tensor([num_reqs, heads], T.bfloat16),
+        BlockGateBias: T.Tensor([heads, max_block_slots], T.float32),
+        Positions: T.Tensor([num_reqs], T.int64),
+        CosSin: T.Tensor([positions_max, ROPE_DIM], T.float32),
+        step_idx: T.int32,
+        Output: T.Tensor([num_reqs, heads, D], T.bfloat16),
+    ):
+        with T.Kernel(heads, num_reqs, threads=128) as (hc, rc):
+            tx = T.get_thread_binding()
+            q_loc = T.alloc_local([4], T.float32)
+            k_loc = T.alloc_local([4], T.float32)
+            o_ctx = T.alloc_local([4], T.float32)
+            o_blk = T.alloc_local([4], T.float32)
+            dot_shared = T.alloc_shared([128], T.float32)
+            O_shared = T.alloc_shared([D], T.bfloat16)
+            cs_shared = T.alloc_shared([ROPE_DIM], T.float32)
+
+            M = T.alloc_var(T.float32)
+            L = T.alloc_var(T.float32)
+            a = T.alloc_var(T.float32)
+            b = T.alloc_var(T.float32)
+            m_new = T.alloc_var(T.float32)
+            s_k = T.alloc_var(T.float32)
+            p_sum = T.alloc_var(T.float32)
+
+            pos = Positions[rc]
+            if tx < ROPE_DIM:
+                cs_shared[tx] = CosSin[pos, tx]
+            for v in T.unroll(4):
+                q_loc[v] = T.Cast(T.float32, Q[rc, hc, tx * 4 + v])
+                o_ctx[v] = T.float32(0)
+                o_blk[v] = T.float32(0)
+
+            pdl.chain()
+            alive = (SwaLengths[rc] > 0) | (IdxLengths[rc] > 0)
+            if alive:
+                M = T.fmul(AttnSink[hc], LOG2E)
+                L = T.float32(1.0)
+                for c in T.unroll(segments):
+                    if PartialStats[rc, c, hc, 1] > 0:
+                        m_new = T.max(M, PartialStats[rc, c, hc, 0])
+                        a = T.exp2(M - m_new)
+                        b = T.exp2(PartialStats[rc, c, hc, 0] - m_new)
+                        L = T.fma(PartialStats[rc, c, hc, 1], b, T.fmul(L, a))
+                        M = m_new
+                        for v in T.unroll(4):
+                            o_ctx[v] = T.fma(
+                                Partial[rc, c, hc, tx * 4 + v],
+                                b,
+                                T.fmul(o_ctx[v], a),
+                            )
+                inv_L_ctx = T.float32(1.0) / L
+                for v in T.unroll(4):
+                    o_ctx[v] = T.Cast(
+                        T.float32, T.Cast(T.bfloat16, T.fmul(o_ctx[v], inv_L_ctx))
+                    )
+
+            M = T.fmul(BlockSink[hc], LOG2E)
+            L = T.float32(1.0)
+            for k in T.serial(step_idx + 1):
+                p_sum = T.float32(0)
+                for v in T.unroll(4):
+                    k_loc[v] = T.Cast(T.float32, K_corr[rc, k, tx * 4 + v])
+                    p_sum = T.fma(q_loc[v], k_loc[v], p_sum)
+                dot_shared[tx] = p_sum
+                T.sync_threads()
+                for stride in (64, 32, 16, 8, 4, 2, 1):
+                    if tx < stride:
+                        dot_shared[tx] = dot_shared[tx] + dot_shared[tx + stride]
+                    T.sync_threads()
+                s_k = T.fmul(
+                    T.fma(dot_shared[0], sm_scale, BlockRelBias[hc, step_idx - k]),
+                    LOG2E,
+                )
+                m_new = T.max(M, s_k)
+                a = T.exp2(M - m_new)
+                b = T.exp2(s_k - m_new)
+                L = T.fma(T.float32(1.0), b, T.fmul(L, a))
+                M = m_new
+                for v in T.unroll(4):
+                    o_blk[v] = T.fma(k_loc[v], b, T.fmul(o_blk[v], a))
+                T.sync_threads()
+
+            gate = T.tanh(
+                T.Cast(T.float32, GateLogits[rc, hc]) + BlockGateBias[hc, step_idx]
+            )
+            inv_L_blk = T.float32(1.0) / L
+            scale_blk = T.fmul(inv_L_blk, gate)
+            for v in T.unroll(4):
+                O_shared[tx * 4 + v] = T.Cast(
+                    T.bfloat16, T.fma(o_blk[v], scale_blk, o_ctx[v])
+                )
+            T.sync_threads()
+
+            half = ROPE_DIM // 2
+            if tx < half:
+                first = T.Cast(T.float32, O_shared[NOPE_DIM + 2 * tx])
+                second = T.Cast(T.float32, O_shared[NOPE_DIM + 2 * tx + 1])
+                cosine = cs_shared[tx]
+                sine = cs_shared[half + tx]
+                O_shared[NOPE_DIM + 2 * tx] = T.Cast(
+                    T.bfloat16, T.ieee_fmaf(first, cosine, second * sine)
+                )
+                O_shared[NOPE_DIM + 2 * tx + 1] = T.Cast(
+                    T.bfloat16, T.ieee_fmaf(first, -sine, second * cosine)
+                )
+            T.sync_threads()
+
+            for v in T.vectorized(4):
+                Output[rc, hc, tx * 4 + v] = O_shared[tx * 4 + v]
+
+    return merge_correction
+
+
+@tilelang.jit
+def dfly2_swiglu_kernel(n: int, threads: int = 128):
+    """Unclamped FP32-product SwiGLU ``bf16(silu(G) * U)`` for ``[M, 2n]`` BF16."""
+    vec = 8
+    assert n % vec == 0
+    M = T.dynamic("M")
+    per_block = threads * vec
+
+    @T.prim_func
+    def dfly2_swiglu(
+        X: T.Tensor((M, 2 * n), T.bfloat16),
+        Y: T.Tensor((M, n), T.bfloat16),
+    ):
+        with T.Kernel(T.ceildiv(n, per_block), M, threads=threads) as (bx, by):
+            pdl.chain()
+            col = (bx * threads + T.get_thread_binding()) * vec
+            gate = T.alloc_local((vec,), T.bfloat16)
+            up = T.alloc_local((vec,), T.bfloat16)
+            out = T.alloc_local((vec,), T.bfloat16)
+            if col < n:
+                for v in T.vectorized(vec):
+                    gate[v] = X[by, col + v]
+                for v in T.vectorized(vec):
+                    up[v] = X[by, n + col + v]
+                for v in T.unroll(vec):
+                    g = T.alloc_var(T.float32, init=T.Cast(T.float32, gate[v]))
+                    u = T.alloc_var(T.float32, init=T.Cast(T.float32, up[v]))
+                    out[v] = T.Cast(T.bfloat16, g / (T.float32(1.0) + T.exp(-g)) * u)
+                for v in T.vectorized(vec):
+                    Y[by, col + v] = out[v]
+
+    return dfly2_swiglu
+
+
+def swiglu_call(n: int, threads: int = 128):
+    return prepare.call(dfly2_swiglu_kernel, n, threads)
+
+
+@tilelang.jit(pass_configs={tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True})
+def dfly2_prepare_step_kernel(
+    num_layers: int,
+    block_size: int,
+    n_spec: int,
+    hidden_size: int,
+    window_size: int,
+    index_topk: int,
+    swa_page_size: int,
+    main_page_size: int,
+    idx_dtype: str,
+):
+    """Populate DFly2 fixed-address step inputs and context tables in one launch."""
+    padded_reqs = T.dynamic("padded_reqs")
+    max_reqs = T.dynamic("max_reqs")
+    padded_rows = T.dynamic("padded_rows")
+    target_tokens = T.dynamic("target_tokens")
+    hidden_tokens = T.dynamic("hidden_tokens")
+    dec_tokens = T.dynamic("dec_tokens")
+    starts_len = T.dynamic("starts_len")
+    dec_starts_len = T.dynamic("dec_starts_len")
+    idx_len = T.dynamic("idx_len")
+    last_len = T.dynamic("last_len")
+    next_len = T.dynamic("next_len")
+    sampled_len = T.dynamic("sampled_len")
+    rejected_len = T.dynamic("rejected_len")
+    replay_len = T.dynamic("replay_len")
+    swa_table_rows = T.dynamic("swa_table_rows")
+    swa_table_cols = T.dynamic("swa_table_cols")
+    swa_table_stride = T.dynamic("swa_table_stride")
+    main_table_rows = T.dynamic("main_table_rows")
+    main_table_cols = T.dynamic("main_table_cols")
+    main_table_stride = T.dynamic("main_table_stride")
+    main_out_cols = T.dynamic("main_out_cols")
+
+    threads = 256
+
+    @T.prim_func
+    def prepare_step(
+        out_block_input_ids: T.Tensor([padded_rows], T.int32),
+        out_block_positions: T.Tensor([padded_rows], T.int64),
+        out_anchor_tokens: T.Tensor([padded_reqs], T.int64),
+        out_anchor_positions: T.Tensor([padded_reqs], T.int64),
+        out_mtp_valid: T.Tensor([padded_reqs], T.float32),
+        out_prev_hidden: T.Tensor([padded_reqs, hidden_size], T.bfloat16),
+        out_req_idx_mapping: T.Tensor([padded_reqs], T.int32),
+        out_sample_idx_mapping: T.Tensor([padded_reqs, n_spec], T.int32),
+        out_swa_indices: T.Tensor([num_layers, max_reqs, window_size], T.int32),
+        out_swa_lengths: T.Tensor([num_layers, max_reqs], T.int32),
+        out_topk_indices: T.Tensor([num_layers, max_reqs, index_topk], T.int32),
+        out_top_lengths: T.Tensor([padded_reqs], T.int32),
+        out_main_page_table: T.Tensor([padded_reqs, main_out_cols], T.int32),
+        target_positions: T.Tensor([target_tokens], T.int64),
+        target_query_start_loc: T.Tensor([starts_len], T.int32),
+        dec_query_start_loc: T.Tensor([dec_starts_len], T.int32),
+        idx_mapping: T.Tensor([idx_len], idx_dtype),
+        last_sampled: T.Tensor([last_len], T.int64),
+        next_prefill_tokens: T.Tensor([next_len], T.int32),
+        num_sampled: T.Tensor([sampled_len], T.int32),
+        num_rejected: T.Tensor([rejected_len], T.int32),
+        last_hidden_states: T.Tensor([hidden_tokens, hidden_size], T.bfloat16),
+        replay_start: T.Tensor([replay_len], T.int64),
+        swa_table_0: T.StridedTensor(
+            [swa_table_rows, swa_table_cols], [swa_table_stride, 1], T.int32
+        ),
+        swa_table_1: T.StridedTensor(
+            [swa_table_rows, swa_table_cols], [swa_table_stride, 1], T.int32
+        ),
+        swa_table_2: T.StridedTensor(
+            [swa_table_rows, swa_table_cols], [swa_table_stride, 1], T.int32
+        ),
+        main_block_table: T.StridedTensor(
+            [main_table_rows, main_table_cols], [main_table_stride, 1], T.int32
+        ),
+        src_topk_0: T.Tensor([dec_tokens, index_topk], T.int32),
+        src_topk_1: T.Tensor([dec_tokens, index_topk], T.int32),
+        src_topk_2: T.Tensor([dec_tokens, index_topk], T.int32),
+        mask_token_id: T.int32,
+        max_model_len: T.int32,
+        num_reqs: T.int32,
+        has_replay: T.int32,
+    ):
+        with T.Kernel(padded_reqs, num_layers, threads=threads) as (r, li):
+            tx = T.get_thread_binding()
+            if r < num_reqs:
+                req = T.Cast(T.int64, idx_mapping[r])
+                q_start = target_query_start_loc[r]
+                q_end = target_query_start_loc[r + 1]
+                d_start = dec_query_start_loc[r]
+                d_end = dec_query_start_loc[r + 1]
+                rejected = num_rejected[r]
+                sampled = num_sampled[r]
+                valid_end = q_end - rejected
+                num_valid = valid_end - q_start
+                orig_prev = T.max(valid_end - 1, q_start)
+                dec_prev = T.max(d_end - (q_end - orig_prev), d_start)
+                first_pos = target_positions[q_start]
+                prev_pos_raw = target_positions[orig_prev]
+                last_valid = T.if_then_else(num_valid > 0, prev_pos_raw, first_pos - 1)
+                anchor_pos = T.max(last_valid + 1, T.int64(0))
+                anchor_tok = T.if_then_else(
+                    sampled > 0,
+                    last_sampled[req],
+                    T.Cast(T.int64, next_prefill_tokens[req]),
+                )
+
+                if li == 0:
+                    if tx == 0:
+                        out_anchor_tokens[r] = anchor_tok
+                        out_anchor_positions[r] = anchor_pos
+                        out_mtp_valid[r] = T.if_then_else(
+                            (num_valid > 0) & (anchor_pos > 0),
+                            T.float32(1.0),
+                            T.float32(0.0),
+                        )
+                        out_req_idx_mapping[r] = T.Cast(T.int32, req)
+                        out_top_lengths[r] = T.Cast(
+                            T.int32, T.min(anchor_pos, T.Cast(T.int64, max_model_len))
+                        )
+                    if tx < n_spec:
+                        out_sample_idx_mapping[r, tx] = T.Cast(T.int32, req)
+                    if tx < block_size:
+                        out_block_input_ids[r * block_size + tx] = T.if_then_else(
+                            tx == 0, T.Cast(T.int32, anchor_tok), mask_token_id
+                        )
+                        out_block_positions[r * block_size + tx] = T.min(
+                            anchor_pos + T.Cast(T.int64, tx),
+                            T.Cast(T.int64, max_model_len - 1),
+                        )
+                    for it in T.serial(tilelang.cdiv(hidden_size, threads)):
+                        col = it * threads + tx
+                        if col < hidden_size:
+                            out_prev_hidden[r, col] = last_hidden_states[orig_prev, col]
+                    active_pages = T.min(
+                        T.Cast(
+                            T.int32,
+                            (anchor_pos + T.int64(main_page_size - 1))
+                            // T.int64(main_page_size),
+                        )
+                        + T.int32(1),
+                        T.min(main_table_cols, main_out_cols),
+                    )
+                    for it in T.serial((active_pages + threads - 1) // threads):
+                        col = it * threads + tx
+                        if col < active_pages:
+                            out_main_page_table[r, col] = main_block_table[r, col]
+
+                rep_floor = T.if_then_else(
+                    has_replay != 0, replay_start[r], T.int64(0)
+                )
+                swa_start = T.max(
+                    T.max(anchor_pos - T.Cast(T.int64, window_size), T.int64(0)),
+                    rep_floor,
+                )
+                swa_len = T.Cast(
+                    T.int32,
+                    T.min(
+                        T.max(anchor_pos - swa_start, T.int64(0)),
+                        T.Cast(T.int64, window_size),
+                    ),
+                )
+                if tx == 0:
+                    out_swa_lengths[li, r] = swa_len
+                for it in T.serial(tilelang.cdiv(window_size, threads)):
+                    col = it * threads + tx
+                    if col < window_size:
+                        logical = swa_start + T.Cast(T.int64, col)
+                        pcol = T.Cast(T.int32, logical // swa_page_size)
+                        inside = (col < swa_len) & (pcol < swa_table_cols)
+                        pcol_safe = T.min(T.max(pcol, 0), swa_table_cols - 1)
+                        page_id = T.if_then_else(
+                            li == 0,
+                            swa_table_0[r, pcol_safe],
+                            T.if_then_else(
+                                li == 1,
+                                swa_table_1[r, pcol_safe],
+                                swa_table_2[r, pcol_safe],
+                            ),
+                        )
+                        phys = page_id * swa_page_size + T.Cast(
+                            T.int32, logical % swa_page_size
+                        )
+                        out_swa_indices[li, r, col] = T.if_then_else(
+                            inside & (page_id > 0), phys, T.int32(-1)
+                        )
+
+                dec_row_safe = T.min(T.max(dec_prev, 0), dec_tokens - 1)
+                for it in T.serial(tilelang.cdiv(index_topk, threads)):
+                    k = it * threads + tx
+                    if k < index_topk:
+                        raw_idx = T.if_then_else(
+                            li == 0,
+                            src_topk_0[dec_row_safe, k],
+                            T.if_then_else(
+                                li == 1,
+                                src_topk_1[dec_row_safe, k],
+                                src_topk_2[dec_row_safe, k],
+                            ),
+                        )
+                        valid_idx = (
+                            (d_end > d_start)
+                            & (anchor_pos > 0)
+                            & (raw_idx >= 0)
+                            & (T.Cast(T.int64, raw_idx) < anchor_pos)
+                        )
+                        out_topk_indices[li, r, k] = T.if_then_else(
+                            valid_idx, raw_idx, T.int32(-1)
+                        )
+            else:
+                if li == 0:
+                    if tx == 0:
+                        out_anchor_tokens[r] = T.int64(0)
+                        out_anchor_positions[r] = T.int64(0)
+                        out_mtp_valid[r] = T.float32(0.0)
+                        out_req_idx_mapping[r] = T.int32(-1)
+                        out_top_lengths[r] = T.int32(0)
+                    if tx < n_spec:
+                        out_sample_idx_mapping[r, tx] = T.int32(-1)
+                    if tx < block_size:
+                        out_block_input_ids[r * block_size + tx] = T.int32(0)
+                        out_block_positions[r * block_size + tx] = T.int64(0)
+                    for it in T.serial(tilelang.cdiv(hidden_size, threads)):
+                        col = it * threads + tx
+                        if col < hidden_size:
+                            out_prev_hidden[r, col] = T.bfloat16(0)
+                    # Padding requests have top_lengths[r] == 0 so main page table is unread.
+                if tx == 0:
+                    out_swa_lengths[li, r] = T.int32(0)
+                for it in T.serial(tilelang.cdiv(window_size, threads)):
+                    col = it * threads + tx
+                    if col < window_size:
+                        out_swa_indices[li, r, col] = T.int32(-1)
+                for it in T.serial(tilelang.cdiv(index_topk, threads)):
+                    k = it * threads + tx
+                    if k < index_topk:
+                        out_topk_indices[li, r, k] = T.int32(-1)
+
+    return prepare_step
+
+
+class DFly2AttentionPlan:
+    """Compiled TileLang plan for DFly2 context + intra-block MLA."""
+
+    def __init__(
+        self,
+        heads: int,
+        swa_width: int,
+        idx_width: int,
+        idx_page_size: int,
+        *,
+        swa_page_size: int,
+        max_rows: int,
+        mode: str,
+        block_size: int = 6,
+        max_block_slots: int = 16,
+        sm_scale: float = HEAD_DIM**-0.5,
+    ) -> None:
+        self.heads = heads
+        self.swa_width = swa_width
+        self.idx_width = idx_width
+        self.idx_page_size = idx_page_size
+        self.swa_page_size = swa_page_size
+        self.swa_bytes = swa_page_size * SWA_RECORD_BYTES
+        self.idx_bytes = idx_page_size * IDX_RECORD_BYTES
+        self.max_rows = max_rows
+        self.mode = mode
+        self.block_size = block_size
+        self.max_block_slots = max_block_slots
+        self.sm_scale = sm_scale
+
+        seg_call, merge_call, self.segments = self.calls_tuple(
+            heads,
+            swa_width,
+            idx_width,
+            idx_page_size,
+            swa_page_size=swa_page_size,
+            mode=mode,
+            block_size=block_size,
+            max_block_slots=max_block_slots,
+            sm_scale=sm_scale,
+        )
+        self.seg_kernel = prepare.launch(seg_call)
+        self.merge_kernel = prepare.launch(merge_call)
+
+    @staticmethod
+    def calls_tuple(
+        heads: int,
+        swa_width: int,
+        idx_width: int,
+        idx_page_size: int,
+        *,
+        swa_page_size: int,
+        mode: str,
+        block_size: int = 6,
+        max_block_slots: int = 16,
+        sm_scale: float = HEAD_DIM**-0.5,
+    ):
+        assert mode in ("backbone", "correction")
+        block_I = 32
+        block_H = min(16 if mode == "correction" else 32, tilelang.cdiv(heads, 16) * 16)
+        threads = min(256, 32 * min(8, (block_H // 16) * (block_I // 8)))
+        chunks = tilelang.cdiv(swa_width, block_I) + tilelang.cdiv(idx_width, block_I)
+        segments = tilelang.cdiv(chunks, SEGMENT_CHUNKS)
+        row_stride_div = block_size if mode == "backbone" else 1
+
+        seg_call = prepare.call(
+            sparse_mla_fwd_v41,
+            heads,
+            swa_width,
+            idx_width,
+            idx_page_size,
+            "decode",
+            swa_page_size=swa_page_size,
+            sm_scale=sm_scale,
+            block_H=block_H,
+            block_I=block_I,
+            threads=threads,
+            segment_chunks=SEGMENT_CHUNKS,
+            segments_only=True,
+            row_stride_div=row_stride_div,
+        )
+        if mode == "backbone":
+            merge_call = prepare.call(
+                dfly2_merge_backbone_kernel,
+                heads,
+                block_size,
+                segments,
+                sm_scale=sm_scale,
+            )
+        else:
+            merge_call = prepare.call(
+                dfly2_merge_correction_kernel,
+                heads,
+                max_block_slots,
+                segments,
+                sm_scale=sm_scale,
+            )
+        return seg_call, merge_call, segments
+
+    @classmethod
+    def calls(cls, *args, **kwargs) -> list:
+        seg_call, merge_call, _ = cls.calls_tuple(*args, **kwargs)
+        return [seg_call, merge_call]
+
+    def scratch_specs(self, rows: int):
+        return (
+            ((rows, self.segments, self.heads, HEAD_DIM), torch.float32),
+            ((rows, self.segments, self.heads, 2), torch.float32),
+        )
+
+    def run_backbone(
+        self,
+        q: torch.Tensor,
+        k_blk: torch.Tensor,
+        swa_cache: torch.Tensor,
+        swa_indices: torch.Tensor,
+        swa_lengths: torch.Tensor,
+        idx_cache: torch.Tensor,
+        idx_indices: torch.Tensor,
+        idx_lengths: torch.Tensor,
+        idx_page_table: torch.Tensor,
+        sinks: torch.Tensor,
+        positions: torch.Tensor,
+        cos_sin: torch.Tensor,
+        out: torch.Tensor,
+        scratch: tuple[torch.Tensor, torch.Tensor],
+    ) -> None:
+        partial, partial_stats = scratch
+        self.seg_kernel(
+            q,
+            swa_cache[:, : self.swa_bytes],
+            swa_indices,
+            swa_lengths,
+            idx_cache[:, : self.idx_bytes],
+            idx_indices,
+            idx_lengths,
+            idx_page_table,
+            partial,
+            partial_stats,
+        )
+        self.merge_kernel(
+            q,
+            partial,
+            partial_stats,
+            k_blk,
+            sinks,
+            positions,
+            cos_sin,
+            out,
+        )
+
+    def run_correction(
+        self,
+        q: torch.Tensor,
+        k_corr: torch.Tensor,
+        swa_cache: torch.Tensor,
+        swa_indices: torch.Tensor,
+        swa_lengths: torch.Tensor,
+        idx_cache: torch.Tensor,
+        idx_indices: torch.Tensor,
+        idx_lengths: torch.Tensor,
+        idx_page_table: torch.Tensor,
+        attn_sink: torch.Tensor,
+        block_sink: torch.Tensor,
+        block_rel_bias: torch.Tensor,
+        gate_logits: torch.Tensor,
+        block_gate_bias: torch.Tensor,
+        positions: torch.Tensor,
+        cos_sin: torch.Tensor,
+        step_idx: int,
+        out: torch.Tensor,
+        scratch: tuple[torch.Tensor, torch.Tensor],
+    ) -> None:
+        partial, partial_stats = scratch
+        self.seg_kernel(
+            q,
+            swa_cache[:, : self.swa_bytes],
+            swa_indices,
+            swa_lengths,
+            idx_cache[:, : self.idx_bytes],
+            idx_indices,
+            idx_lengths,
+            idx_page_table,
+            partial,
+            partial_stats,
+        )
+        self.merge_kernel(
+            q,
+            partial,
+            partial_stats,
+            swa_lengths,
+            idx_lengths,
+            k_corr,
+            attn_sink,
+            block_sink,
+            block_rel_bias,
+            gate_logits,
+            block_gate_bias,
+            positions,
+            cos_sin,
+            int(step_idx),
+            out,
+        )
+
+
+def prepare_step_call(
+    num_layers: int,
+    block_size: int,
+    n_spec: int,
+    hidden_size: int,
+    window_size: int,
+    index_topk: int,
+    swa_page_size: int,
+    main_page_size: int = 256,
+    idx_dtype: str = "int64",
+):
+    return prepare.call(
+        dfly2_prepare_step_kernel,
+        num_layers,
+        block_size,
+        n_spec,
+        hidden_size,
+        window_size,
+        index_topk,
+        swa_page_size,
+        main_page_size,
+        idx_dtype,
+    )
+
+
+# ---------------------------------------------------------------------------
+# Pure-PyTorch CPU / Reference Helpers (for CPU unit tests & parity oracles)
+# ---------------------------------------------------------------------------
+
+
+def dequant_swa_records_cpu(records: torch.Tensor) -> torch.Tensor:
+    """Dequantize ``[N, 528]`` uint8 SWA records (512 E4M3 + 16 UE8M0) to BF16."""
+    fp8 = records[:, :HEAD_DIM].contiguous().view(torch.float8_e4m3fn).to(torch.float32)
+    exp = records[:, HEAD_DIM : HEAD_DIM + HEAD_DIM // SWA_GROUP].to(torch.int32)
+    scales = torch.ldexp(torch.ones_like(exp, dtype=torch.float32), exp - 127)
+    vals = fp8.view(-1, HEAD_DIM // SWA_GROUP, SWA_GROUP) * scales.unsqueeze(-1)
+    return vals.reshape(-1, HEAD_DIM).to(torch.bfloat16)
+
+
+def dequant_idx_records_cpu(records: torch.Tensor) -> torch.Tensor:
+    """Dequantize ``[N, 288]`` uint8 indexed records (256 packed E2M1 + 32 E4M3) to BF16."""
+    lut = torch.tensor(_FP4_LUT, dtype=torch.float32, device=records.device)
+    packed = records[:, : HEAD_DIM // 2].to(torch.int64)
+    lo = lut[packed & 0xF]
+    hi = lut[(packed >> 4) & 0xF]
+    fp4 = torch.stack([lo, hi], dim=-1).reshape(-1, HEAD_DIM)
+    scales = (
+        records[:, HEAD_DIM // 2 : IDX_RECORD_BYTES]
+        .contiguous()
+        .view(torch.float8_e4m3fn)
+        .to(torch.float32)
+    )
+    vals = fp4.view(-1, HEAD_DIM // IDX_GROUP, IDX_GROUP) * scales.unsqueeze(-1)
+    return vals.reshape(-1, HEAD_DIM).to(torch.bfloat16)
+
+
+def dequant_mxfp4_weight_cpu(
+    weight_packed: torch.Tensor, scale_e8m0: torch.Tensor
+) -> torch.Tensor:
+    """Dequantize MXFP4 ``[..., K // 2]`` int8/uint8 + ``[..., K // 32]`` UE8M0 to FP32."""
+    lut = torch.tensor(_FP4_LUT, dtype=torch.float32, device=weight_packed.device)
+    raw = weight_packed.view(torch.uint8).to(torch.int64)
+    lo = lut[raw & 0xF]
+    hi = lut[(raw >> 4) & 0xF]
+    vals = torch.stack([lo, hi], dim=-1).flatten(-2)
+    exp = scale_e8m0.view(torch.uint8).to(torch.int32)
+    scales = torch.ldexp(torch.ones_like(exp, dtype=torch.float32), exp - 127)
+    lead = vals.shape[:-1]
+    k = vals.shape[-1]
+    return (vals.view(*lead, k // 32, 32) * scales.unsqueeze(-1)).reshape(*lead, k)
+
+
+def apply_rope_cpu(
+    x: torch.Tensor,
+    positions: torch.Tensor,
+    cos_sin_cache: torch.Tensor,
+    *,
+    inverse: bool = False,
+) -> torch.Tensor:
+    """Exact GPT-J interleaved RoPE matching ``tilelang/rope.py`` on CPU."""
+    if cos_sin_cache.device != x.device:
+        cos_sin_cache = cos_sin_cache.to(x.device)
+    rope_dim = cos_sin_cache.shape[1]
+    half = rope_dim // 2
+    cs = cos_sin_cache[positions]
+    cos = cs[:, :half]
+    sin = cs[:, half:]
+    if x.ndim == 3:
+        cos = cos.unsqueeze(1)
+        sin = sin.unsqueeze(1)
+    tail = x[..., -rope_dim:].to(torch.float32).unflatten(-1, (half, 2))
+    first = tail[..., 0]
+    second = tail[..., 1]
+    if inverse:
+        rot0 = first * cos + second * sin
+        rot1 = first * (-sin) + second * cos
+    else:
+        rot0 = first * cos - second * sin
+        rot1 = first * sin + second * cos
+    rotated = torch.stack([rot0, rot1], dim=-1).flatten(-2).to(x.dtype)
+    return torch.cat([x[..., :-rope_dim], rotated], dim=-1)
+
+
+def _gather_context_latents_cpu(
+    swa_cache: torch.Tensor,
+    swa_indices: torch.Tensor,
+    swa_lengths: torch.Tensor,
+    swa_page_size: int,
+    idx_cache: torch.Tensor,
+    idx_indices: torch.Tensor,
+    idx_lengths: torch.Tensor,
+    idx_page_table: torch.Tensor,
+    idx_page_size: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Return ``(ctx_latents [B, W + K, 512] BF16, valid_mask [B, W + K] bool)``."""
+    bsz, swa_w = swa_indices.shape
+    idx_w = idx_indices.shape[1]
+    swa_flat = swa_cache[:, : swa_page_size * SWA_RECORD_BYTES].reshape(
+        -1, SWA_RECORD_BYTES
+    )
+    idx_flat = idx_cache[:, : idx_page_size * IDX_RECORD_BYTES].reshape(
+        -1, IDX_RECORD_BYTES
+    )
+    swa_cols = torch.arange(swa_w, device=swa_indices.device).unsqueeze(0)
+    swa_valid = (swa_cols < swa_lengths.unsqueeze(1)) & (swa_indices >= 0)
+    swa_slots = swa_indices.clamp(min=0)
+    swa_kv = dequant_swa_records_cpu(swa_flat[swa_slots.reshape(-1)]).view(
+        bsz, swa_w, HEAD_DIM
+    )
+
+    idx_cols = torch.arange(idx_w, device=idx_indices.device).unsqueeze(0)
+    idx_valid = (idx_cols < idx_lengths.unsqueeze(1)) & (idx_indices >= 0)
+    logical = idx_indices.clamp(min=0)
+    pcol = (logical // idx_page_size).clamp(max=max(idx_page_table.shape[1] - 1, 0))
+    pages = torch.gather(idx_page_table, 1, pcol)
+    phys_idx = (pages * idx_page_size + (logical % idx_page_size)).clamp(min=0)
+    idx_kv = dequant_idx_records_cpu(idx_flat[phys_idx.reshape(-1)]).view(
+        bsz, idx_w, HEAD_DIM
+    )
+
+    latents = torch.cat([swa_kv, idx_kv], dim=1)
+    valid = torch.cat([swa_valid, idx_valid], dim=1)
+    return latents, valid
+
+
+def dfly2_attend_backbone_cpu(
+    q: torch.Tensor,
+    k_blk: torch.Tensor,
+    swa_cache: torch.Tensor,
+    swa_indices: torch.Tensor,
+    swa_lengths: torch.Tensor,
+    swa_page_size: int,
+    idx_cache: torch.Tensor,
+    idx_indices: torch.Tensor,
+    idx_lengths: torch.Tensor,
+    idx_page_table: torch.Tensor,
+    idx_page_size: int,
+    sinks: torch.Tensor,
+    positions: torch.Tensor,
+    cos_sin: torch.Tensor,
+    sm_scale: float = HEAD_DIM**-0.5,
+) -> torch.Tensor:
+    bsz, block_size, _ = k_blk.shape
+    heads = q.shape[1]
+    ctx_kv, ctx_valid = _gather_context_latents_cpu(
+        swa_cache,
+        swa_indices,
+        swa_lengths,
+        swa_page_size,
+        idx_cache,
+        idx_indices,
+        idx_lengths,
+        idx_page_table,
+        idx_page_size,
+    )
+    kv = torch.cat([ctx_kv, k_blk], dim=1).to(torch.float32)
+    blk_valid = torch.ones((bsz, block_size), dtype=torch.bool, device=q.device)
+    valid = torch.cat([ctx_valid, blk_valid], dim=1)
+    qf = q.view(bsz, block_size, heads, HEAD_DIM).to(torch.float32)
+    scores = torch.einsum("bshd,bkd->bshk", qf, kv) * sm_scale
+    scores = scores.masked_fill(~valid[:, None, None, :], float("-inf"))
+    denom = torch.logaddexp(
+        torch.logsumexp(scores, dim=-1, keepdim=True),
+        sinks.to(torch.float32).view(1, 1, heads, 1),
+    )
+    probs = torch.exp(scores - denom)
+    out = torch.einsum("bshk,bkd->bshd", probs, kv).reshape(-1, heads, HEAD_DIM)
+    return apply_rope_cpu(out.to(torch.bfloat16), positions, cos_sin, inverse=True)
+
+
+def dfly2_attend_correction_cpu(
+    q: torch.Tensor,
+    k_corr: torch.Tensor,
+    swa_cache: torch.Tensor,
+    swa_indices: torch.Tensor,
+    swa_lengths: torch.Tensor,
+    swa_page_size: int,
+    idx_cache: torch.Tensor,
+    idx_indices: torch.Tensor,
+    idx_lengths: torch.Tensor,
+    idx_page_table: torch.Tensor,
+    idx_page_size: int,
+    attn_sink: torch.Tensor,
+    block_sink: torch.Tensor,
+    block_rel_bias: torch.Tensor,
+    gate_logits: torch.Tensor,
+    block_gate_bias: torch.Tensor,
+    positions: torch.Tensor,
+    cos_sin: torch.Tensor,
+    step_idx: int,
+    sm_scale: float = HEAD_DIM**-0.5,
+) -> torch.Tensor:
+    bsz, heads, _ = q.shape
+    ctx_kv, ctx_valid = _gather_context_latents_cpu(
+        swa_cache,
+        swa_indices,
+        swa_lengths,
+        swa_page_size,
+        idx_cache,
+        idx_indices,
+        idx_lengths,
+        idx_page_table,
+        idx_page_size,
+    )
+    qf = q.to(torch.float32)
+    ctx_f = ctx_kv.to(torch.float32)
+    alive = ctx_valid.any(dim=-1)
+    scores_ctx = torch.einsum("bhd,bkd->bhk", qf, ctx_f) * sm_scale
+    scores_ctx = scores_ctx.masked_fill(~ctx_valid[:, None, :], float("-inf"))
+    denom_ctx = torch.logaddexp(
+        torch.logsumexp(scores_ctx, dim=-1, keepdim=True),
+        attn_sink.to(torch.float32).view(1, heads, 1),
+    )
+    probs_ctx = torch.where(
+        alive[:, None, None],
+        torch.exp(scores_ctx - denom_ctx),
+        torch.zeros_like(scores_ctx),
+    )
+    read_ctx = torch.einsum("bhk,bkd->bhd", probs_ctx, ctx_f).to(torch.bfloat16).float()
+    read_ctx = torch.where(alive[:, None, None], read_ctx, torch.zeros_like(read_ctx))
+
+    blk_f = k_corr[:, : step_idx + 1].to(torch.float32)
+    ks = torch.arange(step_idx + 1, device=q.device)
+    rel = block_rel_bias.to(torch.float32)[:, step_idx - ks].unsqueeze(0)
+    scores_blk = torch.einsum("bhd,bkd->bhk", qf, blk_f) * sm_scale + rel
+    denom_blk = torch.logaddexp(
+        torch.logsumexp(scores_blk, dim=-1, keepdim=True),
+        block_sink.to(torch.float32).view(1, heads, 1),
+    )
+    probs_blk = torch.exp(scores_blk - denom_blk)
+    read_blk = torch.einsum("bhk,bkd->bhd", probs_blk, blk_f)
+    gate = torch.tanh(
+        gate_logits.to(torch.float32)
+        + block_gate_bias.to(torch.float32)[:, step_idx].unsqueeze(0)
+    )
+    comb = (read_ctx + read_blk * gate.unsqueeze(-1)).to(torch.bfloat16)
+    return apply_rope_cpu(comb, positions, cos_sin, inverse=True)
+
+
+def dfly2_prepare_step_cpu(
+    out_block_input_ids: torch.Tensor,
+    out_block_positions: torch.Tensor,
+    out_anchor_tokens: torch.Tensor,
+    out_anchor_positions: torch.Tensor,
+    out_mtp_valid: torch.Tensor,
+    out_prev_hidden: torch.Tensor,
+    out_req_idx_mapping: torch.Tensor,
+    out_sample_idx_mapping: torch.Tensor,
+    out_swa_indices: torch.Tensor,
+    out_swa_lengths: torch.Tensor,
+    out_topk_indices: torch.Tensor,
+    out_top_lengths: torch.Tensor,
+    out_main_page_table: torch.Tensor,
+    target_positions: torch.Tensor,
+    target_query_start_loc: torch.Tensor,
+    dec_query_start_loc: torch.Tensor,
+    idx_mapping: torch.Tensor,
+    last_sampled: torch.Tensor,
+    next_prefill_tokens: torch.Tensor,
+    num_sampled: torch.Tensor,
+    num_rejected: torch.Tensor,
+    last_hidden_states: torch.Tensor,
+    replay_start: torch.Tensor,
+    swa_tables: tuple[torch.Tensor, torch.Tensor, torch.Tensor],
+    main_block_table: torch.Tensor,
+    src_topks: tuple[torch.Tensor, torch.Tensor, torch.Tensor],
+    *,
+    block_size: int,
+    window_size: int,
+    swa_page_size: int,
+    mask_token_id: int,
+    max_model_len: int,
+    num_reqs: int,
+    padded_reqs: int,
+    has_replay: bool,
+) -> None:
+    out_block_input_ids[: padded_reqs * block_size].zero_()
+    out_block_positions[: padded_reqs * block_size].zero_()
+    out_anchor_tokens[:padded_reqs].zero_()
+    out_anchor_positions[:padded_reqs].zero_()
+    out_mtp_valid[:padded_reqs].zero_()
+    out_prev_hidden[:padded_reqs].zero_()
+    out_req_idx_mapping[:padded_reqs].fill_(-1)
+    out_sample_idx_mapping[:padded_reqs].fill_(-1)
+    out_swa_indices[:, :padded_reqs].fill_(-1)
