+def test_dfly2_register_warmups_and_tp_merged_linear():
+    from vllm.model_executor.warmup.jit_warmup import JitWarmupRegistry
+    from vllm.models.deepseek_v4_1.nvidia.dfly2 import _DFly2MergedColumnParallelLinear
+    from vllm.models.deepseek_v4_1.tilelang import prepare
+
+    target_hf, draft_hf = _make_small_hf_configs()
+    vllm_cfg = _make_stub_vllm_config(target_hf, draft_hf, max_num_seqs=4)
+    vllm_cfg.kernel_config.enable_jit_warmup = True
+    vllm_cfg.additional_config = {}
+    vllm_cfg.optimization_level = 0
+    from vllm.config.vllm import set_current_vllm_config
+
+    with set_current_vllm_config(vllm_cfg):
+        spec = DFly2Speculator(vllm_cfg, torch.device("cpu"))
+        draft_lm = DFly2DeepseekV4ForCausalLM(vllm_config=vllm_cfg)
+    spec.model = draft_lm
+    registry = JitWarmupRegistry(vllm_config=None)
+    with registry.activate():
+        prepare.declare_modules(draft_lm)
+        spec.register_warmups()
+    calls = [
+        (getattr(fn, "__name__", repr(fn)), args, kwargs)
+        for fn, args, kwargs in prepare.declared_calls(registry)
+    ]
+    call_reprs = [f"{name}{args}{sorted(kwargs.items())}" for name, args, kwargs in calls]
+    assert any("dfly2_prepare_step_kernel" in r and "int64" in r for r in call_reprs)
+    assert any("dfly2_prepare_step_kernel" in r and "int32" in r for r in call_reprs)
+    assert any("padding_rows" in r for r in call_reprs)
+    assert any("select_first_argmax_kernel" in r and "True" in r for r in call_reprs)
+    assert any("dfly2_merge_backbone_kernel" in r for r in call_reprs)
+    assert any("dfly2_merge_correction_kernel" in r for r in call_reprs)
+    assert any("dfly2_swiglu_kernel" in r for r in call_reprs)
+    assert any(kwargs.get("segments_only") is True for _, _, kwargs in calls)
+
+    torch.manual_seed(99)
+    x = torch.randn(5, 192, dtype=torch.bfloat16)
+    w0 = torch.randn(128, 192, dtype=torch.bfloat16)
+    w1 = torch.randn(64, 192, dtype=torch.bfloat16)
+    w2 = torch.randn(8, 192, dtype=torch.bfloat16)
+    ref = F.linear(x, torch.cat([w0, w1, w2], dim=0))
+
+    for tp_size in (1, 2, 3, 4):
+        shards_out = []
+        for tp_rank in range(tp_size):
+            layer = _DFly2MergedColumnParallelLinear(
+                192,
+                [128, 64, 8],
+                params_dtype=torch.bfloat16,
+                gather_output=False,
+                tp_size=tp_size,
+                tp_rank=tp_rank,
+            )
+            assert layer.weight.shape == (layer.part_output_size, 192)
+            assert layer.part_output_size % 64 == 0
+            # Poison destination buffer first to verify uninitialized arena padding is zeroed
+            layer.weight.data.fill_(float("nan"))
+            layer.weight_loader(layer.weight, w0, 0)
+            layer.weight_loader(layer.weight, w1, 1)
+            layer.weight_loader(layer.weight, w2, 2)
+            assert torch.isfinite(layer.weight).all()
+            shards_out.append(F.linear(x, layer.weight))
+        gathered = torch.cat(shards_out, dim=-1)[:, :200]
+        assert torch.equal(gathered, ref), f"TP={tp_size} mismatch"
+
