+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Model loader utilities for DFly2 standalone speculative checkpoints."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import torch.nn as nn
+
+from vllm.config import ParallelConfig, VllmConfig, replace
+from vllm.logger import init_logger
+from vllm.v1.worker.gpu.spec_decode.utils import get_pp_safe_draft_load_config
+
+logger = init_logger(__name__)
+
+_TARGET_EMBED_CANDIDATES = (
+    "embed.weight",
+    "model.embed_tokens.weight",
+    "language_model.model.embed_tokens.weight",
+    "language_model.embed.weight",
+)
+
+
+def _get_dfly2_parallel_config(
+    parallel_config: ParallelConfig,
+    tensor_parallel_size: int,
+) -> ParallelConfig:
+    if parallel_config.enable_eplb:
+        logger.warning_once(
+            "EPLB is disabled for the DFly2 draft model. EPLB remains enabled "
+            "for the target model."
+        )
+    return replace(
+        parallel_config,
+        pipeline_parallel_size=1,
+        tensor_parallel_size=tensor_parallel_size,
+        enable_eplb=False,
+        eplb_config=replace(
+            parallel_config.eplb_config,
+            num_redundant_experts=0,
+        ),
+        enable_elastic_ep=False,
+    )
+
+
+def _load_target_embed_for_pp(
+    draft_model: nn.Module, vllm_config: VllmConfig
+) -> None:
+    """Load ``embed_tokens`` from the target checkpoint when PP > 1 omits it on
+    the last pipeline stage."""
+    embed_mod = getattr(draft_model.model, "embed_tokens", None)
+    if embed_mod is None:
+        return
+    target_dir = Path(vllm_config.model_config.model)
+    if not target_dir.is_dir():
+        raise RuntimeError(
+            f"PP > 1 DFly2 requires local target snapshot directory for embed_tokens, "
+            f"got {vllm_config.model_config.model!r}"
+        )
+    from safetensors import safe_open
+
+    index_file = target_dir / "model.safetensors.index.json"
+    shard_file: Path | None = None
+    found_key: str | None = None
+    if index_file.is_file():
+        weight_map = json.loads(index_file.read_text(encoding="utf-8")).get(
+            "weight_map", {}
+        )
+        for key in _TARGET_EMBED_CANDIDATES:
+            if key in weight_map:
+                found_key = key
+                shard_file = target_dir / weight_map[key]
+                break
+    else:
+        single = target_dir / "model.safetensors"
+        if single.is_file():
+            with safe_open(str(single), framework="pt", device="cpu") as sf:
+                keys = set(sf.keys())
+                for key in _TARGET_EMBED_CANDIDATES:
+                    if key in keys:
+                        found_key = key
+                        shard_file = single
+                        break
+    if shard_file is None or found_key is None:
+        raise RuntimeError(
+            f"Could not locate target embedding tensor in {target_dir}"
+        )
+
+    with safe_open(str(shard_file), framework="pt", device="cpu") as sf:
+        tensor = sf.get_tensor(found_key)
+    param = embed_mod.weight
+    embed_mod.weight_loader(param, tensor)
+    quant_method = getattr(embed_mod, "quant_method", None)
+    if quant_method is not None and hasattr(quant_method, "process_weights_after_loading"):
+        quant_method.process_weights_after_loading(embed_mod)
+
+
+def load_dfly2_model(target_model: nn.Module, vllm_config: VllmConfig) -> nn.Module:
+    speculative_config = vllm_config.speculative_config
+    assert speculative_config is not None
+    draft_model_config = speculative_config.draft_model_config
+
+    from vllm.compilation.backends import set_model_tag
+    from vllm.model_executor.model_loader import get_model
+    from vllm.model_executor.models.utils import get_draft_quant_config
+    from vllm.v1.worker.gpu.spec_decode.eagle.utils import (
+        _should_share,
+        get_target_lm_head,
+        maybe_share_target_embed,
+    )
+
+    draft_vllm_config = replace(
+        vllm_config,
+        parallel_config=_get_dfly2_parallel_config(
+            vllm_config.parallel_config,
+            speculative_config.draft_parallel_config.tensor_parallel_size,
+        ),
+        kernel_config=(
+            replace(
+                vllm_config.kernel_config,
+                moe_backend=speculative_config.moe_backend,
+            )
+            if speculative_config.moe_backend is not None
+            else vllm_config.kernel_config
+        ),
+        load_config=get_pp_safe_draft_load_config(vllm_config.load_config),
+    )
+    draft_vllm_config.quant_config = get_draft_quant_config(vllm_config)
+
+    with set_model_tag("dfly2_head"):
+        draft_model = get_model(
+            vllm_config=draft_vllm_config,
+            model_config=draft_model_config,
+            load_config=speculative_config.draft_load_config,
+        )
+
+    target_language_model = (
+        target_model.get_language_model()
+        if hasattr(target_model, "get_language_model")
+        else target_model
+    )
+    target_inner = target_language_model.model
+    draft_inner = draft_model.model
+    target_vocab_size = vllm_config.model_config.get_vocab_size()
+
+    if draft_model.has_own_embed_tokens:
+        _load_target_embed_for_pp(draft_model, vllm_config)
+    elif draft_model_config.get_vocab_size() <= target_vocab_size:
+        maybe_share_target_embed(draft_model, draft_inner, target_inner)
+
+    target_lm_head = get_target_lm_head(target_model, target_language_model)
+    draft_lm_head = getattr(draft_model, "lm_head", None)
+    if (
+        target_lm_head is not None
+        and draft_model_config.get_vocab_size() == target_vocab_size
+        and _should_share(draft_model, "has_own_lm_head", draft_lm_head, target_lm_head)
+    ):
+        if draft_lm_head is not None:
+            del draft_model.lm_head
+        draft_model.lm_head = target_lm_head
+
+    return draft_model
