+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Native DeepSeek-V4.1 DFly2 block-parallel speculative draft model.
+
+Implements the DFly2 architecture (AngelSlim/DS-V4.1-Flash-DFly2-B6):
+  1. ``DFly2MTPFusion``: fuses ``enorm(E(anchor))`` and ``hnorm(prev_hidden)`` into
+     the anchor slot of the ``block_size`` query block.
+  2. Three mHC + Sparse-MLA + 128-expert MXFP4 MoE draft decoder layers reading
+     the target model\x27s SWA and compressed-MLA KV caches and reusing the target\x27s
+     selected DSA ``topk_indices`` (zero draft KV cache, zero draft prefill).
+  3. ``DFly2HiddenCorrection`` + ``DFly2AttentiveCorrection``: sequential
+     left-to-right residual refinement across slots ``1 .. block_size - 1`` with
+     causal gated intra-block keys and target context re-read, sampled through
+     the shared target ``lm_head``.
+"""
+
+from __future__ import annotations
+
+import copy
+from collections.abc import Iterable
+from dataclasses import dataclass
+
+import regex as re
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+from vllm.config import VllmConfig, get_current_vllm_config
+from vllm.distributed import (
+    get_pp_group,
+    get_tensor_model_parallel_rank,
+    get_tensor_model_parallel_world_size,
+    model_parallel_is_initialized,
+    tensor_model_parallel_all_reduce,
+)
+from vllm.forward_context import get_forward_context, is_forward_context_available
+from vllm.logger import init_logger
+from vllm.model_executor.layers.fused_moe import fused_moe_make_expert_params_mapping
+from vllm.model_executor.layers.linear import (
+    ColumnParallelLinear,
+    MergedColumnParallelLinear,
+    ReplicatedLinear,
+    RowParallelLinear,
+    UnquantizedLinearMethod,
+)
+from vllm.model_executor.layers.logits_processor import LogitsProcessor
+from vllm.model_executor.layers.vocab_parallel_embedding import VocabParallelEmbedding
+from vllm.model_executor.model_loader.weight_utils import default_weight_loader
+from vllm.model_executor.models.utils import maybe_prefix
+from vllm.model_executor.utils import set_weight_attrs
+from vllm.model_executor.weight_transfer import copy_weight
+from vllm.models.deepseek_v4.nvidia.model import DeepseekV4MoE
+from vllm.models.deepseek_v41.common.rope import build_deepseek_v4_rope
+from vllm.models.deepseek_v4_1.common.engram import _PaddedColumnParallelLinear
+from vllm.utils.math_utils import cdiv, round_up
+from vllm.v1.worker.workspace import (
+    current_preallocated_workspace,
+    current_workspace_manager,
+    is_workspace_manager_initialized,
+    retain_cuda_graph_capture_resource,
+)
+
+from .. import kernels, l2_prefetch
+from ..tilelang import dfly2 as tl_dfly2
+from ..tilelang import prepare
+from ..tilelang.rope import rope_, rope_call
+
+logger = init_logger(__name__)
+
+_EXPERT_SCALE_RE = re.compile(r"\.experts\.\d+\.w[123]\.scale$")
+
+
+def _tp_world_and_rank() -> tuple[int, int]:
+    if not model_parallel_is_initialized():
+        return 1, 0
+    return get_tensor_model_parallel_world_size(), get_tensor_model_parallel_rank()
+
+
+def _pp_needs_own_embed() -> bool:
+    if not model_parallel_is_initialized():
+        return False
+    pp = get_pp_group()
+    return pp.world_size > 1 and not pp.is_first_rank
+
+
+def _resolve_draft_text_config(draft_model_config):
+    from transformers import PretrainedConfig
+
+    hf_text = getattr(draft_model_config, "hf_text_config", None)
+    if hf_text is not None and hasattr(hf_text, "hidden_size"):
+        return hf_text
+    hf = draft_model_config.hf_config
+    if hasattr(hf, "hidden_size"):
+        return hf
+    if hasattr(hf, "get_text_config"):
+        try:
+            sub = hf.get_text_config()
+            if hasattr(sub, "hidden_size"):
+                return sub
+        except Exception:
+            pass
+    raw_sub = getattr(hf, "text_config", None)
+    if isinstance(raw_sub, dict):
+        return PretrainedConfig.from_dict(raw_sub)
+    if raw_sub is not None and hasattr(raw_sub, "hidden_size"):
+        return raw_sub
+    return hf
+
+
+@dataclass(frozen=True)
+class DFly2ParsedConfig:
+    block_size: int
+    causal_block: bool
+    mask_token_id: int
+    target_kv_layers: tuple[int, ...]
+    target_index_layers: tuple[int, ...]
+    index_topk: int
+    n_routed_experts: int
+    num_experts_per_tok: int
+    mtp_fusion_mode: str | None
+    hidden_correction_intermediate: int | None
+    attentive_source_layer: int
+    attentive_block_keys: bool
+    attentive_block_gated: bool
+    attentive_block_kv_in_embed: bool
+    max_block_slots: int
+
+    @classmethod
+    def from_hf_config(cls, hf_config, text_config=None) -> DFly2ParsedConfig:
+        tcfg = text_config if text_config is not None else hf_config
+        raw = getattr(hf_config, "dfly_config", None) or getattr(tcfg, "dfly_config", None) or {}
+        kv_layers = tuple(int(x) for x in raw.get("target_kv_layers", (28, 32, 36)))
+        idx_layers = tuple(
+            int(x) for x in raw.get("target_index_layers", kv_layers)
+        )
+        if len(kv_layers) != len(idx_layers) or not kv_layers:
+            raise ValueError(
+                f"DFly2 target_kv_layers {kv_layers} and target_index_layers "
+                f"{idx_layers} must be non-empty and equal length."
+            )
+        hc_cfg = raw.get("hidden_correction")
+        hc_inter: int | None = None
+        if isinstance(hc_cfg, dict):
+            hc_inter = int(hc_cfg.get("intermediate_size", tcfg.hidden_size))
+        elif hc_cfg:
+            hc_inter = int(tcfg.hidden_size)
+
+        ac_cfg = raw.get("attentive_correction") or {}
+        if isinstance(ac_cfg, dict) and ac_cfg:
+            src = int(ac_cfg.get("source_layer", -1))
+            if src < 0:
+                src += len(kv_layers)
+            block_keys = bool(ac_cfg.get("block_keys", True))
+            block_gated = block_keys and ac_cfg.get("block_mode", "gated") == "gated"
+            kv_in_embed = ac_cfg.get("block_kv_in", "hidden_embed") == "hidden_embed"
+            max_slots = int(ac_cfg.get("max_block_slots", 16))
+        else:
+            src = -1
+            block_keys = False
+            block_gated = False
+            kv_in_embed = True
+            max_slots = 16
+
+        n_experts = int(
+            raw.get(
+                "num_experts",
+                raw.get(
+                    "n_routed_experts",
+                    getattr(tcfg, "dspark_n_routed_experts", 128) or 128,
+                ),
+            )
+        )
+        top_k = int(
+            raw.get(
+                "num_experts_per_tok",
+                getattr(tcfg, "dspark_num_experts_per_tok", 3) or 3,
+            )
+        )
+        mtp_mode = raw.get("mtp_fusion", "slot0")
+        if mtp_mode in (False, "none", ""):
+            mtp_mode = None
+
+        return cls(
+            block_size=int(raw.get("block_size", 6)),
+            causal_block=bool(raw.get("causal_block", False)),
+            mask_token_id=int(raw.get("mask_token_id", 128799)),
+            target_kv_layers=kv_layers,
+            target_index_layers=idx_layers,
+            index_topk=int(raw.get("index_topk", getattr(tcfg, "index_topk", 512))),
+            n_routed_experts=n_experts,
+            num_experts_per_tok=top_k,
+            mtp_fusion_mode=mtp_mode,
+            hidden_correction_intermediate=hc_inter,
+            attentive_source_layer=src,
+            attentive_block_keys=block_keys,
+            attentive_block_gated=block_gated,
+            attentive_block_kv_in_embed=kv_in_embed,
+            max_block_slots=max_slots,
+        )
+
+
+def _rms_norm(norm_mod: nn.Module, x: torch.Tensor) -> torch.Tensor:
+    if x.is_cuda:
+        return norm_mod(x)
+    eps = getattr(norm_mod, "variance_epsilon", getattr(norm_mod, "eps", 1e-6))
+    xf = x.to(torch.float32)
+    xf = xf * torch.rsqrt(xf.pow(2).mean(-1, keepdim=True) + eps)
+    return (norm_mod.weight.to(torch.float32) * xf).to(x.dtype)
+
+
+class _DFly2MergedColumnParallelLinear(ColumnParallelLinear):
+    """TP-sharded BF16 merged projection with 64-row per-rank tile alignment."""
+
+    def __init__(
+        self,
+        input_size: int,
+        output_sizes: list[int],
+        *,
+        params_dtype: torch.dtype | None = None,
+        quant_config=None,
+        prefix: str = "",
+        gather_output: bool = True,
+        tp_size: int | None = None,
+        tp_rank: int | None = None,
+    ) -> None:
+        self.logical_output_sizes = [int(s) for s in output_sizes]
+        self.logical_output_size = sum(self.logical_output_sizes)
+        world, rank = _tp_world_and_rank()
+        if tp_size is not None:
+            world = int(tp_size)
+        if tp_rank is not None:
+            rank = int(tp_rank)
+        quantum = world * 64
+        self.padded_output_size = round_up(self.logical_output_size, quantum)
+        self.part_output_size = self.padded_output_size // world
+        super().__init__(
+            input_size=input_size,
+            output_size=self.padded_output_size,
+            bias=False,
+            gather_output=False,
+            params_dtype=params_dtype,
+            quant_config=quant_config,
+            prefix=prefix,
+            return_bias=False,
+            disable_tp=(tp_size is not None),
+        )
+        if tp_size is not None and world > 1:
+            self.weight = nn.Parameter(
+                torch.empty(
+                    (self.part_output_size, input_size),
+                    dtype=self.weight.dtype,
+                    device=self.weight.device,
+                ),
+                requires_grad=False,
+            )
+            set_weight_attrs(
+                self.weight,
+                {
+                    "input_dim": 1,
+                    "output_dim": 0,
+                    "weight_loader": self.weight_loader,
+                },
+            )
+        self.tp_size = world
+        self.tp_rank = rank
+        self.output_size_per_partition = self.part_output_size
+        self.gather_merged_output = gather_output
+        if self.weight.data.device.type != "meta":
+            self.weight.data.zero_()
+        if self.padded_output_size != self.logical_output_size:
+            set_weight_attrs(self.weight, {"allow_tp_padding": True})
+
+    def weight_loader(
+        self,
+        param: nn.Parameter,
+        loaded_weight: torch.Tensor,
+        loaded_shard_id: int | None = None,
+    ) -> None:
+        if loaded_shard_id is None:
+            s0, s1 = 0, self.logical_output_size
+        else:
+            if not (0 <= loaded_shard_id < len(self.logical_output_sizes)):
+                raise ValueError(
+                    f"Invalid shard id {loaded_shard_id} for {self.logical_output_sizes}"
+                )
+            s0 = sum(self.logical_output_sizes[:loaded_shard_id])
+            s1 = s0 + self.logical_output_sizes[loaded_shard_id]
+        if loaded_weight.shape[0] != s1 - s0:
+            raise ValueError(
+                f"Expected shard {loaded_shard_id} rows {s1 - s0}, got {loaded_weight.shape[0]}"
+            )
+        r0 = self.tp_rank * self.part_output_size
+        r1 = r0 + self.part_output_size
+        if r1 > self.logical_output_size:
+            pad_local = max(0, self.logical_output_size - r0)
+            param.data.narrow(0, pad_local, r1 - r0 - pad_local).zero_()
+        ov0 = max(s0, r0)
+        ov1 = min(s1, r1)
+        if ov1 > ov0:
+            copy_weight(
+                param.data.narrow(0, ov0 - r0, ov1 - ov0),
+                loaded_weight.narrow(0, ov0 - s0, ov1 - ov0),
+            )
+
+    weight_loader_v2 = weight_loader
+
+    def forward(self, input_: torch.Tensor) -> torch.Tensor:
+        if input_.is_cuda:
+            local_out = self.quant_method.apply(self, input_, None)
+        else:
+            local_out = F.linear(input_.to(self.weight.dtype), self.weight)
+        if self.gather_merged_output and self.tp_size > 1:
+            from vllm.distributed import tensor_model_parallel_all_gather
+
+            out = tensor_model_parallel_all_gather(local_out, dim=-1)
+        else:
+            out = local_out
+        if out.shape[-1] == self.logical_output_size:
+            return out
+        return out[..., : self.logical_output_size].contiguous()
+
+
+def _linear_cpu_or_gpu(layer: nn.Module, x: torch.Tensor) -> torch.Tensor:
+    if isinstance(layer, _DFly2MergedColumnParallelLinear):
+        return layer(x)
+    if x.is_cuda:
+        out = layer(x)
+        return out[0] if isinstance(out, tuple) else out
+    w = layer.weight
+    if hasattr(layer, "logical_output_size"):
+        w = w[: layer.logical_output_size]
+    out = F.linear(x.to(w.dtype), w)
+    tp_size, _ = _tp_world_and_rank()
+    if tp_size > 1:
+        if isinstance(layer, ColumnParallelLinear) and getattr(
+            layer, "gather_output", False
+        ) and not hasattr(layer, "logical_output_size"):
+            from vllm.distributed import tensor_model_parallel_all_gather
+
+            out = tensor_model_parallel_all_gather(out, dim=-1)
+        elif isinstance(layer, RowParallelLinear) and getattr(
+            layer, "reduce_results", False
+        ):
+            out = tensor_model_parallel_all_reduce(out)
+    return out
+
+
+def _alloc_attn_scratch(specs, device: torch.device):
+    scratch = current_preallocated_workspace()
+    if scratch is not None:
+        return tuple(scratch.alloc(shape, dtype=dtype) for shape, dtype in specs)
+    if is_workspace_manager_initialized():
+        out = current_workspace_manager().get_simultaneous(*specs)
+        if torch.cuda.is_current_stream_capturing():
+            for t in out:
+                retain_cuda_graph_capture_resource(t)
+        return out
+    return tuple(torch.empty(shape, dtype=dtype, device=device) for shape, dtype in specs)
+
+
+def _grouped_wo_a(out_3d: torch.Tensor, wo_a: nn.Module, n_local_groups: int) -> torch.Tensor:
+    """``out_3d``: ``[rows, n_local_heads, 512]`` BF16 -> ``[rows, n_local_groups * o_lora_rank]``."""
+    rows = out_3d.shape[0]
+    if rows == 0:
+        return out_3d.new_empty((0, wo_a.weight.shape[0]))
+    grouped = out_3d.reshape(rows, n_local_groups, -1)
+    w = wo_a.weight.view(n_local_groups, -1, grouped.shape[-1])
+    # Batched GEMM over local output groups: [G, rows, 4096] @ [G, 4096, 1024] -> [G, rows, 1024]
+    proj = torch.bmm(grouped.transpose(0, 1), w.transpose(1, 2))
+    return proj.transpose(0, 1).reshape(rows, -1).contiguous()
+
+
+def _mhc_mixes_cpu(
+    h: torch.Tensor,
+    fn: torch.Tensor,
+    scale: torch.Tensor,
+    base: torch.Tensor,
+    hc_mult: int,
+    iters: int,
+    eps: float,
+    norm_eps: float,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    xf = h.flatten(-2).to(torch.float32)
+    rsqrt = torch.rsqrt(xf.pow(2).mean(-1, keepdim=True) + norm_eps)
+    mixes = F.linear(xf, fn.to(torch.float32)) * rsqrt
+    sf = scale.to(torch.float32)
+    bf = base.to(torch.float32)
+    pre = torch.sigmoid(mixes[..., :hc_mult] * sf[0] + bf[:hc_mult]) + eps
+    post = 2.0 * torch.sigmoid(
+        mixes[..., hc_mult : 2 * hc_mult] * sf[1] + bf[hc_mult : 2 * hc_mult]
+    )
+    comb = (mixes[..., 2 * hc_mult :] * sf[2] + bf[2 * hc_mult :]).unflatten(
+        -1, (hc_mult, hc_mult)
+    )
+    comb = comb.softmax(dim=-1) + eps
+    comb = comb / (comb.sum(dim=-2, keepdim=True) + eps)
+    for _ in range(iters - 1):
+        comb = comb / (comb.sum(dim=-1, keepdim=True) + eps)
+        comb = comb / (comb.sum(dim=-2, keepdim=True) + eps)
+    return pre, post, comb
+
+
+def _mhc_post_cpu(
+    x: torch.Tensor, residual: torch.Tensor, post: torch.Tensor, comb: torch.Tensor
+) -> torch.Tensor:
+    mixed = torch.einsum("...jk,...jd->...kd", comb, residual.to(torch.float32))
+    return (post.unsqueeze(-1) * x.to(torch.float32).unsqueeze(-2) + mixed).to(x.dtype)
+
+
+def _clamped_swiglu_cpu(gate_up: torch.Tensor, limit: float) -> torch.Tensor:
+    half = gate_up.shape[-1] // 2
+    gate = gate_up[..., :half].to(torch.float32).clamp(max=limit)
+    up = gate_up[..., half:].to(torch.float32).clamp(min=-limit, max=limit)
+    return (F.silu(gate) * up).to(gate_up.dtype)
+
+
+def _moe_forward_cpu(ffn: DeepseekV4MoE, x: torch.Tensor, is_padding: torch.Tensor | None) -> torch.Tensor:
+    rows, hidden = x.shape
+    if rows == 0:
+        return x.clone()
+    logits = F.linear(x.to(torch.float32), ffn.gate.weight.to(torch.float32))
+    scores = torch.sqrt(F.softplus(logits))
+    bias = getattr(ffn.gate, "e_score_correction_bias", None)
+    choice_scores = scores + bias.to(torch.float32) if bias is not None else scores
+    _, topk_ids = torch.topk(choice_scores, k=ffn.n_activated_experts, dim=-1)
+    topk_weights = torch.gather(scores, 1, topk_ids)
+    if ffn.renormalize:
+        topk_weights = topk_weights / (topk_weights.sum(dim=-1, keepdim=True) + 1e-20)
+    topk_weights = topk_weights * ffn.routed_scaling_factor
+
+    experts = getattr(ffn.experts, "routed_experts", ffn.experts)
+    w13_q = experts.w13_weight
+    w13_s = experts.w13_weight_scale
+    w2_q = experts.w2_weight
+    w2_s = experts.w2_weight_scale
+    start_e = getattr(ffn, "experts_start_idx", 0)
+    end_e = getattr(ffn, "experts_end_idx", ffn.n_routed_experts)
+
+    routed_acc = torch.zeros((rows, hidden), dtype=torch.float32, device=x.device)
+    for r in range(rows):
+        if is_padding is not None and bool(is_padding[r].item()):
+            continue
+        xr = x[r : r + 1].to(torch.float32)
+        for slot in range(ffn.n_activated_experts):
+            eid = int(topk_ids[r, slot].item())
+            if not (start_e <= eid < end_e):
+                continue
+            le = eid - start_e
+            wt = float(topk_weights[r, slot].item())
+            w13 = tl_dfly2.dequant_mxfp4_weight_cpu(w13_q[le], w13_s[le])
+            gu = F.linear(xr, w13)
+            inter = _clamped_swiglu_cpu(gu.to(torch.bfloat16), float(ffn.swiglu_limit))
+            w2 = tl_dfly2.dequant_mxfp4_weight_cpu(w2_q[le], w2_s[le])
+            down = F.linear(inter.to(torch.float32), w2)
+            routed_acc[r] += wt * down.squeeze(0)
+
+    shared = ffn.shared_experts
+    if shared is not None:
+        s_gu = _linear_cpu_or_gpu(shared.gate_up_proj, x)
+        s_act = _clamped_swiglu_cpu(s_gu, float(ffn.swiglu_limit))
+        s_down = F.linear(s_act.to(shared.down_proj.weight.dtype), shared.down_proj.weight)
+        out = (routed_acc + s_down.to(torch.float32)).to(x.dtype)
+    else:
+        out = routed_acc.to(x.dtype)
+    tp_size, _ = _tp_world_and_rank()
+    if tp_size > 1:
+        out = tensor_model_parallel_all_reduce(out)
+    return out
+
+
+class DFly2MTPFusion(nn.Module):
+    """Target final-hidden + anchor-embedding fusion at the opening of DFly2."""
+
+    def __init__(
+        self,
+        hidden_size: int,
+        mode: str,
+        rms_norm_eps: float,
+        quant_config,
+        prefix: str,
+    ) -> None:
+        super().__init__()
+        if mode not in ("slot0", "slot1", "broadcast"):
+            raise ValueError(f"Unsupported DFly2 mtp_fusion mode: {mode!r}")
+        self.hidden_size = hidden_size
+        self.mode = mode
+        self.gate_slot = 1 if mode == "slot1" else 0
+        self.enorm = kernels.rms_norm(hidden_size, rms_norm_eps)
+        self.hnorm = kernels.rms_norm(hidden_size, rms_norm_eps)
+        tp_size, _ = _tp_world_and_rank()
+        proj_cls = _PaddedColumnParallelLinear if tp_size > 1 else ReplicatedLinear
+        self.eh_proj = proj_cls(
+            2 * hidden_size,
+            hidden_size,
+            bias=False,
+            return_bias=False,
+            quant_config=quant_config,
+            prefix=maybe_prefix(prefix, "eh_proj"),
+            **({"gather_output": True} if tp_size > 1 else {}),
+        )
+        self.gate = nn.Parameter(
+            torch.zeros(hidden_size, dtype=torch.bfloat16), requires_grad=False
+        )
+        self.mask_gate = (
+            nn.Parameter(
+                torch.zeros(hidden_size, dtype=torch.bfloat16), requires_grad=False
+            )
+            if mode == "broadcast"
+            else None
+        )
+
+    def forward(
+        self,
+        block_embeds: torch.Tensor,
+        anchor_embeds: torch.Tensor,
+        prev_hidden: torch.Tensor,
+        valid_mask: torch.Tensor,
+        block_size: int,
+    ) -> torch.Tensor:
+        """Apply MTP fusion in place on ``block_embeds`` (``[B * block_size, D]``)."""
+        bsz = anchor_embeds.shape[0]
+        if bsz == 0:
+            return block_embeds
+        e_norm = _rms_norm(self.enorm, anchor_embeds)
+        h_norm = _rms_norm(self.hnorm, prev_hidden.to(anchor_embeds.dtype))
+        fused = _linear_cpu_or_gpu(self.eh_proj, torch.cat([e_norm, h_norm], dim=-1))
+        mask = valid_mask.view(bsz, 1).to(torch.float32)
+        blk = block_embeds.view(bsz, block_size, self.hidden_size)
+        if self.mask_gate is not None:
+            g0 = (self.gate.to(torch.float32) * fused.to(torch.float32) * mask).to(
+                block_embeds.dtype
+            )
+            gm = (
+                self.mask_gate.to(torch.float32) * fused.to(torch.float32) * mask
+            ).to(block_embeds.dtype)
+            blk[:, 0] = blk[:, 0] + g0
+            blk[:, 1:] = blk[:, 1:] + gm.unsqueeze(1)
+        else:
+            delta = (
+                self.gate.to(torch.float32) * fused.to(torch.float32) * mask
+            ).to(block_embeds.dtype)
+            blk[:, self.gate_slot] = blk[:, self.gate_slot] + delta
+        return block_embeds
+
+
+class DFly2Attention(nn.Module):
+    """DFly2 draft attention sharing target SWA + compressed-MLA KV and DSA indices."""
+
+    def __init__(
+        self,
+        vllm_config: VllmConfig,
+        dfly_cfg: DFly2ParsedConfig,
+        layer_idx: int,
+        prefix: str,
+    ) -> None:
+        super().__init__()
+        hf = _resolve_draft_text_config(vllm_config.speculative_config.draft_model_config)
+        self.vllm_config = vllm_config
+        self.dfly_cfg = dfly_cfg
+        self.layer_idx = layer_idx
+        self.target_kv_layer = dfly_cfg.target_kv_layers[layer_idx]
+        self.target_index_layer = dfly_cfg.target_index_layers[layer_idx]
+        self.hidden_size = hf.hidden_size
+        self.head_dim = hf.head_dim
+        self.rope_dim = hf.qk_rope_head_dim
+        self.q_lora_rank = hf.q_lora_rank
+        self.o_lora_rank = hf.o_lora_rank
+        self.window_size = getattr(
+            _resolve_draft_text_config(vllm_config.model_config), "sliding_window", hf.sliding_window
+        )
+        self.index_topk = dfly_cfg.index_topk
+        self.block_size = dfly_cfg.block_size
+
+        tp_size, _ = _tp_world_and_rank()
+        self.n_local_heads = hf.num_attention_heads // tp_size
+        self.n_local_groups = hf.o_groups // tp_size
+
+        self.attn_sink = nn.Parameter(
+            torch.zeros(self.n_local_heads, dtype=torch.float32),
+            requires_grad=False,
+        )
+        self.fused_wqa_wkv = _DFly2MergedColumnParallelLinear(
+            hf.hidden_size,
+            [hf.q_lora_rank, self.head_dim],
+            gather_output=True,
+            quant_config=vllm_config.quant_config,
+            prefix=f"{prefix}.fused_wqa_wkv",
+        )
+        self.q_norm = kernels.rms_norm(hf.q_lora_rank, hf.rms_norm_eps)
+        self.kv_norm = kernels.rms_norm(self.head_dim, hf.rms_norm_eps)
+        self.wq_b = ColumnParallelLinear(
+            hf.q_lora_rank,
+            hf.num_attention_heads * self.head_dim,
+            bias=False,
+            return_bias=False,
+            quant_config=vllm_config.quant_config,
+            prefix=f"{prefix}.wq_b",
+        )
+        self.wo_a = ColumnParallelLinear(
+            hf.num_attention_heads * self.head_dim // hf.o_groups,
+            hf.o_groups * hf.o_lora_rank,
+            bias=False,
+            return_bias=False,
+            quant_config=None,
+            prefix=f"{prefix}.wo_a",
+        )
+        self.wo_a.quant_method = UnquantizedLinearMethod()
+        self.wo_b = RowParallelLinear(
+            hf.o_groups * hf.o_lora_rank,
+            hf.hidden_size,
+            bias=False,
+            return_bias=False,
+            quant_config=vllm_config.quant_config,
+            reduce_results=True,
+            prefix=f"{prefix}.wo_b",
+        )
+        if getattr(hf, "original_num_attention_heads", hf.num_attention_heads) != (
+            hf.num_attention_heads
+        ):
+            for linear in (self.wq_b, self.wo_a, self.wo_b):
+                for param in linear.parameters():
+                    set_weight_attrs(param, {"allow_tp_padding": True})
+
+        self.rotary_emb = build_deepseek_v4_rope(
+            hf,
+            head_dim=self.head_dim,
+            rope_head_dim=self.rope_dim,
+            max_position_embeddings=max(
+                int(getattr(hf, "max_position_embeddings", 0) or 0),
+                int(vllm_config.model_config.max_model_len),
+            ),
+            compress_ratio=1,
+        )
+        self._target_swa_layer = None
+        self._target_main_layer = None
+        self._swa_page_size = (
+            vllm_config.cache_config.swa_block_size or 128
+        )
+        self._main_page_size = vllm_config.cache_config.block_size
+        self._plan: tl_dfly2.DFly2AttentionPlan | None = None
+        self._l2pf_ffn = None
+
+    def bind_target_layers(self, swa_layer, main_layer) -> None:
+        self._target_swa_layer = swa_layer
+        self._target_main_layer = main_layer
+        self._swa_page_size = swa_layer.block_size
+        self._main_page_size = main_layer._main_page
+
+    def _plan_kwargs(self) -> dict:
+        max_rows = (
+            self.vllm_config.scheduler_config.max_num_seqs * self.block_size
+        )
+        return dict(
+            swa_page_size=self._swa_page_size,
+            max_rows=max_rows,
+            mode="backbone",
+            block_size=self.block_size,
+        )
+
+    def declare_kernels(self) -> None:
+        table_width = self.rotary_emb.cos_sin_cache.shape[1]
+        args = (
+            self.n_local_heads,
+            self.window_size,
+            self.index_topk,
+            self._main_page_size,
+        )
+        kwargs = self._plan_kwargs()
+
+        def calls():
+            out = list(
+                tl_dfly2.DFly2AttentionPlan.calls(
+                    *args,
+                    swa_page_size=kwargs["swa_page_size"],
+                    mode="backbone",
+                    block_size=self.block_size,
+                )
+            )
+            if self.n_local_heads > 0:
+                out.append(rope_call(self.n_local_heads, self.head_dim, table_width, 1, False))
+            out.append(rope_call(1, self.head_dim, table_width, 1, False))
+            return out
+
+        def bind():
+            self._plan = tl_dfly2.DFly2AttentionPlan(*args, **kwargs)
+
+        prepare.declare(calls, bind=bind)
+
+    def forward(
+        self,
+        x: torch.Tensor,
+        positions: torch.Tensor,
+        swa_indices: torch.Tensor,
+        swa_lengths: torch.Tensor,
+        topk_indices: torch.Tensor,
+        top_lengths: torch.Tensor,
+        main_page_table: torch.Tensor,
+    ) -> torch.Tensor:
+        rows = x.shape[0]
+        if rows == 0:
+            return x.clone()
+        num_reqs = rows // self.block_size
+        qkv = _linear_cpu_or_gpu(self.fused_wqa_wkv, x)
+        q_raw = qkv[:, : self.q_lora_rank].contiguous()
+        kv_raw = qkv[:, self.q_lora_rank : self.q_lora_rank + self.head_dim].contiguous()
+
+        q_lat = _rms_norm(self.q_norm, q_raw)
+        q = _linear_cpu_or_gpu(self.wq_b, q_lat).view(
+            rows, self.n_local_heads, self.head_dim
+        ).contiguous()
+        k_blk = _rms_norm(self.kv_norm, kv_raw).contiguous()
+
+        cos_sin = self.rotary_emb.cos_sin_cache
+        if x.is_cuda:
+            if cos_sin.device != x.device:
+                cos_sin = cos_sin.to(x.device)
+                self.rotary_emb.cos_sin_cache = cos_sin
+            rope_(q, positions, cos_sin, 1, False)
+            rope_(k_blk, positions, cos_sin, 1, False)
+            k_blk_3d = k_blk.view(num_reqs, self.block_size, self.head_dim)
+            if self._plan is None:
+                self._plan = tl_dfly2.DFly2AttentionPlan(
+                    self.n_local_heads,
+                    self.window_size,
+                    self.index_topk,
+                    self._main_page_size,
+                    **self._plan_kwargs(),
+                )
+            attn_out = torch.empty_like(q)
+            scratch = _alloc_attn_scratch(self._plan.scratch_specs(rows), x.device)
+            assert self._target_swa_layer is not None and self._target_main_layer is not None
+            self._plan.run_backbone(
+                q,
+                k_blk_3d,
+                self._target_swa_layer.kv_cache,
+                swa_indices,
+                swa_lengths,
+                self._target_main_layer.kv_cache,
+                topk_indices,
+                top_lengths,
+                main_page_table,
+                self.attn_sink,
+                positions,
+                cos_sin,
+                attn_out,
+                scratch,
+            )
+        else:
+            q = tl_dfly2.apply_rope_cpu(q, positions, cos_sin, inverse=False)
+            k_blk = tl_dfly2.apply_rope_cpu(k_blk, positions, cos_sin, inverse=False)
+            k_blk_3d = k_blk.view(num_reqs, self.block_size, self.head_dim)
+            assert self._target_swa_layer is not None and self._target_main_layer is not None
+            attn_out = tl_dfly2.dfly2_attend_backbone_cpu(
+                q,
+                k_blk_3d,
+                self._target_swa_layer.kv_cache,
+                swa_indices,
+                swa_lengths,
+                self._swa_page_size,
+                self._target_main_layer.kv_cache,
+                topk_indices,
+                top_lengths,
+                main_page_table,
+                self._main_page_size,
+                self.attn_sink,
+                positions,
+                cos_sin,
+            )
+
+        if self._l2pf_ffn is not None and x.is_cuda:
+            l2_prefetch.issue(self._l2pf_ffn, rows)
+        wo_mid = _grouped_wo_a(attn_out, self.wo_a, self.n_local_groups)
+        return _linear_cpu_or_gpu(self.wo_b, wo_mid)
+
+
+class DFly2DecoderLayer(nn.Module):
+    """One DFly2 draft decoder layer: lagged mHC + DFly2Attention + 128-expert MXFP4 MoE."""
+
+    def __init__(
+        self,
+        vllm_config: VllmConfig,
+        dfly_cfg: DFly2ParsedConfig,
+        layer_idx: int,
+        prefix: str,
+    ) -> None:
+        super().__init__()
+        hf = _resolve_draft_text_config(vllm_config.speculative_config.draft_model_config)
+        self.hidden_size = hf.hidden_size
+        self.rms_norm_eps = hf.rms_norm_eps
+        self.attn = DFly2Attention(
+            vllm_config, dfly_cfg, layer_idx, prefix=f"{prefix}.attn"
+        )
+
+        moe_vllm_cfg = copy.copy(vllm_config)
+        moe_vllm_cfg.model_config = copy.copy(vllm_config.model_config)
+        moe_hf = copy.copy(hf)
+        moe_hf.n_routed_experts = dfly_cfg.n_routed_experts
+        moe_hf.num_experts_per_tok = dfly_cfg.num_experts_per_tok
+        moe_hf.num_hash_layers = 0
+        moe_vllm_cfg.model_config.hf_config = moe_hf
+
+        gate = ReplicatedLinear(
+            hf.hidden_size,
+            dfly_cfg.n_routed_experts,
+            bias=False,
+            prefix=f"{prefix}.ffn.gate",
+        )
+        gate.quant_method = kernels.linear_method()
+        gate.out_dtype = torch.float32
+        self.ffn = DeepseekV4MoE(
+            moe_vllm_cfg,
+            prefix=f"{prefix}.ffn",
+            use_sequence_parallel=False,
+            num_hash_layers=0,
+            n_routed_experts=dfly_cfg.n_routed_experts,
+            n_activated_experts=dfly_cfg.num_experts_per_tok,
+            gate=gate,
+            image_sentinel_lo=0,
+            image_sentinel_count=1,
+            router_cls=kernels.moe_router_class(),
+        )
+        router = getattr(self.ffn.experts, "router", None)
+        if hasattr(router, "max_rows"):
+            router.max_rows = (
+                vllm_config.scheduler_config.max_num_seqs * dfly_cfg.block_size
+            )
+
+        shared = getattr(self.ffn, "shared_experts", None)
+        if shared is not None:
+            shared_width = shared.gate_up_proj.output_size_per_partition // 2
+            shared.act_fn = kernels.shared_expert_activation(
+                shared.act_fn, shared_width, mxfp8_output=False
+            )
+            if (
+                getattr(
+                    hf,
+                    "original_moe_intermediate_size",
+                    hf.moe_intermediate_size,
+                )
+                != hf.moe_intermediate_size
+            ):
+                for proj in (shared.gate_up_proj, shared.down_proj):
+                    for param in proj.parameters():
+                        set_weight_attrs(param, {"allow_tp_padding": True})
+
+        self.attn_norm = kernels.rms_norm(self.hidden_size, self.rms_norm_eps)
+        self.ffn_norm = kernels.rms_norm(self.hidden_size, self.rms_norm_eps)
+        self.hc_mult = hf.hc_mult
+        self.hc_sinkhorn_iters = hf.hc_sinkhorn_iters
+        self.hc_eps = hf.hc_eps
+        self.mhc = kernels.mhc(hf)
+        mix_hc = (2 + self.hc_mult) * self.hc_mult
+        hc_dim = self.hc_mult * self.hidden_size
+        self.hc_attn_fn = nn.Parameter(
+            torch.empty((mix_hc, hc_dim), dtype=torch.float32), requires_grad=False
+        )
+        self.hc_attn_fn_broadcast: torch.Tensor | None = None
+        self.hc_ffn_fn = nn.Parameter(
+            torch.empty((mix_hc, hc_dim), dtype=torch.float32), requires_grad=False
+        )
+        self.hc_attn_base = nn.Parameter(
+            torch.empty(mix_hc, dtype=torch.float32), requires_grad=False
+        )
+        self.hc_ffn_base = nn.Parameter(
+            torch.empty(mix_hc, dtype=torch.float32), requires_grad=False
+        )
+        self.hc_attn_scale = nn.Parameter(
+            torch.empty(3, dtype=torch.float32), requires_grad=False
+        )
+        self.hc_ffn_scale = nn.Parameter(
+            torch.empty(3, dtype=torch.float32), requires_grad=False
+        )
+
+    def declare_kernels(self) -> None:
+        from ..tilelang.linear import _warm_casts
+
+        router = getattr(self.ffn.experts, "router", None)
+        declare = getattr(router, "declare_kernels", None)
+        if declare is not None:
+            declare()
+        hidden_size = self.hidden_size
+        prepare.declare(warm=lambda: _warm_casts(hidden_size))
+
+    def forward(
+        self,
+        x: torch.Tensor,
+        positions: torch.Tensor,
+        input_ids: torch.Tensor | None,
+        pre_mix: torch.Tensor | None,
+        post_mix: torch.Tensor | None,
+        res_mix: torch.Tensor | None,
+        residual: torch.Tensor | None,
+        swa_indices: torch.Tensor,
+        swa_lengths: torch.Tensor,
+        topk_indices: torch.Tensor,
+        top_lengths: torch.Tensor,
+        main_page_table: torch.Tensor,
+        is_padding: torch.Tensor | None = None,
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+        if x.is_cuda:
+            previous_output = x if residual is not None else None
+            if residual is None:
+                residual = x
+            fn = (
+                self.hc_attn_fn_broadcast
+                if residual.ndim == 2 and self.hc_attn_fn_broadcast is not None
+                else self.hc_attn_fn
+            )
+            if residual.ndim == 2 and fn is self.hc_attn_fn:
+                residual = residual[:, None, :].expand(-1, self.hc_mult, -1).contiguous()
+            residual, post_mix, res_mix, x_attn, attn_pre, _ = self.mhc.pre(
+                residual,
+                fn,
+                self.hc_attn_scale,
+                self.hc_attn_base,
+                self.attn_norm.weight,
+                pre_mix,
+                previous_output=previous_output,
+                previous_post=post_mix if previous_output is not None else None,
+                previous_comb=res_mix if previous_output is not None else None,
+            )
+            attn_out = self.attn(
+                x_attn,
+                positions,
+                swa_indices,
+                swa_lengths,
+                topk_indices,
+                top_lengths,
+                main_page_table,
+            )
+            residual, post_mix, res_mix, x_ffn, ffn_pre, x_q = self.mhc.post_pre(
+                attn_out,
+                residual,
+                post_mix,
+                res_mix,
+                self.hc_ffn_fn,
+                self.hc_ffn_scale,
+                self.hc_ffn_base,
+                self.ffn_norm.weight,
+                attn_pre,
+            )
+            with kernels.mxfp8_inputs(x_q):
+                ffn_out = self.ffn(x_ffn, input_ids=input_ids)
+            return ffn_out, residual, post_mix, res_mix, ffn_pre
+
+        # CPU reference path (exact lagged mHC + MXFP4 MoE arithmetic)
+        if residual is not None:
+            residual = _mhc_post_cpu(x, residual, post_mix, res_mix)
+        else:
+            residual = x[:, None, :].expand(-1, self.hc_mult, -1).contiguous()
+        attn_pre, post_mix, res_mix = _mhc_mixes_cpu(
+            residual,
+            self.hc_attn_fn,
+            self.hc_attn_scale,
+            self.hc_attn_base,
+            self.hc_mult,
+            self.hc_sinkhorn_iters,
+            self.hc_eps,
+            self.rms_norm_eps,
+        )
+        cur_pre = attn_pre if pre_mix is None else pre_mix
+        x_in = torch.einsum("...k,...kd->...d", cur_pre, residual.to(torch.float32)).to(
+            x.dtype
+        )
+        x_attn = _rms_norm(self.attn_norm, x_in)
+        attn_out = self.attn(
+            x_attn,
+            positions,
+            swa_indices,
+            swa_lengths,
+            topk_indices,
+            top_lengths,
+            main_page_table,
+        )
+        residual = _mhc_post_cpu(attn_out, residual, post_mix, res_mix)
+        ffn_pre, post_mix, res_mix = _mhc_mixes_cpu(
+            residual,
+            self.hc_ffn_fn,
+            self.hc_ffn_scale,
+            self.hc_ffn_base,
+            self.hc_mult,
+            self.hc_sinkhorn_iters,
+            self.hc_eps,
+            self.rms_norm_eps,
+        )
+        x_ffn_in = torch.einsum(
+            "...k,...kd->...d", attn_pre, residual.to(torch.float32)
+        ).to(x.dtype)
+        x_ffn = _rms_norm(self.ffn_norm, x_ffn_in)
+        ffn_out = _moe_forward_cpu(self.ffn, x_ffn, is_padding)
+        return ffn_out, residual, post_mix, res_mix, ffn_pre
+
+
+class DFly2AttentiveCorrection(nn.Module):
+    """Attentive hidden-states correction with gated causal intra-block keys."""
+
+    def __init__(
+        self,
+        vllm_config: VllmConfig,
+        dfly_cfg: DFly2ParsedConfig,
+        prefix: str,
+    ) -> None:
+        super().__init__()
+        hf = _resolve_draft_text_config(vllm_config.speculative_config.draft_model_config)
+        self.vllm_config = vllm_config
+        self.dfly_cfg = dfly_cfg
+        self.hidden_size = hf.hidden_size
+        self.head_dim = hf.head_dim
+        self.rope_dim = hf.qk_rope_head_dim
+        self.q_lora_rank = hf.q_lora_rank
+        self.o_lora_rank = hf.o_lora_rank
+        self.max_block_slots = dfly_cfg.max_block_slots
+        self.window_size = getattr(
+            _resolve_draft_text_config(vllm_config.model_config), "sliding_window", hf.sliding_window
+        )
+        self.index_topk = dfly_cfg.index_topk
+        self.source_draft_layer = dfly_cfg.attentive_source_layer
+
+        tp_size, tp_rank = _tp_world_and_rank()
+        self.tp_size = tp_size
+        self.tp_rank = tp_rank
+        self.orig_num_heads = int(
+            getattr(hf, "original_num_attention_heads", hf.num_attention_heads)
+        )
+        self.n_local_heads = hf.num_attention_heads // tp_size
+        self.n_local_groups = hf.o_groups // tp_size
+        self.head_start = self.n_local_heads * tp_rank
+        self.head_end = self.head_start + self.n_local_heads
+
+        # Fuse q_in (1280), kv_in (512), and block_gate (orig_num_heads = 64)
+        # into one TP-sharded _DFly2MergedColumnParallelLinear over [h_norm | e_norm] (10240).
+        self.fused_qkv_gate = _DFly2MergedColumnParallelLinear(
+            2 * self.hidden_size,
+            [self.q_lora_rank, self.head_dim, self.orig_num_heads],
+            gather_output=True,
+            quant_config=vllm_config.quant_config,
+            prefix=f"{prefix}.fused_qkv_gate",
+        )
+        self.q_norm = kernels.rms_norm(self.q_lora_rank, hf.rms_norm_eps)
+        self.kv_norm = kernels.rms_norm(self.head_dim, hf.rms_norm_eps)
+        self.wq_b = ColumnParallelLinear(
+            self.q_lora_rank,
+            hf.num_attention_heads * self.head_dim,
+            bias=False,
+            return_bias=False,
+            quant_config=vllm_config.quant_config,
+            prefix=f"{prefix}.wq_b",
+        )
+        self.wo_a = ColumnParallelLinear(
+            hf.num_attention_heads * self.head_dim // hf.o_groups,
+            hf.o_groups * hf.o_lora_rank,
+            bias=False,
+            return_bias=False,
+            quant_config=None,
+            prefix=f"{prefix}.wo_a",
+        )
+        self.wo_a.quant_method = UnquantizedLinearMethod()
+        self.wo_b = RowParallelLinear(
+            hf.o_groups * hf.o_lora_rank,
+            self.hidden_size,
+            bias=False,
+            return_bias=False,
+            quant_config=vllm_config.quant_config,
+            reduce_results=False,
+            prefix=f"{prefix}.wo_b",
+        )
+        if self.orig_num_heads != hf.num_attention_heads:
+            for linear in (self.wq_b, self.wo_a, self.wo_b):
+                for param in linear.parameters():
+                    set_weight_attrs(param, {"allow_tp_padding": True})
+
+        self.attn_sink = nn.Parameter(
+            torch.zeros(self.n_local_heads, dtype=torch.float32), requires_grad=False
+        )
+        self.block_sink = nn.Parameter(
+            torch.zeros(self.n_local_heads, dtype=torch.float32), requires_grad=False
+        )
+        self.block_rel_bias = nn.Parameter(
+            torch.zeros((self.n_local_heads, self.max_block_slots), dtype=torch.float32),
+            requires_grad=False,
+        )
+        self.block_gate_bias = nn.Parameter(
+            torch.zeros((self.n_local_heads, self.max_block_slots), dtype=torch.float32),
+            requires_grad=False,
+        )
+        self.rotary_emb = build_deepseek_v4_rope(
+            hf,
+            head_dim=self.head_dim,
+            rope_head_dim=self.rope_dim,
+            max_position_embeddings=max(
+                int(getattr(hf, "max_position_embeddings", 0) or 0),
+                int(vllm_config.model_config.max_model_len),
+            ),
+            compress_ratio=1,
+        )
+        self._target_swa_layer = None
+        self._target_main_layer = None
+        self._swa_page_size = vllm_config.cache_config.swa_block_size or 128
+        self._main_page_size = vllm_config.cache_config.block_size
+        self._plan: tl_dfly2.DFly2AttentionPlan | None = None
+        self.register_buffer(
+            "k_corr_buf",
+            torch.zeros(
+                (
+                    vllm_config.scheduler_config.max_num_seqs,
+                    self.max_block_slots,
+                    self.head_dim,
+                ),
+                dtype=torch.bfloat16,
+            ),
+            persistent=False,
+        )
+
+    def bind_target_layers(self, swa_layer, main_layer) -> None:
+        self._target_swa_layer = swa_layer
+        self._target_main_layer = main_layer
+        self._swa_page_size = swa_layer.block_size
+        self._main_page_size = main_layer._main_page
+
+    def _plan_kwargs(self) -> dict:
+        return dict(
+            swa_page_size=self._swa_page_size,
+            max_rows=self.vllm_config.scheduler_config.max_num_seqs,
+            mode="correction",
+            max_block_slots=self.max_block_slots,
+        )
+
+    def declare_kernels(self) -> None:
+        table_width = self.rotary_emb.cos_sin_cache.shape[1]
+        args = (
+            self.n_local_heads,
+            self.window_size,
+            self.index_topk,
+            self._main_page_size,
+        )
+        kwargs = self._plan_kwargs()
+
+        def calls():
+            out = list(
+                tl_dfly2.DFly2AttentionPlan.calls(
+                    *args,
+                    swa_page_size=kwargs["swa_page_size"],
+                    mode="correction",
+                    max_block_slots=self.max_block_slots,
+                )
+            )
+            if self.n_local_heads > 0:
+                out.append(rope_call(self.n_local_heads, self.head_dim, table_width, 1, False))
+            out.append(rope_call(1, self.head_dim, table_width, 1, False))
+            return out
+
+        def bind():
+            self._plan = tl_dfly2.DFly2AttentionPlan(*args, **kwargs)
+
+        prepare.declare(calls, bind=bind)
+
+    def _slice_local_gate_logits(self, full_gate: torch.Tensor) -> torch.Tensor:
+        valid_end = min(self.head_end, self.orig_num_heads)
+        if self.head_start >= valid_end:
+            return full_gate.new_zeros((full_gate.shape[0], self.n_local_heads))
+        local_valid = full_gate[:, self.head_start : valid_end]
+        if local_valid.shape[1] == self.n_local_heads:
+            return local_valid.contiguous()
+        out = full_gate.new_zeros((full_gate.shape[0], self.n_local_heads))
+        out[:, : local_valid.shape[1]] = local_valid
+        return out
+
+    def record_slot0_and_project_slot1(
+        self,
+        z_0: torch.Tensor,
+        z_1: torch.Tensor,
+        pos_0: torch.Tensor,
+    ) -> torch.Tensor:
+        """Batch ``[z_0; z_1]`` through ``fused_qkv_gate``, store rotated ``k_corr[:, 0]``,
+        and return ``qkv_gate_1`` for slot 1 (saving one TP all-gather per step)."""
+        bsz = z_0.shape[0]
+        if bsz == 0:
+            return z_1.new_empty((0, self.fused_qkv_gate.logical_output_size))
+        if self.k_corr_buf.device != z_0.device:
+            self.k_corr_buf = self.k_corr_buf.to(z_0.device)
+        both = _linear_cpu_or_gpu(self.fused_qkv_gate, torch.cat([z_0, z_1], dim=0))
+        qkv_0 = both[:bsz]
+        qkv_1 = both[bsz:]
+        kv_raw_0 = qkv_0[
+            :, self.q_lora_rank : self.q_lora_rank + self.head_dim
+        ].contiguous()
+        k_0 = _rms_norm(self.kv_norm, kv_raw_0).contiguous()
+        cos_sin = self.rotary_emb.cos_sin_cache
+        if z_0.is_cuda:
+            if cos_sin.device != z_0.device:
+                cos_sin = cos_sin.to(z_0.device)
+                self.rotary_emb.cos_sin_cache = cos_sin
+            rope_(k_0, pos_0.contiguous(), cos_sin, 1, False)
+        else:
+            k_0 = tl_dfly2.apply_rope_cpu(k_0, pos_0, cos_sin, inverse=False)
+        self.k_corr_buf[:bsz, 0].copy_(k_0)
+        return qkv_1
+
+    def forward_step(
+        self,
+        z_j: torch.Tensor,
+        pos_j: torch.Tensor,
+        step_idx: int,
+        swa_indices: torch.Tensor,
+        swa_lengths: torch.Tensor,
+        topk_indices: torch.Tensor,
+        top_lengths: torch.Tensor,
+        main_page_table: torch.Tensor,
+        *,
+        precomputed_qkv_gate: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        """Run one sequential attentive-correction slot ``step_idx`` (``1 .. B_sz-1``);
+        returns unreduced local TP partial ``wo_b`` output ``[B, hidden_size]``."""
+        bsz = z_j.shape[0]
+        if bsz == 0:
+            return z_j.new_empty((0, self.hidden_size))
+        if self.k_corr_buf.device != z_j.device:
+            self.k_corr_buf = self.k_corr_buf.to(z_j.device)
+
+        qkv_gate = (
+            precomputed_qkv_gate
+            if precomputed_qkv_gate is not None
+            else _linear_cpu_or_gpu(self.fused_qkv_gate, z_j)
+        )
+        q_raw = qkv_gate[:, : self.q_lora_rank].contiguous()
+        kv_raw = qkv_gate[
+            :, self.q_lora_rank : self.q_lora_rank + self.head_dim
+        ].contiguous()
+        gate_all = qkv_gate[
+            :,
+            self.q_lora_rank + self.head_dim : self.q_lora_rank
+            + self.head_dim
+            + self.orig_num_heads,
+        ]
+        gate_logits = self._slice_local_gate_logits(gate_all)
+
+        q_lat = _rms_norm(self.q_norm, q_raw)
+        q = _linear_cpu_or_gpu(self.wq_b, q_lat).view(
+            bsz, self.n_local_heads, self.head_dim
+        ).contiguous()
+        k_j = _rms_norm(self.kv_norm, kv_raw).contiguous()
+
+        cos_sin = self.rotary_emb.cos_sin_cache
+        if z_j.is_cuda:
+            if cos_sin.device != z_j.device:
+                cos_sin = cos_sin.to(z_j.device)
+                self.rotary_emb.cos_sin_cache = cos_sin
+            pos_j = pos_j.contiguous()
+            rope_(q, pos_j, cos_sin, 1, False)
+            rope_(k_j, pos_j, cos_sin, 1, False)
+            self.k_corr_buf[:bsz, step_idx].copy_(k_j)
+            if self._plan is None:
+                self._plan = tl_dfly2.DFly2AttentionPlan(
+                    self.n_local_heads,
+                    self.window_size,
+                    self.index_topk,
+                    self._main_page_size,
+                    **self._plan_kwargs(),
+                )
+            attn_out = torch.empty_like(q)
+            scratch = _alloc_attn_scratch(self._plan.scratch_specs(bsz), z_j.device)
+            assert self._target_swa_layer is not None and self._target_main_layer is not None
+            self._plan.run_correction(
+                q,
+                self.k_corr_buf[:bsz],
+                self._target_swa_layer.kv_cache,
+                swa_indices,
+                swa_lengths,
+                self._target_main_layer.kv_cache,
+                topk_indices,
+                top_lengths,
+                main_page_table,
+                self.attn_sink,
+                self.block_sink,
+                self.block_rel_bias,
+                gate_logits,
+                self.block_gate_bias,
+                pos_j,
+                cos_sin,
+                step_idx,
+                attn_out,
+                scratch,
+            )
+        else:
+            q = tl_dfly2.apply_rope_cpu(q, pos_j, cos_sin, inverse=False)
+            k_j = tl_dfly2.apply_rope_cpu(k_j, pos_j, cos_sin, inverse=False)
+            self.k_corr_buf[:bsz, step_idx].copy_(k_j)
+            assert self._target_swa_layer is not None and self._target_main_layer is not None
+            attn_out = tl_dfly2.dfly2_attend_correction_cpu(
+                q,
+                self.k_corr_buf[:bsz],
+                self._target_swa_layer.kv_cache,
+                swa_indices,
+                swa_lengths,
+                self._swa_page_size,
+                self._target_main_layer.kv_cache,
+                topk_indices,
+                top_lengths,
+                main_page_table,
+                self._main_page_size,
+                self.attn_sink,
+                self.block_sink,
+                self.block_rel_bias,
+                gate_logits,
+                self.block_gate_bias,
+                pos_j,
+                cos_sin,
+                step_idx,
+            )
+
+        wo_mid = _grouped_wo_a(attn_out, self.wo_a, self.n_local_groups)
+        return _linear_cpu_or_gpu(self.wo_b, wo_mid)
+
+
+class DFly2HiddenCorrection(nn.Module):
+    """TreeFlash + Attentive hidden-states correction with fused TP all-reduce."""
+
+    def __init__(
+        self,
+        vllm_config: VllmConfig,
+        dfly_cfg: DFly2ParsedConfig,
+        prefix: str,
+    ) -> None:
+        super().__init__()
+        hf = _resolve_draft_text_config(vllm_config.speculative_config.draft_model_config)
+        self.hidden_size = hf.hidden_size
+        assert dfly_cfg.hidden_correction_intermediate is not None
+        self.intermediate_size = dfly_cfg.hidden_correction_intermediate
+        tp_size, _ = _tp_world_and_rank()
+        self.tp_size = tp_size
+        self.padded_intermediate = round_up(self.intermediate_size, tp_size * 64)
+
+        self.hidden_norm = kernels.rms_norm(self.hidden_size, hf.rms_norm_eps)
+        self.embed_norm = kernels.rms_norm(self.hidden_size, hf.rms_norm_eps)
+        self.gate_up_proj = MergedColumnParallelLinear(
+            2 * self.hidden_size,
+            [self.padded_intermediate, self.padded_intermediate],
+            bias=False,
+            quant_config=vllm_config.quant_config,
+            prefix=f"{prefix}.gate_up_proj",
+        )
+        self.down_proj = RowParallelLinear(
+            self.padded_intermediate,
+            self.hidden_size,
+            bias=False,
+            quant_config=vllm_config.quant_config,
+            reduce_results=False,
+            prefix=f"{prefix}.down_proj",
+        )
+        if self.padded_intermediate != self.intermediate_size:
+            for proj in (self.gate_up_proj, self.down_proj):
+                for param in proj.parameters():
+                    set_weight_attrs(param, {"allow_tp_padding": True})
+
+        self.local_intermediate = self.padded_intermediate // tp_size
+        self._swiglu_kernel = None
+        self.attention = (
+            DFly2AttentiveCorrection(
+                vllm_config, dfly_cfg, prefix=f"{prefix}.attention"
+            )
+            if dfly_cfg.attentive_source_layer >= 0
+            else None
+        )
+
+    def declare_kernels(self) -> None:
+        if self.local_intermediate % 8 != 0:
+            return
+        call_item = tl_dfly2.swiglu_call(self.local_intermediate)
+        prepare.declare(
+            lambda: [call_item],
+            bind=lambda: setattr(self, "_swiglu_kernel", prepare.launch(call_item)),
+        )
+
+    def _mlp_local(self, z: torch.Tensor) -> torch.Tensor:
+        gu = _linear_cpu_or_gpu(self.gate_up_proj, z)
+        half = gu.shape[-1] // 2
+        if z.is_cuda and half % 8 == 0:
+            if self._swiglu_kernel is None:
+                self._swiglu_kernel = prepare.launch(tl_dfly2.swiglu_call(half))
+            act = torch.empty((gu.shape[0], half), dtype=z.dtype, device=z.device)
+            self._swiglu_kernel(gu, act)
+        else:
+            act = (
+                F.silu(gu[:, :half].to(torch.float32)) * gu[:, half:].to(torch.float32)
+            ).to(z.dtype)
+        return _linear_cpu_or_gpu(self.down_proj, act)
+
+    def forward_step(
+        self,
+        h_j: torch.Tensor,
+        e_norm_prev: torch.Tensor,
+        pos_j: torch.Tensor,
+        step_idx: int,
+        swa_indices: torch.Tensor,
+        swa_lengths: torch.Tensor,
+        topk_indices: torch.Tensor,
+        top_lengths: torch.Tensor,
+        main_page_table: torch.Tensor,
+        *,
+        precomputed_h_norm: torch.Tensor | None = None,
+        precomputed_z: torch.Tensor | None = None,
+        precomputed_qkv_gate: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        h_norm = (
+            precomputed_h_norm
+            if precomputed_h_norm is not None
+            else _rms_norm(self.hidden_norm, h_j)
+        )
+        z_j = (
+            precomputed_z
+            if precomputed_z is not None
+            else torch.cat([h_norm, e_norm_prev], dim=-1)
+        )
+        delta_local = self._mlp_local(z_j)
+        if self.attention is not None:
+            attn_local = self.attention.forward_step(
+                z_j,
+                pos_j,
+                step_idx,
+                swa_indices,
+                swa_lengths,
+                topk_indices,
+                top_lengths,
+                main_page_table,
+                precomputed_qkv_gate=precomputed_qkv_gate,
+            )
+            delta_local = delta_local + attn_local
+        if self.tp_size > 1:
+            delta = tensor_model_parallel_all_reduce(delta_local)
+        else:
+            delta = delta_local
+        return h_j + delta.to(h_j.dtype)
+
+
+class DFly2DeepseekV4Model(nn.Module):
+    """Inner DFly2 model owning MTPFusion, 3 draft layers, final_norm, and correction."""
+
+    def __init__(self, *, vllm_config: VllmConfig, prefix: str = "") -> None:
+        super().__init__()
+        assert vllm_config.speculative_config is not None
+        hf = _resolve_draft_text_config(vllm_config.speculative_config.draft_model_config)
+        self.config = hf
+        self.vllm_config = vllm_config
+        self.dfly_cfg = DFly2ParsedConfig.from_hf_config(vllm_config.speculative_config.draft_model_config.hf_config, hf)
+        self.hidden_size = hf.hidden_size
+        self.block_size = self.dfly_cfg.block_size
+
+        if _pp_needs_own_embed():
+            self.embed_tokens: nn.Module | None = VocabParallelEmbedding(
+                hf.vocab_size,
+                hf.hidden_size,
+                quant_config=vllm_config.quant_config,
+                prefix=maybe_prefix(prefix, "embed_tokens"),
+            )
+        else:
+            self.embed_tokens = None
+
+        self.mtp_fusion = (
+            DFly2MTPFusion(
+                hf.hidden_size,
+                self.dfly_cfg.mtp_fusion_mode,
+                hf.rms_norm_eps,
+                vllm_config.quant_config,
+                prefix=maybe_prefix(prefix, "mtp_fusion"),
+            )
+            if self.dfly_cfg.mtp_fusion_mode is not None
+            else None
+        )
+
+        self.layers = nn.ModuleList(
+            [
+                DFly2DecoderLayer(
+                    vllm_config,
+                    self.dfly_cfg,
+                    i,
+                    prefix=maybe_prefix(prefix, f"layers.{i}"),
+                )
+                for i in range(len(self.dfly_cfg.target_kv_layers))
+            ]
+        )
+        self.final_norm = kernels.rms_norm(hf.hidden_size, hf.rms_norm_eps)
+        self.hidden_correction = (
+            DFly2HiddenCorrection(
+                vllm_config,
+                self.dfly_cfg,
+                prefix=maybe_prefix(prefix, "hidden_correction"),
+            )
+            if self.dfly_cfg.hidden_correction_intermediate is not None
+            else None
+        )
+        self._l2pf_ready = False
+        self._mask_embed_cache: torch.Tensor | None = None
+        self._mask_embed_source_id: int = 0
+
+    def cache_mask_embed(self, device: torch.device | None = None) -> torch.Tensor:
+        """Compute and cache the single constant ``mask_token_id`` embedding vector."""
+        assert self.embed_tokens is not None
+        src_id = id(self.embed_tokens)
+        target_dev = device if device is not None else self.embed_tokens.weight.device
+        if (
+            self._mask_embed_cache is not None
+            and self._mask_embed_source_id == src_id
+            and self._mask_embed_cache.device == target_dev
+        ):
+            return self._mask_embed_cache
+        mask_id = torch.tensor(
+            [self.dfly_cfg.mask_token_id], dtype=torch.int32, device=target_dev
+        )
+        self._mask_embed_cache = self.embed_input_ids(mask_id).detach().clone()
+        self._mask_embed_source_id = src_id
+        return self._mask_embed_cache
+
+    def embed_input_ids(self, input_ids: torch.Tensor) -> torch.Tensor:
+        assert self.embed_tokens is not None
+        if input_ids.is_cuda or isinstance(
+            getattr(self.embed_tokens, "quant_method", None), UnquantizedLinearMethod
+        ):
+            return self.embed_tokens(input_ids)
+        # CPU fallback when target embed_tokens uses TileLangEmbeddingMethod
+        w = self.embed_tokens.weight
+        tp_size, tp_rank = _tp_world_and_rank()
+        if tp_size == 1:
+            return F.embedding(input_ids.to(torch.int64), w[: self.config.vocab_size])
+        shard = self.embed_tokens.shard_indices
+        start = shard.org_vocab_start_index
+        end = shard.org_vocab_end_index
+        ids = input_ids.to(torch.int64)
+        mask = (ids >= start) & (ids < end)
+        local_ids = (ids - start).clamp(min=0, max=max(end - start - 1, 0))
+        out = F.embedding(local_ids, w)
+        out = torch.where(mask.unsqueeze(-1), out, torch.zeros_like(out))
+        return tensor_model_parallel_all_reduce(out)
+
+    def _build_l2_prefetch(self) -> bool:
+        if not self.layers:
+            return True
+        device = self.layers[0].hc_attn_fn.device
+        if device.type != "cuda":
+            return True
+        for idx, layer in enumerate(self.layers):
+            ffn = l2_prefetch.param_segments(
+                "mhc", layer, ("hc_ffn_fn", "hc_ffn_scale", "hc_ffn_base")
+            )
+            ffn += l2_prefetch.param_segments("ffn_norm", layer.ffn_norm, ("weight",))
+            ffn += l2_prefetch.linear_segments("gate", layer.ffn.gate)
+            shared = getattr(layer.ffn, "shared_experts", None)
+            for name in ("gate_up_proj", "down_proj"):
+                ffn += l2_prefetch.linear_segments(name, getattr(shared, name, None))
+            layer.attn._l2pf_ffn = l2_prefetch.make_plan(
+                ffn, l2_prefetch.BUDGET_FFN, device
+            )
+            if idx + 1 < len(self.layers):
+                nxt = self.layers[idx + 1]
+                segs = l2_prefetch.param_segments(
+                    "mhc",
+                    nxt,
+                    ("hc_attn_fn", "hc_attn_scale", "hc_attn_base"),
+                )
+                segs += l2_prefetch.param_segments(
+                    "attn_norm", nxt.attn_norm, ("weight",)
+                )
+                segs += l2_prefetch.linear_segments("wqa_wkv", nxt.attn.fused_wqa_wkv)
+                segs += l2_prefetch.linear_segments("wq_b", nxt.attn.wq_b)
+                plan_next = l2_prefetch.make_plan(segs, l2_prefetch.BUDGET_NEXT, device)
+                if plan_next is not None:
+                    object.__setattr__(
+                        layer.ffn.experts,
+                        "_l2_prefetch_pre_reduce_hook",
+                        lambda n, p=plan_next: l2_prefetch.issue(p, n),
+                    )
+        return True
+
+    def forward_backbone(
+        self,
+        block_input_ids: torch.Tensor,
+        block_positions: torch.Tensor,
+        prev_hidden: torch.Tensor,
+        mtp_valid: torch.Tensor,
+        swa_indices: torch.Tensor,
+        swa_lengths: torch.Tensor,
+        topk_indices: torch.Tensor,
+        top_lengths: torch.Tensor,
+        main_page_table: torch.Tensor,
+        is_padding: torch.Tensor | None = None,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """Run embedding + MTPFusion + 3 draft layers + final_norm.
+
+        Returns ``(backbone_normed [B, block_size, D], raw_anchor_embeds [B, D])``.
+        """
+        rows = block_input_ids.shape[0]
+        bsz = rows // self.block_size
+        if (
+            self._mask_embed_cache is not None
+            and self._mask_embed_source_id == id(self.embed_tokens)
+            and self._mask_embed_cache.device == block_input_ids.device
+        ):
+            anchor_ids = (
+                block_input_ids.view(bsz, self.block_size)[:, 0].contiguous()
+            )
+            raw_anchor_embeds = self.embed_input_ids(anchor_ids)
+            block_embeds = (
+                self._mask_embed_cache.expand(bsz, self.block_size, self.hidden_size)
+                .contiguous()
+            )
+            block_embeds[:, 0].copy_(raw_anchor_embeds)
+            block_embeds = block_embeds.view(rows, self.hidden_size)
+        else:
+            block_embeds = self.embed_input_ids(block_input_ids)
+            raw_anchor_embeds = (
+                block_embeds.view(bsz, self.block_size, self.hidden_size)[:, 0].clone()
+            )
+        if self.mtp_fusion is not None:
+            block_embeds = self.mtp_fusion(
+                block_embeds,
+                raw_anchor_embeds,
+                prev_hidden,
+                mtp_valid,
+                self.block_size,
+            )
+
+        hidden_states = block_embeds
+        residual = post_mix = res_mix = pre_mix = None
+        if hidden_states.is_cuda and l2_prefetch.ENABLED and not self._l2pf_ready:
+            self._l2pf_ready = self._build_l2_prefetch()
+
+        use_async_sinkhorn = bool(
+            hidden_states.is_cuda
+            and self.layers
+            and getattr(
+                getattr(self.layers[0], "mhc", None), "supports_async_sinkhorn", False
+            )
+        )
+        with kernels.async_sinkhorn(use_async_sinkhorn):
+            for idx, layer in enumerate(self.layers):
+                hidden_states, residual, post_mix, res_mix, pre_mix = layer(
+                    hidden_states,
+                    block_positions,
+                    block_input_ids,
+                    pre_mix,
+                    post_mix,
+                    res_mix,
+                    residual,
+                    swa_indices[idx],
+                    swa_lengths[idx],
+                    topk_indices[idx],
+                    top_lengths,
+                    main_page_table,
+                    is_padding=is_padding,
+                )
+        if hidden_states.is_cuda:
+            l2_prefetch.join()
+
+        assert pre_mix is not None and residual is not None
+        last_layer = self.layers[-1]
+        if hidden_states.is_cuda:
+            if hasattr(last_layer.mhc, "post_collapse"):
+                collapsed = last_layer.mhc.post_collapse(
+                    hidden_states, residual, post_mix, res_mix, pre_mix
+                )
+            else:
+                residual = last_layer.mhc.post(
+                    hidden_states, residual, post_mix, res_mix
+                )
+                collapsed = last_layer.mhc.collapse(residual, pre_mix)
+        else:
+            residual = _mhc_post_cpu(hidden_states, residual, post_mix, res_mix)
+            collapsed = torch.einsum(
+                "...k,...kd->...d", pre_mix, residual.to(torch.float32)
+            ).to(hidden_states.dtype)
+
+        normed = _rms_norm(self.final_norm, collapsed)
+        return normed.view(bsz, self.block_size, self.hidden_size), raw_anchor_embeds
+
+
+class DFly2DeepseekV4ForCausalLM(nn.Module):
+    """Top-level DFly2 draft CausalLM registered as ``DFlyDeepseekV41DraftModel``."""
+
+    has_own_embed_tokens = False
+    has_own_lm_head = False
+    draft_id_to_target_id = None
+
+    def __init__(self, *, vllm_config: VllmConfig, prefix: str = "") -> None:
+        super().__init__()
+        assert vllm_config.speculative_config is not None
+        self.vllm_config = vllm_config
+        self.draft_model_config = vllm_config.speculative_config.draft_model_config
+        self.config = _resolve_draft_text_config(self.draft_model_config)
+        self.quant_config = vllm_config.quant_config
+        from vllm.utils.torch_utils import set_default_torch_dtype
+
+        with set_default_torch_dtype(self.draft_model_config.dtype):
+            self.model = DFly2DeepseekV4Model(
+                vllm_config=vllm_config, prefix=maybe_prefix(prefix, "dfly2_model")
+            )
+        self.dfly_cfg = self.model.dfly_cfg
+        if self.model.embed_tokens is not None:
+            self.has_own_embed_tokens = True
+        self.lm_head: nn.Module | None = None
+        self.logits_processor = LogitsProcessor(self.config.vocab_size)
+
+    def embed_input_ids(self, input_ids: torch.Tensor) -> torch.Tensor:
+        return self.model.embed_input_ids(input_ids)
+
+    def bind_target_layers(self, target_model: nn.Module) -> list[nn.Module]:
+        """Bind target SWA/compressed-MLA cache layers and return index source layers."""
+        lang = (
+            target_model.get_language_model()
+            if hasattr(target_model, "get_language_model")
+            else target_model
+        )
+        target_layers = lang.model.layers
+        for i, draft_layer in enumerate(self.model.layers):
+            kv_lid = self.dfly_cfg.target_kv_layers[i]
+            tgt_attn = target_layers[kv_lid].attn
+            draft_layer.attn.bind_target_layers(
+                tgt_attn.swa_cache_layer, tgt_attn._owner()
+            )
+        hc = self.model.hidden_correction
+        if hc is not None and hc.attention is not None:
+            src_i = hc.attention.source_draft_layer
+            kv_lid = self.dfly_cfg.target_kv_layers[src_i]
+            tgt_attn = target_layers[kv_lid].attn
+            hc.attention.bind_target_layers(
+                tgt_attn.swa_cache_layer, tgt_attn._owner()
+            )
+        return [
+            target_layers[lid].attn for lid in self.dfly_cfg.target_index_layers
+        ]
+
+    @property
+    def draft_vocab_shard(self) -> tuple[int, int]:
+        assert self.lm_head is not None
+        shard = self.lm_head.shard_indices
+        return shard.org_vocab_start_index, shard.num_org_elements
+
+    def supports_vocab_parallel_greedy(self) -> bool:
+        return (
+            self.lm_head is not None
+            and hasattr(self.lm_head, "tilelang_vocab_greedy")
+            and self.logits_processor.scale == 1.0
+        )
+
+    def greedy_pairs_local(
+        self, hidden_states: torch.Tensor, *, top_k: int = 2
+    ) -> tuple[torch.Tensor, torch.Tensor | None]:
+        assert self.lm_head is not None
+        from ..tilelang.vocab import project_head_greedy_pairs
+
+        vocab_start, shard_vocab = self.draft_vocab_shard
+        res = project_head_greedy_pairs(
+            self.lm_head,
+            hidden_states,
+            vocab=shard_vocab,
+            vocab_start=vocab_start,
+            pair_width=4,
+            top_k=top_k,
+        )
+        if isinstance(res, tuple):
+            return res
+        return res, None
+
+    def compute_logits(self, hidden_states: torch.Tensor) -> torch.Tensor | None:
+        assert self.lm_head is not None
+        if hidden_states.is_cuda:
+            return self.logits_processor(self.lm_head, hidden_states)
+        w = self.lm_head.weight
+        tp_size, _ = _tp_world_and_rank()
+        if tp_size == 1:
+            return F.linear(
+                hidden_states.to(torch.float32),
+                w[: self.config.vocab_size].to(torch.float32),
+            )
+        local = F.linear(hidden_states.to(torch.float32), w.to(torch.float32))
+        from vllm.distributed import tensor_model_parallel_all_gather
+
+        return tensor_model_parallel_all_gather(local, dim=-1)[
+            :, : self.config.vocab_size
+        ]
+
+    def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:
+        expert_mapping = fused_moe_make_expert_params_mapping(
+            self,
+            ckpt_gate_proj_name="w1",
+            ckpt_down_proj_name="w2",
+            ckpt_up_proj_name="w3",
+            num_experts=self.dfly_cfg.n_routed_experts,
+        )
+        expert_mapping_by_key: dict[str, list[tuple[str, str, int, str]]] = {}
+        for mapping in expert_mapping:
+            expert_mapping_by_key.setdefault(mapping[1], []).append(mapping)
+
+        params_dict = dict(self.named_parameters())
+        loaded_params: set[str] = set()
+
+        tp_size, tp_rank = _tp_world_and_rank()
+        n_local_heads = self.config.num_attention_heads // tp_size
+        head_start = n_local_heads * tp_rank
+        head_end = head_start + n_local_heads
+
+        layer_stacked = (
+            (".gate_up_proj.", ".w1.", 0),
+            (".gate_up_proj.", ".w3.", 1),
+            (".attn.fused_wqa_wkv.", ".attn.wq_a.", 0),
+            (".attn.fused_wqa_wkv.", ".attn.wkv.", 1),
+        )
+        hc_stacked = (
+            ("hidden_correction.gate_up_proj.", "hidden_correction.gate_proj.", 0),
+            ("hidden_correction.gate_up_proj.", "hidden_correction.up_proj.", 1),
+            (
+                "hidden_correction.attention.fused_qkv_gate.",
+                "hidden_correction.attention.q_in.",
+                0,
+            ),
+            (
+                "hidden_correction.attention.fused_qkv_gate.",
+                "hidden_correction.attention.kv_in.",
+                1,
+            ),
+            (
+                "hidden_correction.attention.fused_qkv_gate.",
+                "hidden_correction.attention.block_gate.",
+                2,
+            ),
+        )
+
+        for raw_name, loaded_weight in weights:
+            name = raw_name if raw_name.startswith("model.") else f"model.{raw_name}"
+            name = name.replace(".self_attn.", ".attn.").replace(".mlp.", ".ffn.")
+            if name.startswith("model.attentive_correction."):
+                name = name.replace(
+                    "model.attentive_correction.",
+                    "model.hidden_correction.attention.",
+                    1,
+                )
+
+            # Unused VL router bias in text-only draft checkpoints (all zeros).
+            if name.endswith(".ffn.gate.bias_vl"):
+                if name not in params_dict or params_dict[name] is None:
+                    continue
+
+            if _EXPERT_SCALE_RE.search(name):
+                name = name.removesuffix(".scale") + ".weight_scale"
+            if ".shared_experts.w2." in name:
+                name = name.replace(".shared_experts.w2.", ".shared_experts.down_proj.")
+
+            if ".experts." in name:
+                if (
+                    "weight_scale" in name
+                    and loaded_weight.dtype == torch.float8_e8m0fnu
+                ):
+                    loaded_weight = loaded_weight.view(torch.uint8)
+                _, _, rest = name.partition(".experts.")
+                d1 = rest.find(".")
+                d2 = rest.find(".", d1 + 1) if d1 != -1 else -1
+                candidates = (
+                    expert_mapping_by_key.get(f"experts.{rest[: d2 + 1]}")
+                    if d2 != -1
+                    else None
+                )
+                for param_name, weight_name, expert_id, shard_id in (
+                    candidates if candidates is not None else expert_mapping
+                ):
+                    if weight_name not in name:
+                        continue
+                    name_mapped = name.replace(weight_name, param_name)
+                    param = params_dict[name_mapped]
+                    success = param.weight_loader(
+                        param,
+                        loaded_weight,
+                        name_mapped,
+                        shard_id=shard_id,
+                        expert_id=expert_id,
+                        return_success=True,
+                    )
+                    if success:
+                        loaded_params.add(name_mapped)
+                        break
+                continue
+
+            if name.startswith("model.layers."):
+                matched = False
+                for param_name, weight_name, shard_id in layer_stacked:
+                    if weight_name in name:
+                        mapped = name.replace(weight_name, param_name)
+                        param = params_dict[mapped]
+                        param.weight_loader(param, loaded_weight, shard_id)
+                        loaded_params.add(mapped)
+                        matched = True
+                        break
+                if matched:
+                    continue
+
+            if name.startswith("model.hidden_correction."):
+                matched = False
+                for param_name, weight_name, shard_id in hc_stacked:
+                    if weight_name in name:
+                        mapped = name.replace(weight_name, param_name)
+                        param = params_dict[mapped]
+                        param.weight_loader(param, loaded_weight, shard_id)
+                        loaded_params.add(mapped)
+                        matched = True
+                        break
+                if matched:
+                    continue
+
+            if name.endswith(
+                (".attn_sink", ".block_sink", ".block_rel_bias", ".block_gate_bias")
+            ):
+                param = params_dict[name]
+                param.data.zero_()
+                if head_start < loaded_weight.shape[0]:
+                    narrow = loaded_weight[
+                        head_start : min(head_end, loaded_weight.shape[0])
+                    ]
+                    copy_weight(param.data[: narrow.shape[0]], narrow)
+                loaded_params.add(name)
+                continue
+
+            if name.endswith(".ffn.gate.bias"):
+                name = name.replace(
+                    ".ffn.gate.bias", ".ffn.gate.e_score_correction_bias"
+                )
+
+            if name not in params_dict:
+                raise KeyError(f"Unexpected DFly2 checkpoint tensor: {raw_name!r} ({name!r})")
+            param = params_dict[name]
+            loader = getattr(param, "weight_loader", default_weight_loader)
+            loader(param, loaded_weight)
+            loaded_params.add(name)
+
+        logger.info_once("DFly2 draft model loaded: %d parameters", len(loaded_params))
+        return loaded_params
+
+    def process_weights_after_loading(self) -> None:
+        if not self.model.layers:
+            return
+        first_layer = self.model.layers[0]
+        broadcast = (
+            first_layer.hc_attn_fn.detach()
+            .view(-1, first_layer.hc_mult, first_layer.hidden_size)
+            .sum(dim=1)
+        )
+        if first_layer.hc_attn_fn_broadcast is None:
+            first_layer.hc_attn_fn_broadcast = broadcast
+        else:
+            first_layer.hc_attn_fn_broadcast.copy_(broadcast)
