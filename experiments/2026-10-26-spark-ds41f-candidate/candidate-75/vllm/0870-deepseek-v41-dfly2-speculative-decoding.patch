+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""TileLang kernels and CPU reference helpers for DeepSeek-V4.1 DFly2 drafting.
+
+DFly2 shares the target model\x27s SWA and compressed-MLA KV caches and its
+selected DSA top-k indices, without allocating any draft KV cache:
+
+- Backbone draft layers (3 layers, ``6 * B`` rows) read ``[128 SWA | 512 top-k]``
+  from the target\x27s SWA and global compressed KV caches via ``sparse_mla_fwd_v41``
+  (``segments_only=True, row_stride_div=block_size``), fold the ``block_size``
+  bidirectional BF16 intra-block latents + ``attn_sink``, and apply inverse RoPE
+  in BF16 (without FP8 ``act_quant``, as DFly2\x27s ``wo_a`` is BF16).
+- Attentive correction (``B`` rows per sequential slot ``1 .. block_size - 1``)
+  reads ``[128 SWA | 512 top-k]`` from the target\x27s source layer, computes the
+  separate causal gated intra-block attention over ``0 .. step_idx`` with
+  ``block_rel_bias``, ``block_sink`` and ``tanh(block_gate + block_gate_bias)``,
+  combines ``read_ctx + block_read`` in FP32 -> BF16, and applies inverse RoPE.
+- ``dfly2_prepare_step_kernel`` populates all fixed-address input and metadata
+  buffers on device in one launch prior to CUDA graph replay.
+"""
+
+# No `from __future__ import annotations`: TileLang inspects prim_func annotations eagerly.
+import math
+
+import tilelang
+import tilelang.language as T
+import torch
+
+from . import pdl, prepare
+from .sparse_mla import (
+    HEAD_DIM,
