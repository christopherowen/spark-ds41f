+def test_dfly2_docstrings_and_mask_cache_and_graph_active_steps():
+    from vllm.config.vllm import set_current_vllm_config
+    from vllm.v1.worker.gpu.spec_decode.speculator import _target_feeds_hc_residual
+
+    assert _target_feeds_hc_residual.__doc__ is not None
+    assert "HC residual" in _target_feeds_hc_residual.__doc__
