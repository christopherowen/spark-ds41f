             predictor, next_cache = next_lookahead
-            pred_experts = predictor.predict_experts(lookahead_hidden)
+            live_mask = (topk_ids_np >= 0).any(axis=-1)
+            if not live_mask.all():
+                live_idx = torch.as_tensor(
+                    np.flatnonzero(live_mask),
+                    dtype=torch.long,
+                    device=lookahead_hidden.device,
+                )
+                lookahead_input = lookahead_hidden.reshape(
+                    -1, lookahead_hidden.shape[-1]
+                ).index_select(0, live_idx)
+            else:
+                lookahead_input = lookahead_hidden
+            pred_experts = predictor.predict_experts(lookahead_input)
             if pred_experts:
                 next_cache.prefetch_async(pred_experts)
 
