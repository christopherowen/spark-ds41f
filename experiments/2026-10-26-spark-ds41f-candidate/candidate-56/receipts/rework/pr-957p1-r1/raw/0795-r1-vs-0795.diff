@@ -73,6 +74,29 @@ ENABLED = _enabled()
 BUDGET_WO = _l2pf._mb("VLLM_DS41_L2_PREFETCH_WO_MB", "20")
 BUDGET_FFN = _l2pf._mb("VLLM_DS41_L2_PREFETCH_FFN_MB", "16")
 BUDGET_NEXT = _l2pf._mb("VLLM_DS41_L2_PREFETCH_NEXT_MB", "20")
+# COMP's budget, when set: None takes ``comp_budget``'s default.
+BUDGET_COMP = (
+    _l2pf._mb("VLLM_DS41_L2_PREFETCH_COMP_MB", "0")
+    if os.getenv("VLLM_DS41_L2_PREFETCH_COMP_MB") is not None
+    else None
+)
+
+
+def comp_budget(linear: torch.nn.Module) -> int:
+    """The COMP window's fill budget for a compressor projection.
+
+    COMP is issued after Q-B, close to the projection that reads it, and WO's
+    18.9 MB fill queues behind it. A TP rank's 12-bit shard (1-2 MB above TP4)
+    lands in time, so it is prefetched whole, within WO's budget. The replicated
+    BF16 weight through TP4 (10.5 MB at ratio two, 5.2 MB at ratio one) does not:
+    its fill races the projection, which then reads DRAM beside it, and COMP plus
+    WO overflow the 24 MB L2. So a replicated weight gets no window: the
+    projection streams it once. ``VLLM_DS41_L2_PREFETCH_COMP_MB`` sets one budget
+    for every compressor instead.
+    """
+    if BUDGET_COMP is not None:
+        return BUDGET_COMP
+    return BUDGET_WO if getattr(linear, "tp_size", 1) > 1 else 0
 
 
