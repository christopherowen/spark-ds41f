+@pytest.mark.parametrize(
+    "tp_size, budget_comp, expected",
+    [
+        # a TP rank's 12-bit shard (above TP4): prefetched whole, within WO's budget
+        (8, None, "wo"),
+        # the replicated BF16 weight (through TP4): no window by default
+        (1, None, 0),
+        # VLLM_DS41_L2_PREFETCH_COMP_MB sets one budget for both
+        (8, 2_000_000, 2_000_000),
+        (1, 2_000_000, 2_000_000),
+    ],
+)
+def test_compressor_window_has_its_own_budget(
+    segments, monkeypatch, tp_size, budget_comp, expected
+):
+    budgets = {}
+
+    def make_plan(segs, budget, device):
+        if segs:
+            budgets[segs[0]] = budget
+        return _Plan(segs) if segs else None
+
+    monkeypatch.setattr(l2_prefetch, "make_plan", make_plan)
+    monkeypatch.setattr(l2_prefetch, "BUDGET_COMP", budget_comp)
+    layer = _layer(owner=True)
+    layer.attn.compressor.fused_wkv_wgate = SimpleNamespace(tp_size=tp_size)
+    DeepseekV4DecoderLayer.build_l2_prefetch(layer, _layer())
+    expected = l2_prefetch.BUDGET_WO if expected == "wo" else expected
+    assert budgets["compressor"] == expected
+    assert budgets["wo"] == l2_prefetch.BUDGET_WO
+
+
+def test_replicated_compressor_has_no_window():
+    """A zero budget makes no plan, so an owner layer issues no COMP window."""
+    replicated = [("compressor.weight", 1 << 20, 1024 * 5120 * 2)]
+    assert l2_prefetch.make_plan(replicated, 0, torch.device("cpu")) is None
+    shard = [("compressor.weight", 1 << 20, 256 * 7680)]
+    plan = l2_prefetch.make_plan(shard, l2_prefetch.BUDGET_WO, torch.device("cpu"))
+    assert plan is not None and plan.total_bytes == 256 * 7680
+
