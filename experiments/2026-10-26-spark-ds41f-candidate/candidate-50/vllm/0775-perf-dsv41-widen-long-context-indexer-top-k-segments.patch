+@pytest.mark.parametrize(
+    "width, candidates",
+    [
+        (CANDIDATE_BLOCKS * CANDIDATE_BLOCK, False),  # one pass (short prefill)
+        (CANDIDATE_BLOCKS * CANDIDATE_BLOCK, True),  # one pass (reindex rows)
+        (524288, False),  # one merge over 2..32 live lists
