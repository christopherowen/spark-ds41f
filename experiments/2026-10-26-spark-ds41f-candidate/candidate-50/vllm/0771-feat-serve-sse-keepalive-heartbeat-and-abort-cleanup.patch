+@run_async
+@pytest.mark.parametrize("interval", [0.0, 10.0])
+async def test_streaming_disconnect_during_prefill_completes_async_abort(interval):
+    from vllm.entrypoints.serve.utils.sse_keep_alive import with_sse_keep_alive
+
+    request = Request()
+    started = asyncio.Event()
+    abort_entered = asyncio.Event()
+    abort_completed = asyncio.Event()
+
+    async def stream_gen():
+        started.set()
+        try:
+            await asyncio.Event().wait()
+            yield "data: never\n\n"
+        finally:
+            abort_entered.set()
+            # Simulate multi-turn async EngineCore abort notification under
+            # Starlette's cancelled AnyIO task group.
+            with anyio.CancelScope(shield=True):
+                await asyncio.sleep(0)
+                await asyncio.sleep(0.01)
+                abort_completed.set()
+
+    @route
+    async def handle(_, raw_request):
+        return StreamingResponse(
+            content=with_sse_keep_alive(stream_gen(), interval),
+            media_type="text/event-stream",
+        )
+
+    response = await handle(None, request)
+    assert request.app.state.server_load_metrics == 1
+
+    async def receive():
+        await started.wait()
+        return {"type": "http.disconnect"}
+
+    async def send(message):
+        pass
+
+    await response(
+        {"type": "http", "asgi": {"spec_version": "2.3"}},
+        receive,
+        send,
+    )
+    assert abort_entered.is_set()
+    assert abort_completed.is_set()
+    assert request.app.state.server_load_metrics == 0
+
+
+@run_async
+@pytest.mark.parametrize("mode", ["keepalive_send", "chunk_send"])
+async def test_streaming_disconnect_during_send_completes_abort(mode):
+    from vllm.entrypoints.serve.utils.sse_keep_alive import (
+        SSE_KEEP_ALIVE_COMMENT,
+        with_sse_keep_alive,
+    )
+
+    request = Request()
+    disconnect = asyncio.Event()
+    abort_completed = asyncio.Event()
+
+    async def stream_gen():
+        try:
+            if mode == "chunk_send":
+                yield 'data: {"text":"first"}\n\n'
+            await asyncio.Event().wait()
+            yield "data: never\n\n"
+        finally:
+            with anyio.CancelScope(shield=True):
+                await asyncio.sleep(0.01)
+                abort_completed.set()
+
+    @route
+    async def handle(_, raw_request):
+        interval = 0.01 if mode == "keepalive_send" else 10.0
+        return StreamingResponse(
+            content=with_sse_keep_alive(stream_gen(), interval),
+            media_type="text/event-stream",
+        )
+
+    response = await handle(None, request)
+    assert request.app.state.server_load_metrics == 1
+
+    async def receive():
+        await disconnect.wait()
+        return {"type": "http.disconnect"}
+
+    async def send(message):
+        if message["type"] == "http.response.body":
+            target = (
+                SSE_KEEP_ALIVE_COMMENT.encode()
+                if mode == "keepalive_send"
+                else b"first"
+            )
+            if target in message["body"]:
+                disconnect.set()
+                await asyncio.Event().wait()
+
+    await response(
+        {"type": "http", "asgi": {"spec_version": "2.3"}},
+        receive,
+        send,
+    )
+    assert abort_completed.is_set()
+    assert request.app.state.server_load_metrics == 0
+
+
+@run_async
+async def test_streaming_repeated_cancellation_during_abort_cleanup():
+    from vllm.entrypoints.serve.utils.sse_keep_alive import with_sse_keep_alive
+
+    started = asyncio.Event()
+    abort_started = asyncio.Event()
+    finish_abort = asyncio.Event()
+    abort_completed = asyncio.Event()
+
+    async def stream_gen():
+        started.set()
+        try:
+            await asyncio.Event().wait()
+            yield "data: never\n\n"
+        finally:
+            abort_started.set()
+            await finish_abort.wait()
+            abort_completed.set()
+
+    wrapped = with_sse_keep_alive(stream_gen(), 10.0)
+    consumer = asyncio.create_task(anext(wrapped))
+    await started.wait()
+    consumer.cancel("first disconnect")
+    await abort_started.wait()
+    try:
+        for i in range(3):
+            consumer.cancel(f"repeat cancel {i}")
+            await asyncio.sleep(0)
+        await asyncio.sleep(0.01)
+        assert not consumer.done(), "repeated cancel interrupted stream abort cleanup"
+        finish_abort.set()
+        with pytest.raises(asyncio.CancelledError):
+            await consumer
+        assert abort_completed.is_set()
+    finally:
+        finish_abort.set()
+        await asyncio.gather(consumer, return_exceptions=True)
+
+
+@run_async
+@pytest.mark.parametrize("interval", [0.0, 0.01, 10.0])
+async def test_async_llm_generate_streaming_disconnect_aborts_engine_core(interval):
+    import time
+    from vllm.sampling_params import SamplingParams
+    from vllm.v1.engine import EngineCoreRequest
+    from vllm.v1.engine.async_llm import AsyncLLM
+    from vllm.v1.engine.output_processor import OutputProcessor
+    from vllm.entrypoints.serve.utils.sse_keep_alive import (
+        SSE_KEEP_ALIVE_COMMENT,
+        with_sse_keep_alive,
+    )
+
+    submitted_event = asyncio.Event()
+    abort_completed = asyncio.Event()
+    aborted_ids = []
+
+    class SlowAbortCore:
+        def __init__(self):
+            self.resources = SimpleNamespace(engine_dead=False)
+
+        async def add_request_async(self, req):
+            submitted_event.set()
+
+        async def abort_requests_async(self, request_ids):
+            # Multi-turn ZMQ send inside Starlette's cancelled AnyIO scope
+            await asyncio.sleep(0)
+            await asyncio.sleep(0.01)
+            aborted_ids.extend(request_ids)
+            abort_completed.set()
+
+        def shutdown(self, timeout=None):
+            pass
+
+    llm = AsyncLLM.__new__(AsyncLLM)
+    llm.engine_core = SlowAbortCore()
+    llm.output_processor = OutputProcessor(None, log_stats=False)
+    llm.scheduler_config = SimpleNamespace(
+        max_num_queued_reqs=None, max_num_queued_tokens=None
+    )
+    llm.admission_stats = None
+    llm.vllm_config = SimpleNamespace(
+        cache_config=SimpleNamespace(kv_sharing_fast_prefill=False)
+    )
+    llm.log_requests = False
+    llm.output_handler = None
+    llm._run_output_handler = lambda: None
+    llm._request_stall_warning_s = 0
+    llm._log_request_timeline = False
+
+    def assign_request_id(req):
+        req.external_req_id = req.request_id
+        req.request_id = f"{req.request_id}-internal"
+
+    llm.input_processor = SimpleNamespace(assign_request_id=assign_request_id)
+
+    core_req = EngineCoreRequest(
+        request_id="req-1m-prefill",
+        prompt_token_ids=[1] * 1024,
+        mm_features=None,
+        sampling_params=SamplingParams(max_tokens=16, detokenize=False),
+        pooling_params=None,
+        arrival_time=time.time(),
+        lora_request=None,
+        cache_salt=None,
+        data_parallel_rank=None,
+    )
+
+    async def sse_adapter():
+        async for out in llm.generate(
+            core_req, core_req.sampling_params, core_req.request_id
+        ):
+            yield f"data: {out.request_id}\n\n"
+
+    request = Request()
+
+    @route
+    async def handle(_, raw_request):
+        return StreamingResponse(
+            content=with_sse_keep_alive(sse_adapter(), interval),
+            media_type="text/event-stream",
+        )
+
+    response = await handle(None, request)
+    assert request.app.state.server_load_metrics == 1
+
+    ready_to_disconnect = asyncio.Event()
+
+    async def receive():
+        await submitted_event.wait()
+        if interval == 0.01:
+            await ready_to_disconnect.wait()
+        return {"type": "http.disconnect"}
+
+    async def send(message):
+        if (
+            interval == 0.01
+            and message["type"] == "http.response.body"
+            and SSE_KEEP_ALIVE_COMMENT.encode() in message["body"]
+        ):
+            ready_to_disconnect.set()
+
+    await response(
+        {"type": "http", "asgi": {"spec_version": "2.3"}},
+        receive,
+        send,
+    )
+    assert abort_completed.is_set()
+    assert aborted_ids == ["req-1m-prefill-internal"]
+    assert not llm.output_processor.request_states
+    assert request.app.state.server_load_metrics == 0
+
+
+@run_async
+@pytest.mark.parametrize(
+    "endpoint",
+    ["chat_completion", "completion", "responses", "anthropic_messages"],
+)
+async def test_openai_and_anthropic_routers_wrap_stream_with_sse_keep_alive(
+    endpoint, monkeypatch
+):
+    from vllm.entrypoints.anthropic.api_router import create_messages
+    from vllm.entrypoints.openai.chat_completion.api_router import (
+        create_chat_completion,
+    )
+    from vllm.entrypoints.openai.completion.api_router import create_completion
+    from vllm.entrypoints.openai.responses.api_router import create_responses
+    from vllm.entrypoints.serve.utils.sse_keep_alive import SSE_KEEP_ALIVE_COMMENT
+
+    monkeypatch.setenv("VLLM_SSE_KEEPALIVE_INTERVAL_S", "0.01")
+
+    async def slow_prefill_stream():
+        await asyncio.sleep(0.025)
+        if endpoint == "responses":
+            yield SimpleNamespace(
+                type="response.output_text.delta",
+                model_dump_json=lambda **kwargs: '{"id":"tok-1"}',
+            )
+        else:
+            yield 'data: {"id":"tok-1"}\n\n'
+            yield "data: [DONE]\n\n"
+
+    request = Request()
+    request.headers = {}
+
+    if endpoint == "chat_completion":
+        request.app.state.openai_serving_chat = SimpleNamespace(
+            create_chat_completion=lambda req, raw: asyncio.sleep(
+                0, result=slow_prefill_stream()
+            )
+        )
+        route_fn = create_chat_completion
+    elif endpoint == "completion":
+        request.app.state.openai_serving_completion = SimpleNamespace(
+            create_completion=lambda req, raw: asyncio.sleep(
+                0, result=slow_prefill_stream()
+            )
+        )
+        route_fn = create_completion
+    elif endpoint == "responses":
+        request.app.state.openai_serving_responses = SimpleNamespace(
+            create_responses=lambda req, raw: asyncio.sleep(
+                0, result=slow_prefill_stream()
+            )
+        )
+        route_fn = create_responses
+    else:
+        request.app.state.anthropic_serving_messages = SimpleNamespace(
+            create_messages=lambda req, raw: asyncio.sleep(
+                0, result=slow_prefill_stream()
+            )
+        )
+        route_fn = create_messages
+
+    response = await route_fn(SimpleNamespace(), request)
+    assert request.app.state.server_load_metrics == 1
+
+    chunks = []
+    async for chunk in response.body_iterator:
+        chunks.append(chunk if isinstance(chunk, str) else chunk.decode())
+
+    await response.body_iterator.aclose()
+    assert SSE_KEEP_ALIVE_COMMENT in chunks
+    data_chunks = [c for c in chunks if not c.startswith(":")]
+    if endpoint == "responses":
+        assert data_chunks == [
+            'event: response.output_text.delta\ndata: {"id":"tok-1"}\n\n'
+        ]
+    else:
+        assert data_chunks == ['data: {"id":"tok-1"}\n\n', "data: [DONE]\n\n"]
