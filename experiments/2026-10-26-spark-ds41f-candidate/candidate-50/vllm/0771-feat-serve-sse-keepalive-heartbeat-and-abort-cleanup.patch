+def test_sse_keep_alive_interval_resolution(
+    monkeypatch, env_val, arg_val, disabled_flag, expected
+):
+    from vllm.entrypoints.serve.utils.sse_keep_alive import (
+        get_sse_keep_alive_interval,
+        with_sse_keep_alive,
+    )
+
+    monkeypatch.delenv("VLLM_SSE_KEEPALIVE_INTERVAL_S", raising=False)
+    monkeypatch.delenv("VLLM_SSE_KEEP_ALIVE_INTERVAL", raising=False)
+    if env_val is not None:
+        monkeypatch.setenv("VLLM_SSE_KEEPALIVE_INTERVAL_S", env_val)
+
+    args = SimpleNamespace(
+        sse_keep_alive_interval=arg_val,
+        sse_keep_alive_disabled=disabled_flag,
+    )
+    req = Request(SimpleNamespace(args=args))
+    interval = get_sse_keep_alive_interval(req)
+    assert interval == expected
+
+    async def dummy():
+        yield "data: ok\n\n"
+
+    g = dummy()
+    wrapped = with_sse_keep_alive(g, interval)
+    if expected == 0.0:
+        assert wrapped is g
+    else:
+        assert wrapped is not g
+    asyncio.run(wrapped.aclose())
+
