+@run_async
+async def test_sse_keep_alive_long_prefill_cadence_and_openai_parser():
+    import json
+    from vllm.entrypoints.serve.utils.sse_keep_alive import (
+        SSE_KEEP_ALIVE_COMMENT,
+        with_sse_keep_alive,
+    )
+
+    prefill_done = asyncio.Event()
+    entries = 0
+    heartbeats = 0
+
+    async def simulated_chat_stream():
+        nonlocal entries
+        entries += 1
+        await prefill_done.wait()
+        # Synchronous role chunk followed immediately by first content chunk
+        yield 'data: {"id":"chatcmpl-1","object":"chat.completion.chunk","choices":[{"index":0,"delta":{"role":"assistant","content":""}}]}\n\n'
+        yield 'data: {"id":"chatcmpl-1","object":"chat.completion.chunk","choices":[{"index":0,"delta":{"content":"Hello"}}]}\n\n'
+        await asyncio.sleep(0)
+        yield 'data: {"id":"chatcmpl-1","object":"chat.completion.chunk","choices":[{"index":0,"delta":{"content":" world"},"finish_reason":"stop"}]}\n\n'
+        yield "data: [DONE]\n\n"
+
+    raw_frames = []
+    async for frame in with_sse_keep_alive(simulated_chat_stream(), 0.01):
+        raw_frames.append(frame)
+        if frame == SSE_KEEP_ALIVE_COMMENT:
+            heartbeats += 1
+            if heartbeats >= 3:
+                prefill_done.set()
+
+    # The underlying generator was entered once and never cancelled during prefill
+    assert entries == 1
+    assert heartbeats >= 3
+    assert raw_frames[:heartbeats] == [SSE_KEEP_ALIVE_COMMENT] * heartbeats
+
+    # Standard WhatWG / OpenAI SSE parser ignores comment lines starting with ':'
+    parsed_events = []
+    done_received = False
+    raw_stream = "".join(raw_frames)
+    for block in raw_stream.split("\n\n"):
+        if not block:
+            continue
+        data_lines = []
+        for line in block.splitlines():
+            if line.startswith(":"):
+                continue
+            if line.startswith("data:"):
+                data_lines.append(line[5:].lstrip(" "))
+        if not data_lines:
+            continue
+        payload = "\n".join(data_lines)
+        if payload == "[DONE]":
+            done_received = True
+        else:
+            parsed_events.append(json.loads(payload))
+
+    assert done_received
+    assert len(parsed_events) == 3
+    text = "".join(
+         ev["choices"][0]["delta"].get("content", "") for ev in parsed_events
+    )
+    assert text == "Hello world"
+
