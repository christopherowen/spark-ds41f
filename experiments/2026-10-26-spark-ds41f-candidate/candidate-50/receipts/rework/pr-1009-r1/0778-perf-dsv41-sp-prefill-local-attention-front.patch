 from vllm.models.deepseek_v4_1.tilelang.pdl import (  # noqa: E402
@@ -161,3 +163,104 @@ def test_context_kv_front_gives_the_three_kernels_bits(rows, slot_dtype):
         kv_raw, kv_weight, EPS, positions, table, pages, slots, PAGE_SIZE
     )
     _assert_bytes_equal(pages, pages_ref, "context kv cache pages")
+
+
+@pytest.mark.parametrize("slot_dtype", [torch.int64, torch.int32])
+@pytest.mark.parametrize("rows", [1, 2, 3, 6, 8, 9, 16, 24, 48, 64, 65, 512])
+def test_sp_front_and_write_swa_records_give_the_five_kernels_bits(rows, slot_dtype):
+    """``sp_attention_front`` + ``write_swa_records`` match the five-kernel reference
+    bit for bit on ``q_values``, ``q_scales``, and ``pages`` (including strided
+    ``qa_kv`` views, skipped negative/out-of-range slots, and special FP values)."""
+    gen = torch.Generator(device=DEVICE).manual_seed(rows + 200)
+    qa_kv_full = (
+        torch.randn((rows, Q_LATENT + KV_LATENT + 32), generator=gen, device=DEVICE)
+        * 3
+    ).bfloat16()
+    qa_kv = qa_kv_full[:, : Q_LATENT + KV_LATENT]
+    qa_kv[0, :64] = -0.0
+    if rows > 2:
+        qa_kv[1, :] = 0.0
+        qa_kv[2, Q_LATENT + 100] = 1e4
+    if rows > 3:
+        qa_kv[3, :] *= 1e-30
+    q_weight = (
+        torch.randn(Q_LATENT, generator=gen, device=DEVICE) * 0.3 + 1
+    ).bfloat16()
+    kv_weight = (
+        torch.randn(KV_LATENT, generator=gen, device=DEVICE) * 0.3 + 1
+    ).bfloat16()
+    q_weight[:32] = 0.0
+    q_weight[32:64] *= 4096.0
+    positions = torch.randint(0, POSITIONS, (rows,), generator=gen, device=DEVICE)
+    slots = torch.randperm(PAGES * PAGE_SIZE, generator=gen, device=DEVICE)[:rows]
+    slots[rows // 2] = -1
+    if rows > 4:
+        slots[rows - 1] = PAGES * PAGE_SIZE + 5
+    slots = slots.to(slot_dtype)
+    table = _table()
+    page_bytes = PAGE_SIZE * RECORD_BYTES["swa"]
+    pages = torch.empty((PAGES, page_bytes), dtype=torch.uint8, device=DEVICE)
+    pages.random_(generator=gen)
+
+    q_ref = torch.empty((rows, Q_LATENT), dtype=torch.bfloat16, device=DEVICE)
+    norm_forward(qa_kv[:, :Q_LATENT].contiguous(), q_weight, EPS, out=q_ref)
+    kv_ref = torch.empty((rows, KV_LATENT), dtype=torch.bfloat16, device=DEVICE)
+    norm_forward(qa_kv[:, Q_LATENT:].contiguous(), kv_weight, EPS, out=kv_ref)
+    values_ref = torch.empty((rows, Q_LATENT), dtype=torch.float8_e4m3fn, device=DEVICE)
+    scales_ref = torch.empty(
+        (rows, 4 * scale_words(Q_LATENT)), dtype=torch.uint8, device=DEVICE
+    )
+    per_token_cast(
+        q_ref, "e4m3", 32, round_sf=True, use_packed_ue8m0=True,
+        out=(values_ref, scales_ref),
+    )  # fmt: skip
+    rope_(kv_ref, positions, table, 1, False)
+    pages_ref = pages.clone()
+    write_cache(kv_ref, pages_ref, slots, page_size=PAGE_SIZE, cache_kind="swa")
+
+    values = torch.empty_like(values_ref)
+    values.view(torch.uint8).fill_(0x7F)
+    scales = torch.full_like(scales_ref, 0xFF)
+    records = torch.full(
+        (rows, RECORD_BYTES["swa"]), 0xAA, dtype=torch.uint8, device=DEVICE
+    )
+    sp_attention_front(
+        qa_kv, q_weight, kv_weight, EPS, positions, table, values, scales, records
+    )
+    write_swa_records(records, pages, slots, page_size=PAGE_SIZE)
+    _assert_bytes_equal(values, values_ref, "sp q E4M3")
+    _assert_bytes_equal(scales, scales_ref, "sp q scales")
+    _assert_bytes_equal(pages, pages_ref, "sp cache pages")
+
+
+def test_sp_front_and_write_swa_records_empty_and_validation():
+    """Zero-row launches are no-ops and malformed record/page inputs raise ValueError."""
+    table = _table()
+    page_bytes = PAGE_SIZE * RECORD_BYTES["swa"]
+    pages = torch.zeros((PAGES, page_bytes), dtype=torch.uint8, device=DEVICE)
+    q_weight = torch.ones(Q_LATENT, dtype=torch.bfloat16, device=DEVICE)
+    kv_weight = torch.ones(KV_LATENT, dtype=torch.bfloat16, device=DEVICE)
+    sp_attention_front(
+        torch.empty((0, Q_LATENT + KV_LATENT), dtype=torch.bfloat16, device=DEVICE),
+        q_weight,
+        kv_weight,
+        EPS,
+        torch.empty((0,), dtype=torch.int64, device=DEVICE),
+        table,
+        torch.empty((0, Q_LATENT), dtype=torch.float8_e4m3fn, device=DEVICE),
+        torch.empty((0, 4 * scale_words(Q_LATENT)), dtype=torch.uint8, device=DEVICE),
+        torch.empty((0, RECORD_BYTES["swa"]), dtype=torch.uint8, device=DEVICE),
+    )
+    write_swa_records(
+        torch.empty((0, RECORD_BYTES["swa"]), dtype=torch.uint8, device=DEVICE),
+        pages,
+        torch.empty((0,), dtype=torch.int64, device=DEVICE),
+        page_size=PAGE_SIZE,
+    )
+    with pytest.raises(ValueError, match="SWA cache records"):
+        write_swa_records(
+            torch.zeros((2, 16), dtype=torch.uint8, device=DEVICE),
+            pages,
+            torch.zeros((2,), dtype=torch.int64, device=DEVICE),
+            page_size=PAGE_SIZE,
+        )
diff --git a/tests/models/test_deepseek_v4_1_attention.py b/tests/models/test_deepseek_v4_1_attention.py
index 1e4258e06..e1fd95311 100644
--- a/tests/models/test_deepseek_v4_1_attention.py
+++ b/tests/models/test_deepseek_v4_1_attention.py
@@ -1900,3 +1900,201 @@ def test_decode_two_stream_overlap_schedules_disjoint_workspaces(monkeypatch):
     assert ("indexer.wq_b", "main") in names_reidx
     assert ("index_chunk", "main") in names_reidx
     assert ("attend", "main") in names_reidx
+
+
+@pytest.mark.parametrize("is_decode", [False, True])
+@pytest.mark.parametrize("n_real", [4, 2, 0])
+@pytest.mark.parametrize("split_check", [False, True])
+def test_sp_prefill_with_replicated_fused_wqa_wkv_gathers_mxfp8_and_swa_records(
+    monkeypatch, n_real, split_check, is_decode
+):
+    """When ``fused_wqa_wkv`` is replicated across TP, SP prefill without a compressor
+    runs ``sp_attention_front`` on ``qr_kv[:real_rows]``, gathers only ``local_q_cast``
+    and 528-byte SWA cache records via ``gather_mxfp8`` (1,848 B/row), scatters the
+    records via ``write_swa_records``, and keeps ``indexer.weights_proj`` rank-local
+    unless ``_INDEX_SPLIT_CHECK`` is active. A decode step of an SP forward (the
+    warm-up's eager tail shapes) scores every row, so it gathers the head weights of
+    every row: the index queries and their weights always have one row count."""
+    from vllm.models.deepseek_v4_1 import attention, kernels, sp_prefill
+    from vllm.models.deepseek_v4_1.tilelang import cache_writer, front
+    from vllm.models.deepseek_v4_1.tilelang.linear import MXFP8Rows, provided_mxfp8
+
+    monkeypatch.setattr(attention, "_INDEX_SPLIT_CHECK", split_check)
+    module = _tilelang_layer(layer_id=5)
+    module._ready = True
+    module.q_lora_rank = 1280
+    module.n_local_heads = 2
+    module._l2pf_wo = None
+    module._l2pf_comp = None
+    swa_cache = torch.zeros((4, 64 * 528), dtype=torch.uint8)
+    module.swa_cache_layer = SimpleNamespace(
+        prefix="swa", kv_cache=swa_cache, block_size=64
+    )
+    module.q_norm = SimpleNamespace(
+        weight=torch.ones(1280, dtype=torch.bfloat16), variance_epsilon=1e-6
+    )
+    module.kv_norm = SimpleNamespace(
+        weight=torch.ones(512, dtype=torch.bfloat16), variance_epsilon=1e-6
+    )
+    module.rotary_emb = SimpleNamespace(
+        cos_sin_cache=torch.ones((32, 64), dtype=torch.float32)
+    )
+
+    local_x = torch.ones((4, 32), dtype=torch.bfloat16)
+    local_weights = torch.arange(16, dtype=torch.bfloat16).reshape(4, 4)
+    gathered_weights = torch.arange(40, dtype=torch.bfloat16).reshape(10, 4)
+    gathered_q = MXFP8Rows(
+        rows=torch.empty((10, 1280), dtype=torch.bfloat16),
+        values=torch.full((64, 1280), 7, dtype=torch.float8_e4m3fn),
+        scales=torch.full((64, 40), 9, dtype=torch.uint8),
+    )
+    gathered_records = torch.full((10, 528), 11, dtype=torch.uint8)
+    events = []
+
+    class _FakeSPRows:
+        num_tokens = 10
+        local_rows = 4
+        start = 4
+        real_rows = n_real
+
+        def gather(self, x):
+            events.append(("gather", tuple(x.shape), x.dtype))
+            return gathered_weights
+
+        def gather_mxfp8(self, x_q, *extra):
+            assert len(extra) == 1
+            rec = extra[0]
+            events.append(
+                (
+                    "gather_mxfp8",
+                    tuple(x_q.rows.shape),
+                    tuple(rec.shape),
+                    rec.dtype,
+                )
+            )
+            return (gathered_q, gathered_records)
+
+    def rep_wqa_wkv(h):
+        events.append(("fused_wqa_wkv", tuple(h.shape)))
+        return torch.ones((4, 1280 + 512), dtype=torch.bfloat16), None
+
+    rep_wqa_wkv.tp_size = 4
+    rep_wqa_wkv.replicated_sp_prefill = True
+    module.fused_wqa_wkv = rep_wqa_wkv
+
+    def fake_sp_front(
+        qa_kv, q_w, kv_w, eps, pos, cos_sin, q_values, q_scales, records
+    ):
+        events.append(
+            (
+                "sp_attention_front",
+                tuple(qa_kv.shape),
+                 pos.tolist(),
+                tuple(q_values.shape),
+                tuple(q_scales.shape),
+                tuple(records.shape),
+            )
+        )
+
+    def fake_write_swa_records(records, cache, slots, *, page_size):
+        events.append(
+            (
+                "write_swa_records",
+                records is gathered_records,
+                cache is swa_cache,
+                slots.tolist(),
+                page_size,
+            )
+        )
+
+    monkeypatch.setattr(front, "sp_attention_front", fake_sp_front)
+    monkeypatch.setattr(cache_writer, "write_swa_records", fake_write_swa_records)
+    monkeypatch.setattr(
+        kernels,
+        "cast_mxfp8",
+        lambda rows: (_ for _ in ()).throw(
+            AssertionError("cast_mxfp8 should not run on gathered qr")
+        ),
+    )
+    module._cache_context_kv = lambda kv, pos: (_ for _ in ()).throw(
+        AssertionError("_cache_context_kv should not run when _sp_front wrote SWA records")
+    )
+    module.wq_b = lambda qr: (
+        events.append(("wq_b", qr is gathered_q.rows, provided_mxfp8(qr) is gathered_q)),
+        torch.ones((qr.shape[0], 2 * 512), dtype=torch.bfloat16),
+    )[1]
+    module._rope = lambda x, pos, role: x
+    module.indexer = SimpleNamespace(
+        heads=4,
+        wq_b=lambda qr: torch.ones((qr.shape[0], 4 * 128), dtype=torch.bfloat16),
+        weights_proj=lambda h: (
+            events.append(("weights_proj", tuple(h.shape))),
+            local_weights,
+        )[1],
+    )
+    module._quantize_index_query = lambda mode, iq, data, scale, positions=None: None
+    seen_index_query = []
+
+    def check_forward_mqa(q, kv, pos, output, *, index_query=None):
+        assert kv is None
+        seen_index_query.append(index_query)
+        output.zero_()
+
+    module.forward_mqa = check_forward_mqa
+    module._o_proj = lambda output, sp_rows=None: torch.zeros(
+        (4, 32), dtype=torch.bfloat16
+    )
+    slots = torch.arange(100, 110, dtype=torch.int64)
+    metadata = {"swa": SimpleNamespace(is_decode=is_decode, slot_mapping=slots)}
+    monkeypatch.setattr(
+        attention,
+        "get_forward_context",
+        lambda: SimpleNamespace(attn_metadata=metadata),
+    )
+    monkeypatch.setattr(sp_prefill, "current", lambda: _FakeSPRows())
+    positions = torch.arange(20, 30, dtype=torch.int64)
+    out = module._forward(positions, local_x)
+    assert out.shape == (4, 32)
+
+    expected_events = [
+        ("fused_wqa_wkv", (4, 32)),
+        ("weights_proj", (4, 32)),
+    ]
+    if split_check or is_decode:
+        expected_events.append(("gather", (4, 4), torch.bfloat16))
+    if n_real > 0:
+        expected_events.append(
+            (
+                "sp_attention_front",
+                (n_real, 1792),
+                list(range(24, 24 + n_real)),
+                (n_real, 1280),
+                (n_real, 40),
+                (n_real, 528),
+            )
+        )
+    expected_events.extend(
+        [
+            ("gather_mxfp8", (4, 1280), (4, 528), torch.uint8),
+            ("write_swa_records", True, True, list(range(100, 110)), 64),
+            ("wq_b", True, True),
+        ]
+    )
+    assert events == expected_events
+    assert len(seen_index_query) == 1
+    iq_data, iq_scale, weights, split, ref = seen_index_query[0]
+    assert weights.shape[0] == iq_data.shape[0] == iq_scale.shape[0]
+    if is_decode:
+        assert split is None and ref is None
+        assert iq_data.shape == (10, 4, 64)
+        assert iq_scale.shape == (10, 4, 4)
+        assert torch.equal(weights, gathered_weights)
+        return
+    assert iq_data.shape == (n_real, 4, 64)
+    assert iq_scale.shape == (n_real, 4, 4)
+    if split_check:
+        assert torch.equal(weights, gathered_weights[4 : 4 + n_real])
+        assert ref is not None and torch.equal(ref[2], gathered_weights)
+    else:
+        assert torch.equal(weights, local_weights[:n_real])
+        assert ref is None
