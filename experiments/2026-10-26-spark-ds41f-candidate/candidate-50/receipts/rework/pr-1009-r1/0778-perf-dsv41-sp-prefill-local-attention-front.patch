+_COPY_B128_HEADER = """
+__device__ __forceinline__ void dsv41_copy_b128(uint32_t* dst, const uint32_t* src) {
+  if (((reinterpret_cast<uintptr_t>(dst) | reinterpret_cast<uintptr_t>(src)) & 15) == 0) {
+    *reinterpret_cast<uint4*>(dst) = *reinterpret_cast<const uint4*>(src);
+  } else {
+    #pragma unroll
+    for (int i = 0; i < 4; ++i) dst[i] = src[i];
+  }
+}
+"""
+
+
+@tilelang.jit(pass_configs={tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True})
+def swa_records_kernel(page_size: int, slot_dtype: str = "int64"):
+    """Scatter pre-packed 528-byte SWA records into paged ``cache`` at ``slots``."""
+    record = RECORD_BYTES["swa"]
+    words_per_record = record // 4  # 132 uint32 words = 33 * 4 words
+    row_threads = 32
+    threads = 128
+    block_m = threads // row_threads
+    tokens = T.dynamic("tokens")
+    pages, page_words, word_stride = T.dynamic("pages, page_words, word_stride")
+
+    @T.prim_func
+    def cache_writer(
+        src_words: T.Tensor((tokens, words_per_record), T.uint32),
+        dst_words: T.StridedTensor((pages, page_words), (word_stride, 1), T.uint32),
+        slots: T.Tensor((tokens,), slot_dtype),
+    ):
+        with T.Kernel(T.ceildiv(tokens, block_m), threads=threads) as pid:
+            T.import_source(_COPY_B128_HEADER)
+            pdl.chain()
+            tid = T.get_thread_binding()
+            row = tid // row_threads
+            lane = tid % row_threads
+            token_id = pid * block_m + row
+            if token_id < tokens:
+                slot = T.cast(slots[token_id], T.int64)
+                page = slot // page_size
+                if (slot >= 0) & (page < pages):
+                    word_base = (slot % page_size) * words_per_record
+                    T.call_extern(
+                        "handle",
+                        "dsv41_copy_b128",
+                        T.address_of(dst_words[page, word_base + lane * 4]),
+                        T.address_of(src_words[token_id, lane * 4]),
+                    )
+                    if lane == 0:
+                        T.call_extern(
+                            "handle",
+                            "dsv41_copy_b128",
+                            T.address_of(dst_words[page, word_base + 128]),
+                            T.address_of(src_words[token_id, 128]),
+                        )
+
+    return cache_writer
+
+
+def write_swa_records(
+    records: torch.Tensor,
+    cache: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    *,
+    page_size: int,
+) -> None:
+    """Write pre-packed SWA ``records`` (``[T, 528]`` uint8, contiguous) into
+    ``cache`` at ``slot_mapping`` (``[T]`` int32 or int64)."""
+    if records.shape[0] == 0:
+        return
+    record_bytes = RECORD_BYTES["swa"]
+    if (
+        records.dtype != torch.uint8
+        or records.shape[1] != record_bytes
+        or not records.is_contiguous()
+    ):
+        raise ValueError(
+            f"SWA cache records must be contiguous [T, {record_bytes}] uint8"
+        )
+    pages = cache.view(torch.uint8)
+    if pages.dim() > 2:
+        pages = pages.flatten(1)
+    if pages.shape[1] < page_size * record_bytes:
+        raise ValueError(f"cache pages hold fewer than {page_size} swa records")
+    word_bytes, _, word_torch = _WORD["swa"]
+    if pages.stride(0) % word_bytes or pages.shape[1] % word_bytes:
+        raise ValueError(f"cache pages are not whole {word_bytes}-byte words")
+    function, args, kwargs = swa_records_call(page_size, slot_mapping.dtype)
+    kernel = function(*args, **kwargs)
+    kernel(records.view(word_torch), pages.view(word_torch), slot_mapping)
