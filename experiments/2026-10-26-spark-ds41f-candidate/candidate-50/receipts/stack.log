### apply_stack.sh
#!/usr/bin/env bash
# Apply candidate-50 patches 0762.. on top of a tree at 1107 patch head; log each result.
set -u
REPO=$1; SERIES_DIR=$2; LOG=$3
cd "$REPO"
{
echo "# candidate-50 stack: 1107 series (0001..0761, 641 active) then candidate-50 0762.. in series order"
echo "# repo: vLLM 19f2c20ed4d64ae22bd009ceacadd85e2a81e354 + 1107 series via git am --committer-date-is-author-date (committer Christopher Owen <3221756+christopherowen@users.noreply.github.com>)"
echo "# host: $(hostname)  date: $(date -u +%Y-%m-%dT%H:%M:%SZ)  git: $(git --version)"
echo "base-1107 patch_head $(git rev-parse base-1107) tree $(git rev-parse base-1107^{tree})"
} > "$LOG"
grep -v "^#" "$SERIES_DIR/series" | grep -v "^\s*$" | grep -E "^07[6-9][0-9]-|^0[8-9][0-9][0-9]-" | grep -v "^0761" | while read p; do
  f="$SERIES_DIR/$p"
  sha=$(sha256sum "$f" | cut -c1-64)
  out=$(git apply --check --verbose "$f" 2>&1); rc=$?
  echo "$p" | grep -q "^076[2-9]\|^07[7-9]" || continue
  if [ $rc -ne 0 ]; then
    echo "FAIL  $p sha256=$sha  git apply --check rc=$rc" >> "$LOG"; echo "$out" | sed "s/^/      /" >> "$LOG"; exit 1
  fi
  am=$(git -c user.name="Christopher Owen" -c user.email=3221756+christopherowen@users.noreply.github.com am --quiet --committer-date-is-author-date "$f" 2>&1); rc=$?
  if [ $rc -ne 0 ]; then
    echo "FAIL  $p sha256=$sha  git am rc=$rc" >> "$LOG"; echo "$am" | sed "s/^/      /" >> "$LOG"; git am --abort; exit 1
  fi
  files=$(git diff --name-only HEAD~1 HEAD | wc -l)
  echo "OK    $p sha256=$sha  commit=$(git rev-parse HEAD) tree=$(git rev-parse HEAD^{tree}) files=$files" >> "$LOG"
  echo "$out" | grep -E "offset|fuzz" | sed "s/^/      git apply: /" >> "$LOG"
  [ -n "$am" ] && echo "$am" | sed "s/^/      git am: /" >> "$LOG"
  true
done
echo "head $(git rev-parse HEAD) tree $(git rev-parse HEAD^{tree}) patches_after_base $(git rev-list --count base-1107..HEAD)" >> "$LOG"
git diff --check 19f2c20ed4d64ae22bd009ceacadd85e2a81e354 HEAD >/dev/null && echo "git diff --check 19f2c20ed4d6..HEAD: clean" >> "$LOG" || echo "git diff --check 19f2c20ed4d6..HEAD: PROBLEMS" >> "$LOG"
exit 0

### try_orders.sh
#!/usr/bin/env bash
# Try candidate block orders on base-1107 with git apply; report first failure per order.
P=${P:-$HOME/spark-lab/agents/candidate-50/spark-ds41f/experiments/2026-10-26-spark-ds41f-candidate/candidate-50/vllm}
WT=$HOME/spark-lab/agents/candidate-50/stack/wt
cd $HOME/spark-lab/agents/candidate-50/stack/vllm
git worktree remove --force $WT 2>/dev/null; git worktree add -q --detach $WT base-1107
c47="0762 0763 0764 0765 0766 0767"; c48="0768 0769 0770 0771 0772 0773 0774"; c49="0775 0776 0777 0778 0779 0780"
for order in "47 48 49" "47 49 48" "48 47 49" "48 49 47" "49 47 48" "49 48 47"; do
  cd $WT; git checkout -q --detach base-1107; git reset -q --hard; git clean -qfd
  seq=""; for c in $order; do v=c$c; seq="$seq ${!v}"; done
  res="ALL-OK"
  for n in $seq; do f=$(ls $P/$n-*.patch); if ! git apply --index "$f" 2>/tmp/c50err.$$; then res="FAIL at $n ($(grep -m1 "patch failed" /tmp/c50err.$$))"; break; fi; done
  echo "order $order: $res"
done
cd $HOME/spark-lab/agents/candidate-50/stack/vllm; git worktree remove --force $WT; rm -f /tmp/c50err.$$

### try_seq.sh
#!/usr/bin/env bash
# try_seq.sh "<n1 n2 ...>": apply the given numbered patches in order on base-1107 with git apply.
P=${P:-$HOME/spark-lab/agents/candidate-50/spark-ds41f/experiments/2026-10-26-spark-ds41f-candidate/candidate-50/vllm}
WT=$HOME/spark-lab/agents/candidate-50/stack/wt
cd $HOME/spark-lab/agents/candidate-50/stack/vllm
git worktree remove --force $WT 2>/dev/null; git worktree add -q --detach $WT base-1107
for seq in "$@"; do
  cd $WT; git reset -q --hard base-1107; git clean -qfd
  res="ALL-OK"
  for n in $seq; do f=$(ls $P/$n-*.patch); if ! git apply --index "$f" 2>$WT.err; then res="FAIL at $n: $(grep "patch failed\|does not apply" $WT.err | tr "\n" " ")"; break; fi; done
  echo "[$seq] -> $res"
done
cd $HOME/spark-lab/agents/candidate-50/stack/vllm; git worktree remove --force $WT; rm -f $WT.err
