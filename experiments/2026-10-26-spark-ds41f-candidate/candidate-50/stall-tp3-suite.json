{
  "name": "stall-tp3",
  "version": 1,
  "description": "release-tp3's decode-stall steps alone, with the same arguments: short-request TTFT and decode while a cold 131K prompt prefills at 3, 6 and 7 of TP3's streams. The model-scoring step is left out because on sp5 it trips the 4 GiB bench memory floor (2026-11-09).",
  "steps": [
    {
      "id": "stall-3",
      "command": "stall",
      "args": {
        "sizes": [
          131072
        ],
        "streams": 3,
        "max_tokens": 16384,
        "warmup": 20,
        "tail": 2,
        "repeats": 3,
        "probes": [
          2,
          5,
          8,
          11,
          14
        ],
        "probe_tokens": 500,
        "probe_max_tokens": 16
      }
    },
    {
      "id": "stall-6",
      "command": "stall",
      "args": {
        "sizes": [
          131072
        ],
        "streams": 6,
        "max_tokens": 16384,
        "warmup": 20,
        "tail": 2,
        "repeats": 3,
        "probes": [
          2,
          5,
          8,
          11,
          14
        ],
        "probe_tokens": 500,
        "probe_max_tokens": 16
      }
    },
    {
      "id": "stall-7",
      "command": "stall",
      "args": {
        "sizes": [
          131072
        ],
        "streams": 7,
        "max_tokens": 16384,
        "warmup": 20,
        "tail": 2,
        "repeats": 3
      }
    }
  ]
}
