+    def _run_expert_centric_prefill(
+        self,
+        plan,
+        x,
+        topk_ids: torch.Tensor,
+        topk_weights: torch.Tensor,
+        uniq: np.ndarray,
+        out: torch.Tensor | None,
+        workspace: torch.Tensor | None,
+        shared,
+    ):
+        """Single-pass LBA-sorted expert-outer prefill streaming.
+
+        Pass 0 runs all currently resident experts (static + warm dynamic)
+        across all rows with zero NVMe I/O. Remaining cold experts are swept
+        once in ascending LBA batches of ``dynamic_slots``, using role-major
+        ``w13``/``w2`` overlap and FP32 cross-batch accumulation with ``shared``
+        folded once before the final cast.
+        """
+        rows = topk_ids.shape[0]
+        if callable(shared):
+            shared = shared()
+        final_dtype = torch.bfloat16 if shared is not None else plan.out_dtype
+        pass_dtype = plan.out_dtype
+
+        if self._w2_pending:
+            self._ensure_reader_open()
+            self._mod.wait_role(self._reader, self._mod.ROLE_ALL)
+            self._w2_pending = False
+        unhit_probation = self.lfu.clear_probation()
+        if unhit_probation > 0:
+            self.lookahead_evictable += unhit_probation
+        self._in_flight_lookahead.clear()
+
+        slots = self.lfu.expert_to_slot[uniq]
+        resident_exps = uniq[slots >= 0]
+        cold_exps = uniq[slots < 0]
+
+        safe_ids = topk_ids.clamp(min=0)
+        valid_ids = topk_ids >= 0
+        tmp_out = torch.empty((rows, plan.hidden), dtype=pass_dtype, device=self.device)
+        mask_np = self._batch_mask_host.numpy()
+
+        if resident_exps.size > 0:
+            self.prefill_windows += 1
+            self.hits += int(resident_exps.size)
+            mask_np[:] = False
+            mask_np[resident_exps] = True
+            masked_ids = torch.where(
+                valid_ids & self._batch_mask_gpu[safe_ids], topk_ids, -1
+            )
+            plan.run(
+                x,
+                masked_ids,
+                topk_weights,
+                self.weights,
+                tmp_out,
+                workspace=workspace,
+                shared=None,
+                expert_to_slot=self.expert_to_slot_gpu,
+                wait_w2=None,
+            )
+            acc_fp32 = tmp_out.to(torch.float32, copy=True)
+            if cold_exps.size > 0:
+                torch.cuda.current_stream(self.device).synchronize()
+        else:
+            acc_fp32 = torch.zeros(
+                (rows, plan.hidden), dtype=torch.float32, device=self.device
+            )
+
+        batch_size = max(1, self.dynamic_slots)
+        total_cold = int(cold_exps.size)
+        for batch_start in range(0, total_cold, batch_size):
+            batch_arr = cold_exps[batch_start : batch_start + batch_size]
+            batch_list = batch_arr.tolist()
+            self.prefill_windows += 1
+            wait_w2 = self.ensure_active(batch_list, is_prefill=True)
+            mask_np[:] = False
+            mask_np[batch_arr] = True
+            masked_ids = torch.where(
+                valid_ids & self._batch_mask_gpu[safe_ids], topk_ids, -1
+            )
+            plan.run(
+                x,
+                masked_ids,
+                topk_weights,
+                self.weights,
+                tmp_out,
+                workspace=workspace,
+                shared=None,
+                expert_to_slot=self.expert_to_slot_gpu,
+                wait_w2=wait_w2,
+            )
+            acc_fp32.add_(tmp_out)
+            if wait_w2 is not None:
+                wait_w2()
+            if batch_start + batch_size < total_cold:
+                torch.cuda.current_stream(self.device).synchronize()
+
+        if shared is not None:
+            acc_fp32.add_(shared)
+
+        if out is not None:
+            out.copy_(acc_fp32)
+            return out
+
+        final_out = acc_fp32.to(final_dtype)
+
+        def combine(start: int, stop: int, rows_out: torch.Tensor) -> None:
+            rows_out.copy_(final_out[start:stop])
+
+        return combine
+
     def run(
         self,
         plan,
