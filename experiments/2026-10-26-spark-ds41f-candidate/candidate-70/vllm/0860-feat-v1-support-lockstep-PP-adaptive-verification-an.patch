+def test_pp_adaptive_verification_validation_and_apply_confidences():
+    from vllm.config.vllm import VllmConfig
+
+    cfg_unpinned = SimpleNamespace(
+        speculative_config=SimpleNamespace(
+            enable_adaptive_verification=True,
+            adaptive_verification_row_cost=None,
+        ),
+        lora_config=None,
+        parallel_config=SimpleNamespace(pipeline_parallel_size=2),
+    )
+    with pytest.raises(ValueError, match="pinned adaptive_verification_row_cost"):
+        VllmConfig._validate_adaptive_verification(cfg_unpinned)
+
+    cfg_pinned = SimpleNamespace(
+        speculative_config=SimpleNamespace(
+            enable_adaptive_verification=True,
+            adaptive_verification_row_cost=0.035,
+        ),
+        lora_config=None,
+        parallel_config=SimpleNamespace(pipeline_parallel_size=2),
+    )
+    VllmConfig._validate_adaptive_verification(cfg_pinned)
+
+    mgr = make_manager(np.ones((2, 5), dtype=np.float32), row_cost=0.035)
+    mgr._confidence_buffer = torch.ones((1, 2, 5), dtype=torch.float32)
+    mgr._confidence_probs = mgr._confidence_buffer[0]
+    mgr._planned_probs = mgr._confidence_buffer[-1]
+    idx = torch.tensor([0, 1], dtype=torch.int64)
+    idx_np = np.array([0, 1], dtype=np.int64)
+    conf_slice = torch.tensor(
+        [[[0.9, 0.8, 0.7, 0.6, 0.5], [0.4, 0.3, 0.2, 0.1, 0.05]]],
+        dtype=torch.float32,
+    )
+    mgr.apply_pp_confidences(idx, idx_np, conf_slice, torch.tensor([1], dtype=torch.int32))
+    assert mgr._is_calibrated() is True
+    np.testing.assert_allclose(
+        mgr._stale_confidences[mgr._stale_idx].np, conf_slice[0].numpy()
+    )
