From fd2e82c64fb1dc8e4d48a8d5f89a9f626db02593 Mon Sep 17 00:00:00 2001
From: Christopher Owen <christopherowen@users.noreply.github.com>
Date: Mon, 23 Nov 2026 10:47:51 +0100
Subject: [PATCH 859/860] perf(dsv41): enable intra-stage prefill sequence
 parallelism under PP > 1

Allow DeepSeek-V4.1 prefill sequence parallelism within each TP > 1 pipeline
stage while preserving the full-row IntermediateTensors PP wire ABI: non-first
stages slice incoming hidden_states and pre_mix into local SP rows at entry,
and non-last stages gather them via sp.gather_many before packing
IntermediateTensors. Also fix prepare_disk_engram when Engram layers [1, 14]
are split across separate pipeline stages.

Zero behavior change when pipeline_parallel_size == 1.

Upstream-base: 19f2c20ed4d64ae22bd009ceacadd85e2a81e354
Rationale: Lifts PP=2, TP=2 prefill by +16.1% at 32K (5,572 -> 6,471 tok/s) and +16.2% at 131K (5,728 -> 6,655 tok/s) with zero memory or decode regression.
Quality: Exact intra-stage SP; verified LRU 5/5 on live PP=2, TP=2.
Tests: pytest tests/models/test_deepseek_v4_1_sp_prefill.py -k test_resolve_min_rows
Upstream-status: Local PP+SP prefill optimization.
---
 tests/models/test_deepseek_v4_1_sp_prefill.py |  4 +++-
 vllm/models/deepseek_v4_1/nvidia/model.py     | 19 ++++++++++++++++++-
 vllm/models/deepseek_v4_1/sp_prefill.py       |  2 --
 3 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/tests/models/test_deepseek_v4_1_sp_prefill.py b/tests/models/test_deepseek_v4_1_sp_prefill.py
index b38cb4dca..c0b792d1a 100644
--- a/tests/models/test_deepseek_v4_1_sp_prefill.py
+++ b/tests/models/test_deepseek_v4_1_sp_prefill.py
@@ -121,9 +121,11 @@ def test_resolve_min_rows(monkeypatch):
     assert sp_prefill.resolve_min_rows(_config()) == 49
     assert sp_prefill.resolve_min_rows(_config(capture=512)) == 513
     assert sp_prefill.resolve_min_rows(_config(capture=None, spec_tokens=None)) == 9
+    # Intra-stage TP sequence parallelism runs under PP > 1 when TP > 1.
+    assert sp_prefill.resolve_min_rows(_config(pp=2)) == 49
     for disabled in (
         _config(tp=1),
-        _config(pp=2),
+        _config(tp=1, pp=2),
         _config(boundary=True),
     ):
         assert sp_prefill.resolve_min_rows(disabled) == 0
