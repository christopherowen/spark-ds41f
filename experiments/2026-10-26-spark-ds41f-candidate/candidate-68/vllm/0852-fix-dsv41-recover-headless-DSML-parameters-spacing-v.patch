+def _bpe_spelled_ids(tok, text: str) -> list[int]:
+    added = set(tok.get_added_vocab().values())
+    ids: list[int] = []
+    for tid in tok.encode(text, add_special_tokens=False):
+        if tid not in added:
+            ids.append(tid)
+            continue
+        for ch in tok.decode([tid]):
+            ids.extend(tok.encode(ch, add_special_tokens=False))
+    return ids
+
+
+def _run_serving(
+    tok,
+    ids: list[int],
+    *,
+    tools=None,
+    tool_choice="auto",
+    thinking: bool = True,
+    chunk: int | None = None,
+):
+    from vllm.parser.parser_manager import ParserManager
+
+    active_tools = TOOLS if tools is None else tools
+    cls = ParserManager.get_parser(
+        tool_parser_name="deepseek_v41",
+        reasoning_parser_name="deepseek_v41",
+        enable_auto_tools=True,
+    )
+    req = ChatCompletionRequest(
+        model="m",
+        messages=[{"role": "user", "content": "x"}],
+        tools=active_tools,
+        tool_choice=tool_choice,
+        include_reasoning=True,
+        stream=chunk is not None,
+        chat_template_kwargs={"thinking": thinking},
+    )
+    parser = cls(tok, active_tools, chat_template_kwargs={"thinking": thinking})
+    p_tok = tok.convert_tokens_to_ids("<think>" if thinking else "</think>")
+    prompt_ids = [p_tok]
+    if chunk is None:
+        parser.set_prompt_token_ids(prompt_ids)
+        r, c, calls = parser.parse(
+            tok.decode(ids),
+            req,
+            enable_auto_tools=True,
+            model_output_token_ids=ids,
+        )
+        return r or "", c or "", [(tc.name, json.loads(tc.arguments)) for tc in calls or []]
+
+    r_acc, c_acc = "", ""
+    merged: dict[int, list[str]] = {}
+    prev_txt = ""
+    for i in range(0, len(ids), chunk):
+        sub = ids[: i + chunk]
+        cur_txt = tok.decode(sub)
+        delta_txt = cur_txt[len(prev_txt) :]
+        prev_txt = cur_txt
+        d = parser.parse_delta(
+            delta_txt,
+            ids[i : i + chunk],
+            req,
+            prompt_token_ids=prompt_ids,
+            finished=(i + chunk >= len(ids)),
+        )
+        if d is None:
+            continue
+        r_acc += d.reasoning or ""
+        c_acc += d.content or ""
+        for tc in d.tool_calls or []:
+            slot = merged.setdefault(tc.index, ["", ""])
+            slot[0] += tc.function.name or ""
+            slot[1] += tc.function.arguments or ""
+    return r_acc, c_acc, [(n, json.loads(a)) for _, (n, a) in sorted(merged.items())]
+
+
+@pytest.mark.parametrize("chunk", [None, 1, 5])
+def test_preamble_exits_and_spacing_variants_and_orphan_invoke(tokenizer, chunk) -> None:
+    t_end = tokenizer.convert_tokens_to_ids("</think>")
+
+    empty_ids = (
+        _bpe_spelled_ids(tokenizer, "Plan.")
+        + [t_end]
+        + _bpe_spelled_ids(tokenizer, "Before. ")
+        + tokenizer.encode(f"{S}\n{E}", add_special_tokens=False)
+        + _bpe_spelled_ids(tokenizer, " After.")
+    )
+    r, c, calls = _run_serving(tokenizer, empty_ids, chunk=chunk)
+    assert r == "Plan." and calls == [] and "Before." in c and "After." in c
+
+    for variant in (
+        '<｜DSML｜calls>\n<｜DSML｜ invoke name="write_file">\n'
+        '<｜DSML｜ parameter name="path" string="true">a.txt</｜DSML｜ parameter>\n'
+        '<｜DSML｜ parameter name="content" string="true">ok</｜DSML｜ parameter>\n'
+        "</｜DSML｜ invoke>\n</｜DSML｜calls>",
+        '<｜DSML｜ tool_calls>\n<｜DSML｜ invoke name="write_file">\n'
+        '<｜DSML｜ parameter name="path" string="true">a.txt</｜DSML｜ parameter>\n'
+        '<｜DSML｜ parameter name="content" string="true">ok</｜DSML｜ parameter>\n'
+        "</｜DSML｜ invoke>\n</｜DSML｜ tool_calls>",
+        '<｜DSML｜tool_calls>\n<｜DSML｜invoke name="write_file">\n'
+        '<｜DSML｜parameter name="path" string="true">a.txt</｜DSML｜parameter>\n'
+        '<｜DSML｜parameter name="content" string="true">ok</｜DSML｜parameter>\n'
+        "</｜DSML｜invoke>\n</｜DSML｜tool_calls>",
+        '<｜DSML｜ function_calls>\n<｜DSML｜ function name="write_file" >\n'
+        '<｜DSML｜ parameter name="path">a.txt</｜DSML｜ parameter>\n'
+        '<｜DSML｜ parameter name="content">ok</｜DSML｜ parameter>\n'
+        "</｜DSML｜ function>\n</｜DSML｜ function_calls>",
+    ):
+        v_ids = (
+            _bpe_spelled_ids(tokenizer, "Plan.")
+            + [t_end]
+            + _bpe_spelled_ids(tokenizer, "Writing.\n\n")
+            + tokenizer.encode(variant, add_special_tokens=False)
+        )
+        _, vc, vcalls = _run_serving(tokenizer, v_ids, chunk=chunk)
+        assert vc == "Writing.\n\n"
+        assert vcalls == [("write_file", {"path": "a.txt", "content": "ok"})]
+
+        bpe_v_ids = (
+            _bpe_spelled_ids(tokenizer, "Plan.")
+            + [t_end]
+            + _bpe_spelled_ids(tokenizer, "Quoted:\n\n" + variant)
+        )
+        _, bc, bcalls = _run_serving(tokenizer, bpe_v_ids, chunk=chunk)
+        assert bcalls == [] and bc == "Quoted:\n\n" + variant
+
+    orphan_ids = _bpe_spelled_ids(tokenizer, "Direct plan.") + tokenizer.encode(
+        f'{IS}set_cfg">\n{_p("n", "9", "false")}{IE}\n{E}',
+        add_special_tokens=False,
+    )
+    or_r, or_c, or_calls = _run_serving(tokenizer, orphan_ids, chunk=chunk)
+    assert or_r == "Direct plan." and or_c == "" and or_calls == [("set_cfg", {"n": 9})]
+
+
+@pytest.mark.parametrize("chunk", [None, 1, 5])
+def test_headless_parameter_recovery_and_forced_tool_choice(tokenizer, chunk) -> None:
+    t_end = tokenizer.convert_tokens_to_ids("</think>")
+
+    # 1. Headless parameter block uniquely matching `write_file`
+    headless = (
+        f'{PS} name="path">notes.md{PE}\n'
+        f'{PS} name="content">hello{PE}\n'
+        f"{IE}\n{E}"
+    )
+    h_ids = (
+        _bpe_spelled_ids(tokenizer, "Plan.")
+        + [t_end]
+        + _bpe_spelled_ids(tokenizer, "Saving.\n\n")
+        + tokenizer.encode(headless, add_special_tokens=False)
+    )
+    r, c, calls = _run_serving(tokenizer, h_ids, chunk=chunk)
+    assert r == "Plan." and c == "Saving.\n\n"
+    assert calls == [("write_file", {"path": "notes.md", "content": "hello"})]
+
+    # 2. Substituted `parameter` for `invoke` (`name="set_cfg"`)
+    sub = f'{PS} name="set_cfg">\n{PS} name="n">42{PE}\n{IE}\n{E}'
+    s_ids = (
+        _bpe_spelled_ids(tokenizer, "Plan.")
+        + [t_end]
+        + tokenizer.encode(sub, add_special_tokens=False)
+    )
+    _, sc, scalls = _run_serving(tokenizer, s_ids, chunk=chunk)
+    assert sc == "" and scalls == [("set_cfg", {"n": 42})]
+
+    # 3. Ambiguous parameter keys across two declared tools -> quarantined
+    dup_tools = [
+        {
+            "type": "function",
+            "function": {
+                "name": "search_a",
+                "parameters": {
+                    "type": "object",
+                    "properties": {"q": {"type": "string"}},
+                    "required": ["q"],
+                },
+            },
+        },
+        {
+            "type": "function",
+            "function": {
+                "name": "search_b",
+                "parameters": {
+                    "type": "object",
+                    "properties": {"q": {"type": "string"}},
+                    "required": ["q"],
+                },
+            },
+        },
+    ]
+    amb_ids = (
+        _bpe_spelled_ids(tokenizer, "Plan.")
+        + [t_end]
+        + _bpe_spelled_ids(tokenizer, "Searching.\n\n")
+        + tokenizer.encode(f'{PS} name="q" string="true">abc{PE}\n{IE}\n{E}', add_special_tokens=False)
+    )
+    _, ac, acalls = _run_serving(tokenizer, amb_ids, tools=dup_tools, chunk=chunk)
+    assert acalls == [] and ac == "Searching.\n\n"
+
+    # 4. Forced/named tool_choice accepts BPE-spelled post-`</think>` DSML
+    forced_ids = (
+        _bpe_spelled_ids(tokenizer, f"Mention {S} in reasoning.")
+        + [t_end]
+        + _bpe_spelled_ids(tokenizer, f'\n\n{S}\n{IS}set_cfg">\n{_p("n", "11", "false")}{IE}\n{E}')
+    )
+    for tc in ("required", {"type": "function", "function": {"name": "set_cfg"}}):
+        fr, fc, fcalls = _run_serving(tokenizer, forced_ids, tool_choice=tc, chunk=chunk)
+        assert fr == f"Mention {S} in reasoning." and fc == ""
+        assert fcalls == [("set_cfg", {"n": 11})]
