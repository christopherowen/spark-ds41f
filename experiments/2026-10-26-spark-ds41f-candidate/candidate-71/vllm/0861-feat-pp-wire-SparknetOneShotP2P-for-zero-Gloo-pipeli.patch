+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import numpy as np
+import pytest
+import torch
+
+from vllm.v1.worker.gpu.pp_utils import PPHandler
+from vllm.v1.worker.gpu_worker import Worker
+
+
+class _FakeP2P:
+    def __init__(self, *, disabled: bool = False, failure_msg: str | None = None):
+        self.disabled = disabled
+        self._failure_msg = failure_msg
+        self.sent: list[tuple[list[tuple[tuple[int, ...], torch.dtype]], int]] = []
+        self.recvd: list[tuple[list[tuple[tuple[int, ...], torch.dtype]], int]] = []
+        self.health_checks = 0
+        self.closed = False
+
+    def send_tensors(self, tensors, dst: int, *, stream=None):
+        self.sent.append(([(tuple(t.shape), t.dtype) for t in tensors], dst))
+
+    def recv_tensors(self, outs, src: int, *, stream=None):
+        self.recvd.append(([(tuple(t.shape), t.dtype) for t in outs], src))
+        return list(outs)
+
+    def failure(self):
+        return self._failure_msg
+
+    def check_health(self):
+        self.health_checks += 1
+        if self._failure_msg:
+            raise RuntimeError(self._failure_msg)
+
+    def close(self):
+        self.closed = True
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA")
+def test_pp_handler_sparknet_p2p_coalesced_broadcast_and_recv(monkeypatch):
+    monkeypatch.setenv("VLLM_PP_SPARKNET_P2P", "1")
+    fake_tx = _FakeP2P()
+    fake_rx = _FakeP2P()
+
+    def _make_group(is_last: bool):
+        return SimpleNamespace(
+            is_last_rank=is_last,
+            last_rank=2,
+            world_size=2,
+            cpu_group="cpu-pp",
+            make_sibling_device_group=lambda **kw: (_ for _ in ()).throw(
+                AssertionError("should not create sibling NCCL group when P2P active")
+            ),
+        )
+
+    device = torch.device("cuda", 0)
+    with (
+        patch("vllm.v1.worker.gpu.pp_utils.get_pp_group", return_value=_make_group(True)),
+        patch("sparknet.integration.vllm.SparknetOneShotP2P", return_value=fake_tx),
+    ):
+        tx_handler = PPHandler(max_num_reqs=8, num_speculative_steps=5, device=device)
+        assert tx_handler.broadcast_group is None
+        tx_handler.configure_confidence_broadcast(True, planes=2)
+        batch = SimpleNamespace(
+            num_reqs=2,
+            num_computed_tokens_np=np.array([10, 10]),
+            prefill_len_np=np.array([5, 5]),
+            num_scheduled_tokens=np.array([1, 1]),
+            idx_mapping=torch.tensor([0, 1], dtype=torch.int32, device=device),
+            idx_mapping_np=np.array([0, 1], dtype=np.int32),
+        )
+        tx_handler.broadcast(
+            torch.ones((2, 6), dtype=torch.int64, device=device),
+            torch.ones((2,), dtype=torch.int32, device=device),
+            torch.zeros((2,), dtype=torch.int32, device=device),
+            batch,
+        )
+        tx_handler.broadcast_drafts(
+            torch.ones((8, 5), dtype=torch.int64, device=device),
+            batch,
+            confidences=torch.ones((2, 2, 5), dtype=torch.float32, device=device),
+            is_calibrated=True,
+        )
+        tx_handler.close()
+        assert fake_tx.closed
+
+    with (
+        patch("vllm.v1.worker.gpu.pp_utils.get_pp_group", return_value=_make_group(False)),
+        patch("sparknet.integration.vllm.SparknetOneShotP2P", return_value=fake_rx),
+    ):
+        rx_handler = PPHandler(max_num_reqs=8, num_speculative_steps=5, device=device)
+        assert rx_handler.broadcast_group is None
+        rx_handler.configure_confidence_broadcast(True, planes=2)
+        rx_handler.receive(batch)
+        rx_handler.close()
+        assert fake_rx.closed
+
+    # Sender targets PP-local rank 0; receiver reads from PP-local last rank 1; schemas match 1:1.
+    assert [dst for _, dst in fake_tx.sent] == [0, 0]
+    assert [src for _, src in fake_rx.recvd] == [1, 1]
+    assert [shapes for shapes, _ in fake_tx.sent] == [shapes for shapes, _ in fake_rx.recvd]
+
+
+def test_worker_roce_failure_and_health_include_pp_p2p():
+    w = object.__new__(Worker)
+    w._pp_p2p = _FakeP2P(failure_msg="p2p recv stalled")
+    w.model_runner = SimpleNamespace(
+        pp_handler=SimpleNamespace(_pp_bcast_p2p=_FakeP2P(failure_msg=None))
+    )
+    tp_comm = SimpleNamespace(
+        roce_failure=lambda: "tp stalled",
+        roce_ar_comm=SimpleNamespace(check_health=lambda: None),
+    )
+    with patch(
+        "vllm.v1.worker.gpu_worker.get_tp_group",
+        return_value=SimpleNamespace(device_communicator=tp_comm),
+    ):
+        report = w._roce_failure()
+        assert report == "tp stalled; p2p recv stalled"
+        check = w._roce_health_check()
+        assert check is not None
+        with pytest.raises(RuntimeError, match="p2p recv stalled"):
+            check()
