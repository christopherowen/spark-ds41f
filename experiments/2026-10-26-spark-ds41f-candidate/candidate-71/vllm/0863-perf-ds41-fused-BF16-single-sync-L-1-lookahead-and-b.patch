+def load_expert_hotlist(spec: str, num_experts: int) -> dict[int, np.ndarray]:
+    """Load a per-layer expert frequency map from multidomain or a JSON path."""
+    spec = spec.strip()
+    if not spec:
+        return {}
+    if spec == "multidomain":
+        return {
+            layer_idx: np.asarray(counts, dtype=np.float64)
+            for layer_idx, counts in HOTLIST_MULTIDOMAIN_HELDOUT.items()
+            if len(counts) == num_experts
+        }
+    path = Path(spec)
+    if not path.is_file():
+        raise FileNotFoundError(f"DS4.1 expert hotlist not found: {spec}")
+    raw = json.loads(path.read_text())
+    layers = raw.get("layers", raw) if isinstance(raw, dict) else {}
+    out: dict[int, np.ndarray] = {}
+    for key, vals in layers.items():
+        if vals is not None and len(vals) == num_experts:
+            out[int(key)] = np.asarray(vals, dtype=np.float64)
+    return out
