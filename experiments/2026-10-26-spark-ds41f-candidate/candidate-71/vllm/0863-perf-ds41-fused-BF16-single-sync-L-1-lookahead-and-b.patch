+    @torch.no_grad()
+    def predict_topk_gpu(self, hidden_states: torch.Tensor) -> torch.Tensor | None:
+        """Predict [rows, top_k] int32 expert IDs on GPU without FP32 weight cast or D2H sync."""
+        x = hidden_states.reshape(-1, hidden_states.shape[-1])
+        if x.shape[0] == 0 or x.shape[0] > self.max_rows:
+            return None
+        w = self.gate_weight
+        logits = F.linear(x.to(w.dtype), w).float()
+        scores = torch.sqrt(
+            torch.where(logits > 20.0, logits, F.softplus(logits))
+        )
+        if self.bias is not None:
+            bias_f32 = getattr(self, "_bias_f32", None)
+            if bias_f32 is None:
+                bias_f32 = self.bias.float().unsqueeze(0)
+                self._bias_f32 = bias_f32
+            scores = scores + bias_f32
+        _, topk_ids = torch.topk(scores, k=self.top_k, dim=-1, largest=True, sorted=False)
+        return topk_ids.to(torch.int32)
+
