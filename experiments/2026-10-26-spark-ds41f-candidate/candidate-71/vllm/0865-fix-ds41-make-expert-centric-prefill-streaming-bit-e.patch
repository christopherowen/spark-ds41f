                 wait_w2()
             if batch_start + batch_size < total_cold:
                 torch.cuda.current_stream(self.device).synchronize()
 
-        if shared is not None:
-            acc_fp32.add_(shared)
-
+        assert last_dispatch is not None and last_layout is not None
+        combine_route_pos = torch.where(
+            valid_ids,
+            torch.arange(rows * topk, dtype=torch.int32, device=self.device).view(
