From e69d8114e031c2a1724134ede5369b3102c2a0b3 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Mon, 23 Nov 2026 20:36:31 +0100
Subject: [PATCH] fix(ds41): make expert-centric prefill streaming bit-exact
 and batch-invariant

Factor MoeExpertsV41Plan.run_routed() out of run() and stage each wave's BF16 down-projection rows into (token, k) order in y_all before running one final TileLang dispatch.combine() pass. Every token's routed experts are reduced in exact k=0..topk-1 FP32 order with shared folded once, matching ref_plan.run bit-for-bit (torch.equal) regardless of cache residency, prior traffic, or concurrent batch composition while preserving single-pass LBA NVMe streaming speed.

Also restores strict torch.equal assertions (including warm-cache repeat invariance) in test_deepseek_v41_expert_slots.py and fixes the kwarg and device check in test_expert_hotlist_and_fast_lookahead.py.
---
 .../moe/test_deepseek_v41_expert_slots.py     | 15 +++--
 .../test_expert_hotlist_and_fast_lookahead.py |  8 +--
 .../deepseek_v4_1/expert_slots/cache.py       | 67 ++++++++++++-------
 vllm/models/deepseek_v4_1/tilelang/moe.py     | 45 ++++++++++---
 4 files changed, 89 insertions(+), 46 deletions(-)

diff --git a/tests/kernels/moe/test_deepseek_v41_expert_slots.py b/tests/kernels/moe/test_deepseek_v41_expert_slots.py
index 8754f3522..cd7940a34 100644
--- a/tests/kernels/moe/test_deepseek_v41_expert_slots.py
+++ b/tests/kernels/moe/test_deepseek_v41_expert_slots.py
@@ -253,16 +253,17 @@ def test_pack_and_role_major_io_uring_read_fixed_bit_exact(
         out_ref_p = torch.empty(p_rows, hidden, dtype=torch.bfloat16, device="cuda")
         out_slot_p = torch.empty(p_rows, hidden, dtype=torch.bfloat16, device="cuda")
         ref_plan.run(xp_q, p_ids, p_w, ref_weights, out_ref_p)
-        # Default expert-centric prefill sweeps each cold expert once.
+        # Default expert-centric prefill sweeps each cold expert once and is
+        # bit-exact (cache-state and batch invariant) against ref_plan.run.
         cache.run(slot_plan, xp_q, p_ids, p_w, out_slot_p)
         torch.cuda.synchronize()
-        assert torch.allclose(
-            out_ref_p,
-            out_slot_p,
-            rtol=2e-2,
-            atol=max(2.0, 2e-2 * float(out_ref_p.abs().max())),
-        )
+        assert torch.equal(out_ref_p, out_slot_p)
         assert 1 < cache.prefill_windows <= 4
+        # Repeat with the mutated warm cache state to prove cache-order invariance.
+        out_slot_p2 = torch.empty(p_rows, hidden, dtype=torch.bfloat16, device="cuda")
+        cache.run(slot_plan, xp_q, p_ids, p_w, out_slot_p2)
+        torch.cuda.synchronize()
+        assert torch.equal(out_ref_p, out_slot_p2)
         # Token-order fallback remains bit-exact when selected.
         cache._expert_centric_prefill = False
         out_slot_tok = torch.empty(p_rows, hidden, dtype=torch.bfloat16, device="cuda")
diff --git a/tests/models/deepseek_v4_1/test_expert_hotlist_and_fast_lookahead.py b/tests/models/deepseek_v4_1/test_expert_hotlist_and_fast_lookahead.py
