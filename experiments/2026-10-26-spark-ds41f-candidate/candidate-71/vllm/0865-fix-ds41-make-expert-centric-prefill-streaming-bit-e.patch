diff --git a/vllm/models/deepseek_v4_1/tilelang/moe.py b/vllm/models/deepseek_v4_1/tilelang/moe.py
index 7ab4c8650..0b6e29cba 100644
--- a/vllm/models/deepseek_v4_1/tilelang/moe.py
+++ b/vllm/models/deepseek_v4_1/tilelang/moe.py
@@ -2378,6 +2378,41 @@ class MoeExpertsV41Plan:
         and ``shared`` (a callable one is still called here), which must stay
         unchanged until its last call.
         """
+        dispatch, layout, y = self.run_routed(
+            x,
+            topk_ids,
+            topk_weights,
+            weights,
+            workspace=workspace,
+            expert_to_slot=expert_to_slot,
+            wait_w2=wait_w2,
+        )
+        if callable(shared):
+            shared = shared()
+        if out is not None:
+            return dispatch.combine(y, layout, out, shared=shared)
+
+        def combine(start, stop, rows_out):
+            dispatch.combine(y, layout, rows_out, shared=shared, start=start, stop=stop)
+
+        return combine
+
+    def run_routed(
+        self,
+        x: MXFP8Rows,
+        topk_ids,
+        topk_weights,
+        weights,
+        workspace=None,
+        *,
+        expert_to_slot=None,
+        wait_w2=None,
+    ):
+        """Run dispatch, gate_up/swiglu, and down without combining routes.
+
+        Returns ``(dispatch, layout, y)`` where ``y`` holds the BF16 per-route
+        down-projection rows addressed by ``layout["route_pos"]``.
+        """
         rows = topk_ids.shape[0]
         dispatch = self._dispatch_for(rows, topk_ids.dtype)
         gate_up_kernel, swiglu_kernel, down_kernel = self._kernels_for(rows)
@@ -2420,15 +2455,7 @@ class MoeExpertsV41Plan:
         if wait_w2 is not None:
             wait_w2()
         down_kernel(hq, h_words, *_present(down), order, tile_expert, y)
-        if callable(shared):
-            shared = shared()
-        if out is not None:
