+    def record_input_ready(
+        self,
+        shared_experts_input: torch.Tensor,
+    ) -> bool:
+        """Record ``_input_ready_event`` on the main stream before router gate launch.
+
+        When the aux-stream shared expert launch is deferred until after the router
+        gate GEMM (``_post_gate_hook``), recording the input-ready event before the
+        gate GEMM lets the aux stream start immediately without waiting on the gate
+        GEMM or inserting an event record between the gate GEMM and top-k routing.
+        """
+        if (
+            self._determine_shared_experts_order(shared_experts_input)
+            != SharedExpertsOrder.MULTI_STREAM_OVERLAPPED
+        ):
+            return False
+        assert self._stream is not None
+        idx = self._output_idx
+        assert self._output[idx] is None
+        shared_experts_input.record_stream(self._stream)
+        self._input_ready_event[idx].record(current_stream())
+        return True
+
     def maybe_forward_async(
         self,
         shared_experts_input: torch.Tensor,
         workspace: torch.Tensor | None = None,
+        *,
+        input_ready_recorded: bool = False,
     ) -> bool:
