index d9062785b..80c113d2d 100644
--- a/tests/v1/spec_decode/test_adaptive_verification.py
+++ b/tests/v1/spec_decode/test_adaptive_verification.py
@@ -947,3 +947,118 @@ def test_high_concurrency_row_cost_knee_admits_coalesced_drafts():
     _, _, knee_budget = manager._batch_budget
     assert knee_budget == 32
     assert total == 40
+def test_saturated_row_cost_knee_curbs_second_wave_over_admission():
+    """Above 64 rows (DECODE_ROWS / DECODE_CHUNK), Tensor Core tiles and MoE
+    expert union saturate, returning marginal row cost to >= 1.0x and adding a
+    second-wave step jump so low-confidence tail drafts do not spill past 64."""
+    # 16 requests with 5 drafts: positions 0..2 have high survival (0.90, 0.81, 0.729)
+    # filling 16 + 48 = 64 rows; position 3 has survival 0.36 (profitable only if
+    # the 0.55x discount continued forever past 64 rows).
+    confidences = np.tile(
+        np.array([[0.90, 0.90, 0.90, 0.62, 0.50]], dtype=np.float32), (16, 1)
+    )
+    manager = make_manager(confidences, row_cost=0.035)
+    req_ids = [f"r{i}" for i in range(16)]
+    manager.req_states.req_id_to_index = {rid: i for i, rid in enumerate(req_ids)}
+    manager.dead_rows_tau = 0.15
+
+    num_tokens_per_req = {rid: 6 for rid in req_ids}
+    draft_tokens = {rid: [1, 2, 3, 4, 5] for rid in req_ids}
+
+    # Without the 64-row saturation knee, 0.55x slope admits position 3 into the
+    # 80-row second wave.
+    manager.saturated_row_cost_knee = 0
+    manager.second_wave_step_rows = 0.0
+    unbounded_total = manager.get_num_tokens(num_tokens_per_req, draft_tokens)
+    assert unbounded_total == 80
+
+    # With the 64-row saturation knee and second-wave step, total rows stay at 64.
+    manager.saturated_row_cost_knee = 64
+    manager.saturated_row_cost_scale = 1.0
+    manager.second_wave_step_rows = 2.0
+    capped_total = manager.get_num_tokens(num_tokens_per_req, draft_tokens)
+    _, _, capped_budget = manager._batch_budget
+    assert capped_budget == 48
+    assert capped_total == 64
+
+
+def test_single_request_16_row_mma_tile_boundary_prevents_spill():
+    """A single request (c1) with > 15 candidate drafts has no cross-request
+    expert coalescing above 16 rows and must pay the 16->17 MMA tile step."""
+    # 1 request with 19 copy-draft slots (20 rows max): first 15 drafts have 0.96
+    # conditional confidence, tail drafts 15..18 have survival ~0.042.
+    probs = np.array(
+        [[0.96] * 15 + [0.095, 0.98, 0.98, 0.98]], dtype=np.float32
+    )
+    manager = make_manager(probs, row_cost=0.035)
+    manager.req_states.req_id_to_index = {"r0": 0}
+    total = manager.get_num_tokens({"r0": 20}, {"r0": list(range(19))})
+    _, _, draft_budget = manager._batch_budget
+    # Stops at 15 drafts (16 total rows = 1 MMA tile) rather than spilling into
+    # the 2nd 16-row MMA tile for low-survival tail drafts.
+    assert draft_budget == 15
+    assert total == 16
+
+
+def test_context_length_band_scales_row_cost_and_dead_rows_tau():
+    """Deep active context (16K..128K) scales marginal per-row indexer cost and
+    tightens calibrated dead-row thresholds while keeping <= 8K unchanged."""
+    confidences = np.tile(
+        np.array([[0.78, 0.72, 0.71, 0.71, 0.73]], dtype=np.float32), (8, 1)
+    )
+    manager = make_manager(confidences, row_cost=0.035)
+    req_ids = [f"r{i}" for i in range(8)]
+    manager.req_states.req_id_to_index = {rid: i for i, rid in enumerate(req_ids)}
+    manager.dead_rows_tau = 0.20
+    manager.calibrated_confidence = True
+
+    scales = manager._context_row_cost_scale(
+        np.array([2048, 8192, 16384, 32768, 65536, 131072])
+    )
+    assert np.allclose(scales[:2], [1.0, 1.0])
+    assert np.all(np.diff(scales[1:]) > 0)
+
+    num_tokens_per_req = {rid: 6 for rid in req_ids}
+    draft_tokens = {rid: [1, 2, 3, 4, 5] for rid in req_ids}
+
+    # At 2K and 8K context, c8 admits 32 draft rows (total 40).
+    for ctx_len in (2048, 8192):
+        manager.req_states.num_computed_tokens_np = np.full(8, ctx_len, dtype=np.int32)
+        assert manager.get_num_tokens(num_tokens_per_req, draft_tokens) == 40
+        assert np.isclose(
+            manager.effective_dead_rows_tau(),
+            2.0 * 0.035 / (1.0 + 3.0 * 0.035),
+        )
+
+    # At 128K context, uncoalesced indexer cost per row trims position 3
+    # (survival 0.2831), reducing draft budget from 32 to 24 (total 32) and
+    # raising the calibrated dead-row threshold.
+    manager.req_states.num_computed_tokens_np = np.full(8, 131072, dtype=np.int32)
+    total_128k = manager.get_num_tokens(num_tokens_per_req, draft_tokens)
+    _, _, budget_128k = manager._batch_budget
+    assert budget_128k == 24
+    assert total_128k == 32
+    assert manager.effective_dead_rows_tau() > 2.0 * 0.035 / (1.0 + 3.0 * 0.035)
+
+
+def test_heterogeneous_context_batch_prioritizes_short_context_drafts():
+    """In a mixed-context cohort, short-context requests receive draft budget
+    ahead of deep-context requests with similar raw confidence."""
+    confidences = np.array(
+        [
+            [0.75, 0.72, 0.70, 0.68, 0.65],  # short (2K)
+            [0.76, 0.72, 0.70, 0.68, 0.65],  # long (128K)
+        ],
+        dtype=np.float32,
+    )
+    manager = make_manager(confidences, row_cost=0.055)
+    manager.req_states.req_id_to_index = {"short": 0, "long": 1}
+    manager.req_states.num_computed_tokens_np = np.array([2048, 131072], dtype=np.int32)
+
+    manager.get_num_tokens(
+        {"short": 6, "long": 6},
+        {"short": [1, 2, 3, 4, 5], "long": [1, 2, 3, 4, 5]},
+    )
+    num_drafts_per_req, _, draft_budget = manager._batch_budget
+    assert 0 < draft_budget < 10
+    assert num_drafts_per_req["short"] > num_drafts_per_req["long"]
