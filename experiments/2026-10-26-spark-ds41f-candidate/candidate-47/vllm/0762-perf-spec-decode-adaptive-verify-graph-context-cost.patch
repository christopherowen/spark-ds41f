+            if num_reqs is not None and num_reqs <= 1
+            else 0.0
+        )
+        single_req = tile_step > 0.0
+        mid_scale = 1.0 if single_req else scale
+        if knee > 0:
+            band1 = np.minimum(rows_f, knee)
+            if sat_knee > knee:
+                band2 = np.clip(rows_f - knee, 0.0, sat_knee - knee)
+                band3 = np.maximum(rows_f - sat_knee, 0.0)
+                effective_rows = band1 + mid_scale * band2 + sat_scale * band3
+            else:
