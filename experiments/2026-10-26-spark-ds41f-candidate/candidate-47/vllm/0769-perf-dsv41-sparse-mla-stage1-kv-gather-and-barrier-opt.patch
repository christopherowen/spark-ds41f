-        # first keeps shared-memory reads out of the issue loop.
+    def load_copy_slots(chunk, slots, base, copy_slot):
+        # Preload copy_slot from shared slots before waiting on the previous
+        # cp.async group so shared-memory slot reads do not force an extra
+        # barrier before issuing the next chunk's cp.async copies.
+        is_swa = True if not idx_blocks else chunk < swa_blocks
+        tx = T.get_thread_binding()
+        if is_swa:
+            swa_segs = SWA_RECORD_BYTES // 16
+            for k in T.unroll(tilelang.cdiv(BI * swa_segs, threads)):
+                copy_slot[k] = slots[
+                    base + T.min((k * threads + tx) // swa_segs, BI - 1)
+                ]
+        else:
+            idx_segs = IDX_RECORD_BYTES // 16
+            for k in T.unroll(tilelang.cdiv(BI * idx_segs, threads)):
+                copy_slot[k] = slots[
+                    base + T.min((k * threads + tx) // idx_segs, BI - 1)
+                ]
+
+    @T.macro
+    def issue_stage_records(Records, record_bytes, page_size, staged, copy_slot):
+        # cp.async each record into its exact-stride staging row, 16 bytes per
+        # copy; masked entries are zero-filled, so they dequantize to zero.
