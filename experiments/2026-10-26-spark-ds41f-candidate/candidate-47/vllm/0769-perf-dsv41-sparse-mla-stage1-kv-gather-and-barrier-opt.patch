+@pytest.mark.parametrize("heads", [16, 24])
+def test_sparse_mla_short_indexed_segments_match_across_routes(heads, rows=6):
+    """Ragged indexed lengths spanning 0..300 exercise 1..4 active segments per row
+    in extend (active_segs), decode (skip_inactive=True), and split
+    (skip_inactive=False); all three routes must match bit for bit."""
+    case = _mla_case(512, heads, rows)
+    case["idx_len"] = torch.tensor(
+        [0, 17, 64, 128, 129, 300][:rows], dtype=torch.int32, device=DEVICE
+    )
+    outs = _mla_run(case)
+    ref = _mla_ref(case)
+    torch.testing.assert_close(
+        outs["extend"].float(), ref.float(), rtol=0.13, atol=2e-2
+    )
+    for kernel, out in outs.items():
+        assert torch.equal(out, outs["extend"]), f"{kernel} differs from extend"
