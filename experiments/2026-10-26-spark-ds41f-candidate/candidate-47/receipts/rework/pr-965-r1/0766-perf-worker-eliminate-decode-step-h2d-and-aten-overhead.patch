+def test_block_tables_apply_staged_writes_skips_clean_decode_steps(monkeypatch):
+    """Non-allocating decode steps (overwrite=False, empty block_ids) skip UVA/GPU writes."""
+    device = torch.device("cuda")
+    block_tables = BlockTables(
+        block_sizes=[16, 32],
+        max_num_reqs=4,
+        max_num_batched_tokens=64,
+        max_num_blocks_per_group=[8, 8],
+        device=device,
+        kernel_block_sizes=[16, 16],
+    )
+    block_tables.append_block_ids(
+        req_index=0,
+        new_block_ids=([1, 2], [3]),
+        overwrite=True,
+    )
+    assert block_tables._dirty
+    block_tables.apply_staged_writes()
+    assert not block_tables._dirty
+
+    # Append empty block lists as on a normal decode step that allocates no new blocks.
+    block_tables.append_block_ids(
+        req_index=0,
+        new_block_ids=([], []),
+        overwrite=False,
+    )
+    assert not block_tables._dirty
+
+    monkeypatch.setattr(
+        block_tables.fused_writer,
+        "apply",
+        lambda *a, **kw: pytest.fail("clean decode step must skip fused_writer.apply"),
+    )
+    monkeypatch.setattr(
+        block_tables.num_blocks,
+        "copy_to_uva",
+        lambda *a, **kw: pytest.fail("clean decode step must skip num_blocks.copy_to_uva"),
+    )
+    block_tables.apply_staged_writes()
+
+
+def test_block_tables_apply_staged_writes_applies_writes_staged_on_a_table():
+    """The skip covers only a step with nothing staged: a write staged on a table
+    directly, outside append_block_ids, still lands on the next apply."""
+    device = torch.device("cuda")
+    block_tables = BlockTables(
+        block_sizes=[16, 32],
+        max_num_reqs=4,
+        max_num_batched_tokens=64,
+        max_num_blocks_per_group=[8, 8],
+        device=device,
+        kernel_block_sizes=[16, 16],
+    )
+    block_tables.block_tables[1].stage_write(2, 3, [7, 8])
+    assert not block_tables._dirty
+    block_tables.apply_staged_writes()
+    torch.accelerator.synchronize()
+    assert block_tables.block_tables[1].gpu[2, 3:5].tolist() == [7, 8]
+    assert not block_tables.block_tables[1]._staged_write_indices
