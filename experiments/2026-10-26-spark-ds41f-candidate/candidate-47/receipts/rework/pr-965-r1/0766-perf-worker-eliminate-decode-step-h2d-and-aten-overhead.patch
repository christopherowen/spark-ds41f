@@ -438,6 +438,55 @@ def test_step_ignores_negative_idx_mapping_and_dead_row_cut():
     )
 
 
+@pytest.mark.parametrize("device_name", ["cuda", "cpu"])
+def test_step_fuses_dead_row_cut_and_copy_int_state(device_name: str):
+    """Fused dead_row_cut and copy_int_state in step() matches unfused reference."""
+    device = torch.device(device_name)
+    torch.manual_seed(99)
+    est_fused = OnlineAcceptanceEstimator.for_confidence_head(
+        MAX_NUM_REQS, NUM_STEPS, device
+    )
+    est_ref = OnlineAcceptanceEstimator.for_confidence_head(
+        MAX_NUM_REQS, NUM_STEPS, device
+    )
+    feats = torch.randn(MAX_NUM_REQS, NUM_STEPS, device=device)
+    preds = torch.rand(MAX_NUM_REQS, NUM_STEPS, device=device) * 0.8 + 0.1
+    est_fused.features.copy_(feats)
+    est_fused.predictions.copy_(preds)
+    est_ref.features.copy_(feats)
+    est_ref.predictions.copy_(preds)
+
+    idx_mapping = torch.tensor([0, 2, 5, -1, 7], dtype=torch.int32, device=device)
+    num_sampled = torch.tensor([3, 2, 4, 1, 1], dtype=torch.int32, device=device)
+    num_rejected = torch.tensor([2, 3, 1, 0, 4], dtype=torch.int32, device=device)
+    dead_row_cut = torch.tensor([2, 2, 4, 0, 2], dtype=torch.int32, device=device)
+    copy_int_state = torch.zeros((MAX_NUM_REQS, 2), dtype=torch.int32, device=device)
+    # Mark slot 2 as having a pending CopyDrafter proposal (> 0 in column 1).
+    copy_int_state[2, 1] = 8
+
+    est_fused.step(
+        idx_mapping,
+        num_sampled,
+        num_rejected,
+        dead_row_cut=dead_row_cut,
+        copy_int_state=copy_int_state,
+    )
+
+    live_rejected = (dead_row_cut - (num_sampled - 1).clamp_min(0)).clamp_min(0)
+    ref_rejected = torch.minimum(num_rejected, live_rejected)
+    safe_idx = idx_mapping.clamp_min(0)
+    ref_idx = torch.where(
+        (idx_mapping >= 0) & (copy_int_state[safe_idx, 1] > 0),
+        -1,
+        idx_mapping,
+    )
+    est_ref.step(ref_idx, num_sampled, ref_rejected)
+
+    torch.testing.assert_close(est_fused.counts, est_ref.counts)
+    torch.testing.assert_close(est_fused.info, est_ref.info)
+    torch.testing.assert_close(est_fused.grad, est_ref.grad)
+
+
 def test_confidence_head_online_irls_reduces_survival_mae():
     """Online IRLS calibration of an overconfident confidence head recovers true survival."""
     device = torch.device("cuda")
