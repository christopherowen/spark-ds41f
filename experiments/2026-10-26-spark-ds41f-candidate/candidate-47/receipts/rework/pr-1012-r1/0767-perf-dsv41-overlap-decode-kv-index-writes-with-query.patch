+def test_decode_two_stream_overlap_schedules_disjoint_workspaces(monkeypatch):
+    """On decode steps, ``_forward`` forks ``aux_stream`` with disjoint workspace
+    slices: KV+Index source layers overlap ``_index_query`` with the post-gather
+    compressor + index-key write chain and overlap ``_rope(q)`` + decode metadata
+    with ``_index_chunk``; index-only reindex layers overlap ``_rope(q)`` +
+    ``indexer.weights_proj`` with ``indexer.wq_b``."""
+    import contextlib
+
+    from vllm.models.deepseek_v4_1 import attention
+    from vllm.models.deepseek_v4_1.compressor import DeepseekCompressor
+    from vllm.models.deepseek_v4_1.tilelang.linear import MXFP8Rows
+    from vllm.v1.worker import workspace as ws_mod
+
+    events = []
+    ws_buf = torch.zeros(65536, dtype=torch.uint8)
+
+    class _FakeStream:
+        def __init__(self, name):
+            self.name = name
+
+        def wait_stream(self, other):
+            events.append(("wait_stream", self.name, getattr(other, "name", "main")))
+
+    main_s = _FakeStream("main")
+    aux_s = _FakeStream("aux")
+    active_stream = [main_s]
+
+    @contextlib.contextmanager
+    def fake_stream_ctx(s):
+        prev = active_stream[0]
+        active_stream[0] = s
+        try:
+            yield
+        finally:
+            active_stream[0] = prev
+
+    class _FakeWM:
+        def get_simultaneous(self, *specs):
+            out, off = [], 0
+            for shape, dtype in specs:
+                n = dtype.itemsize
+                for d in shape:
+                    n *= d
+                out.append(ws_buf[off : off + n].view(dtype).view(shape))
+                off += (n + 255) // 256 * 256
+            return tuple(out)
+
+    monkeypatch.setattr(attention, "aux_stream", lambda: aux_s)
+    monkeypatch.setattr(attention, "current_workspace_manager", lambda: _FakeWM())
+    monkeypatch.setattr(attention, "retain_cuda_graph_capture_resource", lambda _: None)
+    monkeypatch.setattr(torch.cuda, "current_stream", lambda *_: active_stream[0])
+    monkeypatch.setattr(torch.cuda, "stream", fake_stream_ctx)
+    monkeypatch.setattr(torch.cuda, "is_current_stream_capturing", lambda: False)
+    monkeypatch.setattr(torch.Tensor, "record_stream", lambda self, s: None)
+
+    module = _tilelang_layer(layer_id=2)
+    module._ready = True
+    module.is_draft = False
+    module.index_source_layer_id = 2
+    module._context = {module.prefix: module}
+    module._draft_replays = False
+    module._l2pf_wo = None
+    module._l2pf_comp = None
+    module._owner = lambda: module
+    module.q_lora_rank = 16
+    module.n_local_heads = 2
+    module.compress_ratio = 2
+    module._main_page = 64
+    module._index_page = 64
+    module._index_width = 16
+    module.DECODE_CHUNK = 64
+    module.INDEX_CHUNK = 64
+    module.candidate_source_layer = 20
+    module._attention_geometry()
+    module._short_index_shape = None
+    module.topk_indices_buffer = torch.zeros(64, 512, dtype=torch.int32)
+    module._index_pages = torch.zeros(64, 16, dtype=torch.int32)
+    module._active = torch.tensor([1024], dtype=torch.int32)
+    module.kv_cache = torch.zeros(4, 64 * 288, dtype=torch.uint8)
+    module.swa_cache_layer = SimpleNamespace(
+        prefix="swa", block_size=64, kv_cache=torch.zeros(4, 64 * 528, dtype=torch.uint8)
+    )
+    module.rotary_emb = SimpleNamespace(
+        cos_sin_cache=SimpleNamespace(is_cuda=True, shape=(4096, 64))
+    )
+
+    comp = DeepseekCompressor.__new__(DeepseekCompressor)
+    torch.nn.Module.__init__(comp)
+    comp.compress_ratio = 2
+    comp._values = torch.zeros(64, 512)
+    comp._latent = torch.zeros(64, 512, dtype=torch.bfloat16)
+    comp._slots = torch.arange(64, dtype=torch.int64)
+    comp.state_cache = SimpleNamespace(prefix="state")
+    monkeypatch.setattr(
+        DeepseekCompressor,
+        "_project_local",
+        lambda self, h: (events.append(("project_local", active_stream[0].name)), "gathered")[1],
+    )
+    monkeypatch.setattr(
+        DeepseekCompressor,
+        "_finish_project",
+        lambda self, g, r: events.append(
+            ("finish_project", active_stream[0].name, g, ws_mod.current_preallocated_workspace().data_ptr())
+        ),
+    )
+    monkeypatch.setattr(
+        DeepseekCompressor,
+        "_forward_tilelang",
+        lambda self, r, m, s, **kw: events.append(
+            ("forward_tilelang", active_stream[0].name, kw["kv_cache"] is module.kv_cache)
+        ),
+    )
+    module.compressor = comp
+
+    def fake_wqb(qr):
+        events.append(("indexer.wq_b", active_stream[0].name, ws_mod.current_preallocated_workspace().data_ptr()))
+        return torch.zeros(qr.shape[0], 4 * 128, dtype=torch.bfloat16)
+
+    fake_wqb.quant_method = SimpleNamespace(get_workspace_size=lambda lyr, n: 1024)
+
+    def fake_hw(h):
+        events.append(("indexer.weights_proj", active_stream[0].name, ws_mod.current_preallocated_workspace().data_ptr()))
+        return torch.ones(h.shape[0], 4, dtype=torch.bfloat16)
+
+    fake_hw.quant_method = SimpleNamespace(get_workspace_size=lambda lyr, n: 2048)
+
+    def fake_wk(lat):
+        events.append(("indexer.wk", active_stream[0].name, ws_mod.current_preallocated_workspace().data_ptr()))
+        return torch.zeros(lat.shape[0], 128, dtype=torch.bfloat16)
+
+    fake_wk.quant_method = SimpleNamespace(get_workspace_size=lambda lyr, n: 1536)
+
+    module.indexer = SimpleNamespace(
+        heads=4,
+        wq_b=fake_wqb,
+        weights_proj=fake_hw,
+        wk=fake_wk,
+        k_norm=SimpleNamespace(weight=torch.ones(128), variance_epsilon=1e-6),
+        k_cache=SimpleNamespace(prefix="idx", kv_cache=torch.zeros(4, 64 * 132, dtype=torch.uint8)),
+    )
+    cls = type(module)
+    monkeypatch.setattr(
+        cls,
+        "_quantize_index_query",
+        lambda self, mode, iq, d, s, positions=None: None,
+    )
+    monkeypatch.setattr(
+        cls,
+        "_write_index_keys",
+        lambda self, k, slots, positions=None: events.append(("write_index_keys", active_stream[0].name)),
+    )
+    monkeypatch.setattr(
+        cls,
+        "_rope",
+        lambda self, x, pos, role: (events.append(("rope", role, active_stream[0].name)), x)[1],
+    )
+    monkeypatch.setattr(
+        cls,
+        "_write_decode_metadata",
+        lambda self, bufs, swa, main, rows: events.append(("decode_metadata", active_stream[0].name)),
+    )
+    monkeypatch.setattr(
+        cls,
+        "_check_attention_rows",
+        lambda self, mode, rows: None,
+    )
+    monkeypatch.setattr(
+        cls,
+        "_attention_scratch_specs",
+        lambda self, mode, rows: (((256,), torch.uint8),),
+    )
+    monkeypatch.setattr(
+        cls,
+        "_index_chunk",
+        lambda self, mode, rows, **kw: events.append(("index_chunk", active_stream[0].name)),
+    )
+    monkeypatch.setattr(
+        cls,
+        "_attend",
+        lambda self, mode, q, output, **kw: (events.append(("attend", active_stream[0].name)), output.zero_()),
+    )
+    from vllm.models.deepseek_v4_1.tilelang import metadata as tl_metadata
+
+    monkeypatch.setattr(
+        tl_metadata,
+        "pages",
+        lambda *a, **k: events.append(("pages", active_stream[0].name)),
+    )
+
+    q_cast = MXFP8Rows(
+        torch.zeros(4, 16, dtype=torch.bfloat16),
+        torch.zeros(64, 16, dtype=torch.uint8),
+        torch.zeros(64, 4, dtype=torch.uint8),
+    )
+    module.fused_wqa_wkv = lambda h: (torch.zeros(4, 528, dtype=torch.bfloat16), None)
+    module._front = lambda qr_kv, pos: (
+        q_cast.rows,
+        torch.zeros(4, 512, dtype=torch.bfloat16),
+        q_cast,
+    )
+    module.wq_b = lambda qr: torch.zeros(4, 2 * 512, dtype=torch.bfloat16)
+    module._o_proj = lambda out, sp_rows=None: out.view(4, -1)
+
+    swa_meta = SimpleNamespace(
+        is_decode=True,
+        slot_mapping=torch.arange(4, dtype=torch.int64),
+        req_id_per_token=torch.arange(4, dtype=torch.int32),
+        cache_lengths=torch.full((4,), 64, dtype=torch.int32),
+        block_table=torch.ones((4, 16), dtype=torch.int32),
+        positions=torch.arange(4, dtype=torch.int64),
+        query_start_loc=torch.arange(5, dtype=torch.int32),
+        request_positions=torch.zeros(4, dtype=torch.int64),
+    )
+    ctx = SimpleNamespace(
+        attn_metadata={
+            "swa": swa_meta,
+            module.prefix: swa_meta,
+            "state": swa_meta,
+            "idx": swa_meta,
+        }
+    )
+    monkeypatch.setattr(attention, "get_forward_context", lambda: ctx)
+
+    module._forward(torch.arange(4, dtype=torch.int64), torch.zeros(4, 32, dtype=torch.bfloat16))
+
+    # project_local runs on main before forking aux; _index_query runs on aux while
+    # finish_project + forward_tilelang + wk + write_index_keys run on main with a
+    # disjoint workspace pointer; then rope(q) + decode_metadata run on aux while
+    # index_chunk runs on main.
+    aux_ptrs = {e[2] for e in events if e[0] in ("indexer.wq_b", "indexer.weights_proj")}
+    main_ptrs = {e[2] for e in events if e[0] == "indexer.wk"}
+    assert len(aux_ptrs) == 1 and len(main_ptrs) == 1
+    assert aux_ptrs != main_ptrs
+    names = [(e[0], e[1]) if e[0] != "rope" else (e[0], e[1], e[2]) for e in events]
+    assert ("project_local", "main") in names
+    assert ("indexer.wq_b", "aux") in names
+    assert ("indexer.weights_proj", "aux") in names
+    assert ("forward_tilelang", "main") in names
+    assert ("indexer.wk", "main") in names
+    assert ("write_index_keys", "main") in names
+    assert ("pages", "main") in names
+    assert ("rope", "q", "aux") in names
+    assert ("decode_metadata", "aux") in names
+    assert ("index_chunk", "main") in names
+    assert ("attend", "main") in names
+
+    # Index-only reindex layer (compressor is None): rope(q) + weights_proj on aux
+    # overlap with wq_b on main with disjoint workspaces, joining before forward_mqa.
+    events.clear()
+    module.compressor = None
+    module._forward(torch.arange(4, dtype=torch.int64), torch.zeros(4, 32, dtype=torch.bfloat16))
+    wqb_ptrs = {e[2] for e in events if e[0] == "indexer.wq_b"}
+    hw_ptrs = {e[2] for e in events if e[0] == "indexer.weights_proj"}
+    assert len(wqb_ptrs) == 1 and len(hw_ptrs) == 1 and wqb_ptrs != hw_ptrs
+    names_reidx = [(e[0], e[1]) if e[0] != "rope" else (e[0], e[1], e[2]) for e in events]
+    assert ("rope", "q", "aux") in names_reidx
+    assert ("indexer.weights_proj", "aux") in names_reidx
+    assert ("indexer.wq_b", "main") in names_reidx
+    assert ("index_chunk", "main") in names_reidx
+    assert ("attend", "main") in names_reidx
