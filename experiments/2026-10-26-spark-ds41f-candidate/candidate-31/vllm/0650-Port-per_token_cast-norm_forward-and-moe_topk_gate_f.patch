+def norm_forward_and_per_token_cast(
+    x: torch.Tensor,
+    weight: Optional[torch.Tensor],
+    eps: float,
+    fmt: str,
+    num_per_channels: int,
+    residual: Optional[torch.Tensor] = None,
+    out_scale: float = 1.0,
+    use_tma_aligned_col_major_sf: bool = False,
+    round_sf: bool = False,
+    use_packed_ue8m0: bool = False,
