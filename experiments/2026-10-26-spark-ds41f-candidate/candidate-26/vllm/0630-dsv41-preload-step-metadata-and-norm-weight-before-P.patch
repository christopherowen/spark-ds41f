Subject: [PATCH 630/630] dsv41: preload step metadata and norm weight before
 PDL wait in compressor

---
 tests/kernels/deepseek_v41_pdl_sources.py     |  2 +
 .../models/deepseek_v4_1/tilelang/compress.py | 58 ++++++++++++-------
 2 files changed, 38 insertions(+), 22 deletions(-)

diff --git a/tests/kernels/deepseek_v41_pdl_sources.py b/tests/kernels/deepseek_v41_pdl_sources.py
index 76d85d07a..66b42a0e2 100644
--- a/tests/kernels/deepseek_v41_pdl_sources.py
+++ b/tests/kernels/deepseek_v41_pdl_sources.py
@@ -69,6 +69,8 @@ EXEMPT = {"pdl_early_reader"}
 # before cudaGridDependencySynchronize().
 EARLY_PARAMETERS: dict[str, set[str]] = {
     "attention_front": {"cos_sin", "kv_weight", "positions", "q_weight", "slots"},
+    "compress": {"counts", "positions", "slots", "starts", "state_slots", "weight"},
+    "compress_gather_partial_state": {"counts", "positions", "starts", "table"},
     "indexer_mxfp4_quantize": {"CosSin", "Positions", "Slots", "Weight"},
     "mhc_post": {"comb", "post", "residual"},
     "moe_grouped_fp8_fp4_gemm": {"Narrow", "Order", "SFBase", "TileExpert"},
diff --git a/vllm/models/deepseek_v4_1/tilelang/compress.py b/vllm/models/deepseek_v4_1/tilelang/compress.py
