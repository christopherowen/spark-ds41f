+        assert self._feed(req, self._varied(120, 5)) is None
+        assert self._feed(req, let_me_do_it * 4) is None
+        assert req.force_thinking_end and req.thinking_loop_breaks == 1
+        assert req.last_loop_info == ("contiguous_phrase", 6, 4)
