+@pytest.mark.parametrize("mode", [CUDAGraphMode.FULL, CUDAGraphMode.PIECEWISE])
+def test_target_model_full_cudagraph_metadata_and_state_replay(monkeypatch, mode):
+    """Target FULL graphs refresh model_state and attention builder metadata in-graph."""
+    inputs = SimpleNamespace(
+        input_ids=torch.zeros(20, dtype=torch.int32),
+        positions=torch.zeros(20, dtype=torch.int64),
+        query_start_loc=torch.arange(5, dtype=torch.int32) * 5,
+        seq_lens=torch.tensor([11, 21, 0, 0], dtype=torch.int32),
+        is_padding=torch.ones(20, dtype=torch.bool),
+    )
+    tables = SimpleNamespace(
+        cp_size=1,
+        input_block_tables=[torch.ones(4, 2, dtype=torch.int32)],
+        slot_mappings=torch.ones(1, 20, dtype=torch.int64),
+    )
+    events: list[object] = []
+
+    class State:
+        supports_captured_full_attn_metadata = True
+
+        def prepare_dummy_inputs(self, nr, nt):
+            return {}
+
+        def finalize_cudagraph_inputs(self, model_inputs, cg_mode):
+            return None
+
+        def prepare_cudagraph_replay(self, buf, nr, nt):
+            events.append(("state_replay", buf.seq_lens[1].item(), nr, nt))
+
+    def refresh(starts, seq, table, slots, nr, nt):
+        events.append(("attn_replay", seq[1].item(), table[1, 0].item(), slots[5].item()))
+
+    group = SimpleNamespace(
+        get_metadata_builder=lambda: SimpleNamespace(prepare_cudagraph_replay=refresh)
+    )
+    monkeypatch.setattr(
+        gpu_cudagraph_utils, "prepare_inputs_to_capture", lambda *a, **kw: ({}, {})
+    )
+    monkeypatch.setattr(
+        gpu_cudagraph_utils,
+        "set_forward_context",
+        contextmanager(lambda *a, **kw: (yield)),
+    )
+
+    def capture(self, create_forward, progress_bar_desc):
+        desc = BatchExecutionDescriptor(mode, 10, 2, 5)
+        forward = create_forward(desc, warmup=False)
+        forward(mode)
+        inputs.seq_lens[1] = 7
+        tables.input_block_tables[0][1, 0] = 3
+        tables.slot_mappings[0, 5] = 17
+        forward(mode)
+
+    monkeypatch.setattr(gpu_cudagraph_utils.CudaGraphManager, "capture", capture)
+    manager = gpu_cudagraph_utils.ModelCudaGraphManager.__new__(
+        gpu_cudagraph_utils.ModelCudaGraphManager
+    )
+    manager.max_num_reqs, manager.dp_size = 4, 1
+    manager.is_first_pp_rank = manager.is_last_pp_rank = True
+    manager.use_breakable_cg = False
+    manager.cudagraph_mode = mode
+    manager.vllm_config = _create_vllm_config()
+    manager.hidden_states = None
+    manager.aux_hidden_states = []
+    manager.intermediate_tensors = None
+    manager.run_pw_graph = lambda model, model_inputs: model(**model_inputs)
+
+    class Model(torch.nn.Module):
+        def forward(self, **kwargs):
+            events.append("model")
+            return torch.zeros((10, 4))
+
+    with patch.object(
+        gpu_cudagraph_utils, "has_compiled_submodule", return_value=True
+    ):
+        manager.capture(
+            Model(),
+            State(),
+            inputs,
+            None,
+            tables,
+            [[group]],
+            None,
+        )
+    assert manager.captures_full_attn_metadata
+    assert events == (
+        [
+            ("state_replay", 21, 2, 10),
+            ("attn_replay", 21, 1, 1),
+            "model",
+            ("state_replay", 7, 2, 10),
+            ("attn_replay", 7, 3, 17),
+            "model",
+        ]
+        if mode == CUDAGraphMode.FULL
+        else ["model", "model"]
+    )
