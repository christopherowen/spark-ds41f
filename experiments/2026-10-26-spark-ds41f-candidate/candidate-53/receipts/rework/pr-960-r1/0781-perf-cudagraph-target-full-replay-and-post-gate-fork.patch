+@cuda
+def test_ced_state_cudagraph_replay_matches_eager_stage(monkeypatch):
+    """CEDState.stage_floors + prepare_cudagraph_replay inside a captured graph
+    matches eager CEDState.stage bit-for-bit across varying seq_lens and floors."""
+    import importlib
+
+    import tilelang.cache
+
+    from vllm.models.deepseek_v4_1.tilelang import ced as ced_kernels
+
+    cache_module = importlib.import_module(tilelang.cache.freeze.__module__)
+    monkeypatch.setattr(cache_module, "_frozen_reason", None)
+    ced_kernels.requests_kernel(4, False, False)
+
+    captured = CEDState(4, 256, (128, 256), "cuda")
+    eager = CEDState(4, 256, (128, 256), "cuda")
+    starts = torch.tensor([0, 6, 12, 18, 24], dtype=torch.int32, device="cuda")
+    seq = torch.tensor([140, 260, 90, 512], dtype=torch.int32, device="cuda")
+    captured.stage(starts, seq, [6] * 4, [False] * 4, [0] * 4)
+    torch.accelerator.synchronize()
+
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        captured.prepare_cudagraph_replay(starts, seq, 4)
+
+    for lengths, floors in (
+        ([140, 260, 90, 512], [0, 0, 0, 0]),
+        ([145, 265, 95, 517], [0, 0, 0, 0]),
+        ([200, 400, 150, 800], [128, 256, 64, 512]),
+    ):
+        seq.copy_(torch.tensor(lengths, dtype=torch.int32))
+        ring_before = captured._stage_ring_idx
+        captured.stage_floors(floors)
+        if floors == [0, 0, 0, 0]:
+            assert captured._stage_ring_idx == ring_before
+        graph.replay()
+        eager.stage(starts, seq, [6] * 4, [False] * 4, floors)
+        assert torch.equal(captured.replay_start[:4], eager.replay_start[:4])
+        assert torch.equal(captured.request_positions[:4], eager.request_positions[:4])
+        assert torch.equal(captured.starts[:5], eager.starts[:5])
