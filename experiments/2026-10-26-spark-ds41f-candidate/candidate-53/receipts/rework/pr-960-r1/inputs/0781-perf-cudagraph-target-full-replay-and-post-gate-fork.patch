+    def stage_floors(self, floors) -> None:
+        """Stage per-request replay floors for non-compacting FULL CUDA graph replay."""
+        self.plan = None
+        nr = len(floors)
+        if nr == 0:
+            return
+        floors_list = [int(f) for f in floors]
+        if self._staged_floors[:nr] == floors_list:
+            return
+        ring_slot = self._stage_ring_idx % self._STAGE_RING_SIZE
+        self._stage_ring_idx += 1
+        floors_host = self._floors_host_ring[ring_slot][:nr]
+        floors_host.copy_(torch.tensor(floors_list, dtype=torch.int64))
+        self.floors[:nr].copy_(floors_host, non_blocking=True)
+        self._staged_floors[:nr] = floors_list
+
+    def prepare_cudagraph_replay(
+        self, starts: torch.Tensor, seq: torch.Tensor, num_reqs: int
+    ) -> None:
+        """Refresh request positions and SWA replay starts inside a FULL CUDA graph."""
+        ced_kernels.requests(
+            starts,
+            seq,
+            self.limits,
+            self.floors,
+            self.starts,
+            self.request_positions,
+            self.replay_start,
+            self.counts,
+            num_reqs,
+            compact=False,
+        )
+
     def get_indices(self) -> torch.Tensor | None:
         return None if self.plan is None else self.indices[: self.plan.num_tokens]
 
