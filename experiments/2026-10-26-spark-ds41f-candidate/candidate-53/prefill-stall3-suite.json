{
  "name": "prefill-stall3",
  "version": 1,
  "description": "screen-tp3's prefill step and release-tp3's stall-3 step alone (same arguments), to attribute candidate-53's prefill and stall-3 changes to #984 between configurations of one image.",
  "steps": [
    {
      "id": "prefill",
      "command": "prefill",
      "args": {
        "sizes": [
          32768,
          262144
        ],
        "repeats": 3
      }
    },
    {
      "id": "stall-3",
      "command": "stall",
      "args": {
        "sizes": [
          131072
        ],
        "streams": 3,
        "max_tokens": 16384,
        "warmup": 20,
        "tail": 2,
        "repeats": 3,
        "probes": [
          2,
          5,
          8,
          11,
          14
        ],
        "probe_tokens": 500,
        "probe_max_tokens": 16
      }
    }
  ]
}
