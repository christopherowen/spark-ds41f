@@ -0,0 +1,86 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+import torch.nn as nn
+
+from vllm.models.deepseek_v4_1.nvidia.dspark import (
+    DSparkDeepseekV4ForCausalLM,
+    DSparkDeepseekV4Model,
+)
+
+pytestmark = pytest.mark.cpu_test
+
+
+class _CountingEmbedding(nn.Module):
+    def __init__(self, vocab_size: int, hidden_size: int):
+        super().__init__()
+        self.weight = nn.Parameter(
+            torch.randn(vocab_size, hidden_size, dtype=torch.bfloat16)
+        )
+        self.call_row_counts: list[int] = []
+
+    def forward(self, input_ids: torch.Tensor) -> torch.Tensor:
+        self.call_row_counts.append(int(input_ids.numel()))
+        return self.weight[input_ids.long()]
+
+
+def _make_stub_model(vocab_size: int = 64, hidden_size: int = 32):
+    model = DSparkDeepseekV4Model.__new__(DSparkDeepseekV4Model)
+    nn.Module.__init__(model)
+    model.embed_tokens = _CountingEmbedding(vocab_size, hidden_size)
+    model._cached_mask_token_id = None
+    model._cached_mask_embed = None
+
+    lm = DSparkDeepseekV4ForCausalLM.__new__(DSparkDeepseekV4ForCausalLM)
+    nn.Module.__init__(lm)
+    lm.model = model
+    return lm
+
+
+def test_embed_query_block_bit_exact_and_reduces_lookup_rows():
+    torch.manual_seed(0)
+    lm = _make_stub_model(vocab_size=128, hidden_size=48)
+    mask_id = 127
+    block_size = 5
+    num_reqs = 4
+
+    anchors = torch.tensor([3, 17, 42, 99], dtype=torch.int32)
+    query_ids = torch.full((num_reqs, block_size), mask_id, dtype=torch.int32)
+    query_ids[:, 0] = anchors
+    flat_ids = query_ids.reshape(-1)
+
+    ref = lm.embed_input_ids(flat_ids)
+    assert lm.model.embed_tokens.call_row_counts == [num_reqs * block_size]
+
+    lm.cache_mask_embed(mask_id)
+    lm.model.embed_tokens.call_row_counts.clear()
+
+    cached_out = lm.embed_query_block(flat_ids, block_size, mask_id)
+    assert torch.equal(cached_out, ref)
+    assert lm.model.embed_tokens.call_row_counts == [num_reqs]
+
+
+def test_embed_query_block_fallbacks():
+    torch.manual_seed(1)
+    lm = _make_stub_model(vocab_size=64, hidden_size=16)
+    flat_ids = torch.tensor([1, 2, 3, 4, 5, 6], dtype=torch.int32)
+
+    # Uncached falls back to full embedding.
+    out_uncached = lm.embed_query_block(flat_ids, 3, 2)
+    assert torch.equal(out_uncached, lm.embed_input_ids(flat_ids))
+
+    # Mismatched mask_token_id or non-divisible length falls back safely.
+    lm.cache_mask_embed(2)
+    lm.model.embed_tokens.call_row_counts.clear()
+    out_mismatch = lm.embed_query_block(flat_ids, 3, 9)
+    assert torch.equal(out_mismatch, lm.embed_input_ids(flat_ids))
+    assert lm.model.embed_tokens.call_row_counts == [6, 6]
+
+    lm.model.embed_tokens.call_row_counts.clear()
+    out_indivisible = lm.embed_query_block(flat_ids, 5, 2)
+    assert torch.equal(out_indivisible, lm.embed_input_ids(flat_ids))
+    assert lm.model.embed_tokens.call_row_counts == [6, 6]
