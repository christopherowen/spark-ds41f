@@ -428,6 +430,60 @@ class DSparkDeepseekV4Model(nn.Module):
         assert self.embed_tokens is not None
         return self.embed_tokens(input_ids)
 
+    def cache_mask_embed(self, mask_token_id: int) -> None:
+        """Precompute and cache the constant mask-token embedding vector.
+
+        DSpark query blocks repeat ``mask_token_id`` across offsets
+        ``1..block_size-1`` of every request. Caching the all-reduced vector
+        once after weight load shrinks per-step embedding lookup and TP
+        all-reduce by ``block_size`` while staying bit-exact.
+        """
+        if self.embed_tokens is None:
+            return
+        weight = getattr(self.embed_tokens, "weight", None)
+        if weight is None or weight.device.type == "meta":
+            return
+        mask_id = torch.tensor(
+            [int(mask_token_id)], dtype=torch.int32, device=weight.device
+        )
+        with torch.no_grad():
+            self._cached_mask_token_id = int(mask_token_id)
+            self._cached_mask_embed = self.embed_tokens(mask_id).detach().clone()
+
+    def embed_query_block(
+        self,
+        input_ids: torch.Tensor,
+        block_size: int,
+        mask_token_id: int | None = None,
+    ) -> torch.Tensor:
+        """Embed ``[num_reqs * block_size]`` query blocks where offsets
+        ``1..block_size-1`` hold the cached constant mask token."""
+        cached = self._cached_mask_embed
+        if (
+            cached is None
+            or block_size <= 1
+            or input_ids.numel() == 0
+            or input_ids.numel() % block_size != 0
+            or (
+                mask_token_id is not None
+                and self._cached_mask_token_id != int(mask_token_id)
+            )
+        ):
+            return self.embed_input_ids(input_ids)
+        num_reqs = input_ids.numel() // block_size
+        anchor_ids = input_ids.view(num_reqs, block_size)[:, 0].contiguous()
+        anchor_embeds = self.embed_input_ids(anchor_ids)
+        if cached.device != anchor_embeds.device or cached.dtype != anchor_embeds.dtype:
+            cached = cached.to(device=anchor_embeds.device, dtype=anchor_embeds.dtype)
+        out = torch.empty(
+            (num_reqs, block_size, anchor_embeds.shape[-1]),
+            dtype=anchor_embeds.dtype,
+            device=anchor_embeds.device,
+        )
+        out[:, 0].copy_(anchor_embeds)
+        out[:, 1:].copy_(cached.view(1, 1, -1))
+        return out.view(num_reqs * block_size, anchor_embeds.shape[-1])
+
     def combine_hidden_states(
         self, aux_hidden_states: torch.Tensor, out: torch.Tensor | None = None
     ) -> torch.Tensor:
@@ -681,6 +737,17 @@ class DSparkDeepseekV4ForCausalLM(nn.Module):
     def embed_input_ids(self, input_ids: torch.Tensor) -> torch.Tensor:
         return self.model.embed_input_ids(input_ids)
 
+    def cache_mask_embed(self, mask_token_id: int) -> None:
+        self.model.cache_mask_embed(mask_token_id)
+
+    def embed_query_block(
+        self,
+        input_ids: torch.Tensor,
+        block_size: int,
+        mask_token_id: int | None = None,
+    ) -> torch.Tensor:
+        return self.model.embed_query_block(input_ids, block_size, mask_token_id)
+
     def combine_hidden_states(
         self, aux_hidden_states: torch.Tensor, out: torch.Tensor | None = None
     ) -> torch.Tensor:
