From 52719d296ee53dba4bec3e7ea703a080f12468dc Mon Sep 17 00:00:00 2001
From: Christopher Owen <christopherowen@users.noreply.github.com>
Date: Fri, 27 Nov 2026 04:39:08 +0100
Subject: [PATCH 871/871] dspark: retain FULL CUDA graph replay for truncated
 dynamic draft depth

DFlashSpeculator.propose forced eager execution whenever
0 < active_spec < num_speculative_steps, dropping out of FULL CUDA graph
capture on any per-batch-size or acceptance-driven draft-depth schedule.

For greedy DSpark without a logit-reading acceptance estimator, replay the
captured FULL graph directly: mask sample_idx_mapping[:, active_spec:] to
-1 before replay so the in-graph confidence calibrator neither records tail
features nor predicts tail slots, and zero draft_token_confidence_probs
beyond active_spec after replay. Plain DFlash and probabilistic DSpark
retain the existing eager path.

Upstream base: 19f2c20ed4d64ae22bd009ceacadd85e2a81e354 + candidate-74 (0001..0869) + 0870
Quality impact: none (identical outputs at fixed K=5; preserves exact calibration masking when K < 5)
Tests: tests/v1/spec_decode/test_dspark_mask_embed_cache.py
Upstream status: local candidate-76 patch
---
 .../test_dspark_mask_embed_cache.py           | 23 +++++++++++++++++++
 .../gpu/spec_decode/dflash/speculator.py      | 19 ++++++++++++++-
 .../gpu/spec_decode/dspark/speculator.py      |  3 +++
 3 files changed, 44 insertions(+), 1 deletion(-)

diff --git a/tests/v1/spec_decode/test_dspark_mask_embed_cache.py b/tests/v1/spec_decode/test_dspark_mask_embed_cache.py
index 1f04ddebeb..1ace6d9e47 100644
--- a/tests/v1/spec_decode/test_dspark_mask_embed_cache.py
+++ b/tests/v1/spec_decode/test_dspark_mask_embed_cache.py
@@ -84,3 +84,26 @@ def test_embed_query_block_fallbacks():
     out_indivisible = lm.embed_query_block(flat_ids, 5, 2)
     assert torch.equal(out_indivisible, lm.embed_input_ids(flat_ids))
     assert lm.model.embed_tokens.call_row_counts == [6, 6]
+
+
+def test_dspark_can_replay_truncated_graph_policy():
+    from vllm.v1.worker.gpu.spec_decode.dflash.speculator import DFlashSpeculator
+    from vllm.v1.worker.gpu.spec_decode.dspark.speculator import DSparkSpeculator
+
+    dflash = DFlashSpeculator.__new__(DFlashSpeculator)
+    assert dflash._can_replay_truncated_graph() is False
+
+    # Greedy DSpark without logit-based estimator can replay captured FULL graph.
+    dspark = DSparkSpeculator.__new__(DSparkSpeculator)
+    dspark.draft_logits = None
+    dspark.acceptance_estimator = object()
+    dspark.use_confidence_head = True
+    assert dspark._can_replay_truncated_graph() is True
+
+    # Probabilistic DSpark or logit-reading acceptance estimator stays eager.
+    dspark.draft_logits = torch.empty((1, 5, 16))
+    assert dspark._can_replay_truncated_graph() is False
+
+    dspark.draft_logits = None
+    dspark.use_confidence_head = False
+    assert dspark._can_replay_truncated_graph() is False
