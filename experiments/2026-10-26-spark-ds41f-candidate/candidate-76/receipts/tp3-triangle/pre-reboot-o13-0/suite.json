 "suite": {
  "name": "screen-tp3",
  "version": 1,
  "description": "Per-change screen for three nodes (8 streams, 1M context), about 18 minutes a build: model behaviour first (it also heat-soaks the GPU), the engine grid up to eight requests, eight streams in a closed loop, real-text prefill at 32K and 256K. Its grid needs the dev-mode collective RPC.",
  "steps": [
   {
    "id": "model",
    "command": "model",
    "args": {
     "limit": 128,
     "concurrency": 8,
     "max_tokens": 256,
     "top": 20
    }
   },
   {
    "id": "grid",
    "command": "engine",
    "args": {
     "replays": 100,
     "settle": 1,
     "max_requests": 8
    }
   },
   {
    "id": "c8",
    "command": "run",
    "args": {
     "mode": "closed",
     "concurrency": 8,
     "warmup": 60,
     "duration": 300,
     "extra_body": {
      "chat_template_kwargs": {
       "thinking": false
      }
     }
    }
   },
   {
    "id": "prefill",
    "command": "prefill",
    "args": {
     "sizes": [
      32768,
      262144
     ],
     "repeats": 3
    }
   }
  ]
 },
