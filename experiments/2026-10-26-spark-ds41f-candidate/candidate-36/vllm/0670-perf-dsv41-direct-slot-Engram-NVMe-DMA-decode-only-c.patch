+    col_end = np.zeros(24, dtype=np.int64)
+    col_delta = np.zeros(24, dtype=np.int64)
+    owned_starts = np.empty(len(owned), dtype=np.int64)
+    owned_rows = np.empty(len(owned), dtype=np.int64)
