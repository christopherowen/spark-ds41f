 tests/models/test_deepseek_v4_1_ced_model.py | 103 +++++++++++++++++++
 vllm/models/deepseek_v4_1/attention.py       |  27 ++++-
 vllm/models/deepseek_v4_1/nvidia/model.py    |  44 ++++++--
 4 files changed, 237 insertions(+), 12 deletions(-)

