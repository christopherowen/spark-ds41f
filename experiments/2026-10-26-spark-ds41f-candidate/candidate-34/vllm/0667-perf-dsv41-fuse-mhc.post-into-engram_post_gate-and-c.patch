+                residual,
+                post,
+                comb,
+                xs,
+                t,
+                h,
+                tx,
+                chunks,
+                threads,
+                vec,
+                hc_mult,
+            )
+            if T.cast(ids[t], T.int64) == IMAGE_SENTINEL:
+                for c in T.serial(chunks):
+                    for i in T.vectorized(vec):
+                        out[t, h, (c * threads + tx) * vec + i] = T.cast(
