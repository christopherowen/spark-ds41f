+
+
+def engram_post_gate_blocked(
+    layer_out: torch.Tensor,
+    residual: torch.Tensor,
+    post: torch.Tensor,
+    comb: torch.Tensor,
+    kv: torch.Tensor,
+    weight: torch.Tensor,
+    ids: torch.Tensor,
+    out: torch.Tensor,
+    eps: float,
+    hc_mult: int,
