+_DECODE_SCORE_MAX_ROWS = 96
+_BLOCKMAX_MIN_ROWS = _DECODE_SCORE_MAX_ROWS + 1  # keep <=96 decode on R=3
+_DECODE_SCORE_ROW_GROUP = 3
+_PREFILL_SCORE_ROW_GROUP = 4
+
+
+def _decode_score_max_ctas(width: int) -> int:
+    # Wave-aligned CTA cap for SM121 (48 SMs x 3 CTAs/SM = 144 concurrent CTAs/wave):
+    # 144 (1 wave) through 256K context and 288 (2 waves) above 256K (e.g. 1M).
+    return 288 if width > 262144 else 144
+
+
 def _score_call(width, page_size, candidates):
-    return prepare.call(indexer_score_v41, width, page_size, candidates)
+    if candidates:
+        return prepare.call(indexer_score_v41, width, page_size, True)
+    return prepare.call(
+        indexer_score_v41,
+        width,
+        page_size,
+        False,
+        row_group=_PREFILL_SCORE_ROW_GROUP,
+    )
+
+
+def _score_decode_call(width, page_size):
+    return prepare.call(
+        indexer_score_v41,
+        width,
+        page_size,
+        False,
+        max_ctas=_decode_score_max_ctas(width),
+        row_group=_DECODE_SCORE_ROW_GROUP,
+    )
 
 
