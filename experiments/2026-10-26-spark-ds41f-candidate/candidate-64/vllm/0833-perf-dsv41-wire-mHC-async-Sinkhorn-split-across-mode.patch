     return TileKernelsMHC(config)
 
 
+def async_sinkhorn(enabled: bool = True) -> contextlib.AbstractContextManager:
+    """Split mHC finalize into critical-path norm and off-critical-path Sinkhorn."""
+    if not enabled:
+        return contextlib.nullcontext()
+    from .tilelang.mhc import async_sinkhorn as _async_sinkhorn
+
+    return _async_sinkhorn(True)
+
+
+def wait_sinkhorn(device: torch.device | None = None) -> None:
+    """Join any pending async mHC Sinkhorn launch onto the current stream."""
+    from .tilelang.mhc import wait_sinkhorn as _wait_sinkhorn
+
+    _wait_sinkhorn(device)
+
