From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Christopher Owen <christopherowen@users.noreply.github.com>
Date: Sat, 21 Nov 2026 18:52:02 +0100
Subject: [PATCH] perf(sparse_mla): route single-segment SWA-only
 layers directly to extend


Route single-segment SWA-only layers (segments <= 1) directly to the
SparseMlaV41Plan extend kernel instead of split/decode, eliminating
2 compiled kernels per shape and the SWA Partial scratch buffer.

Upstream-base: 19f2c20ed4d64ae22bd009ceacadd85e2a81e354
Rationale: Faster on 16/16 decode shapes (-1.06..-4.06 us/layer across 5
           SWA layers) with fewer kernels and lower scratch memory.
Quality: uint16 bit-exact against decode/split reference.
Tests: 38/38 SparseMlaV41Plan and SWA parity tests (PR #1277).
Upstream-status: Local DeepSeek-V4.1 SparseMLA dispatch simplification.
---
 .../attention/test_deepseek_v41_tilelang.py       |  5 +++--
 vllm/models/deepseek_v4_1/tilelang/sparse_mla.py  | 15 +++++++++++----
 2 files changed, 14 insertions(+), 6 deletions(-)

diff --git a/tests/kernels/attention/test_deepseek_v41_tilelang.py b/tests/kernels/attention/test_deepseek_v41_tilelang.py
index b46399c08..2ab262bdd 100644
--- a/tests/kernels/attention/test_deepseek_v41_tilelang.py
+++ b/tests/kernels/attention/test_deepseek_v41_tilelang.py
@@ -1368,8 +1368,9 @@ def test_sparse_mla_plan_routes_right_sizes_head_block_and_decode_waves(monkeypa
 
     swa24 = SparseMlaV41Plan.routes(24, 128, 0, 128, swa_page_size=128, max_rows=2048)
     assert swa24.segments == 1
-    assert swa24.split_max_rows == 24
-    assert swa24.decode_max_rows == 144
+    assert swa24.split_max_rows == 0
+    assert swa24.decode_max_rows == 0
+    assert list(swa24.kernels) == ["extend"]
 
 
 @pytest.mark.parametrize("heads", [16, 24])
diff --git a/vllm/models/deepseek_v4_1/tilelang/sparse_mla.py b/vllm/models/deepseek_v4_1/tilelang/sparse_mla.py
index 652b74bd0..fe6e71815 100644
--- a/vllm/models/deepseek_v4_1/tilelang/sparse_mla.py
+++ b/vllm/models/deepseek_v4_1/tilelang/sparse_mla.py
@@ -1124,14 +1124,21 @@ class SparseMlaV41Plan:
         segments = tilelang.cdiv(chunks, segment_chunks)
         sms = torch.cuda.get_device_properties(device).multi_processor_count
         if decode_max_rows is None:
+            # Single-segment layers (e.g. SWA-only) have no K/V segments to split:
+            # decode/split would write FP32 Partial to DRAM and launch a merge kernel
+            # for one segment, which is strictly slower than single-kernel extend.
             decode_max_rows = (
-                DECODE_MAX_WAVES * sms // (segments * tilelang.cdiv(heads, block_H))
+                0
+                if segments <= 1
+                else DECODE_MAX_WAVES
+                * sms
+                // (segments * tilelang.cdiv(heads, block_H))
             )
         if split_max_rows is None:
             split_max_rows = (
-                sms // (segments * tilelang.cdiv(heads, split_block_H))
-                if split_block_H
-                else 0
+                0
+                if segments <= 1 or not split_block_H
+                else sms // (segments * tilelang.cdiv(heads, split_block_H))
             )
         decode_max_rows = min(decode_max_rows, max_rows)
         split_max_rows = min(split_max_rows, decode_max_rows)
