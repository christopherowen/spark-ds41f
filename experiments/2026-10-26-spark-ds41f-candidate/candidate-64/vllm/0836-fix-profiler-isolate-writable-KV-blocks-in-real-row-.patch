+    @staticmethod
+    def _real_context_pool_block(
+        group: int, off: int, usable: int, share: int
+    ) -> int:
+        if off < 0 or off >= share:
+            raise ValueError(
+                f"real_rows KV block offset {off} exceeds group {group} share {share}"
+            )
+        return (group * share + off) % usable + 1
