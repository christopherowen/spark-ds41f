+@pytest.mark.parametrize("num_tokens", [205, 800])
+def test_gate_router_route_local_caches_tail_rank_masks(
+    plain_scratch, padded_step, monkeypatch, num_tokens
+):
+    """Repeated SP local routing across encoder layers reuses the tail rank's
+    padded local masks instead of re-allocating and copying them per layer."""
+    from vllm.models.deepseek_v4_1 import sp_prefill
+
+    world_size = 3
+    padded_step(num_tokens, 4)
+    gate = _Gate(384, seed=num_tokens)
+    generator = torch.Generator(device="cuda").manual_seed(num_tokens + 7)
+    x = torch.randn(num_tokens, 5120, device="cuda", generator=generator).to(
+        torch.bfloat16
+    )
+    bias = torch.randn(384, device="cuda", generator=generator) * 0.1
+    bias_vl = torch.nn.Parameter(
+        torch.randn(384, device="cuda", generator=generator) * 0.1,
+        requires_grad=False,
+    )
+    input_ids = torch.randint(
+        0, 1000, (num_tokens,), device="cuda", generator=generator
+    )
+    input_ids[1::4] = LO
+    router = tilelang_router.TileLangGateRouter(
+        gate=gate,
+        top_k=6,
+        global_num_experts=384,
+        e_score_correction_bias=bias,
+        renormalize=True,
+        routed_scaling_factor=SCALE,
+        scoring_func="sqrtsoftplus",
+        bias_vl=bias_vl,
+        image_sentinel_lo=LO,
+        image_sentinel_count=1,
+    )
+    router.declare_kernels()
+
+    layout = sp_prefill.SPRows(num_tokens, world_size, world_size - 1)
+    assert layout.real_rows < layout.local_rows
+    local_x = layout.local_slice(x)
+
+    orig_local_slice = sp_prefill.SPRows.local_slice
+    slice_calls = []
+
+    def counted_local_slice(self, tensor):
+        slice_calls.append(tensor.shape)
+        return orig_local_slice(self, tensor)
+
+    monkeypatch.setattr(sp_prefill.SPRows, "local_slice", counted_local_slice)
+    w1, ids1 = router.route_local(local_x, layout, input_ids=input_ids)
+    first_calls = len(slice_calls)
+    assert first_calls >= 1
+    w2, ids2 = router.route_local(local_x, layout, input_ids=input_ids)
+    assert len(slice_calls) == first_calls
+    assert torch.equal(ids1, ids2)
+    assert torch.equal(w1.view(torch.int32), w2.view(torch.int32))
+
+
+def _sp_gate_router(seed):
+    """A vision layer's gate router, as the SP local routing tests build it."""
+    gate = _Gate(384, seed=seed)
+    generator = torch.Generator(device="cuda").manual_seed(seed + 7)
+    bias = torch.randn(384, device="cuda", generator=generator) * 0.1
+    bias_vl = torch.nn.Parameter(
+        torch.randn(384, device="cuda", generator=generator) * 0.1,
+        requires_grad=False,
+    )
+    router = tilelang_router.TileLangGateRouter(
+        gate=gate,
+        top_k=6,
+        global_num_experts=384,
+        e_score_correction_bias=bias,
+        renormalize=True,
+        routed_scaling_factor=SCALE,
+        scoring_func="sqrtsoftplus",
+        bias_vl=bias_vl,
+        image_sentinel_lo=LO,
+        image_sentinel_count=1,
+    )
+    router.declare_kernels()
+    return router, generator
+
+
+def _new_forward(monkeypatch):
+    """A forward of its own: the runner makes a new ForwardContext every step."""
+    context = type("Context", (), {})()
+    context.attn_metadata = None  # ForwardContext always has it; no CED plan here
+    monkeypatch.setattr(tilelang_router, "is_forward_context_available", lambda: True)
+    monkeypatch.setattr(tilelang_router, "get_forward_context", lambda: context)
+    return context
+
+
+@pytest.mark.parametrize(
+    "world_size,num_tokens", [(3, 205), (3, 800), (3, 1024), (4, 1024)]
+)
+def test_gate_router_route_local_under_inference_mode(
+    plain_scratch, monkeypatch, world_size, num_tokens
+):
+    """The worker runs every forward, its startup memory profile included, under
+    torch.inference_mode, where the step's padding mask and ids, and the masks
+    routing computes from them, are inference tensors: they track no version
+    counter. SP local routing keeps its local masks there too, on every rank, on
+    the partials path (local_rows <= 256) and the full-gate path, and routes the
+    bits it routes outside inference mode."""
+    from vllm.models.deepseek_v4_1 import sp_prefill
+
+    router, generator = _sp_gate_router(num_tokens)
+    x = torch.randn(num_tokens, 5120, device="cuda", generator=generator).to(
+        torch.bfloat16
+    )
+    input_ids = torch.randint(
+        0, 1000, (num_tokens,), device="cuda", generator=generator
+    )
+    input_ids[1::4] = LO
+
+    def forward(layout, layers):
+        context = _new_forward(monkeypatch)
+        context.is_padding = torch.zeros(num_tokens, dtype=torch.bool, device="cuda")
+        context.is_padding[num_tokens - 4 :] = True
+        ids = input_ids.clone()
+        local_x = layout.local_slice(x)
+        routes = [
+            router.route_local(local_x, layout, input_ids=ids) for _ in range(layers)
+        ]
+        return context, routes
+
+    for rank in range(world_size):
+        layout = sp_prefill.SPRows(num_tokens, world_size, rank)
+        with torch.no_grad():
+            _, ((expected_weights, expected_ids),) = forward(layout, 1)
+        with torch.inference_mode():
+            context, routes = forward(layout, 3)
+        assert context.is_padding.is_inference()
+        assert context._ds41_local_masks
+        for weights, ids in routes:
+            assert torch.equal(ids, expected_ids)
+            assert torch.equal(
+                weights.view(torch.int32), expected_weights.view(torch.int32)
+            )
+        if layout.real_rows < layout.local_rows:
+            assert (routes[0][1][layout.real_rows :] == -1).all()
+
+
+def test_gate_router_route_local_masks_last_one_forward(plain_scratch, monkeypatch):
+    """The runner refills its padding and id buffers in place every step and hands
+    each forward new views of them in a new ForwardContext. A forward's SP local
+    masks are its own: never the previous forward's, though the buffers' storage,
+    the row count and the layout are the same."""
+    from vllm.models.deepseek_v4_1 import sp_prefill
+
+    num_tokens, world_size = 800, 3
+    layout = sp_prefill.SPRows(num_tokens, world_size, world_size - 1)
+    assert layout.real_rows < layout.local_rows
+    router, generator = _sp_gate_router(num_tokens)
+    x = torch.randn(num_tokens, 5120, device="cuda", generator=generator).to(
+        torch.bfloat16
+    )
+    local_x = layout.local_slice(x)
+    first_ids = torch.randint(
+        0, 1000, (num_tokens,), device="cuda", generator=generator
+    )
+    first_ids[1::4] = LO
+    second_ids = first_ids.clone()
+    second_ids[1::4] = 7
+    second_ids[2::4] = LO
+    steps = [(first_ids, 4), (second_ids, 40), (first_ids, 4)]
+    padding_buffer = torch.zeros(num_tokens, dtype=torch.bool, device="cuda")
+    ids_buffer = torch.zeros(num_tokens, dtype=torch.int64, device="cuda")
+    real = slice(layout.start, layout.start + layout.real_rows)
+
+    with torch.inference_mode():
+        for step_ids, padding in steps:
+            # The full-row reference, in a forward of its own.
+            context = _new_forward(monkeypatch)
+            context.is_padding = torch.zeros_like(padding_buffer)
+            context.is_padding[num_tokens - padding :] = True
+            expected_weights, expected_ids = router._compute_routing(
+                None, x, None, input_ids=step_ids.clone()
+            )
+            # The step: its buffers refilled in place, as the runner fills them.
+            padding_buffer.fill_(False)
+            padding_buffer[num_tokens - padding :] = True
+            ids_buffer.copy_(step_ids)
+            context = _new_forward(monkeypatch)
+            context.is_padding = padding_buffer[:num_tokens]
+            ids = ids_buffer[:num_tokens]
+            first_pad = num_tokens - padding - layout.start
+            for _ in range(2):
+                weights, topk_ids = router.route_local(local_x, layout, input_ids=ids)
+                assert torch.equal(topk_ids[: layout.real_rows], expected_ids[real])
+                assert torch.equal(
+                    weights[: layout.real_rows].view(torch.int32),
+                    expected_weights[real].view(torch.int32),
+                )
+                assert (topk_ids[first_pad:] == -1).all()
+                assert (topk_ids[:first_pad] >= 0).all()
+
+
+def test_gate_router_route_local_outside_a_forward(plain_scratch):
+    """Outside a forward (no ForwardContext) SP local routing keeps nothing: the
+    row layout is a frozen value, not a step, and it routes as the full rows do."""
+    from vllm.models.deepseek_v4_1 import sp_prefill
+
+    assert not tilelang_router.is_forward_context_available()
+    num_tokens, world_size = 800, 3
+    router, generator = _sp_gate_router(num_tokens)
+    x = torch.randn(num_tokens, 5120, device="cuda", generator=generator).to(
+        torch.bfloat16
+    )
+    input_ids = torch.randint(
+        0, 1000, (num_tokens,), device="cuda", generator=generator
+    )
+    input_ids[1::4] = LO
+    expected_weights, expected_ids = router._compute_routing(
+        None, x, None, input_ids=input_ids
+    )
+    for rank in range(world_size):
+        layout = sp_prefill.SPRows(num_tokens, world_size, rank)
+        real = slice(layout.start, layout.start + layout.real_rows)
+        with torch.inference_mode():
+            for _ in range(2):
+                weights, ids = router.route_local(
+                    layout.local_slice(x), layout, input_ids=input_ids
+                )
+                assert torch.equal(ids[: layout.real_rows], expected_ids[real])
+                assert torch.equal(
+                    weights[: layout.real_rows].view(torch.int32),
+                    expected_weights[real].view(torch.int32),
+                )
+        assert not hasattr(layout, "_ds41_local_masks")
