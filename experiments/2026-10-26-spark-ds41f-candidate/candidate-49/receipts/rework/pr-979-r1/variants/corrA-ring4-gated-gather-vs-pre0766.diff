+def test_gather_many_routes_roce_and_packs_small_tensors(monkeypatch):
+    """On sparknet's ``ring4`` topology, when ``b12x_ar_comm`` accepts all tensors in
+    ``gather_many``, large tensors are gathered directly into the destination buffer
+    while small trailing tensors (``<= 512`` B/row, such as MXFP8 scales and top-k
+    routes) are packed into one ``uint8`` all-gather, reducing 4 collectives to 2.
+    On ``direct``, without a one-shot runtime, or when any tensor exceeds
+    ``should_all_gather``, ``gather_many`` uses grouped ``pynccl_comm``."""
+    layout = sp_prefill.SPRows(10, 3, 2)  # padded=12, local=4, real=2
+    vals = torch.arange(4 * 1024, dtype=torch.uint8).reshape(4, 1024)
+    scales = torch.arange(4 * 32, dtype=torch.uint8).reshape(4, 32)
+    weights = torch.arange(4 * 6, dtype=torch.float32).reshape(4, 6)
+    ids = torch.arange(4 * 6, dtype=torch.int32).reshape(4, 6)
+
+    roce_calls = []
+    pynccl_calls = []
+
+    class _FakeRuntime:
+        def __init__(self, topology: str):
+            self.topology = topology
+
+        def all_gather(self, inp, dim=0, out=None):
+            assert dim == 0 and out is not None
+            roce_calls.append(("runtime_ag", tuple(inp.shape), inp.dtype))
+            out.copy_(inp.repeat(3, *([1] * (inp.ndim - 1))))
+            return out
+
+    class _FakeRoce:
+        disabled = False
+
+        def __init__(self, max_bytes: int, topology: str | None = "ring4"):
+            self.max_bytes = max_bytes
+            self._runtime = _FakeRuntime(topology) if topology else None
+
+        def should_all_gather(self, inp, dim=0):
+            assert dim == 0
+            return inp.numel() * inp.element_size() <= self.max_bytes
+
+    class _FakePyNccl:
+        disabled = False
+
+        def group_start(self):
+            pynccl_calls.append("group_start")
+
+        def all_gather(self, full, local):
+            pynccl_calls.append(("pynccl_ag", tuple(full.shape), tuple(local.shape)))
+            full.copy_(local.repeat(3, *([1] * (local.ndim - 1))))
+
+        def group_end(self):
+            pynccl_calls.append("group_end")
+
+    def route(roce: _FakeRoce) -> None:
+        roce_calls.clear()
+        pynccl_calls.clear()
+        monkeypatch.setattr(
+            sp_prefill,
+            "get_tp_group",
+            lambda: SimpleNamespace(
+                device_communicator=SimpleNamespace(
+                    b12x_ar_comm=roce, pynccl_comm=_FakePyNccl()
+                )
+            ),
+        )
+
+    monkeypatch.setattr(sp_prefill, "model_parallel_is_initialized", lambda: True)
+    route(_FakeRoce(max_bytes=16384))
+    out_v, out_s, out_w, out_i = layout.gather_many(
+        vals, scales, weights, ids, padded_rows=(64, 64)
+    )
+    # 1 direct call for vals (1024 B/row > 512) + 1 packed call for
+    # (scales, weights, ids) (32 + 24 + 24 = 80 B/row)
+    assert roce_calls == [
+        ("runtime_ag", (4, 1024), torch.uint8),
+        ("runtime_ag", (4, 80), torch.uint8),
+    ]
+    assert pynccl_calls == []
+    assert out_v.shape == (64, 1024)
+    assert out_s.shape == (64, 32)
+    assert out_w.shape == (10, 6) and out_w.dtype == torch.float32
+    assert out_i.shape == (10, 6) and out_i.dtype == torch.int32
+    torch.testing.assert_close(out_v[:12], vals.repeat(3, 1), rtol=0, atol=0)
+    torch.testing.assert_close(out_s[:12], scales.repeat(3, 1), rtol=0, atol=0)
+    torch.testing.assert_close(out_w, weights.repeat(3, 1)[:10], rtol=0, atol=0)
+    torch.testing.assert_close(out_i, ids.repeat(3, 1)[:10], rtol=0, atol=0)
+
+    # On direct, without a runtime, or when vals exceeds max_bytes: grouped PyNCCL.
+    for roce in (
+        _FakeRoce(max_bytes=16384, topology="direct"),
+        _FakeRoce(max_bytes=16384, topology=None),
+        _FakeRoce(max_bytes=1024),
+    ):
+        route(roce)
+        got = layout.gather_many(vals, scales, weights, ids, padded_rows=(64, 64))
+        assert roce_calls == []
+        assert pynccl_calls[0] == "group_start" and pynccl_calls[-1] == "group_end"
+        assert len(pynccl_calls) == 6
+        for a, b in zip(got, (out_v[:12], out_s[:12], out_w, out_i)):
+            torch.testing.assert_close(a[: b.shape[0]], b, rtol=0, atol=0)
+
