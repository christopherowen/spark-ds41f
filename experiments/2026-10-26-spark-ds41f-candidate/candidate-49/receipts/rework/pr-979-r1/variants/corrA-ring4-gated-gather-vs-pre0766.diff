+@pytest.mark.parametrize("roce_fits", [True, False])
+@pytest.mark.parametrize("slices", [1, 2])
+def test_project_exchange_rows_cuda_with_active_roce_comm(
+    monkeypatch, topology, roce_fits, slices, world=4, rows=10
+):
+    """On CUDA streams when ``b12x_ar_comm`` is active alongside ``pynccl_comm``:
+    - at ``slices=1``, one full-row projection, then ``then()``, then the TP group's
+      row exchange (``exchange_rows``: ``b12x_ar_comm`` when its
+      ``should_all_to_all_rows`` accepts the rows, else ``pynccl_comm``), in order
+      on the current stream;
+    - at ``slices=2``, sliced ``copy_self=False`` exchange runs over ``pynccl_comm``
+      and ``b12x_ar_comm`` is not used."""
+    from types import SimpleNamespace
+
+    total = world * rows - 3
+    fabric = _Fabric(world)
+    inputs = [
+        torch.randn(total, 6, device="cuda", dtype=torch.bfloat16)
+        for _ in range(world)
+    ]
+    outputs: list[torch.Tensor | None] = [None] * world
+    steps: list[list[str]] = [[] for _ in range(world)]
+    roce_counts = [0] * world
+    local_state = threading.local()
+
+    monkeypatch.setattr(
+        sp_prefill,
+        "get_tp_group",
+        lambda: SimpleNamespace(
+            device_communicator=SimpleNamespace(
+                pynccl_comm=local_state.comm, b12x_ar_comm=local_state.roce
+            )
+        ),
+    )
+
+    def all_to_all_rows(x, n):  # the TP group's row exchange, as CudaCommunicator's
+        steps[local_state.rank].append("exchange")
+        if local_state.roce.should_all_to_all_rows(x, n):
+            return local_state.roce.all_to_all_rows(x, n)
+        out = x.new_empty((world, n, *x.shape[1:]))
+        local_state.comm.all_to_all_rows(out, x.contiguous(), n)
+        return out
+
+    monkeypatch.setattr(
+        sp_prefill, "tensor_model_parallel_all_to_all_rows", all_to_all_rows
+    )
+    errors = []
+
+    def run(rank: int) -> None:
+        try:
+            local_state.rank = rank
+            local_state.comm = fabric.comm(rank)
+            sp = sp_prefill.SPRows(num_tokens=total, world_size=world, rank=rank)
+            real = sp.real_rows
+
+            class _Roce:
+                disabled = False
+
+                def should_all_to_all_rows(self, x, l_rows):
+                    return roce_fits
+
+                def all_to_all_rows(self, x, l_rows):
+                    roce_counts[rank] += 1
+                    out = torch.zeros(
+                        (world, l_rows, 6), device=x.device, dtype=x.dtype
+                    )
+                    for s in range(world):
+                        out[s, :real].copy_(
+                            inputs[s][rank * l_rows : rank * l_rows + real]
+                        )
+                    return out
+
+            local_state.roce = _Roce()
+
+            def project(start, stop, dest):
+                steps[rank].append("project")
+                dest.copy_(inputs[rank][start:stop])
+
+            outputs[rank] = sp.project_exchange_rows(
+                project,
+                (6,),
+                torch.bfloat16,
+                inputs[rank].device,
+                slices=slices,
+                then=lambda: steps[rank].append("then"),
+            )
+            torch.cuda.synchronize()
+        except BaseException as error:
+            errors.append((rank, error))
+            fabric.barrier.abort()
+
+    threads = [threading.Thread(target=run, args=(r,)) for r in range(world)]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join()
+    assert not errors, errors
+    local = sp_prefill.SPRows(num_tokens=total, world_size=world, rank=0).local_rows
+    for me in range(world):
+        assert steps[me].count("then") == 1
+        if slices == 1:
+            assert steps[me] == ["project", "then", "exchange"]
+            assert roce_counts[me] == (1 if roce_fits else 0)
+        else:
+            assert steps[me].count("project") > 1 and "exchange" not in steps[me]
+            assert roce_counts[me] == 0
+        real = max(0, min(local, total - me * local))
+        for source in range(world):
+            got = outputs[me][source]
+            assert torch.equal(
+                got[:real].view(torch.int16),
+                inputs[source][me * local : me * local + real].view(torch.int16),
+            )
