+        own = per if n is None else T.ceildiv(n, threads)
+        if n is None or tx * own < n:
+            for v in T.serial(own):
+                if n is None or tx * own + v < n:
+                    key = T.cast(keys[_swizzle_key_idx(tx * own + v, swizzle)], T.int32)
                     if key > thr:
