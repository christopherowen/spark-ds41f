+@pytest.mark.parametrize("num_tokens", [205, 800])
+def test_gate_router_route_local_caches_tail_rank_masks(
+    plain_scratch, padded_step, monkeypatch, num_tokens
+):
+    """Repeated SP local routing across encoder layers reuses the tail rank's
+    padded local masks instead of re-allocating and copying them per layer."""
+    from vllm.models.deepseek_v4_1 import sp_prefill
+
+    world_size = 3
+    padded_step(num_tokens, 4)
+    gate = _Gate(384, seed=num_tokens)
+    generator = torch.Generator(device="cuda").manual_seed(num_tokens + 7)
+    x = torch.randn(num_tokens, 5120, device="cuda", generator=generator).to(
+        torch.bfloat16
+    )
+    bias = torch.randn(384, device="cuda", generator=generator) * 0.1
+    bias_vl = torch.nn.Parameter(
+        torch.randn(384, device="cuda", generator=generator) * 0.1,
+        requires_grad=False,
+    )
+    input_ids = torch.randint(
+        0, 1000, (num_tokens,), device="cuda", generator=generator
+    )
+    input_ids[1::4] = LO
+    router = tilelang_router.TileLangGateRouter(
+        gate=gate,
+        top_k=6,
+        global_num_experts=384,
+        e_score_correction_bias=bias,
+        renormalize=True,
+        routed_scaling_factor=SCALE,
+        scoring_func="sqrtsoftplus",
+        bias_vl=bias_vl,
+        image_sentinel_lo=LO,
+        image_sentinel_count=1,
+    )
+    router.declare_kernels()
+
+    layout = sp_prefill.SPRows(num_tokens, world_size, world_size - 1)
+    assert layout.real_rows < layout.local_rows
+    local_x = layout.local_slice(x)
+
+    orig_local_slice = sp_prefill.SPRows.local_slice
+    slice_calls = []
+
+    def counted_local_slice(self, tensor):
+        slice_calls.append(tensor.shape)
+        return orig_local_slice(self, tensor)
+
+    monkeypatch.setattr(sp_prefill.SPRows, "local_slice", counted_local_slice)
+    w1, ids1 = router.route_local(local_x, layout, input_ids=input_ids)
+    first_calls = len(slice_calls)
+    assert first_calls >= 1
+    w2, ids2 = router.route_local(local_x, layout, input_ids=input_ids)
+    assert len(slice_calls) == first_calls
+    assert torch.equal(ids1, ids2)
+    assert torch.equal(w1.view(torch.int32), w2.view(torch.int32))
