From 36849b3e44f82ed1b392853b61a993d366c322b6 Mon Sep 17 00:00:00 2001
From: Christopher Owen <root@your.mom>
Date: Sun, 1 Nov 2026 01:05:31 +0100
Subject: [PATCH 628/628] feat(dsv41): pad moe_intermediate_size and handle
 TP-padded expert scale codes for TP5..TP8

Pad DeepSeek V4.1 moe_intermediate_size to a multiple of tp_size * 64 in DeepseekV41ForCausalLMConfig.update_model_config_for_parallelism (2304 -> 2560 at TP5 and TP8, 2304 -> 2688 at TP7), enable allow_tp_padding on shared_experts when padded, and ignore zero-padded scale columns in _row_deltas when packing routed-expert UE8M0 scale codes.
---
 .../test_deepseek_v41_expert_scale_codes.py   | 42 +++++++++++
 tests/models/test_deepseek_v4_1_config.py     | 47 +++++++++++++
 vllm/model_executor/models/config.py          | 70 ++++++++++++++-----
 vllm/models/deepseek_v4_1/nvidia/model.py     | 12 ++++
 .../deepseek_v4_1/tilelang/scale_codes.py     | 16 ++++-
 5 files changed, 167 insertions(+), 20 deletions(-)

diff --git a/tests/kernels/quantization/test_deepseek_v41_expert_scale_codes.py b/tests/kernels/quantization/test_deepseek_v41_expert_scale_codes.py
index b89c6aa..ca5e46a 100644
--- a/tests/kernels/quantization/test_deepseek_v41_expert_scale_codes.py
+++ b/tests/kernels/quantization/test_deepseek_v41_expert_scale_codes.py
@@ -655,3 +655,45 @@ def test_process_weights_replaces_w13_before_preparing_w2(monkeypatch):
     experts.fold_shared = True
     experts.process_weights_after_loading(layer)
     assert calls == [0, 1]
+
+
+@pytest.mark.parametrize(
+    "k, loaded_cols",
+    [
+        (512, 8),   # TP5 rank 4: 256 of 512 columns loaded (8 of 16 scale blocks)
+        (384, 2),   # TP7 rank 6: 64 of 384 columns loaded (2 of 12 scale blocks)
+        (320, 9),   # TP8 all ranks: 288 of 320 columns loaded (9 of 10 scale blocks)
+    ],
+)
+def test_tp_zero_padded_scale_columns_preserve_loaded_exponents_and_narrow_flag(
+    k: int, loaded_cols: int
+):
+    """When TP pads ``moe_intermediate_size`` to a multiple of ``tp_size * 64``
+    (TP5, TP7, TP8), ``RoutedExperts._load_w2`` leaves trailing ``w2_weight`` and
+    ``w2_weight_scale`` columns zero-filled. ``_row_deltas`` ignores those zero
+    scale bytes when computing ``base`` and ``deltas`` so loaded columns expand
+    byte-for-byte, zero-padded columns expand to ``base`` (multiplying zero weights),
+    and narrow/wide expert classification depends only on the loaded columns."""
+    exponents = _experts(k)
+    exponents[:, :, loaded_cols:] = 0
+    n_exp = k // 32
+
+    got = pack_expert_scale_codes(exponents)
+    assert got.narrow.tolist() == [1, 0]
+
+    narrow_words = expand_scale_codes_2bit(got.codes_2bit[0], got.base[0])
+    assert torch.equal(narrow_words, expand_scale_codes(got.codes[0], got.base[0]))
+    raw0 = narrow_words.view(torch.uint8).reshape(exponents.shape[1], -1)
+    assert torch.equal(raw0[:, :loaded_cols], exponents[0, :, :loaded_cols])
+    assert torch.equal(
+        raw0[:, loaded_cols:n_exp],
+        got.base[0].unsqueeze(1).expand(-1, n_exp - loaded_cols),
+    )
+
+    wide_words = expand_scale_codes(got.codes[1], got.base[1])
+    raw1 = wide_words.view(torch.uint8).reshape(exponents.shape[1], -1)
+    assert torch.equal(raw1[:, :loaded_cols], exponents[1, :, :loaded_cols])
+    assert torch.equal(
+        raw1[:, loaded_cols:n_exp],
+        got.base[1].unsqueeze(1).expand(-1, n_exp - loaded_cols),
+    )
diff --git a/tests/models/test_deepseek_v4_1_config.py b/tests/models/test_deepseek_v4_1_config.py
index a7f8e08..eaaa079 100644
--- a/tests/models/test_deepseek_v4_1_config.py
+++ b/tests/models/test_deepseek_v4_1_config.py
@@ -67,3 +67,50 @@ def test_deepseek_v41_tp3_padding_uses_generic_parallel_hook() -> None:
     assert text_config.num_attention_heads == 72
     assert text_config.o_groups == 9
     assert model_config.model_arch_config.total_num_attention_heads == 72
+
+
+@pytest.mark.parametrize(
+    "tp_size, expected_heads, expected_groups, expected_moe_intermediate",
+    [
+        (3, 72, 9, 2304),
+        (4, 64, 8, 2304),
+        (5, 80, 10, 2560),
+        (6, 96, 12, 2304),
+        (7, 112, 14, 2688),
+        (8, 64, 8, 2560),
+    ],
+)
+def test_deepseek_v41_tp3_to_tp8_padding_aligns_heads_and_moe_intermediate(
+    tp_size: int,
+    expected_heads: int,
+    expected_groups: int,
+    expected_moe_intermediate: int,
+) -> None:
+    text_config = SimpleNamespace(
+        num_attention_heads=64,
+        o_groups=8,
+        moe_intermediate_size=2304,
+    )
+    model_config = SimpleNamespace(
+        architecture="DeepseekV41ForCausalLM",
+        hf_config=text_config,
+        hf_text_config=text_config,
+        model_arch_config=SimpleNamespace(total_num_attention_heads=64),
+    )
+    model_config.get_model_arch_config = lambda: SimpleNamespace(
+        total_num_attention_heads=text_config.num_attention_heads
+    )
+    parallel_config = SimpleNamespace(tensor_parallel_size=tp_size)
+
+    ModelConfig._update_model_config_for_parallelism(model_config, parallel_config)
+    ModelConfig._update_model_config_for_parallelism(model_config, parallel_config)
+
+    assert text_config.num_attention_heads == expected_heads
+    assert text_config.o_groups == expected_groups
+    assert text_config.moe_intermediate_size == expected_moe_intermediate
+    assert (text_config.moe_intermediate_size // tp_size) % 64 == 0
+    if expected_heads != 64:
+        assert text_config.original_num_attention_heads == 64
+        assert text_config.original_o_groups == 8
+    if expected_moe_intermediate != 2304:
+        assert text_config.original_moe_intermediate_size == 2304
