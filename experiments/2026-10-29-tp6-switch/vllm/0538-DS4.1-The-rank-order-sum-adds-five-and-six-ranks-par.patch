+@pytest.mark.parametrize("world", WORLDS)
+def test_kernel_adds_each_source_once_in_rank_order(world):
+    """The kernel's IR, built on the host, in statement order: source r's row is
+    loaded r-th; the first is taken as is (a cast, no add to zero), each other is
+    added to the running FP32 total right after its load; one rounding at the end."""
+    script = rank_order_sum_kernel.get_tir(world).script()
+    steps = re.findall(
+        r"xs\[i\] = (s\d+)\[row, i\]"
+        r"|total\[i\] = (total\[i\] \+ )?T\.Cast\(\"float32\", xs\[i\]\)"
+        r"|(xs)\[i\] = T\.Cast\(\"bfloat16\", total\[i\]\)",
+        script,
+    )
+    steps = [
+        load or ("add" if add else "round" if rnd else "take")
+        for load, add, rnd in steps
+    ]
+    want = ["s0", "take"]
+    for r in range(1, world):
+        want += [f"s{r}", "add"]
+    assert steps == want + ["round"]
+
