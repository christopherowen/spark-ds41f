 @pytest.mark.parametrize("id_dtype", [torch.int32, torch.int64])
 @pytest.mark.parametrize(
-    "layout", ["dense", "padded", "sliced", "transposed", "general"]
+    "layout,cols",
+    [
+        ("dense", 33),
+        ("padded", 33),
+        ("sliced", 33),
+        ("transposed", 33),
+        ("transposed", 1024),
