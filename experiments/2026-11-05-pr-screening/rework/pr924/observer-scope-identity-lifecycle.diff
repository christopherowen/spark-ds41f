diff --git a/experiments/2026-11-04-lossless-memory/engram/observer_support.py b/experiments/2026-11-04-lossless-memory/engram/observer_support.py
new file mode 100644
--- /dev/null
+++ b/experiments/2026-11-04-lossless-memory/engram/observer_support.py
@@ -0,0 +1,233 @@
+"""Exact-target metadata and owned CPU-observer lifecycle; no implicit dispatch."""
+import hashlib
+import json
+import re
+import shlex
+import subprocess
+import uuid
+
+OWNER = "lossless-memory-engram-observer"
+LABEL_PREFIX = "local.spark-ds41f.observer."
+TARGET_FORMAT = '{"Id":{{json .Id}},"Image":{{json .Image}},"State":{"Running":{{json .State.Running}},"Pid":{{json .State.Pid}},"StartedAt":{{json .State.StartedAt}}},"User":{{json .Config.User}},"Privileged":{{json .HostConfig.Privileged}},"CapAdd":{{json .HostConfig.CapAdd}}}'
+OWN_FORMAT = '{"Id":{{json .Id}},"Name":{{json .Name}},"Image":{{json .Image}},"ConfigImage":{{json .Config.Image}},"Labels":{{json .Config.Labels}},"Running":{{json .State.Running}}}'
+
+# The SSH UID can read birth ticks/NSpid even when root-owned io/FD access is
+# protected. No privileged operation occurs while this target is captured.
+HOST_SNAPSHOT = r'''
+import json,pathlib,sys
+result={}
+for pid in sys.argv[1:]:
+ root=pathlib.Path('/proc')/pid
+ def ticks():
+  value=(root/'stat').read_text()
+  return int(value[value.rfind(')')+2:].split()[19])
+ before=ticks()
+ line=next(v for v in (root/'status').read_text().splitlines() if v.startswith('NSpid:'))
+ ns=[int(v) for v in line.split()[1:]]
+ if not ns or ns[0]!=int(pid) or before!=ticks():raise RuntimeError('target PID identity changed during capture')
+ result[pid]={'start_ticks':before,'namespace_pids':ns}
+print(json.dumps(result))
+'''
+
+# Prepended to both the I/O probe and FD verifier, so their exact stdin/program
+# hash covers the common checks. All comparisons use one observer's cgroup view.
+PROC_IDENTITY = r'''
+import hashlib,json,os,pathlib
+def observer_proc_identity(pid):
+ root=pathlib.Path('/proc')/str(pid)
+ stat=(root/'stat').read_text()
+ return {'start_ticks':int(stat[stat.rfind(')')+2:].split()[19]),
+         'pid_namespace':os.readlink(root/'ns/pid'),
+         'cgroup':(root/'cgroup').read_text().splitlines()}
+def observer_check_identity(value,expected_ticks,init,container_id):
+ if (value['start_ticks']!=expected_ticks or value['pid_namespace']!=init['pid_namespace']
+     or value['cgroup']!=init['cgroup'] or not any(container_id in row for row in init['cgroup'])):
+  raise RuntimeError('PID reuse or namespace/cgroup membership changed')
+def observer_assert_stable(before,after):
+ if before!=after:raise RuntimeError('PID identity changed during observation')
+'''
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def valid_target(target, image=None):
+    require(isinstance(target, dict) and re.fullmatch(r"[0-9a-f]{64}", target.get("container_id", "")),
+            "inspected immutable container ID is required")
+    require(re.fullmatch(r"sha256:[0-9a-f]{64}", target.get("image", ""))
+            and (image is None or target["image"] == image), "target image differs")
+    init = str(target.get("init_pid", "")); pids = target.get("processes", {})
+    require(init in pids and 1 <= len(pids) <= 1024 and target.get("started_at"), "target init/PID set is missing")
+    for pid, row in pids.items():
+        require(pid.isascii() and pid.isdecimal() and int(pid) > 0
+                and type(row.get("start_ticks")) is int and row["start_ticks"] > 0,
+                "target PID birth identity is invalid")
+        ns = row.get("namespace_pids")
+        require(isinstance(ns, list) and ns and ns[0] == int(pid)
+                and all(type(v) is int and v > 0 for v in ns), "target PID namespace map is invalid")
+    require(len({row["namespace_pids"][-1] for row in pids.values()}) == len(pids),
+            "target namespace PIDs are duplicated")
+    return target
+
+
+def capture_target(run, container, parse_pids, expected_image=None):
+    inspected = json.loads(run("docker", "inspect", container, "--format", TARGET_FORMAT))
+    require(inspected["State"]["Running"] is True and inspected["User"] in ("", "root", "0")
+            and inspected["Privileged"] is False
+            and set(inspected.get("CapAdd") or []) <= {"IPC_LOCK", "CAP_IPC_LOCK"},
+            "serving container permissions/running state differ")
+    pids = parse_pids(run("docker", "top", inspected["Id"], "-eo", "pid"))
+    require(str(inspected["State"]["Pid"]) in pids, "inspected container init is not in docker top")
+    births = json.loads(run("python3", "-c", HOST_SNAPSHOT, *pids))
+    require(set(births) == set(pids), "captured serving PID set differs")
+    return valid_target({"container": container, "container_id": inspected["Id"],
+        "image": inspected["Image"], "init_pid": inspected["State"]["Pid"],
+        "started_at": inspected["State"]["StartedAt"], "processes": births}, expected_image)
+
+
+def verify_target(run, target, parse_pids):
+    valid_target(target)
+    now = capture_target(run, target["container_id"], parse_pids, target["image"])
+    # capture by immutable ID changes only the descriptive container argument.
+    now["container"] = target["container"]
+    require(now == target, "serving container/PID births changed after observation")
+
+
+def namespace_target(target):
+    valid_target(target)
+    return {"container_id": target["container_id"],
+            "init_pid": target["processes"][str(target["init_pid"])]["namespace_pids"][-1],
+            "processes": {str(row["namespace_pids"][-1]): {"start_ticks": row["start_ticks"]}
+                          for row in target["processes"].values()}}
+
+
+class CleanupUnknown(RuntimeError):
+    pass
+
+
+def ssh_transport(spark, nodes, node):
+    def run(argv, *, input_text=None, timeout=30):
+        return subprocess.run(["ssh", *spark.ssh_options(), spark.ssh_target(nodes, node), shlex.join(argv)],
+            input=input_text, text=True, capture_output=True, timeout=timeout)
+    return run
+
+
+def owned_observer(transport, run_argv, *, image, window, guard, latch_review, trace,
+                   input_text=None, timeout=30, nonce=None, persist=None):
+    """Create/start an owned peer; inspect its exact ID/labels before any stop/rm.
+
+    A timed-out SSH client never constitutes cleanup. Unknown cleanup latches a
+    sticky review hold through the existing exact-owner controller callback.
+    """
+    require(run_argv[:2] == ["docker", "run"] and re.fullmatch(r"sha256:[0-9a-f]{64}", image),
+            "owned observer requires a fixed run plan and immutable image")
+    require(not any(v == "--name" or v.startswith("--name=") or v.startswith("--label")
+                    for v in run_argv[2:]), "observer plan must not supply lifecycle identity")
+    nonce = nonce or uuid.uuid4().hex
+    require(re.fullmatch(r"[0-9a-f]{32}", nonce) and isinstance(window, str) and window,
+            "observer owner token is missing")
+    name = "lossless-obs-" + hashlib.sha256(window.encode()).hexdigest()[:12] + "-" + nonce[:12]
+    labels = {LABEL_PREFIX + "owner": OWNER, LABEL_PREFIX + "window": window, LABEL_PREFIX + "nonce": nonce}
+    require(type(timeout) is int and 1 <= timeout <= 1800, "observer lifetime must be explicitly bounded")
+    child_lifetime = min(timeout, 600)
+    # The alarm is armed inside the container, independent of the SSH client or
+    # controller lifetime. Ten minutes leaves margin before the scoped window's
+    # fifteen-minute stale-heartbeat watchdog, even with its 30-second beat.
+    # These fixed observers execute one Python process; a deadline never passes
+    # a partial observation. The transport may retain its longer timeout.
+    image_index = run_argv.index(image)
+    require(run_argv[image_index - 2:image_index] == ["--entrypoint", "python3"]
+            and run_argv[image_index + 1] == "-c", "unexpected observer entrypoint")
+    program_index = image_index + 2
+    bounded_argv = list(run_argv)
+    bounded_argv[program_index] = ("import signal; signal.signal(signal.SIGALRM,signal.SIG_DFL); "
+        f"signal.alarm({child_lifetime});\n" + bounded_argv[program_index])
+    trace.update(name=name, image=image, window=window, nonce=nonce, commands=[], cleanup_known=False,
+                 child_lifetime_seconds=child_lifetime,transport_timeout_seconds=timeout)
+    cid, outcome, failure, create_attempted = None, None, None, False
+
+    def save():
+        if persist is not None:
+            persist()
+
+    save()
+
+    def command(argv, *, source=None, seconds=30):
+        row = {"argv": argv, "timeout": seconds,
+               "stdin_sha256": hashlib.sha256(source.encode()).hexdigest() if source is not None else None}
+        trace["commands"].append(row)
+        save()
+        try:
+            result = transport(argv, input_text=source, timeout=seconds)
+            row.update(exit=result.returncode, stdout=result.stdout, stderr=result.stderr)
+            save()
+            require(len((result.stdout + result.stderr).encode()) <= 512 * 1024,
+                    "observer output exceeded its retained bound")
+            return result
+        except BaseException as error:
+            row["error"] = type(error).__name__ + ": " + str(error)
+            if isinstance(error, subprocess.TimeoutExpired):
+                for key in ("stdout", "stderr"):
+                    partial = getattr(error, key, None)
+                    row[key] = partial.decode(errors="replace") if isinstance(partial, bytes) else partial
+            save()
+            raise
+
+    def inspected(reference):
+        result = command(["docker", "inspect", reference, "--format", OWN_FORMAT], seconds=15)
+        if result.returncode:
+            require(result.returncode == 1 and ("No such object" in result.stderr or "No such container" in result.stderr),
+                    "observer cleanup identity is unreadable")
+            return None
+        value = json.loads(result.stdout)
+        require(value.get("Name") == "/" + name and value.get("Image") == image
+                and value.get("ConfigImage") == image
+                and re.fullmatch(r"[0-9a-f]{64}", value.get("Id", ""))
+                and (cid is None or value["Id"] == cid)
+                and all((value.get("Labels") or {}).get(k) == v for k, v in labels.items()),
+                "refusing foreign container cleanup")
+        return value
+
+    try:
+        guard()
+        create = ["docker", "create", "--name", name, "--stop-timeout=5"]
+        for key, value in labels.items():
+            create += ["--label", key + "=" + value]
+        create += [arg for arg in bounded_argv[2:] if arg != "--rm"]
+        create_attempted = True
+        created = command(create)
+        require(created.returncode == 0 and re.fullmatch(r"[0-9a-f]{64}", created.stdout.strip()),
+                "observer create did not return an immutable CID")
+        cid = created.stdout.strip(); trace["cid"] = cid
+        save()
+        require(inspected(cid) is not None, "created observer disappeared")
+        guard()
+        outcome = command(["docker", "start", "--attach", "--interactive", cid],
+                          source=input_text, seconds=timeout)
+    except BaseException as error:
+        failure = error
+        trace["failure"] = type(error).__name__ + ": " + str(error)
+        save()
+    finally:
+        try:
+            actual = inspected(cid or name) if create_attempted else None
+            if actual is not None:
+                if actual["Running"]:
+                    stopped = command(["docker", "stop", "--time", "5", actual["Id"]], seconds=15)
+                    require(stopped.returncode == 0, "owned observer stop failed")
+                    actual = inspected(actual["Id"])
+                    require(actual is not None and actual["Running"] is False, "owned observer is still running or unknown")
+                removed = command(["docker", "rm", actual["Id"]], seconds=15)
+                require(removed.returncode == 0 and inspected(actual["Id"]) is None, "owned observer removal is unverified")
+            trace["cleanup_known"] = True
+            save()
+        except BaseException as error:
+            trace["cleanup_error"] = type(error).__name__ + ": " + str(error)
+            latch_review(trace["cleanup_error"])
+            save()
+            raise CleanupUnknown("observer cleanup is unknown; exact scope retained for review") from error
+    if failure is not None:
+        raise failure
+    return outcome
