{
  "experiment": "experiments/2026-11-16-c60-prefill",
  "run": "candidate-60-image",
  "jobs": [
    {
      "kind": "sync"
    },
    {
      "kind": "image",
      "config": "image-dgx4.json",
      "node": "dgx4",
      "copies": [
        [
          "dgx4",
          "dgx3-internal"
        ],
        [
          "dgx3",
          "dgx2-internal"
        ],
        [
          "dgx2",
          "dgx1-internal"
        ]
      ],
      "remove_stopped": true
    },
    {
      "kind": "kernel",
      "bundles": [
        {
          "bundle": "experiments/2026-11-16-c60-prefill/bundles/release-tests",
          "node": "dgx4"
        }
      ]
    }
  ]
}
