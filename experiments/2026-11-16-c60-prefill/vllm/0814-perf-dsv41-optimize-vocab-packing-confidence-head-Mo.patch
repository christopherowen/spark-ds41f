     return [_call(flatten_sampled_kernel)]
 
 
+@tilelang.jit(pass_configs=_PASS)
+def mask_dead_rows_kernel(idx_dtype: str):
+    """Mask expanded_idx_mapping to -1 on dead verification rows
+    (row - cu_num_logits[r] > dead_row_cut[r]) and gather each row's
+    top_k and top_p with neutral values (vocab_size and 1.0)
+    on dead rows."""
+    num_logits, num_reqs, cu_len, states = T.dynamic(
+        "num_logits, num_reqs, cu_len, states"
+    )
+
+    @T.prim_func
+    def mask_dead_rows(
+        out_idx: T.Tensor((num_logits,), idx_dtype),
+        out_k: T.Tensor((num_logits,), T.int32),
+        out_p: T.Tensor((num_logits,), T.float32),
+        expanded_idx_mapping: T.Tensor((num_logits,), idx_dtype),
+        cu_num_logits: T.Tensor((cu_len,), T.int32),
+        dead_row_cut: T.Tensor((num_reqs,), T.int32),
+        top_k_state: T.Tensor((states,), T.int32),
+        top_p_state: T.Tensor((states,), T.float32),
+        vocab_size: T.int32,
+    ):
+        with T.Kernel(
+            T.ceildiv(num_logits, _FLATTEN_THREADS), threads=_FLATTEN_THREADS
+        ) as b:
+            row = b * _FLATTEN_THREADS + T.get_thread_binding()
+            req = T.alloc_var(T.int32, init=-1)
+            for r in T.serial(num_reqs):
+                if (cu_num_logits[r] <= row) & (row < cu_num_logits[r + 1]):
+                    req = r
+            if row < num_logits:
+                slot = T.alloc_var(
+                    T.int64, init=T.cast(expanded_idx_mapping[row], T.int64)
+                )
+                live = (
+                    (req >= 0)
+                    & (slot >= T.int64(0))
+                    & (
+                        row - cu_num_logits[T.max(req, 0)]
+                        <= dead_row_cut[T.max(req, 0)]
+                    )
+                )
+                safe_slot = T.max(slot, T.int64(0))
+                out_idx[row] = T.if_then_else(
+                    live, expanded_idx_mapping[row], T.cast(-1, idx_dtype)
+                )
+                out_k[row] = T.if_then_else(
+                    live, top_k_state[safe_slot], vocab_size
+                )
+                out_p[row] = T.if_then_else(
+                    live, top_p_state[safe_slot], T.float32(1)
+                )
+
+    return mask_dead_rows
+
+
+def mask_dead_rows_key(idx_dtype: torch.dtype) -> tuple:
+    return (_DTYPES[idx_dtype],)
+
+
+def mask_dead_rows(
+    expanded_idx_mapping: torch.Tensor,
+    cu_num_logits: torch.Tensor,
+    dead_row_cut: torch.Tensor,
+    top_k_state: torch.Tensor,
+    top_p_state: torch.Tensor,
+    vocab_size: int,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Return (live_idx_mapping, row_top_k, row_top_p) where rows past each
+    request's dead_row_cut are masked to -1, vocab_size, and 1.0."""
+    num_logits = expanded_idx_mapping.shape[0]
+    device = expanded_idx_mapping.device
+    out_idx = torch.empty_like(expanded_idx_mapping)
+    out_k = torch.empty(num_logits, dtype=torch.int32, device=device)
+    out_p = torch.empty(num_logits, dtype=torch.float32, device=device)
+    if num_logits:
+        num_reqs = dead_row_cut.shape[0]
+        _kernel(
+            mask_dead_rows_kernel,
+            *mask_dead_rows_key(expanded_idx_mapping.dtype),
+        )(
+            out_idx,
+            out_k,
+            out_p,
+            expanded_idx_mapping.contiguous(),
+            _as(cu_num_logits[: num_reqs + 1], torch.int32),
+            _as(dead_row_cut, torch.int32),
+            top_k_state,
+            top_p_state,
+            int(vocab_size),
+        )
+    return out_idx, out_k, out_p
+
+
+def mask_dead_rows_calls() -> list:
+    return [
+        _call(mask_dead_rows_kernel, *mask_dead_rows_key(dtype))
+        for dtype in (torch.int32, torch.int64)
+    ]
+
+
 # --- Per-request row scatters ---------------------------------------------------
 
 _SCATTER_THREADS = 128
