+def test_bounded_piece_cache_entry_and_byte_budget():
+    from vllm.tokenizers.deepseek_v41 import _BoundedPieceCache
+
+    cache = _BoundedPieceCache(max_entries=4, max_bytes=256)
+    assert isinstance(cache, dict)
+    cache["a" * 20] = (1, 2, 3)
+    cache["b" * 20] = (4, 5, 6)
+    cache.touch("a" * 20)
+    cache["c" * 20] = (7, 8, 9)
+    cache["d" * 20] = (10, 11, 12)
+    cache["e" * 20] = (13, 14, 15)
+    assert len(cache) <= 4
+    # "b"*20 was least recently touched and should be evicted before "a"*20.
+    assert ("a" * 20) in cache
+    assert ("b" * 20) not in cache
+
+    # An oversized entry is skipped instead of wiping warm entries or exceeding budget.
+    cache["giant" * 100] = tuple(range(500))
+    assert ("giant" * 100) not in cache
+    assert cache.total_bytes <= 256
+    cache.clear()
+    assert len(cache) == 0
+    assert cache.total_bytes == 0
+
