+class TestDeferredToolReference:
+    def test_tool_result_with_tool_reference_keeps_single_tool_message(self):
+        tools = [
+            {
+                "name": "tool_search",
+                "description": "Search deferred tools",
+                "input_schema": {
+                    "type": "object",
+                    "properties": {"q": {"type": "string"}},
+                },
+            },
+            {
+                "name": "db_query",
+                "description": "Execute SQL",
+                "input_schema": {
+                    "type": "object",
+                    "properties": {"sql": {"type": "string"}},
+                },
+                "defer_loading": True,
+            },
+        ]
+        request = _make_request(
+            [
+                {"role": "user", "content": "Query users table."},
+                {
+                    "role": "assistant",
+                    "content": [
+                        {
+                            "type": "tool_use",
+                            "id": "call_s1",
+                            "name": "tool_search",
+                            "input": {"q": "sql"},
+                        }
+                    ],
+                },
+                {
+                    "role": "user",
+                    "content": [
+                        {
+                            "type": "tool_result",
+                            "tool_use_id": "call_s1",
+                            "content": [
+                                {"type": "text", "text": "Matched:"},
+                                {"type": "tool_reference", "tool_name": "db_query"},
+                            ],
+                        }
+                    ],
+                },
+            ],
+            tools=tools,
+        )
+        converted = _convert(request)
+        tool_msgs = [m for m in converted.messages if m.get("role") == "tool"]
+        assert len(tool_msgs) == 1
+        assert tool_msgs[0]["tool_call_id"] == "call_s1"
+        assert tool_msgs[0]["content"] == [
+            {"type": "text", "text": "Matched:"},
+            {"type": "tool_reference", "name": "db_query"},
+        ]
+        assert converted.tools is not None
+        assert converted.tools[1].function.defer_loading is True
+
+        # Rendering through DeepSeek V4.1 keeps deferred tools out of system
+        # preamble and injects their schema inline inside <tool_result>.
+        from tests.tokenizers_.test_deepseek_v4 import FakeHfTokenizer
+        from vllm.tokenizers.deepseek_v41 import get_deepseek_v41_tokenizer
+
+        prompt = get_deepseek_v41_tokenizer(FakeHfTokenizer()).apply_chat_template(
+            converted.messages,
+            tools=[t.model_dump(exclude_none=True) for t in converted.tools],
+            tokenize=False,
+            thinking=False,
+        )
+        sys_section, _, rest = prompt.partition("<｜User｜>")
+        assert "tool_search" in sys_section
+        assert "db_query" not in sys_section
+        assert "<tool_schema>" in rest
+        assert '"name": "db_query"' in rest
+        assert "Matched:" in rest
