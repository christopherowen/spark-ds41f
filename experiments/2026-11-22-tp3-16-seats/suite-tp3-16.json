{
  "name": "tp3-16-seats",
  "version": 1,
  "description": "TP3 16-seat qualification suite: 128-prompt bit-exact model check at c16, engine grid up to 16 requests, c1/c8/c16 closed loops, stall-6 131K probe TTFT, and 1M prefill memory-headroom check.",
  "steps": [
    {
      "id": "model",
      "command": "model",
      "args": {
        "limit": 128,
        "concurrency": 16,
        "max_tokens": 256,
        "top": 20
      }
    },
    {
      "id": "grid",
      "command": "engine",
      "args": {
        "replays": 100,
        "settle": 1,
        "max_requests": 16
      }
    },
    {
      "id": "c1",
      "command": "run",
      "args": {
        "mode": "closed",
        "concurrency": 1,
        "warmup": 30,
        "duration": 180,
        "extra_body": {
          "chat_template_kwargs": {
            "thinking": false
          }
        }
      }
    },
    {
      "id": "c8",
      "command": "run",
      "args": {
        "mode": "closed",
        "concurrency": 8,
        "warmup": 60,
        "duration": 300,
        "extra_body": {
          "chat_template_kwargs": {
            "thinking": false
          }
        }
      }
    },
    {
      "id": "c16",
      "command": "run",
      "args": {
        "mode": "closed",
        "concurrency": 16,
        "warmup": 60,
        "duration": 300,
        "extra_body": {
          "chat_template_kwargs": {
            "thinking": false
          }
        }
      }
    },
    {
      "id": "stall-6",
      "command": "stall",
      "args": {
        "sizes": [
          131072
        ],
        "streams": 6,
        "max_tokens": 16384,
        "warmup": 20,
        "tail": 2,
        "repeats": 3,
        "probes": [
          2,
          5,
          8,
          11,
          14
        ],
        "probe_tokens": 500,
        "probe_max_tokens": 16
      }
    },
    {
      "id": "prefill-1m",
      "command": "prefill",
      "args": {
        "sizes": [
          1000000
        ],
        "repeats": 1
      }
    }
  ]
}
