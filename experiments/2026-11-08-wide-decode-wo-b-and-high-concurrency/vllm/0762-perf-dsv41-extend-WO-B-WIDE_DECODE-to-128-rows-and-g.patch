+@pytest.mark.parametrize("max_num_seqs", [32, 48])
+def test_high_concurrency_varlen_decode_uses_padded_ladder_past_16_reqs(
+    monkeypatch, max_num_seqs
+):
+    """Above 16 requests, dense_varlen_decode_shapes stops adding per-request
+    full-depth captures because the 8-row/16-row padded ladder already covers
+    104+ rows as FULL graphs."""
+    cap = max_num_seqs * 6 + 11
+    ladder = [1, 2, 3, 4, 6, 8, *range(12, 33, 4), *range(40, min(cap, 257), 8)]
+    if cap > 256:
+        ladder.extend(range(272, cap, 16))
+    sizes = [*(s for s in ladder if s < cap), cap]
+    shapes = gpu_cudagraph_utils.dense_varlen_decode_shapes(
+        max_num_seqs, 17, cap, uniform_query_len=6
+    )
+    assert len(shapes) == 70
+    assert max(tokens for _, tokens in shapes) == 102
+
+    manager = _make_spec_decode_manager(
+        monkeypatch,
+        decode_query_len=17,
+        capture_sizes=sizes,
+        num_speculative_tokens=5,
+        max_num_seqs=max_num_seqs,
+        varlen_decode=True,
+    )
+    for reqs in range(1, max_num_seqs + 1):
+        rows = reqs * 6
+        desc = manager.dispatch(reqs, rows, None, 0, max_query_len=6)
+        assert desc.cg_mode == CUDAGraphMode.FULL
+        assert desc.num_reqs >= reqs
+        if reqs <= 16:
+            assert desc.num_tokens == rows
+        else:
+            assert rows <= desc.num_tokens <= rows + 16
