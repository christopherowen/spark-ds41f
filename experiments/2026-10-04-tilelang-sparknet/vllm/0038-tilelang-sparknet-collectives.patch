From 54a82c924feaa1993ab018679b8e79a1b66c6422 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Sun, 4 Oct 2026 18:43:39 +0200
Subject: [PATCH] Use sparknet's one-shot collectives for DS4.1's TileLang
 family

With the RoCE policy selected, the TileLang kernel family constructs
sparknet's vLLM adapter instead of B12X's: the same protocol (B12X's RoCE
collectives with spark3's patches 0001-0011), the same constructor and
methods, prepared at construction. The worker freezes sparknet's kernel
resolution after warm-up, so a compile inside a step raises instead of
stalling it.
---
 .../device_communicators/cuda_communicator.py | 22 +++++++++++++++----
 vllm/v1/worker/gpu_worker.py                  |  7 ++++++
 2 files changed, 25 insertions(+), 4 deletions(-)

diff --git a/vllm/distributed/device_communicators/cuda_communicator.py b/vllm/distributed/device_communicators/cuda_communicator.py
index f984bc944..d731eb6af 100644
--- a/vllm/distributed/device_communicators/cuda_communicator.py
+++ b/vllm/distributed/device_communicators/cuda_communicator.py
@@ -191,11 +191,24 @@ class CudaCommunicator(DeviceCommunicatorBase):
                 global_ranks=self.ranks,
             )
         elif self.use_roce_allreduce and self.world_size > 1:
-            # RoCEnante: multi-node DGX Spark one-shot RDMA collectives
-            # from b12x.comm.roce.
-            from .b12x_roce_all_reduce import B12xRoceAllReduce
+            # Multi-node DGX Spark one-shot RDMA collectives: sparknet's for
+            # DS4.1's TileLang kernel family, b12x.comm.roce's for B12X. Both
+            # carry the same protocol (B12X with spark3's RoCE patches).
+            roce_options = {}
+            if envs.VLLM_DS41_KERNEL_BACKEND == "tilelang":
+                from sparknet.integration.vllm import (
+                    SparknetOneShotAllReduce as RoceAllReduce,
+                )
+
+                from vllm.distributed.parallel_state import in_the_same_node_as
+
+                roce_options["in_the_same_node"] = in_the_same_node_as(
+                    self.cpu_group, source_rank=0
+                )
+            else:
+                from .b12x_roce_all_reduce import B12xRoceAllReduce as RoceAllReduce
 
-            self.b12x_ar_comm = B12xRoceAllReduce(
+            self.b12x_ar_comm = RoceAllReduce(
                 group=self.cpu_group,
                 device_group=self.device_group,
                 device=self.device,
@@ -203,6 +216,7 @@ class CudaCommunicator(DeviceCommunicatorBase):
                 nccl_available=(
                     self.pynccl_comm is not None and not self.pynccl_comm.disabled
                 ),
+                **roce_options,
             )
             self._roce_policy = not self.b12x_ar_comm.disabled
             if self._roce_policy:
diff --git a/vllm/v1/worker/gpu_worker.py b/vllm/v1/worker/gpu_worker.py
index 3222d7ef2..59d1e6b89 100644
--- a/vllm/v1/worker/gpu_worker.py
+++ b/vllm/v1/worker/gpu_worker.py
@@ -5,6 +5,7 @@
 import contextlib
 import gc
 import os
+import sys
 import time
 from collections.abc import Callable
 from contextlib import AbstractContextManager, contextmanager, nullcontext
@@ -1105,6 +1106,12 @@ class Worker(WorkerBase):
             mode=self.observability_config.jit_monitor_mode,
             verbose=self.observability_config.jit_monitor_verbose,
         )
+        if "sparknet.oneshot" in sys.modules:
+            # sparknet prepared its kernels before capture; one compiling now
+            # would stall a step, so it raises instead.
+            sys.modules["sparknet.oneshot"].freeze_kernel_resolution(
+                "vLLM warm-up is complete"
+            )
 
         # Freeze the worker heap so the GC won't scan static objects
         # (model weights, KV caches, CUDA graphs) during inference.
-- 
