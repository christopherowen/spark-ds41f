From 545073ea632f2daa78e8a9323b232996338aea40 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Sun, 4 Oct 2026 18:43:39 +0200
Subject: [PATCH] Use sparknet's one-shot collectives for DS4.1's TileLang
 family

The TileLang kernel family always runs sparknet's one-shot collectives on
its tensor-parallel group, configured by sparknet's own SPARKNET_ROCE_*
settings: the communicator constructs sparknet's vLLM adapter (the same
protocol as B12X's RoCE collectives with spark3's patches 0001-0011,
prepared at construction), refuses VLLM_ENABLE_ROCE_ALLREDUCE, which does
not apply to it, and requires custom all-reduce. The policy log names the
backend constructed. The worker freezes sparknet's kernel resolution after
warm-up, so a compile inside a step raises instead of stalling it.
---
 .../device_communicators/cuda_communicator.py | 52 +++++++++++++++----
 vllm/v1/worker/gpu_worker.py                  |  7 +++
 2 files changed, 48 insertions(+), 11 deletions(-)

diff --git a/vllm/distributed/device_communicators/cuda_communicator.py b/vllm/distributed/device_communicators/cuda_communicator.py
index f984bc944..c124aed01 100644
--- a/vllm/distributed/device_communicators/cuda_communicator.py
+++ b/vllm/distributed/device_communicators/cuda_communicator.py
@@ -124,13 +124,27 @@ class CudaCommunicator(DeviceCommunicatorBase):
                 and envs.VLLM_ENABLE_PCIE_ALLREDUCE
                 and envs.VLLM_PCIE_ALLREDUCE_BACKEND == "b12x"
             )
-            if envs.VLLM_ENABLE_ROCE_ALLREDUCE and not use_custom_allreduce:
-                raise ValueError(
-                    "RoCEnante was requested but custom all-reduce is disabled"
+            if envs.VLLM_DS41_KERNEL_BACKEND == "tilelang":
+                # DS4.1's TileLang family always runs sparknet's one-shot
+                # collectives; vLLM's RoCE switch is not read for it.
+                if envs.VLLM_ENABLE_ROCE_ALLREDUCE:
+                    raise ValueError(
+                        "VLLM_ENABLE_ROCE_ALLREDUCE does not apply to the TileLang "
+                        "kernel family, whose one-shot collectives are always on"
+                    )
+                if not use_custom_allreduce:
+                    raise ValueError(
+                        "sparknet's one-shot collectives need custom all-reduce"
+                    )
+                use_roce_allreduce = True
+            else:
+                if envs.VLLM_ENABLE_ROCE_ALLREDUCE and not use_custom_allreduce:
+                    raise ValueError(
+                        "RoCEnante was requested but custom all-reduce is disabled"
+                    )
+                use_roce_allreduce = (
+                    use_custom_allreduce and envs.VLLM_ENABLE_ROCE_ALLREDUCE
                 )
-            use_roce_allreduce = (
-                use_custom_allreduce and envs.VLLM_ENABLE_ROCE_ALLREDUCE
-            )
             if use_b12x_allreduce or use_roce_allreduce:
                 use_flashinfer_allreduce = False
 
@@ -191,11 +205,25 @@ class CudaCommunicator(DeviceCommunicatorBase):
                 global_ranks=self.ranks,
             )
         elif self.use_roce_allreduce and self.world_size > 1:
-            # RoCEnante: multi-node DGX Spark one-shot RDMA collectives
-            # from b12x.comm.roce.
-            from .b12x_roce_all_reduce import B12xRoceAllReduce
+            # Multi-node DGX Spark one-shot RDMA collectives: sparknet's for
+            # DS4.1's TileLang kernel family (configured by its SPARKNET_ROCE_*
+            # settings), b12x.comm.roce's for B12X. Both carry the same
+            # protocol (B12X's with spark3's RoCE patches).
+            roce_options = {}
+            if envs.VLLM_DS41_KERNEL_BACKEND == "tilelang":
+                from sparknet.integration.vllm import (
+                    SparknetOneShotAllReduce as RoceAllReduce,
+                )
+
+                from vllm.distributed.parallel_state import in_the_same_node_as
+
+                roce_options["in_the_same_node"] = in_the_same_node_as(
+                    self.cpu_group, source_rank=0
+                )
+            else:
+                from .b12x_roce_all_reduce import B12xRoceAllReduce as RoceAllReduce
 
-            self.b12x_ar_comm = B12xRoceAllReduce(
+            self.b12x_ar_comm = RoceAllReduce(
                 group=self.cpu_group,
                 device_group=self.device_group,
                 device=self.device,
@@ -203,6 +231,7 @@ class CudaCommunicator(DeviceCommunicatorBase):
                 nccl_available=(
                     self.pynccl_comm is not None and not self.pynccl_comm.disabled
                 ),
+                **roce_options,
             )
             self._roce_policy = not self.b12x_ar_comm.disabled
             if self._roce_policy:
@@ -366,10 +395,11 @@ class CudaCommunicator(DeviceCommunicatorBase):
         """
         if self._roce_policy:
             logger.info_once(
-                "Collective policy for group '%s': B12X_ROCENANTE for eligible "
+                "Collective policy for group '%s': %s for eligible "
                 "all-reduce/all-gather; PYNCCL for other inputs, reduce-scatter "
                 "and variable collectives. No backend-error fallback.",
                 self.unique_name or "<unnamed>",
+                self.b12x_ar_comm.backend_name,
                 scope="global",
             )
             return
diff --git a/vllm/v1/worker/gpu_worker.py b/vllm/v1/worker/gpu_worker.py
index 3222d7ef2..59d1e6b89 100644
--- a/vllm/v1/worker/gpu_worker.py
+++ b/vllm/v1/worker/gpu_worker.py
@@ -5,6 +5,7 @@
 import contextlib
 import gc
 import os
+import sys
 import time
 from collections.abc import Callable
 from contextlib import AbstractContextManager, contextmanager, nullcontext
@@ -1105,6 +1106,12 @@ class Worker(WorkerBase):
             mode=self.observability_config.jit_monitor_mode,
             verbose=self.observability_config.jit_monitor_verbose,
         )
+        if "sparknet.oneshot" in sys.modules:
+            # sparknet prepared its kernels before capture; one compiling now
+            # would stall a step, so it raises instead.
+            sys.modules["sparknet.oneshot"].freeze_kernel_resolution(
+                "vLLM warm-up is complete"
+            )
 
         # Freeze the worker heap so the GC won't scan static objects
         # (model weights, KV caches, CUDA graphs) during inference.
-- 
