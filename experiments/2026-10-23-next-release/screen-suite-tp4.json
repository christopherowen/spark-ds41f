{
 "name": "next-release-screen-tp4",
 "version": 1,
 "description": "spark-ds41f-1022's trimmed TP4 promotion suite (model at 16 streams, grid up to 16 requests, closed loops at 16 and 1, 32K and 131K prefill), one cold 1,000,000-token prefill (the long end of the CED skip), and the sampled suite's sixteen streams (temperature 1, top_p 1, seed 0; 30 s warm-up, 180 s), where the block-verification draw refresh changes the text by design. The grid needs the dev-mode collective RPC.",
 "steps": [
  {
   "id": "model",
   "command": "model",
   "args": {
    "limit": 64,
    "concurrency": 16,
    "max_tokens": 256,
    "top": 20
   }
  },
  {
   "id": "grid",
   "command": "engine",
   "args": {
    "replays": 100,
    "settle": 1,
    "max_requests": 16
   }
  },
  {
   "id": "c16",
   "command": "run",
   "args": {
    "mode": "closed",
    "concurrency": 16,
    "warmup": 30,
    "duration": 180,
    "extra_body": {
     "chat_template_kwargs": {
      "thinking": false
     }
    }
   }
  },
  {
   "id": "c1",
   "command": "run",
   "args": {
    "mode": "closed",
    "concurrency": 1,
    "warmup": 30,
    "duration": 180,
    "extra_body": {
     "chat_template_kwargs": {
      "thinking": false
     }
    }
   }
  },
  {
   "id": "prefill",
   "command": "prefill",
   "args": {
    "sizes": [
     32768,
     131072
    ],
    "repeats": 3
   }
  },
  {
   "id": "prefill-1m",
   "command": "prefill",
   "args": {
    "sizes": [
     1000000
    ],
    "repeats": 1
   }
  },
  {
   "id": "sampled-c16",
   "command": "run",
   "args": {
    "mode": "closed",
    "concurrency": 16,
    "warmup": 30,
    "duration": 180,
    "extra_body": {
     "temperature": 1.0,
     "top_p": 1.0,
     "seed": 0,
     "chat_template_kwargs": {
      "thinking": false
     }
    }
   }
  }
 ]
}
