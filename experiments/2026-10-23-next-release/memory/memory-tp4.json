{
 "experiment": "experiments/2026-10-23-next-release/memory",
 "run": "next-memory-tp4",
 "jobs": [
  {
   "kind": "sync"
  },
  {
   "kind": "measure",
   "bench": false,
   "bracket": false,
   "telemetry": false,
   "extras": [
    [
     "soak.py",
     [
      "--minutes",
      "75"
     ],
     "soak"
    ],
    [
     "collect.py",
     [
      "--out",
      "results/private/lab/next-memory/{run}",
      "--label",
      "{label}",
      "--wait",
      "0",
      "--trace",
      "cache/next-memory/{label}"
     ],
     "collect"
    ]
   ],
   "arms": [
    {
     "config": "soak-tp4.json",
     "label": "soak"
    },
    {
     "config": "soak-malloc-tp4.json",
     "label": "soak-malloc"
    }
   ]
  }
 ]
}
