{
  "description": "Release tests (next-2): the manifest's vLLM test files in the image, chunked with timeouts; per-test outcomes under /c/release-tests.",
  "image": "spark-ds41f:19f2c20ed4d6-next-2",
  "env": {
    "HF_HUB_OFFLINE": "1",
    "PYTHONPATH": "/b",
    "TILELANG_CACHE_DIR": "/c/tilelang-release-tests",
    "ENGRAM_ROWS_TEST_DIR": "/c/engram-rows-test"
  },
  "workdir": "vllm",
  "io_uring": true,
  "argv": [
    "/b/release_test_runner.py",
    "/b/manifest.json",
    "/c/release-tests/next-2"
  ],
  "verdict": "exit",
  "mounts": [
    [
      "manifest.json",
      "/b/manifest.json"
    ],
    [
      "release_test_runner.py",
      "/b/release_test_runner.py"
    ],
    [
      "tblib_stub.py",
      "/b/tblib_stub.py"
    ],
    [
      "offline_skip.py",
      "/b/offline_skip.py"
    ]
  ]
}
