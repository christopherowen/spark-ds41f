    "max_requests": 16
   }
  },
  {
   "id": "c16",
   "command": "run",
   "args": {
    "mode": "closed",
    "concurrency": 16,
    "warmup": 30,
    "duration": 180,
    "extra_body": {
     "chat_template_kwargs": {
      "thinking": false
     }
    }
   }
  },
  {
   "id": "c1",
   "command": "run",
   "args": {
    "mode": "closed",
    "concurrency": 1,
    "warmup": 30,
    "duration": 180,
    "extra_body": {
     "chat_template_kwargs": {
      "thinking": false
     }
    }
   }
  },
  {
   "id": "prefill",
   "command": "prefill",
   "args": {
    "sizes": [
     32768,
     131072
    ],
    "repeats": 3
   }
  }
 ]
}
