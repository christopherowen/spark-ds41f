{
  "name": "verification-budget-screen-tp3",
  "version": 1,
  "description": "Policy-only causal screen on an unreleased C40 image. Fixed native TP3 eight active slots; c16 means sixteen distinct clients, including queueing. Same model prompts and timed workload per arm. Not full qualification.",
  "steps": [
    {"id":"model","command":"model","args":{"limit":128,"concurrency":8,"max_tokens":256,"top":20}},
    {"id":"c1","command":"run","args":{"mode":"closed","concurrency":1,"warmup":60,"duration":300,"extra_body":{"chat_template_kwargs":{"thinking":false}}}},
    {"id":"c4","command":"run","args":{"mode":"closed","concurrency":4,"warmup":60,"duration":300,"extra_body":{"chat_template_kwargs":{"thinking":false}}}},
    {"id":"c8","command":"run","args":{"mode":"closed","concurrency":8,"warmup":60,"duration":300,"extra_body":{"chat_template_kwargs":{"thinking":false}}}},
    {"id":"c16","command":"run","args":{"mode":"closed","concurrency":16,"warmup":60,"duration":300,"extra_body":{"chat_template_kwargs":{"thinking":false}}}}
  ]
}
