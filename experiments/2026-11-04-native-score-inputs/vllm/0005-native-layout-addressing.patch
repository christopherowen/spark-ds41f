 .../test_gpu_tilelang_logprob_softmax.py      | 37 +++++++++-----
 vllm/v1/worker/gpu/sample/tilelang_logprob.py | 49 ++++++++++---------
 2 files changed, 53 insertions(+), 33 deletions(-)

diff --git a/tests/v1/worker/test_gpu_tilelang_logprob_softmax.py b/tests/v1/worker/test_gpu_tilelang_logprob_softmax.py
