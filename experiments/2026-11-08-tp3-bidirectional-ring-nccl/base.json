{
  "notes": "Control arm: legacy 8-channel 1 MiB unidirectional NCCL profile on spark-ds41f:1107 (tp3-triangle before the 6-channel bidirectional 8 MiB Ring promotion).",
  "extends": {
    "config": "config/cluster.json",
    "shape": "tp3-triangle"
  },
  "set": {
    "deployment": {
      "launch_enabled": false
    },
    "environment": {
      "NCCL_BUFFSIZE": "1048576",
      "NCCL_MAX_NCHANNELS": "8"
    }
  },
  "unset": [
    "environment.NCCL_ALGO",
    "environment.NCCL_MIN_NCHANNELS",
    "environment.NCCL_P2P_NET_CHUNKSIZE",
    "environment.NCCL_SWITCHLESS_BIDIRECTIONAL",
    "environment.NCCL_MIN_TRAFFIC_PER_CHANNEL",
    "environment.NCCL_THREAD_THRESHOLDS"
  ]
}
