{
  "notes": "tp3-triangle balanced 6-channel bidirectional 8 MiB NCCL Ring profile on spark-ds41f:1107 (effective P2P chunksize 512 KiB via NCCL_P2P_NET_CHUNKSIZE=262144 x2 on GB10 SM121).",
  "extends": {
    "config": "config/cluster.json",
    "shape": "tp3-triangle"
  },
  "set": {
    "deployment": {
      "launch_enabled": false
    },
    "environment": {
      "NCCL_ALGO": "Ring",
      "NCCL_MIN_NCHANNELS": "6",
      "NCCL_MAX_NCHANNELS": "6",
      "NCCL_BUFFSIZE": "8388608",
      "NCCL_P2P_NET_CHUNKSIZE": "262144",
      "NCCL_SWITCHLESS_BIDIRECTIONAL": "1",
      "NCCL_MIN_TRAFFIC_PER_CHANNEL": "512",
      "NCCL_THREAD_THRESHOLDS": "-2 -2 -2 1 1 1"
    }
  }
}
