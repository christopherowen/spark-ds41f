+@pytest.mark.parametrize("rows", [1, 6, 17, 64])
+def test_mxfp8_gemm_rope_mxfp4_decode_matches_separate_gemm_and_quantize(rows):
+    """Fused ``mxfp8_gemm_rope_mxfp4_decode`` produces bit-identical MXFP4 ``q`` and
+    ``scales`` to running ``mxfp8_gemm_decode`` followed by ``quantize_mxfp4`` with
+    RoPE."""
+    from vllm.models.deepseek_v4_1.tilelang.gemm import (
+        decode_tile_rows,
+        fp8_decode_config,
+        mxfp8_gemm_decode,
+        mxfp8_gemm_rope_mxfp4_decode,
+        pack_scale_words,
+    )
+    from vllm.models.deepseek_v4_1.tilelang.linear import cast_mxfp8
+
+    gen = _gen(200 + rows)
+    n, k = INDEX_HEADS * INDEX_DIM, 1280
+    x = torch.randn((rows, k), generator=gen, device=DEVICE, dtype=torch.bfloat16)
+    cast_rows = cast_mxfp8(x)
+    weight = torch.randn((n, k), generator=gen, device=DEVICE).to(torch.float8_e4m3fn)
+    weight_sf = torch.randint(
+        120, 132, (n // 32, k // 32), generator=gen, device=DEVICE, dtype=torch.uint8
+    )
+    packed_sfb = pack_scale_words(weight_sf)
+    positions = torch.randint(
+        0, 512, (rows,), generator=gen, device=DEVICE, dtype=torch.int64
+    )
+    table = rope_table(512)
+
+    block_M = decode_tile_rows(rows)
+    cfg = fp8_decode_config(n, k, block_M)
+    gemm_sep = mxfp8_gemm_decode(n, k, **cfg, padded_rows=True)
+    gemm_fused = mxfp8_gemm_rope_mxfp4_decode(
+        n, k, **cfg, padded_rows=True, head_dim=INDEX_DIM, rope_dim=64
+    )
+
+    iq = torch.empty((rows, n), dtype=torch.bfloat16, device=DEVICE)
+    gemm_sep(
+        cast_rows.values,
+        weight,
+        cast_rows.scales.view(torch.uint32),
+        packed_sfb,
+        iq,
+    )
+    ref_q = torch.empty((rows, INDEX_HEADS, 64), dtype=torch.uint8, device=DEVICE)
+    ref_s = torch.empty((rows, INDEX_HEADS, 4), dtype=torch.uint8, device=DEVICE)
+    quantize_mxfp4(
+        iq.view(rows, INDEX_HEADS, INDEX_DIM),
+        ref_q,
+        ref_s,
+        positions=positions,
+        cos_sin=table,
+    )
+
+    q_out = torch.empty_like(ref_q)
+    s_out = torch.empty_like(ref_s)
+    gemm_fused(
+        cast_rows.values,
+        weight,
+        cast_rows.scales.view(torch.uint32),
+        packed_sfb,
+        positions,
+        table,
+        q_out.view(rows, n // 2),
+        s_out.view(rows, n // 32),
+    )
+    assert torch.equal(s_out, ref_s)
+    assert torch.equal(q_out, ref_q)
+
