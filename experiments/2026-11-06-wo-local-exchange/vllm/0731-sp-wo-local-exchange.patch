+@pytest.mark.parametrize("world_size", [1, 3, 4])
+def test_sp_wo_rank_groups_and_declaration_binds_peer_shards(monkeypatch, world_size):
+    """Encoder attention layers record every TP rank's trimmed WO group count,
+    declare all distinct peer WO-B prefill GEMM widths before cache freeze, bind
+    trimmed peer WO-B shards while reusing this rank's own shard in place, and
+    leave CED decoder / draft layers on their single local shard."""
+    from torch import nn
+
+    from vllm.models.deepseek_v4_1 import attention
+    from vllm.models.deepseek_v4_1.tilelang import prepare
+    from vllm.models.deepseek_v4_1.tilelang import wo as tl_wo
+
+    monkeypatch.setattr(
+        attention, "get_tensor_model_parallel_world_size", lambda: world_size
+    )
+    orig_groups = 8
+    padded_groups = 9 if world_size == 3 else orig_groups
+    per_rank_padded = padded_groups // world_size
+
+    def make_layer(rank: int, *, is_ced_decoder: bool = False, is_draft: bool = False):
+        module = _tilelang_layer(layer_id=20 if is_ced_decoder else 0)
+        module.config.model_config = SimpleNamespace(
+            hf_config=SimpleNamespace(
+                original_o_groups=orig_groups, o_groups=padded_groups
+            )
+        )
+        module.is_ced_decoder = is_ced_decoder
+        module.is_draft = is_draft
+        module.n_groups = padded_groups
+        module.n_local_groups = per_rank_padded
+        module.n_local_heads = per_rank_padded * 8
+        module.head_dim = 64
+        module.o_lora_rank = 128
+        module.hidden_size = 256
+        module.attn_sink = nn.Parameter(
+            torch.arange(module.n_local_heads, dtype=torch.float32),
+            requires_grad=False,
+        )
+        module.wq_b = nn.Module()
+        module.wq_b.weight = nn.Parameter(
+            torch.zeros((module.n_local_heads * 64, 128), dtype=torch.float8_e4m3fn),
+            requires_grad=False,
+        )
+        module.wq_b.weight_scale_inv = nn.Parameter(
+            torch.ones(
+                (module.n_local_heads * 64 // 32, 128 // 32), dtype=torch.uint8
+            ),
+            requires_grad=False,
+        )
+        w_a = torch.full(
+            (per_rank_padded * 128, 8 * 64), rank + 1, dtype=torch.uint8
+        ).view(torch.float8_e4m3fn)
+        s_a = torch.full(
+            (per_rank_padded * 128 // 32, 8 * 64 // 32),
+            120 + rank,
+            dtype=torch.uint8,
+        )
+        w_b = torch.full(
+            (256, per_rank_padded * 128), 10 + rank, dtype=torch.uint8
+        ).view(torch.float8_e4m3fn)
+        s_b = torch.full(
+            (256 // 32, per_rank_padded * 128 // 32),
+            124 + rank,
+            dtype=torch.uint8,
+        )
+        module.wo_a = nn.Module()
+        module.wo_a.weight = nn.Parameter(w_a, requires_grad=False)
+        module.wo_a.weight_scale_inv = nn.Parameter(s_a, requires_grad=False)
+        module.wo_b = nn.Module()
+        module.wo_b.weight = nn.Parameter(w_b, requires_grad=False)
+        module.wo_b.weight_scale_inv = nn.Parameter(s_b, requires_grad=False)
+        return module
+
+    for flag in ("is_ced_decoder", "is_draft"):
+        monkeypatch.setattr(attention, "get_tensor_model_parallel_rank", lambda: 0)
+        non_sp = make_layer(0, **{flag: True})
+        non_sp.setup_wo_projection()
+        assert non_sp._wo_projection_weights.sp_rank_groups == ()
+        assert non_sp._wo_projection_weights.sp_shards is None
+
+    expected_groups = (
+        ()
+        if world_size == 1
+        else ((3, 3, 2) if world_size == 3 else (2, 2, 2, 2))
+    )
+    layers = []
+    declared_by_rank = []
+    for rank in range(world_size):
+        monkeypatch.setattr(attention, "get_tensor_model_parallel_rank", lambda r=rank: r)
+        layer = make_layer(rank)
+        layer.setup_wo_projection()
+        proj = layer._wo_projection_weights
+        assert proj.sp_rank_groups == expected_groups
+        regs = []
+        monkeypatch.setattr(
+            prepare,
+            "declare",
+            lambda calls=None, bind=None, warm=None, regs=regs: regs.append(
+                (calls, bind)
+            ),
+        )
+        proj.declare_kernels()
+        layers.append(layer)
+        declared_by_rank.append(regs)
+
+    if world_size == 1:
+        assert len(declared_by_rank[0]) == 2
+        return
+
+    monkeypatch.setattr(
+        prepare,
+        "launch",
+        lambda entry: ("launched", getattr(entry[0], "__name__", type(entry[0]).__name__), entry[1], entry[2]),
+    )
+    max_cols = max(expected_groups) * 128
+    max_sf_words = max_cols // 128
+    padded_weights = []
+    padded_sfs = []
+    for rank, layer in enumerate(layers):
+        b = layer._wo_projection_weights.b
+        w = torch.zeros((256, max_cols), dtype=b.weight.dtype)
+        w[:, : b.weight.shape[1]].copy_(b.weight)
+        sf = torch.zeros((256 // 32, max_sf_words), dtype=b.tilelang_weight_sf.dtype)
+        sf[:, : b.tilelang_weight_sf.shape[1]].copy_(b.tilelang_weight_sf)
+        padded_weights.append(w)
+        padded_sfs.append(sf)
+    all_w = torch.cat(padded_weights, dim=0)
+    all_sf = torch.cat(padded_sfs, dim=0)
+
+    def fake_all_gather(tensor, dim=0):
+        assert dim == 0
+        if tensor.dtype == torch.uint32:
+            return all_sf.clone()
+        return all_w.clone()
+
+    monkeypatch.setattr(tl_wo, "tensor_model_parallel_all_gather", fake_all_gather)
+
+    expected_cols = {g * 128 for g in expected_groups}
+    for rank, (layer, regs) in enumerate(zip(layers, declared_by_rank)):
+        assert len(regs) == 3
+        extra_calls = list(regs[2][0]())
+        gemm_cols = {
+            call[1][1]
+            for call in extra_calls
+            if call[0] is tl_wo.mxfp8_gemm
+        }
+        assert gemm_cols == expected_cols
+        monkeypatch.setattr(
+            tl_wo, "get_tensor_model_parallel_rank", lambda r=rank: r
+        )
+        for _, bind in regs:
+            if bind is not None:
+                bind()
+        proj = layer._wo_projection_weights
+        assert proj.sp_shards is not None and len(proj.sp_shards) == world_size
+        assert proj.sp_shards[rank] is proj.b
+        for peer, g in enumerate(expected_groups):
+            shard = proj.sp_shards[peer]
+            assert shard.weight.shape == (256, g * 128)
+            assert shard.tilelang_weight_sf.shape == (256 // 32, g * 128 // 128)
+            assert torch.equal(
+                shard.weight.view(torch.uint8),
+                layers[peer]._wo_projection_weights.b.weight.view(torch.uint8),
+            )
+            assert torch.equal(
+                shard.tilelang_weight_sf,
+                layers[peer]._wo_projection_weights.b.tilelang_weight_sf,
+            )
+
+
+@pytest.mark.parametrize("world_size", [3, 4])
+@pytest.mark.parametrize("tokens", [10, 12, 205])
+@pytest.mark.parametrize("unreduced", [True, False])
+@pytest.mark.parametrize("nonfinite", [False, True])
+def test_sp_wo_local_exchange_matches_full_row_parts_and_rank_order_sum(
+    monkeypatch, world_size, tokens, unreduced, nonfinite
+):
+    """Exchanging WO-A's native MXFP8 ``(xq, sf)`` output and running each rank's
+    WO-B shard on local rows reproduces every rank slot of ``parts`` and its
+    rank-order sum bit-for-bit across finite, signed-zero, and non-finite inputs,
+    while running WO-A once per rank and zeroing pad rows only through
+    ``columns.zero_``."""
+    from torch import nn
+
+    from vllm.models.deepseek_v4_1 import attention, l2_prefetch, sp_prefill
+    from vllm.models.deepseek_v4_1.tilelang import collectives, columns
+    from vllm.models.deepseek_v4_1.tilelang import wo as tl_wo
+
+    groups_by_rank = (3, 3, 2) if world_size == 3 else (2, 2, 2, 2)
+    rank_width = 512
+    head_dim = 64
+    hidden = 1280
+
+    zero_calls = []
+
+    def cpu_zero_(out: torch.Tensor) -> torch.Tensor:
+        nbytes = out.numel() * out.element_size()
+        assert out.is_contiguous() and nbytes % 16 == 0
+        zero_calls.append(tuple(out.shape))
+        out.view(torch.uint8).fill_(0)
+        return out
+
+    monkeypatch.setattr(columns, "zero_", cpu_zero_)
+
+    def refuse_torch_zero(self, *args, **kwargs):
+        raise AssertionError("a pad row was zeroed by torch.Tensor.zero_")
+
+    monkeypatch.setattr(torch.Tensor, "zero_", refuse_torch_zero)
+
+    gen = torch.Generator().manual_seed(4100 + world_size * 100 + tokens)
+    layers = []
+    inputs = []
+    wo_a_calls = {r: [] for r in range(world_size)}
+
+    def run_wo_b_ref(xq, weight, sf_u32, weight_sf, out):
+        # Exact block-32 FP32 accumulation per rank shard, rounded once to BF16.
+        m = out.shape[0]
+        k = xq.shape[1]
+        xq = xq[:m]
+        n = weight.shape[0]
+        sf_a = sf_u32.view(torch.uint8)[:m, : k // 32]
+        sf_b = weight_sf.view(torch.uint8)[:, : k // 32]
+        scale_a = torch.ldexp(
+            torch.ones((m, k // 32), dtype=torch.float32),
+            sf_a.to(torch.int32) - 127,
+        ).repeat_interleave(32, dim=1)
+        scale_b = (
+            torch.ldexp(
+                torch.ones((n // 32, k // 32), dtype=torch.float32),
+                sf_b.to(torch.int32) - 127,
+            )
+            .repeat_interleave(32, dim=0)
+            .repeat_interleave(32, dim=1)
+        )
+        a_fp32 = xq.to(torch.float32) * scale_a
+        b_fp32 = weight.to(torch.float32) * scale_b
+        acc = torch.zeros((m, n), dtype=torch.float32)
+        for k0 in range(0, k, 128):
+            acc = acc + a_fp32[:, k0 : k0 + 128] @ b_fp32[:, k0 : k0 + 128].T
+        out.copy_(acc.to(torch.bfloat16))
+
+    for rank, groups in enumerate(groups_by_rank):
+        cols = groups * rank_width
+        heads = groups * 8
+        layer = _tilelang_layer(layer_id=0)
+        layer.hidden_size = hidden
+        layer._l2pf_ffn = f"ffn_{rank}"
+        wo_a = nn.Module()
+        wo_a.weight = nn.Parameter(
+            torch.randint(
+                0, 120, (cols, 8 * head_dim), generator=gen, dtype=torch.uint8
+            ).view(torch.float8_e4m3fn),
+            requires_grad=False,
+        )
+        wo_a.weight_scale_inv = nn.Parameter(
+            torch.randint(
+                125,
+                129,
+                (cols // 32, 8 * head_dim // 32),
+                generator=gen,
+                dtype=torch.uint8,
+            ),
+            requires_grad=False,
+        )
+        wo_b = nn.Module()
+        wo_b.weight = nn.Parameter(
+            torch.randint(
+                0, 120, (hidden, cols), generator=gen, dtype=torch.uint8
+            ).view(torch.float8_e4m3fn),
+            requires_grad=False,
+        )
+        wo_b.weight_scale_inv = nn.Parameter(
+            torch.randint(
+                125,
+                129,
+                (hidden // 32, cols // 32),
+                generator=gen,
+                dtype=torch.uint8,
+            ),
+            requires_grad=False,
+        )
+        proj = tl_wo.TileLangWOProjection(wo_a, wo_b, groups=groups)
+        proj.enable_sp(groups_by_rank)
+        proj.b.tilelang_decode_rows = 128
+        proj.b.tilelang_prefill = run_wo_b_ref
+        proj.b.tilelang_decode = {16: run_wo_b_ref, 32: run_wo_b_ref, 64: run_wo_b_ref, 96: run_wo_b_ref}
+        proj.b.tilelang_wide = {96: 96}
+
+        def make_a_call(r, cols_r):
+            def a_call(x, xq, sf, partials=None):
+                m = x.shape[0]
+                wo_a_calls[r].append(m)
+                vals = x[:, :cols_r].to(torch.float8_e4m3fn)
+                xq.copy_(vals)
+                sf.fill_(127 + (r % 2))
+
+            return a_call
+
+        a_fn = make_a_call(rank, cols)
+
+        class _FakeA:
+            columns = cols
+            partial_specs = staticmethod(lambda rows: ())
+
+            def __call__(self, x, xq, sf, partials=None, _fn=a_fn):
+                return _fn(x, xq, sf, partials)
+
+        proj.a = _FakeA()
+        layer._wo_projection_weights = proj
+        layers.append(layer)
+
+        o_r = (torch.randn((tokens, heads, head_dim), generator=gen) * 0.5).bfloat16()
+        o_r[0, 0, 0] = -0.0
+        if nonfinite:
+            o_r[1, 0, 0] = float("nan")
+            o_r[2, 0, 1] = float("inf")
+            o_r[3, 0, 2] = -float("inf")
+        inputs.append(o_r)
+
+    for rank, layer in enumerate(layers):
+        proj = layer._wo_projection_weights
+        proj.sp_shards = tuple(
+            proj.b
+            if peer == rank
+            else tl_wo._PeerWeight(
+                layers[peer]._wo_projection_weights.b.weight.clone(),
+                layers[peer]._wo_projection_weights.b.tilelang_weight_sf.clone(),
+                run_wo_b_ref,
+            )
+            for peer in range(world_size)
+        )
+
+    ws = torch.empty(16 * 1024 * 1024, dtype=torch.uint8)
+    monkeypatch.setattr(tl_wo, "current_preallocated_workspace", lambda: ws)
+
+    # Full-row reference on each rank before collective exchange / reduction.
+    padded_rows = sp_prefill.SPRows(tokens, world_size, 0).padded_rows
+    local_rows = padded_rows // world_size
+    full_rank_outputs = []
+    for rank, layer in enumerate(layers):
+        padded = torch.zeros((padded_rows, hidden), dtype=torch.bfloat16)
+        layer._wo_projection_weights(inputs[rank], padded[:tokens])
+        full_rank_outputs.append(padded.view(world_size, local_rows, hidden))
+    for r in wo_a_calls:
+        wo_a_calls[r].clear()
+
+    # Simulate the two-step collective exchange (xq and sf) across all ranks.
+    sent_xq = {}
+    sent_sf = {}
+    for rank, layer in enumerate(layers):
+        proj = layer._wo_projection_weights
+        cols_r = proj.a.columns
+        sf_bytes_r = cols_r // 32
+        xq_s = torch.empty((world_size, local_rows, cols_r), dtype=torch.float8_e4m3fn)
+        sf_s = torch.empty((world_size, local_rows, sf_bytes_r), dtype=torch.uint8)
+        proj.a(
+            inputs[rank].view(tokens, -1),
+            xq_s.view(padded_rows, cols_r)[:tokens],
+            sf_s.view(padded_rows, sf_bytes_r)[:tokens],
+            None,
+        )
+        if tokens < padded_rows:
+            cpu_zero_(xq_s.view(padded_rows, cols_r)[tokens:])
+            cpu_zero_(sf_s.view(padded_rows, sf_bytes_r)[tokens:])
+        sent_xq[rank] = xq_s
+        sent_sf[rank] = sf_s
+    for r in wo_a_calls:
+        wo_a_calls[r].clear()
+    zero_calls.clear()
+
+    exchanged_bytes = {r: 0 for r in range(world_size)}
+
+    def fake_exchange_into(self, send, recv):
+        r = self.rank
+        src_table = sent_xq if send.dtype == torch.float8_e4m3fn else sent_sf
+        for peer in range(self.world_size):
+            if peer != r:
+                exchanged_bytes[r] += send[peer].numel() * send.element_size()
+                recv[peer].copy_(src_table[peer][r])
+
+    monkeypatch.setattr(sp_prefill.SPRows, "exchange_into", fake_exchange_into)
+    prefetched = []
+    monkeypatch.setattr(
+        l2_prefetch, "issue", lambda plan, rows: prefetched.append((plan, rows))
+    )
+
+    for rank, layer in enumerate(layers):
+        sp = sp_prefill.SPRows(tokens, world_size, rank, unreduced=unreduced)
+        actual = layer._o_proj(inputs[rank], sp_rows=sp)
+        expected_parts = torch.stack(
+            [full_rank_outputs[peer][rank] for peer in range(world_size)], dim=0
+        )
+        assert wo_a_calls[rank] == [tokens]
+        cols_r = groups_by_rank[rank] * rank_width
+        expected_wire = (world_size - 1) * local_rows * (cols_r + cols_r // 32)
+        assert exchanged_bytes[rank] == expected_wire
+        baseline_wire = (world_size - 1) * local_rows * hidden * 2
+        assert exchanged_bytes[rank] < baseline_wire
+        if unreduced:
+            assert actual.shape == (world_size, local_rows, hidden)
+            assert torch.equal(
+                actual.view(torch.int16), expected_parts.view(torch.int16)
+            )
+            summed = collectives.RankOrderParts(actual).sum()
+            expected_sum = collectives.RankOrderParts(expected_parts).sum()
+            assert torch.equal(
+                summed.view(torch.int16), expected_sum.view(torch.int16)
+            )
+        else:
+            expected_sum = collectives.rank_order_sum(list(expected_parts.unbind(0)))
+            assert actual.shape == (local_rows, hidden)
+            assert torch.equal(
+                actual.view(torch.int16), expected_sum.view(torch.int16)
+            )
+    assert prefetched == [(f"ffn_{r}", tokens) for r in range(world_size)]
+
+
+@pytest.mark.parametrize("world_size", [3, 4])
+def test_sp_wo_local_exchange_matches_native_tilelang_kernels_on_sm12x(monkeypatch, world_size):
+    if not torch.cuda.is_available() or torch.cuda.get_device_capability()[0] != 12:
+        pytest.skip("DeepSeek-V4.1 TileLang WO kernels require SM12x")
+    pytest.importorskip("tilelang")
+    from torch import nn
+
+    from vllm.models.deepseek_v4_1 import sp_prefill
+    from vllm.models.deepseek_v4_1.tilelang import collectives
+    from vllm.models.deepseek_v4_1.tilelang import wo as tl_wo
+
+    groups_by_rank = (3, 3, 2) if world_size == 3 else (2, 2, 2, 2)
+    rank_width = 1024
+    head_dim = 512
+    hidden = 5120
+    gen = torch.Generator(device="cuda").manual_seed(4200 + world_size)
+
+    projections = []
+    for rank, groups in enumerate(groups_by_rank):
+        cols = groups * rank_width
+        wo_a = nn.Module()
+        wo_a.weight = nn.Parameter(
+            torch.randint(
+                0, 120, (cols, 8 * head_dim), generator=gen, device="cuda", dtype=torch.uint8
+            ).view(torch.float8_e4m3fn),
+            requires_grad=False,
+        )
+        wo_a.weight_scale_inv = nn.Parameter(
+            torch.randint(
+                118,
+                124,
+                (cols // 32, 8 * head_dim // 32),
+                generator=gen,
+                device="cuda",
+                dtype=torch.uint8,
+            ),
+            requires_grad=False,
+        )
+        wo_b = nn.Module()
+        wo_b.weight = nn.Parameter(
+            torch.randint(
+                0, 120, (hidden, cols), generator=gen, device="cuda", dtype=torch.uint8
+            ).view(torch.float8_e4m3fn),
+            requires_grad=False,
+        )
+        wo_b.weight_scale_inv = nn.Parameter(
+            torch.randint(
+                118,
+                124,
+                (hidden // 32, cols // 32),
+                generator=gen,
+                device="cuda",
+                dtype=torch.uint8,
+            ),
+            requires_grad=False,
+        )
+        proj = tl_wo.TileLangWOProjection(wo_a, wo_b, groups=groups)
+        proj.enable_sp(groups_by_rank)
+        proj.a.kernels = {
+            b: c[0](*c[1], **c[2]) for b, c in proj.a._kernels()["kernels"].items()
+        }
+        r_call = proj.a._kernels()["reduce"]
+        proj.a.reduce = r_call[0](*r_call[1], **r_call[2])
+        p_calls = {
+            c: call[0](*call[1], **call[2])
+            for c, call in proj._sp_prefill_calls().items()
+        }
