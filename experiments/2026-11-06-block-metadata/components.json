{
  "experiment": "experiments/2026-11-06-block-metadata",
  "run": "block-metadata-components",
  "controller": "experiments/2026-11-06-block-metadata/bundle/run.py",
  "node": "dgx1",
  "resources": {
    "cpus": "2",
    "memory": "16g",
    "memory_swap": "16g",
    "pids_limit": 512,
    "thread_limits": {
      "CMAKE_BUILD_PARALLEL_LEVEL": 2,
      "MAX_JOBS": 2,
      "MKL_NUM_THREADS": 1,
      "NUMEXPR_MAX_THREADS": 1,
      "OMP_NUM_THREADS": 2,
      "OPENBLAS_NUM_THREADS": 1,
      "TORCHINDUCTOR_COMPILE_THREADS": 2,
      "TVM_NUM_THREADS": 2
    }
  },
  "jobs": [
    {
      "kind": "kernel",
      "bundles": [
        {
          "node": "dgx1",
          "bundle": "experiments/2026-11-06-block-metadata/bundle"
        }
      ]
    }
  ]
}
