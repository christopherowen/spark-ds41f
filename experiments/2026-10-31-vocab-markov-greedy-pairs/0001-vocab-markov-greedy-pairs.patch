+def project_head_markov_greedy_pairs(
+    layer: nn.Module,
+    x: torch.Tensor,
+    base_logits: torch.Tensor,
+    vocab: int | None = None,
+    vocab_start: int = 0,
+    pair_width: int = 4,
+    out: torch.Tensor | None = None,
