+    """Each row's ``(max, global index)`` pair of ``base_logits + x @ W^T``
+    through a prepared BF16 Markov head over its ``vocab`` real columns starting
+    at ``vocab_start``, written into the first two columns of ``[rows, pair_width]``
+    FP32 without materializing the Markov bias tensor."""
+    x = x.contiguous()
+    rows = x.shape[0]
+    n = int(layer.weight.shape[0])
+    if vocab is None:
+        vocab = n
+    partials_kernel, finish_kernel, num_tiles = layer.tilelang_vocab_markov_greedy[
+        row_tile(rows)
+    ]
+    partial_vals = torch.empty((rows, num_tiles), dtype=torch.float32, device=x.device)
+    partial_idxs = torch.empty((rows, num_tiles), dtype=torch.int32, device=x.device)
+    pairs = (
+        out
+        if out is not None
+        else torch.empty((rows, pair_width), dtype=torch.float32, device=x.device)
+    )
+    partials_kernel(
+        x,
+        layer.weight,
+        base_logits,
+        partial_vals,
+        partial_idxs,
+        vocab,
+    )
+    finish_kernel(partial_vals, partial_idxs, pairs, vocab_start)
+    return pairs
