{
 "experiment": "experiments/2026-11-17-indexer-decode-share",
 "run": "indexer-decode-share-real-rows-again-tp4-switched",
 "jobs": [
  {
   "kind": "sync"
  },
  {
   "kind": "profile",
   "workloads": [
    "decode"
   ],
   "workload_args": {
    "decode": [
     "--depths",
     "4096,262144,1000000",
     "--tokens",
     "192",
     "--replays",
     "30",
     "--real-rows"
    ]
   },
   "arms": [
    {
     "config": "experiments/2026-11-16-c61-decode/tp4-switched-grid-prof.json",
     "label": "c61-grid-again"
    }
   ]
  },
  {
   "kind": "measure",
   "bench": false,
   "bracket": false,
   "telemetry": true,
   "arms": [
    {
     "config": "experiments/2026-11-16-c61-decode/tp4-switched-grid-dev.json",
     "label": "c61-grid-dev"
    }
   ],
   "extras": [
    [
     "scripts/servebench_engine.py",
     [
      "--real-rows",
      "--replays",
      "30",
      "--label",
      "{label}",
      "--output",
      "results/private/determinism/{run}/{label}-real-grid.json"
     ],
     "real-grid"
    ]
   ]
  }
 ]
}
