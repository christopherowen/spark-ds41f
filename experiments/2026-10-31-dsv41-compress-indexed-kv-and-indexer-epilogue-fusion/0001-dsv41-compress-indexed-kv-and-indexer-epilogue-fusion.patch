--- a/tests/kernels/attention/test_deepseek_v41_tilelang.py
+++ b/tests/kernels/attention/test_deepseek_v41_tilelang.py
@@ -304,6 +304,114 @@ def test_norm_rope_write_index_keys(ratio, slot_dtype, page_size=64, pages=5):
     assert bool((pool._base[:, [0, 2]] == 0xAB).all())
 
 
+@pytest.mark.parametrize("ratio", [1, 2])
+@pytest.mark.parametrize("slot_dtype", [torch.int64, torch.int32])
+def test_norm_rope_write_index_keys_fuses_splitk_shards(
+    ratio, slot_dtype, page_size=64, pages=3
+):
+    """Passing ``[4, rows, 128]`` FP32 split-K partials to
+    ``norm_rope_write_index_keys`` reduces the 4 shards in registers in shard order
+    and writes the exact same paged MXFP4 records as ``splitk_reduce`` followed by
+    2D ``norm_rope_write_index_keys``."""
+    n = 37
+    gen = _gen(19 + ratio)
+    partials = torch.randn(
+        (4, n, INDEX_DIM), generator=gen, device=DEVICE, dtype=torch.float32
+    )
+    reduced = (partials[0] + partials[1] + partials[2] + partials[3]).to(
+        torch.bfloat16
+    )
+    weight = torch.randn((INDEX_DIM,), generator=gen, device=DEVICE).bfloat16()
+    eps = 1e-6
+    positions = torch.randint(
+        0, 512, (n,), generator=gen, device=DEVICE, dtype=torch.int64
+    )
+    table = rope_table(512)
+    slots = torch.randperm(pages * page_size, generator=gen, device=DEVICE)[:n].to(
+        slot_dtype
+    )
+    slots[:2] = -1
+    pool_fused = _page_buffer(pages, page_bytes(page_size))
+    pool_sep = pool_fused.clone()
+
+    norm_rope_write_index_keys(
+        partials, weight, eps, positions, table, pool_fused, slots, page_size, ratio
+    )
+    norm_rope_write_index_keys(
+        reduced, weight, eps, positions, table, pool_sep, slots, page_size, ratio
+    )
+    assert torch.equal(pool_fused, pool_sep)
+
+
+@pytest.mark.parametrize("rows", [1, 6, 17, 64])
+def test_mxfp8_gemm_rope_mxfp4_decode_matches_separate_gemm_and_quantize(rows):
+    """Fused ``mxfp8_gemm_rope_mxfp4_decode`` produces bit-identical MXFP4 ``q`` and
+    ``scales`` to running ``mxfp8_gemm_decode`` followed by ``quantize_mxfp4`` with
+    RoPE."""
+    from vllm.models.deepseek_v4_1.tilelang.gemm import (
+        decode_tile_rows,
+        fp8_decode_config,
+        mxfp8_gemm_decode,
+        mxfp8_gemm_rope_mxfp4_decode,
+        pack_scale_words,
+    )
+    from vllm.models.deepseek_v4_1.tilelang.linear import cast_mxfp8
+
+    gen = _gen(200 + rows)
+    n, k = INDEX_HEADS * INDEX_DIM, 1280
+    x = torch.randn((rows, k), generator=gen, device=DEVICE, dtype=torch.bfloat16)
+    cast_rows = cast_mxfp8(x)
+    weight = torch.randn((n, k), generator=gen, device=DEVICE).to(torch.float8_e4m3fn)
+    weight_sf = torch.randint(
+        120, 132, (n // 32, k // 32), generator=gen, device=DEVICE, dtype=torch.uint8
+    )
+    packed_sfb = pack_scale_words(weight_sf)
+    positions = torch.randint(
+        0, 512, (rows,), generator=gen, device=DEVICE, dtype=torch.int64
+    )
+    table = rope_table(512)
+
+    block_M = decode_tile_rows(rows)
+    cfg = fp8_decode_config(n, k, block_M)
+    gemm_sep = mxfp8_gemm_decode(n, k, **cfg, padded_rows=True)
+    gemm_fused = mxfp8_gemm_rope_mxfp4_decode(
+        n, k, **cfg, padded_rows=True, head_dim=INDEX_DIM, rope_dim=64
+    )
+
+    iq = torch.empty((rows, n), dtype=torch.bfloat16, device=DEVICE)
+    gemm_sep(
+        cast_rows.values,
+        weight,
+        cast_rows.scales.view(torch.uint32),
+        packed_sfb,
+        iq,
+    )
+    ref_q = torch.empty((rows, INDEX_HEADS, 64), dtype=torch.uint8, device=DEVICE)
+    ref_s = torch.empty((rows, INDEX_HEADS, 4), dtype=torch.uint8, device=DEVICE)
+    quantize_mxfp4(
+        iq.view(rows, INDEX_HEADS, INDEX_DIM),
+        ref_q,
+        ref_s,
+        positions=positions,
+        cos_sin=table,
+    )
+
+    q_out = torch.empty_like(ref_q)
+    s_out = torch.empty_like(ref_s)
+    gemm_fused(
+        cast_rows.values,
+        weight,
+        cast_rows.scales.view(torch.uint32),
+        packed_sfb,
+        positions,
+        table,
+        q_out.view(rows, n // 2),
+        s_out.view(rows, n // 32),
+    )
+    assert torch.equal(s_out, ref_s)
+    assert torch.equal(q_out, ref_q)
+
+
 def _ref_scores(inp, page_size, extent, positions_of):
     """Staged BF16 score: BF16 dot, ReLU, BF16 weighted product, ordered head sum."""
     rows = inp["q_values"].shape[0]
