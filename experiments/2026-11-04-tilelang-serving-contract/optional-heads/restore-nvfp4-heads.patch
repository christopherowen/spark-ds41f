-        )
+        retired_options = ("VLLM_DS41_ENGRAM_OVERLAP",)
         supplied = [name for name in retired_options if name in os.environ]
         if supplied:
             raise ValueError(
diff --git a/vllm/models/deepseek_v4_1/nvidia/dspark.py b/vllm/models/deepseek_v4_1/nvidia/dspark.py
index f30e29704e..112cf63d3f 100644
--- a/vllm/models/deepseek_v4_1/nvidia/dspark.py
+++ b/vllm/models/deepseek_v4_1/nvidia/dspark.py
@@ -17,6 +17,7 @@ import regex as re
 import torch
 import torch.nn as nn
 
+from vllm import envs
 from vllm.config import VllmConfig, get_current_vllm_config
 from vllm.config.compilation import CUDAGraphMode
 from vllm.distributed import (
@@ -34,6 +35,7 @@ from vllm.model_executor.layers.logits_processor import (
     _is_packed_head,
     _is_plain_bf16_head,
 )
+from vllm.model_executor.layers.vocab_parallel_embedding import ParallelLMHead
 from vllm.model_executor.model_loader.weight_utils import default_weight_loader
 from vllm.model_executor.models.qwen3_dspark import (
     DSparkConfidenceHead,
@@ -336,20 +338,26 @@ class DSparkDeepseekV4Model(nn.Module):
         )
 
         markov_quantization = (
-            "packed_bf16"
-            if current_vllm_config.kernel_config.linear_backend == "tilelang"
-            and packed_bf16_supported(
-                config.dspark_markov_rank, torch.get_default_dtype()
+            "nvfp4"
+            if envs.VLLM_DS41_MARKOV_NVFP4
+            else (
+                "packed_bf16"
+                if current_vllm_config.kernel_config.linear_backend == "tilelang"
+                and packed_bf16_supported(
+                    config.dspark_markov_rank, torch.get_default_dtype()
+                )
+                else None
             )
-            else None
         )
         self.markov_head = DSparkMarkovHead(
             config.vocab_size,
             draft_vocab_size,
             config.dspark_markov_rank,
             prefix=maybe_prefix(prefix, "markov_head"),
-            # Pack the native BF16 transition head losslessly into 12 bits
-            # per weight (75% of BF16 bytes) on the supported TileLang path.
+            # An NVFP4 transition head fits the GB10 L2, so the sequential
+            # draft positions after the first reread it from L2. On the
+            # TileLang path without NVFP4, pack the BF16 transition head
+            # losslessly into 12 bits per weight (75% of BF16 bytes).
             lm_head_quantization=markov_quantization,
             vocab_parallel=_vocab_parallel_greedy(),
         )
@@ -569,6 +577,19 @@ class DSparkDeepseekV4ForCausalLM(nn.Module):
         # head otherwise remains on meta and cannot be natively precompiled.
         self.lm_head: nn.Module | None = None
         self.logits_processor = LogitsProcessor(self.config.vocab_size)
+        if envs.VLLM_DS41_DRAFT_NVFP4_HEAD:
+            # A drafter-owned NVFP4 vocabulary head reads half the bytes of
+            # the shared MXFP8 target head; only draft acceptance depends on it.
+            head = ParallelLMHead(
+                self.config.vocab_size,
+                self.config.hidden_size,
+                prefix=maybe_prefix(prefix, "lm_head"),
+                lm_head_quantization="nvfp4",
+            )
+            if head.runtime_lm_head_quantization == "nvfp4":
+                self.lm_head = head
+                self.has_own_lm_head = True
+                self.checkpoint_weight_name_prefixes = ("mtp.", "head.")
 
     # --- Hooks used by the speculator -------------------------------------
 
