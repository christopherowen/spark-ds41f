From 16f0b96eb81e74f2407f2686e53988b195bbc433 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Wed, 4 Nov 2026 17:35:12 +0100
Subject: [PATCH] Experiment with alternative NVFP4 DSpark heads

Base: ecbfff36289d4a131169054702cf3eac384b7a4e.
Rationale: preserve the removed Markov and drafter-owned head alternatives outside serving.
Quality: draft arithmetic and ownership change only when explicitly selected. This restoration does not restore Engram's obsolete option or the MoE fallbacks.
Tests: patch application checked; inference, acceptance, memory and performance unqualified. Create separate source identifiers and an image before testing.
Upstream status: local experiment, not submitted.
---
 .../test_deepseek_v41_serving_contract.py     | 27 +-------------
 vllm/envs.py                                  | 16 +++++++--
 vllm/model_executor/models/config.py          |  6 +---
 vllm/models/deepseek_v4_1/nvidia/dspark.py    | 35 +++++++++++++++----
 4 files changed, 44 insertions(+), 40 deletions(-)

diff --git a/tests/models/test_deepseek_v41_serving_contract.py b/tests/models/test_deepseek_v41_serving_contract.py
index 2b0de56aed..4244efcac3 100644
--- a/tests/models/test_deepseek_v41_serving_contract.py
+++ b/tests/models/test_deepseek_v41_serving_contract.py
@@ -9,11 +9,7 @@ import pytest
 from vllm import envs
 from vllm.model_executor.models.config import DeepseekV41ForCausalLMConfig
 
-RETIRED = (
-    "VLLM_DS41_ENGRAM_OVERLAP",
-    "VLLM_DS41_MARKOV_NVFP4",
-    "VLLM_DS41_DRAFT_NVFP4_HEAD",
-)
+RETIRED = ("VLLM_DS41_ENGRAM_OVERLAP",)
 
 
 @pytest.mark.parametrize("name", RETIRED)
@@ -29,24 +25,3 @@ def test_retired_setting_is_rejected_before_model_setup(monkeypatch, name, value
 @pytest.mark.parametrize("name", RETIRED)
 def test_retired_setting_is_not_an_environment_option(name):
     assert name not in envs.environment_variables
-
-
-def test_dspark_uses_the_targets_vocabulary_head(monkeypatch):
-    from torch import nn
-
-    from vllm.models.deepseek_v4_1.nvidia import dspark
-
-    monkeypatch.setattr(dspark, "DSparkDeepseekV4Model", lambda **kwargs: nn.Identity())
-    monkeypatch.setattr(dspark, "_linear_scale_param_name", lambda *args: "scale")
-    monkeypatch.setattr(dspark, "LogitsProcessor", lambda size: SimpleNamespace(size=size))
-    hf_config = SimpleNamespace(vocab_size=128, expert_dtype="fp4")
-    config = SimpleNamespace(
-        quant_config=None,
-        speculative_config=SimpleNamespace(
-            draft_model_config=SimpleNamespace(hf_config=hf_config)
-        ),
-    )
-    draft = dspark.DSparkDeepseekV4ForCausalLM(vllm_config=config)
-    assert draft.lm_head is None  # load_dspark_model aliases the target after loading
-    assert not draft.has_own_lm_head
-    assert draft.checkpoint_weight_name_prefixes == ("mtp.",)
diff --git a/vllm/envs.py b/vllm/envs.py
index e23bac7fa0..8088e4f40a 100755
--- a/vllm/envs.py
+++ b/vllm/envs.py
@@ -219,6 +219,8 @@ if TYPE_CHECKING:
     VLLM_QWEN3_8_FLASH_NEXT_MTP_COMPACT: bool = True
     VLLM_GDN_SPEC_DECODE_METADATA_FASTPATH: bool = True
     VLLM_MTP_NVFP4_LM_HEAD: bool = True
+    VLLM_DS41_MARKOV_NVFP4: bool = False
+    VLLM_DS41_DRAFT_NVFP4_HEAD: bool = False
     VLLM_DS41_PACKED_BF16_LM_HEAD: bool = False
     VLLM_DS41_HEAD_DTYPE: Literal["float32", "model"] = "float32"
     VLLM_STARTUP_HEARTBEAT_TIMEOUT_S: float = 120.0
@@ -1885,9 +1887,19 @@ environment_variables: dict[str, Callable[[], Any]] = {
     "VLLM_MTP_NVFP4_LM_HEAD": lambda: bool(
         int(os.getenv("VLLM_MTP_NVFP4_LM_HEAD", "1"))
     ),
+    # Quantize the DeepSeek V4.1 DSpark Markov transition head to NVFP4 (fits
+    # the GB10 L2; draft graph 3.57 -> 3.0 ms). Off until its effect on
+    # acceptance is measured.
+    "VLLM_DS41_MARKOV_NVFP4": lambda: bool(
+        int(os.getenv("VLLM_DS41_MARKOV_NVFP4", "0"))
+    ),
+    # Give the DeepSeek V4.1 DSpark drafter its own NVFP4 vocabulary head.
+    "VLLM_DS41_DRAFT_NVFP4_HEAD": lambda: bool(
+        int(os.getenv("VLLM_DS41_DRAFT_NVFP4_HEAD", "0"))
+    ),
     # Store the DeepSeek V4/V4.1 target vocabulary head (which the DSpark
-    # drafter shares) in the exact 12-bit packed BF16 form: every weight bit
-    # is kept, in 75% of the bytes.
+    # drafter shares when it has no head of its own) in B12X's exact 12-bit
+    # packed BF16 form: every weight bit is kept, in 75% of the bytes.
     "VLLM_DS41_PACKED_BF16_LM_HEAD": lambda: bool(
         int(os.getenv("VLLM_DS41_PACKED_BF16_LM_HEAD", "0"))
     ),
diff --git a/vllm/model_executor/models/config.py b/vllm/model_executor/models/config.py
