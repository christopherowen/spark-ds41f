+    torch.testing.assert_close(a, b, rtol=0, atol=0)
+
+    @T.prim_func
+    def into_fragment(A: T.Tensor((n,), T.float32), C: T.Tensor((n,), T.float32)):
+        with T.Kernel(1, threads=128):
