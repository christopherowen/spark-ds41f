{
 "experiment": "experiments/2026-10-18-roce-gid-by-address",
 "run": "gid-tp4-qualify",
 "jobs": [
  {
   "kind": "sync"
  },
  {
   "kind": "fabric",
   "config": "gid-tp4.json",
   "script": "gid_check.py",
   "label": "gid-check"
  },
  {
   "kind": "fabric",
   "config": "gid-tp4.json",
   "script": "scripts/probe_collectives.py",
   "label": "probe"
  },
  {
   "kind": "fabric",
   "config": "gid-tp4.json",
   "script": "experiments/2026-10-15-r6n/failstop.py",
   "label": "failstop-eager",
   "environment": {
    "FAILSTOP_SCENARIO": "eager"
   }
  },
  {
   "kind": "fabric",
   "config": "gid-tp4.json",
   "script": "experiments/2026-10-15-r6n/failstop.py",
   "label": "failstop-graph",
   "environment": {
    "FAILSTOP_SCENARIO": "graph"
   }
  }
 ]
}
