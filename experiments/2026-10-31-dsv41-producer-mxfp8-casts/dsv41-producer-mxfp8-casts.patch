+def slice_mxfp8(cast: MXFP8Rows, first: int, last: int) -> MXFP8Rows:
+    """Rows ``[first:last]`` of ``cast``, padded to ``mxfp8_rows(last - first)``
+    without re-running ``per_token_cast``."""
+    if first == 0 and last == cast.rows.shape[0]:
+        return cast
+    rows = cast.rows[first:last]
+    m = rows.shape[0]
+    padded = mxfp8_rows(m)
+    if first + padded <= cast.values.shape[0]:
+        return MXFP8Rows(
+            rows,
+            cast.values[first : first + padded],
+            cast.scales[first : first + padded],
+        )
+    out = empty_mxfp8(rows)
+    if m:
+        out.values[:m].copy_(cast.values[first:last])
+        out.scales[:m].copy_(cast.scales[first:last])
+    return out
+
