+def test_slice_mxfp8_feeds_row_range(default_vllm_config, n=4096, k=1280):
+    """``slice_mxfp8`` hands a row sub-range of ``q_cast`` to ``indexer.wq_b``
+    without re-running ``per_token_cast``, matching a fresh cast bit for bit."""
+    from torch import nn
+
+    from vllm.models.deepseek_v4_1.tilelang.linear import (
+        TileLangBlock32Rows,
+        cast_mxfp8,
+        provide_mxfp8,
+        slice_mxfp8,
+    )
+    from vllm.v1.worker.workspace import use_preallocated_workspace
+
+    weight, exps, _ = _block32_weight(n, k, 11)
+    layer = nn.Module()
+    layer.weight, layer.weight_scale_inv = weight, exps
+    casting = TileLangBlock32Rows(layer, 0)
+    casting.declare_kernels()
+    fed = TileLangBlock32Rows(layer, 0)
+    fed.tilelang_mxfp8_input = True
+    fed.declare_kernels()
+    x = torch.randn((300, k), generator=_gen(12), device=DEVICE).bfloat16()
+    scratch = torch.empty(16 << 20, dtype=torch.uint8, device=DEVICE)
+    with use_preallocated_workspace(scratch):
+        for total, first, last in (
+            (6, 0, 6),
+            (64, 16, 48),
+            (120, 96, 120),
+            (300, 75, 150),
+        ):
+            full_cast = cast_mxfp8(x[:total])
+            sub = x[first:last]
+            expected = casting(sub)
+            with provide_mxfp8(slice_mxfp8(full_cast, first, last)):
+                assert torch.equal(fed(sub), expected), (total, first, last)
+
+
 # The router splits K eight ways; (100, 200) cannot split.
 @pytest.mark.parametrize("n, k", [(384, 5120), (100, 200)])
