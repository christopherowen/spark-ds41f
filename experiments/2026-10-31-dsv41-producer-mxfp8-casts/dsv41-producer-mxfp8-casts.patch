+@pytest.mark.parametrize("rows", [1, 6, 96, 2024])
+@pytest.mark.parametrize("n", [512, 576])
+def test_forward_with_cast_matches_separate_cast(rows, n):
+    """Fusing the MXFP8 cast into ``SiluAndMulClampFP32`` produces the exact BF16
+    output and ``per_token_cast`` E4M3/UE8M0 bytes of the separate path."""
+    limit = 10.0
+    generator = torch.Generator(device="cuda").manual_seed(100 + rows + n)
+    gate_up = (
+        torch.randn(rows, 2 * n, generator=generator, device="cuda") * 6
+    ).bfloat16()
+    act = SiluAndMulClampFP32(limit, width=n, cast=True)
+    out, out_q = act.forward_with_cast(gate_up)
+    ref_out = _reference(gate_up, limit)
+    ref_q = cast_mxfp8(ref_out)
+    assert torch.equal(out, ref_out)
+    assert out_q.values.shape == ref_q.values.shape
+    assert out_q.scales.shape == ref_q.scales.shape
+    assert torch.equal(out_q.values[:rows].view(torch.uint8), ref_q.values[:rows].view(torch.uint8))
+    assert torch.equal(
+        out_q.scales[:rows, : n // 32], ref_q.scales[:rows, : n // 32]
+    )
