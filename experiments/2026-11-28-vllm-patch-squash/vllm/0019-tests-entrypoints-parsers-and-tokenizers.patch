+def test_parallel_newline_chunks_and_direct_encode_call_exactness():
+    from transformers import TokenizersBackend
+    from vllm.tokenizers.deepseek_v41 import _split_parallel_newline_chunks
+
+    tokenizer = byte_level_tokenizer()
+    tokenizer._segment_cache.clear()
+
+    # Create a large multi-line prompt >= 64 KiB spanning system, user, and assistant segments.
+    code_lines = [
+        f"def fn_{i}(x):\n    return x * {i} + {i % 7}\n"
+        for i in range(2000)
+    ]
+    big_doc = "".join(code_lines)
+    chunks = _split_parallel_newline_chunks(big_doc, target_chars=16384)
+    assert len(chunks) > 1
+    assert "".join(chunks) == big_doc
+    for prev_chunk, next_chunk in zip(chunks, chunks[1:]):
+        assert prev_chunk.endswith("\n") and not next_chunk[0].isspace()
+
+    msgs = [
+        {"role": "system", "content": "Be concise."},
+        {"role": "user", "content": big_doc},
+        {"role": "assistant", "content": "", "reasoning_content": "Done reasoning."},
+        {"role": "assistant", "content": "Final reply."},
+    ]
+    prompt = tokenizer.apply_chat_template(
+        msgs, tokenize=False, add_generation_prompt=False
+    )
+
+    ref_ids_no_bos = TokenizersBackend.encode(tokenizer, prompt, add_special_tokens=False)
+    fast_ids_no_bos = tokenizer.encode(prompt, add_special_tokens=False)
+    assert fast_ids_no_bos == ref_ids_no_bos
+
+    ref_ids_bos = TokenizersBackend.encode(tokenizer, prompt, add_special_tokens=True)
+    fast_ids_bos = tokenizer.encode(prompt, add_special_tokens=True)
+    assert fast_ids_bos == ref_ids_bos
+
+    ref_call = TokenizersBackend.__call__(tokenizer, prompt, add_special_tokens=False)
+    fast_call = tokenizer(prompt, add_special_tokens=False)
+    assert dict(fast_call) == dict(ref_call)
+    assert len(tokenizer._segment_cache) > 0
+
+    # Warm second call after appending a turn reuses cached segments and stays bit-exact.
+    prompt_next = prompt + "<｜User｜>Follow up question<｜end▁of▁sentence｜><｜Assistant｜>"
+    assert tokenizer.encode(prompt_next, add_special_tokens=False) == TokenizersBackend.encode(
+        tokenizer, prompt_next, add_special_tokens=False
+    )
+    assert dict(tokenizer(prompt_next, add_special_tokens=True, return_length=True)) == dict(
+        TokenizersBackend.__call__(
+            tokenizer, prompt_next, add_special_tokens=True, return_length=True
+        )
+    )
