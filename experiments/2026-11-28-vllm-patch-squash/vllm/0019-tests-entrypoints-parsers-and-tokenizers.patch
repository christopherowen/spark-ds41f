+    else:
+        deltas = schedule_deltas(tokenizer, r_ids, r_prompt_ids, schedule)
+        r_actual = stream(r_parser, request, r_prompt_ids, deltas)
+    assert r_actual == ("Draft </think> " + CALL, "Done", [])
