+def _req(stream: bool = False) -> ChatCompletionRequest:
+    return ChatCompletionRequest(
+        model="m",
+        messages=[{"role": "user", "content": "x"}],
+        tools=TOOLS,
+        stream=stream,
+    )
+
+
+def _parsed(args: str):
+    try:
+        return (json.loads(args) if args else None), True
+    except Exception:
+        return args, False
+
+
+def _run_nonstream(tok, text: str) -> dict:
+    r = _req()
+    tp = DeepSeekV41EngineToolParser(tok, r.tools, chat_template_kwargs={"thinking": False})
+    out = tp.extract_tool_calls(text, r)
+    calls = []
+    for c in out.tool_calls:
+        a, ok = _parsed(c.function.arguments)
+        calls.append({"name": c.function.name, "args": a, "json_ok": ok})
+    return {"tools_called": out.tools_called, "calls": calls, "content": out.content}
+
+
+def _run_stream(tok, text: str, chunk: int) -> dict:
+    r = _req(stream=True)
+    tp = DeepSeekV41EngineToolParser(tok, r.tools, chat_template_kwargs={"thinking": False})
+    ids = tok.encode(text, add_special_tokens=False)
+    prev_text, prev_ids, content, calls = "", [], "", {}
+
+    def absorb(d):
+        nonlocal content
+        if d is None:
+            return
+        if d.content:
+            content += d.content
+        for tc in d.tool_calls or []:
+            c = calls.setdefault(tc.index, {"name": None, "args": ""})
+            if tc.function and tc.function.name:
+                c["name"] = tc.function.name
+            if tc.function and tc.function.arguments:
+                c["args"] += tc.function.arguments
+
+    for i in range(0, len(ids), chunk):
+        cur_ids = ids[: i + chunk]
+        cur_text = tok.decode(cur_ids)
+        delta = cur_text[len(prev_text) :]
+        absorb(
+            tp.extract_tool_calls_streaming(
+                prev_text, cur_text, delta, prev_ids, cur_ids, ids[i : i + chunk], r
+            )
+        )
+        prev_text, prev_ids = cur_text, cur_ids
+    if hasattr(tp, "finish_streaming"):
+        absorb(tp.finish_streaming())
+    out = []
+    for k in sorted(calls):
+        a, ok = _parsed(calls[k]["args"])
+        out.append({"name": calls[k]["name"], "args": a, "json_ok": ok})
+    return {"calls": out, "content": content}
+
+
+def _calls_of(block: dict) -> list[tuple]:
+    return [(c["name"], c["args"]) for c in block.get("calls", [])]
+
+
+def test_structural_dsml_active_by_default() -> None:
+    assert v41mod._STRUCTURAL_ACTIVE is True
+
+
+@pytest.mark.parametrize("case_name", sorted(CASES))
+def test_structural_closer_matrix_case(tokenizer, case_name: str) -> None:
+    text = CASES[case_name]
+    ns = _run_nonstream(tokenizer, text)
+    for chunk in (1, 3, 7, 10**6):
+        st = _run_stream(tokenizer, text, chunk)
+        for call in st["calls"]:
+            if case_name in TRUNCATION:
+                continue
+            assert call["json_ok"], f"G1 {case_name} chunk={chunk}: {call['args']!r}"
+        if case_name not in TRUNCATION:
+            assert _calls_of(st) == _calls_of(ns), (
+                f"G2 {case_name} chunk={chunk}: stream {_calls_of(st)} != nonstream {_calls_of(ns)}"
+            )
+    if case_name in FIXED:
+        assert _calls_of(ns) == FIXED[case_name]
+    if case_name in ("N_omit_param_close_then_invoke_end", "N2_omit_param_close_then_invoke_end_eos"):
+        assert _calls_of(ns) == [("write_file", {"path": "a.txt", "content": "hello\n"})]
+    if case_name == "R_value_ends_with_literal_param_closer":
+        assert _calls_of(ns) == [("write_file", {"path": "x.md", "content": f"the tag is {PE}"})]
+
