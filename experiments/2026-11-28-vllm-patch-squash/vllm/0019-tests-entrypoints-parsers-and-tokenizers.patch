+def test_same_turn_timer_and_completion_does_not_resolve_next_waiter() -> None:
+    """Reproduce #1210 deterministically via same-turn timer expiry and task completion.
+
+    When _on_timer fires on the same turn that task_1 finishes, _on_timer sets
+    waiter_1 to False and task_1 queues its done callback on loop._ready before
+    remove_done_callback runs. Synchronous iteration through keep-alive and
+    chunk-1 creates task_2 and awaits waiter_2 before loop._ready drains. The
+    queued callback must remain bound to waiter_1 so waiter_2 is never resolved
+    prematurely.
+    """
+
+    async def scenario() -> None:
+        loop = asyncio.get_running_loop()
+        orig_call_at = loop.call_at
+        fut1: asyncio.Future[str] = loop.create_future()
+        fut2: asyncio.Future[str] = loop.create_future()
+        intercepted = False
+
+        def wrapped_call_at(when, callback, *args, **kwargs):
+            nonlocal intercepted
+            if not intercepted and getattr(callback, "__name__", "") == "_on_timer":
+                intercepted = True
+
+                def racer(*cb_args):
+                    callback(*cb_args)
+                    if not fut1.done():
+                        fut1.set_result("chunk-1")
+
+                return orig_call_at(when, racer, *args, **kwargs)
+            return orig_call_at(when, callback, *args, **kwargs)
+
+        async def gen():
+            yield await fut1
+            loop.call_later(0.01, fut2.set_result, "chunk-2")
+            yield await fut2
+
+        loop.call_at = wrapped_call_at  # type: ignore[method-assign]
+        try:
+            chunks = [chunk async for chunk in with_sse_keep_alive(gen(), 0.01)]
+        finally:
+            loop.call_at = orig_call_at  # type: ignore[method-assign]
+
+        assert intercepted
+        assert SSE_KEEP_ALIVE_COMMENT in chunks
+        assert [c for c in chunks if c != SSE_KEEP_ALIVE_COMMENT] == [
+            "chunk-1",
+            "chunk-2",
+        ]
+
+    asyncio.run(scenario())
+
+
+def test_streaming_response_disconnect_and_fast_stream() -> None:
+    async def scenario() -> None:
+        async def fast():
+            for i in range(4):
+                yield f"data: {i}\n\n"
+
+        out = [chunk async for chunk in with_sse_keep_alive(fast(), 1.0)]
+        assert out == [f"data: {i}\n\n" for i in range(4)]
+
+        finalized = asyncio.Event()
+        started = asyncio.Event()
+
+        async def slow():
+            try:
+                await asyncio.Event().wait()
+                yield "never"
+            finally:
+                finalized.set()
+
+        response = StreamingResponse(
+            content=with_sse_keep_alive(slow(), 10.0),
+            media_type="text/event-stream",
+        )
+
+        async def receive():
+            await started.wait()
+            return {"type": "http.disconnect"}
+
+        async def send(message):
+            if message["type"] == "http.response.start":
+                started.set()
+
+        await response(
+            {"type": "http", "asgi": {"spec_version": "2.3"}},
+            receive,
+            send,
+        )
+        assert finalized.is_set()
+        pending = [
+            t
+            for t in asyncio.all_tasks()
+            if t is not asyncio.current_task() and not t.done()
+        ]
+        assert pending == []
+
+    asyncio.run(scenario())
