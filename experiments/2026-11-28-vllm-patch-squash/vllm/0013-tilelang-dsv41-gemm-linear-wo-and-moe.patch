+def _interleave_gate_up_slabs(tensor: torch.Tensor, slab: int = 64) -> torch.Tensor:
+    """Interleave ``[E, 2 * I, ...]`` gate and up rows in ``slab``-row pairs.
+
+    Every ``2 * slab`` (``block_N = 128``) row block holds ``slab`` gate rows
+    followed by the matching ``slab`` up rows, so one prefill ``gate_up``
+    column tile computes both halves needed by SwiGLU.
+    """
+    experts, two_inter = tensor.shape[:2]
+    inter = two_inter // 2
+    rest = tensor.shape[2:]
+    return (
+        tensor.view(experts, 2, inter // slab, slab, *rest)
+        .transpose(1, 2)
+        .contiguous()
+        .view(experts, two_inter, *rest)
+    )
+
+
+def tile_expert_weights(b_packed, block_N, *, interleave_gate_up: bool = False):
+    """Tile-major copy of ``[E, N, K / 2]`` packed E2M1 expert weights.
+
+    Returns ``(tiles, tails)``. Tile ``(e, n, k)`` (``block_N`` rows by 128
+    columns) becomes one contiguous ``[block_N, 64]``-byte slab of ``tiles``,
+    at index ``(e * N / block_N + n) * (K // 128) + k``. When ``K % 128 == 64``,
+    ``tails[e * N / block_N + n]`` holds that row block's last 64 columns as
+    ``[block_N, 32]`` bytes; otherwise ``tails`` is None.
+
+    When ``interleave_gate_up`` is True, fuses ``_interleave_gate_up_slabs``
+    (each ``block_N`` row tile holds ``block_N // 2`` gate rows followed by the
+    matching ``block_N // 2`` up rows) into the tile permutation with zero
+    intermediate allocation.
+    """
+    E, N, half_k = b_packed.shape
+    k_full, tail = divmod(2 * half_k, FP4_TMA_K)
+    slab_bytes = FP4_TMA_K // 2
+    if interleave_gate_up and block_N % 2 == 0 and N % block_N == 0:
+        slab = block_N // 2
+        n_blocks = N // block_N
+        b = b_packed.view(E, 2, n_blocks, slab, half_k)
+        full = b[..., : k_full * FP4_TMA_K // 2]
+        if slab_bytes % 8 == 0 and full.is_contiguous():
+            tiles = (
+                full.view(torch.int64)
+                .reshape(E, 2, n_blocks, slab, k_full, slab_bytes // 8)
+                .permute(0, 2, 4, 1, 3, 5)
+                .contiguous()
+                .view(b_packed.dtype)
+                .reshape(-1, block_N, slab_bytes)
+            )
+        else:
+            tiles = (
+                full.reshape(E, 2, n_blocks, slab, k_full, slab_bytes)
+                .permute(0, 2, 4, 1, 3, 5)
+                .contiguous()
+                .reshape(-1, block_N, slab_bytes)
+            )
+        if not tail:
+            return tiles, None
+        tails = (
+            b[..., k_full * FP4_TMA_K // 2 :]
+            .permute(0, 2, 1, 3, 4)
+            .contiguous()
+            .reshape(-1, block_N, tail // 2)
+        )
+        return tiles, tails.view(torch.uint8)
+    b = b_packed.view(E, N // block_N, block_N, half_k)
+    full = b[..., : k_full * FP4_TMA_K // 2]
+    if slab_bytes % 8 == 0 and full.is_contiguous():
+        tiles = (
+            full.view(torch.int64)
+            .reshape(E, N // block_N, block_N, k_full, slab_bytes // 8)
+            .permute(0, 1, 3, 2, 4)
+            .contiguous()
+            .view(b_packed.dtype)
+            .reshape(-1, block_N, slab_bytes)
+        )
+    else:
+        tiles = (
+            full.reshape(E, N // block_N, block_N, k_full, slab_bytes)
+            .permute(0, 1, 3, 2, 4)
+            .reshape(-1, block_N, slab_bytes)
+            .contiguous()
+        )
+    if not tail:
+        return tiles, None
+    tails = b[..., k_full * FP4_TMA_K // 2 :].reshape(-1, block_N, tail // 2)
+    return tiles, tails.contiguous().view(torch.uint8)
+
+
+@tilelang.jit(
+    pass_configs={
+        tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True,
+        tilelang.PassConfigKey.TL_DISABLE_THREAD_STORAGE_SYNC: True,
+        tilelang.PassConfigKey.TL_DISABLE_SAFE_MEMORY_ACCESS: True,
+    },
+)
+def moe_swiglu_cast(
+    intermediate,
+    block_M,
+    limit,
+    rows_per_cta=None,
+    slab_interleaved: bool = False,
+):
+    """The routed experts' SwiGLU, route weight and MXFP8 cast over the live tiles.
+
+    ``H[L, 2I]`` (the gate/up GEMM's BF16 output, gate columns first) becomes
+    ``Out[L, I]`` E4M3 with ``OutSF[L, *]`` UE8M0 bytes, one per 32 columns, for
+    every layout row with ``Order[row] >= 0``; padding rows are not written, as the
+    down GEMM's padding outputs are never read. A CTA takes ``rows_per_cta`` rows of
+    one tile, loading all of them before computing any, and the CTAs of tiles past
+    ``num_tiles`` (``TileExpert < 0``) stop there, so a decode step pays for its
+    live rows only.
+
+    The arithmetic follows DeepSeek's reference ``Expert.forward`` (as
+    ``activation.swiglu_clamp_cast_kernel`` does for the shared expert): gate and up
+    projections are widened to FP32, clamped at ``limit`` by compare and select (so a
+    NaN passes as through ``torch.clamp``), multiplied as
+    ``(gate / (1 + exp(-gate))) * up * weight`` in FP32, rounded to ``bfloat16``
+    (``self.w2(x.to(dtype))``), and then cast to MXFP8 with ``get_sf_and_inv`` over
+    each 32-column block.
+    """
+    from vllm.models.deepseek_v4_1.tilelang.quant_common import (
+        get_best_vectorize_size,
+        get_cast_output_config,
+        get_sf_and_inv,
+    )
+
+    in_dtype = T.bfloat16
+    out_config = get_cast_output_config("e4m3", (1, SF_BLOCK), False, True, True)
+    warp = 32
+    vec = max(
+        math.gcd(intermediate, get_best_vectorize_size(in_dtype) * warp) // warp, 1
+    )
+    chunk = warp * vec
+    assert intermediate % chunk == 0, "a warp's columns must tile the row"
+    assert SF_BLOCK % vec == 0, "a scale block spans whole thread vectors"
+    if slab_interleaved:
+        assert intermediate % 64 == 0, "interleaved gate/up slabs require 64-col width"
+    warps = intermediate // chunk  # one row's warps
+    if rows_per_cta is None:
+        # Fewer warps a row (TP3's 768 columns: 3) want fewer rows a CTA in flight
+        # (GB10 bench, experiments/2026-10-18-r6w-swiglu).
+        rows_per_cta = 4 if warps >= 4 else 2
+    assert block_M % rows_per_cta == 0
+    threads = warp * warps
+    reduce_rounds = (SF_BLOCK // vec).bit_length() - 1
+    sf_lanes = SF_BLOCK // vec
+    sf_width = 4 * scale_words(intermediate)
+    tiles = T.dynamic("tiles")
+    rows = tiles * block_M
+
+    @T.macro
+    def compute_row(
+        r,
+        base,
+        col,
+        tid,
+        weights,
+        xl,
+        xr,
+        xl_f,
+        xr_f,
+        x_bf16,
+        x,
+        stored,
+        amax,
+        Out,
+        OutSF,
+    ):
+        row = base + r
+        weight = T.alloc_var(T.float32, init=weights[r])
+        for j in T.vectorized(vec):
+            xl_f[j] = T.float32(xl[r, j])
+            xr_f[j] = T.float32(xr[r, j])
+        for j in T.unroll(vec):
+            val_l = T.alloc_var(T.float32, init=xl_f[j])
+            val_r = T.alloc_var(T.float32, init=xr_f[j])
+            if limit is not None:
+                val_l = T.Select(val_l > limit, limit, val_l)
+                val_r = T.Select(val_r > limit, limit, val_r)
+                val_r = T.Select(val_r < -limit, -limit, val_r)
+            val = T.alloc_var(
+                T.float32,
+                init=(val_l / (1.0 + T.exp(-val_l))) * val_r * weight,
+            )
+            x_bf16[j] = T.cast(val, in_dtype)
+            x[j] = T.cast(x_bf16[j], T.float32)
+        for j in T.vectorized(2):
+            amax[j] = 0
+        for j in T.unroll(vec):
+            amax[j % 2] = T.max(amax[j % 2], T.abs(x[j]))
+        amax[0] = T.max(amax[0], amax[1])
+        for j in T.unroll(reduce_rounds):
+            amax[0] = T.max(amax[0], T.shfl_xor(amax[0], 1 << j))
+        sf, sf_inv = get_sf_and_inv(amax[0], out_config)
+        if (tid % warp) % sf_lanes == 0:
+            OutSF[row, col // SF_BLOCK] = sf
+        for j in T.vectorized(vec):
+            x[j] *= sf_inv
+        for j in T.vectorized(vec):
+            stored[j] = T.cast(x[j], T.float8_e4m3fn)
+        for j in T.vectorized(vec):
+            Out[row, col + j] = stored[j]
+
+    @T.prim_func
+    def moe_swiglu_cast_kernel(
+        H: T.Tensor((rows, 2 * intermediate), in_dtype),
+        Out: T.Tensor((rows, intermediate), T.float8_e4m3fn),
+        OutSF: T.Tensor((rows, sf_width), T.uint8),
+        Order: T.Tensor((rows,), T.int32),
+        Weights: T.Tensor((rows,), T.float32),
+        TileExpert: T.Tensor((tiles,), T.int32),
+    ):
+        with T.Kernel(block_M // rows_per_cta, tiles, threads=threads) as (slab, t):
+            tid = T.get_thread_binding()
+            col = (tid // warp) * chunk + (tid % warp) * vec
+            slab_col = (col // 64) * 128 + (col % 64) if slab_interleaved else col
+            up_col = slab_col + 64 if slab_interleaved else intermediate + col
+            orders = T.alloc_local((rows_per_cta,), T.int32)
+            weights = T.alloc_local((rows_per_cta,), T.float32)
+            xl = T.alloc_local((rows_per_cta, vec), in_dtype)
+            xr = T.alloc_local((rows_per_cta, vec), in_dtype)
+            xl_f = T.alloc_local((vec,), T.float32)
+            xr_f = T.alloc_local((vec,), T.float32)
+            x_bf16 = T.alloc_local((vec,), in_dtype)
+            x = T.alloc_local((vec,), T.float32)
+            stored = T.alloc_local((vec,), T.float8_e4m3fn)
+            amax = T.alloc_local((2,), T.float32)
+            base = t * block_M + slab * rows_per_cta
+            expert = TileExpert[t]
+            # Routes within each tile are packed contiguously from row 0, so a negative
+            # order at row 0 (or row 1) implies all remaining rows in the slab are padding.
+            if expert >= 0:
+                orders[0] = Order[base]
+                if orders[0] >= 0:
+                    weights[0] = Weights[base]
+                    if rows_per_cta > 1:
+                        orders[1] = Order[base + 1]
+                        if orders[1] >= 0:
+                            weights[1] = Weights[base + 1]
+                            for r in T.unroll(rows_per_cta - 2):
+                                orders[r + 2] = Order[base + r + 2]
+                                if orders[r + 2] >= 0:
+                                    weights[r + 2] = Weights[base + r + 2]
+            pdl.chain()
+            if expert >= 0 and orders[0] >= 0:
+                for j in T.vectorized(vec):
+                    xl[0, j] = H[base, slab_col + j]
+                for j in T.vectorized(vec):
+                    xr[0, j] = H[base, up_col + j]
+                if rows_per_cta > 1 and orders[1] >= 0:
+                    for j in T.vectorized(vec):
+                        xl[1, j] = H[base + 1, slab_col + j]
+                    for j in T.vectorized(vec):
+                        xr[1, j] = H[base + 1, up_col + j]
+                    for r in T.unroll(rows_per_cta - 2):
+                        if orders[r + 2] >= 0:
+                            for j in T.vectorized(vec):
+                                xl[r + 2, j] = H[base + r + 2, slab_col + j]
+                            for j in T.vectorized(vec):
+                                xr[r + 2, j] = H[base + r + 2, up_col + j]
+                compute_row(
+                    0,
+                    base,
+                    col,
+                    tid,
+                    weights,
+                    xl,
+                    xr,
+                    xl_f,
+                    xr_f,
+                    x_bf16,
+                    x,
+                    stored,
+                    amax,
+                    Out,
+                    OutSF,
+                )
+                if rows_per_cta > 1 and orders[1] >= 0:
+                    compute_row(
+                        1,
+                        base,
+                        col,
+                        tid,
+                        weights,
+                        xl,
+                        xr,
+                        xl_f,
+                        xr_f,
+                        x_bf16,
+                        x,
+                        stored,
+                        amax,
+                        Out,
+                        OutSF,
+                    )
+                    for r in T.unroll(rows_per_cta - 2):
+                        if orders[r + 2] >= 0:
+                            compute_row(
+                                r + 2,
+                                base,
+                                col,
+                                tid,
+                                weights,
+                                xl,
+                                xr,
+                                xl_f,
+                                xr_f,
+                                x_bf16,
+                                x,
+                                stored,
+                                amax,
+                                Out,
+                                OutSF,
+                            )
+
+    return moe_swiglu_cast_kernel
+
+
+def tile_codes(codes: torch.Tensor, block_N: int) -> torch.Tensor:
+    """``pack_scale_codes``' ``[E, N, words]`` codes in the coded GEMM's layout:
+    ``[E * N / block_N * words, block_N]``, each tile's codes for one K block
+    contiguous, so a stage loads them in 16-byte copies."""
+    E, N, words = codes.shape
+    return (
+        codes.view(torch.int16)
+        .view(E, N // block_N, block_N, words)
+        .permute(0, 1, 3, 2)
+        .reshape(-1, block_N)
+        .contiguous()
+        .view(torch.uint16)
+    )
+
+
+def _spans(specs):
+    """Byte offset and size of each spec laid out back to back, 256-byte aligned."""
+    spans, offset = [], 0
+    for shape, dtype in specs:
+        nbytes = dtype.itemsize
+        for dim in shape:
+            nbytes *= dim
+        spans.append((offset, nbytes))
+        offset += (nbytes + 255) // 256 * 256
+    return spans, offset
+
+
+def carve(scratch, specs):
+    """Views of ``specs`` in ``scratch``, laid out as ``workspace_bytes``."""
+    spans, _ = _spans(specs)
+    return [
+        scratch[offset : offset + nbytes].view(dtype).view(shape)
+        for (offset, nbytes), (shape, dtype) in zip(spans, specs)
+    ]
+
+
+def workspace_bytes(specs) -> int:
+    return _spans(specs)[1]
+
+
+class MoeExpertsV41Plan:
+    """Routed MXFP4 experts, MXFP8 activations: dispatch, two grouped GEMMs, combine.
+
+    Expert weights come from ``prepare_weights``: ``w13`` (``[E, 2I, H / 2]``
+    packed E2M1, gate rows first) and ``w2`` (``[E, H, I / 2]``), each with
+    its UE8M0 bytes, become tile-major. The tokens arrive cast to MXFP8 by the
+    kernel that produced them (``linear.MXFP8Rows``: the mHC entry). The fused
+    SwiGLU (``moe_swiglu_cast``: DeepSeek's clamp, route weight before the down
+    projection, MXFP8 cast) runs between the GEMMs. The plan holds no buffers;
+    ``workspace_specs(rows)`` lists one call's scratch. Its owner calls
+    ``declare_kernels()`` when preparing kernels; ``run`` launches the kernels it
+    binds.
+
+    Each grouped-GEMM tile holds ``block_M`` routes of one expert and reads that
+    expert's weight slab again, so a call's tile height is chosen by its rows
+    (``tile_height``): decode steps and short prefills keep ``decode_block_M``
+    (16 rows, one SM120 MMA atom tall), where nearly every active expert has at
+    most 16 routes and wider tiles only pad empty rows; medium prefills, once the
+    average expert fills a ``decode_block_M`` tile, step up to ``block_M`` (32);
+    and long prefills, where the average expert has at least one full ``block_M``
+    tile, use ``prefill_block_M`` (64) rows a tile and read the weights half as
+    often a route (GB10, one layer's experts at TP3's 768 columns a rank: 11%
+    faster at 8,192 tokens, 19% at 16,384; spark-ds41f
+    experiments/2026-10-26-tp3-budget-memory). A row's sum over K runs in the same
+    order at every height, so its output has the same bits.
+    """
+
+    def __init__(
+        self,
+        num_experts,
+        topk,
+        hidden,
+        intermediate,
+        *,
+        swiglu_limit=None,
+        decode_block_M=16,
+        block_M=32,
+        prefill_block_M=64,
+        prefill_swizzle_panel=4,
+        block_N=128,
+        num_stages=3,
+        down_num_stages=None,
+        out_dtype=torch.bfloat16,
+        idx_dtypes=(torch.int32, torch.int64),
+        max_rows: int | None = None,
+        num_slots: int | None = None,
+        narrow_codes: bool | None = None,
+        slot_map: bool | None = None,
+    ):
+        self.num_experts, self.topk, self.hidden, self.intermediate = (
+            num_experts,
+            topk,
+            hidden,
+            intermediate,
+        )
+        self.num_slots = num_experts if num_slots is None else num_slots
+        if self.num_slots <= 0 or self.num_slots > num_experts:
+            raise ValueError(
+                f"num_slots ({self.num_slots}) must be in 1..{num_experts}"
+            )
+        self.slot_map = (
+            (self.num_slots < num_experts) if slot_map is None else bool(slot_map)
+        )
+        self.narrow_codes = (
+            (not self.slot_map) if narrow_codes is None else bool(narrow_codes)
+        )
+        (
+            self.decode_block_M,
+            self.block_M,
+            self.prefill_block_M,
+            self.block_N,
+        ) = (
+            decode_block_M,
+            block_M,
+            prefill_block_M,
+            block_N,
+        )
+        self.prefill_swizzle_panel = prefill_swizzle_panel
+        self.num_stages = num_stages
+        self.down_num_stages = (
+            (3 if intermediate % 128 == 0 else 2)
+            if down_num_stages is None
+            else down_num_stages
+        )
+        self.swiglu_limit = swiglu_limit
+        # Routers emit int32 or int64 expert ids. The combine writes ``out_dtype``.
+        self.out_dtype = out_dtype
+        self.idx_dtypes = tuple(idx_dtypes)
+        self.max_rows = max_rows
+        mid_min_routes = decode_block_M * num_experts
+        prefill_min_routes = block_M * num_experts
+        decode_max_routes = (
+            mid_min_routes - 1
+            if block_M != decode_block_M
+            else (prefill_min_routes - 1 if prefill_block_M != decode_block_M else None)
+        )
+        mid_max_routes = (
+            prefill_min_routes - 1 if prefill_block_M != block_M else None
+        )
+        if max_rows is not None:
+            max_routes = max_rows * topk
+            decode_max_routes = (
+                max_routes
+                if decode_max_routes is None
+                else min(decode_max_routes, max_routes)
+            )
+            mid_max_routes = (
+                max_routes
+                if mid_max_routes is None
+                else min(mid_max_routes, max_routes)
+            )
+        else:
+            max_routes = None
+        dispatch_kw = {"slot_map": True} if self.slot_map else {}
+        self.decode_dispatch = {
+            dtype: MoeDispatchV41Plan(
+                num_experts,
+                topk,
+                decode_block_M,
+                hidden,
+                dtype,
+                out_dtype,
+                max_routes=decode_max_routes,
+                **dispatch_kw,
+            )
+            for dtype in self.idx_dtypes
+        }
+        self.dispatch = {
+            dtype: MoeDispatchV41Plan(
+                num_experts,
+                topk,
+                block_M,
+                hidden,
+                dtype,
+                out_dtype,
+                min_routes=mid_min_routes,
+                max_routes=mid_max_routes,
+                **dispatch_kw,
+            )
+            for dtype in self.idx_dtypes
+        }
+        self.prefill_dispatch = {
+            dtype: MoeDispatchV41Plan(
+                num_experts,
+                topk,
+                prefill_block_M,
+                hidden,
+                dtype,
+                out_dtype,
+                min_routes=prefill_min_routes,
+                max_routes=max_routes,
+                **dispatch_kw,
+            )
+            for dtype in self.idx_dtypes
+        }
+
+    def _has_mid_tiles(self) -> bool:
+        return self.block_M != self.decode_block_M and (
+            self.max_rows is None
+            or self.max_rows * self.topk >= self.decode_block_M * self.num_experts
+        )
+
+    def _has_prefill_tiles(self) -> bool:
+        return self.prefill_block_M != self.block_M and (
+            self.max_rows is None
+            or self.tile_height(self.max_rows) == self.prefill_block_M
+        )
+
+    def _has_prefill_swiglu_fusion(self) -> bool:
+        return (
+            self.narrow_codes
+            and not self.slot_map
+            and self._has_prefill_tiles()
+            and self.block_N == 128
+            and self.intermediate % 64 == 0
+        )
+
+    def _dispatches(self) -> tuple[MoeDispatchV41Plan, ...]:
+        out = list(self.decode_dispatch.values())
+        if self._has_mid_tiles():
+            out.extend(self.dispatch.values())
+        if self._has_prefill_tiles():
+            out.extend(self.prefill_dispatch.values())
+        return tuple(out)
+
+    def kernels(self) -> dict:
+        """The grouped GEMMs and the fused SwiGLU at each reachable tile height, as
+        the calls ``bind`` makes: ``gate_up``, ``down`` and ``swiglu`` at
+        ``decode_block_M``; at the same height ``late_gate_up`` and ``late_down``,
+        which trigger after their K loop (calls of ``LATE_TRIGGER_ROWS`` rows or
+        more); with a ``mid_`` prefix at ``block_M`` and a ``prefill_`` prefix at
+        ``prefill_block_M``, whose GEMMs trigger late and optionally swizzle across
+        ``prefill_swizzle_panel`` consecutive M-tiles (default 2; decode/mid keep 0)."""
+        config = dict(
+            block_N=self.block_N,
+            coded_scales=True,
+            narrow_codes=self.narrow_codes,
+        )
+        num_experts, topk, hidden, inter = (
+            self.num_slots,
+            self.topk,
+            self.hidden,
+            self.intermediate,
+        )
+        tiers = [("", self.decode_block_M, False, 0)]
+        if self.max_rows is None or self.max_rows >= LATE_TRIGGER_ROWS:
+            tiers.append(("late_", self.decode_block_M, True, 0))
+        if self._has_mid_tiles():
+            tiers.append(("mid_", self.block_M, True, 0))
+        if self._has_prefill_tiles():
+            tiers.append(
+                ("prefill_", self.prefill_block_M, True, self.prefill_swizzle_panel)
+            )
+        kernels = {}
+        fuse_prefill = self._has_prefill_swiglu_fusion()
+        for prefix, block_M, late, swizzle in tiers:
+            down_stages = (
+                self.down_num_stages
+                if block_M in (self.decode_block_M, self.block_M)
+                else self.num_stages
+            )
+            gemm_config = (
+                {**config, "swizzle_panel": swizzle} if swizzle else config
+            )
+            fused = fuse_prefill and prefix == "prefill_"
+            gate_up_config = (
+                {**gemm_config, "fuse_swiglu": True, "swiglu_limit": self.swiglu_limit}
+                if fused
+                else gemm_config
+            )
+            kernels[f"{prefix}gate_up"] = prepare.call(
+                grouped_fp8_fp4_gemm,
+                num_experts,
+                2 * inter,
+                hidden,
+                topk,
+                True,
+                block_M,
+                num_stages=self.num_stages,
+                **gate_up_config,
+                trigger_after_loop=late,
+            )
+            kernels[f"{prefix}down"] = prepare.call(
+                grouped_fp8_fp4_gemm,
+                num_experts,
+                hidden,
+                inter,
+                topk,
+                False,
+                block_M,
+                num_stages=down_stages,
+                **gemm_config,
+                trigger_after_loop=late,
+            )
+            if prefix != "late_" and not fused:  # the SwiGLU is the same at either trigger
+                swiglu_kwargs = {"slab_interleaved": True} if fuse_prefill else {}
+                kernels[f"{prefix}swiglu"] = prepare.call(
+                    moe_swiglu_cast, inter, block_M, self.swiglu_limit, **swiglu_kwargs
+                )
+        return kernels
+
+    def tile_height(self, rows: int) -> int:
+        """The tile height of a call of ``rows`` tokens: ``prefill_block_M`` once the
+        average expert has a full ``block_M`` tile of routes (``rows * topk >=
+        block_M * num_experts``: 2,048 tokens for V4.1's 384 experts at top-6),
+        ``block_M`` once the average expert has a full ``decode_block_M`` tile
+        (``rows * topk >= decode_block_M * num_experts``: 1,024 tokens), else
+        ``decode_block_M``. Decode steps and their CUDA graphs stay at
+        ``decode_block_M``."""
+        routes = rows * self.topk
+        if routes >= self.block_M * self.num_experts:
+            return self.prefill_block_M
+        if routes >= self.decode_block_M * self.num_experts:
+            return self.block_M
+        return self.decode_block_M
+
+    def _dispatch_for(self, rows: int, idx_dtype):
+        """The dispatch plan of a call at its tile height."""
+        height = self.tile_height(rows)
+        if height == self.decode_block_M:
+            return self.decode_dispatch[idx_dtype]
+        if height == self.block_M:
+            return self.dispatch[idx_dtype]
+        return self.prefill_dispatch[idx_dtype]
+
+    def _kernels_for(self, rows: int):
+        """The (gate/up, SwiGLU, down) kernels of a call at its tile height, its
+        grouped GEMMs triggering late from ``LATE_TRIGGER_ROWS`` rows."""
+        height = self.tile_height(rows)
+        if height != self.decode_block_M:
+            if height == self.block_M:
+                return self.mid_gate_up, self.mid_swiglu, self.mid_down
+            swiglu = None if self._has_prefill_swiglu_fusion() else self.prefill_swiglu
+            return self.prefill_gate_up, swiglu, self.prefill_down
+        if rows >= LATE_TRIGGER_ROWS:
+            return self.late_gate_up, self.swiglu, self.late_down
+        return self.gate_up, self.swiglu, self.down
+
+    def declare_kernels(self) -> None:
+        """Declare the grouped GEMMs, the fused SwiGLU and each reachable dispatch
+        plan's kernels, stored on the plans once prepared."""
+
+        def calls() -> list[prepare.TileLangCall]:
+            out = _calls(self.kernels())
+            for dispatch in self._dispatches():
+                out.extend(_calls(dispatch.kernels()))
+            return out
+
+        def bind() -> None:
+            for name, kernel in _launch(self.kernels()).items():
+                setattr(self, name, kernel)
+            for dispatch in self._dispatches():
+                dispatch.bind()
+
+        prepare.declare(calls, bind=bind)
+
+    def prepare_weight(
+        self,
+        w,
+        scale,
+        *,
+        gate_up: bool | None = None,
+    ):
+        """One GEMM's ``(tiles, tails, codes, codes_2bit, narrow, base)``
+        in ``overlay_byte_codes(tile_codes(...), tile_byte_codes(...), narrow)``
+        and ``narrow_code_offsets(narrow)`` layout."""
+        if gate_up is None:
+            gate_up = (
+                w.shape[1] == 2 * self.intermediate
+                and w.shape[2] * 2 == self.hidden
+            )
+        fuse_interleave = bool(gate_up and self._has_prefill_swiglu_fusion())
+        if fuse_interleave:
+            scale = _interleave_gate_up_slabs(scale)
+        if self.narrow_codes:
+            codes, codes_2bit, narrow_offsets, base = encode_expert_scale_codes(
+                scale, self.block_N
+            )
+        else:
+            packed = pack_expert_scale_codes(scale)
+            base = packed.base
+            codes = tile_codes(packed.codes, self.block_N)
+            codes_2bit = None
+            narrow_offsets = None
+            del packed
+        tiles, tails = tile_expert_weights(
+            w.view(torch.int8), self.block_N, interleave_gate_up=fuse_interleave
+        )
+        return tiles, tails, codes, codes_2bit, narrow_offsets, base
+
+    def prepare_weights(self, w13, w13_scale, w2, w2_scale):
+        """Per GEMM ``(tiles, tails, codes, codes_2bit, narrow, base)``.
+
+        ``tails`` is None unless the GEMM's K is 64 past a multiple of 128 (the
+        down projection of TP4's 576-wide expert rows). ``codes`` and
+        ``codes_2bit`` are ``overlay_byte_codes``' uint16 and uint8 views of one
+        compact buffer: an expert whose every row has delta <= 3 is narrow and
+        takes one ``[n_blocks * k_blocks, block_N]``-byte unit (four 2-bit deltas
+        a byte, low bits first); a wide expert takes two units (its ``tile_codes``
+        4-bit codes). ``narrow`` is ``narrow_code_offsets``' uint16
+        ``(unit_base << 1) | is_narrow`` per expert. A narrow expert's GEMM loads
+        ``codes_2bit``; a wide expert loads ``codes``.
+        """
+        return (
+            self.prepare_weight(w13, w13_scale, gate_up=True),
+            self.prepare_weight(w2, w2_scale, gate_up=False),
+        )
+
+    def workspace_specs(self, rows, idx_dtype=torch.int64):
+        """One call's scratch, laid out for the call's tile height (``tile_height``):
+        ``prefill_block_M`` tiles pad each expert's routes to more rows."""
+        dispatch = self._dispatch_for(rows, idx_dtype)
+        layout_rows = dispatch.tiles(rows) * dispatch.block_M
+        hidden, inter = self.hidden, self.intermediate
+        fused = (
+            self._has_prefill_swiglu_fusion()
+            and self.tile_height(rows) == self.prefill_block_M
+        )
+        specs = [*dispatch.workspace_specs(rows)]
+        if not fused:
+            specs.append(((layout_rows, 2 * inter), torch.bfloat16))  # gate/up output
+        specs.extend((
+            ((layout_rows, inter), torch.float8_e4m3fn),  # down input, MXFP8
+            ((layout_rows, 4 * scale_words(inter)), torch.uint8),
+            ((layout_rows, hidden), torch.bfloat16),  # down output
+        ))
+        return tuple(specs)
+
+    def run(
+        self,
+        x: MXFP8Rows,
+        topk_ids,
+        topk_weights,
+        weights,
+        out,
+        workspace=None,
+        shared=None,
+        *,
+        expert_to_slot=None,
+        wait_w2=None,
+    ):
+        """``out[t] = sum_k w[t, k] * down_e(swiglu(gate_up_e(x[t]))) (+ shared[t])``.
+
+        ``e`` is the token's k-th expert. ``x`` is the tokens' MXFP8 rows, as their
+        producer wrote them. ``weights`` comes from ``prepare_weights``;
+        ``workspace`` is a byte buffer of at least
+        ``workspace_bytes(workspace_specs(rows))``. ``shared`` (BF16 rows) is added
+        to the FP32 sum before the one rounding to ``out``'s dtype; a callable
+        ``shared`` is called just before the combine launch (it may wait for
+        another stream) and returns those rows.
+
+        With ``out`` None the combine is not launched: the result is
+        ``combine(start, stop, rows_out)``, which writes the output's rows
+        ``start:stop`` into ``rows_out`` (in the dtype ``out`` would have) with one
+        launch, the same bits however the rows are split. It reads ``workspace``
+        and ``shared`` (a callable one is still called here), which must stay
+        unchanged until its last call.
+        """
+        dispatch, layout, y = self.run_routed(
+            x,
+            topk_ids,
+            topk_weights,
+            weights,
+            workspace=workspace,
+            expert_to_slot=expert_to_slot,
+            wait_w2=wait_w2,
+        )
+        if callable(shared):
+            shared = shared()
+        if out is not None:
+            return dispatch.combine(y, layout, out, shared=shared)
+
+        def combine(start, stop, rows_out):
+            dispatch.combine(y, layout, rows_out, shared=shared, start=start, stop=stop)
+
+        return combine
+
+    def run_routed(
+        self,
+        x: MXFP8Rows,
+        topk_ids,
+        topk_weights,
+        weights,
+        workspace=None,
+        *,
+        expert_to_slot=None,
+        wait_w2=None,
+    ):
+        """Run dispatch, gate_up/swiglu, and down without combining routes.
+
+        Returns ``(dispatch, layout, y)`` where ``y`` holds the BF16 per-route
+        down-projection rows addressed by ``layout["route_pos"]``.
+        """
+        rows = topk_ids.shape[0]
+        dispatch = self._dispatch_for(rows, topk_ids.dtype)
+        gate_up_kernel, swiglu_kernel, down_kernel = self._kernels_for(rows)
+        specs = self.workspace_specs(rows, topk_ids.dtype)
+        if workspace is None:
+            workspace = torch.empty(
+                workspace_bytes(specs), dtype=torch.uint8, device=x.values.device
+            )
+        buffers = carve(workspace, specs)
+        count = len(dispatch.workspace_specs(rows))
+        gate_up, down = weights
+        layout = (
+            dispatch.dispatch(
+                topk_ids, topk_weights, buffers[:count], expert_to_slot=expert_to_slot
+            )
+            if self.slot_map
+            else dispatch.dispatch(topk_ids, topk_weights, buffers[:count])
+        )
+        order, tile_expert = layout["order"], layout["tile_expert"]
+        # The gather reads the live rows only; padding rows past them are not read.
+        x_words = x.scales.view(torch.uint32)
+        if swiglu_kernel is None:
+            hq, h_sf, y = buffers[count:]
+            h_words = h_sf.view(torch.uint32)
+            gate_up_kernel(
+                x.values,
+                x_words,
+                *_present(gate_up),
+                order,
+                tile_expert,
+                layout["layout_weights"],
+                hq,
+                h_sf,
+            )
+        else:
+            h, hq, h_sf, y = buffers[count:]
+            h_words = h_sf.view(torch.uint32)
+            gate_up_kernel(x.values, x_words, *_present(gate_up), order, tile_expert, h)
+            swiglu_kernel(h, hq, h_sf, order, layout["layout_weights"], tile_expert)
+        if wait_w2 is not None:
+            wait_w2()
+        down_kernel(hq, h_words, *_present(down), order, tile_expert, y)
+        return dispatch, layout, y
+
+
+def _present(weights):
+    """A GEMM's weight arguments: the tiles, the K tails when it has them, the scale
+    codes and the row bases.
+
+    ``prepare_weights`` returns ``(tiles, tails, codes, codes_2bit, narrow, base)``.
+    The kernel loads ``codes_2bit`` for an expert whose ``narrow`` flag is 1 and
+    ``codes`` otherwise.
+    """
+    return tuple(w for w in weights if w is not None)
