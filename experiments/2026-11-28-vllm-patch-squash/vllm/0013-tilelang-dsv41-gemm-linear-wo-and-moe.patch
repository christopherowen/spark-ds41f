+                    T.clear(C_block)
+                    T.gemm(A0_shared, B0_shared, C_block, transpose_B=True)
+                    for i, j in T.Parallel(block_M, block_N):
+                        C_local[i, j] += C_block[i, j]
+                    if single_b:
+                        for step in T.serial(iters):
+                            item = step * threads + tx
+                            if items % threads == 0 or item < items:
+                                j = item // slices
