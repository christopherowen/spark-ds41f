+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""TileLang linear methods for DeepSeek-V4.1 (``--linear-backend tilelang``).
+
+Block-32 FP8 projections quantize activations to MXFP8 with TileKernels'
+per-token cast (DeepSeek's E4M3, one UE8M0 scale per 32 elements) and run
+``mxfp8_gemm``; decode rows go through whole 16-, 32- or 64-row activation
+tiles from the padded workspace. Unquantized projections run ``bf16_gemm``;
+projections with few output tiles (the router) split K over the SMs for
+decode rows and reduce the FP32 partials in a fixed order. Every path keeps
+each row's accumulation order fixed, so results do not depend on the batch.
+
+The kernels borrow activation scratch from vLLM's workspace.
+
+A projection marked ``tilelang_mxfp8_input`` casts nothing: the kernel that
+produced its input wrote the cast too (``MXFP8Rows``; the mHC entries do, for the
+sublayer's first projections), and hands it over for the call
+(``provide_mxfp8``).
+"""
+
+import contextlib
+import functools
+import math
+from typing import NamedTuple
+
+import torch
+from torch import nn
+
+from vllm.model_executor.layers.linear import UnquantizedLinearMethod
+from vllm.models.deepseek_v4_1.quant_config import Block32FP8LinearMethod
+from vllm.models.deepseek_v4_1.tilelang import pdl, prepare
+from vllm.v1.worker.workspace import (
+    current_preallocated_workspace,
+    current_workspace_manager,
+    retain_cuda_graph_capture_resource,
+)
+
+from .gemm import (
+    BF16_SPLIT_ROWS,
+    DECODE_ROWS,
+    DECODE_TILE_ROWS,
+    SF_BLOCK,
+    SPLIT_BF16,
+    SPLIT_DECODE_ROWS,
+    SPLIT_FP8,
+    TILE_CONTIGUOUS_FP8,
+    WIDE_DECODE,
+    bf16_gemm,
+    bf16_gemm_partials,
+    bf16_gemm_splitk,
+    bf16_gemm_two,
+    bf16_shards,
+    decode_tile_rows,
+    fp8_decode_config,
+    fp8_prefill_config,
+    mxfp8_gemm,
+    mxfp8_gemm_decode,
+    mxfp8_gemm_rope_mxfp4_decode,
+    mxfp8_gemm_partials,
+    pack_scale_words,
+    pack_weight_tiles,
+    packed_bf16_gemm,
+    packed_bf16_gemm_partials,
+    packed_bf16_gemm_splitk,
+    packed_bf16_gemm_two,
+    packed_bf16_unpack,
+    pick_block_K,
+    scale_words,
+    split_bucket,
+    split_row_tile,
+    splitk_reduce,
+)
+from .vocab import GROUP, pack_bf16_weight
+
+_TORCH_TO_TL = {torch.bfloat16: "bfloat16", torch.float32: "float32"}
+
+
+def _activation_specs(rows: int, k: int, decode_rows: int = DECODE_ROWS):
+    """MXFP8 activations and packed scales; decode rows fill whole tiles.
+
+    TileKernels pads each row's packed UE8M0 exponents to whole words. Rows
+    past ``rows`` in a decode tile are never stored by the GEMM. A layer whose
+    decode tiles serve more than DECODE_ROWS rows pads to whole DECODE_ROWS tiles.
+    """
+    if rows <= DECODE_ROWS:
+        tile_rows = DECODE_ROWS
+    elif rows <= decode_rows:
+        tile_rows = -(-rows // DECODE_ROWS) * DECODE_ROWS
+    else:
+        tile_rows = rows
+    return (
+        ((tile_rows, k), torch.float8_e4m3fn),
+        ((tile_rows, 4 * scale_words(k)), torch.uint8),
+    )
+
+
+# A producer writes a projection's MXFP8 input in whole DECODE_ROWS tiles up to the
+# widest decode row bound (WIDE_DECODE: 128 rows), so each 16-, 32- or 64-row decode
+# tile reads in bounds; past it, the prefill GEMMs read the live rows alone.
+MXFP8_DECODE_ROWS = max(max(wide) for wide in WIDE_DECODE.values())
+
+
+def mxfp8_rows(rows: int) -> int:
+    """Rows a producer writes for ``rows`` rows of a projection's MXFP8 input."""
+    if rows > MXFP8_DECODE_ROWS:
+        return rows
+    return -(-rows // DECODE_ROWS) * DECODE_ROWS
+
+
+class MXFP8Rows(NamedTuple):
+    """BF16 activation rows beside their MXFP8 cast, as block-32 projections read it.
+
+    ``values`` (E4M3) and ``scales`` (packed UE8M0 bytes, ``4 * scale_words(K)`` a row)
+    hold ``per_token_cast``'s bytes of ``rows`` in their first ``rows.shape[0]`` rows,
+    padded to ``mxfp8_rows`` rows that no GEMM stores."""
+
+    rows: torch.Tensor
+    values: torch.Tensor
+    scales: torch.Tensor
+
+
+def empty_mxfp8(rows: torch.Tensor) -> MXFP8Rows:
+    """Unwritten MXFP8 buffers for ``rows`` (BF16 ``[M, K]``), for their producer."""
+    m, k = rows.shape
+    padded = mxfp8_rows(m)
+    return MXFP8Rows(
+        rows,
+        torch.empty((padded, k), dtype=torch.float8_e4m3fn, device=rows.device),
+        torch.empty(
+            (padded, 4 * scale_words(k)), dtype=torch.uint8, device=rows.device
+        ),
+    )
+
+
+def cast_mxfp8(rows: torch.Tensor) -> MXFP8Rows:
+    """``rows``' MXFP8 cast by TileKernels' ``per_token_cast``: the producer of rows
+    regrouped after the kernel that wrote their cast (a CED boundary's compact rows,
+    prefill SP's gathered rows). ``_warm_casts`` of their width declares it."""
+    out = empty_mxfp8(rows)
+    m = rows.shape[0]
+    if m:
+        pdl.per_token_cast(
+            rows,
+            "e4m3",
+            SF_BLOCK,
+            round_sf=True,
+            use_packed_ue8m0=True,
+            out=(out.values[:m], out.scales[:m]),
+        )
+    return out
+
+
+def slice_mxfp8(rows: MXFP8Rows, first: int, last: int) -> MXFP8Rows:
+    """Rows ``[first, last)`` of ``rows`` as an ``MXFP8Rows`` view when ``rows`` holds
+    enough padded rows past ``first``, else copied into a padded decode tile buffer."""
+    if first == 0 and last == rows.rows.shape[0]:
+        return rows
+    sub = rows.rows[first:last]
+    m = sub.shape[0]
+    needed = mxfp8_rows(m)
+    if rows.values.shape[0] - first >= needed:
+        return MXFP8Rows(
+            sub,
+            rows.values[first : first + needed],
+            rows.scales[first : first + needed],
+        )
+    out = empty_mxfp8(sub)
+    if m:
+        out.values[:m].copy_(rows.values[first:last])
+        out.scales[:m].copy_(rows.scales[first:last])
+    return out
+
+
+# The MXFP8 rows handed to the projections of the calls in progress, innermost last.
+_PROVIDED: list[MXFP8Rows] = []
+
+
+@contextlib.contextmanager
+def provide_mxfp8(rows: MXFP8Rows):
+    """Hand ``rows`` to the projections that read their input's cast from its producer
+    (``tilelang_mxfp8_input``) for the calls inside: the sublayer the rows feed."""
+    _PROVIDED.append(rows)
+    try:
+        yield
+    finally:
+        _PROVIDED.pop()
+
+
+def optional_provided_mxfp8(x: torch.Tensor) -> MXFP8Rows | None:
+    """The handed-over cast of ``x`` when a producer provided one via
+    ``provide_mxfp8``, else ``None``."""
+    for rows in reversed(_PROVIDED):
+        if rows.rows.data_ptr() == x.data_ptr() and rows.rows.shape == x.shape:
+            return rows
+    return None
+
+
+try_provided_mxfp8 = optional_provided_mxfp8
+
+
+def provided_mxfp8(x: torch.Tensor) -> MXFP8Rows:
+    """The handed-over cast of ``x``: rows at ``x``'s address, of ``x``'s shape. The
+    holder keeps them alive, so no other tensor can be at that address. A projection
+    whose input arrives without its cast fails here: it has no cast of its own."""
+    rows = optional_provided_mxfp8(x)
+    if rows is not None:
+        return rows
+    raise RuntimeError(
+        f"no MXFP8 cast was handed over for these {tuple(x.shape)} rows: the "
+        "projection reads its input's cast from the input's producer (provide_mxfp8)"
+    )
+
+
+
+# Row tiles of the split-K partials kernel. A 64-row tile computes one decode
+# row in twice the time of a 16-row tile; every height gives the same
+# partials bit for bit, so each row count takes the smallest tile that fits.
+PARTIAL_ROW_TILES = (16, 32, 48, 64)
+
+
+def partials_kernel(layer: nn.Module, rows: int):
+    """The layer's split-K partials kernel with the smallest row tile for ``rows``."""
+    for block_M in PARTIAL_ROW_TILES:
+        if rows <= block_M:
+            return layer.tilelang_partials[block_M]
+    return layer.tilelang_partials[PARTIAL_ROW_TILES[-1]]
+
+
+def _partial_specs(layer: nn.Module, rows: int):
+    """FP32 split-K partials of a BF16 projection's decode rows, if it splits."""
+    shards = layer.tilelang_shards
+    if shards == 1 or rows > layer.tilelang_split_rows:
+        return ()
+    return (((shards, rows, layer.weight.shape[0]), torch.float32),)
+
+
+def _spec_bytes(specs) -> int:
+    total = 0
+    for shape, dtype in specs:
+        nbytes = dtype.itemsize
+        for dim in shape:
+            nbytes *= dim
+        total += (nbytes + 255) // 256 * 256
+    return total
+
+
+def _scratch(specs, scratch: torch.Tensor | None):
+    """Views of ``specs`` in the caller's scratch, else in vLLM's workspace."""
+    if scratch is None:
+        scratch = current_preallocated_workspace()
+    if scratch is not None:
+        return _carve(scratch.view(-1).view(torch.uint8), specs)
+    views = current_workspace_manager().get_simultaneous(*specs)
+    retain_cuda_graph_capture_resource(views[0])
+    return views
+
+
+def _carve(scratch: torch.Tensor, specs):
+    """Views of ``specs`` laid out back to back, 256-byte aligned, in ``scratch``."""
+    views, offset = [], 0
+    for shape, dtype in specs:
+        nbytes = dtype.itemsize
+        for dim in shape:
+            nbytes *= dim
+        views.append(scratch[offset : offset + nbytes].view(dtype).view(shape))
+        offset += (nbytes + 255) // 256 * 256
+    return views
+
+
+def _block32_linear(
+    layer, x: torch.Tensor, out: torch.Tensor, scratch: torch.Tensor | None
+) -> None:
+    n = out.shape[-1]
+    k = layer.weight.shape[1] * layer.tilelang_groups  # grouped reads all groups' K
+    if x.ndim != 2:
+        x = x.reshape(-1, k)
+        out = out.view(x.shape[0], n)
+    rows = x.shape[0]
+    provided = (
+        provided_mxfp8(x)
+        if layer.tilelang_mxfp8_input
+        else (optional_provided_mxfp8(x) if layer.tilelang_groups == 1 else None)
+    )
+    if provided is not None:
+        if layer.tilelang_shards > 1 and rows <= layer.tilelang_split_rows:
+            _block32_split_mxfp8(
+                layer, provided.values, provided.scales, out.view(rows, n), scratch
+            )
+        else:
+            _block32_gemm(
+                layer, provided.values, provided.scales, out.view(rows, n), rows
+            )
+        return
+
+    if layer.tilelang_shards > 1 and rows <= layer.tilelang_split_rows:
+        _block32_split(layer, x, out, scratch)
+        return
+    xq, sf = _scratch(_activation_specs(rows, k, layer.tilelang_decode_rows), scratch)
+    pdl.per_token_cast(
+        x,
+        "e4m3",
+        SF_BLOCK,
+        round_sf=True,
+        use_packed_ue8m0=True,
+        out=(xq[:rows], sf[:rows]),
+    )
+    _block32_gemm(layer, xq, sf, out, rows)
+
+
+def _block32_gemm_weights(
+    layer,
+    xq: torch.Tensor,
+    sf: torch.Tensor,
+    weight: torch.Tensor,
+    weight_sf: torch.Tensor,
+    out: torch.Tensor,
+    rows: int,
+) -> None:
+    if rows > layer.tilelang_decode_rows:
+        gemm = layer.tilelang_prefill
+        # A producer pads rows that another projection's decode tiles read.
+        xq, sf = xq[:rows], sf[:rows]
+    else:
+        gemm = layer.tilelang_decode[decode_tile_rows(rows, layer.tilelang_wide)]
+    gemm(xq, weight, sf.view(torch.uint32), weight_sf, out)
+
+
+def _block32_gemm(layer, xq, sf, out, rows: int) -> None:
+    """The GEMM of a block-32 projection without split-K on its MXFP8 activations
+    (``_activation_specs`` buffers or a producer's ``MXFP8Rows``, the first ``rows``
+    rows live)."""
+    shard_decode = getattr(layer, "tilelang_shard_decode", None)
+    if shard_decode is not None and out.shape[-1] == getattr(
+        layer, "part_output_size", -1
+    ):
+        gemm = shard_decode[decode_tile_rows(rows, {})]
+        gemm(
+            xq,
+            layer.shard_weight,
+            sf.view(torch.uint32),
+            layer.shard_weight_sf,
+            out,
+        )
+        return
+    weight = getattr(layer, "tilelang_weight", layer.weight)
+    _block32_gemm_weights(
+        layer, xq, sf, weight, layer.tilelang_weight_sf, out, rows
+    )
+
+
+def _block32_linear_shards(
+    layer,
+    x: torch.Tensor,
+    shards: tuple[tuple[torch.Tensor, torch.Tensor], ...],
+    out: torch.Tensor,
+    scratch: torch.Tensor | None,
+) -> None:
+    """Project ``x`` (``[rows, K]`` BF16) through every rank's ``(weight, weight_sf)``
+    shard into ``out[:, :rows]`` (``[world_size, local_rows, N]`` BF16), casting ``x``
+    to MXFP8 once."""
+    k = layer.weight.shape[1] * layer.tilelang_groups
+    if x.ndim != 2:
+        x = x.reshape(-1, k)
+    rows = x.shape[0]
+    if rows == 0:
+        return
+    provided = (
+        provided_mxfp8(x)
+        if layer.tilelang_mxfp8_input
+        else (optional_provided_mxfp8(x) if layer.tilelang_groups == 1 else None)
+    )
+    if provided is not None:
+        xq, sf = provided.values, provided.scales
+        if layer.tilelang_shards > 1 and rows <= layer.tilelang_split_rows:
+            tile = split_row_tile(rows)
+            padded = -(-rows // tile) * tile
+            (partials,) = _scratch(
+                (((layer.tilelang_shards, rows, out.shape[-1]), torch.float32),),
+                scratch,
+            )
+            kernel = layer.tilelang_partials[split_bucket(rows)]
+            sf_u32 = sf[:padded].view(torch.uint32)
+            for s, (w_s, sf_s) in enumerate(shards):
+                kernel(xq[:padded], w_s, sf_u32, sf_s, partials)
+                layer.tilelang_reduce(partials, out[s, :rows])
+        else:
+            for s, (w_s, sf_s) in enumerate(shards):
+                _block32_gemm_weights(layer, xq, sf, w_s, sf_s, out[s, :rows], rows)
+        return
+    if layer.tilelang_shards > 1 and rows <= layer.tilelang_split_rows:
+        xq, sf, partials = _scratch(_split_specs(layer, rows), scratch)
+        pdl.per_token_cast(
+            x,
+            "e4m3",
+            SF_BLOCK,
+            round_sf=True,
+            use_packed_ue8m0=True,
+            out=(xq[:rows], sf[:rows]),
+        )
+        kernel = layer.tilelang_partials[split_bucket(rows)]
+        sf_u32 = sf.view(torch.uint32)
+        for s, (w_s, sf_s) in enumerate(shards):
+            kernel(xq, w_s, sf_u32, sf_s, partials)
+            layer.tilelang_reduce(partials, out[s, :rows])
+        return
+    xq, sf = _scratch(_activation_specs(rows, k, layer.tilelang_decode_rows), scratch)
+    pdl.per_token_cast(
+        x,
+        "e4m3",
+        SF_BLOCK,
+        round_sf=True,
+        use_packed_ue8m0=True,
+        out=(xq[:rows], sf[:rows]),
+    )
+    for s, (w_s, sf_s) in enumerate(shards):
+        _block32_gemm_weights(layer, xq, sf, w_s, sf_s, out[s, :rows], rows)
+
+
+def _split_specs(layer, rows: int):
+    """Split-K decode scratch: MXFP8 activations and scales padded to whole row
+    tiles, and the FP32 partials of the live rows."""
+    n, k = layer.weight.shape
+    tile = split_row_tile(rows)
+    padded = -(-rows // tile) * tile
+    return (
+        ((padded, k), torch.float8_e4m3fn),
+        ((padded, 4 * scale_words(k)), torch.uint8),
+        ((layer.tilelang_shards, rows, n), torch.float32),
+    )
+
+
+def _block32_split(layer, x: torch.Tensor, out: torch.Tensor, scratch) -> None:
+    rows = x.shape[0]
+    xq, sf, partials = _scratch(_split_specs(layer, rows), scratch)
+    pdl.per_token_cast(
+        x,
+        "e4m3",
+        SF_BLOCK,
+        round_sf=True,
+        use_packed_ue8m0=True,
+        out=(xq[:rows], sf[:rows]),
+    )
+    layer.tilelang_partials[split_bucket(rows)](
+        xq, layer.weight, sf.view(torch.uint32), layer.tilelang_weight_sf, partials
+    )
+    layer.tilelang_reduce(partials, out)
+
+
+def _block32_split_mxfp8(
+    layer, xq: torch.Tensor, sf: torch.Tensor, out: torch.Tensor, scratch
+) -> None:
+    rows, n = out.shape
+    tile = split_row_tile(rows)
+    padded = -(-rows // tile) * tile
+    (partials,) = _scratch(
+        (((layer.tilelang_shards, rows, n), torch.float32),), scratch
+    )
+    layer.tilelang_partials[split_bucket(rows)](
+        xq[:padded],
+        layer.weight,
+        sf[:padded].view(torch.uint32),
+        layer.tilelang_weight_sf,
+        partials,
+    )
+    layer.tilelang_reduce(partials, out)
+
+
+def _bf16_linear(
+    layer, x: torch.Tensor, out: torch.Tensor, scratch: torch.Tensor | None
+) -> None:
+    n, k = layer.weight.shape
+    if x.ndim != 2:
+        rows = x.numel() // k
+        x, out = x.reshape(rows, k), out.view(rows, n)
+    else:
+        rows = x.shape[0]
+    specs = _partial_specs(layer, rows)
+    if specs:
+        (partials,) = _scratch(specs, scratch)
+        partials_kernel(layer, rows)(x, layer.weight, partials)
+        layer.tilelang_reduce(partials, out)
+    else:
+        layer.tilelang_gemm(x, layer.weight, out)
+
+
+def _bf16_linear_shards(
+    layer,
+    x: torch.Tensor,
+    shards: tuple[torch.Tensor, ...],
+    out: torch.Tensor,
+    scratch: torch.Tensor | None,
+) -> None:
+    _, k = layer.weight.shape
+    if x.ndim != 2:
+        x = x.reshape(-1, k)
+    rows = x.shape[0]
+    if rows == 0:
+        return
+    specs = _partial_specs(layer, rows)
+    if specs:
+        (partials,) = _scratch(specs, scratch)
+        kernel = partials_kernel(layer, rows)
+        for s, shard in enumerate(shards):
+            w_s = shard[0] if isinstance(shard, tuple) else shard
+            kernel(x, w_s, partials)
+            layer.tilelang_reduce(partials, out[s, :rows])
+    else:
+        for s, shard in enumerate(shards):
+            w_s = shard[0] if isinstance(shard, tuple) else shard
+            layer.tilelang_gemm(x, w_s, out[s, :rows])
+
+
+def project_block32_rope_mxfp4_decode(
+    layer: nn.Module,
+    x: torch.Tensor,
+    positions: torch.Tensor,
+    cos_sin: torch.Tensor,
+    q_out: torch.Tensor,
+    s_out: torch.Tensor,
+) -> None:
+    """Project ``x`` through a block-32 FP8 layer at decode rows and fuse
+    GPT-J RoPE + MXFP4 quantization directly into ``q_out`` and ``s_out``."""
+    k = layer.weight.shape[1]
+    rows = x.numel() // k if x.ndim != 2 else x.shape[0]
+    if rows == 0:
+        return
+    if x.ndim != 2:
+        x = x.reshape(rows, k)
+    provided = (
+        provided_mxfp8(x)
+        if getattr(layer, "tilelang_mxfp8_input", False)
+        else optional_provided_mxfp8(x)
+    )
+    if provided is not None:
+        xq, sf = provided.values, provided.scales
+    else:
+        xq, sf = _scratch(
+            _activation_specs(rows, k, layer.tilelang_decode_rows),
+            current_preallocated_workspace(),
+        )
+        pdl.per_token_cast(
+            x,
+            "e4m3",
+            SF_BLOCK,
+            round_sf=True,
+            use_packed_ue8m0=True,
+            out=(xq[:rows], sf[:rows]),
+        )
+    weight = getattr(layer, "tilelang_weight", layer.weight)
+    gemm = layer.tilelang_decode_rope_mxfp4
+    gemm(
+        xq,
+        weight,
+        sf.view(torch.uint32),
+        layer.tilelang_weight_sf,
+        positions,
+        cos_sin,
+        q_out.view(rows, -1),
+        s_out.view(rows, -1),
+    )
+
+
+def project_bf16_partials(layer: nn.Module, x: torch.Tensor) -> torch.Tensor:
+    """Project ``x`` through a BF16 layer, returning 3D FP32 split-K ``partials``
+    (``[shards, rows, N]``) at decode sizes so a fused consumer (``norm_rope_write_index_keys``)
+    reduces the shards in registers without launching ``splitk_reduce``."""
+    n, k = layer.weight.shape
+    rows = x.numel() // k if x.ndim != 2 else x.shape[0]
+    if x.ndim != 2:
+        x = x.reshape(rows, k)
+    scratch = current_preallocated_workspace()
+    specs = _partial_specs(layer, rows)
+    if specs:
+        (partials,) = _scratch(specs, scratch)
+        partials_kernel(layer, rows)(x, layer.weight, partials)
+        return partials
+    out = torch.empty(
+        (rows, n),
+        dtype=getattr(layer, "out_dtype", torch.bfloat16),
+        device=x.device,
+    )
+    layer.tilelang_gemm(x, layer.weight, out)
+    return out
+
+
+def _block32_kernels(
+    n: int,
+    k: int,
+    groups: int = 1,
+    *,
+    rope_mxfp4: tuple[int, int] | None = None,
+    split_override: dict | None = None,
+) -> dict:
+    """Every kernel of a block-32 FP8 projection of an E4M3 ``[n, k]`` weight, as the
+    calls ``_bind_block32`` makes.
+
+    With ``groups`` > 1 the weight stacks ``groups`` blocks of ``n / groups`` rows,
+    each applied to its own K columns of ``groups * k``-wide activations.
+    """
+    split = split_override if split_override is not None else (SPLIT_FP8.get((n, k)) if groups == 1 else None)
+    if split:
+        # A narrow projection: split-K decode rows, and prefill tiles that add the
+        # same shards in the same order.
+        shards = split["shards"]
+        return {
+            "partials": {
+                bucket: prepare.call(
+                    mxfp8_gemm_partials, n, k, shards, block_M=min(bucket, 64), **config
+                )
+                for bucket, config in split["decode"].items()
+            },
+            "reduce": prepare.call(splitk_reduce, n, shards),
+            "prefill": prepare.call(
+                mxfp8_gemm, n, k, **split["prefill"], shards=shards
+            ),
+        }
+    part = n // groups
+    wide = WIDE_DECODE.get((n, k), {}) if groups == 1 else {}
+    # The wide decode table can name a tile taller than DECODE_ROWS (WO-B's 96).
+    heights = sorted({*DECODE_TILE_ROWS, *wide.values()})
+    tile_kw = (
+        {"tile_contiguous": True}
+        if groups == 1 and (n, k) in TILE_CONTIGUOUS_FP8
+        else {}
+    )
+    out = {
+        "decode": {
+            block_M: prepare.call(
+                mxfp8_gemm_decode,
+                part,
+                k,
+                **fp8_decode_config(part, k, block_M, groups),
+                padded_rows=True,
+                groups=groups,
+                **tile_kw,
+            )
+            for block_M in heights
+        },
+        "prefill": prepare.call(
+            mxfp8_gemm,
+            part,
+            k,
+            **fp8_prefill_config(part, k, groups),
+            groups=groups,
+            **tile_kw,
+        ),
+    }
+    if rope_mxfp4 is not None:
+        head_dim, rope_dim = rope_mxfp4
+        out["decode_rope_mxfp4"] = prepare.call(
+            mxfp8_gemm_rope_mxfp4_decode,
+            part,
+            k,
+            head_dim=head_dim,
+            rope_dim=rope_dim,
+            block_K=pick_block_K(k),
+            padded_rows=True,
+            **tile_kw,
+        )
+    return out
+
+
+def _calls(kernels: dict) -> list[prepare.TileLangCall]:
+    """The calls of a ``*_kernels`` table (values are calls or dicts of calls)."""
+    out = []
+    for value in kernels.values():
+        out.extend(value.values() if isinstance(value, dict) else [value])
+    return out
+
+
+def _launch(kernels: dict) -> dict:
+    """A ``*_kernels`` table with each call made (prepared: cache hits)."""
+    return {
+        name: {key: prepare.launch(c) for key, c in value.items()}
+        if isinstance(value, dict)
+        else prepare.launch(value)
+        for name, value in kernels.items()
+    }
+
+
+def _max_rows() -> int:
+    from vllm.config import get_current_vllm_config
+
+    return get_current_vllm_config().scheduler_config.max_num_batched_tokens
+
+
+@functools.cache
+def _warm_cast(k: int, rows: int) -> None:
+    """TileKernels' MXFP8 per-token cast of ``rows`` x ``k`` BF16 activations, run once
+    on zeros, so its kernel (keyed by K, the row stride and the small-batch bucket)
+    is compiled before the cache freezes."""
+    x = torch.zeros((rows, k), dtype=torch.bfloat16, device="cuda")
+    xq, sf = (
+        torch.empty(shape, dtype=dtype, device="cuda")
+        for shape, dtype in _activation_specs(rows, k)
+    )
+    pdl.per_token_cast(
+        x,
+        "e4m3",
+        SF_BLOCK,
+        round_sf=True,
+        use_packed_ue8m0=True,
+        out=(xq[:rows], sf[:rows]),
+    )
+
+
+# TileKernels' per-token cast compiles a small-batch kernel for calls of at most this
+# many rows (SMALL_BATCH_THRESHOLD, a local of per_token_cast_impl; a test reads it).
+CAST_SMALL_BATCH_ROWS = 4096
+
+
+def _warm_casts(k: int) -> None:
+    """Each of TileKernels' cast buckets the projection can launch: small batches
+    always, large ones when a forward can exceed the small-batch rows."""
+    _warm_cast(k, 1)
+    if _max_rows() > CAST_SMALL_BATCH_ROWS:
+        _warm_cast(k, CAST_SMALL_BATCH_ROWS + 1)
+
+
+def _declare_block32(
+    layer, groups: int = 1, cast: bool = True, *, split_override: dict | None = None
+) -> None:
+    """Configure a block-32 FP8 projection of ``layer.weight`` (E4M3 ``[N, K]``),
+    register it for the custom op, and declare its kernels. ``cast=False``: the
+    caller hands the GEMMs MXFP8 activations (WO-B), so no per-token cast launches.
+    A layer marked ``tilelang_mxfp8_input`` reads its input's cast from the input's
+    producer (``provide_mxfp8``) and casts nothing either."""
+    n = (
+        layer.logical_output_size
+        if getattr(layer, "part_output_size", 0) > 0
+        else layer.weight.shape[0]
+    )
+    k = layer.weight.shape[1]
+    if n == 0 or k == 0 or groups == 0:
+        layer.tilelang_groups = groups
+        layer.tilelang_wide = {}
+        layer.tilelang_decode_rows = DECODE_ROWS
+        layer.tilelang_shards = 1
+        layer.tilelang_mxfp8_input = getattr(layer, "tilelang_mxfp8_input", False)
+        return
+    kernels = _block32_kernels(
+        n,
+        k,
+        groups,
+        rope_mxfp4=getattr(layer, "tilelang_rope_mxfp4", None),
+        split_override=split_override,
+    )
+    part_n = (
+        getattr(layer, "part_output_size", 0)
+        if getattr(layer, "tp_size", 1) > 1 and groups == 1
+        else 0
+    )
+    shard_decode = (
+        {
+            block_M: prepare.call(
+                mxfp8_gemm_decode,
+                part_n,
+                k,
+                **fp8_decode_config(part_n, k, block_M),
+                padded_rows=True,
+            )
+            for block_M in DECODE_TILE_ROWS
+        }
+        if part_n
+        else None
+    )
+    layer.tilelang_groups = groups
+    layer.tilelang_wide = WIDE_DECODE.get((n, k), {}) if groups == 1 else {}
+    layer.tilelang_decode_rows = max(layer.tilelang_wide, default=DECODE_ROWS)
+    split = split_override if split_override is not None else (SPLIT_FP8.get((n, k)) if groups == 1 else None)
+    layer.tilelang_shards = split["shards"] if split else 1
+    if split:
+        layer.tilelang_split_rows = split["rows"]
+    layer.tilelang_mxfp8_input = getattr(layer, "tilelang_mxfp8_input", False)
+    if layer.tilelang_mxfp8_input:
+        single_heights = (
+            {min(bucket, 64) for bucket in split["decode"] if bucket <= DECODE_ROWS}
+            if split
+            else set(DECODE_TILE_ROWS)
+        )
+        multi_heights = (
+            {min(bucket, 64) for bucket in split["decode"] if bucket > DECODE_ROWS}
+            if split
+            else set(layer.tilelang_wide.values())
+        )
+        if (
+            groups != 1
+            or (split and split["rows"] > MXFP8_DECODE_ROWS)
+            or any(height <= 0 or height > DECODE_ROWS for height in single_heights)
+            or any(DECODE_ROWS % height for height in multi_heights)
+        ):
+            # A producer pads to whole DECODE_ROWS tiles (mxfp8_rows) for one GEMM.
+            raise ValueError(
+                f"the ({n}, {k}) projection cannot read a producer's MXFP8 rows"
+            )
+        cast = False
+
+    def bind() -> None:
+        for name, kernel in _launch(kernels).items():
+            setattr(layer, f"tilelang_{name}", kernel)
+        if shard_decode is not None:
+            layer.tilelang_shard_decode = {
+                block_M: prepare.launch(c) for block_M, c in shard_decode.items()
+            }
+
+    prepare.declare(
+        lambda: _calls(kernels)
+        + (list(shard_decode.values()) if shard_decode is not None else []),
+        bind=bind,
+        warm=(lambda: _warm_casts(k * groups)) if cast else None,
+    )
+
+
+def _block32_scale_words(layer, *, split_override: dict | None = None) -> None:
+    """Pack the 32x32 block-scale grid. The GEMM indexes it with ``row // 32``.
+
+    ``pack_scale_words(..., rows=N)`` repeats this grid once per output row.
+    Storing the grid keeps ``SFB[row // 32, word]`` equal to that expanded word.
+    Grouped weights are stacked in N, so the same index is the broadcast's word.
+    """
+    scales = layer.weight_scale_inv.view(torch.uint8)
+    rows, cols = layer.weight.shape
+    if scales.shape[0] * 32 != rows:
+        raise ValueError(
+            f"block scales have {scales.shape[0]} rows for {rows} outputs; "
+            "the GEMM reads one scale row per 32 output rows"
+        )
+    if rows == 0 or cols == 0:
+        layer.tilelang_weight_sf = torch.empty(
+            (rows // 32, scale_words(cols)),
+            dtype=torch.uint32,
+            device=scales.device,
+        )
+        layer.tilelang_weight = layer.weight
+        return
+    full_sf = pack_scale_words(scales)
+    logical_n = (
+        layer.logical_output_size
+        if getattr(layer, "part_output_size", 0) > 0
+        else rows
+    )
+    layer.tilelang_weight_sf = full_sf[: logical_n // 32]
+    if (
+        getattr(layer, "tp_size", 1) > 1
+        and getattr(layer, "part_output_size", 0) > 0
+    ):
+        part_n = layer.part_output_size
+        r0 = layer.tp_rank * part_n
+        r1 = r0 + part_n
+        layer.shard_weight = layer.weight[r0:r1]
+        layer.shard_weight_sf = full_sf[r0 // 32 : r1 // 32]
+    groups = getattr(layer, "tilelang_groups", 1)
+    split = (
+        split_override
+        if split_override is not None
+        else (SPLIT_FP8.get((logical_n, cols)) if groups == 1 else None)
+    )
+    if (
+        not split
+        and (logical_n, cols) in TILE_CONTIGUOUS_FP8
+        and logical_n == rows
+        and groups == 1
+        and not getattr(layer, "tilelang_weight_packed", False)
+    ):
+        packed = pack_weight_tiles(layer.weight)
+        layer.weight.data = packed.view(rows, cols)
+        layer.tilelang_weight = packed
+        layer.tilelang_weight_packed = True
+    elif not getattr(layer, "tilelang_weight_packed", False):
+        layer.tilelang_weight = layer.weight[:logical_n]
+
+
+def _apply_block32(
+    layer, x: torch.Tensor, *, out_cols: int | None = None
+) -> torch.Tensor:
+    cols = (
+        out_cols
+        if out_cols is not None
+        else (
+            layer.logical_output_size
+            if getattr(layer, "part_output_size", 0) > 0
+            else layer.weight.shape[0]
+        )
+    )
+    out = torch.empty(
+        (*x.shape[:-1], cols),
+        dtype=torch.bfloat16,
+        device=x.device,
+    )
+    _block32_linear(layer, x, out, current_preallocated_workspace())
+    return out
+
+
+class TileLangFP8LinearMethod(Block32FP8LinearMethod):
+    """Checkpoint block-32 FP8 weights with MXFP8 activations."""
+
+    def declare_layer_kernels(self, layer):
+        _declare_block32(layer)
+
+    def process_weights_after_loading(self, layer):
+        _block32_scale_words(layer)
+
+    def get_workspace_size(self, layer, num_tokens: int) -> int:
+        if getattr(layer, "tilelang_mxfp8_input", False):
+            return 0  # its producer writes the activations
+        return _spec_bytes(
+            _activation_specs(
+                num_tokens, layer.weight.shape[1], layer.tilelang_decode_rows
+            )
+        )
+
+    def apply(self, layer, x, bias=None):
+        if bias is not None:
+            raise ValueError("V4.1 block32 projections require bias-free weights")
+        return _apply_block32(layer, x)
+
+    def apply_into(self, layer, x: torch.Tensor, out: torch.Tensor) -> torch.Tensor:
+        _block32_linear(layer, x, out, current_preallocated_workspace())
+        return out
+
+    def apply_shards(
+        self,
+        layer,
+        x: torch.Tensor,
+        shards: tuple[tuple[torch.Tensor, torch.Tensor], ...],
+        out: torch.Tensor,
+    ) -> torch.Tensor:
+        _block32_linear_shards(
+            layer, x, shards, out, current_preallocated_workspace()
+        )
+        return out
+
+
+class TileLangBlock32Rows:
+    """Output rows ``start:`` of a loaded block-32 FP8 projection as their own GEMM.
+
+    The DSpark drafter projects the target's hidden states through only the KV
+    rows of each layer's fused Q-A/KV weight. Views of the weight and its scales
+    share the checkpoint storage; the owner must keep this object alive.
+    """
+
+    def __init__(self, layer: nn.Module, start: int):
+        if start % 32:
+            raise ValueError(f"rows from {start} do not start on a 32-row scale block")
+        stop = (
+            layer.logical_output_size
+            if getattr(layer, "part_output_size", 0) > 0
+            else layer.weight.shape[0]
+        )
+        self.weight = layer.weight[start:stop]
+        self.weight_scale_inv = layer.weight_scale_inv[start // 32 : stop // 32]
+        _block32_scale_words(self)
+
+    def declare_kernels(self) -> None:
+        """Declare the projection's kernels (its owner calls this when preparing)."""
+        _declare_block32(self)
+
+    def __call__(self, x: torch.Tensor) -> torch.Tensor:
+        return _apply_block32(self, x)
+
+
+class TileLangGroupedBlock32Rows:
+    """Multiple matching ``TileLangBlock32Rows`` stacked along N in one GEMM.
+
+    Concatenating identically shaped context-KV weights along N preserves each
+    output tile's exact reduction order when using the per-layer ``SPLIT_FP8``
+    schedule, while eliminating repeated activation reads and kernel launches.
+    """
+
+    def __init__(self, projections: list[TileLangBlock32Rows]):
+        if len(projections) < 2:
+            raise ValueError("grouped context projection requires at least two layers")
+        first = projections[0]
+        part_n, k = first.weight.shape
+        if any(p.weight.shape != (part_n, k) for p in projections):
+            raise ValueError("grouped context projections must share (N, K)")
+        self.part_n = part_n
+        self.slices = (part_n,) * len(projections)
+        self.weight = torch.cat([p.weight for p in projections], dim=0).contiguous()
+        self.weight_scale_inv = torch.cat(
+            [p.weight_scale_inv for p in projections], dim=0
+        ).contiguous()
+        self.tilelang_mxfp8_input = all(
+            getattr(p, "tilelang_mxfp8_input", False) for p in projections
+        )
+        _block32_scale_words(self, split_override=SPLIT_FP8.get((part_n, k)))
+
+    def declare_kernels(self) -> None:
+        """Declare kernels for the stacked N projection using the slice's split-K."""
+        k = self.weight.shape[1]
+        _declare_block32(self, split_override=SPLIT_FP8.get((self.part_n, k)))
+
+    def __call__(self, x: torch.Tensor) -> tuple[torch.Tensor, ...]:
+        return _apply_block32(self, x).split(self.slices, dim=-1)
+
+
+def _out_dtype(layer: nn.Module) -> str:
+    """The layer's output dtype as the GEMMs name it (set after construction)."""
+    return _TORCH_TO_TL[getattr(layer, "out_dtype", torch.bfloat16)]
+
+
+def _bf16_kernels(layer: nn.Module) -> dict:
+    """Every kernel of a BF16 projection of ``layer.weight``, as calls."""
+    n, k = layer.weight.shape
+    out_dtype = _out_dtype(layer)
+    shards = bf16_shards(n, k)
+    router = getattr(layer, "tilelang_router", None)
+    bounded_router = router is not None and router.max_rows is not None
+    kernels = {}
+    if shards == 1 or not bounded_router or router._gates_every_row():
+        kernels["gemm"] = prepare.call(
+            bf16_gemm, n, k, out_dtype=out_dtype, shards=shards
+        )
+    if shards > 1:
+        max_rows = router.max_rows if bounded_router else None
+        kernels["partials"] = {
+            block_M: prepare.call(bf16_gemm_partials, n, k, shards, block_M=block_M)
+            for i, block_M in enumerate(PARTIAL_ROW_TILES)
+            if i == 0 or max_rows is None or max_rows > PARTIAL_ROW_TILES[i - 1]
+        }
+        if not bounded_router:
+            kernels["reduce"] = prepare.call(
+                splitk_reduce, n, shards, out_dtype=out_dtype
+            )
+    return kernels
+
+
+class TileLangLinearMethod(UnquantizedLinearMethod):
+    """BF16 weights, BF16 or FP32 output (``layer.out_dtype``)."""
+
+    def declare_layer_kernels(self, layer: nn.Module) -> None:
+        n, k = layer.weight.shape
+        layer.tilelang_shards = bf16_shards(n, k)
+        layer.tilelang_split_rows = BF16_SPLIT_ROWS.get((n, k), DECODE_ROWS)
+
+        def bind() -> None:
+            for name, kernel in _launch(_bf16_kernels(layer)).items():
+                setattr(layer, f"tilelang_{name}", kernel)
+
+        prepare.declare(lambda: _calls(_bf16_kernels(layer)), bind=bind)
+
+    def process_weights_after_loading(self, layer: nn.Module) -> None:
+        """The checkpoint weight is used as loaded."""
+
+    def apply(
+        self, layer: nn.Module, x: torch.Tensor, bias: torch.Tensor | None = None
+    ) -> torch.Tensor:
+        if bias is not None:
+            raise ValueError("V4.1 native projections require bias-free weights")
+        out = torch.empty(
+            (*x.shape[:-1], layer.weight.shape[0]),
+            dtype=getattr(layer, "out_dtype", torch.bfloat16),
+            device=x.device,
+        )
+        _bf16_linear(layer, x, out, current_preallocated_workspace())
+        return out
+
+    def apply_into(
+        self, layer: nn.Module, x: torch.Tensor, out: torch.Tensor
+    ) -> torch.Tensor:
+        _bf16_linear(layer, x, out, current_preallocated_workspace())
+        return out
+
+    def apply_shards(
+        self,
+        layer: nn.Module,
+        x: torch.Tensor,
+        shards: tuple[torch.Tensor, ...],
+        out: torch.Tensor,
+    ) -> torch.Tensor:
+        _bf16_linear_shards(
+            layer, x, shards, out, current_preallocated_workspace()
+        )
+        return out
+
+    def get_workspace_size(self, layer, num_tokens: int) -> int:
+        return _spec_bytes(_partial_specs(layer, num_tokens))
+
+
+class TileLangScaledLinearMethod(TileLangLinearMethod):
+    """``TileLangLinearMethod`` with a power-of-two output scale folded into the
+    weight at load. Scaling by a power of two is exact in BF16 and commutes with
+    the FP32 accumulation, so the output equals the unscaled projection's times
+    ``scale``, bit for bit (checked on the weight), without a separate pass."""
+
+    def __init__(self, scale: float):
+        super().__init__()
+        if scale <= 0 or math.frexp(scale)[0] != 0.5:
+            raise ValueError(f"{scale} is not a power of two")
+        self.scale = scale
+
+    def process_weights_after_loading(self, layer: nn.Module) -> None:
+        weight = layer.weight.data
+        scaled = weight * self.scale
+        if not torch.equal(scaled / self.scale, weight):
+            raise ValueError(f"{self.scale} does not scale this weight exactly")
+        weight.copy_(scaled)
+
+
+def _bf16_shape(layer: nn.Module) -> tuple[int, int]:
+    """Logical ``(out_features, in_features)`` of an unpacked or 12-bit packed BF16 weight."""
+    return (
+        int(layer.weight.shape[0]),
+        int(getattr(layer, "packed_bf16_in_features", layer.weight.shape[1])),
+    )
+
+
+def pack_bf16_layer(layer: nn.Module, shards: int) -> None:
+    """Pack a contiguous CUDA BF16 weight in place when ``K`` and its shards are
+    multiples of ``GROUP`` (128)."""
+    if hasattr(layer, "packed_bf16_exponent_base"):
+        return
+    weight = layer.weight.data
+    if (
+        weight.ndim != 2
+        or weight.dtype != torch.bfloat16
+        or not weight.is_cuda
+        or not weight.is_contiguous()
+    ):
+        return
+    n, k = map(int, weight.shape)
+    if n == 0 or k == 0 or k % GROUP or (k // GROUP) % shards:
+        return
+    packed = pack_bf16_weight(weight, in_place=True)
+    layer.weight.data = packed.values
+    layer.packed_bf16_in_features = k
+    layer.packed_bf16_exponent_base = packed.exponent_base
+    layer.packed_bf16_exceptions = packed.exceptions
+    layer.weight_exception_entries = packed.exception_entries
+    layer.weight_row_offsets = packed.row_offsets
+
+
+def unpack_bf16_layer(layer: nn.Module) -> torch.Tensor:
+    """Return ``layer``'s logical ``[N, K]`` BF16 weight, unpacking 12-bit storage if packed."""
+    if not hasattr(layer, "packed_bf16_exponent_base"):
+        return layer.weight
+    n, k = _bf16_shape(layer)
+    packed = layer.weight
+    low = packed[:, :k].to(torch.int32)
+    codes = packed[:, k:].to(torch.int32)
+    code_a = codes & 0x0F
+    code_b = (codes >> 4) & 0x0F
+    exp_code = torch.stack(
+        (
+            code_a.view(n, k // GROUP, GROUP // 2),
+            code_b.view(n, k // GROUP, GROUP // 2),
+        ),
+        dim=2,
+    ).reshape(n, k)
+    base_minus_one = int(layer.packed_bf16_exponent_base) - 1
+    exp = torch.where(
+        exp_code > 0, exp_code + base_minus_one, torch.zeros_like(exp_code)
+    )
+    bits = ((low & 0x80) << 8) | (exp << 7) | (low & 0x7F)
+    entries = layer.weight_exception_entries
+    if entries.numel() > 0:
+        u = entries.to(torch.int64) & 0xFFFFFFFF
+        cols = u >> 16
+        exc_bits = (u & 0xFFFF).to(torch.int32)
+        offsets = layer.weight_row_offsets.to(torch.int64)
+        counts = offsets[1:] - offsets[:-1]
+        rows = torch.repeat_interleave(
+            torch.arange(n, device=bits.device, dtype=torch.int64), counts
+        )
+        bits[rows, cols] = exc_bits
+    return bits.to(torch.int16).view(torch.bfloat16)
+
+
+class TileLangSplitLinearMethod(UnquantizedLinearMethod):
+    """A BF16 weight of equal row blocks (the compressor's wkv and wgate), each
+    projected into its own output by one launch over the whole weight.
+
+    Weights are packed losslessly into 12-bit storage (``pack_bf16_weight``).
+    Decode rows (up to ``SPLIT_DECODE_ROWS``) split K over the SMs, unpack 12-bit
+    tiles in registers/shared memory with pre-MMA exception restoration, and add the
+    FP32 partials in shard order into the outputs; prefill rows unpack the weight
+    once into workspace scratch and run one warp-specialized GEMM that adds the same
+    shards in the same order, so a row's bits do not depend on the batch.
+    """
+
+    def __init__(self, parts: int):
+        super().__init__()
+        if parts not in (1, 2):
+            raise ValueError("the split projection has one or two parts")
+        self.parts = parts
+
+    def _split(self, layer: nn.Module) -> dict:
+        n, k = _bf16_shape(layer)
+        split = SPLIT_BF16.get((n, k)) or dict(shards=bf16_shards(n, k), blocked=False)
+        decode = split.get("decode", {})
+        if any("block_K" in config for config in decode.values()):
+            raise ValueError(
+                "split-K decode tiles keep block_K (it sets the sum order)"
+            )
+        return dict(shards=split["shards"], blocked=split["blocked"], decode=decode)
+
+    def process_weights_after_loading(self, layer: nn.Module) -> None:
+        """Pack the compressor's BF16 weight into exact 12-bit storage when enabled."""
+        if hasattr(layer, "_zero_pad_rows"):
+            layer._zero_pad_rows()
+        if getattr(layer, "pack_bf16", True):
+            pack_bf16_layer(layer, self._split(layer)["shards"])
+
+    def _kernels(self, layer: nn.Module) -> dict:
+        """Every kernel of the split projection, as calls."""
+        n, k = _bf16_shape(layer)
+        out_dtype = _out_dtype(layer)
+        split = self._split(layer)
+        shards, blocked, decode = split["shards"], split["blocked"], split["decode"]
+        packed_base = getattr(layer, "packed_bf16_exponent_base", None)
+        if self.parts == 2:
+            gemm = prepare.call(
+                bf16_gemm_two,
+                n // 2,
+                k,
+                out_dtype=out_dtype,
+                shards=shards,
+                blocked=blocked,
+            )
+        else:
+            gemm = prepare.call(
+                bf16_gemm, n, k, out_dtype=out_dtype, shards=shards, blocked=blocked
+            )
+        # Decode rows: one launch per call (the last CTA of a tile adds the shards).
+        splitk = {
+            block_M: (
+                prepare.call(
+                    packed_bf16_gemm_splitk,
+                    n,
+                    k,
+                    shards,
+                    packed_base,
+                    block_M=block_M,
+                    out_dtype=out_dtype,
+                    parts=self.parts,
+                    blocked=blocked,
+                    **decode.get(block_M, {}),
+                )
+                if packed_base is not None
+                else prepare.call(
+                    bf16_gemm_splitk,
+                    n,
+                    k,
+                    shards,
+                    block_M=block_M,
+                    out_dtype=out_dtype,
+                    parts=self.parts,
+                    blocked=blocked,
+                    **decode.get(block_M, {}),
+                )
+            )
+            for block_M in PARTIAL_ROW_TILES
+        }
+        kernels = {"gemm": gemm, "splitk": splitk}
+        if packed_base is not None:
+            kernels["unpack"] = prepare.call(packed_bf16_unpack, n, k, packed_base)
+        return kernels
+
+    def declare_layer_kernels(self, layer: nn.Module) -> None:
+        n, k = _bf16_shape(layer)
+        if n % self.parts:
+            raise ValueError(f"{n} rows do not split into {self.parts} parts")
+        layer.tilelang_parts = self.parts
+        layer.tilelang_shards = self._split(layer)["shards"]
+
+        def bind() -> None:
+            for name, kernel in _launch(self._kernels(layer)).items():
+                setattr(layer, f"tilelang_{name}", kernel)
+            # One zeroed counter per tile of the narrowest decode tile; every
+            # call leaves them zeroed.
+            decode = self._split(layer)["decode"]
+            block_N = min(
+                config.get("block_N", 64) for config in (*decode.values(), {})
+            )
+            split_rows = _split_rows(layer)
+            layer.tilelang_counters = torch.zeros(
+                (-(-split_rows // PARTIAL_ROW_TILES[0])) * (-(-n // block_N)),
+                dtype=torch.int32,
+                device=layer.weight.device,
+            )
+
+        prepare.declare(lambda: _calls(self._kernels(layer)), bind=bind)
+
+    def get_workspace_size(self, layer, num_tokens: int) -> int:
+        split_rows = _split_rows(layer)
+        rows = min(num_tokens, split_rows)
+        n, k = _bf16_shape(layer)
+        decode_bytes = _spec_bytes((((layer.tilelang_shards, rows, n), torch.float32),))
+        if num_tokens > split_rows and hasattr(
+            layer, "packed_bf16_exponent_base"
+        ):
+            return max(decode_bytes, _spec_bytes((((n, k), torch.bfloat16),)))
+        return decode_bytes
+
+
+def _split_rows(layer: nn.Module) -> int:
+    if not hasattr(layer, "packed_bf16_exponent_base"):
+        return SPLIT_DECODE_ROWS
+    n, k = _bf16_shape(layer)
+    cap = 512 if n <= 128 else 256
+    return max(SPLIT_DECODE_ROWS, min(cap, k // (2 * layer.tilelang_shards)))
+
+
+def _split_bf16(layer, x, outputs, scratch) -> None:
+    n, k = _bf16_shape(layer)
+    rows = x.shape[0]
+    packed = hasattr(layer, "packed_bf16_exponent_base")
+    if rows <= _split_rows(layer):
+        (partials,) = _scratch(
+            (((layer.tilelang_shards, rows, n), torch.float32),), scratch
+        )
+        block_M = next(
+            (bm for bm in PARTIAL_ROW_TILES if rows <= bm), PARTIAL_ROW_TILES[-1]
+        )
+        if packed:
+            layer.tilelang_splitk[block_M](
+                x,
+                layer.weight,
+                layer.weight_exception_entries,
+                layer.weight_row_offsets,
+                partials,
+                layer.tilelang_counters,
+                *outputs,
+            )
+        else:
+            layer.tilelang_splitk[block_M](
+                x, layer.weight, partials, layer.tilelang_counters, *outputs
+            )
+    elif packed:
+        (weight_scratch,) = _scratch((((n, k), torch.bfloat16),), scratch)
+        layer.tilelang_unpack(
+            layer.weight,
+            layer.weight_exception_entries,
+            layer.weight_row_offsets,
+            weight_scratch,
+        )
+        layer.tilelang_gemm(x, weight_scratch, *outputs)
+    else:
+        layer.tilelang_gemm(x, layer.weight, *outputs)
+
+
+def project_parts(layer: nn.Module, x: torch.Tensor, outputs, rows: int) -> None:
+    """Project ``x`` (rows x K) through a split layer: each row block into the
+    first ``rows`` rows of its output."""
+    scratch = current_preallocated_workspace()
+    if layer.tilelang_parts == 2:
+        _split_bf16(layer, x, (outputs[0][:rows], outputs[1][:rows]), scratch)
+    else:
+        _split_bf16(layer, x, (outputs[0][:rows],), scratch)
+
+
+__all__ = [
+    "MXFP8Rows",
+    "TileLangBlock32Rows",
+    "TileLangFP8LinearMethod",
+    "TileLangLinearMethod",
+    "TileLangScaledLinearMethod",
+    "TileLangSplitLinearMethod",
+    "cast_mxfp8",
+    "empty_mxfp8",
+    "mxfp8_rows",
+    "project_bf16_partials",
+    "project_parts",
+    "provide_mxfp8",
+    "provided_mxfp8",
+    "slice_mxfp8",
+    "try_provided_mxfp8",
+]
