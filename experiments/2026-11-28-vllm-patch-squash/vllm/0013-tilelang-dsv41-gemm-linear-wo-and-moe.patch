+        32: dict(block_N=32, block_K=256, num_stages=3, threads=128),
+        48: dict(block_N=32, block_K=256, num_stages=3, threads=128),
+        64: dict(block_N=32, block_K=256, num_stages=3, threads=128),
+    },
+}
