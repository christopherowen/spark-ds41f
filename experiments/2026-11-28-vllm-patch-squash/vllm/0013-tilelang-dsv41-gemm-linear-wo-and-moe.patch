+                A0_shared = T.alloc_shared((block_M, _PACKED_HALF), T.bfloat16)
+                A1_shared = T.alloc_shared((block_M, _PACKED_HALF), T.bfloat16)
+                B0_shared = T.alloc_shared((block_N, _PACKED_HALF), T.bfloat16)
+                if not single_b:
