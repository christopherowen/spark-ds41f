+                else:
+                    T.copy(C_local, C0[by * block_M, bx * block_N])
+            else:
+                if shards > 1:
+                    T.copy(C_total, C1[by * block_M, (bx - tiles) * block_N])
+                else:
+                    T.copy(C_local, C1[by * block_M, (bx - tiles) * block_N])
+
+    return gemm_packed_bf16_two
