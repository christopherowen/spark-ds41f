+@tilelang.jit(pass_configs={tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True})
+def packed_bf16_gemm_two(
+    N: int,
+    K: int,
+    exponent_base: int,
+    block_M: int = 64,
+    block_N: int = 64,
+    num_stages: int = 2,
+    threads: int = 128,
