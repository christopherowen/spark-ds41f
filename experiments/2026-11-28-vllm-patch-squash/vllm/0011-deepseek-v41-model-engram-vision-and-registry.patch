+def _load_checkpoint_router_biases(
+    model_path: str | Path | None,
+    layer_indices: list[int],
+    num_experts: int,
+) -> list[torch.Tensor]:
+    """Load ``ffn.gate.bias`` per layer from safetensors before weights load.
+
+    Checkpoint shards visit ``layers.L.ffn.experts.*`` before
+    ``layers.L.ffn.gate.bias``, so MoE layers finalizing online need their
+    router biases pre-read for hot-expert ranking and entropy slot budgeting.
+    """
+    biases: dict[int, torch.Tensor] = {}
+    model_dir = Path(model_path) if model_path else None
+    if model_dir is not None and model_dir.is_dir():
+        index_path = model_dir / "model.safetensors.index.json"
+        candidates: list[tuple[int, str]] = []
+        for idx in layer_indices:
+            for key in (
+                f"layers.{idx}.ffn.gate.bias",
+                f"model.layers.{idx}.ffn.gate.bias",
+                f"layers.{idx}.ffn.gate.e_score_correction_bias",
+                f"model.layers.{idx}.ffn.gate.e_score_correction_bias",
+            ):
+                candidates.append((idx, key))
+
+        shard_to_reqs: dict[Path, list[tuple[int, str]]] = {}
+        if index_path.is_file():
+            try:
+                weight_map: dict[str, str] = json.loads(index_path.read_text()).get(
+                    "weight_map", {}
+                )
+                for idx, key in candidates:
+                    if idx in biases:
+                        continue
+                    rel = weight_map.get(key)
+                    if rel:
+                        shard_to_reqs.setdefault(model_dir / rel, []).append((idx, key))
+            except Exception as exc:
+                logger.warning("Failed reading %s for router biases: %s", index_path, exc)
+        else:
+            single = model_dir / "model.safetensors"
+            if single.is_file():
+                shard_to_reqs[single] = candidates
+
+        if shard_to_reqs:
+            from safetensors import safe_open
+
+            for shard_path, reqs in shard_to_reqs.items():
+                if not shard_path.is_file():
+                    continue
+                try:
+                    with safe_open(str(shard_path), framework="pt", device="cpu") as f:
+                        available = set(f.keys())
+                        for idx, key in reqs:
+                            if idx not in biases and key in available:
+                                t = f.get_tensor(key)
+                                if t.numel() == num_experts:
+                                    biases[idx] = t.detach().to(torch.float32).cpu().clone()
+                except Exception as exc:
+                    logger.warning(
+                        "Failed reading router biases from %s: %s", shard_path, exc
+                    )
+
+    return [
+        biases.get(idx, torch.zeros(num_experts, dtype=torch.float32))
+        for idx in layer_indices
+    ]
+
