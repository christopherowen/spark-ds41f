+#define PY_SSIZE_T_CLEAN
+#include <Python.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <liburing.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#define READER_CAPSULE "vllm.expert_slots.reader"
+#define ABI_VERSION 1
+#define RING_DEPTH 1024u
+#define PACK_HEADER_BYTES 4096u
+
+enum {
+    KIND_W13_TILES = 1u,
+    KIND_W13_META = 2u,
+    KIND_W2_TILES = 3u,
+    KIND_W2_META = 4u
+};
+
+enum {
+    ROLE_W13 = 0,
+    ROLE_W2 = 1,
+    ROLE_ALL = 2
