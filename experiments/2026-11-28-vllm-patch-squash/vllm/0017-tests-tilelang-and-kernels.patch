+    graph = _graph(chain.run)
+    for replay in range(REPLAYS):
+        chain.poison()
+        graph.replay()
+        torch.cuda.synchronize()
+        got = chain.digests()
+        differ = [name for name in want if got[name] != want[name]]
+        assert not differ, f"replay {replay}: {differ} differ from the eager run"
