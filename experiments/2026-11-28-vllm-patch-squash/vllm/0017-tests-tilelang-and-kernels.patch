+    assert packed.narrow.tolist() == [1, 0, 1]
+    narrow = tile_byte_codes(packed.codes_2bit, _BLOCK_N)
+    wide = tile_codes(packed.codes, _BLOCK_N)
+    n_blocks, words = 256 // _BLOCK_N, packed.codes.shape[-1]
+    assert words == 5
