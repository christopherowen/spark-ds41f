+            offset = position % page_size
+            inp["pool"][page, offset * 64 : offset * 64 + 64] = 0xFF
+            words = page_size * 64 + offset * 4
+            inp["pool"][page, words : words + 4] = 0xFF
+    _, poisoned = plan.run(*(inp[k] for k in names))
