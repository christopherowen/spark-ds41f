+@pytest.mark.parametrize("rows", [12, 300])
+def test_moe_experts_nan_token_stays_in_its_row(rows):
+    """A NaN in one token's input changes no other token's bits, though the expert
+    tiles mix tokens."""
+    run, x, *_ = _case(rows)
