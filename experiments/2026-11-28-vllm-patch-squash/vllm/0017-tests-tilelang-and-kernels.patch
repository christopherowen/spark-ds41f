+@pytest.mark.parametrize(
+    "width, topk, group",
+    [
+        (4096, INDEX_TOPK, 1),  # one pass
+        (32768, INDEX_TOPK, 1),  # one merge
+        (300000, INDEX_TOPK, 1),  # one merge
+        (600000, INDEX_TOPK, 1),  # two merge levels
+        (32768, CANDIDATE_BLOCKS, CANDIDATE_BLOCK),  # grouped, one pass
