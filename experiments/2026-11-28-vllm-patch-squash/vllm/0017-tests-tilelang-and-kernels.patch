+        assert torch.equal(wide[row], packed.codes[expert, logical, ko])
+    wide_rows = slice(n_blocks * words, 2 * n_blocks * words)
+    assert torch.equal(narrow[wide_rows], torch.zeros_like(narrow[wide_rows]))
