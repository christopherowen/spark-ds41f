+    names = ("q_packed", "q_scales", "weights", "pool", "page_table", "lengths")
+    ids = torch.full((rows, CANDIDATE_BLOCKS), -7, dtype=torch.int32, device=DEVICE)
+    counts = torch.full((rows,), -7, dtype=torch.int32, device=DEVICE)
