+    )[:, : kv_page_size * 288]
+    kv_fused = kv_sep.clone()
+
+    out_sep = torch.full((CAPACITY, DIM), 5.0, dtype=torch.bfloat16, device=DEVICE)
+    emitted_sep = torch.ones(CAPACITY, dtype=torch.bool, device=DEVICE)
