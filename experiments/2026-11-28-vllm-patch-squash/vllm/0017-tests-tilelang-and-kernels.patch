+def _table():
+    inv = 1.0 / (10000 ** (torch.arange(0, ROPE, 2, device=DEVICE).double() / ROPE))
+    angles = torch.arange(POSITIONS, device=DEVICE).double()[:, None] * inv
+    return torch.cat((angles.cos(), angles.sin()), dim=-1).float()
