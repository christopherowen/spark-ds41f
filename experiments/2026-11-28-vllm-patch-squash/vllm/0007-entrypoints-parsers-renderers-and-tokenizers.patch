+    _HEADLESS_ENTRY_STATES = frozenset(
+        {
+            ParserState.CONTENT,
+            ParserState.REASONING,
+            ParserState.TOOL_PREAMBLE,
+            ParserState.TOOL_BETWEEN,
+        }
