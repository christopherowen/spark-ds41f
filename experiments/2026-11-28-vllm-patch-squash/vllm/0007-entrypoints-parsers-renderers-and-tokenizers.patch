+
+        def _v41_close_open_headless_param(self) -> None:
+            if self._v41_raw_open_param(self._v41_headless_raw):
+                spans = (
+                    ((_PARAM_CLOSE_ATOM, _PARAM_CLOSE_ATOM + len(DSML_ATOM)),)
