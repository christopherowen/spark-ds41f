+# Bounded per-tokenizer piece cache (message/turn chunks -> token IDs).
+_MAX_SEGMENT_CACHE = 8192
+_MAX_CACHE_BYTES = 64 * 1024 * 1024
+_MIN_FAST_PATH_CHARS = 1024
+_PARALLEL_CHUNK_THRESHOLD = 65536
+_PARALLEL_CHUNK_TARGET = 16384
