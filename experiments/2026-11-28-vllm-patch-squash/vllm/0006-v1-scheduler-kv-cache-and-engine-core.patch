@@ -427,8 +445,199 @@ class KVCacheCoordinator(ABC):
         Args:
             request_id: The request ID.
         """
-        for manager in self.single_type_managers:
-            manager.free(request_id)
+        if len(self.single_type_managers) <= 1:
+            for manager in self.single_type_managers:
+                manager.free(request_id)
+            return
+
+        # Two-tier hybrid tail-to-root eviction order:
+        # - Tier 0 (aged SWA head, right after unhashed free blocks): older
+        #   non-anchored SWA blocks ordered descending by end_token so light
+        #   pool pressure evicts superseded interior SWA blocks before any
+        #   live full-attention block.
+        # - Tier 1 (active conversation tail-to-root run at MRU tail): all
+        #   full-attention blocks paired with the active turn-endpoint SWA
+        #   checkpoint (max_full_end) and a sparse fallback SWA checkpoint
+        #   ladder (root + highest checkpoint <= max_full_end - 1024, plus
+        #   4096-token multiples when > 32 checkpoints exist) so deep eviction
+        #   steps down cleanly to retained checkpoints without collapsing to 0.
+        max_full_end = 0
+        full_items: list[tuple[int, int, int, int, KVCacheBlock, object]] = []
+        swa_retained_by_group: dict[
+            int, tuple[SlidingWindowManager, dict[int, tuple[KVCacheBlock, object]]]
+        ] = {}
+        for group_id, manager in enumerate(self.single_type_managers):
+            if not manager.enable_caching:
+                continue
+            is_sparse = (
+                1 if isinstance(manager, (SlidingWindowManager, MambaManager)) else 0
+            )
+            block_size = manager.block_size
+            if isinstance(manager, SlidingWindowManager):
+                retained = manager._req_retained_blocks.get(request_id)
+                if retained:
+                    swa_retained_by_group[group_id] = (manager, dict(retained))
+            else:
+                for blk_idx, blk in enumerate(
+                    manager.req_to_blocks.get(request_id, ())
+                ):
+                    if not blk.is_null and blk.block_hash is not None:
+                        end_token = (blk_idx + 1) * block_size
+                        if end_token > max_full_end:
+                            max_full_end = end_token
+                        full_items.append(
+                            (
+                                end_token,
+                                is_sparse,
+                                group_id,
+                                blk_idx,
+                                blk,
+                                blk.block_hash,
+                            )
+                        )
+
+        blocks = self.pop_blocks_for_free(request_id)
+        self.block_pool.free_blocks(reversed(blocks))
+
+        if not swa_retained_by_group or max_full_end <= 0:
+            return
+
+        anchored_items: list[tuple[int, int, int, int, KVCacheBlock, object]] = []
+        aged_items: list[tuple[int, int, int, int, KVCacheBlock, object]] = []
+        for group_id, (manager, retained) in swa_retained_by_group.items():
+            block_size = manager.block_size
+            align = manager.cache_hit_alignment_tokens
+            valid: list[tuple[int, int, KVCacheBlock, object]] = []
+            for blk_idx, (blk, expected_hash) in sorted(retained.items()):
+                end_token = (blk_idx + 1) * block_size
+                if (
+                    end_token <= max_full_end
+                    and not blk.is_null
+                    and blk.ref_cnt == 0
+                    and blk.block_hash == expected_hash
+                    and (blk.pool is None or blk.pool is self.block_pool)
+                    and blk.prev_free_block is not None
+                    and blk.next_free_block is not None
+                ):
+                    valid.append((end_token, blk_idx, blk, expected_hash))
+            if not valid:
+                continue
+
+            anchored_ends: set[int] = {max_full_end}
+            below = [
+                item
+                for item in valid
+                if item[0] <= max_full_end - 1024 and item[0] % align == 0
+            ]
+            if not below:
+                below = [
+                    item
+                    for item in valid
+                    if item[0] < max_full_end and item[0] % align == 0
+                ]
+            if below:
+                anchored_ends.add(below[0][0])
+                anchored_ends.add(below[-1][0])
+                if len(below) > 32:
+                    for end_token, _, _, _ in below:
+                        if end_token % 4096 == 0:
+                            anchored_ends.add(end_token)
+
+            for end_token, blk_idx, blk, expected_hash in valid:
+                entry = (end_token, 1, group_id, blk_idx, blk, expected_hash)
+                if end_token in anchored_ends:
+                    anchored_items.append(entry)
+                else:
+                    aged_items.append(entry)
+
+        queue = self.block_pool.free_block_queue
+        if aged_items:
+            aged_items.sort(
+                key=lambda item: (-item[0], item[1], item[2], -item[3])
+            )
+            seen_aged: set[int] = set()
+            ordered_aged: list[KVCacheBlock] = []
+            for _, _, _, _, blk, _ in aged_items:
+                if blk.block_id not in seen_aged:
+                    seen_aged.add(blk.block_id)
+                    ordered_aged.append(blk)
+            # Locate the unhashed/hashed boundary in O(1) when the pool is full
+            # (or O(cached blocks) backward from ordered_aged[-1] when large
+            # unhashed free capacity sits at fake_free_list_head).
+            curr = queue.fake_free_list_head.next_free_block
+            steps = 0
+            while (
+                curr is not None
+                and curr is not queue.fake_free_list_tail
+                and curr.block_hash is None
+                and steps < 8
+            ):
+                curr = curr.next_free_block
+                steps += 1
+            if (
+                curr is not None
+                and curr is not queue.fake_free_list_tail
+                and curr.block_hash is None
+            ):
+                scan = ordered_aged[-1]
+                while scan.prev_free_block is not None and (
+                    scan.prev_free_block is not queue.fake_free_list_head
+                ):
+                    prev = scan.prev_free_block
+                    if prev.block_hash is not None:
+                        scan = prev
+                    elif (
+                        prev.prev_free_block is not None
+                        and prev.prev_free_block is not queue.fake_free_list_head
+                        and prev.prev_free_block.block_hash is not None
+                    ):
+                        scan = prev.prev_free_block
+                    else:
+                        break
+                anchor_prev = (
+                    scan.prev_free_block
+                    if scan.prev_free_block is not None
+                    else queue.fake_free_list_head
+                )
+            else:
+                anchor_prev = (
+                    curr.prev_free_block
+                    if curr is not None and curr.prev_free_block is not None
+                    else queue.fake_free_list_head
+                )
+            for blk in ordered_aged:
+                queue.remove(blk)
+            next_node = anchor_prev.next_free_block
+            assert next_node is not None
+            prev_node = anchor_prev
+            for blk in ordered_aged:
+                blk.prev_free_block = prev_node
+                prev_node.next_free_block = blk
+                prev_node = blk
+            prev_node.next_free_block = next_node
+            next_node.prev_free_block = prev_node
+            queue.num_free_blocks += len(ordered_aged)
+
+        run_items = full_items + anchored_items
+        run_items.sort(key=lambda item: (-item[0], item[1], item[2], -item[3]))
+        seen_run: set[int] = set()
+        ordered_run: list[KVCacheBlock] = []
+        for _, _, _, _, blk, expected_hash in run_items:
+            if (
+                blk.block_id not in seen_run
+                and blk.ref_cnt == 0
+                and not blk.is_null
+                and blk.block_hash == expected_hash
+                and (blk.pool is None or blk.pool is self.block_pool)
+                and blk.prev_free_block is not None
+                and blk.next_free_block is not None
+            ):
+                seen_run.add(blk.block_id)
+                ordered_run.append(blk)
+        if ordered_run:
+            for blk in ordered_run:
+                queue.remove(blk)
+            queue.append_n(ordered_run)
 
