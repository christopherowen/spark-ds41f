+def _find_windowed_repeating_pattern(
+    token_ids: Sequence[int],
+    min_pattern_size: int,
+    max_pattern_size: int,
+    min_count: int,
+    start_idx: int = 0,
+    window_size: int = 160,
+    min_density: float = 0.6,
