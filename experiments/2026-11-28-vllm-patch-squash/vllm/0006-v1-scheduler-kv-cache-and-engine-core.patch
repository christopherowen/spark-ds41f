-            blocks.extend(manager.pop_blocks_for_free(request_id))
-        return blocks
+        if len(self.single_type_managers) <= 1:
+            blocks: list[KVCacheBlock] = []
+            for manager in self.single_type_managers:
+                blocks.extend(manager.pop_blocks_for_free(request_id))
+            return blocks
+
+        tagged_blocks: list[tuple[int, int, int, int, KVCacheBlock]] = []
+        for group_id, manager in enumerate(self.single_type_managers):
+            is_sparse = (
+                1 if isinstance(manager, (SlidingWindowManager, MambaManager)) else 0
+            )
+            block_size = manager.block_size
+            for blk_idx, blk in enumerate(manager.pop_blocks_for_free(request_id)):
+                end_token = (blk_idx + 1) * block_size
+                tagged_blocks.append((end_token, -is_sparse, -group_id, blk_idx, blk))
+        tagged_blocks.sort(key=lambda item: item[:4])
+        return [item[4] for item in tagged_blocks]
 
