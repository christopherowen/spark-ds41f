 _INIT_SLOPE = 0.5
 _INIT_BIAS = -0.2
 
+# A trained scalar confidence head (e.g. DSpark's confidence_head) already
+# emits a probability in (0, 1); start at identity in log-odds space (slope 1,
+# intercept 0) so cold-start predictions match the raw head until the first
+# online IRLS refit calibrates the per-position decay and slope.
+_INIT_CONFIDENCE_HEAD_SLOPE = 1.0
+_INIT_CONFIDENCE_HEAD_BIAS = 0.0
+
+# Empirical per-position log-odds calibration intercepts fitted across DSpark's
+# 5-step Markov confidence head on DeepSeek-V4.1-Flash (positions 0..4).
+# Maps DSpark's overconfident raw head onto empirical conditional acceptance from
+# step 0 so c1 avoids cold-boot starvation during the initial IRLS window while
+# still adapting online.
+_WARM_CONFIDENCE_HEAD_INTERCEPTS: tuple[float, ...] = (
+    -0.52,
+    -0.64,
+    -0.96,
+    -0.85,
+    -0.74,
+)
+
+
+# A confidence head that takes the draft's top-2 logit margin calibrates on
+# ``logit(p) + _CONFIDENCE_MARGIN_GAIN * log(1 + margin)`` (the TileLang head's fused
+# kernel, whose MARGIN_GAIN this is). Its start: the slope and the intercept shifts
+# between the two fits on the AgentX turns of
+# experiments/2026-11-17-draft-calibration-sizing (slope 1.086 -> 0.728, intercepts
+# lower by 0.89, 1.15, 1.29, 1.40, 1.49), applied to the values above.
+_CONFIDENCE_MARGIN_GAIN = 2.0
+_WARM_MARGIN_CONFIDENCE_SLOPE = 0.67
+_WARM_MARGIN_CONFIDENCE_INTERCEPTS: tuple[float, ...] = (
+    -1.41,
+    -1.79,
+    -2.25,
+    -2.25,
+    -2.23,
+)
+# Bound on the margin (confidence.MARGIN_CAP).
+_MARGIN_CAP = 64.0
+
+
+def add_margin_to_confidence_probs(
+    confidence_probs: torch.Tensor,
+    margins: torch.Tensor,
+    gain: float = _CONFIDENCE_MARGIN_GAIN,
+) -> None:
+    """``p <- sigmoid(logit(p) + gain * log(1 + margin))`` in place, for the paths
+    that calibrate the head's probabilities outside its fused kernel. ``margins``
+    has ``confidence_probs``' elements in its order; a row the drafter left at 0
+    stays 0, and a NaN margin counts as 0."""
+    raw = confidence_probs.float()
+    eps = 1e-6
+    clamped = raw.clamp(eps, 1.0 - eps)
+    features = torch.log(clamped / (1.0 - clamped)).clamp(-_MAX_LOG_ODDS, _MAX_LOG_ODDS)
+    margin = torch.nan_to_num(margins.float().view_as(raw), nan=0.0).clamp(
+        0.0, _MARGIN_CAP
+    )
+    features = (features + gain * torch.log1p(margin)).clamp(
+        -_MAX_LOG_ODDS, _MAX_LOG_ODDS
+    )
+    probs = torch.where(raw > 0.0, torch.sigmoid(features), torch.zeros_like(raw))
+    confidence_probs.copy_(probs.to(confidence_probs.dtype))
+
 
