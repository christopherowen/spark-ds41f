+    compute_local_stats_shard(
+        local_stats,
+        target_logits,
+        draft_sampled,
+        expanded_idx_mapping,
+        expanded_local_pos,
+        temperature,
+        steps,
+        vocab_start,
+        apply_temperature,
+    )
