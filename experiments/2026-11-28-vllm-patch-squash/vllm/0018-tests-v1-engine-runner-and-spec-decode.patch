+    biases = torch.zeros((states, width), device="cuda")
+    min_lens = zeros + 5
+    num_stops = zeros + 3
+    restore_rows = zeros + 1
+    stops = torch.zeros((states, width), device="cuda", dtype=torch.int32)
+    stops[:, :3] = torch.tensor([0, 1, 2], device="cuda", dtype=torch.int32)
+    expected = logits.clone()
+    _bias_kernel[(rows,)](
+        expected,
+        expected.stride(0),
+        vocab,
+        mapping,
+        zeros,
+        allowed,
+        allowed.stride(0),
+        zeros,
+        bias_ids,
+        bias_ids.stride(0),
+        biases,
+        biases.stride(0),
+        positions,
+        min_lens,
+        num_stops,
+        restore_rows,
+        stops,
+        stops.stride(0),
+        BLOCK_SIZE=width,
+        LOGITS_BLOCK_SIZE=8192,
+        CHECK_ALL_MASKED_ROWS=True,
