+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Aligned prefill chunks: a chunk ends at an absolute multiple of the threshold."""
+
+import functools
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from vllm.v1.core.sched import scheduler as scheduler_module
+
+
+def _chunk(
+    threshold,
+    computed,
+    remaining,
+    *,
+    num_runnable_decodes=0,
+    prefill_yield=True,
+):
+    owner = SimpleNamespace(
+        scheduler_config=SimpleNamespace(long_prefill_token_threshold=threshold),
+        prefill_yield=prefill_yield,
+    )
+    return scheduler_module.Scheduler._aligned_prefill_chunk(
+        owner, computed, remaining, num_runnable_decodes
+    )
+
+
+def test_chunks_end_at_multiples_of_the_threshold():
+    assert _chunk(400, 0, 800) == 400
+    assert _chunk(400, 400, 400) == 400
+    assert _chunk(400, 0, 150) == 150  # the prompt ends first
+    # A prefix-cache hit of 1536 tokens: the first chunk ends at 8096, as in a
+    # cold run, not 8096 tokens later.
+    assert _chunk(8096, 1536, 9000) == 6560
+    assert _chunk(0, 1536, 5000) == 5000  # no threshold: unchanged
+
+
+def test_a_whole_chunk_must_fit_beside_the_decode_rows():
+    def check(threshold, budget, seqs=16, spec=5, lookahead=5):
+        # VllmConfig.max_decode_rows: every stream at the drafter's block, and
+        # one request's copy drafts past it.
+        owner = SimpleNamespace(
+            scheduler_config=SimpleNamespace(long_prefill_token_threshold=threshold),
+            max_decode_rows=seqs * (1 + spec) + lookahead - spec,
+            max_num_scheduled_tokens=budget,
+        )
+        scheduler_module.Scheduler._check_aligned_prefill_chunks(owner)
+
+    check(8096, 8192)  # TP4: 16 streams of six rows beside a chunk
+    check(4048, 4096, seqs=8)  # TP3
+    # Copy drafts to 16: one stream of 17 rows, the others six.
+    check(8085, 8192, lookahead=16)
+    check(4037, 4096, seqs=8, lookahead=16)
+    for threshold, budget, lookahead in (
+        (8192, 8192, 5),
+        (0, 8192, 5),
+        (8097, 8192, 5),
+        (8096, 8192, 16),
+    ):
+        with pytest.raises(ValueError):
+            check(threshold, budget, lookahead=lookahead)
+
+
+# A minimal OPT-125m configuration, so the scheduler builds without the hub.
+_OPT_CONFIG = {
+    "architectures": ["OPTForCausalLM"],
+    "model_type": "opt",
+    "hidden_size": 768,
+    "num_attention_heads": 12,
+    "num_hidden_layers": 12,
+    "ffn_dim": 3072,
+    "max_position_embeddings": 2048,
+    "vocab_size": 50272,
+    "word_embed_proj_dim": 768,
+    "torch_dtype": "float16",
+    "do_layer_norm_before": True,
+    "pad_token_id": 1,
+    "bos_token_id": 2,
+    "eos_token_id": 2,
+}
+
+
+def _scheduled(monkeypatch, tmp_path, aligned):
+    # The scheduler fixtures live in the source tree's tests, not in every image.
+    utils = pytest.importorskip("tests.v1.core.utils")
+    create_requests, create_scheduler = utils.create_requests, utils.create_scheduler
+    # DeepSeek V4.1's configuration sets the flag; this OPT model takes it here.
+    monkeypatch.setattr(
+        utils,
+        "SchedulerConfig",
+        functools.partial(utils.SchedulerConfig, align_prefill_chunks=aligned),
+    )
+    (tmp_path / "config.json").write_text(json.dumps(_OPT_CONFIG))
+    scheduler = create_scheduler(
+        model=str(tmp_path),
+        max_num_batched_tokens=1024,
+        long_prefill_token_threshold=400,
+        skip_tokenizer_init=True,
+        device="cpu",
+    )
+    requests = create_requests(num_requests=3, num_tokens=800)
+    for request in requests:
+        scheduler.add_request(request)
+    return requests, scheduler.schedule().num_scheduled_tokens
+
+
+def test_no_partial_chunk_when_the_budget_is_short(monkeypatch, tmp_path):
+    requests, scheduled = _scheduled(monkeypatch, tmp_path, aligned=True)
+    assert scheduled[requests[0].request_id] == 400
+    assert scheduled[requests[1].request_id] == 400
+    assert requests[2].request_id not in scheduled
+
+
+def test_off_the_third_request_takes_what_is_left(monkeypatch, tmp_path):
+    requests, scheduled = _scheduled(monkeypatch, tmp_path, aligned=False)
+    assert scheduled[requests[2].request_id] == 224
+
+
+def test_deep_context_chunk_grid_zero_extra_chunks_below_256k():
+    # For all contexts < 256K (0..262143), including the 128K (131072) grid and
+    # stall-* suites, chunks remain at full threshold even when decodes are active.
+    for threshold, expected_128k_chunks in ((6096, 22), (16288, 9)):
+        computed = 0
+        chunks = 0
+        while computed < 131072:
+            step = _chunk(
+                threshold,
+                computed,
+                131072 - computed,
+                num_runnable_decodes=15,
+                prefill_yield=True,
+            )
+            assert step == min(threshold, 131072 - computed)
+            computed += step
+            chunks += 1
+        assert chunks == expected_128k_chunks
+
+
+def test_deep_context_chunk_grid_steps_down_at_256k_and_512k_when_decodes_active():
+    # Solo prefill (num_runnable_decodes == 0) or prefill_yield="off": full threshold
+    # at all contexts up to 1M.
+    for context in (0, 131072, 262144, 524288, 900000):
+        for threshold in (6096, 16288):
+            assert (
+                _chunk(threshold, context, 32768, num_runnable_decodes=0)
+                == threshold - context % threshold
+            )
+            assert (
+                _chunk(
+                    threshold,
+                    context,
+                    32768,
+                    num_runnable_decodes=7,
+                    prefill_yield=False,
+                )
+                == threshold - context % threshold
+            )
+
+    # 256K <= context < 512K with active decodes: 4,096-token tier on 2,048 grid.
+    for context in (262144, 327680, 520192):
+        for threshold in (6096, 16288):
+            assert (
+                _chunk(threshold, context, 32768, num_runnable_decodes=7)
+                == 4096 - context % 4096
+            )
+
+    # context >= 512K with active decodes: 2,048-token tier on 2,048 grid.
+    for context in (524288, 655360, 901120):
+        for threshold in (6096, 16288):
+            assert (
+                _chunk(threshold, context, 32768, num_runnable_decodes=7)
+                == 2048 - context % 2048
+            )
+
+    # Crossing 256K from 44 full TP3 chunks (44 * 6096 = 268224) snaps onto
+    # the 4,096 / 2,048 grid in one transition chunk (2112 tokens -> 270336),
+    # then takes exact 4,096 chunks up to 524288 and 2,048 chunks thereafter.
+    c = 44 * 6096
+    transition = _chunk(6096, c, 900000 - c, num_runnable_decodes=7)
+    assert transition == 2112
+    assert (c + transition) % 4096 == 0
+    assert _chunk(6096, c + transition, 900000 - (c + transition), num_runnable_decodes=7) == 4096
+
+
+def test_deep_context_mixed_step_caps_total_prefill_tokens_to_active_tier(
+    monkeypatch, tmp_path
+):
+    utils = pytest.importorskip("tests.v1.core.utils")
+    monkeypatch.setattr(
+        utils,
+        "SchedulerConfig",
+        functools.partial(
+            utils.SchedulerConfig,
+            align_prefill_chunks=True,
+            prefill_yield="short",
+        ),
+    )
+    cfg = dict(_OPT_CONFIG, max_position_embeddings=600000)
+    (tmp_path / "config.json").write_text(json.dumps(cfg))
+    scheduler = utils.create_scheduler(
+        model=str(tmp_path),
+        max_num_seqs=16,
+        max_num_batched_tokens=6144,
+        long_prefill_token_threshold=6096,
+        max_model_len=600000,
+        num_blocks=40000,
+        skip_tokenizer_init=True,
+        device="cpu",
+    )
+    (dec,) = utils.create_requests(num_requests=1, num_tokens=32, req_ids=["dec"])
+    dec.max_tokens = 100
+    scheduler.add_request(dec)
+    out0 = scheduler.schedule()
+    assert out0.num_scheduled_tokens == {"dec": 32}
+    dec.append_output_token_ids(0)
+
+    # Admit a deep-context request and advance it to 262,144 computed tokens.
+    (deep,) = utils.create_requests(
+        num_requests=1, num_tokens=270336, req_ids=["deep"]
+    )
+    deep.max_tokens = 10
+    scheduler.add_request(deep)
+    # Schedule first chunk to move deep into running, then set computed to 262144
+    out1 = scheduler.schedule()
+    assert out1.num_scheduled_tokens["deep"] == 6096
+    dec.append_output_token_ids(0)
+    # Advance through the 2 interleaved decode steps after the 6,096 chunk
+    for _ in range(2):
+        out_i = scheduler.schedule()
+        assert out_i.num_scheduled_tokens == {"dec": 1}
+        dec.append_output_token_ids(0)
+
+    # Allocate blocks up to 262144 and set computed tokens to 262144 (256K).
+    scheduler.kv_cache_manager.allocate_slots(deep, 262144 - deep.num_computed_tokens)
+    deep.num_computed_tokens = 262144
+
+    # Also queue a second long prefill request (> long_prefill_token_threshold
+    # so short-prompt yield does not preempt deep); at 256K with decodes active,
+    # deep gets 4,096 tokens and the step prefill cap prevents extra_req from
+    # filling the remaining 2,047 tokens of max_num_batched_tokens.
+    (extra_req,) = utils.create_requests(
+        num_requests=1, num_tokens=20000, req_ids=["extra"]
+    )
+    scheduler.add_request(extra_req)
+    out_deep = scheduler.schedule()
+    assert out_deep.num_scheduled_tokens == {"dec": 1, "deep": 4096}
