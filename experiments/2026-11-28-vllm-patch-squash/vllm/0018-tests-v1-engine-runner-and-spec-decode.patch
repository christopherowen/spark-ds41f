+
+
+def _make_worker(
+    *,
+    requested_gib: float = 101.5,
+    kv_gib: float = 4.90625,
+    tp_size: int = 3,
+    has_speculator: bool = True,
+    draft_tp: int | None = None,
+) -> Worker:
+    worker = Worker.__new__(Worker)
+    worker.device = torch.device("cuda:0")
+    worker.requested_memory = int(requested_gib * (1024**3))
+    worker.cache_config = SimpleNamespace(
+        kv_cache_memory_bytes=int(kv_gib * (1024**3)) if kv_gib > 0 else None
+    )
+    worker.parallel_config = SimpleNamespace(tensor_parallel_size=tp_size)
+    worker.speculative_config = (
+        SimpleNamespace(
+            method="dspark",
+            draft_tensor_parallel_size=(draft_tp if draft_tp is not None else tp_size),
+        )
+        if has_speculator
+        else None
+    )
+    worker._contiguous_pool_anchor = None
+    worker._contiguous_pool_bytes = 0
+    worker._contiguous_pool_range = (0, 0)
+    return worker
+
+
+def _buddyinfo_o13(o13_count: int) -> str:
+    return (
+        "Node 0, zone      DMA      4   4   4   4   4   4   4   4   0   0   0   0   0   0\n"
+        f"Node 0, zone   Normal     10  10  10  10  10  10  10  10  10  10  10  10  10 {o13_count}\n"
+    )
