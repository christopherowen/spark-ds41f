+def _combine_ours(args, num_logits, num_new, dead_rows):
+    (ids, idx, last, starts, seq_lens, prefill_len, draft_tokens, cu) = args
+    logits = torch.full((num_logits,), -7, dtype=torch.int64, device=DEVICE)
+    if idx.shape[0]:
