+        logits, mapping, temperature, seeds, pos, apply_temperature, is_drafting
+    )
+    theirs = c.gather(dim=-1, index=d.argmax(dim=-1, keepdim=True)).view(-1)
+    _assert_same(ours, theirs, "sampled tokens")
