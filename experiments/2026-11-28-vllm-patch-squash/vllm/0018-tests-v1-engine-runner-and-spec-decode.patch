+        logits,
+        torch.zeros(1, dtype=torch.int32, device=DEVICE),
+        torch.zeros(0, dtype=torch.int32, device=DEVICE),
+        torch.zeros((0, 3), dtype=torch.int64, device=DEVICE),
+        False,
+    )
+    assert out.logprobs.shape == out.ranks.shape == (0, 3)
+
