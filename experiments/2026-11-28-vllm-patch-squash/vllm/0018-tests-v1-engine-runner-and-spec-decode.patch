@@ -0,0 +1,204 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Submission failures must not retain frontend prompts or orphan sampled children."""
+
+import asyncio
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from vllm.sampling_params import SamplingParams
+from vllm.v1.engine import EngineCoreOutput, EngineCoreRequest, FinishReason
+from vllm.v1.engine.async_llm import AsyncLLM
+from vllm.v1.engine.output_processor import OutputProcessor
+
+pytestmark = pytest.mark.cpu_test
+
+
+class SubmissionCore:
+    def __init__(self):
+        self.resources = SimpleNamespace(engine_dead=False)
+        self.submitted = []
+        self.aborted = []
+        self.fail_at = None
+        self.block_at = None
+        self.abort_error = False
+        self.entered = asyncio.Event()
+        self.resume = asyncio.Event()
+
+    async def add_request_async(self, request):
+        self.submitted.append(request.request_id)
+        if len(self.submitted) == self.block_at:
+            self.entered.set()
+            await self.resume.wait()
+        if len(self.submitted) == self.fail_at:
+            raise RuntimeError("submission failed")
+
+    async def abort_requests_async(self, request_ids):
+        self.aborted.extend(request_ids)
+        if self.abort_error:
+            raise RuntimeError("abort send failed")
+
+    def shutdown(self, timeout=None):
+        pass
+
+
+def make_llm():
+    llm = AsyncLLM.__new__(AsyncLLM)
+    llm.engine_core = SubmissionCore()
+    llm.output_processor = OutputProcessor(None, log_stats=False)
+    llm.scheduler_config = SimpleNamespace(
+        max_num_queued_reqs=None, max_num_queued_tokens=None
+    )
+    llm.admission_stats = None
+    llm.vllm_config = SimpleNamespace(
+        cache_config=SimpleNamespace(kv_sharing_fast_prefill=False)
+    )
+    llm.log_requests = False
+    llm.output_handler = None
+    llm._run_output_handler = lambda: None
+    llm._request_stall_warning_s = 0
+    llm._log_request_timeline = False
+    sequence = 0
+
+    def assign_request_id(request):
+        nonlocal sequence
+        sequence += 1
+        request.external_req_id = request.request_id
+        request.request_id = f"{request.request_id}-internal-{sequence}"
+
+    llm.input_processor = SimpleNamespace(assign_request_id=assign_request_id)
+    return llm
+
+
+def make_request(n=1, request_id="shared-external-id"):
+    return EngineCoreRequest(
+        request_id=request_id,
+        prompt_token_ids=list(range(65536)),
+        mm_features=None,
+        sampling_params=SamplingParams(n=n, max_tokens=16, detokenize=False),
+        pooling_params=None,
+        arrival_time=time.time(),
+        lora_request=None,
+        cache_salt=None,
+        data_parallel_rank=None,
+    )
+
+
+def assert_empty(llm):
+    processor = llm.output_processor
+    assert not processor.request_states
+    assert not processor.parent_requests
+    assert not processor.external_req_ids
+    assert processor.get_num_queued_tokens() == 0
+
+
+@pytest.mark.parametrize("abort_error", [False, True])
+def test_failed_submission_rolls_back_registered_prompt(abort_error):
+    async def run():
+        llm = make_llm()
+        llm.engine_core.fail_at = 1
+        llm.engine_core.abort_error = abort_error
+        request = make_request()
+        with pytest.raises(RuntimeError, match="^submission failed$"):
+            await llm.add_request(request.request_id, request, request.sampling_params)
+        assert_empty(llm)
+        assert llm.engine_core.aborted == llm.engine_core.submitted
+
+    asyncio.run(run())
+
+
+def test_repeated_failed_submissions_do_not_accumulate_prompt_history():
+    async def run():
+        llm = make_llm()
+        for index in range(16):
+            llm.engine_core.fail_at = len(llm.engine_core.submitted) + 1
+            request = make_request(request_id=f"failed-{index}")
+            with pytest.raises(RuntimeError, match="submission failed"):
+                await llm.add_request(
+                    request.request_id, request, request.sampling_params
+                )
+        # The uncorrected code retains sixteen prompts (1,048,576 token IDs)
+        # even though none reached the engine and no request can finish them.
+        assert_empty(llm)
+
+    asyncio.run(run())
+
+
+@pytest.mark.parametrize("n, block_at", [(1, 1), (3, 2), (3, 3)])
+def test_disconnect_during_submission_rolls_back_all_children(n, block_at):
+    async def run():
+        llm = make_llm()
+        llm.engine_core.block_at = block_at
+        request = make_request(n)
+        # Exercise generate(): its queue handle has not yet been assigned when
+        # cancellation interrupts add_request(). No engine output will arrive.
+        generator = llm.generate(
+            request, request.sampling_params, request.request_id
+        )
+        task = asyncio.create_task(anext(generator))
+        await asyncio.wait_for(llm.engine_core.entered.wait(), timeout=2)
+        assert len(llm.output_processor.request_states) == block_at
+        assert llm.output_processor.get_num_queued_tokens() == block_at * 65536
+        task.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+        await generator.aclose()
+        assert_empty(llm)
+        assert set(llm.engine_core.aborted) == set(llm.engine_core.submitted)
+
+    asyncio.run(run())
+
+
+@pytest.mark.parametrize("n", [1, 3])
+def test_failure_does_not_abort_another_request_reusing_external_id(n):
+    async def run():
+        llm = make_llm()
+        first = make_request()
+        queue = await llm.add_request(
+            first.request_id, first, first.sampling_params
+        )
+        original_id = first.request_id
+        llm.engine_core.fail_at = 1 + n
+        request = make_request(n)
+        with pytest.raises(RuntimeError, match="submission failed"):
+            await llm.add_request(request.request_id, request, request.sampling_params)
+        assert set(llm.output_processor.request_states) == {original_id}
+        assert not llm.output_processor.parent_requests
+        assert llm.output_processor.external_req_ids == {
+            "shared-external-id": [original_id]
+        }
+        assert original_id not in llm.engine_core.aborted
+        await llm.abort(queue.request_id, internal=True)
+        assert_empty(llm)
+
+    asyncio.run(run())
+
+
+@pytest.mark.parametrize("n", [1, 3])
+def test_successful_submission_and_completion_keep_normal_cleanup(n):
+    async def run():
+        llm = make_llm()
+        request = make_request(n)
+        queue = await llm.add_request(
+            request.request_id, request, request.sampling_params
+        )
+        assert len(llm.output_processor.request_states) == n
+        assert not llm.engine_core.aborted
+        outputs = [
+            EngineCoreOutput(
+                request_id=internal_id,
+                new_token_ids=[1],
+                finish_reason=FinishReason.STOP,
+            )
+            for internal_id in llm.engine_core.submitted
+        ]
+        llm.output_processor.process_outputs(outputs)
+        assert_empty(llm)
+        result = await queue.get()
+        assert result.finished
+        assert len(result.outputs) == n
+        assert not llm.engine_core.aborted
+
+    asyncio.run(run())
diff --git a/tests/v1/engine/test_utility_call_cleanup.py b/tests/v1/engine/test_utility_call_cleanup.py
new file mode 100644
index 0000000000000000000000000000000000000000..5977cad87dba94a227a2b5c2a10f91511a7b00cf
--- /dev/null
+++ b/tests/v1/engine/test_utility_call_cleanup.py
@@ -0,0 +1,186 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Every utility caller releases its slot, including when no reply can arrive."""
+
+import asyncio
+from concurrent.futures import Future
+from types import SimpleNamespace
+
+import pytest
+
+from vllm.v1.engine import UtilityOutput, UtilityResult
+from vllm.v1.engine.core_client import (
+    AsyncMPClient,
+    SyncMPClient,
+    _process_utility_output,
+)
+
+pytestmark = pytest.mark.cpu_test
+
+
+def reply(call_id, failure=False):
+    return UtilityOutput(
+        call_id=call_id,
+        failure_message="utility failed" if failure else None,
+        result=None if failure else UtilityResult("ok"),
+    )
+
+
+def make_client(asynchronous, stage=None, failure=False):
+    cls = AsyncMPClient if asynchronous else SyncMPClient
+    client = cls.__new__(cls)
+    client.resources = SimpleNamespace(engine_dead=False)
+    client.client_index = 0
+    client.core_engine = b"\x00\x00"
+    client.utility_results = {}
+    client.entered = asyncio.Event() if asynchronous else None
+    client.call_id = None
+
+    def encode(value):
+        client.call_id = value[1]
+        if stage == "encode":
+            raise ValueError("encode failed")
+        return [b"utility"]
+
+    client.encoder = SimpleNamespace(encode=encode)
+
+    async def send_async(message, engine):
+        if stage == "send":
+            raise RuntimeError("send failed")
+        if stage == "block_send":
+            client.entered.set()
+            await asyncio.Future()
+        if stage != "wait_reply" and stage != "output_task":
+            _process_utility_output(reply(client.call_id, failure), client.utility_results)
+
+    def send_sync(message, copy=False):
+        if stage == "send":
+            raise RuntimeError("send failed")
+        _process_utility_output(reply(client.call_id, failure), client.utility_results)
+
+    def ensure_output():
+        if stage == "output_task":
+            raise RuntimeError("output task failed")
+        client.entered.set()
+
+    client._send_input_message = send_async
+    client.input_socket = SimpleNamespace(send_multipart=send_sync)
+    client._ensure_output_queue_task = ensure_output
+    return client
+
+
+@pytest.mark.parametrize("stage", ["encode", "send", "output_task"])
+def test_async_utility_failure_releases_pending_future(stage):
+    async def run():
+        client = make_client(True, stage)
+        with pytest.raises((ValueError, RuntimeError), match="failed"):
+            await client.call_utility_async("echo", "payload")
+        assert not client.utility_results
+
+    asyncio.run(run())
+
+
+@pytest.mark.parametrize("stage", ["encode", "send"])
+def test_sync_utility_failure_releases_pending_future(stage):
+    client = make_client(False, stage)
+    with pytest.raises((ValueError, RuntimeError), match="failed"):
+        client.call_utility("echo", "payload")
+    assert not client.utility_results
+
+
+@pytest.mark.parametrize("stage", ["block_send", "wait_reply"])
+def test_cancellation_releases_slot_and_late_reply_is_harmless(stage):
+    async def run():
+        client = make_client(True, stage)
+        task = asyncio.create_task(client.call_utility_async("echo"))
+        await asyncio.wait_for(client.entered.wait(), 2)
+        call_id = client.call_id
+        task.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+        assert not client.utility_results
+        _process_utility_output(reply(call_id), client.utility_results)
+        assert not client.utility_results
+        # A delayed response must not kill the output receiver or another call.
+        healthy = make_client(True)
+        healthy.utility_results = client.utility_results
+        assert await healthy.call_utility_async("echo") == "ok"
+        assert not healthy.utility_results
+
+    asyncio.run(run())
+
+
+@pytest.mark.parametrize("asynchronous", [False, True])
+def test_repeated_failed_utility_calls_do_not_accumulate(asynchronous):
+    async def run():
+        client = make_client(asynchronous, "send")
+        for _ in range(64):
+            with pytest.raises(RuntimeError, match="send failed"):
+                if asynchronous:
+                    await client.call_utility_async("echo")
+                else:
+                    client.call_utility("echo")
+        assert not client.utility_results
+
+    asyncio.run(run())
+
+
+@pytest.mark.parametrize("asynchronous", [False, True])
+@pytest.mark.parametrize("failure", [False, True])
+def test_normal_utility_reply_keeps_result_and_cleanup(asynchronous, failure):
+    async def run():
+        client = make_client(asynchronous, failure=failure)
+
+        async def call():
+            if asynchronous:
+                return await client.call_utility_async("echo")
+            return client.call_utility("echo")
+
+        if failure:
+            with pytest.raises(Exception, match="utility failed"):
+                await call()
+        else:
+            assert await call() == "ok"
+        assert not client.utility_results
+
+    asyncio.run(run())
+
+
+@pytest.mark.parametrize("failure", [False, True])
+def test_unknown_or_duplicate_utility_reply_does_not_stop_receiver(failure):
+    _process_utility_output(reply(123, failure), {})
+
+
+@pytest.mark.parametrize("asynchronous", [False, True])
+@pytest.mark.parametrize("failure", [False, True])
+def test_reply_racing_with_cancelled_future_does_not_stop_receiver(asynchronous, failure):
+    async def run():
+        future = asyncio.get_running_loop().create_future() if asynchronous else Future()
+        results = {123: future}
+        future.cancel()
+        _process_utility_output(reply(123, failure), results)
+        assert not results
+
+    asyncio.run(run())
+
+
+def test_cancelling_one_utility_does_not_remove_another_pending_call():
+    async def run():
+        client = make_client(True, "wait_reply")
+        first = asyncio.create_task(client.call_utility_async("first"))
+        await asyncio.wait_for(client.entered.wait(), 2)
+        first_id = client.call_id
+        client.entered.clear()
+        second = asyncio.create_task(client.call_utility_async("second"))
+        await asyncio.wait_for(client.entered.wait(), 2)
+        second_id = client.call_id
+        first.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await first
+        assert set(client.utility_results) == {second_id}
+        _process_utility_output(reply(first_id), client.utility_results)
+        _process_utility_output(reply(second_id), client.utility_results)
+        assert await second == "ok"
+        assert not client.utility_results
+
+    asyncio.run(run())
