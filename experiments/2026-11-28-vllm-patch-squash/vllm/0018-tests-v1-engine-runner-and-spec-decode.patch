+        (idx3 / "shared_cpu_list").write_text("0-9\n" if cpu < 10 else "10-19\n", encoding="utf-8")
+
+    plan_gb10 = cpu_affinity.partition_cpu_affinity(
+        allowed=set(range(20)), sysfs_root=gb10, proxy_cpu_spec="big"
+    )
+    assert plan_gb10.proxy_cpus == (19,)
+    assert plan_gb10.worker_main_cpus == (18,)
+    assert plan_gb10.engine_core_cpus == (17,)
+    assert plan_gb10.api_server_cpus == (0, 1, 2, 3, 4, 15, 16)
+    assert plan_gb10.worker_aux_cpus == (5, 6, 7, 8, 9)
+
+    inv = tmp_path / "inverted"
+    _populate_gb10_sysfs(inv)
+    for cpu in range(20):
+        idx3 = inv / f"cpu{cpu}" / "cache" / "index3"
+        idx3.mkdir(parents=True, exist_ok=True)
+        (idx3 / "size").write_text("16384K\n" if cpu < 10 else "8192K\n", encoding="utf-8")
+        (idx3 / "shared_cpu_list").write_text("0-9\n" if cpu < 10 else "10-19\n", encoding="utf-8")
+
+    plan_inv = cpu_affinity.partition_cpu_affinity(
+        allowed=set(range(20)), sysfs_root=inv, proxy_cpu_spec="big"
+    )
+    assert plan_inv.proxy_cpus == (9,)
+    assert plan_inv.worker_main_cpus == (8,)
+    assert plan_inv.engine_core_cpus == (7,)
+    assert plan_inv.worker_aux_cpus == (15, 16, 17, 18, 19)
+    assert plan_inv.api_server_cpus == (5, 6, 10, 11, 12, 13, 14)
