+def test_widen_only_uniform_placeholders(monkeypatch, tmp_path):
+    _, scheduler = _scheduler(monkeypatch, tmp_path, copy_drafts=True, max_num_seqs=4)
+
+    class Request:
+        is_prefill_chunk = False
+        copy_draft_alloc = LOOKAHEAD
