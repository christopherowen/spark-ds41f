+            torch.uint8,
+            "cuda",
+            optional=True,
+        )
+        is None
+    )
+    monkeypatch.setattr(display_carveout, "_REQUIRED", True)
+    with pytest.raises(RuntimeError, match="display carve-out limit"):
+        display_carveout.allocate(
