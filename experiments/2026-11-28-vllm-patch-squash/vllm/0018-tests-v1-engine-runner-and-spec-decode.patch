+def test_calibrated_confidence_matches_dead_rows_tau_to_c1_survival():
+    """With calibrated confidence_head survival, c1 prices cold-L2 single-request
+    MoE row cost (2.5x -> tau ~0.1386) on device DeadRows while admitting all <=5
+    DSpark slots on the host to avoid p_k^2 intersection with 1-step-stale
+    _stale_confidences, while c2+ and wide copy drafts keep host budgeting."""
+    # Typical calibrated c1 conditional probs -> survival [0.677, 0.376, 0.149, 0.0686, 0.0438]
+    typical = np.array([[0.677, 0.556, 0.396, 0.460, 0.638]], dtype=np.float32)
+    manager = make_manager(typical, row_cost=0.035)
+    manager.req_states.req_id_to_index = {"r0": 0}
+    manager.dead_rows_tau = 0.20
+    manager.calibrated_confidence = True
+
+    c1_row_cost = 0.035 * 2.5
+    c1_tau = 2.0 * c1_row_cost / (1.0 + 3.0 * c1_row_cost)
+    assert np.isclose(manager.effective_dead_rows_tau(num_reqs=1), c1_tau)
+    c2_row_cost = 0.035 * (
+        1.0 + adaptive_module.SMALL_BATCH_L2_ROW_COST_BONUS / 2.0
+    )
+    assert np.isclose(
+        manager.effective_dead_rows_tau(num_reqs=2),
+        2.0 * c2_row_cost / (1.0 + 3.0 * c2_row_cost),
+    )
+    total = manager.get_num_tokens({"r0": 6}, {"r0": [1, 2, 3, 4, 5]})
+    _, _, draft_budget = manager._batch_budget
+    # c1 DSpark admits all 5 slots on host; device DeadRows prunes at tau_c1=0.1386.
+    assert draft_budget == 5
+    assert total == 6
+
+    manager._confidence_probs = torch.ones((1, 5), dtype=torch.float32)
+    manager._dead_row_cut = torch.empty((1,), dtype=torch.int32)
+    dead = manager.dead_row_args(torch.zeros(6, dtype=torch.bool), 1)
+    assert dead is not None
+    assert np.isclose(dead.log_tau, float(np.log(c1_tau)))
+
+    # Low 1-step-stale confidences must not drop current-step c1 DSpark slots on host.
+    low = np.array([[0.45, 0.40, 0.30, 0.30, 0.30]], dtype=np.float32)
+    manager_lo = make_manager(low, row_cost=0.035)
+    manager_lo.req_states.req_id_to_index = {"r0": 0}
+    manager_lo.dead_rows_tau = 0.20
+    manager_lo.calibrated_confidence = True
+    manager_lo.get_num_tokens({"r0": 6}, {"r0": [1, 2, 3, 4, 5]})
+    assert manager_lo._batch_budget[2] == 5
+
+    # Multi-request batches (c2+) still prune against stale_confidences & c2+ tau.
+    low_c2 = np.repeat(low, 2, axis=0)
+    manager_c2 = make_manager(low_c2, row_cost=0.035)
+    manager_c2.req_states.req_id_to_index = {"r0": 0, "r1": 1}
+    manager_c2.req_states.num_computed_tokens_np = np.ones(2, dtype=np.int32)
+    manager_c2.req_states.prefill_len = SimpleNamespace(
+        np=np.ones(2, dtype=np.int32)
+    )
+    manager_c2.dead_rows_tau = 0.20
+    manager_c2.calibrated_confidence = True
+    manager_c2.get_num_tokens({"r0": 6, "r1": 6}, {"r0": [1, 2, 3, 4, 5], "r1": [1, 2, 3, 4, 5]})
+    assert manager_c2._batch_budget[2] == 4
+
+    # Wide copy drafts (> num_draft_steps) at c1 keep host utility budgeting.
+    wide_copy = np.full((1, 16), 0.95, dtype=np.float32)
+    manager_wide = make_manager(wide_copy, row_cost=0.035)
+    manager_wide.req_states.req_id_to_index = {"r0": 0}
+    manager_wide.num_draft_steps = 5
+    manager_wide.dead_rows_tau = 0.20
+    manager_wide.calibrated_confidence = True
