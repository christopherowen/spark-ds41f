+class _Head:
+    """A confidence head that takes the fused call and records its arguments."""
+
+    def __init__(self, takes_margin):
+        self.calls = []
+        if takes_margin:
+            self.takes_margin = True
+
+    def probability_and_calibrate(self, *args):
+        self.calls.append(args)
+        return args[2]
+
