+        lookback, "_bound", lambda *key: used.append(key) or bound(*key)
+    )
+    lookback.gather_lookback(window, idx, computed, history)
+    assert used == [lookback.gather_lookback_key(3, tli.RUNNER_IDX_DTYPE)]
