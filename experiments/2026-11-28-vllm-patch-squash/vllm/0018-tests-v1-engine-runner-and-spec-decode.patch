+++ b/tests/v1/core/test_new_request_data_ipc.py
@@ -0,0 +1,185 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import pickle
+
+import numpy as np
+import pytest
+import torch
+
+from vllm.distributed.device_communicators.shm_broadcast import MessageQueue
+from vllm.sampling_params import SamplingParams
+from vllm.v1.core.sched.output import (
+    INT32_TOKEN_IDS_MIN_LEN,
+    Int32TokenIds,
+    NewRequestData,
+)
+from vllm.v1.request import Request
+
+
+def _make_request(prompt_tokens: list[int], req_id: str = "req-1") -> Request:
+    return Request(
+        request_id=req_id,
+        prompt_token_ids=prompt_tokens,
+        sampling_params=SamplingParams(max_tokens=16),
+        pooling_params=None,
+    )
+
+
+def test_int32_token_ids_sequence_protocol():
+    raw = [i * 3 - 7 for i in range(512)]
+    packed = Int32TokenIds.from_sequence(raw)
+    assert packed is not None
+    assert len(packed) == 512
+    assert bool(packed) is True
+    assert not bool(Int32TokenIds(np.empty(0, dtype=np.int32)))
+    assert isinstance(packed[0], int)
+    assert packed[0] == raw[0]
+    assert packed[-1] == raw[-1]
+    sliced = packed[10:50]
+    assert isinstance(sliced, Int32TokenIds)
+    assert sliced == raw[10:50]
+    assert packed == raw
+    assert packed.tolist() == raw
+    assert list(packed) == raw
+    copied = packed.copy()
+    assert copied == packed
+    assert copied._arr is not packed._arr
+    arr_view = np.asarray(packed, dtype=np.int32)
+    assert np. shares_memory(arr_view, packed._arr)
+
+
+def test_new_request_data_from_request_fresh_and_resumed():
+    tokens = [i % 100000 for i in range(4096)]
+    req = _make_request(tokens)
+
+    # Fresh request: prompt_token_ids and prefill_token_ids share one Int32TokenIds
+    data = NewRequestData.from_request(
+        req, block_ids=([1, 2, 3],), prefill_token_ids=req._all_token_ids
+    )
+    assert isinstance(data.prompt_token_ids, Int32TokenIds)
+    assert data.prefill_token_ids is data.prompt_token_ids
+    assert data.prompt_len == 4096
+    assert data.prompt_token_ids == tokens
+
+    # Single PickleBuffer emitted for both fields combined
+    buffers = []
+    blob = pickle.dumps(
+        data, protocol=pickle.HIGHEST_PROTOCOL, buffer_callback=buffers.append
+    )
+    assert len(buffers) == 1
+    raw_views = [b.raw() for b in buffers]
+    restored = pickle.loads(blob, buffers=raw_views)
+    assert isinstance(restored.prompt_token_ids, Int32TokenIds)
+    assert restored.prefill_token_ids is restored.prompt_token_ids
+    assert restored.prompt_token_ids == tokens
+
+    # Resumed request with output tokens appended
+    req.append_output_token_ids([99991, 99992, 99993])
+    resumed = NewRequestData.from_request(
+        req, block_ids=([1, 2, 3, 4],), prefill_token_ids=req._all_token_ids
+    )
+    assert resumed.prompt_len == 4096
+    assert len(resumed.prefill_token_ids) == 4099
+    assert resumed.prompt_token_ids == tokens
+    assert resumed.prefill_token_ids == tokens + [99991, 99992, 99993]
+
+    buffers_resumed = []
+    blob_resumed = pickle.dumps(
+        resumed,
+        protocol=pickle.HIGHEST_PROTOCOL,
+        buffer_callback=buffers_resumed.append,
+    )
+    assert len(buffers_resumed) == 1
+    restored_resumed = pickle.loads(
+        blob_resumed, buffers=[b.raw() for b in buffers_resumed]
+    )
+    assert restored_resumed.prompt_len == 4096
+    assert restored_resumed.prompt_token_ids == tokens
+    assert restored_resumed.prefill_token_ids == tokens + [99991, 99992, 99993]
+
+
+def test_new_request_data_short_and_overflow_fallback():
+    short_tokens = list(range(32))
+    assert len(short_tokens) < INT32_TOKEN_IDS_MIN_LEN
+    req_short = _make_request(short_tokens, req_id="short")
+    data_short = NewRequestData.from_request(
+        req_short, block_ids=([1],), prefill_token_ids=req_short._all_token_ids
+    )
+    assert isinstance(data_short.prompt_token_ids, list)
+    assert data_short.prefill_token_ids is data_short.prompt_token_ids
+
+    huge_tokens = [1 << 40] * 512
+    req_huge = _make_request(huge_tokens, req_id="huge")
+    data_huge = NewRequestData.from_request(
+        req_huge, block_ids=([1],), prefill_token_ids=req_huge._all_token_ids
+    )
+    assert isinstance(data_huge.prompt_token_ids, list)
+    restored_huge = pickle.loads(pickle.dumps(data_huge, protocol=5))
+    assert restored_huge.prompt_token_ids == huge_tokens
+
+
+@pytest.mark.parametrize("num_tokens", [4096, 32768, 300000])
+def test_message_queue_new_request_data_roundtrip(num_tokens: int):
+    tokens = [(i * 17 + 5) % 128000 for i in range(num_tokens)]
+    req = _make_request(tokens, req_id=f"mq-{num_tokens}")
+    data = NewRequestData.from_request(
+        req,
+        block_ids=(list(range(num_tokens // 64)),),
+        prefill_token_ids=req._all_token_ids,
+    )
+
+    mq_writer = MessageQueue(
+        n_reader=1,
+        n_local_reader=1,
+        local_reader_ranks=[0],
+        max_chunk_bytes=2 * 1024 * 1024,
+        max_chunks=2,
+    )
+    mq_reader = MessageQueue.create_from_handle(mq_writer.export_handle(), rank=0)
+    try:
+        mq_writer.enqueue(data, timeout=5.0)
+        received = mq_reader.dequeue(timeout=5.0)
+        assert isinstance(received.prompt_token_ids, Int32TokenIds)
+        assert received.prefill_token_ids is received.prompt_token_ids
+        assert received.prompt_len == num_tokens
+        assert np.array_equal(
+            np.asarray(received.prefill_token_ids, dtype=np.int32),
+            np.asarray(tokens, dtype=np.int32),
+        )
+    finally:
+        mq_writer.shutdown()
+        mq_reader.shutdown()
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="Requires CUDA for UVA")
+def test_staged_write_tensor_with_int32_token_ids():
+    from vllm.v1.worker.gpu.buffer_utils import StagedWriteTensor
+
+    device = torch.device("cuda:0")
+    tensor = StagedWriteTensor(
+        (4, 8192), dtype=torch.int32, device=device, uva_instead_of_gpu=True
+    )
+    toks0 = Int32TokenIds(np.arange(100, 4196, dtype=np.int32))
+    toks1 = Int32TokenIds(np.arange(5000, 7048, dtype=np.int32))
+
+    tensor.stage_write(0, 0, toks0)
+    tensor.stage_write(2, 10, toks1)
+    tensor.apply_write()
+    torch.cuda.synchronize()
+
+    row0 = tensor.gpu[0, : len(toks0)].cpu().numpy()
+    row2 = tensor.gpu[2, 10 : 10 + len(toks1)].cpu().numpy()
+    assert np.array_equal(row0, toks0._arr)
+    assert np.array_equal(row2, toks1._arr)
+
+    # Also verify mixed array + list + elem staging fallback
+    tensor.stage_write(1, 0, toks0[:128])
+    tensor.stage_write(1, 128, [77, 88, 99])
+    tensor.stage_write_elem(3, 42)
+    tensor.apply_write()
+    torch.cuda.synchronize()
+
+    assert np.array_equal(tensor.gpu[1, :128].cpu().numpy(), toks0._arr[:128])
+    assert tensor.gpu[1, 128:131].cpu().tolist() == [77, 88, 99]
+    assert int(tensor.gpu[3, 0].cpu().item()) == 42
diff --git a/tests/v1/core/test_prefill_yield.py b/tests/v1/core/test_prefill_yield.py
new file mode 100644
index 0000000000000000000000000000000000000000..b9d014539baf2d868aeb8781d0e449322ea854e1
--- /dev/null
+++ b/tests/v1/core/test_prefill_yield.py
@@ -0,0 +1,304 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Prefill yield: a long prompt's aligned chunk gives its step to short prompts and to
+held first tokens, and keeps its chunk boundaries."""
+
+import functools
+import json
+
+import pytest
+
+_OPT_CONFIG = {
+    "architectures": ["OPTForCausalLM"],
+    "model_type": "opt",
+    "hidden_size": 768,
+    "num_attention_heads": 12,
+    "num_hidden_layers": 12,
+    "ffn_dim": 3072,
+    "max_position_embeddings": 8192,
+    "vocab_size": 50272,
+    "word_embed_proj_dim": 768,
+    "torch_dtype": "float16",
+    "do_layer_norm_before": True,
+    "pad_token_id": 1,
+    "bos_token_id": 2,
+    "eos_token_id": 2,
+}
+
+BUDGET = 1024
+SEQS = 16
+THRESHOLD = BUDGET - SEQS
+
+
+def _scheduler(monkeypatch, tmp_path, prefill_yield="short", limit_s=10.0):
+    utils = pytest.importorskip("tests.v1.core.utils")
+    # DeepSeek V4.1's configuration sets align_prefill_chunks; this OPT model takes
+    # it, and the yield option, here.
+    monkeypatch.setattr(
+        utils,
+        "SchedulerConfig",
+        functools.partial(
+            utils.SchedulerConfig,
+            align_prefill_chunks=True,
+            prefill_yield=prefill_yield,
+            prefill_yield_limit_s=limit_s,
+        ),
+    )
+    (tmp_path / "config.json").write_text(json.dumps(_OPT_CONFIG))
+    scheduler = utils.create_scheduler(
+        model=str(tmp_path),
+        max_num_seqs=SEQS,
+        max_num_batched_tokens=BUDGET,
+        long_prefill_token_threshold=THRESHOLD,
+        max_model_len=8192,
+        skip_tokenizer_init=True,
+        device="cpu",
+    )
+    return utils, scheduler
+
+
+def _request(utils, req_id, tokens):
+    (request,) = utils.create_requests(num_requests=1, num_tokens=tokens, req_ids=[req_id])
+    return request
+
+
+def _steps(scheduler, count):
+    return [dict(scheduler.schedule().num_scheduled_tokens) for _ in range(count)]
+
+
+def test_off_keeps_first_come_first_served(monkeypatch, tmp_path):
+    utils, scheduler = _scheduler(monkeypatch, tmp_path, prefill_yield="off")
+    scheduler.add_request(_request(utils, "long", 4000))
+    assert _steps(scheduler, 1) == [{"long": THRESHOLD}]
+    scheduler.add_request(_request(utils, "short", 200))
+    # The short request waits for the long prompt's whole prefill.
+    assert _steps(scheduler, 3) == [
+        {"long": THRESHOLD},
+        {"long": THRESHOLD},
+        {"long": 4000 - 3 * THRESHOLD},
+    ]
+
+
+def test_a_short_prompt_takes_the_step_and_the_chunks_keep_their_boundaries(
+    monkeypatch, tmp_path
+):
+    utils, scheduler = _scheduler(monkeypatch, tmp_path)
+    scheduler.add_request(_request(utils, "long", 4000))
+    assert _steps(scheduler, 1) == [{"long": THRESHOLD}]
+    scheduler.add_request(_request(utils, "short", 200))
+    steps = _steps(scheduler, 4)
+    assert steps[0] == {"short": 200}
+    # The long prompt resumes where it stopped: its chunks still end at multiples of
+    # the threshold.
+    assert steps[1:] == [
+        {"long": THRESHOLD},
+        {"long": THRESHOLD},
+        {"long": 4000 - 3 * THRESHOLD},
+    ]
+
+
+def test_a_long_prompt_at_the_head_does_not_hold_up_a_short_one(monkeypatch, tmp_path):
+    utils, scheduler = _scheduler(monkeypatch, tmp_path)
+    scheduler.add_request(_request(utils, "long", 4000))
+    scheduler.add_request(_request(utils, "short", 200))
+    steps = _steps(scheduler, 2)
+    assert steps == [{"short": 200}, {"long": THRESHOLD}]
+
+
+def test_shorts_keep_their_order(monkeypatch, tmp_path):
+    utils, scheduler = _scheduler(monkeypatch, tmp_path)
+    scheduler.add_request(_request(utils, "long", 4000))
+    for name in ("a", "b", "c"):
+        scheduler.add_request(_request(utils, name, 300))
+    (step,) = _steps(scheduler, 1)
+    assert step == {"a": 300, "b": 300, "c": 300}
+
+
+def test_nothing_short_waiting_changes_nothing(monkeypatch, tmp_path):
+    utils, on = _scheduler(monkeypatch, tmp_path)
+    for name in ("x", "y"):
+        on.add_request(_request(utils, name, 3000))
+    assert _steps(on, 4) == [
+        {"x": THRESHOLD},
+        {"x": THRESHOLD},
+        {"x": 3000 - 2 * THRESHOLD},
+        {"y": THRESHOLD},
+    ]
+
+
+def test_the_held_first_token_step_carries_no_long_chunk(monkeypatch, tmp_path):
+    utils, scheduler = _scheduler(monkeypatch, tmp_path)
+    scheduler.sink_rejection = True  # set by DeepSeek V4.1's sink detector
+    scheduler.add_request(_request(utils, "long", 4000))
+    assert _steps(scheduler, 1) == [{"long": THRESHOLD}]
+    scheduler.add_request(_request(utils, "short", 200))
+    assert _steps(scheduler, 1) == [{"short": 200}]
+    assert "short" in scheduler._first_decode_due
+    # The short prompt's first decode step is due: the long chunk waits.
+    assert "long" not in scheduler.schedule().num_scheduled_tokens
+
+
+def test_a_long_prompt_stops_yielding_at_its_limit(monkeypatch, tmp_path):
+    utils, scheduler = _scheduler(monkeypatch, tmp_path, limit_s=1e-9)
+    scheduler.sink_rejection = True
+    scheduler.add_request(_request(utils, "long", 4000))
+    assert _steps(scheduler, 1) == [{"long": THRESHOLD}]
+    scheduler.add_request(_request(utils, "short", 200))
+    assert _steps(scheduler, 1) == [{"short": 200}]
+    # Its yield began in that step and is past the limit now.
+    assert scheduler.schedule().num_scheduled_tokens.get("long") == THRESHOLD
+
+
+def test_yield_excludes_lanes_and_cadence():
+    from vllm.config import SchedulerConfig
+
+    with pytest.raises(ValueError):
+        SchedulerConfig(
+            max_model_len=8192, is_encoder_decoder=False,
+            prefill_yield="short", max_parallel_prefills=2,
+        )
+    with pytest.raises(ValueError):
+        SchedulerConfig(
+            max_model_len=8192, is_encoder_decoder=False,
+            prefill_yield="short", prefill_schedule_interval=2,
+        )
+
+
+def _step_and_advance_decodes(scheduler):
+    output = scheduler.schedule()
+    scheduled = dict(output.num_scheduled_tokens)
+    for req_id in scheduled:
+        req = scheduler.requests[req_id]
+        if not req.is_prefill_chunk:
+            req.append_output_token_ids(0)
+    return scheduled
+
+
+def test_interleave_k_graphed_decode_steps_between_full_prefill_chunks(
+    monkeypatch, tmp_path
+):
+    utils, scheduler = _scheduler(monkeypatch, tmp_path)
+    dec = _request(utils, "dec", 20)
+    dec.max_tokens = 100
+    scheduler.add_request(dec)
+    assert _step_and_advance_decodes(scheduler) == {"dec": 20}
+
+    long_req = _request(utils, "long", 3000)
+    long_req.max_tokens = 10
+    scheduler.add_request(long_req)
+    # Chunk 1 of long + dec (>= 1.0 s stall), then 2 pure decode steps,
+    # Chunk 2 + dec, 2 pure decode steps, Chunk 3 (final) + dec.
+    steps = [_step_and_advance_decodes(scheduler) for _ in range(7)]
+    assert steps == [
+        {"dec": 1, "long": THRESHOLD},
+        {"dec": 1},
+        {"dec": 1},
+        {"dec": 1, "long": THRESHOLD},
+        {"dec": 1},
+        {"dec": 1},
+        {"dec": 1, "long": 3000 - 2 * THRESHOLD},
+    ]
+
+
+def test_interleave_works_at_full_slot_occupancy_stall_15(monkeypatch, tmp_path):
+    utils, scheduler = _scheduler(monkeypatch, tmp_path)
+    for idx in range(SEQS - 1):
+        req = _request(utils, f"d{idx}", 10)
+        req.max_tokens = 100
+        scheduler.add_request(req)
+    first_step = _step_and_advance_decodes(scheduler)
+    assert len(first_step) == SEQS - 1
+
+    long_req = _request(utils, "long", 2500)
+    long_req.max_tokens = 10
+    scheduler.add_request(long_req)
+    # All 16 sequence slots are now full (15 decodes + 1 long prefill).
+    step1 = _step_and_advance_decodes(scheduler)
+    assert step1["long"] == THRESHOLD
+    assert len(step1) == SEQS
+
+    step2 = _step_and_advance_decodes(scheduler)
+    step3 = _step_and_advance_decodes(scheduler)
+    assert "long" not in step2 and len(step2) == SEQS - 1
+    assert "long" not in step3 and len(step3) == SEQS - 1
+
+    step4 = _step_and_advance_decodes(scheduler)
+    assert step4["long"] == THRESHOLD
+    assert len(step4) == SEQS
+
+
+def test_interleave_admits_waiting_short_prefill_during_decode_step(
+    monkeypatch, tmp_path
+):
+    utils, scheduler = _scheduler(monkeypatch, tmp_path)
+    dec = _request(utils, "dec", 20)
+    dec.max_tokens = 100
+    scheduler.add_request(dec)
+    assert _step_and_advance_decodes(scheduler) == {"dec": 20}
+
+    long_req = _request(utils, "long", 3000)
+    long_req.max_tokens = 10
+    scheduler.add_request(long_req)
+    assert _step_and_advance_decodes(scheduler) == {"dec": 1, "long": THRESHOLD}
+
+    # Queue both a second long request and a short request during chunk 1:
+    # the interleaved step skips long2, admits short, and keeps long's chunk
+    # boundaries intact.
+    long2 = _request(utils, "long2", 3000)
+    short = _request(utils, "short", 200)
+    short.max_tokens = 50
+    scheduler.add_request(long2)
+    scheduler.add_request(short)
+
+    assert _step_and_advance_decodes(scheduler) == {"dec": 1, "short": 200}
+    assert _step_and_advance_decodes(scheduler) == {"dec": 1, "short": 1}
+    assert _step_and_advance_decodes(scheduler) == {
+        "dec": 1,
+        "short": 1,
+        "long": THRESHOLD,
+    }
+
+
+def test_interleave_gated_by_elapsed_stall_skips_fast_chunks_until_threshold(
+    monkeypatch, tmp_path
+):
+    import vllm.v1.core.sched.scheduler as sched_mod
+
+    clock = [100.0]
+    monkeypatch.setattr(sched_mod.time, "monotonic", lambda: clock[0])
+    utils, scheduler = _scheduler(monkeypatch, tmp_path)
+    dec = _request(utils, "dec", 20)
+    dec.max_tokens = 100
+    scheduler.add_request(dec)
+    assert _step_and_advance_decodes(scheduler) == {"dec": 20}
+
+    long_req = _request(utils, "long", 4000)
+    long_req.max_tokens = 10
+    scheduler.add_request(long_req)
+
+    # Chunk 1 runs and takes only 0.45 s (< 1.0 s stall threshold):
+    # next step must NOT interleave decode-only steps yet.
+    assert _step_and_advance_decodes(scheduler) == {"dec": 1, "long": THRESHOLD}
+    clock[0] += 0.45
+    assert _step_and_advance_decodes(scheduler) == {"dec": 1, "long": THRESHOLD}
+
+    # Chunk 2 takes 0.60 s -> accumulated stall is 0.45 + 0.60 = 1.05 s >= 1.0 s:
+    # now 2 pure decode steps interleave before Chunk 3.
+    clock[0] += 0.60
+    assert _step_and_advance_decodes(scheduler) == {"dec": 1}
+    clock[0] += 0.08
+    assert _step_and_advance_decodes(scheduler) == {"dec": 1}
+    clock[0] += 0.08
+    assert _step_and_advance_decodes(scheduler) == {"dec": 1, "long": THRESHOLD}
+
+
+def test_interleave_does_not_pause_when_no_decodes_are_runnable(
+    monkeypatch, tmp_path
+):
+    utils, scheduler = _scheduler(monkeypatch, tmp_path)
+    scheduler.add_request(_request(utils, "long", 3000))
+    assert _steps(scheduler, 3) == [
+        {"long": THRESHOLD},
+        {"long": THRESHOLD},
+        {"long": 3000 - 2 * THRESHOLD},
+    ]
