+        cp_interleave,
+        123,
+        nqpr,
+        DRAFTS,
+        MAX_REQS,
+        max_tokens,
+        model_len,
+        False,
+    )
+    torch.accelerator.synchronize()
+    for name in vars(outputs):
+        assert torch.equal(
