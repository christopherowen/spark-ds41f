+    const int oi = __shfl_xor_sync(0xffffffffu, sec_i, off);
+    if (lane_row == 0 && vllm_vocab_first_argmax_keep(ov, oi, sec_v, sec_i)) {
+      sec_v = ov;
+      sec_i = oi;
+    }
+  }
+  __syncthreads();
+  if (lane == 0) {
