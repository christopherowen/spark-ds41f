+    pairs[out_off] = g1_v;
+    pairs[out_off + 1] = (g1_i < 2147483647) ? (float)(vocab_start + g1_i) : (float)(1 << 30);
+    pairs[out_off + 2] = (g2_i < 2147483647) ? g2_v : -CUDART_INF_F;
+    pairs[out_off + 3] = (g2_i < 2147483647) ? (float)(vocab_start + g2_i) : (float)(1 << 30);
+  }
