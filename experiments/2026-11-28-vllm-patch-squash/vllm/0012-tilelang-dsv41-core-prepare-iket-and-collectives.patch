+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""TileLang sparse-MLA metadata for DeepSeek-V4.1: integer kernels, exact.
+
+Each keeps the contract of the Triton kernel it replaced, element for element,
+including which rows each launch writes:
+
+- ``requests``: request starts (``nt`` past the live requests), each request's first
+  position (``seq - query``, -1 past them) and the live counts ``[nt, nr]``.
+- ``tokens``: per token its request, position, ring or paged slot (-1 unless the
+  state is emitted) and visible compressed length, over the rows of the first
+  ``ceil(nt / 128)`` blocks of 128 (the readable domain; capacity rows past it keep
+  their contents).
+
+  ``builder`` writes both in one launch: every KV-cache group's builder runs them
+  each step (26 groups at DS4.1's decode, target and drafter), and the pair of
+  kernels it replaced was two launches a group.
+- ``chunk``: per row its sliding-window page indices (-1 holes), window length and
+  top-k length.
+- ``pages``: per row its request's page table, block 0 and holes as -1, over the
+  pages of the row's visible entries only. The Triton kernel it replaced wrote every
+  column; at a 1M-token context that is 4,096 a row, where a row reads
+  ``ceil(visible / page)``: the sparse MLA's indexed lanes and the indexer's tiles
+  look up only positions below the row's visible length, and a masked lane's lookup
+  is discarded (``test_sparse_mla_reads_only_live_pages``,
+  ``test_indexer_reads_only_live_pages``). Columns past them keep their contents.
+"""
+
+# No `from __future__ import annotations`: TileLang reads the prim_func
+# annotations eagerly, and the symbolic shape must resolve.
+import tilelang
+import tilelang.language as T
+import torch
+
+from . import pdl
+
+_PASS = {tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True}
+_BLOCK = 128
+_TOP = 512  # top-k length cap
+_GROUP = 8  # decode_metadata's page columns a thread takes per live-page check
+
+
+def _search_steps(requests: int) -> int:
+    """Binary-search iterations over ``requests`` (+1 for the empty tail)."""
+    return max(1, (requests + 1).bit_length())
+
+
+@tilelang.jit(pass_configs=_PASS)
+def builder_kernel(max_requests: int, page: int, ratio: int, circular: bool):
+    """A metadata builder's ``requests`` and ``tokens`` in one launch: the request
+    blocks first (``ceil((max_requests + 1) / 128)``), then the token blocks (the
+    first ``ceil(nt / 128)`` blocks of rows). The two parts read only the step's
+    inputs, never each other's outputs."""
+    cover = T.dynamic("cover")  # rows written: the first ceil(nt / 128) blocks
+    starts_len = T.dynamic("starts_len")
+    seq_len = T.dynamic("seq_len")
+    table_rows = T.dynamic("table_rows")
+    table_cols = T.dynamic("table_cols")
+    table_stride = T.dynamic("table_stride")
+    slot_rows = T.dynamic("slot_rows")
+    steps = _search_steps(max_requests)
+    request_blocks = (max_requests + 1 + _BLOCK - 1) // _BLOCK
+
+    @T.prim_func
+    def metadata_builder(
+        starts: T.Tensor((starts_len,), T.int32),
+        seq: T.Tensor((seq_len,), T.int32),
+        table: T.StridedTensor((table_rows, table_cols), (table_stride, 1), T.int32),
+        input_slots: T.Tensor((slot_rows,), T.int64),
+        out_starts: T.Tensor((max_requests + 1,), T.int32),
+        request_positions: T.Tensor((max_requests,), T.int64),
+        counts: T.Tensor((2,), T.int32),
+        positions: T.Tensor((cover,), T.int64),
+        reqs: T.Tensor((cover,), T.int32),
+        slots: T.Tensor((cover,), T.int64),
+        visible: T.Tensor((cover,), T.int32),
+        nr: T.int32,
+        nt: T.int32,
+    ):
+        with T.Kernel(request_blocks + T.ceildiv(cover, _BLOCK), threads=_BLOCK) as bx:
+            pdl.chain()
+            tx = T.get_thread_binding()
+            bounds = T.alloc_local((2,), T.int32)
+            if bx < request_blocks:
+                r = bx * _BLOCK + tx
+                if r <= max_requests:
+                    start = T.if_then_else(r <= nr, starts[r], nt)
+                    end = T.if_then_else(r < nr, starts[r + 1], nt)
+                    out_starts[r] = start
+                    if r < max_requests:
+                        request_positions[r] = T.if_then_else(
+                            r < nr,
+                            T.Cast(T.int64, seq[r] - (end - start)),
+                            T.int64(-1),
+                        )
+                if r == 0:
+                    counts[0] = nt
+                    counts[1] = nr
+            else:
+                t = (bx - request_blocks) * _BLOCK + tx
+                if t < cover:
+                    # The request whose rows contain t (Triton's upper-bound search).
+                    bounds[0] = 0
+                    bounds[1] = nr
+                    for _ in T.serial(steps):
+                        if bounds[0] < bounds[1]:
+                            mid = (bounds[0] + bounds[1]) // 2
+                            end_mid = T.if_then_else(mid < nr, starts[mid + 1], nt)
+                            if end_mid <= t:
+                                bounds[0] = mid + 1
+                            else:
+                                bounds[1] = mid
+                    lo = bounds[0]
+                    live = (t < nt) & (lo < nr)
+                    start = T.if_then_else(live, starts[lo], 0)
+                    end = T.if_then_else(live, starts[lo + 1], 0)
+                    sq = T.if_then_else(live, seq[lo], 0)
+                    pos = (
+                        T.Cast(T.int64, sq) - T.Cast(T.int64, end - start) + (t - start)
+                    )
+                    input_slot = T.if_then_else(t < nt, input_slots[t], T.int64(-1))
+                    if circular:
+                        valid0 = live & (pos >= 0)
+                    else:
+                        valid0 = live & (pos >= 0) & (input_slot >= 0)
+                    logical = T.truncdiv(pos, ratio)
+                    page_col = T.int64(0) if circular else T.truncdiv(logical, page)
+                    valid1 = valid0 & (page_col < table_cols)
+                    block = T.if_then_else(
+                        valid1, T.Cast(T.int64, table[lo, page_col]), T.int64(0)
+                    )
+                    valid = valid1 & (block > 0)
+                    slot = block * page + T.truncmod(logical, page)
+                    emit = valid & (T.truncmod(pos + 1, ratio) == 0)
+                    if circular:
+                        # Only a request's last ring-size rows take a ring slot: the
+                        # earlier rows of a long chunk would share them.
+                        emit = emit & (t >= end - page)
+                    positions[t] = T.if_then_else(valid, pos, T.int64(-1))
+                    reqs[t] = T.if_then_else(valid, lo, -1)
+                    slots[t] = T.if_then_else(emit, slot, T.int64(-1))
+                    visible[t] = T.if_then_else(
+                        valid, T.Cast(T.int32, T.truncdiv(pos + 1, ratio)), 0
+                    )
+
+    return metadata_builder
+
+
+def _window_macro(
+    page, window, width, draft, replay, threads, per_thread, *, pad: bool = False
+):
+    """One row's sliding-window metadata (``chunk``), for a block of ``threads``
+    threads."""
+
+    @T.macro
+    def window_row(
+        row, tx, info, positions, reqs, table, swa, lengths, top_lengths, visible,
+        starts, request_positions, replay_start, is_padding, offset,
+    ):  # fmt: skip
+        req = reqs[offset + row]
+        pos = positions[offset + row]
+        if pad:
+            padded = is_padding[offset + row] != T.uint8(0)
+            valid = (req >= 0) & (pos >= 0) & (~padded)
+        else:
+            valid = (req >= 0) & (pos >= 0)
+        if draft:
+            first = T.if_then_else(valid, T.Cast(T.int64, starts[req]), T.int64(0))
+            end = T.if_then_else(valid, T.Cast(T.int64, starts[req + 1]), T.int64(0))
+            prefix = T.if_then_else(valid, request_positions[req], T.int64(0))
+            info[0] = T.max(prefix - window, T.int64(0))
+            if replay:
+                # The drafter's context rows are the CED decoder's kept rows:
+                # before the replay start its window holds nothing written.
+                info[0] = T.max(
+                    info[0], T.if_then_else(valid, replay_start[req], T.int64(0))
+                )
+            length = prefix + end - first - info[0]
+        else:
+            info[0] = T.max(pos + 1 - window, T.int64(0))
+            if replay:
+                info[0] = T.max(
+                    info[0], T.if_then_else(valid, replay_start[req], T.int64(0))
+                )
+            length = pos + 1 - info[0]
+        info[1] = T.if_then_else(
+            valid, T.min(T.max(length, T.int64(0)), T.int64(width)), T.int64(0)
+        )
+        for k in T.serial(per_thread):
+            col = k * threads + tx
+            if col < width:
+                logical = info[0] + col
+                inside = valid & (logical >= 0) & (col < info[1])
+                page_id = T.if_then_else(
+                    inside,
+                    T.Cast(T.int64, table[req, T.truncdiv(logical, page)]),
+                    T.int64(-1),
+                )
+                physical = page_id * page + T.truncmod(logical, page)
+                swa[row, col] = T.if_then_else(
+                    (page_id > 0) & (logical >= 0) & (col < info[1]),
+                    T.Cast(T.int32, physical),
+                    -1,
+                )
+        if tx == 0:
+            lengths[row] = T.Cast(T.int32, T.max(info[1], T.int64(0)))
+            top_lengths[row] = T.if_then_else(
+                valid, T.min(T.max(visible[offset + row], 0), _TOP), 0
+            )
+
+    return window_row
+
+
+def _live_pages(visible, page: int, read_width):
+    """The page-table columns a row's readers reach: the pages holding its
+    ``visible`` entries (``page`` a page), at most ``read_width``."""
+    return T.min((T.max(visible, 0) + page - 1) // page, read_width)
+
+
+def _threads(width: int) -> tuple[int, int]:
+    threads = min(256, max(32, (width + 31) // 32 * 32))
+    return threads, (width + threads - 1) // threads
+
+
+@tilelang.jit(pass_configs=_PASS)
+def chunk_kernel(
+    page: int, window: int, width: int, draft: bool, replay: bool, pad: bool = False
+):
+    rows = T.dynamic("rows")
+    src_rows = T.dynamic("src_rows")
+    table_rows = T.dynamic("table_rows")
+    table_cols = T.dynamic("table_cols")
+    table_stride = T.dynamic("table_stride")
+    req_count = T.dynamic("req_count")
+    starts_len = T.dynamic("starts_len")
+    replay_len = T.dynamic("replay_len")
+    pad_len = T.dynamic("pad_len")
+    threads, per_thread = _threads(width)
+    window_row = _window_macro(
+        page, window, width, draft, replay, threads, per_thread, pad=pad
+    )
+
+    if not pad:
+
+        @T.prim_func
+        def metadata_chunk(
+            positions: T.Tensor((src_rows,), T.int64),
+            reqs: T.Tensor((src_rows,), T.int32),
+            table: T.StridedTensor((table_rows, table_cols), (table_stride, 1), T.int32),
+            swa: T.Tensor((rows, width), T.int32),
+            lengths: T.Tensor((rows,), T.int32),
+            top_lengths: T.Tensor((rows,), T.int32),
+            visible: T.Tensor((src_rows,), T.int32),
+            starts: T.Tensor((starts_len,), T.int32),
+            request_positions: T.Tensor((req_count,), T.int64),
+            replay_start: T.Tensor((replay_len,), T.int64),
+            offset: T.int32,
+        ):
+            with T.Kernel(rows, threads=threads) as row:
+                pdl.chain()
+                tx = T.get_thread_binding()
+                info = T.alloc_local((2,), T.int64)  # window start, clamped length
+                window_row(
+                    row, tx, info, positions, reqs, table, swa, lengths, top_lengths,
+                    visible, starts, request_positions, replay_start, None, offset,
+                )  # fmt: skip
+
+        return metadata_chunk
+
+    @T.prim_func
+    def metadata_chunk(
+        positions: T.Tensor((src_rows,), T.int64),
+        reqs: T.Tensor((src_rows,), T.int32),
+        table: T.StridedTensor((table_rows, table_cols), (table_stride, 1), T.int32),
+        swa: T.Tensor((rows, width), T.int32),
+        lengths: T.Tensor((rows,), T.int32),
+        top_lengths: T.Tensor((rows,), T.int32),
+        visible: T.Tensor((src_rows,), T.int32),
+        starts: T.Tensor((starts_len,), T.int32),
+        request_positions: T.Tensor((req_count,), T.int64),
+        replay_start: T.Tensor((replay_len,), T.int64),
+        is_padding: T.Tensor((pad_len,), T.uint8),
+        offset: T.int32,
+    ):
+        with T.Kernel(rows, threads=threads) as row:
+            pdl.chain()
+            tx = T.get_thread_binding()
+            info = T.alloc_local((2,), T.int64)  # window start, clamped length
+            window_row(
+                row, tx, info, positions, reqs, table, swa, lengths, top_lengths,
+                visible, starts, request_positions, replay_start, is_padding, offset,
+            )  # fmt: skip
+
+    return metadata_chunk
+
+
+@tilelang.jit(pass_configs=_PASS)
+def decode_metadata_kernel(
+    page: int,
+    window: int,
+    width: int,
+    draft: bool,
+    replay: bool,
+    main_width: int,
+    main_page: int,
+    pad: bool = False,
+):
+    """``chunk`` and ``pages`` of the main cache in one launch, a block for each part
+    of each row: the window metadata and the main page table (block 0 and holes as
+    -1) over the pages of the row's ``visible`` entries (``main_page`` a page)."""
+    rows = T.dynamic("rows")
+    src_rows = T.dynamic("src_rows")
+    table_rows = T.dynamic("table_rows")
+    table_cols = T.dynamic("table_cols")
+    table_stride = T.dynamic("table_stride")
+    main_src_rows = T.dynamic("main_src_rows")
+    main_rows = T.dynamic("main_rows")
+    main_cols = T.dynamic("main_cols")
+    main_stride = T.dynamic("main_stride")
+    req_count = T.dynamic("req_count")
+    starts_len = T.dynamic("starts_len")
+    replay_len = T.dynamic("replay_len")
+    pad_len = T.dynamic("pad_len")
+    threads, per_thread = _threads(width)
+    window_row = _window_macro(
+        page, window, width, draft, replay, threads, per_thread, pad=pad
+    )
+    groups = (main_width + _GROUP * threads - 1) // (_GROUP * threads)
+
+    @T.macro
+    def decode_row(
+        row, part, positions, reqs, table, swa, lengths, top_lengths, visible,
+        starts, request_positions, replay_start, main_reqs, main_table,
+        main_pages, is_padding, offset, main_read_width,
+    ):  # fmt: skip
+        tx = T.get_thread_binding()
+        info = T.alloc_local((2,), T.int64)  # window start, clamped length
+        live = T.alloc_var(T.int32)  # the page part's columns
+        entries = T.alloc_local((groups * _GROUP,), T.int32)
+        if part == 0:
+            window_row(
+                row, tx, info, positions, reqs, table, swa, lengths, top_lengths,
+                visible, starts, request_positions, replay_start, is_padding, offset,
+            )  # fmt: skip
+        else:
+            req = main_reqs[offset + row]
+            live = _live_pages(
+                visible[offset + row], main_page, T.min(main_read_width, main_width)
+            )
+            if req < 0:
+                live = 0
+            if pad:
+                if is_padding[offset + row] != T.uint8(0):
+                    live = 0
+            for g in T.unroll(groups):
+                if g * _GROUP * threads < live:
+                    for k in T.unroll(_GROUP):
+                        col = (g * _GROUP + k) * threads + tx
+                        entries[g * _GROUP + k] = T.if_then_else(
+                            col < live, main_table[req, col], 0
+                        )
+            for g in T.unroll(groups):
+                if g * _GROUP * threads < live:
+                    for k in T.unroll(_GROUP):
+                        col = (g * _GROUP + k) * threads + tx
+                        if col < live:
+                            main_pages[row, col] = T.if_then_else(
+                                entries[g * _GROUP + k] > 0,
+                                entries[g * _GROUP + k],
+                                -1,
+                            )
+
+    if not pad:
+
+        @T.prim_func
+        def metadata_decode(
+            positions: T.Tensor((src_rows,), T.int64),
+            reqs: T.Tensor((src_rows,), T.int32),
+            table: T.StridedTensor((table_rows, table_cols), (table_stride, 1), T.int32),
+            swa: T.Tensor((rows, width), T.int32),
+            lengths: T.Tensor((rows,), T.int32),
+            top_lengths: T.Tensor((rows,), T.int32),
+            visible: T.Tensor((src_rows,), T.int32),
+            starts: T.Tensor((starts_len,), T.int32),
+            request_positions: T.Tensor((req_count,), T.int64),
+            replay_start: T.Tensor((replay_len,), T.int64),
+            main_reqs: T.Tensor((main_src_rows,), T.int32),
+            main_table: T.StridedTensor((main_rows, main_cols), (main_stride, 1), T.int32),
+            main_pages: T.Tensor((rows, main_width), T.int32),
+            offset: T.int32,
+            main_read_width: T.int32,
+        ):
+            with T.Kernel(rows, 2, threads=threads) as (row, part):
+                pdl.chain()
+                decode_row(
+                    row, part, positions, reqs, table, swa, lengths, top_lengths,
+                    visible, starts, request_positions, replay_start, main_reqs,
+                    main_table, main_pages, None, offset, main_read_width,
+                )  # fmt: skip
+
+        return metadata_decode
+
+    @T.prim_func
+    def metadata_decode(
+        positions: T.Tensor((src_rows,), T.int64),
+        reqs: T.Tensor((src_rows,), T.int32),
+        table: T.StridedTensor((table_rows, table_cols), (table_stride, 1), T.int32),
+        swa: T.Tensor((rows, width), T.int32),
+        lengths: T.Tensor((rows,), T.int32),
+        top_lengths: T.Tensor((rows,), T.int32),
+        visible: T.Tensor((src_rows,), T.int32),
+        starts: T.Tensor((starts_len,), T.int32),
+        request_positions: T.Tensor((req_count,), T.int64),
+        replay_start: T.Tensor((replay_len,), T.int64),
+        main_reqs: T.Tensor((main_src_rows,), T.int32),
+        main_table: T.StridedTensor((main_rows, main_cols), (main_stride, 1), T.int32),
+        main_pages: T.Tensor((rows, main_width), T.int32),
+        is_padding: T.Tensor((pad_len,), T.uint8),
+        offset: T.int32,
+        main_read_width: T.int32,
+    ):
+        with T.Kernel(rows, 2, threads=threads) as (row, part):
+            pdl.chain()
+            decode_row(
+                row, part, positions, reqs, table, swa, lengths, top_lengths,
+                visible, starts, request_positions, replay_start, main_reqs,
+                main_table, main_pages, is_padding, offset, main_read_width,
+            )  # fmt: skip
+
+    return metadata_decode
+
+
+@tilelang.jit(pass_configs=_PASS)
+def pages_kernel(width: int, page: int):
+    """Each row's page table over the pages of its ``lengths`` entries (``page`` a
+    page)."""
+    rows = T.dynamic("rows")
+    src_rows = T.dynamic("src_rows")
+    table_rows = T.dynamic("table_rows")
+    table_cols = T.dynamic("table_cols")
+    table_stride = T.dynamic("table_stride")
+    groups = (width + _GROUP * _BLOCK - 1) // (_GROUP * _BLOCK)
+
+    @T.prim_func
+    def metadata_pages(
+        reqs: T.Tensor((src_rows,), T.int32),
+        lengths: T.Tensor((src_rows,), T.int32),
+        table: T.StridedTensor((table_rows, table_cols), (table_stride, 1), T.int32),
+        out: T.Tensor((rows, width), T.int32),
+        offset: T.int32,
+        read_width: T.int32,
+    ):
+        with T.Kernel(rows, threads=_BLOCK) as (row,):
+            pdl.chain()
+            tx = T.get_thread_binding()
+            live = T.alloc_var(T.int32)
+            entries = T.alloc_local((groups * _GROUP,), T.int32)
+            req = reqs[offset + row]
+            live = _live_pages(lengths[offset + row], page, T.min(read_width, width))
+            if req < 0:
+                live = 0
+            for g in T.unroll(groups):
+                if g * _GROUP * _BLOCK < live:
+                    for k in T.unroll(_GROUP):
+                        col = (g * _GROUP + k) * _BLOCK + tx
+                        entries[g * _GROUP + k] = T.if_then_else(
+                            col < live, table[req, col], 0
+                        )
+            for g in T.unroll(groups):
+                if g * _GROUP * _BLOCK < live:
+                    for k in T.unroll(_GROUP):
+                        col = (g * _GROUP + k) * _BLOCK + tx
+                        if col < live:
+                            # vLLM reserves physical block zero; page tables use -1 for holes.
+                            out[row, col] = T.if_then_else(
+                                entries[g * _GROUP + k] > 0,
+                                entries[g * _GROUP + k],
+                                -1,
+                            )
+
+    return metadata_pages
+
+
+def builder(
+    starts, seq, table, input_slots, out_starts, request_positions, counts, positions,
+    reqs, slots, visible, nr: int, nt: int, *, page: int, ratio: int, circular: bool,
+) -> None:  # fmt: skip
+    """``requests`` then ``tokens`` (module docstring), one launch: the request
+    starts, positions and counts, and the token rows of the first
+    ``max(1, ceil(nt / 128))`` blocks."""
+    cover = min(positions.shape[0], max(1, -(-nt // _BLOCK)) * _BLOCK)
+    builder_kernel(request_positions.shape[0], page, ratio, circular)(
+        starts, seq, table, input_slots, out_starts, request_positions, counts,
+        positions[:cover], reqs[:cover], slots[:cover], visible[:cover], nr, nt,
+    )  # fmt: skip
+
+
+@tilelang.jit(pass_configs=_PASS)
+def mask_lengths_kernel():
+    """Zero ``lengths[r]`` where ``is_padding[r] != 0``."""
+    rows = T.dynamic("rows")
+    pad_len = T.dynamic("pad_len")
+
+    @T.prim_func
+    def metadata_mask_lengths(
+        lengths: T.Tensor((rows,), T.int32),
+        is_padding: T.Tensor((pad_len,), T.uint8),
+        out: T.Tensor((rows,), T.int32),
+    ):
+        with T.Kernel(T.ceildiv(rows, _BLOCK), threads=_BLOCK) as bx:
+            pdl.chain()
+            r = bx * _BLOCK + T.get_thread_binding()
+            if r < rows:
+                out[r] = T.if_then_else(is_padding[r] != T.uint8(0), 0, lengths[r])
+
+    return metadata_mask_lengths
+
+
+def mask_lengths(lengths, is_padding, rows: int, out=None):
+    """Return ``lengths[:rows]`` with ``is_padding[:rows] != 0`` entries zeroed."""
+    if out is None:
+        out = lengths.new_empty(rows)
+    mask_lengths_kernel()(lengths[:rows], is_padding.view(torch.uint8), out[:rows])
+    return out[:rows]
+
+
+def chunk(
+    positions, reqs, table, swa, lengths, top_lengths, visible, starts,
+    request_positions, offset: int, rows: int, *, page: int, window: int,
+    draft: bool, replay_start=None, is_padding=None,
+) -> None:  # fmt: skip
+    """Window metadata for ``rows`` rows from source row ``offset``."""
+    width = swa.shape[1]
+    replay = replay_start is not None
+    pad = is_padding is not None
+    extra = (is_padding.view(torch.uint8),) if pad else ()
+    chunk_kernel(page, window, width, draft, replay, pad)(
+        positions, reqs, table, swa[:rows], lengths[:rows], top_lengths[:rows],
+        visible, starts, request_positions,
+        replay_start if replay_start is not None else request_positions,
+        *extra, offset,
+    )  # fmt: skip
+
+
+def decode_metadata(
+    positions, reqs, table, swa, lengths, top_lengths, visible, starts,
+    request_positions, main_reqs, main_table, main_pages, offset: int, rows: int,
+    main_read_width: int, *, page: int, window: int, draft: bool, main_page: int,
+    replay_start=None, is_padding=None,
+) -> None:  # fmt: skip
+    """``chunk`` then ``pages`` of the main cache for ``rows`` rows, one launch; a row's
+    main page table covers the pages of its ``visible`` entries, ``main_page`` a page
+    (its other columns keep their contents)."""
+    width, main_width = swa.shape[1], main_pages.shape[1]
+    replay = replay_start is not None
+    pad = is_padding is not None
+    extra = (is_padding.view(torch.uint8),) if pad else ()
+    decode_metadata_kernel(
+        page, window, width, draft, replay, main_width, main_page, pad
+    )(
+        positions, reqs, table, swa[:rows], lengths[:rows], top_lengths[:rows],
+        visible, starts, request_positions,
+        replay_start if replay_start is not None else request_positions, main_reqs,
+        main_table, main_pages[:rows], *extra, offset, main_read_width,
+    )  # fmt: skip
+
+
+def pages(
+    reqs, lengths, table, out, offset: int, rows: int, read_width: int, *, page: int
+) -> None:
+    """Page tables for ``rows`` rows from source row ``offset``, over the pages of
+    each row's ``lengths`` entries (``page`` a page; ``out`` is ``[*, width]``, its
+    other columns keep their contents)."""
+    end = offset + rows
+    pages_kernel(out.shape[1], page)(
+        reqs[:end], lengths[:end], table, out[:rows], offset, read_width
+    )
+
+
+__all__ = [
+    "mask_lengths",
+    "mask_lengths_kernel",
+    "builder",
+    "builder_kernel",
+    "chunk",
+    "chunk_kernel",
+    "decode_metadata",
+    "decode_metadata_kernel",
+    "pages",
+    "pages_kernel",
+]
diff --git a/vllm/models/deepseek_v4_1/tilelang/norm.py b/vllm/models/deepseek_v4_1/tilelang/norm.py
new file mode 100644
index 0000000000000000000000000000000000000000..afe212ded9dc217f6220cf86761ad10e5b0a97fa
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/tilelang/norm.py
@@ -0,0 +1,751 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Native TileLang RMSNorm and fused per-token cast for DeepSeek-V4.1."""
+
+import functools
+import math
+from typing import Optional, Union
+
+import tilelang
+import torch
+from tilelang.cuda import language as T
+from torch import nn
+
+from vllm.models.deepseek_v4_1.tilelang import pdl, prepare
+from vllm.models.deepseek_v4_1.tilelang.gemm import SF_BLOCK
+from vllm.models.deepseek_v4_1.tilelang.linear import MXFP8Rows, empty_mxfp8
+from vllm.models.deepseek_v4_1.tilelang.quant_common import (
+    IMPORT_BF16X2_FP8_CVT,
+    CastOutputConfig,
+    QuantTensor,
+    align,
+    alloc_scaling_factors,
+    cast_epilogue,
+    ceil_div,
+    get_cast_output_config,
+    get_packed_ue8m0_pack_factor,
+    get_packed_ue8m0_torch_dtype,
+    get_sf_and_inv,
+    get_sf_index,
+    get_sf_inv_dtype,
+    get_sf_shape,
+)
+
+
+@tilelang.jit
+def get_norm_forward_and_per_token_cast_kernel_cuda(
+    hidden: int,
+    with_weight: bool,
+    with_residual: bool,
+    eps: float,
+    out_scale: float,
+    x_dtype: T.dtype,
+    out_config: CastOutputConfig,
+    with_out_bf16: bool = False,
+    mega_moe_block_m: int = 0,
+    use_pdl: bool = False,
+):
+    assert 0 < hidden <= 8192
+    assert out_config.with_sf or out_config.dtype == x_dtype
+    assert not out_config.with_sf or out_config.sf_block == (1, 32)
+    assert not with_out_bf16 or out_config.with_sf
+
+    # A row is split into 16-byte vectors, thread `row_offset` of the row holds
+    # vectors `vi * row_threads + row_offset`.
+    num_threads = 128
+    num_elems_per_thread = 32
+    vec_size = math.gcd(16 // x_dtype.bytes, hidden)
+    num_vecs = hidden // vec_size
+    row_threads = min(
+        num_threads,
+        max(
+            min(8, tilelang.next_power_of_2(num_vecs)),
+            tilelang.next_power_of_2(ceil_div(hidden, num_elems_per_thread)),
+        ),
+    )
+
+    num_per_channels = out_config.sf_block[1]
+    group_lanes = num_per_channels // vec_size
+    num_sf_cols = ceil_div(hidden, num_per_channels)
+    packed_sf_pad = (
+        out_config.use_packed_ue8m0
+        and out_config.use_tma_aligned_col_major_sf
+        and num_sf_cols % 4 != 0
+    )
+    sf_inv_dtype = get_sf_inv_dtype(x_dtype, out_config)
+    if out_config.with_sf:
+        assert hidden % num_per_channels == 0
+    num_thread_vec = ceil_div(num_vecs, row_threads)
+    block_m = num_threads // row_threads
+    warp_threads = min(32, row_threads)
+    num_row_warps = row_threads // warp_threads
+    row_layout = T.Fragment(
+        (block_m, row_threads), forward_thread_fn=lambda i, j: i * row_threads + j
+    )
+    warp_layout = T.Fragment(
+        (block_m, num_row_warps),
+        forward_thread_fn=lambda i, w, rep: i * row_threads + w * warp_threads + rep,
+        replicate=warp_threads,
+    )
+    warp_reduce_layout = T.Fragment(
+        (block_m, num_row_warps, warp_threads),
+        forward_thread_fn=lambda i, w, j: i * row_threads + w * warp_threads + j,
+    )
+    row_reduce_layout = T.Fragment(
+        (block_m, row_threads, num_row_warps),
+        forward_thread_fn=lambda i, j, w: i * row_threads + j,
+    )
+
+    mega_sf_tile_rows = 128
+    mega_sf_lane_rows = 32
+    mega_sf_cols = mega_sf_tile_rows // mega_sf_lane_rows
+    if mega_moe_block_m > 0:
+        assert (
+            out_config.with_sf
+            and out_config.round_sf
+            and hidden % mega_sf_tile_rows == 0
+        )
+    mega_moe_aligned_block_m = align(mega_moe_block_m, mega_sf_tile_rows)
+
+    batch = T.dynamic("batch")
+    num_tokens = T.dynamic("num_tokens")
+    x_stride = T.dynamic("x_stride")
+    x_batch_stride = T.dynamic("x_batch_stride")
+    out_stride = T.dynamic("out_stride")
+    out_batch_stride = T.dynamic("out_batch_stride")
+    out_bf16_stride = T.dynamic("out_bf16_stride")
+    out_bf16_batch_stride = T.dynamic("out_bf16_batch_stride")
+    residual_stride = T.dynamic("residual_stride")
+    residual_batch_stride = T.dynamic("residual_batch_stride")
+    residual_out_stride = T.dynamic("residual_out_stride")
+    residual_out_batch_stride = T.dynamic("residual_out_batch_stride")
+    out_sf_stride = T.dynamic("out_sf_stride")
+    out_sf_batch_stride = T.dynamic("out_sf_batch_stride")
+    mega_moe_sf_rows = T.dynamic("mega_moe_sf_rows")
+    sf_shape = (
+        get_sf_shape((num_tokens, hidden), out_config) if out_config.with_sf else (1, 1)
+    )
+
+    @T.macro
+    def get_mega_moe_sf_row(token_id: int):
+        i = token_id % mega_moe_block_m
+        return (
+            token_id // mega_moe_block_m * mega_moe_aligned_block_m
+            + i // mega_sf_tile_rows * mega_sf_tile_rows
+            + i % mega_sf_lane_rows * mega_sf_cols
+            + i % mega_sf_tile_rows // mega_sf_lane_rows
+        )
+
+    @T.prim_func
+    def norm_forward_and_per_token_cast_kernel(
+        x: T.StridedTensor[
+            (batch, num_tokens, hidden), (x_batch_stride, x_stride, 1), x_dtype
+        ],
+        out: T.StridedTensor[
+            (batch, num_tokens, hidden),
+            (out_batch_stride, out_stride, 1),
+            out_config.dtype,
+        ],
+        out_sf: T.StridedTensor[
+            (batch, *sf_shape),
+            (out_sf_batch_stride, out_sf_stride, 1),
+            out_config.sf_dtype,
+        ],
+        out_bf16: T.StridedTensor[
+            (batch, num_tokens, hidden),
+            (out_bf16_batch_stride, out_bf16_stride, 1),
+            T.bfloat16,
+        ],
+        mega_moe_sf: T.StridedTensor[
+            (mega_moe_sf_rows, hidden // 128, 4),
+            (4, mega_moe_sf_rows * 4, 1),
+            T.uint8,
+        ],
+        weight: T.Tensor[(hidden,), x_dtype],
+        rstd: T.Tensor[(batch, num_tokens), T.float32],
+        residual: T.StridedTensor[
+            (batch, num_tokens, hidden),
+            (residual_batch_stride, residual_stride, 1),
+            x_dtype,
+        ],
+        residual_out: T.StridedTensor[
+            (batch, num_tokens, hidden),
+            (residual_out_batch_stride, residual_out_stride, 1),
+            x_dtype,
+        ],
+    ):
+        with T.Kernel(
+            T.ceildiv(num_tokens, block_m), batch, threads=num_threads
+        ) as (pid_token, batch_id):
+            if sf_inv_dtype == T.bfloat16:
+                T.import_source(IMPORT_BF16X2_FP8_CVT)
+            T.assume(x_stride % 16 == 0)
+            T.assume(x_batch_stride % 16 == 0)
+            T.assume(out_stride % 16 == 0)
+            T.assume(out_batch_stride % 16 == 0)
+            if with_out_bf16:
+                T.assume(out_bf16_stride % 16 == 0)
+                T.assume(out_bf16_batch_stride % 16 == 0)
+            if with_residual:
+                T.assume(residual_stride % 16 == 0)
+                T.assume(residual_batch_stride % 16 == 0)
+                T.assume(residual_out_stride % 16 == 0)
+                T.assume(residual_out_batch_stride % 16 == 0)
+            T.annotate_min_blocks_per_sm(5)
+            if use_pdl:
+                T.pdl_sync()
+            tid = T.get_thread_binding()
+            row_id = tid // row_threads
+            row_offset = tid % row_threads
+            token_id = pid_token * block_m + row_id
+
+            sum_partial = T.alloc_fragment((block_m, row_threads), T.float32)
+            warp_reducer = T.alloc_reducer(
+                (block_m, num_row_warps), T.float32, op="sum"
+            )
+            warp_fragment = T.alloc_fragment((block_m, num_row_warps), T.float32)
+            sum_shared = T.alloc_shared((block_m, num_row_warps), T.float32)
+            row_partial = T.alloc_fragment(
+                (block_m, row_threads, num_row_warps), T.float32
+            )
+            sum_reducer = T.alloc_reducer((block_m, row_threads), T.float32, op="sum")
+            sum_fragment = T.alloc_fragment((block_m, row_threads), T.float32)
+            T.annotate_layout(
+                {
+                    sum_partial: row_layout,
+                    warp_fragment: warp_layout,
+                    row_partial: row_reduce_layout,
+                    sum_fragment: row_layout,
+                }
+            )
+            x_local = T.alloc_local((num_thread_vec, vec_size), x_dtype)
+            y_fp32_local = T.alloc_local((vec_size,), T.float32)
+            y_local = T.alloc_local((num_thread_vec, vec_size), x_dtype)
+            sum_local = T.alloc_local((2,), T.float32)
+            if with_residual:
+                residual_local = T.alloc_local((vec_size,), x_dtype)
+            if with_weight:
+                weight_local = T.alloc_local((vec_size,), x_dtype)
+            if out_config.with_sf:
+                sf_local = T.alloc_local((num_thread_vec,), out_config.sf_dtype)
+                amax_local = T.alloc_local((num_thread_vec,), T.float32)
+
+            T.clear(sum_local)
+            for vi in T.unroll(num_thread_vec):
+                token_offset = (vi * row_threads + row_offset) * vec_size
+                if token_id < num_tokens and token_offset < hidden:
+                    for j in T.vectorized(vec_size):
+                        x_local[vi, j] = x[batch_id, token_id, token_offset + j]
+                    if with_residual:
+                        for j in T.vectorized(vec_size):
+                            residual_local[j] = residual[
+                                batch_id, token_id, token_offset + j
+                            ]
+                        for j in T.vectorized(vec_size):
+                            x_local[vi, j] += residual_local[j]
+                        for j in T.vectorized(vec_size):
+                            residual_out[batch_id, token_id, token_offset + j] = (
+                                x_local[vi, j]
+                            )
+                else:
+                    T.clear(x_local[vi, :])
+                for j in T.vectorized(vec_size):
+                    sum_local[j % 2] += T.float32(x_local[vi, j]) * T.float32(
+                        x_local[vi, j]
+                    )
+
+            sum_partial[row_id, row_offset] = sum_local[0] + sum_local[1]
+            T.reducer_init(warp_reducer)
+            for i, w, j in T.Parallel(
+                block_m, num_row_warps, warp_threads, loop_layout=warp_reduce_layout
+            ):
+                T.reducer_update(
+                    warp_reducer[i, w], sum_partial[i, w * warp_threads + j]
+                )
+            T.finalize_reducer(warp_reducer, warp_fragment)
+            if row_offset % warp_threads == 0:
+                sum_shared[row_id, row_offset // warp_threads] = warp_fragment[
+                    row_id, row_offset // warp_threads
+                ]
+            T.sync_threads()
+            for i, j, w in T.Parallel(
+                block_m, row_threads, num_row_warps, loop_layout=row_reduce_layout
+            ):
+                row_partial[i, j, w] = sum_shared[i, w]
+            T.reducer_init(sum_reducer)
+            for i, j, w in T.Parallel(
+                block_m, row_threads, num_row_warps, loop_layout=row_reduce_layout
+            ):
+                T.reducer_update(sum_reducer[i, j], row_partial[i, j, w])
+            T.finalize_reducer(sum_reducer, sum_fragment)
+            rstd_value = T.alloc_var(
+                T.float32,
+                init=T.rsqrt(sum_fragment[row_id, row_offset] / hidden + eps),
+            )
+            if row_offset == 0 and token_id < num_tokens:
+                rstd[batch_id, token_id] = rstd_value
+
+            for vi in T.unroll(num_thread_vec):
+                token_offset = (vi * row_threads + row_offset) * vec_size
+                is_valid = token_id < num_tokens and token_offset < hidden
+                if with_weight:
+                    if token_offset < hidden:
+                        for j in T.vectorized(vec_size):
+                            weight_local[j] = weight[token_offset + j]
+                    for j in T.vectorized(vec_size):
+                        y_fp32_local[j] = (
+                            T.float32(x_local[vi, j])
+                            * rstd_value
+                            * (T.float32(weight_local[j]) * out_scale)
+                        )
+                else:
+                    for j in T.vectorized(vec_size):
+                        y_fp32_local[j] = (
+                            T.float32(x_local[vi, j]) * rstd_value * out_scale
+                        )
+                for j in T.vectorized(vec_size):
+                    y_local[vi, j] = y_fp32_local[j]
+                if not out_config.with_sf:
+                    if is_valid:
+                        for j in T.vectorized(vec_size):
+                            out[batch_id, token_id, token_offset + j] = y_local[vi, j]
+                else:
+                    if with_out_bf16 and is_valid:
+                        for j in T.vectorized(vec_size):
+                            out_bf16[batch_id, token_id, token_offset + j] = y_local[
+                                vi, j
+                            ]
+
+                    amax = T.alloc_var(T.float32, init=0.0)
+                    for j in T.unroll(vec_size):
+                        amax = T.max(amax, T.abs(y_fp32_local[j]))
+                    amax = T.float32(T.cast(amax, x_dtype))
+                    for i in T.unroll(int(math.log2(group_lanes))):
+                        amax = T.max(amax, T.shfl_xor(amax, 1 << i))
+                    amax_local[vi] = amax
+
+            if out_config.with_sf:
+                for vi in T.unroll(num_thread_vec):
+                    token_offset = (vi * row_threads + row_offset) * vec_size
+                    sf, sf_inv = get_sf_and_inv(amax_local[vi], out_config, sf_inv_dtype)
+                    sf_local[vi] = sf
+                    if token_id < num_tokens and token_offset < hidden:
+                        for j in T.vectorized(vec_size):
+                            out[batch_id, token_id, token_offset + j] = (
+                                y_local[vi, j] * sf_inv
+                            )
+
+            if out_config.with_sf:
+                if token_id < num_tokens and row_offset % group_lanes == 0:
+                    for vi in T.unroll(num_thread_vec):
+                        token_offset = (vi * row_threads + row_offset) * vec_size
+                        if token_offset < hidden:
+                            sf_col = token_offset // num_per_channels
+                            sf_row, sf_column = get_sf_index(
+                                token_id, sf_col, out_config
+                            )
+                            out_sf[batch_id, sf_row, sf_column] = sf_local[vi]
+                            if packed_sf_pad and sf_col == num_sf_cols - 1:
+                                for pad_col in T.unroll(
+                                    num_sf_cols, align(num_sf_cols, 4)
+                                ):
+                                    _, pad_column = get_sf_index(
+                                        token_id, pad_col, out_config
+                                    )
+                                    out_sf[batch_id, sf_row, pad_column] = 0
+                            if mega_moe_block_m > 0:
+                                exponent = (
+                                    sf_local[vi]
+                                    if out_config.use_packed_ue8m0
+                                    else T.cast(
+                                        T.reinterpret(sf_local[vi], T.uint32) >> 23,
+                                        T.uint8,
+                                    )
+                                )
+                                mega_moe_sf[
+                                    get_mega_moe_sf_row(token_id),
+                                    sf_col // 4,
+                                    sf_col % 4,
+                                ] = exponent
+
+            if use_pdl:
+                T.pdl_trigger()
+
+    return norm_forward_and_per_token_cast_kernel
+
+
+def norm_forward_and_per_token_cast_impl(
+    x: torch.Tensor,
+    weight: Optional[torch.Tensor],
+    eps: float,
+    fmt: str,
+    num_per_channels: Optional[int],
+    residual: Optional[torch.Tensor] = None,
+    out_scale: float = 1.0,
+    use_tma_aligned_col_major_sf: bool = False,
+    round_sf: bool = False,
+    use_packed_ue8m0: bool = False,
+    with_out_bf16: bool = False,
+    out: Optional[torch.Tensor] = None,
+    out_sf: Optional[torch.Tensor] = None,
+    out_bf16: Optional[torch.Tensor] = None,
+    residual_out: Optional[torch.Tensor] = None,
+    mega_moe_sf: Optional[torch.Tensor] = None,
+    mega_moe_block_m: int = 0,
+    use_pdl: bool = False,
+) -> tuple[
+    Union[torch.Tensor, QuantTensor],
+    Optional[torch.Tensor],
+    torch.Tensor,
+    torch.Tensor,
+]:
+    assert (
+        x.ndim in (2, 3)
+        and x.dtype in (torch.bfloat16, torch.float32)
+        and x.stride(-1) == 1
+    )
+    num_tokens, hidden = x.shape[-2:]
+    batch = x.shape[0] if x.ndim == 3 else 1
+    assert hidden > 0
+    assert hidden % 16 == 0 and hidden <= 8192
+
+    def batched(tensor):
+        return tensor.unsqueeze(0) if tensor is not None and x.ndim == 2 else tensor
+
+    if weight is not None:
+        assert (
+            weight.shape == (hidden,)
+            and weight.dtype == x.dtype
+            and weight.device == x.device
+            and weight.is_contiguous()
+        )
+
+    assert (fmt, num_per_channels) in [("e4m3", 32), ("bf16", None), ("fp32", None)]
+    out_config = get_cast_output_config(
+        fmt,
+        (1, num_per_channels or 1),
+        use_tma_aligned_col_major_sf,
+        round_sf,
+        use_packed_ue8m0,
+    )
+    assert (
+        out_config.with_sf or out_config.torch_dtype == x.dtype
+    ), "the unquantized output must match the input dtype"
+    assert not out_config.with_sf or hidden % num_per_channels == 0
+    assert (
+        not with_out_bf16 or out_config.with_sf
+    ), "the extra output is only needed with casting"
+    assert (mega_moe_sf is None) == (mega_moe_block_m == 0)
+    if mega_moe_sf is not None:
+        assert x.ndim == 2 and mega_moe_block_m > 0
+        assert out_config.with_sf and round_sf and hidden % 128 == 0
+        assert mega_moe_sf.device == x.device
+        assert (
+            mega_moe_sf.dtype == torch.int32
+            and mega_moe_sf.shape == (num_tokens, hidden // 128)
+            and mega_moe_sf.stride(0) == 1
+        )
+        num_mega_moe_sf_rows = mega_moe_sf.stride(1)
+        assert (
+            ceil_div(num_tokens, mega_moe_block_m) * align(mega_moe_block_m, 128)
+            <= num_mega_moe_sf_rows
+        )
+
+    if out is None:
+        out = torch.empty(x.shape, dtype=out_config.torch_dtype, device=x.device)
+    if out_config.with_sf:
+        if out_sf is None:
+            alloc_shape = (num_tokens, hidden)
+            if x.ndim == 3:
+                if use_tma_aligned_col_major_sf:
+                    sf_pack = (
+                        get_packed_ue8m0_pack_factor() if use_packed_ue8m0 else 1
+                    )
+                    alloc_shape = (
+                        num_tokens,
+                        batch * align(hidden, num_per_channels * sf_pack),
+                    )
+                else:
+                    alloc_shape = (batch * num_tokens, hidden)
+            out_sf = alloc_scaling_factors(alloc_shape, out_config, x.device)
+            if x.ndim == 3:
+                sf_rows, sf_cols = get_sf_shape((num_tokens, hidden), out_config)
+                out_sf = out_sf.as_strided(
+                    (batch, sf_rows, sf_cols),
+                    (sf_rows * out_sf.stride(0), out_sf.stride(0), 1),
+                )
+        else:
+            assert not use_tma_aligned_col_major_sf
+            if use_packed_ue8m0:
+                assert out_sf.dtype == get_packed_ue8m0_torch_dtype()
+                out_sf = out_sf.view(torch.uint8)
+            expected_sf_shape = get_sf_shape((num_tokens, hidden), out_config)
+            assert (
+                out_sf.shape == (*x.shape[:-2], *expected_sf_shape)
+                and out_sf.stride(-1) == 1
+            )
+            assert (
+                out_sf.dtype == out_config.sf_torch_dtype
+                and out_sf.device == x.device
+            )
+    else:
+        assert out_sf is None
+    if with_out_bf16:
+        if out_bf16 is None:
+            out_bf16 = torch.empty(x.shape, dtype=torch.bfloat16, device=x.device)
+    else:
+        assert out_bf16 is None
+    residual_out = (
+        torch.empty_like(x)
+        if residual is not None and residual_out is None
+        else residual_out
+    )
+    if out_bf16 is not None:
+        assert (
+            out_bf16.shape == x.shape
+            and out_bf16.dtype == torch.bfloat16
+            and out_bf16.device == x.device
+            and out_bf16.stride(-1) == 1
+        )
+    for tensor in (residual, residual_out):
+        if tensor is not None:
+            assert (
+                tensor.shape == x.shape
+                and tensor.dtype == x.dtype
+                and tensor.device == x.device
+                and tensor.stride(-1) == 1
+            )
+    assert (
+        out.shape == x.shape
+        and out.dtype == out_config.torch_dtype
+        and out.device == x.device
+        and out.stride(-1) == 1
+    )
+    rstd = torch.empty(x.shape[:-1], dtype=torch.float32, device=x.device)
+
+    kernel_kwargs = dict(
+        hidden=hidden,
+        with_weight=weight is not None,
+        with_residual=residual is not None,
+        eps=eps,
+        out_scale=out_scale,
+        x_dtype=T.dtype(x.dtype),
+        out_config=out_config,
+        with_out_bf16=with_out_bf16,
+        mega_moe_block_m=mega_moe_block_m,
+    )
+    if batch * num_tokens > 0:
+        for tensor in (x, out, out_bf16, residual, residual_out):
+            if tensor is not None:
+                assert all(stride % 16 == 0 for stride in tensor.stride()[:-1])
+        kernel = get_norm_forward_and_per_token_cast_kernel_cuda(
+            **kernel_kwargs, use_pdl=use_pdl
+        )
+        if mega_moe_sf is not None:
+            mega_moe_sf = (
+                mega_moe_sf.mT.view(torch.uint8).as_strided(
+                    (num_mega_moe_sf_rows, hidden // 128, 4),
+                    (4, num_mega_moe_sf_rows * 4, 1),
+                )
+            )
+        args = (
+            batched(x),
+            batched(out),
+            batched(out_sf),
+            batched(out_bf16),
+            mega_moe_sf,
+            weight,
+            batched(rstd),
+            batched(residual),
+            batched(residual_out),
+        )
+        kernel(*args)
+
+    norm_input = x if residual is None else residual_out
+    if out_config.with_sf:
+        if x.ndim == 3 and use_tma_aligned_col_major_sf:
+            sf_rows, sf_cols = out_sf.shape[-2:]
+            out_sf = out_sf.as_strided(
+                (batch * sf_rows, sf_cols), (out_sf.stride(1), 1)
+            )
+            out_sf = cast_epilogue(out_sf, out_config)
+            out_sf = out_sf.as_strided(
+                (batch, out_sf.shape[0], sf_rows),
+                (sf_rows * out_sf.stride(1), *out_sf.stride()),
+            )
+        else:
+            out_sf = cast_epilogue(out_sf, out_config)
+        return (out, out_sf), out_bf16, rstd, norm_input
+    return out, None, rstd, norm_input
+
+
+def norm_forward_and_per_token_cast(
+    x: torch.Tensor,
+    weight: Optional[torch.Tensor],
+    eps: float,
+    fmt: str,
+    num_per_channels: int,
+    residual: Optional[torch.Tensor] = None,
+    out_scale: float = 1.0,
+    use_tma_aligned_col_major_sf: bool = False,
+    round_sf: bool = False,
+    use_packed_ue8m0: bool = False,
+    with_out_bf16: bool = False,
+    out: Optional[QuantTensor] = None,
+    out_bf16: Optional[torch.Tensor] = None,
+    residual_out: Optional[torch.Tensor] = None,
+    mega_moe_sf: Optional[torch.Tensor] = None,
+    mega_moe_block_m: int = 0,
+    *,
+    use_pdl: bool = False,
+) -> tuple[QuantTensor, Optional[torch.Tensor], torch.Tensor, torch.Tensor]:
+    """RMSNorm with optional residual addition, cast to FP8 with per-token scales."""
+    out_x, out_sf = (None, None) if out is None else out
+    return norm_forward_and_per_token_cast_impl(
+        x,
+        weight,
+        eps,
+        fmt,
+        num_per_channels,
+        residual,
+        out_scale,
+        use_tma_aligned_col_major_sf=use_tma_aligned_col_major_sf,
+        round_sf=round_sf,
+        use_packed_ue8m0=use_packed_ue8m0,
+        with_out_bf16=with_out_bf16,
+        out=out_x,
+        out_sf=out_sf,
+        out_bf16=out_bf16,
+        residual_out=residual_out,
+        mega_moe_sf=mega_moe_sf,
+        mega_moe_block_m=mega_moe_block_m,
+        use_pdl=use_pdl,
+    )
+
+
+def norm_forward(
+    x: torch.Tensor,
+    weight: Optional[torch.Tensor],
+    eps: float,
+    residual: Optional[torch.Tensor] = None,
+    out_scale: float = 1.0,
+    out: Optional[torch.Tensor] = None,
+    residual_out: Optional[torch.Tensor] = None,
+    *,
+    use_pdl: bool = False,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """RMSNorm with optional input-dtype residual addition."""
+    assert x.dtype in (torch.bfloat16, torch.float32)
+    out, _, rstd, norm_input = norm_forward_and_per_token_cast_impl(
+        x,
+        weight,
+        eps,
+        "bf16" if x.dtype == torch.bfloat16 else "fp32",
+        None,
+        residual,
+        out_scale,
+        out=out,
+        residual_out=residual_out,
+        use_pdl=use_pdl,
+    )
+    return out, rstd, norm_input
+
+
+def _rmsnorm(
+    x: torch.Tensor, weight: torch.Tensor, out: torch.Tensor, eps: float
+) -> None:
+    pdl.norm_forward(x, weight, eps, out=out)
+
+
+@functools.cache
+def _warm(hidden: int, eps: float, dtype: torch.dtype) -> None:
+    """Native TileLang RMSNorm of one zero row of ``hidden`` (``dtype`` input and
+    weight), so its kernel (keyed by the width, eps and dtype, not the rows) is
+    compiled before the cache freezes."""
+    x = torch.zeros((1, hidden), dtype=dtype, device="cuda")
+    weight = torch.ones(hidden, dtype=dtype, device="cuda")
+    _rmsnorm(x, weight, torch.empty_like(x), eps)
+
+
+@functools.cache
+def _warm_with_cast(hidden: int, eps: float, dtype: torch.dtype) -> None:
+    """TileKernels' fused RMSNorm + MXFP8 per-token cast of one zero row."""
+    x = torch.zeros((1, hidden), dtype=dtype, device="cuda")
+    weight = torch.ones(hidden, dtype=dtype, device="cuda")
+    out_bf16 = torch.empty_like(x)
+    cast = empty_mxfp8(out_bf16)
+    pdl.norm_forward_and_per_token_cast(
+        x,
+        weight,
+        eps,
+        "e4m3",
+        SF_BLOCK,
+        round_sf=True,
+        use_packed_ue8m0=True,
+        with_out_bf16=True,
+        out=(cast.values[:1], cast.scales[:1].view(torch.int32)),
+        out_bf16=out_bf16,
+    )
+
+
+class TileLangRMSNorm(nn.Module):
+    """``y = x * rsqrt(mean(x^2) + eps) * weight`` in FP32, in the input dtype."""
+
+    def __init__(self, hidden_size: int, eps: float = 1e-6):
+        super().__init__()
+        self.weight = nn.Parameter(
+            torch.ones(hidden_size, dtype=torch.bfloat16), requires_grad=False
+        )
+        self.variance_epsilon = eps
+        self.with_cast = False
+
+    def declare_kernels(self) -> None:
+        """Native TileLang norm of this width; its input has the weight's dtype."""
+        hidden, eps, dtype = (
+            self.weight.shape[0],
+            self.variance_epsilon,
+            self.weight.dtype,
+        )
+        prepare.declare(warm=lambda: _warm(hidden, eps, dtype))
+        if self.with_cast:
+            prepare.declare(warm=lambda: _warm_with_cast(hidden, eps, dtype))
+
+    def forward_with_cast(
+        self, x: torch.Tensor, out: torch.Tensor | None = None
+    ) -> MXFP8Rows:
+        """The normalized rows (written into ``out`` when given) beside their
+        MXFP8 cast, in one TileKernels ``norm_forward_and_per_token_cast`` launch."""
+        if x.ndim != 2 or (out is not None and out.ndim != 2):
+            raise ValueError("forward_with_cast requires 2D input and output")
+        if out is None:
+            out = torch.empty(x.shape, dtype=x.dtype, device=x.device)
+        cast = empty_mxfp8(out)
+        m = x.shape[0]
+        if m:
+            pdl.norm_forward_and_per_token_cast(
+                x,
+                self.weight,
+                self.variance_epsilon,
+                "e4m3",
+                SF_BLOCK,
+                round_sf=True,
+                use_packed_ue8m0=True,
+                with_out_bf16=True,
+                out=(cast.values[:m], cast.scales[:m].view(torch.int32)),
+                out_bf16=out,
+            )
+        return cast
+
+    def forward(self, x: torch.Tensor, out: torch.Tensor | None = None) -> torch.Tensor:
+        """The normalized rows, into ``out`` (contiguous, ``x``'s rows) when given."""
+        if x.ndim == 2 and (out is None or out.ndim == 2):
+            if out is None:
+                out = torch.empty(x.shape, dtype=x.dtype, device=x.device)
+            pdl.norm_forward(x, self.weight, self.variance_epsilon, out=out)
+            return out
+        shape = x.shape
+        x = x.reshape(-1, shape[-1])
+        if out is None:
+            out = torch.empty(x.shape, dtype=x.dtype, device=x.device)
+        pdl.norm_forward(x, self.weight, self.variance_epsilon, out=out.view(x.shape))
+        return out.view(shape)
