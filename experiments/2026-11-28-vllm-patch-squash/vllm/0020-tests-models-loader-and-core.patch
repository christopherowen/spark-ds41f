+LAYERS = (1, 2, 5)
+METADATA = {
+    "general.base_model.0.name": "test-model",
+    "glp.mode": "project",
+    "glp.spec_version": 1,
+    "glp.rank": 1,
+    "glp.hook_point": glp.HOOK_POINT,
+    "glp.alpha_default": 0.75,
+    "glp.layer_ids_zero_based": "1,2,5",
+}
