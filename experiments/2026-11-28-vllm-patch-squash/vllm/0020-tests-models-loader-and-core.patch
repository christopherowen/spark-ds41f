+def _decode_mxfp4_pages_reference(pool: torch.Tensor, page: int) -> torch.Tensor:
+    lut = torch.tensor(
+        [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0],
+        dtype=torch.float32,
+        device=pool.device,
+    )
+    pages = pool.shape[0]
+    raw_bytes = pool[:, : page * 64].view(pages, page, 64).to(torch.int32)
+    scales = pool[:, page * 64 : page * 68].view(pages, page, 4).to(torch.int32)
+    even = raw_bytes & 15
+    odd = (raw_bytes >> 4) & 15
+    codes = torch.stack((even, odd), dim=-1).view(pages, page, 128)
+    mag = codes & 7
+    sign = torch.where((codes & 8) != 0, -1.0, 1.0)
+    scale_f32 = torch.bitwise_left_shift(scales, 23).view(torch.float32)
+    scale_expanded = scale_f32.repeat_interleave(32, dim=-1)
+    decoded = (sign * lut[mag] * scale_expanded).view(pages, page // 8, 8, 4, 32)
+    mean = decoded.mean(dim=2)
+    dev_sq = (decoded - mean.unsqueeze(2)).square().sum(dim=-1)
+    max_idx = (
+        dev_sq.argmax(dim=2, keepdim=True)
+        .unsqueeze(-1)
+        .expand(-1, -1, 1, -1, 32)
+    )
+    dom = torch.gather(decoded, 2, max_idx).squeeze(2)
+    blended = 0.85 * mean + 0.15 * dom
+    return blended.reshape(pages, page // 8, 128).to(torch.float8_e4m3fn)
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA required")
+def test_lsa_gpu_summarize_blocks_and_freeze_registration():
+    import tilelang
+    from vllm.models.deepseek_v4_1.tilelang import prepare
+    from vllm.models.deepseek_v4_1.tilelang.block_shortlist import (
+        STATE_BYTES,
+        summarize_blocks,
+    )
+    from vllm.models.deepseek_v4_1.tilelang.query_reuse import QueryReusePlan
+
+    cases = [
+        (16384, 128, False, 64),
+        (65536, 256, True, 512),
+        (131072, 256, True, 1024),
+    ]
+    calls = [prepare.call(summarize_blocks, 128), prepare.call(summarize_blocks, 256)]
+    for width, page, source, budget in cases:
+        calls.extend(
+            QueryReusePlan.calls(width, page, candidate_blocks=source, budget=budget)
+        )
+    tilelang.prepare(calls, num_workers=4)
+
+    gen = torch.Generator(device="cuda").manual_seed(20261106)
+    for page in (128, 256):
+        num_pages = 6
+        pool = torch.zeros(
+            num_pages, page * STATE_BYTES + 128, dtype=torch.uint8, device="cuda"
+        )[:, : page * STATE_BYTES]
+        pool[:, : page * 64] = torch.randint(
+            0,
+            256,
+            (num_pages, page * 64),
+            generator=gen,
+            dtype=torch.int32,
+            device="cuda",
+        ).to(torch.uint8)
+        pool[:, page * 64 : page * 68] = torch.randint(
+            120,
+            132,
+            (num_pages, page * 4),
+            generator=gen,
+            dtype=torch.int32,
+            device="cuda",
+        ).to(torch.uint8)
+
+        # Complete pages 0, 2, 4; page 1 has non-terminal slot; page 3 is untouched.
+        slots = torch.tensor(
+            [page - 1, page + 5, 2 * page + page - 1, -1, 4 * page + page - 1],
+            dtype=torch.int64,
+            device="cuda",
+        )
+        summarize_blocks(page)(pool, pool.view(torch.float8_e4m3fn), slots)
+        ref = _decode_mxfp4_pages_reference(pool, page)
+        actual = pool.view(torch.float8_e4m3fn)[:, page * 68 : page * STATE_BYTES].view(
+            num_pages, page // 8, 128
+        )
+        for p_idx in (0, 2, 4):
+            assert torch.equal(
+                actual[p_idx].view(torch.uint8), ref[p_idx].view(torch.uint8)
+            )
+        for p_idx in (1, 3, 5):
+            assert torch.count_nonzero(actual[p_idx].to(torch.float32)) == 0
