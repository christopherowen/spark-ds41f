+                torch.ones((64, 40), dtype=torch.uint8),
+            ),
+        )[1],
+    )
+    module.wq_b = lambda qr: torch.ones(
+        (qr.shape[0], n_local_heads * 512), dtype=torch.bfloat16
+    )
+    module._rope = lambda x, pos, role: x
+    module._o_proj = lambda output, sp_rows=None: (
+        events.append(("o_proj", tuple(output.shape))),
+        torch.zeros((4, 32), dtype=torch.bfloat16),
+    )[1]
+    monkeypatch.setattr(
+        attention,
+        "get_forward_context",
+        lambda: SimpleNamespace(attn_metadata=None),
