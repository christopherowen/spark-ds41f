+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""DeepSeek V4.1 on GB10: a quantization config's ignored layers take the
+wrapper's module names before any layer is built."""
+
+import pytest
+
+from vllm.model_executor.layers.linear import LinearBase
+from vllm.model_executor.model_loader.utils import configure_quant_config
+from vllm.models.deepseek_v4_1 import kernels
+from vllm.models.deepseek_v4_1.nvidia.vl_model import (
+    DeepseekV41ForCausalLM,
+    _make_deepseek_v4_vl_weights_mapper,
+)
+from vllm.models.deepseek_v4_1.quant_config import (
+    Block32FP8LinearMethod,
+    DeepseekV41FP8Config,
+)
+
+# DeepSeek-V4.1-Flash-1017's quantization_config (revision 1bae0e10).
+CHECKPOINT_QUANT = {
+    "quant_method": "fp8",
+    "activation_scheme": "dynamic",
+    "weight_block_size": [32, 32],
+    "scale_fmt": "ue8m0",
+    "expert_dtype": "fp4",
+}
+# Checkpoint names and the modules the wrapper builds for them.
+MODULES = {
+    "layers.1.engram.wkv": "language_model.model.layers.1.engram.wkv",
+    "layers.14.engram.wkv": "language_model.model.layers.14.engram.wkv",
+    "layers.0.attn.wq_b": "language_model.model.layers.0.attn.wq_b",
+    "layers.0.ffn.shared_experts.w2": (
+        "language_model.model.layers.0.ffn.shared_experts.down_proj"
+    ),
+    "embed.proj": "language_model.model.embed.proj",
+    "norm.proj": "language_model.model.norm.proj",
+    "hc_head_fn": "language_model.model.hc_head_fn",
+    "mtp.0.head": "language_model.model.mtp.0.head",
+    # A name already in the wrapper's namespace stays: mapping twice is safe.
+    "language_model.model.layers.1.engram.wkv": (
+        "language_model.model.layers.1.engram.wkv"
+    ),
+}
+
+
+def _configured(ignored_layers=None):
+    config = dict(CHECKPOINT_QUANT)
+    if ignored_layers is not None:
+        config["ignored_layers"] = list(ignored_layers)
+    quant = DeepseekV41FP8Config.from_config(config)
+    # The engine's hook, before the first instance of the model class exists.
+    configure_quant_config(quant, DeepseekV41ForCausalLM)
+    return quant
+
+
+def test_served_checkpoint_lists_no_ignored_layers() -> None:
+    """The served checkpoint ignores nothing: every linear stays block32 FP8."""
+    quant = _configured()
+
+    assert quant.ignored_layers == []
+    method = quant.get_quant_method(
+        LinearBase.__new__(LinearBase), "language_model.model.layers.1.engram.wkv"
+    )
+    assert isinstance(method, Block32FP8LinearMethod)
+
+
+def test_ignored_layers_take_the_wrapper_module_names() -> None:
+    quant = _configured(MODULES)
+
+    assert quant.ignored_layers == list(MODULES.values())
+    # A second model class of the same engine (a reload) changes nothing.
+    configure_quant_config(quant, DeepseekV41ForCausalLM)
+    assert quant.ignored_layers == list(MODULES.values())
+
+
+@pytest.mark.parametrize("layer_id", [1, 14])
+def test_ignored_engram_projection_is_not_quantized(layer_id) -> None:
+    """An ignored Engram projection gets the plain linear method at the prefix
+    the wrapper builds it with; its neighbour stays block32 FP8."""
+    quant = _configured([f"layers.{layer_id}.engram.wkv"])
+    layer = LinearBase.__new__(LinearBase)
+    prefix = f"language_model.model.layers.{layer_id}.engram.wkv"
+
+    ignored = quant.get_quant_method(layer, prefix)
+    assert type(ignored) is type(kernels.linear_method())
+    assert not isinstance(ignored, Block32FP8LinearMethod)
+    kept = quant.get_quant_method(
+        layer, f"language_model.model.layers.{layer_id}.attn.wq_b"
+    )
+    assert isinstance(kept, Block32FP8LinearMethod)
+
+
+@pytest.mark.parametrize("expert_dtype", ["fp4", "fp8"])
+def test_class_mapper_renames_modules_as_the_instance_mapper(expert_dtype) -> None:
+    """The class mapper carries the instance mapper's module renames and none of
+    its tensor, scale or drop rules."""
+    mapper = DeepseekV41ForCausalLM.hf_to_vllm_mapper
+    instance = _make_deepseek_v4_vl_weights_mapper(expert_dtype, "weight_scale_inv")
+
+    assert mapper.orig_to_new_prefix == instance.orig_to_new_prefix
+    assert not mapper.orig_to_new_regex
+    assert not mapper.orig_to_new_suffix
+    assert None not in mapper.orig_to_new_substr.values()
+    names = list(MODULES)
+    assert mapper.apply_list(names) == list(MODULES.values())
+    assert mapper.apply_list(names) == instance.get_rename_mapper().apply_list(names)
