+            super().__init__()
+            self.weight = torch.nn.Parameter(
+                torch.empty((64, 64), dtype=torch.bfloat16, device="cuda")
+            )
+            self._refresh_views()
+
+        def _refresh_views(self):
+            self.shard_weight = self.weight[:32]
+
+    m = _WithShardView()
+    buddy_big = tmp_path / "buddy_big"
+    buddy_big.write_text(
+        "Node 0, zone   Normal   10 10 10 10  64 0 0 0 0  64 0 0 0 0\n",
+        encoding="utf-8",
+    )
+    arena = direct_loader.bind_weight_arena(
+        m,
+        torch.device("cuda"),
+        order13_sponge=True,
+        sponge_min_model_bytes=0,
+        buddyinfo_path=buddy_big,
+        page_bytes=4096,
+        retain_sponge=True,
+    )
+    assert arena is not None
+    assert hasattr(m, "_direct_buddy_sponge") and len(m._direct_buddy_sponge) > 0
+    assert (
+        m.shard_weight.untyped_storage().data_ptr()
+        == arena.untyped_storage().data_ptr()
+    )
+    direct_loader.release_weight_arena_sponge(m, torch.device("cuda"))
+    assert not hasattr(m, "_direct_buddy_sponge")
+
+
+    # 3. Verify 4 KiB PTE overhead discounting and _trim_sponge_for_post_load
+    # release/trim guards prevent 4 KiB-page post-load MemAvailable exhaustion.
+    meminfo_tight = tmp_path / "meminfo_tight"
+    meminfo_tight.write_text(
+        f"MemAvailable: {(64 << 10)} kB\n",
+        encoding="utf-8",
+    )
+    buddy_ample = tmp_path / "buddy_ample"
+    buddy_ample.write_text(
+        "Node 0, zone   Normal   0 0 0 0  512 0 0 0 0  512 0 0 0 0\n",
+        encoding="utf-8",
+    )
+    sp_4k = direct_loader._allocate_order13_sponge(
+        torch.device("cuda"),
+        required_bytes=32 << 20,
+        buddyinfo_path=buddy_ample,
+        meminfo_path=meminfo_tight,
+        page_bytes=4096,
+        headroom_bytes=16 << 20,
+        chunk_bytes=2 << 20,
+    )
+    sp_64k = direct_loader._allocate_order13_sponge(
+        torch.device("cuda"),
+        required_bytes=32 << 20,
+        buddyinfo_path=buddy_ample,
+        meminfo_path=meminfo_tight,
+        page_bytes=65536,
+        headroom_bytes=16 << 20,
+        chunk_bytes=2 << 20,
+    )
+    # 64 MiB avail - 16 MiB headroom = 48 MiB; on 4 KiB kernels 48*(48/49)=47 MiB
+    # -> 47-32=15 MiB (7 chunks) vs 64 KiB's 48-32=16 MiB (8 chunks).
+    assert len(sp_4k) == 7 and len(sp_64k) == 8
+    sp_64k.clear()
+
+    # Trim when post-arena MemAvailable is below post_load_headroom_bytes:
+    meminfo_post = tmp_path / "meminfo_post"
+    meminfo_post.write_text(f"MemAvailable: {(10 << 10)} kB\n", encoding="utf-8")
+    trimmed = direct_loader._trim_sponge_for_post_load(
+        sp_4k,
+        torch.device("cuda"),
+        target_bsz=2 << 20,
+        buddyinfo_path=buddy_ample,
+        meminfo_path=meminfo_post,
+        page_bytes=4096,
+        post_load_headroom_bytes=16 << 20,
+        min_high_bytes=4 << 20,
+    )
+    assert len(trimmed) == 4  # dropped ceil(6 MiB / 2 MiB) = 3 chunks from 7
+
+    # Full release when remaining >= target_bsz blocks are exhausted:
+    buddy_exhausted = tmp_path / "buddy_exhausted"
+    buddy_exhausted.write_text(
+        "Node 0, zone   Normal   0 0 0 0  64 0 0 0 0  0 0 0 0 0\n",
+        encoding="utf-8",
+    )
+    released = direct_loader._trim_sponge_for_post_load(
+        trimmed,
+        torch.device("cuda"),
+        target_bsz=2 << 20,
+        buddyinfo_path=buddy_exhausted,
+        meminfo_path=meminfo_tight,
+        page_bytes=4096,
+        post_load_headroom_bytes=16 << 20,
+        min_high_bytes=4 << 20,
+    )
+    assert len(released) == 0
