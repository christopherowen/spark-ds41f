+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import numpy as np
+import pytest
+import torch
+
+from vllm.models.deepseek_v4_1.expert_slots.cache import RouterLookaheadPredictor
+from vllm.models.deepseek_v4_1.expert_slots.hotlist import (
+    HOTLIST_MULTIDOMAIN_HELDOUT,
+    load_expert_hotlist,
+)
+
+
+def test_bundled_multidomain_hotlist_loads_all_layers():
+    hl = load_expert_hotlist("multidomain", 384)
+    assert len(hl) == 40
+    assert len(HOTLIST_MULTIDOMAIN_HELDOUT) == 40
+    for layer_idx in range(40):
+        arr = hl[layer_idx]
+        assert arr.shape == (384,)
+        assert arr.dtype == np.float64
+        assert np.all(arr >= 0)
+        if layer_idx > 0:
+            assert arr.sum() > 0
+
+
+def test_missing_hotlist_raises():
+    with pytest.raises(FileNotFoundError):
+        load_expert_hotlist("/nonexistent/ds41_hotlist.json", 384)
+
+
+def test_fast_bf16_lookahead_predict_topk_gpu():
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    torch.manual_seed(0)
+    w = torch.randn(32, 64, dtype=torch.bfloat16, device=device) * 0.1
+    bias = torch.randn(32, dtype=torch.bfloat16, device=device)
+    x = torch.randn(4, 64, dtype=torch.bfloat16, device=device) * 0.1
+    pred = RouterLookaheadPredictor(w, e_score_correction_bias=bias, top_k=6, max_rows=16)
+    tk = pred.predict_topk_gpu(x)
+    assert tk is not None
+    assert tk.shape == (4, 6)
+    assert tk.dtype == torch.int32
+    assert tk.device.type == device.type
+    assert pred.predict_topk_gpu(x[:0]) is None
+    assert pred.predict_topk_gpu(torch.randn(17, 64, dtype=torch.bfloat16, device=device)) is None
