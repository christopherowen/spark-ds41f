+            return
+        gathered = tensor_model_parallel_all_gather(flags[None], dim=0)
+        if not bool((gathered == flags[None]).all()):
+            raise RuntimeError(
+                "Sink detector flags differ across tensor-parallel ranks: "
+                f"{gathered.tolist()}"
+            )
