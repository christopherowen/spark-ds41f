+        logits: T.StridedTensor((num_logits, vocab), (logits_stride, 1), logits_dtype),
+        cu_num_logits: T.Tensor((cu_len,), T.int32),
+        num_sampled: T.Tensor((sampled_len,), T.int32),
+        alternates: T.Tensor((reqs, alts), T.int64),
