+++ b/vllm/v1/worker/gpu/sample/tilelang_bias.py
@@ -0,0 +1,343 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Allowed-token, sparse-bias and minimum-length candidate."""
+
+from vllm.tilelang_utils import T, tilelang
+from vllm.v1.worker.gpu.sample.tilelang_controls import (
+    _DTYPES,
+    _HEADER,
+    _PASS,
+    _declare,
+)
+
+
+def register_bias(
+    *,
+    vocab_size,
+    logits_strides,
+    allowed_stride,
+    bias_ids_stride,
+    bias_stride,
+    stop_stride,
+    width,
+):
+    _declare(
+        bias_kernel,
+        [
+            (
+                vocab_size,
+                stride,
+                allowed_stride,
+                bias_ids_stride,
+                bias_stride,
+                stop_stride,
+                width,
+                restore,
+                "int64",
+                "int64",
+                4 if stride % 4 == 0 else 1,
+            )
+            for stride in logits_strides
+            for restore in (False, True)
+        ],
+    )
+
+
+_THREADS = 128
+_ROW_TILE = (
+    8192  # Triton's LOGITS_BLOCK_SIZE: the row's fill and scan, a tile at a time
+)
+
+
+@tilelang.jit(pass_configs=_PASS)
+def bias_kernel(
+    vocab: int,
+    stride: int,
+    allowed_stride: int,
+    bias_ids_stride: int,
+    bias_stride: int,
+    stop_stride: int,
+    width: int,
+    restore: bool,
+    index_dtype: str,
+    position_dtype: str,
+    run: int,
+):
+    """``_bias_kernel`` in its tile form: a block a row, each list's ids and values
+    loaded (predicated on the list's length) before the gathered logits, and those
+    before any store, every masked store predicated. The row's -inf fill and the
+    all-masked scan take 8192 columns a tile; only the last, partial tile clamps
+    its loads and predicates its stores; with ``run`` 4 (16-byte aligned rows, the
+    launch checked) the whole tiles are filled and read as vectors in Triton's
+    layout. As Triton's maximum, the scan ignores NaN: a row is alive when some
+    logit is above -inf. A row with an allowed list reads back only its allowed ids:
+    every other column is the fill's -inf, or -inf or NaN where a bias met it, so
+    they decide the scan's answer without the row's second pass."""
+    rows, states, allowed_cols, bias_cols, bias_ids_cols, stop_cols = T.dynamic(
+        "rows, states, allowed_cols, bias_cols, bias_ids_cols, stop_cols"
+    )
+    per = max(width // _THREADS, 1)
+    row_per = _ROW_TILE // _THREADS
+    full = vocab // _ROW_TILE
+
+    def load_if(dtype, address, other, ok):
+        helper = (
+            "vllm_control_load_if_b32"
+            if dtype == "int32"
+            else ("vllm_control_load_if_f32")
+        )
+        return T.call_extern(dtype, helper, address, other, ok)
+
+    def store_if(address, value, ok):
+        return T.call_extern("handle", "vllm_control_store_if", address, value, ok)
+
+    @T.macro
+    def fill_row(logits, row, tx):
+        for tile in T.serial(full):
+            for r in T.unroll(row_per // run):
+                col0 = tile * _ROW_TILE + r * (_THREADS * run) + run * tx
+                for k in T.vectorized(run):
+                    logits[row, col0 + k] = -T.infinity("float32")
+        if vocab % _ROW_TILE:
+            for j in T.unroll(row_per):
+                col = full * _ROW_TILE + j * _THREADS + tx
+                store_if(
+                    T.address_of(logits[row, col]), -T.infinity("float32"), col < vocab
+                )
+
+    @T.macro
+    def scan_row(logits, row, tx, row_values, alive):
+        """Whether some column of the row is above -inf, the block's verdict in every
+        thread's ``alive[0]``. Each tile ends with ``__syncthreads_or`` (one barrier
+        that ORs the block's flags), and the scan stops at the first tile with a
+        live column: the answer cannot change after it. A dead row reads every
+        column, as Triton's maximum does."""
+        tile = T.alloc_var(T.int32, init=0)
+        while (tile < full) & (alive[0] == 0):
+            for r in T.unroll(row_per // run):
+                col0 = tile * _ROW_TILE + r * (_THREADS * run) + run * tx
+                for k in T.vectorized(run):
+                    row_values[r * run + k] = logits[row, col0 + k]
+            for j in T.unroll(row_per):
+                alive[0] = alive[0] | T.cast(
+                    row_values[j] > -T.infinity("float32"), "int32"
+                )
+            alive[0] = T.call_extern("int32", "__syncthreads_or", alive[0])
+            tile = tile + 1
+        # A trace-time width check around a runtime test: not one condition.
+        if vocab % _ROW_TILE:  # noqa: SIM102
+            if alive[0] == 0:
+                # A repeated last column does not change whether any is alive.
+                for j in T.unroll(row_per):
+                    col = full * _ROW_TILE + j * _THREADS + tx
+                    row_values[j] = logits[row, T.min(col, vocab - 1)]
+                for j in T.unroll(row_per):
+                    alive[0] = alive[0] | T.cast(
+                        row_values[j] > -T.infinity("float32"), "int32"
+                    )
+                alive[0] = T.call_extern("int32", "__syncthreads_or", alive[0])
+
+    @T.prim_func
+    def bias(
+        logits: T.StridedTensor((rows, vocab), (stride, 1), "float32"),
+        mapping: T.Tensor((rows,), index_dtype),
+        positions: T.Tensor((rows,), position_dtype),
+        num_allowed: T.Tensor((states,), "int32"),
+        allowed: T.StridedTensor((states, allowed_cols), (allowed_stride, 1), "int32"),
+        num_bias: T.Tensor((states,), "int32"),
+        bias_ids: T.StridedTensor(
+            (states, bias_ids_cols), (bias_ids_stride, 1), "int32"
+        ),
+        biases: T.StridedTensor((states, bias_cols), (bias_stride, 1), "float32"),
+        min_lens: T.Tensor((states,), "int32"),
+        num_stops: T.Tensor((states,), "int32"),
+        restore_row: T.Tensor((states,), "int32"),
+        stops: T.StridedTensor((states, stop_cols), (stop_stride, 1), "int32"),
+    ):
+        with T.Kernel(rows, threads=_THREADS) as block:
+            T.import_source(_HEADER)
+            tx = T.get_thread_binding()
+            row = T.cast(block, "int64")
+            req = T.alloc_var(T.int64, init=T.cast(mapping[block], "int64"))
+            safe_req = T.max(req, T.int64(0))
+            n_allowed = T.alloc_var(
+                T.int32, init=T.if_then_else(req >= 0, num_allowed[safe_req], 0)
+            )
+            n_bias = T.alloc_var(
+                T.int32, init=T.if_then_else(req >= 0, num_bias[safe_req], 0)
+            )
+            n_stops = T.alloc_var(
+                T.int32, init=T.if_then_else(req >= 0, num_stops[safe_req], 0)
+            )
+            position = T.alloc_var(position_dtype, init=positions[block])
+            min_len = T.alloc_var(
+                T.int32, init=T.if_then_else(req >= 0, min_lens[safe_req], 0)
+            )
+            # Whether this row restores its stop tokens when nothing else is left.
+            keep = T.alloc_var(
+                T.int32,
+                init=T.if_then_else(req >= 0, restore_row[safe_req], 0)
+                if restore
+                else 0,
+            )
+            ids = T.alloc_local((per,), "int32")
+            allowed_ids = T.alloc_local((per,), "int32")
+            values = T.alloc_local((per,), "float32")
+            extra = T.alloc_local((per,), "float32")
+            row_values = T.alloc_local((row_per,), "float32")
+            alive = T.alloc_local((1,), "int32")
+            if n_allowed > 0:
+                for k in T.unroll(per):
+                    col = k * _THREADS + tx
+                    ids[k] = load_if(
+                        "int32", T.address_of(allowed[req, col]), 0, col < n_allowed
+                    )
+                for k in T.unroll(per):
+                    allowed_ids[k] = ids[k]
+                for k in T.unroll(per):
+                    values[k] = load_if(
+                        "float32",
+                        T.address_of(logits[row, ids[k]]),
+                        T.float32(0),
+                        k * _THREADS + tx < n_allowed,
+                    )
+                T.sync_threads()
+                fill_row(logits, row, tx)
+                T.sync_threads()
+                for k in T.unroll(per):
+                    store_if(
+                        T.address_of(logits[row, ids[k]]),
+                        values[k],
+                        k * _THREADS + tx < n_allowed,
+                    )
+                T.sync_threads()
+            if n_bias > 0:
+                for k in T.unroll(per):
+                    col = k * _THREADS + tx
+                    ids[k] = load_if(
+                        "int32", T.address_of(bias_ids[req, col]), 0, col < n_bias
+                    )
+                    extra[k] = load_if(
+                        "float32",
+                        T.address_of(biases[req, col]),
+                        T.float32(0),
+                        col < n_bias,
+                    )
+                for k in T.unroll(per):
+                    values[k] = load_if(
+                        "float32",
+                        T.address_of(logits[row, ids[k]]),
+                        T.float32(0),
+                        k * _THREADS + tx < n_bias,
+                    )
+                for k in T.unroll(per):
+                    store_if(
+                        T.address_of(logits[row, ids[k]]),
+                        values[k] + extra[k],
+                        k * _THREADS + tx < n_bias,
+                    )
+                T.sync_threads()
+            if (n_stops > 0) & (position + 1 < min_len):
+                for k in T.unroll(per):
+                    col = k * _THREADS + tx
+                    ids[k] = load_if(
+                        "int32", T.address_of(stops[req, col]), 0, col < n_stops
+                    )
+                if keep != 0:
+                    for k in T.unroll(per):
+                        values[k] = load_if(
+                            "float32",
+                            T.address_of(logits[row, ids[k]]),
+                            -T.infinity("float32"),
+                            k * _THREADS + tx < n_stops,
+                        )
+                    T.sync_threads()
+                for k in T.unroll(per):
+                    store_if(
+                        T.address_of(logits[row, ids[k]]),
+                        -T.infinity("float32"),
+                        k * _THREADS + tx < n_stops,
+                    )
+                if keep != 0:
+                    T.sync_threads()
+                    alive[0] = 0
+                    if n_allowed > 0:
+                        for k in T.unroll(per):
+                            seen = load_if(
+                                "float32",
+                                T.address_of(logits[row, allowed_ids[k]]),
+                                -T.infinity("float32"),
+                                k * _THREADS + tx < n_allowed,
+                            )
+                            alive[0] = alive[0] | T.cast(
+                                seen > -T.infinity("float32"), "int32"
+                            )
+                        alive[0] = T.call_extern("int32", "__syncthreads_or", alive[0])
+                    else:
+                        scan_row(logits, row, tx, row_values, alive)
+                    for k in T.unroll(per):
+                        store_if(
+                            T.address_of(logits[row, ids[k]]),
+                            values[k],
+                            (alive[0] == 0)
+                            & (k * _THREADS + tx < n_stops)
+                            & (values[k] > -T.infinity("float32"))
+                            & (values[k] < T.infinity("float32")),
+                        )
+
+    return bias
+
+
+def _run(logits) -> int:
+    """4 when every row starts 16-byte aligned, else 1."""
+    return 4 if logits.data_ptr() % 16 == 0 and logits.stride(0) % 4 == 0 else 1
+
+
+def apply_logit_bias(
+    logits,
+    mapping,
+    positions,
+    num_allowed,
+    allowed,
+    num_bias,
+    bias_ids,
+    biases,
+    min_lens,
+    num_stops,
+    restore_row,
+    stops,
+    check_all_masked_rows=False,
+):
+    if logits.shape[0]:
+        width = (
+            1
+            << (
+                max(allowed.shape[1], bias_ids.shape[1], stops.shape[1]) - 1
+            ).bit_length()
+        )
+        bias_kernel(
+            logits.shape[1],
+            logits.stride(0),
+            allowed.stride(0),
+            bias_ids.stride(0),
+            biases.stride(0),
+            stops.stride(0),
+            width,
+            check_all_masked_rows,
+            _DTYPES[mapping.dtype],
+            _DTYPES[positions.dtype],
+            _run(logits),
+        )(
+            logits,
+            mapping,
+            positions,
+            num_allowed,
+            allowed,
+            num_bias,
+            bias_ids,
+            biases,
+            min_lens,
+            num_stops,
+            restore_row,
+            stops,
+        )
diff --git a/vllm/v1/worker/gpu/sample/tilelang_controls.py b/vllm/v1/worker/gpu/sample/tilelang_controls.py
new file mode 100644
index 0000000000000000000000000000000000000000..4831f35d9bdbc773ed0cb02c92eca453649a1ba3
--- /dev/null
+++ b/vllm/v1/worker/gpu/sample/tilelang_controls.py
@@ -0,0 +1,537 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Request-dependent logits processors with the V2 sampler's tensor layouts."""
+
+import torch
+
+from vllm.tilelang_utils import T, tilelang
+
+_PASS = {
+    tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True,
+    tilelang.PassConfigKey.TL_DISABLE_SAFE_MEMORY_ACCESS: True,
+}
+_DTYPES = {torch.int32: "int32", torch.int64: "int64"}
+_HEADER = r"""
+// Triton's bundled libdevice __nv_logf, as used by the sampling family.
+// CUDA's logf and lg2.approx * ln(2) can move a min-p threshold by one ULP.
+__device__ __forceinline__ float vllm_control_log(float x) {
+  float result;
+  asm("{\n"
+      ".reg .pred tiny, fin, zero;\n"
+      ".reg .b32 z, o, e, m, f, r, p, q, l, w;\n"
+      "setp.lt.f32 tiny, %1, 0f00800000;\n"
+      "mul.rn.f32 z, %1, 0f4B000000;\n"
+      "selp.f32 z, z, %1, tiny;\n"
+      "selp.f32 o, 0fC1B80000, 0f00000000, tiny;\n"
+      "add.s32 e, z, -1059760811;\n"
+      "and.b32 e, e, -8388608;\n"
+      "sub.s32 m, z, e;\n"
+      "cvt.rn.f32.s32 f, e;\n"
+      "fma.rn.ftz.f32 f, f, 0f34000000, o;\n"
+      "add.rn.f32 r, m, 0fBF800000;\n"
+      "fma.rn.ftz.f32 p, 0fBE055027, r, 0f3E1039F6;\n"
+      "fma.rn.ftz.f32 p, p, r, 0fBDF8CDCC;\n"
+      "fma.rn.ftz.f32 p, p, r, 0f3E0F2955;\n"
+      "fma.rn.ftz.f32 p, p, r, 0fBE2AD8B9;\n"
+      "fma.rn.ftz.f32 p, p, r, 0f3E4CED0B;\n"
+      "fma.rn.ftz.f32 p, p, r, 0fBE7FFF22;\n"
+      "fma.rn.ftz.f32 p, p, r, 0f3EAAAA78;\n"
+      "fma.rn.ftz.f32 p, p, r, 0fBF000000;\n"
+      "mul.rn.f32 q, r, p;\n"
+      "fma.rn.ftz.f32 q, q, r, r;\n"
+      "fma.rn.ftz.f32 l, f, 0f3F317218, q;\n"
+      // Preserve the bundled libdevice exceptional-value handling.
+      "setp.lt.u32 fin, z, 2139095040;\n"
+      "fma.rn.ftz.f32 w, z, 0f7F800000, 0f7F800000;\n"
+      "selp.f32 l, l, w, fin;\n"
+      "setp.eq.f32 zero, z, 0f00000000;\n"
+      "selp.f32 %0, 0fFF800000, l, zero;\n"
+      "}"
+      : "=f"(result) : "f"(x));
+  return result;
+}
+// Triton's masked loads and stores: a masked lane keeps ``other`` and never waits on
+// memory, and nothing branches, so a tile's loads issue together.
+__device__ __forceinline__ int vllm_control_load_if_b32(const void* p, int other,
+                                                       bool ok) {
+  int v = other;
+  asm volatile("{\n .reg .pred q;\n setp.ne.b32 q, %2, 0;\n"
+               " @q ld.global.b32 %0, [%1];\n}"
+               : "+r"(v) : "l"(p), "r"((int)ok));
+  return v;
+}
+__device__ __forceinline__ float vllm_control_load_if_f32(const void* p, float other,
+                                                         bool ok) {
+  float v = other;
+  asm volatile("{\n .reg .pred q;\n setp.ne.b32 q, %2, 0;\n"
+               " @q ld.global.f32 %0, [%1];\n}"
+               : "+f"(v) : "l"(p), "r"((int)ok));
+  return v;
+}
+__device__ __forceinline__ void vllm_control_store_if_b64(void* p, long long v,
+                                                          bool ok) {
+  asm volatile("{\n .reg .pred q;\n setp.ne.b32 q, %2, 0;\n"
+               " @q st.global.b64 [%0], %1;\n}"
+               :: "l"(p), "l"(v), "r"((int)ok) : "memory");
+}
+__device__ __forceinline__ void vllm_control_store_if(void* p, float v, bool ok) {
+  asm volatile("{\n .reg .pred q;\n setp.ne.b32 q, %2, 0;\n"
+               " @q st.global.f32 [%0], %1;\n}"
+               :: "l"(p), "f"(v), "r"((int)ok) : "memory");
+}
+__device__ __forceinline__ float vllm_control_reciprocal(float x) {
+  float y;
+  asm("rcp.approx.ftz.f32 %0, %1;" : "=f"(y) : "f"(x));
+  return y;
+}
+__device__ __forceinline__ float vllm_control_penalty(float x, float scale,
+    float freq, int count, float presence) {
+  x = __fmul_rn(x, scale);
+  x = __fmaf_rn(-freq, (float)count, x);
+  return __fmaf_rn(-presence, (float)(count > 0), x);
+}
+"""
+
+
+def _launch(factory, key, *tensors):
+    factory(*key)(*tensors)
+
+
+def _declare(factory, keys):
+    from vllm.model_executor.warmup.jit_warmup import JitWarmupRegistry
+
+    if JitWarmupRegistry.active() is None:
+        return
+    from vllm.models.deepseek_v4_1.tilelang.prepare import call, declare
+
+    declare(lambda: [call(factory, *key) for key in keys])
+
+
+def _min_p_column(start, j, tx, tile, threads, run):
+    """Column of thread ``tx``'s ``j``-th element in tile ``start``: runs of ``run``
+    consecutive columns, ``threads * run`` apart (Triton's layout for its loads)."""
+    return start * tile + (j // run) * (threads * run) + run * tx + j % run
+
+
+@tilelang.jit(pass_configs=_PASS)
+def min_p_kernel(
+    vocab: int,
+    stride: int,
+    index_dtype: str,
+    run: int,
+    threads: int = 256,
+    tile: int = 2048,
+):
+    """One row a block, in tiles of ``tile`` columns. Each tile's loads are issued
+    before its values are used: with ``run`` 4 (16-byte aligned rows, the launch
+    checked) as vectors, and in the last, partial tile at columns clamped to the row
+    (a repeated column does not change the maximum; its stores are predicated).
+    The threshold pass takes the tiles last to first, starting with those the
+    maximum's pass read last, which are likeliest still in L2: at 96 rows, whose
+    50 MB the L2 cannot hold, that is 12-14% faster than Triton's second forward
+    pass (experiments/2026-10-24-tilelang-completion, min-p round 2)."""
+    rows, states = T.dynamic("rows, states")
+    per_thread = tile // threads
+    full = vocab // tile
+    warps = threads // 32
+
+    @T.macro
+    def load_tile(values, src, row, start, tx):
+        for r in T.unroll(per_thread // run):
+            col0 = _min_p_column(start, r * run, tx, tile, threads, run)
+            for k in T.vectorized(run):
+                values[r * run + k] = src[row, col0 + k]
+
+    # The last, partial tile's threshold pass: loads at clamped columns, the stores
+    # predicated.
+    @T.macro
+    def threshold_tail(values, minimum, src, row, tx):
+        for j in T.unroll(per_thread):
+            col = _min_p_column(full, j, tx, tile, threads, run)
+            values[j] = src[row, T.min(col, vocab - 1)]
+        for j in T.unroll(per_thread):
+            col = _min_p_column(full, j, tx, tile, threads, run)
+            T.call_extern(
+                "handle",
+                "vllm_control_store_if",
+                T.address_of(src[row, col]),
+                T.if_then_else(
+                    values[j] < minimum[0], -T.infinity("float32"), values[j]
+                ),
+                col < vocab,
+            )
+
+    @T.prim_func
+    def min_p(
+        logits: T.StridedTensor((rows, vocab), (stride, 1), "float32"),
+        mapping: T.Tensor((rows,), index_dtype),
+        thresholds: T.Tensor((states,), "float32"),
+    ):
+        with T.Kernel(rows, threads=threads) as block:
+            T.import_source(_HEADER)
+            tx = T.get_thread_binding()
+            row = T.cast(block, "int64")
+            values = T.alloc_local((per_thread,), "float32")
+            best = T.alloc_local((1,), "float32")
+            minimum = T.alloc_local((1,), "float32")
+            partial = T.alloc_shared((warps,), "float32")
+            req = T.alloc_var(T.int64, init=T.cast(mapping[block], "int64"))
+            minimum[0] = T.if_then_else(
+                req >= T.int64(0),
+                thresholds[T.max(req, T.int64(0))],
+                T.float32(0),
+            )
+            if minimum[0] != 0:
+                best[0] = -T.infinity("float32")
+                for start in T.serial(full):
+                    load_tile(values, logits, row, start, tx)
+                    for j in T.unroll(per_thread):
+                        best[0] = T.max(best[0], values[j])
+                if vocab % tile:
+                    for j in T.unroll(per_thread):
+                        col = _min_p_column(full, j, tx, tile, threads, run)
+                        values[j] = logits[row, T.min(col, vocab - 1)]
+                    for j in T.unroll(per_thread):
+                        best[0] = T.max(best[0], values[j])
+                # The maximum ignores isolated NaNs, as Triton's does.
+                best[0] = T.max(best[0], T.shfl_xor(best[0], 16))
+                best[0] = T.max(best[0], T.shfl_xor(best[0], 8))
+                best[0] = T.max(best[0], T.shfl_xor(best[0], 4))
+                best[0] = T.max(best[0], T.shfl_xor(best[0], 2))
+                best[0] = T.max(best[0], T.shfl_xor(best[0], 1))
+                if tx % 32 == 0:
+                    partial[tx // 32] = best[0]
+                T.sync_threads()
+                best[0] = partial[0]
+                for w in T.unroll(1, warps):
+                    best[0] = T.max(best[0], partial[w])
+                minimum[0] = best[0] + T.call_extern(
+                    "float32", "vllm_control_log", minimum[0]
+                )
+                if vocab % tile:
+                    threshold_tail(values, minimum, logits, row, tx)
+                for step in T.serial(full):
+                    start = full - 1 - step
+                    load_tile(values, logits, row, start, tx)
+                    for r in T.unroll(per_thread // run):
+                        col0 = _min_p_column(start, r * run, tx, tile, threads, run)
+                        for k in T.vectorized(run):
+                            logits[row, col0 + k] = T.if_then_else(
+                                values[r * run + k] < minimum[0],
+                                -T.infinity("float32"),
+                                values[r * run + k],
+                            )
+
+    return min_p
+
+
+def _min_p_run(logits) -> int:
+    """4 when every row starts 16-byte aligned, else 1."""
+    return 4 if logits.data_ptr() % 16 == 0 and logits.stride(0) % 4 == 0 else 1
+
+
+def register_min_p(*, logits_stride: int, vocab_size: int):
+    _declare(
+        min_p_kernel,
+        [
+            (
+                vocab_size,
+                logits_stride,
+                "int64",
+                4 if logits_stride % 4 == 0 else 1,
+            )
+        ],
+    )
+
+
+def apply_min_p(logits, mapping, thresholds):
+    if logits.shape[0]:
+        _launch(
+            min_p_kernel,
+            (
+                logits.shape[1],
+                logits.stride(0),
+                _DTYPES[mapping.dtype],
+                _min_p_run(logits),
+            ),
+            logits,
+            mapping,
+            thresholds,
+        )
+
+
+@tilelang.jit(
+    pass_configs={**_PASS, tilelang.PassConfigKey.TL_DISABLE_VECTORIZE_256: True}
+)
+def penalties_kernel(
+    vocab: int,
+    logits_stride: int,
+    mask_stride: int,
+    counts_stride: int,
+    index_dtype: str,
+    threads: int = 256,
+):
+    rows, states, mask_rows, count_rows = T.dynamic(
+        "rows, states, mask_rows, count_rows"
+    )
+    block = 2048
+
+    @T.prim_func
+    def penalties(
+        logits: T.StridedTensor((rows, vocab), (logits_stride, 1), "float32"),
+        mapping: T.Tensor((rows,), index_dtype),
+        token_ids: T.Tensor((rows,), "int32"),
+        local_pos: T.Tensor((rows,), "int32"),
+        repetition: T.Tensor((states,), "float32"),
+        frequency: T.Tensor((states,), "float32"),
+        presence: T.Tensor((states,), "float32"),
+        prompt_mask: T.StridedTensor(
+            (mask_rows, T.ceildiv(vocab, 32)), (mask_stride, 1), "int32"
+        ),
+        output_counts: T.StridedTensor(
+            (count_rows, vocab), (counts_stride, 1), "int32"
+        ),
+    ):
+        with T.Kernel(rows, T.ceildiv(vocab, block), threads=threads) as (row, blk):
+            T.import_source(_HEADER)
+            req = T.alloc_local((1,), "int64")
+            rep = T.alloc_local((1,), "float32")
+            freq = T.alloc_local((1,), "float32")
+            pres = T.alloc_local((1,), "float32")
+            scale = T.alloc_local((1,), "float32")
+            values = T.alloc_fragment((block,), "float32")
+            counts = T.alloc_fragment((block,), "int32")
+            req[0] = mapping[row]
+            safe_req = T.max(req[0], T.int64(0))
+            rep[0] = T.if_then_else(
+                req[0] >= 0, repetition[safe_req], T.float32(1)
+            )
+            freq[0] = T.if_then_else(
+                req[0] >= 0, frequency[safe_req], T.float32(0)
+            )
+            pres[0] = T.if_then_else(
+                req[0] >= 0, presence[safe_req], T.float32(0)
+            )
+            if (rep[0] != 1) | (freq[0] != 0) | (pres[0] != 0):
+                for col in T.Parallel(block):
+                    index = blk * block + col
+                    values[col] = T.if_then_else(
+                        index < vocab, logits[T.cast(row, "int64"), index], 0
+                    )
+                    counts[col] = T.if_then_else(
+                        index < vocab, output_counts[req[0], index], 0
+                    )
+                for prev in T.serial(local_pos[row]):
+                    for col in T.Parallel(block):
+                        counts[col] += T.cast(
+                            blk * block + col
+                            == token_ids[row - local_pos[row] + prev + 1],
+                            "int32",
+                        )
+                for col in T.Parallel(block):
+                    index = blk * block + col
+                    if index < vocab:
+                        scale[0] = 1
+                        if rep[0] != 1:
+                            appeared = (
+                                (prompt_mask[req[0], index // 32] >> (index % 32)) & 1
+                            ) | T.cast(counts[col] > 0, "int32")
+                            scale[0] = T.if_then_else(appeared != 0, rep[0], 1)
+                            if values[col] > 0:
+                                scale[0] = T.call_extern(
+                                    "float32", "vllm_control_reciprocal", scale[0]
+                                )
+                        logits[T.cast(row, "int64"), index] = T.call_extern(
+                            "float32",
+                            "vllm_control_penalty",
+                            values[col],
+                            scale[0],
+                            freq[0],
+                            counts[col],
+                            pres[0],
+                        )
+
+    return penalties
+
+
+def register_penalties(
+    *,
+    logits_stride: int,
+    prompt_bin_mask_stride: int,
+    output_bin_counts_stride: int,
+    vocab_size: int,
+):
+    _declare(
+        penalties_kernel,
+        [
+            (
+                vocab_size,
+                logits_stride,
+                prompt_bin_mask_stride,
+                output_bin_counts_stride,
+                "int64",
+            )
+        ],
+    )
+
+
+def apply_penalties(logits, mapping, tokens, positions, rep, freq, pres, mask, counts):
+    if logits.shape[0]:
+        _launch(
+            penalties_kernel,
+            (
+                logits.shape[1],
+                logits.stride(0),
+                mask.stride(0),
+                counts.stride(0),
+                _DTYPES[mapping.dtype],
+            ),
+            logits,
+            mapping,
+            tokens,
+            positions,
+            rep,
+            freq,
+            pres,
+            mask,
+            counts,
+        )
+
+
+@tilelang.jit(pass_configs=_PASS)
+def bincount_kernel(
+    tokens_stride: int,
+    mask_stride: int,
+    counts_stride: int,
+    index_dtype: str,
+    threads: int = 128,
+):
+    rows, states, columns, mask_cols, counts_cols = T.dynamic(
+        "rows, states, columns, mask_cols, counts_cols"
+    )
+
+    @T.prim_func
+    def bincount(
+        mapping: T.Tensor((rows,), index_dtype),
+        tokens: T.StridedTensor((states, columns), (tokens_stride, 1), "int32"),
+        prompt_len: T.Tensor((states,), "int32"),
+        prefill_len: T.Tensor((states,), "int32"),
+        mask: T.StridedTensor((states, mask_cols), (mask_stride, 1), "int32"),
+        counts: T.StridedTensor((states, counts_cols), (counts_stride, 1), "int32"),
+        num_blocks: T.int32,
+    ):
+        with T.Kernel(rows, num_blocks, threads=threads) as (row, blk):
+            req = T.alloc_local((1,), "int64")
+            token = T.alloc_local((1,), "int32")
+            req[0] = mapping[row]
+            for i in T.Parallel(1024):
+                pos = blk * 1024 + i
+                if pos < prefill_len[req[0]]:
+                    token[0] = tokens[req[0], pos]
+                    if pos < prompt_len[req[0]]:
+                        T.atomic_or(mask[req[0], token[0] // 32], 1 << (token[0] % 32))
+                    else:
+                        T.atomic_add(counts[req[0], token[0]], 1)
+
+    return bincount
+
+
+_CLEAR_BLOCK = 1024  # columns of a row a block clears in each tensor
+
+
+@tilelang.jit(pass_configs=_PASS)
+def clear_bincount_rows_kernel(
+    mask_stride: int, counts_stride: int, index_dtype: str, threads: int = 128
+):
+    """``mask.index_fill_(0, idx, 0)`` and ``counts.index_fill_(0, idx, 0)`` for
+    ``idx = mapping.long()``, in one launch: the rows ``bincount_kernel`` then
+    accumulates into. A negative index wraps as index_fill_'s does, each tensor by
+    its own rows. A block clears ``_CLEAR_BLOCK`` columns of a row of each, its
+    threads on consecutive columns."""
+    rows, mask_rows, mask_cols, count_rows, count_cols = T.dynamic(
+        "rows, mask_rows, mask_cols, count_rows, count_cols"
+    )
+
+    @T.prim_func
+    def clear_rows(
+        mapping: T.Tensor((rows,), index_dtype),
+        mask: T.StridedTensor((mask_rows, mask_cols), (mask_stride, 1), "int32"),
+        counts: T.StridedTensor((count_rows, count_cols), (counts_stride, 1), "int32"),
+    ):
+        with T.Kernel(
+            rows, T.ceildiv(T.max(mask_cols, count_cols), _CLEAR_BLOCK), threads=threads
+        ) as (row, blk):
+            tx = T.get_thread_binding()
+            req = T.alloc_local((1,), "int64")
+            mask_row = T.alloc_local((1,), "int64")
+            count_row = T.alloc_local((1,), "int64")
+            req[0] = T.cast(mapping[row], "int64")
+            mask_row[0] = T.if_then_else(req[0] < 0, req[0] + mask_rows, req[0])
+            count_row[0] = T.if_then_else(req[0] < 0, req[0] + count_rows, req[0])
+            for k in T.unroll(_CLEAR_BLOCK // threads):
+                col = blk * _CLEAR_BLOCK + k * threads + tx
+                if col < mask_cols:
+                    mask[mask_row[0], col] = 0
+                if col < count_cols:
+                    counts[count_row[0], col] = 0
+
+    return clear_rows
+
+
+def register_bincount(
+    *,
+    all_token_ids_stride: int,
+    prompt_bin_mask_stride: int,
+    output_bin_counts_stride: int,
+):
+    _declare(
+        bincount_kernel,
+        [
+            (
+                all_token_ids_stride,
+                prompt_bin_mask_stride,
+                output_bin_counts_stride,
+                "int32",
+            )
+        ],
+    )
+    _declare(
+        clear_bincount_rows_kernel,
+        [(prompt_bin_mask_stride, output_bin_counts_stride, "int32")],
+    )
+
+
+def clear_bincount_rows(mapping, mask, counts):
+    """The prompt bits and output counts of the requests at ``mapping``, zeroed."""
+    if mapping.numel():
+        _launch(
+            clear_bincount_rows_kernel,
+            (mask.stride(0), counts.stride(0), _DTYPES[mapping.dtype]),
+            mapping,
+            mask,
+            counts,
+        )
+
+
+def accumulate_bincount(
+    mapping, tokens, prompt, prefill, mask, counts, max_prefill_len
+):
+    """Kernel portion only; the owner clears the selected rows first
+    (``clear_bincount_rows``)."""
+    if mapping.numel() and max_prefill_len:
+        _launch(
+            bincount_kernel,
+            (
+                tokens.stride(0),
+                mask.stride(0),
+                counts.stride(0),
+                _DTYPES[mapping.dtype],
+            ),
+            mapping,
+            tokens,
+            prompt,
+            prefill,
+            mask,
+            counts,
+            (max_prefill_len + 1023) // 1024,
+        )
