+        ctrl_idx_mapping_np = idx_mapping_np[ctrl_req_np]
+        ctrl_exp_idx = input_batch.expanded_idx_mapping.index_select(0, ctrl_row_idx)
+        ctrl_exp_lpos = input_batch.expanded_local_pos.index_select(0, ctrl_row_idx)
