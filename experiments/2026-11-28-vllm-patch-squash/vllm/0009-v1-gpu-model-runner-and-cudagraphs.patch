+        scores: T.Tensor((reqs, alts), T.float32),
+    ):
+        with T.Kernel(
+            reqs, T.ceildiv(vocab, SINK_ROWS_BLOCK), threads=_SINK_ROWS_THREADS
+        ) as (req, blk):
+            tx = T.get_thread_binding()
+            raw = T.alloc_local((per,), logits_dtype)
+            row = T.alloc_var(
+                T.int64,
+                init=T.cast(cu_num_logits[req], T.int64)
+                + T.max(T.cast(num_sampled[req], T.int64) - 1, T.int64(0)),
+            )
+            token = T.alloc_var(T.int64, init=T.int64(0))
+            for k in T.unroll(per):
+                if blk * SINK_ROWS_BLOCK + k * _SINK_ROWS_THREADS + tx < vocab:
+                    raw[k] = logits[
+                        row, blk * SINK_ROWS_BLOCK + k * _SINK_ROWS_THREADS + tx
+                    ]
+            for k in T.unroll(per):
+                if blk * SINK_ROWS_BLOCK + k * _SINK_ROWS_THREADS + tx < vocab:
+                    rows[req, blk * SINK_ROWS_BLOCK + k * _SINK_ROWS_THREADS + tx] = (
+                        raw[k]
+                    )
+            if (blk == 0) & (tx < alts):
+                token = T.max(alternates[req, tx], T.int64(0))
+                tokens[req, tx] = token
+                tokens_by_alt[tx, req] = token
+                if logits_mode:
+                    scores[req, tx] = T.cast(logits[row, token], T.float32)
+
+    return sink_rows
+
+
+def sink_rows_key(
+    logits_dtype: torch.dtype, num_alternates: int, logits_mode: bool
+) -> tuple:
+    return (_DTYPES[logits_dtype], num_alternates, logits_mode)
+
+
+def sink_rows(
+    logits: torch.Tensor,
+    cu_num_logits: torch.Tensor,
+    num_sampled: torch.Tensor,
+    alternates: torch.Tensor,
+    scores: torch.Tensor,
+    logits_mode: bool,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """``sink_rows_kernel``'s launch for ``[num_reqs, num_alternates]`` alternates
+    (both at least 1): the rows ``[num_reqs, vocab]`` in the logits' dtype, the
+    clamped alternates ``[num_reqs, num_alternates]`` and ``[num_alternates,
+    num_reqs]`` (int64); with ``logits_mode``, their logits into ``scores``."""
+    num_reqs, num_alternates = alternates.shape
+    device = logits.device
+    rows = torch.empty((num_reqs, logits.shape[1]), dtype=logits.dtype, device=device)
+    tokens = torch.empty((num_reqs, num_alternates), dtype=torch.int64, device=device)
+    tokens_by_alt = torch.empty(
+        (num_alternates, num_reqs), dtype=torch.int64, device=device
+    )
+    _kernel(
+        sink_rows_kernel, *sink_rows_key(logits.dtype, num_alternates, logits_mode)
+    )(
+        logits,
+        cu_num_logits,
+        num_sampled,
+        alternates.contiguous(),
+        rows,
+        tokens,
+        tokens_by_alt,
+        scores,
+    )
+    return rows, tokens, tokens_by_alt
+
+
+SINK_CANDIDATE_BLOCK = 1024
+
+
+def _drafted_row(live, local, dead_cut, req, dead_rows: bool):
+    """Whether a request's last sampled row (``local`` in its block) verified a
+    draft: not its last row (``live``) and, with ``dead_rows``, before its cut."""
+    if dead_rows:
+        return live & (local < dead_cut[req])
+    return live
+
+
+@tilelang.jit(pass_configs=_PASS)
+def sink_candidates_kernel(
+    logits_dtype: str,
+    idx_dtype: str,
+    num_candidates: int,
+    mask_rejected_draft: bool,
+    run: int,
+    pos_dtype: str = "int64",
+    dead_rows: bool = False,
+):
+    """``sink._sink_candidates_kernel``: one block of 128 threads per ``(request,
+    vocabulary block of 1024)``, a thread's elements in runs of ``run``
+    (``_triton_run``). The scores are the request's last sampled row's logits (with a
+    rejected one-hot draft masked when ``mask_rejected_draft``) plus the draw's
+    noise; the block's ``num_candidates`` best, in descending order, each found by
+    Triton's argmax and then masked. With ``dead_rows``, verification ended each
+    request's block at its ``dead_cut``: a row at the cut drew the bonus, which
+    masks nothing, as the last row does."""
+    reqs, rows, vocab, candidates = T.dynamic("reqs, rows, vocab, candidates")
+    # Inputs may be longer than the batch: each has its own length.
+    cu_len, num_len, sampled_rows, sampled_width = T.dynamic(
+        "cu_len, num_len, sampled_rows, sampled_width"
+    )
+    drafts_len, idx_len, temp_len, seed_len, pos_len, cut_len = T.dynamic(
+        "drafts_len, idx_len, temp_len, seed_len, pos_len, cut_len"
+    )
+    logits_stride, candidates_stride, sampled_stride = T.dynamic(
+        "logits_stride, candidates_stride, sampled_stride", "int64"
+    )
+
+    @T.macro
+    def passes(raw, scores, rejected, verified, word_seed, blk, tx, noisy):
+        """The thread's scores from its loaded runs; with ``noisy`` each element's
+        Philox word is drawn unconditionally, ahead of its bound check (the Gumbel
+        sampler's ``passes``)."""
+        for r in T.unroll(_PASSES // run):
+            col0 = blk * SINK_CANDIDATE_BLOCK + r * (_THREADS * run) + run * tx
+            for k in T.unroll(run):
+                index = col0 + k
+                if noisy:
+                    word = T.alloc_var(
+                        T.uint32,
+                        init=T.call_extern(
+                            "uint32", "vllm_randint32", word_seed[0], index
+                        ),
+                    )
+                scores[r * run + k] = -T.infinity(T.float32)
+                if index < vocab:
+                    scores[r * run + k] = T.cast(raw[r * run + k], T.float32)
+                    if (rejected[0] != 0) & (index == verified[0]):
+                        scores[r * run + k] = -T.infinity(T.float32)
+                    if noisy:
+                        scores[r * run + k] = T.call_extern(
+                            "float32", "vllm_gumbel_score", scores[r * run + k], word
+                        )
+
+    @T.prim_func
+    def sink_candidates(
+        values: T.StridedTensor((reqs, candidates), (candidates_stride, 1), T.float32),
+        indices: T.StridedTensor((reqs, candidates), (candidates_stride, 1), T.int64),
+        logits: T.StridedTensor((rows, vocab), (logits_stride, 1), logits_dtype),
+        cu_num_logits: T.Tensor((cu_len,), T.int32),
+        num_sampled: T.Tensor((num_len,), T.int32),
+        sampled: T.StridedTensor(
+            (sampled_rows, sampled_width), (sampled_stride, 1), T.int64
+        ),
+        drafts: T.Tensor((drafts_len,), T.int32),
+        idx_mapping: T.Tensor((idx_len,), idx_dtype),
+        temperature: T.Tensor((temp_len,), T.float32),
+        seeds: T.Tensor((seed_len,), T.int64),
+        pos: T.Tensor((pos_len,), pos_dtype),
+        dead_cut: T.Tensor((cut_len,), T.int32),
+    ):
+        with T.Kernel(
+            reqs, T.ceildiv(vocab, SINK_CANDIDATE_BLOCK), threads=_THREADS
+        ) as (req, blk):
+            T.import_source(_HEADER)
+            tx = T.get_thread_binding()
+            row = T.alloc_local((1,), T.int64)
+            local = T.alloc_local((1,), T.int32)
+            state = T.alloc_local((1,), T.int64)
+            temp = T.alloc_local((1,), T.float32)
+            rejected = T.alloc_local((1,), T.int32)
+            verified = T.alloc_local((1,), T.int32)
+            word_seed = T.alloc_local((1,), T.uint32)
+            raw = T.alloc_local((_PASSES,), logits_dtype)
+            scores = T.alloc_local((_PASSES,), T.float32)
+            best = T.alloc_local((1,), T.float32)
+            best_index = T.alloc_local((1,), T.int32)
+            other = T.alloc_local((1,), T.float32)
+            other_index = T.alloc_local((1,), T.int32)
+            partial = T.alloc_shared((_WARPS,), T.float32)
+            partial_index = T.alloc_shared((_WARPS,), T.int32)
+            chosen = T.alloc_shared((1,), T.int32)
+            if run > 1:
+                # The launch checked it: a 16-byte base and a stride of 16 elements.
+                T.assume(logits_stride % 16 == 0)
+
+            # As Triton's kernel: every load issued as soon as its index is known,
+            # none behind a test of another's value (the draft at an index that
+            # exists whatever the row), and the block's logits before the
+            # temperature's test.
+            local[0] = T.max(num_sampled[req] - 1, 0)
+            # The row that produced the request's last sampled token.
+            row[0] = T.cast(cu_num_logits[req] + local[0], T.int64)
+            end = T.alloc_var(T.int64, init=T.cast(cu_num_logits[req + 1], T.int64))
+            state[0] = T.cast(idx_mapping[req], T.int64)
+            temp[0] = temperature[state[0]]
+            seed = T.alloc_var(T.int64, init=seeds[state[0]])
+            position = T.alloc_var(pos_dtype, init=pos[row[0]])
+            for r in T.unroll(_PASSES // run):
+                col0 = blk * SINK_CANDIDATE_BLOCK + r * (_THREADS * run) + run * tx
+                _load_run_at(logits, raw, r * run, row[0], col0, vocab, run)
+            rejected[0] = 0
+            verified[0] = -1
+            if mask_rejected_draft:
+                # A random row that rejected its draft resampled the residual,
+                # which for one-hot drafts is the target without the draft.
+                draft = T.alloc_var(
+                    T.int32,
+                    init=drafts[T.min(row[0] + 1, T.cast(drafts_len - 1, T.int64))],
+                )
+                emitted = T.alloc_var(T.int64, init=sampled[req, local[0]])
+                live = _drafted_row(
+                    row[0] != end - 1, local[0], dead_cut, req, dead_rows
+                )
+                verified[0] = T.if_then_else(live, draft, -1)
+                rejected[0] = T.if_then_else(
+                    live
+                    & (draft >= 0)
+                    & (T.cast(draft, T.int64) != emitted)
+                    & (temp[0] != T.float32(0)),
+                    1,
+                    0,
+                )
+            word_seed[0] = _randint_at(seed, position, pos_dtype, False)
+            # One test of the temperature for the whole block, as the Gumbel sampler.
+            if temp[0] != T.float32(0):
+                passes(raw, scores, rejected, verified, word_seed, blk, tx, True)
+            else:
+                passes(raw, scores, rejected, verified, word_seed, blk, tx, False)
+            for i in T.unroll(num_candidates):
+                best[0] = scores[0]
+                best_index[0] = _element(0, tx, run)
+                for j in T.unroll(1, _PASSES):
+                    _keep_or_take(best, best_index, scores[j], _element(j, tx, run))
+                _block_argmax(
+                    best, best_index, other, other_index, partial, partial_index, tx
+                )
+                if tx == 0:
+                    values[req, blk * num_candidates + i] = best[0]
+                    indices[req, blk * num_candidates + i] = T.cast(
+                        blk * SINK_CANDIDATE_BLOCK + best_index[0], T.int64
+                    )
+                    chosen[0] = best_index[0]
+                T.sync_threads()
+                for j in T.unroll(_PASSES):
+                    if _element(j, tx, run) == chosen[0]:
+                        scores[j] = -T.infinity(T.float32)
+
+    return sink_candidates
+
+
+def sink_candidates_key(
+    logits_dtype: torch.dtype,
+    idx_dtype: torch.dtype,
+    num_candidates: int,
+    mask_rejected_draft: bool,
+    run: int = 1,
+    pos_dtype: torch.dtype = torch.int64,
+    dead_rows: bool = False,
+) -> tuple:
+    return (
+        _DTYPES[logits_dtype],
+        _DTYPES[idx_dtype],
+        num_candidates,
+        mask_rejected_draft,
+        run,
+        _DTYPES[pos_dtype],
+        dead_rows,
+    )
+
+
+def sink_candidates(
+    logits: torch.Tensor,
+    vocab_size: int,
+    cu_num_logits: torch.Tensor,
+    num_sampled: torch.Tensor,
+    sampled: torch.Tensor,
+    drafts: torch.Tensor,
+    idx_mapping: torch.Tensor,
+    temperature: torch.Tensor,
+    seeds: torch.Tensor,
+    pos: torch.Tensor,
+    num_candidates: int,
+    mask_rejected_draft: bool,
+    dead_cut: torch.Tensor | None = None,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """``SinkSampler.alternates_of``'s launch: each request's candidates per
+    vocabulary block, ``(values, indices)`` of ``[num_reqs, blocks *
+    num_candidates]``, in vocabulary order of the blocks; ``dead_cut`` ([num_reqs]
+    int32) where verification ended each block at its dead-row cut."""
+    num_reqs = idx_mapping.shape[0]
+    num_blocks = -(-vocab_size // SINK_CANDIDATE_BLOCK)
+    width = num_blocks * num_candidates
+    values = logits.new_empty((num_reqs, width), dtype=torch.float32)
+    indices = logits.new_empty((num_reqs, width), dtype=torch.int64)
+    if num_reqs > 0:
+        kernel = _kernel(
+            sink_candidates_kernel,
+            *sink_candidates_key(
+                logits.dtype,
+                idx_mapping.dtype,
+                num_candidates,
+                mask_rejected_draft,
+                _triton_run(logits),
+                pos.dtype,
+                dead_cut is not None,
+            ),
+        )
+        kernel(
+            values,
+            indices,
+            logits[:, :vocab_size],
+            cu_num_logits,
+            num_sampled,
+            sampled,
+            drafts,
+            idx_mapping,
+            temperature,
+            seeds,
+            pos,
+            # Without a cut it is not read: the counts stand in.
+            num_sampled if dead_cut is None else dead_cut,
+        )
+    return values, indices
+
+
+def _next_power_of_2(value: int) -> int:
+    return 1 << max(value - 1, 0).bit_length()
+
+
+@tilelang.jit(pass_configs=_PASS)
+def sink_policy_kernel(
+    idx_dtype: str,
+    num_alternates: int,
+    rejection: bool,
+    logprobs: bool,
+    sampled_width: int,
+    num_event_fields: int,
+):
+    """``sink._sink_policy_kernel``: one block per request, whose first thread
+    applies the draft-zero policy, keeps the alternates and writes the events in
+    Triton's order. The flagged-value maximum takes the lowest row among equal
+    values (``row_values`` are finite: the detector stores them through
+    ``nan_to_num``). Each buffer is passed flat; ``num_alternates`` is at least 1,
+    as the Triton launch's ``NUM_ALTERNATES``. The step's alternate logprobs and
+    ranks are read at their request and alternate strides (the ranks are stored
+    alternate by alternate). With ``logprobs``, every request's recovered logprob
+    and rank is written, 0 where no draft zero was replaced: the zeros the Triton
+    launch's buffers were filled with."""
+    alts = num_alternates
+    width = sampled_width
+    padded = _next_power_of_2(width + 1)
+    reqs, cu_len, flags_len, values_len, drafts_len = T.dynamic(
+        "reqs, cu_len, flags_len, values_len, drafts_len"
+    )
+    num_len, rejected_len, decoding_len = T.dynamic(
+        "num_len, rejected_len, decoding_len"
+    )
+    out_len, num_out_len, lp_len, rank_len = T.dynamic(
+        "out_len, num_out_len, lp_len, rank_len"
+    )
+    new_len, new_lp_len, new_rank_len = T.dynamic("new_len, new_lp_len, new_rank_len")
+    state_len, state_lp_len, state_rank_len = T.dynamic(
+        "state_len, state_lp_len, state_rank_len"
+    )
+    idx_len, tries_len, total_len_len, count_rows, count_cols = T.dynamic(
+        "idx_len, tries_len, total_len_len, count_rows, count_cols"
+    )
+    count_stride = T.dynamic("count_stride", "int64")
+
+    @T.prim_func
+    def sink_policy(
+        sampled: T.Tensor((reqs, width), T.int64),
+        num_sampled: T.Tensor((num_len,), T.int32),
+        num_rejected: T.Tensor((rejected_len,), T.int32),
+        out_tokens: T.Tensor((out_len,), T.int64),
+        num_out: T.Tensor((num_out_len,), T.int32),
+        events: T.Tensor((reqs, num_event_fields), T.int32),
+        recovered_logprobs: T.Tensor((lp_len,), T.float32),
+        recovered_ranks: T.Tensor((rank_len,), T.int64),
+        cu_num_logits: T.Tensor((cu_len,), T.int32),
+        idx_mapping: T.Tensor((idx_len,), idx_dtype),
+        decoding: T.Tensor((decoding_len,), T.int8),
+        flags: T.Tensor((flags_len,), T.int8),
+        row_values: T.Tensor((values_len,), T.float32),
+        drafts: T.Tensor((drafts_len,), T.int32),
+        new_alternates: T.Tensor((new_len,), T.int64),
+        new_alternate_logprobs: T.Tensor((new_lp_len,), T.float32),
+        new_alternate_ranks: T.Tensor((new_rank_len,), T.int64),
+        alternates: T.Tensor((state_len,), T.int64),
+        alternate_logprobs: T.Tensor((state_lp_len,), T.float32),
+        alternate_ranks: T.Tensor((state_rank_len,), T.int64),
+        tries: T.Tensor((tries_len,), T.int32),
+        total_len: T.Tensor((total_len_len,), T.int32),
+        bin_counts: T.StridedTensor(
+            (count_rows, count_cols), (count_stride, 1), T.int32
+        ),
+        counts: T.Tensor((3,), T.int64),
+        new_lp_req_stride: T.int64,
+        new_lp_alt_stride: T.int64,
+        new_rank_req_stride: T.int64,
+        new_rank_alt_stride: T.int64,
+    ):
+        with T.Kernel(reqs, threads=32) as req:
+            tx = T.get_thread_binding()
+            start = T.alloc_local((1,), T.int32)
+            logits_n = T.alloc_local((1,), T.int32)
+            sampled_n = T.alloc_local((1,), T.int32)
+            state = T.alloc_local((1,), T.int64)
+            is_decoding = T.alloc_local((1,), T.int32)
+            row0_flag = T.alloc_local((1,), T.int32)
+            accepted_flags = T.alloc_local((1,), T.int32)
+            cut = T.alloc_local((1,), T.int32)
+            draft_zero_flag = T.alloc_local((1,), T.int32)
+            outcome = T.alloc_local((1,), T.int32)
+            drafter_flags = T.alloc_local((1,), T.int32)
+            cut_row = T.alloc_local((1,), T.int32)
+            attempts = T.alloc_local((1,), T.int32)
+            slot = T.alloc_local((1,), T.int64)
+            alternate = T.alloc_local((1,), T.int64)
+            rejected = T.alloc_local((1,), T.int32)
+            draft_zero = T.alloc_local((1,), T.int64)
+            shift = T.alloc_local((1,), T.int32)
+            value = T.alloc_local((1,), T.float32)
+            best = T.alloc_local((1,), T.float32)
+            best_row = T.alloc_local((1,), T.int32)
+            flagged = T.alloc_local((1,), T.int32)
+            if tx == 0:
+                start[0] = cu_num_logits[req]
+                logits_n[0] = cu_num_logits[req + 1] - start[0]
+                sampled_n[0] = num_sampled[req]
+                if sampled_n[0] == 0:
+                    # A prefill chunk: its row is not sampled.
+                    if logprobs:
+                        recovered_logprobs[req] = T.float32(0)
+                        recovered_ranks[req] = T.int64(0)
+                    num_out[req] = 0
+                    events[req, 0] = 0
+                    events[req, 1] = 2
+                    events[req, 2] = 0
+                    events[req, 3] = -1
+                    events[req, 4] = 0
+                    events[req, 5] = -1
+                else:
+                    state[0] = T.cast(idx_mapping[req], T.int64)
+                    is_decoding[0] = T.if_then_else(decoding[req] != T.int8(0), 1, 0)
+                    row0_flag[0] = T.if_then_else(flags[start[0]] != T.int8(0), 1, 0)
+                    # Drafter rows whose inputs were accepted (1 .. num_sampled
+                    # - 1), and the row of the first rejected draft.
+                    accepted_flags[0] = 0
+                    cut[0] = 0
+                    for r in T.serial(1, padded):
+                        # The flag is read only for the request's rows.
+                        if r < logits_n[0]:  # noqa: SIM102
+                            if flags[start[0] + r] != T.int8(0):
+                                if r < sampled_n[0]:
+                                    accepted_flags[0] = accepted_flags[0] + 1
+                                if r == sampled_n[0]:
+                                    cut[0] = 1
+                    if sampled_n[0] >= logits_n[0]:
+                        cut[0] = 0
+                    draft_zero_flag[0] = is_decoding[0] & row0_flag[0]
+                    # Prompt row flagged: FLAGGED; it cannot be replaced.
+                    outcome[0] = T.if_then_else(
+                        (is_decoding[0] == 0) & (row0_flag[0] != 0), 1, 0
+                    )
+                    if rejection:
+                        attempts[0] = tries[state[0]]
+                        slot[0] = state[0] * alts + T.cast(
+                            T.min(attempts[0], alts - 1), T.int64
+                        )
+                        alternate[0] = alternates[slot[0]]
+                        rejected[0] = T.if_then_else(
+                            (draft_zero_flag[0] != 0)
+                            & (attempts[0] < alts)
+                            & (alternate[0] >= 0),
+                            1,
+                            0,
+                        )
+                        outcome[0] = T.if_then_else(
+                            rejected[0] != 0,
+                            2,
+                            T.if_then_else(draft_zero_flag[0] != 0, 3, outcome[0]),
+                        )
+                        drafter_flags[0] = T.if_then_else(
+                            rejected[0] != 0, 0, accepted_flags[0] + cut[0]
+                        )
+                        cut_row[0] = T.if_then_else(
+                            (cut[0] != 0) & (rejected[0] == 0), sampled_n[0], -1
+                        )
+                        if rejected[0] != 0:
+                            # Draft zero is replaced by its next alternate; the
+                            # request's position does not advance.
+                            draft_zero[0] = T.cast(drafts[start[0]], T.int64)
+                            sampled[req, 0] = alternate[0]
+                            num_sampled[req] = 1
+                            num_rejected[req] = logits_n[0]
+                            tries[state[0]] = attempts[0] + 1
+                            if logprobs:
+                                recovered_logprobs[req] = alternate_logprobs[slot[0]]
+                                recovered_ranks[req] = alternate_ranks[slot[0]]
+                            # The request state already holds draft zero as its
+                            # last token: take it out.
+                            total_len[state[0]] = total_len[state[0]] - 1
+                            bin_counts[state[0], draft_zero[0]] = (
+                                bin_counts[state[0], draft_zero[0]] - 1
+                            )
+                            out_tokens[T.cast(req, T.int64) * (width + 1)] = alternate[
+                                0
+                            ]
+                            num_out[req] = 1
+                        else:
+                            if logprobs:
+                                recovered_logprobs[req] = T.float32(0)
+                                recovered_ranks[req] = T.int64(0)
+                            # The last sampled token's draw provides the next
+                            # alternates.
+                            for a in T.serial(alts):
+                                alternates[state[0] * alts + a] = new_alternates[
+                                    T.cast(req, T.int64) * alts + a
+                                ]
+                                if logprobs:
+                                    alternate_logprobs[state[0] * alts + a] = (
+                                        new_alternate_logprobs[
+                                            T.cast(req, T.int64) * new_lp_req_stride
+                                            + a * new_lp_alt_stride
+                                        ]
+                                    )
+                                    alternate_ranks[state[0] * alts + a] = (
+                                        new_alternate_ranks[
+                                            T.cast(req, T.int64) * new_rank_req_stride
+                                            + a * new_rank_alt_stride
+                                        ]
+                                    )
+                            tries[state[0]] = 0
+                            # Draft zero first, then the step's sampled tokens.
+                            shift[0] = is_decoding[0]
+                            for r in T.serial(width):
+                                if r < sampled_n[0]:
+                                    out_tokens[
+                                        T.cast(req, T.int64) * (width + 1)
+                                        + shift[0]
+                                        + r
+                                    ] = sampled[req, r]
+                            if is_decoding[0] != 0:
+                                out_tokens[T.cast(req, T.int64) * (width + 1)] = T.cast(
+                                    drafts[start[0]], T.int64
+                                )
+                            num_out[req] = sampled_n[0] + shift[0]
+                    else:
+                        outcome[0] = T.if_then_else(
+                            draft_zero_flag[0] != 0, 1, outcome[0]
+                        )
+                        drafter_flags[0] = accepted_flags[0]
+                        cut_row[0] = -1
+                    # The largest flagged value among the rows the step judged
+                    # (up to the first rejected draft) and its row.
+                    for r in T.serial(padded):
+                        value[0] = T.float32(-1)
+                        if (r < logits_n[0]) & (r <= sampled_n[0]):  # noqa: SIM102
+                            if flags[start[0] + r] != T.int8(0):
+                                value[0] = row_values[start[0] + r]
+                        if (r == 0) | (value[0] > best[0]):
+                            best[0] = value[0]
+                            best_row[0] = r
+                    flagged[0] = T.if_then_else(best[0] >= T.float32(0), 1, 0)
+                    events[req, 0] = outcome[0]
+                    events[req, 1] = T.if_then_else(is_decoding[0] != 0, 0, 2)
+                    events[req, 2] = drafter_flags[0]
+                    events[req, 3] = cut_row[0]
+                    events[req, 4] = T.if_then_else(
+                        flagged[0] != 0, T.cast(best[0], T.int32), 0
+                    )
+                    events[req, 5] = T.if_then_else(flagged[0] != 0, best_row[0], -1)
+                    T.atomic_add(counts[0], T.cast(draft_zero_flag[0], T.int64))
+                    T.atomic_add(counts[1], T.cast(drafter_flags[0], T.int64))
+                    T.atomic_add(
+                        counts[2],
+                        T.cast((is_decoding[0] == 0) & (row0_flag[0] != 0), T.int64),
+                    )
+
+    return sink_policy
+
+
+def sink_policy(
+    sampled: torch.Tensor,
+    num_sampled: torch.Tensor,
+    num_rejected: torch.Tensor,
+    out_tokens: torch.Tensor,
+    num_out: torch.Tensor,
+    events: torch.Tensor,
+    recovered_logprobs: torch.Tensor,
+    recovered_ranks: torch.Tensor,
+    cu_num_logits: torch.Tensor,
+    idx_mapping: torch.Tensor,
+    decoding: torch.Tensor,
+    flags: torch.Tensor,
+    row_values: torch.Tensor,
+    drafts: torch.Tensor,
+    new_alternates: torch.Tensor,
+    new_alternate_logprobs: torch.Tensor,
+    new_alternate_ranks: torch.Tensor,
+    alternates: torch.Tensor,
+    alternate_logprobs: torch.Tensor,
+    alternate_ranks: torch.Tensor,
+    tries: torch.Tensor,
+    total_len: torch.Tensor,
+    bin_counts: torch.Tensor,
+    counts: torch.Tensor,
+    num_alternates: int,
+    rejection: bool,
+    logprobs: bool,
+    num_event_fields: int,
+) -> None:
+    """``SinkSampler.apply``'s launch, with the Triton launch's arguments (the
+    placeholders where a variant has no buffer included); the per-slot and step
+    buffers are contiguous, except the step's alternate logprobs and ranks
+    (``[num_reqs, alternates]``), which may be stored alternate by alternate. With
+    ``logprobs``, the recovered logprobs and ranks need no zeros first: every
+    request's is written."""
+    num_reqs, sampled_width = sampled.shape
+    if num_reqs == 0:
+        return
+    new_lp, new_lp_strides = _alternate_columns(new_alternate_logprobs)
+    new_ranks, new_rank_strides = _alternate_columns(new_alternate_ranks)
+    kernel = _kernel(
+        sink_policy_kernel,
+        *sink_policy_key(
+            idx_mapping.dtype,
+            num_alternates,
+            rejection,
+            logprobs,
+            sampled_width,
+            num_event_fields,
+        ),
+    )
+    kernel(
+        sampled,
+        num_sampled,
+        num_rejected,
+        out_tokens.view(-1),
+        num_out.view(-1),
+        events,
+        recovered_logprobs.view(-1),
+        recovered_ranks.view(-1),
+        cu_num_logits,
+        idx_mapping,
+        decoding,
+        flags,
+        row_values,
+        drafts,
+        new_alternates.view(-1),
+        new_lp,
+        new_ranks,
+        alternates.view(-1),
+        alternate_logprobs.view(-1),
+        alternate_ranks.view(-1),
+        tries,
+        total_len,
+        bin_counts,
+        counts,
+        *new_lp_strides,
+        *new_rank_strides,
+    )
+
+
+def _alternate_columns(
+    columns: torch.Tensor,
+) -> tuple[torch.Tensor, tuple[int, int]]:
+    """A ``[num_reqs, alternates]`` tensor stored request by request or alternate by
+    alternate, as its flat storage and its (request, alternate) strides."""
+    if columns.is_contiguous():
+        return columns.view(-1), (columns.stride(0), columns.stride(1))
+    if columns.t().is_contiguous():
+        return columns.t().view(-1), (columns.stride(0), columns.stride(1))
+    raise ValueError(
+        f"alternate columns of strides {columns.stride()} are neither request- "
+        "nor alternate-major"
+    )
+
+
+def sink_policy_key(
+    idx_dtype: torch.dtype,
+    num_alternates: int,
+    rejection: bool,
+    logprobs: bool,
+    sampled_width: int,
+    num_event_fields: int,
+) -> tuple:
+    return (
+        _DTYPES[idx_dtype],
+        max(num_alternates, 1),
+        rejection,
+        logprobs and rejection,
+        sampled_width,
+        num_event_fields,
+    )
+
+
+# --- Greedy argmax and verification -----------------------------------------
+
+# dspark.greedy._BLOCK
+GREEDY_BLOCK = 2048
+_VEC = 8  # values in one 16-byte load of 16-bit logits
+_INT32_MAX = 2147483647
+
+
+@T.macro
+def _first_keep_or_take(best, best_index, value, index):
+    """``(best, best_index)`` = ``_first_argmax`` of itself and ``(value, index)``,
+    by selects."""
+    keep = T.alloc_var(
+        T.int32,
+        init=T.call_extern(
+            "int32", "vllm_first_argmax_keep", best[0], best_index[0], value, index
+        ),
+    )
+    best_index[0] = T.if_then_else(keep != 0, best_index[0], index)
+    best[0] = T.if_then_else(keep != 0, best[0], value)
+
+
+@T.macro
+def _first_exchange(best, best_index, other, other_index, distance):
+    other[0] = T.shfl_xor(best[0], distance)
+    other_index[0] = T.shfl_xor(best_index[0], distance)
+    _first_keep_or_take(best, best_index, other[0], other_index[0])
+
+
+@T.macro
+def _warp_first_argmax(best, best_index, other, other_index):
+    """Every lane's ``(best, best_index)`` = the warp's first maximum (the
+    combine is a total order, so the pairing does not matter)."""
+    _first_exchange(best, best_index, other, other_index, 16)
+    _first_exchange(best, best_index, other, other_index, 8)
+    _first_exchange(best, best_index, other, other_index, 4)
+    _first_exchange(best, best_index, other, other_index, 2)
+    _first_exchange(best, best_index, other, other_index, 1)
+
+
+@T.macro
+def _first_keep_or_take_top2(
+    best, best_index, second, second_index, value, index
+):
+    """Update top-1 ``(best, best_index)`` and runner-up ``(second, second_index)``
+    with ``(value, index)`` by branchless selects under ``vllm_first_argmax_keep``,
+    ignoring duplicate indices."""
+    dup = T.alloc_var(
+        T.int32,
+        init=T.if_then_else(
+            (index == best_index[0]) | (index == second_index[0]), 1, 0
+        ),
+    )
+    keep_best = T.alloc_var(
+        T.int32,
+        init=T.if_then_else(
+            dup != 0,
+            1,
+            T.call_extern(
+                "int32", "vllm_first_argmax_keep", best[0], best_index[0], value, index
+            ),
+        ),
+    )
+    cand_v = T.alloc_var(
+        T.float32, init=T.if_then_else(keep_best != 0, value, best[0])
+    )
+    cand_i = T.alloc_var(
+        T.int32, init=T.if_then_else(keep_best != 0, index, best_index[0])
+    )
+    best[0] = T.if_then_else(keep_best != 0, best[0], value)
+    best_index[0] = T.if_then_else(keep_best != 0, best_index[0], index)
+    keep_sec = T.alloc_var(
+        T.int32,
+        init=T.if_then_else(
+            dup != 0,
+            1,
+            T.call_extern(
+                "int32",
+                "vllm_first_argmax_keep",
+                second[0],
+                second_index[0],
+                cand_v,
+                cand_i,
+            ),
+        ),
+    )
+    second[0] = T.if_then_else(keep_sec != 0, second[0], cand_v)
+    second_index[0] = T.if_then_else(keep_sec != 0, second_index[0], cand_i)
+
+
+@T.macro
+def _first_exchange_top2(
+    best,
+    best_index,
+    second,
+    second_index,
+    other,
+    other_index,
+    other2,
+    other2_index,
+    distance,
+):
+    other[0] = T.shfl_xor(best[0], distance)
+    other_index[0] = T.shfl_xor(best_index[0], distance)
+    other2[0] = T.shfl_xor(second[0], distance)
+    other2_index[0] = T.shfl_xor(second_index[0], distance)
+    _first_keep_or_take_top2(
+        best, best_index, second, second_index, other[0], other_index[0]
+    )
+    _first_keep_or_take_top2(
+        best, best_index, second, second_index, other2[0], other2_index[0]
+    )
+
+
+@T.macro
+def _warp_first_argmax_top2(
+    best,
+    best_index,
+    second,
+    second_index,
+    other,
+    other_index,
+    other2,
+    other2_index,
+):
+    """Every lane's ``((best, best_index), (second, second_index))`` = the warp's
+    top-1 and runner-up under ``vllm_first_argmax_keep``'s total order."""
+    _first_exchange_top2(
+        best, best_index, second, second_index, other, other_index, other2, other2_index, 16
+    )
+    _first_exchange_top2(
+        best, best_index, second, second_index, other, other_index, other2, other2_index, 8
+    )
+    _first_exchange_top2(
+        best, best_index, second, second_index, other, other_index, other2, other2_index, 4
+    )
+    _first_exchange_top2(
+        best, best_index, second, second_index, other, other_index, other2, other2_index, 2
+    )
+    _first_exchange_top2(
+        best, best_index, second, second_index, other, other_index, other2, other2_index, 1
+    )
+
+
+@tilelang.jit(pass_configs=_PASS)
+def partial_argmax_kernel(
+    base_dtype: str,
+    bias_dtype: str | None,
+    vector: bool,
+    threads: int = _THREADS,
+    top2: bool = False,
+):
+    """``dspark.greedy._partial_argmax`` (with a bias, each sum rounded to the base
+    dtype as the materialized ``torch.add``) and ``_partial_argmax_logits``
+    (without): the first maximum (and when ``top2`` is True, the runner-up) of each
+    2048-column part of each row, by value and shard-local column, into flat
+    FP32 / int32 scratch. ``threads`` a block; with ``vector`` (16-byte aligned rows,
+    columns a multiple of eight), each thread reads runs of eight consecutive values.
+    The combine is a total order, so the layout does not change the result."""
+    rows, vocab, values_len, indices_len = T.dynamic(
+        "rows, vocab, values_len, indices_len"
+    )
+    base_stride, bias_stride = T.dynamic("base_stride, bias_stride", "int64")
+    biased = bias_dtype is not None
+    if not biased:
+        bias_dtype = base_dtype  # placeholder the variant never reads
+    warps = threads // 32
+    runs = GREEDY_BLOCK // (threads * _VEC)
+    passes = GREEDY_BLOCK // threads
+
+    @T.prim_func
+    def partial_argmax(
+        base: T.StridedTensor((rows, vocab), (base_stride, 1), base_dtype),
+        bias: T.StridedTensor((rows, vocab), (bias_stride, 1), bias_dtype),
+        values: T.Tensor((values_len,), T.float32),
+        indices: T.Tensor((indices_len,), T.int32),
+    ):
+        with T.Kernel(rows, T.ceildiv(vocab, GREEDY_BLOCK), threads=threads) as (
+            row,
+            part,
+        ):
+            T.import_source(_HEADER)
+            tx = T.get_thread_binding()
+            a = T.alloc_local((passes,), base_dtype)
+            b = T.alloc_local((passes,), bias_dtype)
+            best = T.alloc_local((1,), T.float32)
+            best_index = T.alloc_local((1,), T.int32)
+            other = T.alloc_local((1,), T.float32)
+            other_index = T.alloc_local((1,), T.int32)
+            partial = T.alloc_shared((warps,), T.float32)
+            partial_index = T.alloc_shared((warps,), T.int32)
+            second = T.alloc_local((1,), T.float32)
+            second_index = T.alloc_local((1,), T.int32)
+            other2 = T.alloc_local((1,), T.float32)
+            other2_index = T.alloc_local((1,), T.int32)
+            partial2 = T.alloc_shared((warps,), T.float32)
+            partial2_index = T.alloc_shared((warps,), T.int32)
+            # Triton's masked lanes, which no column beats.
+            best[0] = -T.infinity(T.float32)
+            best_index[0] = _INT32_MAX
+            if top2:
+                second[0] = -T.infinity(T.float32)
+                second_index[0] = _INT32_MAX
+            if vector:
+                # The launch checked it: rows 16-byte aligned, columns whole runs.
+                T.assume(base_stride % _VEC == 0)
+                T.assume(bias_stride % _VEC == 0)
+                T.assume(vocab % _VEC == 0)
+                # Every run loaded before any is combined, as Triton loads its block.
+                for run in T.unroll(runs):
+                    col0 = part * GREEDY_BLOCK + (run * threads + tx) * _VEC
+                    if col0 < vocab:
+                        for i in T.vectorized(_VEC):
+                            a[run * _VEC + i] = base[row, col0 + i]
+                        if biased:
+                            for i in T.vectorized(_VEC):
+                                b[run * _VEC + i] = bias[row, col0 + i]
+                for run in T.unroll(runs):
+                    col0 = part * GREEDY_BLOCK + (run * threads + tx) * _VEC
+                    if col0 < vocab:
+                        for i in T.unroll(_VEC):
+                            value = T.cast(a[run * _VEC + i], T.float32)
+                            if biased:
+                                value = T.cast(
+                                    T.cast(
+                                        value + T.cast(b[run * _VEC + i], T.float32),
+                                        base_dtype,
+                                    ),
+                                    T.float32,
+                                )
+                            if top2:
+                                _first_keep_or_take_top2(
+                                    best, best_index, second, second_index, value, col0 + i
+                                )
+                            else:
+                                _first_keep_or_take(best, best_index, value, col0 + i)
+            else:
+                for j in T.unroll(passes):
+                    col = part * GREEDY_BLOCK + j * threads + tx
+                    if col < vocab:
+                        a[j] = base[row, col]
+                        if biased:
+                            b[j] = bias[row, col]
+                for j in T.unroll(passes):
+                    col = part * GREEDY_BLOCK + j * threads + tx
+                    if col < vocab:
+                        value = T.cast(a[j], T.float32)
+                        if biased:
+                            value = T.cast(
+                                T.cast(value + T.cast(b[j], T.float32), base_dtype),
+                                T.float32,
+                            )
+                        if top2:
+                            _first_keep_or_take_top2(
+                                best, best_index, second, second_index, value, col
+                            )
+                        else:
+                            _first_keep_or_take(best, best_index, value, col)
+            if top2:
+                _warp_first_argmax_top2(
+                    best,
+                    best_index,
+                    second,
+                    second_index,
+                    other,
+                    other_index,
+                    other2,
+                    other2_index,
+                )
+                if tx % 32 == 0:
+                    partial[tx // 32] = best[0]
+                    partial_index[tx // 32] = best_index[0]
+                    partial2[tx // 32] = second[0]
+                    partial2_index[tx // 32] = second_index[0]
+                T.sync_threads()
+                if tx == 0:
+                    for w in T.unroll(1, warps):
+                        _first_keep_or_take_top2(
+                            best,
+                            best_index,
+                            second,
+                            second_index,
+                            partial[w],
+                            partial_index[w],
+                        )
+                        _first_keep_or_take_top2(
+                            best,
+                            best_index,
+                            second,
+                            second_index,
+                            partial2[w],
+                            partial2_index[w],
+                        )
+                    slot = (
+                        T.cast(row, T.int64) * T.ceildiv(vocab, GREEDY_BLOCK) + part
+                    ) * 2
+                    values[slot] = best[0]
+                    values[slot + 1] = second[0]
+                    indices[slot] = best_index[0]
+                    indices[slot + 1] = second_index[0]
+            else:
+                _warp_first_argmax(best, best_index, other, other_index)
+                if tx % 32 == 0:
+                    partial[tx // 32] = best[0]
+                    partial_index[tx // 32] = best_index[0]
+                T.sync_threads()
+                if tx == 0:
+                    for w in T.unroll(1, warps):
+                        _first_keep_or_take(
+                            best, best_index, partial[w], partial_index[w]
+                        )
+                    slot = T.cast(row, T.int64) * T.ceildiv(vocab, GREEDY_BLOCK) + part
+                    values[slot] = best[0]
+                    indices[slot] = best_index[0]
+
+    return partial_argmax
+
+
+# Parts a lane of the finish reads: ``ceil(parts / 32)``, declared for each value here
+# (vocabularies of up to 32 * 2 * GREEDY_BLOCK columns).
+_FINISH_LANES = (1, 2)
+_FINISH_LANES_TOP2 = (1, 2, 4)
+
+
+@tilelang.jit(pass_configs=_PASS)
+def finish_argmax_kernel(output: str, per_lane: int = 1):
+    """``dspark.greedy._finish_argmax_pair`` (``output`` "pair": the row's first
+    maximum and its global index ``+ vocab_start`` as FP32 into ``out[row *
+    out_stride]`` and the element after it; ``output`` "pair_top2": also the
+    runner-up maximum and its global index into columns 2 and 3 of the 16-byte
+    pair row) and ``_finish_argmax`` ("int32" /
+    "int64": the index into ``out[row * out_stride]``), from the parts' scratch, a
+    warp a row. As Triton's, every part
+    is loaded before any is combined: lane ``k`` reads parts ``k``, ``k + 32``, ...
+    (``per_lane`` of them, Triton's masked values past ``parts``), then the lanes
+    reduce; the combine is a total order, so the pairing does not matter."""
+    rows, values_len, indices_len, out_len = T.dynamic(
+        "rows, values_len, indices_len, out_len"
+    )
+    pair = output in ("pair", "pair_top2")
+    top2 = output == "pair_top2"
+    out_dtype = "float32" if pair else output
+
+    @T.prim_func
+    def finish_argmax(
+        values: T.Tensor((values_len,), T.float32),
+        indices: T.Tensor((indices_len,), T.int32),
+        out: T.Tensor((out_len,), out_dtype),
+        parts: T.int32,
+        out_rows: T.int32,
+        out_stride: T.int64,
+        vocab_start: T.int32,
+    ):
+        with T.Kernel(out_rows, threads=32) as row:
+            T.import_source(_HEADER)
+            tx = T.get_thread_binding()
+            v = T.alloc_local((per_lane,), T.float32)
+            ix = T.alloc_local((per_lane,), T.int32)
+            best = T.alloc_local((1,), T.float32)
+            best_index = T.alloc_local((1,), T.int32)
+            other = T.alloc_local((1,), T.float32)
+            other_index = T.alloc_local((1,), T.int32)
+            second = T.alloc_local((1,), T.float32)
+            second_index = T.alloc_local((1,), T.int32)
+            other2 = T.alloc_local((1,), T.float32)
+            other2_index = T.alloc_local((1,), T.int32)
+            for k in T.unroll(per_lane):
+                part = tx + k * 32
+                slot = T.cast(row, T.int64) * parts + T.min(part, parts - 1)
+                v[k] = T.if_then_else(
+                    part < parts, values[slot], -T.infinity(T.float32)
+                )
+                ix[k] = T.if_then_else(part < parts, indices[slot], _INT32_MAX)
+            best[0] = v[0]
+            best_index[0] = ix[0]
+            if top2:
+                for k in T.unroll(1, per_lane):
+                    _first_keep_or_take(best, best_index, v[k], ix[k])
+                _warp_first_argmax(best, best_index, other, other_index)
+                second[0] = T.if_then_else(
+                    ix[0] == best_index[0], -T.infinity(T.float32), v[0]
+                )
+                second_index[0] = T.if_then_else(
+                    ix[0] == best_index[0], _INT32_MAX, ix[0]
+                )
+                for k in T.unroll(1, per_lane):
+                    _first_keep_or_take(
+                        second,
+                        second_index,
+                        T.if_then_else(
+                            ix[k] == best_index[0], -T.infinity(T.float32), v[k]
+                        ),
+                        T.if_then_else(ix[k] == best_index[0], _INT32_MAX, ix[k]),
+                    )
+                _warp_first_argmax(second, second_index, other, other_index)
+                if tx == 0:
+                    base_out = T.cast(row, T.int64) * out_stride
+                    out[base_out] = best[0]
+                    out[base_out + 1] = T.cast(best_index[0] + vocab_start, T.float32)
+                    out[base_out + 2] = second[0]
+                    out[base_out + 3] = T.if_then_else(
+                        second_index[0] < _INT32_MAX,
+                        T.cast(second_index[0] + vocab_start, T.float32),
+                        T.float32(1 << 30),
+                    )
+            else:
+                for k in T.unroll(1, per_lane):
+                    _first_keep_or_take(best, best_index, v[k], ix[k])
+                _warp_first_argmax(best, best_index, other, other_index)
+                if tx == 0:
+                    if pair:
+                        out[T.cast(row, T.int64) * out_stride] = best[0]
+                        out[T.cast(row, T.int64) * out_stride + 1] = T.cast(
+                            best_index[0] + vocab_start, T.float32
+                        )
+                    else:
+                        out[T.cast(row, T.int64) * out_stride] = T.cast(
+                            best_index[0], out_dtype
+                        )
+
+    return finish_argmax
+
+
+@T.macro
+def _select_pairs(
+    pairs, best, best_index, other, other_index, row, tx, ranks, span, pair_width
+):
+    """Every lane's first maximum over the row's ranks' pairs, in lanes below
+    ``span`` (lanes past ``ranks`` hold Triton's masked values)."""
+    lane = T.min(tx, ranks - 1)
+    value = pairs[row, pair_width * lane]
+    index = pairs[row, pair_width * lane + 1]
+    best[0] = T.if_then_else(tx < ranks, value, -T.infinity(T.float32))
+    best_index[0] = T.if_then_else(tx < ranks, T.cast(index, T.int32), T.int32(1 << 30))
+    if span >= 32:
+        _first_exchange(best, best_index, other, other_index, 16)
+    if span >= 16:
+        _first_exchange(best, best_index, other, other_index, 8)
+    if span >= 8:
+        _first_exchange(best, best_index, other, other_index, 4)
+    if span >= 4:
+        _first_exchange(best, best_index, other, other_index, 2)
+    if span >= 2:
+        _first_exchange(best, best_index, other, other_index, 1)
+
+
+@T.macro
+def _select_pairs_top2(
+    pairs,
+    best,
+    best_index,
+    second,
+    second_index,
+    other,
+    other_index,
+    other2,
+    other2_index,
+    row,
+    tx,
+    ranks,
+    span,
+    pair_width,
+):
+    """Every lane's top-1 and runner-up over the row's ranks' 4-column pairs
+    ``[best_v, best_i, second_v, second_i]``, in lanes below ``span``."""
+    lane = T.min(tx, ranks - 1)
+    v1 = pairs[row, pair_width * lane]
+    i1 = pairs[row, pair_width * lane + 1]
+    v2 = pairs[row, pair_width * lane + 2]
+    i2 = pairs[row, pair_width * lane + 3]
+    best[0] = T.if_then_else(tx < ranks, v1, -T.infinity(T.float32))
+    best_index[0] = T.if_then_else(tx < ranks, T.cast(i1, T.int32), T.int32(1 << 30))
+    second[0] = T.if_then_else(tx < ranks, v2, -T.infinity(T.float32))
+    second_index[0] = T.if_then_else(tx < ranks, T.cast(i2, T.int32), T.int32(1 << 30))
+    if span >= 32:
+        _first_exchange_top2(
+            best, best_index, second, second_index, other, other_index, other2, other2_index, 16
+        )
+    if span >= 16:
+        _first_exchange_top2(
+            best, best_index, second, second_index, other, other_index, other2, other2_index, 8
+        )
+    if span >= 8:
+        _first_exchange_top2(
+            best, best_index, second, second_index, other, other_index, other2, other2_index, 4
+        )
+    if span >= 4:
+        _first_exchange_top2(
+            best, best_index, second, second_index, other, other_index, other2, other2_index, 2
+        )
+    if span >= 2:
+        _first_exchange_top2(
+            best, best_index, second, second_index, other, other_index, other2, other2_index, 1
+        )
+
+
+@T.macro
+def _embed_row(table, token, step_out, confidence_out, row, tx, per_lane, table_rows):
+    """Row ``token`` of the Markov embedding ``table`` into both outputs' ``row``,
+    ``per_lane`` elements a lane (``torch.nn.Embedding``'s lookup)."""
+    source = T.max(T.min(token, table_rows - 1), 0)
+    for v in T.vectorized(per_lane):
+        step_out[row, tx * per_lane + v] = table[source, tx * per_lane + v]
+    for v in T.vectorized(per_lane):
+        confidence_out[row, tx * per_lane + v] = table[source, tx * per_lane + v]
+
+
+@tilelang.jit(pass_configs=_PASS)
+def select_first_argmax_kernel(
+    output_dtype: str,
+    ranks: int,
+    embed_width: int = 0,
+    pair_width: int = 2,
+    top2_branch: bool = False,
+):
+    """``dspark.greedy._select_first_argmax``: the first maximum's global index
+    over the all-gathered ``(value, index)`` pairs of each row ([rows, pair_width *
+    ranks] FP32, a rank's pair at the start of its ``pair_width`` columns; indices
+    exact in FP32), into ``out[row * out_stride]``, a warp a row.
+    As in Triton, the number of ranks is fixed when the kernel is built and every
+    load is issued before any combine: lane ``k < ranks`` reads rank ``k``'s pair,
+    the other lanes hold Triton's masked values (-inf, 2**30), and the lanes reduce
+    over the next power of two (the combine is a total order).
+
+    With ``embed_width``, the drafter's next step: the selected token's row of the
+    Markov embedding ``table`` ([vocab, embed_width] BF16) into ``step_out[row]``
+    and ``confidence_out[row]``, which ``nn.Embedding`` and a stack wrote.
+
+    With ``top2_branch`` (``pair_width == 4``), also reduces the global runner-up
+    ``(second_value, second_index)`` across all shards, writes the runner-up token
+    and top1-top2 logit margin, and when ``embed_width > 0`` and ``best - second <=
+    branch_margin``, scores ``markov_conf_weight . (table[second] - table[best])``
+    across the warp to promote the runner-up when its transition confidence gain
+    outweighs the logit gap."""
+    assert 1 <= ranks <= 32
+    assert embed_width % 32 == 0
+    assert not top2_branch or pair_width == 4
+    rows, width, out_len = T.dynamic("rows, width, out_len")
+    pairs_stride = T.dynamic("pairs_stride", "int64")
+    span = 1 << max(ranks - 1, 0).bit_length()
+
+    if not embed_width and not top2_branch:
+
+        @T.prim_func
+        def select_first_argmax(
+            pairs: T.StridedTensor((rows, width), (pairs_stride, 1), T.float32),
+            out: T.Tensor((out_len,), output_dtype),
+            out_stride: T.int64,
+        ):
+            with T.Kernel(rows, threads=32) as row:
+                T.import_source(_HEADER)
+                tx = T.get_thread_binding()
+                best = T.alloc_local((1,), T.float32)
+                best_index = T.alloc_local((1,), T.int32)
+                other = T.alloc_local((1,), T.float32)
+                other_index = T.alloc_local((1,), T.int32)
+                _select_pairs(
+                    pairs, best, best_index, other, other_index, row, tx, ranks,
+                    span, pair_width,
+                )  # fmt: skip
+                if tx == 0:
+                    out[T.cast(row, T.int64) * out_stride] = T.cast(
+                        best_index[0], output_dtype
+                    )
+
+        return select_first_argmax
+
+    if not embed_width and top2_branch:
+        runner_up_len, margin_len = T.dynamic("runner_up_len, margin_len")
+
+        @T.prim_func
+        def select_first_argmax_top2(
+            pairs: T.StridedTensor((rows, width), (pairs_stride, 1), T.float32),
+            out: T.Tensor((out_len,), output_dtype),
+            out_stride: T.int64,
+            runner_up_out: T.Tensor((runner_up_len,), output_dtype),
+            runner_up_stride: T.int64,
+            margin_out: T.Tensor((margin_len,), T.float32),
+            margin_stride: T.int64,
+        ):
+            with T.Kernel(rows, threads=32) as row:
+                T.import_source(_HEADER)
+                tx = T.get_thread_binding()
+                best = T.alloc_local((1,), T.float32)
+                best_index = T.alloc_local((1,), T.int32)
+                second = T.alloc_local((1,), T.float32)
+                second_index = T.alloc_local((1,), T.int32)
+                other = T.alloc_local((1,), T.float32)
+                other_index = T.alloc_local((1,), T.int32)
+                other2 = T.alloc_local((1,), T.float32)
+                other2_index = T.alloc_local((1,), T.int32)
+                _select_pairs_top2(
+                    pairs, best, best_index, second, second_index, other,
+                    other_index, other2, other2_index, row, tx, ranks, span,
+                    pair_width,
+                )  # fmt: skip
+                if tx == 0:
+                    out[T.cast(row, T.int64) * out_stride] = T.cast(
+                        best_index[0], output_dtype
+                    )
+                    runner_up_out[T.cast(row, T.int64) * runner_up_stride] = T.cast(
+                        T.if_then_else(
+                            second_index[0] < (1 << 30), second_index[0], best_index[0]
+                        ),
+                        output_dtype,
+                    )
+                    margin_out[T.cast(row, T.int64) * margin_stride] = (
+                        best[0] - second[0]
+                    )
+
+        return select_first_argmax_top2
+
+    table_rows = T.dynamic("table_rows")
+    step_stride, confidence_stride = T.dynamic(
+        "step_stride, confidence_stride", "int64"
+    )
+    per_lane = embed_width // 32
+
+    if not top2_branch:
+
+        @T.prim_func
+        def select_first_argmax_embed(
+            pairs: T.StridedTensor((rows, width), (pairs_stride, 1), T.float32),
+            out: T.Tensor((out_len,), output_dtype),
+            out_stride: T.int64,
+            table: T.Tensor((table_rows, embed_width), T.bfloat16),
+            step_out: T.StridedTensor((rows, embed_width), (step_stride, 1), T.bfloat16),
+            confidence_out: T.StridedTensor(
+                (rows, embed_width), (confidence_stride, 1), T.bfloat16
+            ),
+        ):
+            with T.Kernel(rows, threads=32) as row:
+                T.import_source(_HEADER)
+                tx = T.get_thread_binding()
+                best = T.alloc_local((1,), T.float32)
+                best_index = T.alloc_local((1,), T.int32)
+                other = T.alloc_local((1,), T.float32)
+                other_index = T.alloc_local((1,), T.int32)
+                selected = T.alloc_shared((1,), T.int32)
+                _select_pairs(
+                    pairs, best, best_index, other, other_index, row, tx, ranks,
+                    span, pair_width,
+                )  # fmt: skip
+                if tx == 0:
+                    out[T.cast(row, T.int64) * out_stride] = T.cast(
+                        best_index[0], output_dtype
+                    )
+                    selected[0] = best_index[0]
+                T.sync_threads()
+                _embed_row(
+                    table, selected[0], step_out, confidence_out, row, tx, per_lane,
+                    table_rows,
+                )  # fmt: skip
+
+        return select_first_argmax_embed
+
+    runner_up_len, margin_len = T.dynamic("runner_up_len, margin_len")
+
+    @T.prim_func
+    def select_first_argmax_embed_top2(
+        pairs: T.StridedTensor((rows, width), (pairs_stride, 1), T.float32),
+        out: T.Tensor((out_len,), output_dtype),
+        out_stride: T.int64,
+        table: T.Tensor((table_rows, embed_width), T.bfloat16),
+        step_out: T.StridedTensor((rows, embed_width), (step_stride, 1), T.bfloat16),
+        confidence_out: T.StridedTensor(
+            (rows, embed_width), (confidence_stride, 1), T.bfloat16
+        ),
+        markov_conf_weight: T.Tensor((embed_width,), T.float32),
+        runner_up_out: T.Tensor((runner_up_len,), output_dtype),
+        runner_up_stride: T.int64,
+        margin_out: T.Tensor((margin_len,), T.float32),
+        margin_stride: T.int64,
+        branch_margin: T.float32,
+        branch_weight: T.float32,
+    ):
+        with T.Kernel(rows, threads=32) as row:
+            T.import_source(_HEADER)
+            tx = T.get_thread_binding()
+            best = T.alloc_local((1,), T.float32)
+            best_index = T.alloc_local((1,), T.int32)
+            second = T.alloc_local((1,), T.float32)
+            second_index = T.alloc_local((1,), T.int32)
+            other = T.alloc_local((1,), T.float32)
+            other_index = T.alloc_local((1,), T.int32)
+            other2 = T.alloc_local((1,), T.float32)
+            other2_index = T.alloc_local((1,), T.int32)
+            s_idx = T.alloc_shared((2,), T.int32)
+            s_val = T.alloc_shared((2,), T.float32)
+            eb = T.alloc_local((per_lane,), T.bfloat16)
+            es = T.alloc_local((per_lane,), T.bfloat16)
+            mw = T.alloc_local((per_lane,), T.float32)
+            diff_acc = T.alloc_local((1,), T.float32)
+            _select_pairs_top2(
+                pairs, best, best_index, second, second_index, other,
+                other_index, other2, other2_index, row, tx, ranks, span,
+                pair_width,
+            )  # fmt: skip
+            if tx == 0:
+                s_idx[0] = best_index[0]
+                s_idx[1] = T.if_then_else(
+                    second_index[0] < (1 << 30), second_index[0], best_index[0]
+                )
+                s_val[0] = best[0]
+                s_val[1] = second[0]
+            T.sync_threads()
+            b_idx = s_idx[0]
+            r_idx = s_idx[1]
+            b_val = s_val[0]
+            r_val = s_val[1]
+            margin = b_val - r_val
+            src_b = T.max(T.min(b_idx, table_rows - 1), 0)
+            for v in T.vectorized(per_lane):
+                eb[v] = table[src_b, tx * per_lane + v]
+            if (
+                (branch_margin > T.float32(0.0))
+                & (r_idx != b_idx)
+                & (margin >= T.float32(0.0))
+                & (margin <= branch_margin)
+            ):
+                src_r = T.max(T.min(r_idx, table_rows - 1), 0)
+                for v in T.vectorized(per_lane):
+                    es[v] = table[src_r, tx * per_lane + v]
+                for v in T.unroll(per_lane):
+                    mw[v] = markov_conf_weight[tx * per_lane + v]
+                diff_acc[0] = T.float32(0.0)
+                for v in T.unroll(per_lane):
+                    diff_acc[0] = diff_acc[0] + (
+                        T.cast(es[v], T.float32) - T.cast(eb[v], T.float32)
+                    ) * mw[v]
+                diff_acc[0] = T.warp_reduce_sum(diff_acc[0])
+                take_second = (r_val + branch_weight * diff_acc[0]) > b_val
+                for v in T.unroll(per_lane):
+                    eb[v] = T.if_then_else(take_second, es[v], eb[v])
+                if tx == 0:
+                    chosen = T.if_then_else(take_second, r_idx, b_idx)
+                    runner_up = T.if_then_else(take_second, b_idx, r_idx)
+                    out[T.cast(row, T.int64) * out_stride] = T.cast(
+                        chosen, output_dtype
+                    )
+                    runner_up_out[T.cast(row, T.int64) * runner_up_stride] = T.cast(
+                        runner_up, output_dtype
+                    )
+                    margin_out[T.cast(row, T.int64) * margin_stride] = margin
+            else:
+                if tx == 0:
+                    out[T.cast(row, T.int64) * out_stride] = T.cast(b_idx, output_dtype)
+                    runner_up_out[T.cast(row, T.int64) * runner_up_stride] = T.cast(
+                        r_idx, output_dtype
+                    )
+                    margin_out[T.cast(row, T.int64) * margin_stride] = margin
+            for v in T.vectorized(per_lane):
+                step_out[row, tx * per_lane + v] = eb[v]
+            for v in T.vectorized(per_lane):
+                confidence_out[row, tx * per_lane + v] = eb[v]
+
+    return select_first_argmax_embed_top2
+
+
+@tilelang.jit(pass_configs=_PASS)
+def markov_anchor_embed_kernel(ids_dtype: str, index_dtype: str, embed_width: int):
+    """The drafter's first step: each request's anchor token (``ids[index[row]]``,
+    which a torch gather read) and its row of the Markov embedding ``table`` into
+    ``step_out[row]`` and ``confidence_out[row]`` (``nn.Embedding`` and a stack), a
+    warp a row."""
+    assert embed_width % 32 == 0
+    rows, ids_len, table_rows = T.dynamic("rows, ids_len, table_rows")
+    step_stride, confidence_stride = T.dynamic(
+        "step_stride, confidence_stride", "int64"
+    )
+    per_lane = embed_width // 32
+
+    @T.prim_func
+    def markov_anchor_embed(
+        ids: T.Tensor((ids_len,), ids_dtype),
+        index: T.Tensor((rows,), index_dtype),
+        table: T.Tensor((table_rows, embed_width), T.bfloat16),
+        step_out: T.StridedTensor((rows, embed_width), (step_stride, 1), T.bfloat16),
+        confidence_out: T.StridedTensor(
+            (rows, embed_width), (confidence_stride, 1), T.bfloat16
+        ),
+    ):
+        with T.Kernel(rows, threads=32) as row:
+            tx = T.get_thread_binding()
+            token = T.alloc_var(T.int64, init=T.cast(ids[index[row]], T.int64))
+            _embed_row(
+                table, token, step_out, confidence_out, row, tx, per_lane, table_rows
+            )
+
+    return markov_anchor_embed
+
+
+def _flat(column: torch.Tensor) -> torch.Tensor:
+    """The span of a (possibly strided) column as a flat view, which a kernel
+    indexes at ``row * stride``."""
+    rows = column.shape[0]
+    span = (rows - 1) * column.stride(0) + 1 if rows > 0 else 0
+    return column.as_strided((span,), (1,))
+
+
+def _vector_rows(*tensors: torch.Tensor) -> bool:
+    """Every row of each 16-bit tensor starts 16-byte aligned and its columns are
+    whole runs of eight."""
+    return all(
+        t.element_size() == 2
+        and t.data_ptr() % 16 == 0
+        and (t.stride(0) * 2) % 16 == 0
+        and t.shape[1] % _VEC == 0
+        for t in tensors
+    )
+
+
+def partial_argmax_key(
+    base_dtype: torch.dtype,
+    bias_dtype: torch.dtype | None,
+    vector: bool,
+    top2: bool = False,
+) -> tuple:
+    key = (
+        _DTYPES[base_dtype],
+        _DTYPES[bias_dtype] if bias_dtype is not None else None,
+        vector,
+    )
+    return (*key, _THREADS, True) if top2 else key
+
+
+def _partial_argmax(
+    base: torch.Tensor,
+    bias: torch.Tensor | None,
+    partial_values: torch.Tensor,
+    partial_indices: torch.Tensor,
+    *,
+    top2: bool = False,
+) -> None:
+    rows, vocab = base.shape
+    if rows == 0:
+        return
+    vector = _vector_rows(base) if bias is None else _vector_rows(base, bias)
+    kernel = _kernel(
+        partial_argmax_kernel,
+        *partial_argmax_key(
+            base.dtype, None if bias is None else bias.dtype, vector, top2=top2
+        ),
+    )
+    kernel(
+        base,
+        base if bias is None else bias,
+        partial_values.view(-1),
+        partial_indices.view(-1),
+    )
+
+
+def _finish(
+    partial_values: torch.Tensor,
+    partial_indices: torch.Tensor,
+    out: torch.Tensor,
+    rows: int,
+    parts: int,
+    out_stride: int,
+    vocab_start: int,
+    output: str,
+) -> None:
+    if rows == 0:
+        return
+    top2 = output == "pair_top2"
+    lanes = _FINISH_LANES_TOP2 if top2 else _FINISH_LANES
+    per_lane = -(-parts // 32)
+    if per_lane not in lanes:
+        raise ValueError(
+            f"{parts} vocabulary parts exceed the greedy finish's "
+            f"{32 * lanes[-1]} ({lanes})"
+        )
+    kernel = _kernel(finish_argmax_kernel, output, per_lane)
+    kernel(
+        partial_values.view(-1),
+        partial_indices.view(-1),
+        out,
+        parts,
+        rows,
+        out_stride,
+        vocab_start,
+    )
+
+
+def greedy_markov_shard_pair(
+    base_logits: torch.Tensor,
+    markov_bias: torch.Tensor,
+    vocab_start: int,
+    pairs: torch.Tensor,
+    partial_values: torch.Tensor,
+    partial_indices: torch.Tensor,
+    *,
+    top2: bool = False,
+) -> None:
+    """``dspark.greedy.greedy_markov_shard_pair``."""
+    if base_logits.shape != markov_bias.shape:
+        raise ValueError(
+            "DSpark greedy base logits and Markov bias must have identical shapes: "
+            f"{tuple(base_logits.shape)} != {tuple(markov_bias.shape)}"
+        )
+    rows, vocab = base_logits.shape
+    if vocab_start + vocab > 1 << 24:
+        raise ValueError("vocabulary indices must stay exact in FP32")
+    parts = -(-vocab // GREEDY_BLOCK)
+    slots = parts * (2 if top2 else 1)
+    needed = rows * slots
+    if min(partial_values.numel(), partial_indices.numel()) < needed:
+        raise ValueError("DSpark greedy scratch is smaller than the logits require")
+    _partial_argmax(
+        base_logits, markov_bias, partial_values, partial_indices, top2=top2
+    )
+    _finish(
+        partial_values,
+        partial_indices,
+        pairs.view(-1),
+        rows,
+        slots,
+        pairs.stride(0),
+        vocab_start,
+        "pair_top2" if top2 else "pair",
+    )
+
+
+def greedy_shard_pair(
+    logits: torch.Tensor,
+    vocab: int,
+    vocab_start: int,
+    pairs: torch.Tensor,
+    partial_values: torch.Tensor,
+    partial_indices: torch.Tensor,
+) -> None:
+    """``dspark.greedy.greedy_shard_pair``."""
+    rows = logits.shape[0]
+    if vocab > logits.shape[1]:
+        raise ValueError("the shard's real vocabulary exceeds its logits")
+    if vocab_start + vocab > 1 << 24:
+        raise ValueError("vocabulary indices must stay exact in FP32")
+    parts = -(-vocab // GREEDY_BLOCK)
+    if min(partial_values.numel(), partial_indices.numel()) < rows * parts:
+        raise ValueError("greedy scratch is smaller than the logits require")
+    _partial_argmax(logits[:, :vocab], None, partial_values, partial_indices)
+    _finish(
+        partial_values,
+        partial_indices,
+        pairs.view(-1),
+        rows,
+        parts,
+        pairs.stride(0),
+        vocab_start,
+        "pair",
+    )
+
+
+def select_first_argmax(
+    pairs: torch.Tensor,
+    output: torch.Tensor,
+    pair_width: int = 2,
+    embed: tuple[torch.Tensor, torch.Tensor, torch.Tensor] | None = None,
+    top2_branch: (
+        tuple[torch.Tensor | None, torch.Tensor, torch.Tensor, float, float] | None
+    ) = None,
+) -> None:
+    """``dspark.greedy.select_first_argmax``; with ``embed`` (table, step rows,
+    confidence rows), also the selected tokens' Markov embeddings; with
+    ``top2_branch`` (markov_conf_weight, runner_up_out, margin_out, branch_margin,
+    branch_weight), also reduces the global runner-up and promotes it when
+    Markov transition confidence outweighs a narrow top1-top2 logit gap."""
+    rows = pairs.shape[0]
+    if rows == 0:
+        return
+    ranks = pairs.shape[1] // pair_width
+    use_top2 = top2_branch is not None
+    if embed is None:
+        kernel = _kernel(
+            select_first_argmax_kernel,
+            *select_first_argmax_key(output, ranks, 0, pair_width, top2_branch=use_top2),
+        )
+        if not use_top2:
+            kernel(pairs, _flat(output), output.stride(0))
+            return
+        _, runner_up_out, margin_out, _, _ = top2_branch
+        kernel(
+            pairs,
+            _flat(output),
+            output.stride(0),
+            _flat(runner_up_out),
+            runner_up_out.stride(0),
+            _flat(margin_out),
+            margin_out.stride(0),
+        )
+        return
+    table, step_out, confidence_out = embed
+    kernel = _kernel(
+        select_first_argmax_kernel,
+        *select_first_argmax_key(
+            output, ranks, table.shape[1], pair_width, top2_branch=use_top2
+        ),
+    )
+    if not use_top2:
+        kernel(pairs, _flat(output), output.stride(0), table, step_out, confidence_out)
+        return
+    markov_conf_weight, runner_up_out, margin_out, branch_margin, branch_weight = (
+        top2_branch
+    )
+    assert markov_conf_weight is not None
+    kernel(
+        pairs,
+        _flat(output),
+        output.stride(0),
+        table,
+        step_out,
+        confidence_out,
+        markov_conf_weight,
+        _flat(runner_up_out),
+        runner_up_out.stride(0),
+        _flat(margin_out),
+        margin_out.stride(0),
+        float(branch_margin),
+        float(branch_weight),
+    )
+
+
+def select_first_argmax_key(
+    output: torch.Tensor | torch.dtype,
+    ranks: int,
+    embed_width: int,
+    pair_width: int,
+    *,
+    top2_branch: bool = False,
+) -> tuple:
+    """``select_first_argmax_kernel``'s key: the width-2 pairs (Triton's layout)
+    keep the original kernel's key."""
+    dtype = _DTYPES[output if isinstance(output, torch.dtype) else output.dtype]
+    if top2_branch:
+        return (dtype, ranks, embed_width, pair_width, True)
+    if pair_width == 2:
+        return (dtype, ranks, embed_width) if embed_width else (dtype, ranks)
+    return (dtype, ranks, embed_width, pair_width)
+
+
+def markov_anchor_embed(
+    ids: torch.Tensor,
+    index: torch.Tensor,
+    table: torch.Tensor,
+    step_out: torch.Tensor,
+    confidence_out: torch.Tensor,
+) -> None:
+    """``table[ids[index]]`` into ``step_out`` and ``confidence_out``."""
+    if index.shape[0] == 0:
+        return
+    kernel = _kernel(
+        markov_anchor_embed_kernel,
+        _DTYPES[ids.dtype],
+        _DTYPES[index.dtype],
+        table.shape[1],
+    )
+    kernel(ids, index, table, step_out, confidence_out)
+
+
+def markov_embed_calls(
+    ids_dtype: torch.dtype,
+    index_dtype: torch.dtype,
+    output_dtype: torch.dtype,
+    ranks: int,
+    embed_width: int,
+    *,
+    top2_branch: bool = False,
+) -> list:
+    """The drafter's Markov embeddings: the anchor's, and the selection that also
+    embeds the next step's token."""
+    calls = [
+        _call(
+            markov_anchor_embed_kernel,
+            _DTYPES[ids_dtype],
+            _DTYPES[index_dtype],
+            embed_width,
+        ),
+        _call(
+            select_first_argmax_kernel,
+            *select_first_argmax_key(output_dtype, ranks, embed_width, 4),
+        ),
+    ]
+    if top2_branch:
+        calls.append(
+            _call(
+                select_first_argmax_kernel,
+                *select_first_argmax_key(
+                    output_dtype, ranks, embed_width, 4, top2_branch=True
+                ),
+            )
+        )
+    return calls
+
+
+def sample_greedy_markov(
+    base_logits: torch.Tensor,
+    markov_bias: torch.Tensor,
+    output: torch.Tensor,
+    partial_values: torch.Tensor,
+    partial_indices: torch.Tensor,
+) -> None:
+    """``dspark.greedy.sample_greedy_markov``."""
+    if base_logits.shape != markov_bias.shape:
+        raise ValueError(
+            "DSpark greedy base logits and Markov bias must have identical shapes: "
+            f"{tuple(base_logits.shape)} != {tuple(markov_bias.shape)}"
+        )
+    rows, vocab = base_logits.shape
+    parts = -(-vocab // GREEDY_BLOCK)
+    if min(partial_values.numel(), partial_indices.numel()) < rows * parts:
+        raise ValueError("DSpark greedy scratch is smaller than the logits require")
+    _partial_argmax(base_logits, markov_bias, partial_values, partial_indices)
+    _finish(
+        partial_values,
+        partial_indices,
+        _flat(output),
+        rows,
+        parts,
+        output.stride(0),
+        0,
+        _DTYPES[output.dtype],
+    )
+
+
+# select_first_argmax's masked pair: no real pair loses to it.
+_MASKED_INDEX = 1 << 30
+
+
+@tilelang.jit(pass_configs=_PASS)
+def greedy_rejection_kernel(width: int, drafts_dtype: str, ranks: int, pair_width: int):
+    """``dspark.greedy._select_first_argmax`` and
+    ``greedy_verification._greedy_rejection_kernel`` in one launch, from the
+    all-gathered ``(value, index)`` pairs of each logits row ([rows, pair_width *
+    ranks] FP32, a rank's pair first in its ``pair_width`` columns), a warp a
+    request.
+
+    Lane ``j`` of a request with ``num_drafts`` drafts (``j <= num_drafts``) takes
+    position ``start + j``: it loads the row's ``ranks`` pairs, all before the
+    first combine, and reduces them in rank order with ``_first_keep_or_take``
+    (the selection's combine, a total order: NaN first, then the larger value,
+    then the smaller index; with ``ranks`` not a power of two, the masked pair the
+    selection pads with too), so the target is the selection's, bit for bit; the
+    lanes below ``num_drafts`` also stage the draft the position verifies. Lane 0
+    then runs the rejection kernel's loop from shared memory: drafts are accepted
+    while they equal the target (a -1 draft never is); the first mismatch commits
+    the target, and a fully accepted block commits the bonus position's. Positions
+    after the first mismatch are not written; ``num_sampled`` is the accepted
+    count plus one."""
+    if not 1 <= width <= 65:
+        raise ValueError(f"{width} sampled tokens a request: at most 64 drafts")
+    if not 1 <= ranks <= 32 or pair_width < 2:
+        raise ValueError(f"{ranks} ranks of {pair_width}-column pairs")
+    span = 1 << max(ranks - 1, 0).bit_length()
+    passes = -(-width // 32)
+    reqs, cu_len, drafts_len, rows, cols = T.dynamic(
+        "reqs, cu_len, drafts_len, rows, cols"
+    )
+    pairs_stride = T.dynamic("pairs_stride", "int64")
+
+    @T.prim_func
+    def greedy_rejection(
+        sampled: T.Tensor((reqs, width), T.int64),
+        num_sampled: T.Tensor((reqs,), T.int32),
+        pairs: T.StridedTensor((rows, cols), (pairs_stride, 1), T.float32),
+        draft_sampled: T.Tensor((drafts_len,), drafts_dtype),
+        cu_num_logits: T.Tensor((cu_len,), T.int32),
+    ):
+        with T.Kernel(reqs, threads=32) as req:
+            T.import_source(_HEADER)
+            tx = T.get_thread_binding()
+            values = T.alloc_local((ranks,), T.float32)
+            indices = T.alloc_local((ranks,), T.int32)
+            best = T.alloc_local((1,), T.float32)
+            best_index = T.alloc_local((1,), T.int32)
+            targets = T.alloc_shared((width,), T.int64)
+            drafts = T.alloc_shared((width,), T.int64)
+            accepted = T.alloc_local((1,), T.int64)
+            verifying = T.alloc_local((1,), T.int32)
+            start = T.alloc_var(T.int64, init=T.cast(cu_num_logits[req], T.int64))
+            num_drafts = T.alloc_var(
+                T.int64, init=T.cast(cu_num_logits[req + 1], T.int64) - start - 1
+            )
+            for p in T.unroll(passes):
+                pos = p * 32 + tx
+                if (pos < width) & (T.cast(pos, T.int64) <= num_drafts):
+                    for k in tuple(range(ranks)):
+                        values[k] = pairs[start + pos, pair_width * k]
+                        indices[k] = T.cast(
+                            pairs[start + pos, pair_width * k + 1], T.int32
+                        )
+                    best[0] = values[0]
+                    best_index[0] = indices[0]
+                    for k in tuple(range(1, ranks)):
+                        _first_keep_or_take(best, best_index, values[k], indices[k])
+                    if span > ranks:
+                        _first_keep_or_take(
+                            best, best_index, -T.infinity(T.float32), _MASKED_INDEX
+                        )
+                    targets[pos] = T.cast(best_index[0], T.int64)
+                    if T.cast(pos, T.int64) < num_drafts:
+                        drafts[pos] = T.cast(draft_sampled[start + pos + 1], T.int64)
+            T.sync_threads()
+            if tx == 0:
+                accepted[0] = 0
+                verifying[0] = 1
+                for i in tuple(range(width - 1)):
+                    if (num_drafts > i) & (verifying[0] != 0):
+                        # -1 is a placeholder draft that is always rejected.
+                        if (targets[i] == drafts[i]) & (drafts[i] >= 0):
+                            sampled[req, i] = drafts[i]
+                            accepted[0] = accepted[0] + 1
+                        else:
+                            sampled[req, i] = targets[i]
+                            verifying[0] = 0
+                if accepted[0] == num_drafts:
+                    # Every draft accepted: the bonus position's target.
+                    sampled[req, num_drafts] = targets[num_drafts]
+                num_sampled[req] = T.cast(accepted[0] + 1, T.int32)
+
+    return greedy_rejection
+
+
+def greedy_rejection_key(
+    width: int, drafts_dtype: torch.dtype, ranks: int, pair_width: int
+) -> tuple:
+    return (width, _DTYPES[drafts_dtype], ranks, pair_width)
+
+
+def greedy_rejection_sample(
+    pairs: torch.Tensor,
+    draft_sampled: torch.Tensor,
+    cu_num_logits: torch.Tensor,
+    num_speculative_steps: int,
+    pair_width: int = 4,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """``greedy_verification.greedy_rejection_sample``: the targets selected from
+    the gathered pairs ([rows, pair_width * ranks] FP32) and the drafts verified
+    against them, in one launch."""
+    num_reqs = cu_num_logits.shape[0] - 1
+    sampled = draft_sampled.new_empty(
+        num_reqs, num_speculative_steps + 1, dtype=torch.int64
+    )
+    num_sampled = sampled.new_empty(num_reqs, dtype=torch.int32)
+    if num_reqs > 0:
+        if pairs.shape[1] % pair_width:
+            raise ValueError(
+                f"{pairs.shape[1]} pair columns are not whole {pair_width}-column pairs"
+            )
+        kernel = _kernel(
+            greedy_rejection_kernel,
+            *greedy_rejection_key(
+                num_speculative_steps + 1,
+                draft_sampled.dtype,
+                pairs.shape[1] // pair_width,
+                pair_width,
+            ),
+        )
+        kernel(sampled, num_sampled, pairs, draft_sampled, cu_num_logits)
+    return sampled, num_sampled
+
+
+# --- Temperature --------------------------------------------------------------
+
+
+@tilelang.jit(pass_configs=_PASS)
+def temperature_kernel(
+    idx_dtype: str, run: int, block: int, threads: int = _TEMPERATURE_THREADS
+):
+    """``gumbel._temperature_kernel``: FP32 logits divided in place by their
+    request's temperature (``div.full.f32``), rows at temperature 0 or 1 left
+    alone; a block of ``threads`` per token and ``block`` columns,
+    each thread's elements in runs of ``run`` (``_triton_run``), one vector load
+    and store each when aligned. As in Triton, the thread's runs are all loaded,
+    then divided, then stored: the logits are read and written through one pointer,
+    so a run stored before the next run's load would make every load wait for a
+    store. As in Triton, the temperature is read at the mapped index without a
+    validity check."""
+    tokens, vocab, idx_len, temp_len = T.dynamic("tokens, vocab, idx_len, temp_len")
+    logits_stride = T.dynamic("logits_stride", "int64")
+    runs = block // (threads * run)
+
+    @T.prim_func
+    def temperature(
+        logits: T.StridedTensor((tokens, vocab), (logits_stride, 1), T.float32),
+        idx_mapping: T.Tensor((idx_len,), idx_dtype),
+        temperature: T.Tensor((temp_len,), T.float32),
+    ):
+        with T.Kernel(tokens, T.ceildiv(vocab, block), threads=threads) as (t, blk):
+            T.import_source(_HEADER)
+            tx = T.get_thread_binding()
+            temp = T.alloc_local((1,), T.float32)
+            raw = T.alloc_local((runs * run,), T.float32)
+            if run > 1:
+                # The launch checked it: a 16-byte base and a stride of 16 elements.
+                T.assume(logits_stride % 16 == 0)
+            req = T.alloc_var(T.int64, init=T.cast(idx_mapping[t], T.int64))
+            temp[0] = T.if_then_else(req >= 0, temperature[req], T.float32(1))
+            if (temp[0] != T.float32(0)) & (temp[0] != T.float32(1)):
+                for r in T.unroll(runs):
+                    col0 = blk * block + r * (threads * run) + run * tx
+                    _load_run_at(logits, raw, r * run, t, col0, vocab, run)
+                for k in T.unroll(runs * run):
+                    raw[k] = T.call_extern("float32", "vllm_div_full", raw[k], temp[0])
+                for r in T.unroll(runs):
+                    col0 = blk * block + r * (threads * run) + run * tx
+                    _store_run_at(logits, raw, r * run, t, col0, vocab, run)
+
+    return temperature
+
+
+def apply_temperature(
+    logits: torch.Tensor,
+    expanded_idx_mapping: torch.Tensor,
+    temperature: torch.Tensor,
+) -> None:
+    """``gumbel.apply_temperature``."""
+    if logits.shape[0] == 0:
+        return
+    block = _TEMPERATURE_BLOCKS[logits.shape[0] >= _TEMPERATURE_SMALL]
+    kernel = _kernel(
+        temperature_kernel,
+        _DTYPES[expanded_idx_mapping.dtype],
+        _triton_run(logits),
+        block,
+    )
+    kernel(logits, expanded_idx_mapping.contiguous(), temperature)
+
+
+# --- Trace replay & compact sampling mask ------------------------------------
+
+
+@tilelang.jit(pass_configs=_PASS)
+def trace_replay_kernel(idx_dtype: str):
+    """``trace_replay._trace_replay_kernel``: for each request in the batch,
+    overwrites ``sampled[r]`` with ``trace_token_ids[req, total_len[req] -
+    prompt_len[req]]`` when ``req >= 0``, ``trace_len[req] > 0``, and
+    ``0 <= step < trace_len[req]``."""
+    num_reqs, states, max_len, len_states, total_states, prompt_states = T.dynamic(
+        "num_reqs, states, max_len, len_states, total_states, prompt_states"
+    )
+    trace_stride = T.dynamic("trace_stride", "int64")
+
+    @T.prim_func
+    def trace_replay(
+        sampled: T.Tensor((num_reqs,), T.int64),
+        idx_mapping: T.Tensor((num_reqs,), idx_dtype),
+        trace_token_ids: T.StridedTensor(
+            (states, max_len), (trace_stride, 1), T.int32
+        ),
+        trace_len: T.Tensor((len_states,), T.int32),
+        total_len: T.Tensor((total_states,), T.int32),
+        prompt_len: T.Tensor((prompt_states,), T.int32),
+    ):
+        with T.Kernel(T.ceildiv(num_reqs, 32), threads=32) as b:
+            r = b * 32 + T.get_thread_binding()
+            if r < num_reqs:
+                req = T.cast(idx_mapping[r], T.int64)
+                if req >= 0:
+                    t_len = trace_len[req]
+                    if t_len > 0:
+                        step = total_len[req] - prompt_len[req]
+                        if (step >= 0) & (step < t_len):
+                            sampled[r] = T.cast(trace_token_ids[req, step], T.int64)
+
+    return trace_replay
+
+
+def trace_replay_key(idx_dtype: torch.dtype) -> tuple:
+    return (_DTYPES[idx_dtype],)
+
+
+def apply_trace_tokens(
+    sampled: torch.Tensor,
+    idx_mapping: torch.Tensor,
+    trace_token_ids: torch.Tensor,
+    trace_len: torch.Tensor,
+    total_len: torch.Tensor,
+    prompt_len: torch.Tensor,
+) -> None:
+    """``trace_replay.apply_trace_tokens``'s launch."""
+    if idx_mapping.shape[0] == 0:
+        return
+    key = trace_replay_key(idx_mapping.dtype)
+    _kernel(trace_replay_kernel, *key)(
+        sampled.view(-1),
+        idx_mapping,
+        trace_token_ids,
+        trace_len,
+        total_len,
+        prompt_len,
+    )
+
+
+_COMPACT_MASK_THREADS = 256
+_COMPACT_MASK_BITS = 8
+_COMPACT_MASK_BLOCK = _COMPACT_MASK_THREADS * _COMPACT_MASK_BITS
+
+
+@tilelang.jit(pass_configs=_PASS)
+def compact_sampling_mask_kernel(logits_dtype: str, sampled_dtype: str):
+    """``output._compact_sampling_mask_kernel``: for each request row, records the
+    first ``max_num_kept`` finite-logit vocabulary indices in ascending order in
+    ``token_ids[req, :]``, the packed little-endian bitmask in ``packed_mask[req,
+    :]``, and the full finite-logit count in ``counts[req]``. Rows with
+    ``num_sampled_tokens[req] <= 0`` record an empty mask and count 0."""
+    num_reqs, vocab, sampled_len, kept_cols, mask_cols = T.dynamic(
+        "num_reqs, vocab, sampled_len, kept_cols, mask_cols"
+    )
+    logits_stride, ids_stride, mask_stride = T.dynamic(
+        "logits_stride, ids_stride, mask_stride", "int64"
+    )
+    threads = _COMPACT_MASK_THREADS
+    warps = threads // 32
+
+    @T.prim_func
+    def compact_sampling_mask(
+        logits: T.StridedTensor((num_reqs, vocab), (logits_stride, 1), logits_dtype),
+        num_sampled_tokens: T.Tensor((sampled_len,), sampled_dtype),
+        token_ids: T.StridedTensor((num_reqs, kept_cols), (ids_stride, 1), T.int32),
+        packed_mask: T.StridedTensor((num_reqs, mask_cols), (mask_stride, 1), T.uint8),
+        counts: T.Tensor((num_reqs,), T.int32),
+        vocab_size: T.int32,
+        max_num_kept: T.int32,
+    ):
+        with T.Kernel(num_reqs, threads=threads) as req:
+            tx = T.get_thread_binding()
+            lane = tx % 32
+            warp = tx // 32
+            smem_counts = T.alloc_shared((threads,), T.int32)
+            warp_totals = T.alloc_shared((warps,), T.int32)
+            active = T.alloc_var(T.bool, init=num_sampled_tokens[req] > 0)
+            running_count = T.alloc_var(T.int32, init=0)
+            mask_bytes = T.ceildiv(vocab_size, 8)
+            num_passes = T.ceildiv(vocab_size, _COMPACT_MASK_BLOCK)
+            for p in T.serial(num_passes):
+                byte_idx = p * threads + tx
+                col0 = byte_idx * 8
+                mask_byte = T.alloc_var(T.int32, init=0)
+                thread_kept = T.alloc_var(T.int32, init=0)
+                if active:
+                    for b in T.unroll(8):
+                        col = col0 + b
+                        if col < vocab_size:
+                            val = T.cast(logits[req, col], T.float32)
+                            if (val > -T.infinity(T.float32)) & (
+                                val < T.infinity(T.float32)
+                            ):
+                                mask_byte = mask_byte | (1 << b)
+                                thread_kept = thread_kept + 1
+                if byte_idx < mask_bytes:
+                    packed_mask[req, byte_idx] = T.cast(mask_byte, T.uint8)
+                smem_counts[tx] = thread_kept
+                T.sync_threads()
+                local_offset = T.alloc_var(T.int32, init=0)
+                for i in T.unroll(32):
+                    if i < lane:
+                        local_offset = local_offset + smem_counts[warp * 32 + i]
+                if lane == 31:
+                    warp_totals[warp] = local_offset + thread_kept
+                T.sync_threads()
+                for w in T.unroll(warps):
+                    if w < warp:
+                        local_offset = local_offset + warp_totals[w]
+                pass_total = T.alloc_var(T.int32, init=0)
+                for w in T.unroll(warps):
+                    pass_total = pass_total + warp_totals[w]
+                pos = T.alloc_var(T.int32, init=running_count + local_offset)
+                if thread_kept > 0:
+                    for b in T.unroll(8):
+                        if ((mask_byte >> b) & 1) != 0:
+                            if pos < max_num_kept:
+                                token_ids[req, pos] = col0 + b
+                            pos = pos + 1
+                running_count = running_count + pass_total
+                T.sync_threads()
+            if tx == 0:
+                counts[req] = running_count
+
+    return compact_sampling_mask
+
+
+def compact_sampling_mask_key(
+    logits_dtype: torch.dtype, sampled_dtype: torch.dtype = torch.int32
+) -> tuple:
+    return (_DTYPES[logits_dtype], _DTYPES[sampled_dtype])
+
+
+def compact_sampling_mask(
+    logits: torch.Tensor,
+    num_sampled_tokens: torch.Tensor,
+    token_ids: torch.Tensor,
+    packed_mask: torch.Tensor,
+    counts: torch.Tensor,
+    vocab_size: int,
+    max_num_kept: int,
+) -> None:
+    """``SamplingMaskTensors.from_logits``'s launch."""
+    if logits.shape[0] == 0:
+        return
+    if logits.stride(1) != 1:
+        logits = logits.contiguous()
+    ids_arg = token_ids if token_ids.shape[1] > 0 else counts.view(-1, 1)
+    mask_arg = (
+        packed_mask
+        if packed_mask.shape[1] > 0
+        else counts.view(torch.uint8).view(logits.shape[0], -1)
+    )
+    key = compact_sampling_mask_key(logits.dtype, num_sampled_tokens.dtype)
+    _kernel(compact_sampling_mask_kernel, *key)(
+        logits[:, :vocab_size],
+        num_sampled_tokens,
+        ids_arg,
+        mask_arg,
+        counts,
+        vocab_size,
+        max_num_kept,
+    )
+
+
+# --- Preparation --------------------------------------------------------------
+
+# The runner's batch-to-request-state index is ``np.intp``.
+RUNNER_IDX_DTYPE = torch.int64
+
+
+def _runs(dtype: torch.dtype, strides: Sequence[int] | None = None) -> tuple[int, ...]:
+    """The layouts a launch may take for logits of ``dtype`` (``_triton_run``):
+    when ``strides`` are given, each stride's layout (for a 16-byte aligned base
+    allocation); otherwise both."""
+    vec = 16 // torch.empty((), dtype=dtype).element_size()
+    if strides:
+        return tuple(
+            dict.fromkeys(vec if stride % 16 == 0 else 1 for stride in strides)
+        )
+    return 1, vec
+
+
+def _greedy_vectors(
+    dtypes: Sequence[torch.dtype], vector: bool | None = None
+) -> tuple[bool, ...]:
+    """``partial_argmax_kernel``'s ``vector`` specializations: ``_vector_rows`` is
+    True only on 16-bit tensors whose rows are 16-byte aligned and 8-element wide."""
+    if any(dtype.itemsize != 2 for dtype in dtypes):
+        return (False,)
+    if vector is not None:
+        return (bool(vector),)
+    return (True, False)
+
+
+def _call(factory: Any, *key: Any) -> tuple:
+    from vllm.models.deepseek_v4_1.tilelang import prepare
+
+    return prepare.call(factory, *key)
+
+
+def declare(calls: Callable[[], list]) -> None:
+    """Declare an owner's calls with the runner's JIT registry: its TileLang owner
+    compiles them with the deployment's other TileLang calls before memory
+    profiling, and the kernel cache freezes. Like a Triton dispatcher's
+    ``register_warmup``, a no-op where no registry collects (the first launch then
+    compiles, the cache not being frozen)."""
+    from vllm.model_executor.warmup.jit_warmup import JitWarmupRegistry
+
+    if JitWarmupRegistry.active() is None:
+        return
+    from vllm.models.deepseek_v4_1.tilelang import prepare
+
+    prepare.declare(calls)
+
+
+@tilelang.jit(pass_configs=_PASS)
+def copy_logits_kernel(
+    dtype: str, vectorized: bool = False, idx_dtype: str | None = None
+):
+    """Own an FP32 logits copy, including cast and non-contiguous source rows.
+    When idx_dtype is given, rows with idx_mapping[row] < 0 (dead
+    verification rows past dead_row_cut) exit before reading src."""
+    rows, cols, row_stride, col_stride = T.dynamic("rows, cols, row_stride, col_stride")
+    source_strides = (row_stride, 1) if vectorized else (row_stride, col_stride)
+    has_idx = idx_dtype is not None
+    if not has_idx:
+        idx_dtype = "int64"
+
+    @T.prim_func
+    def copy_logits_unmasked(
+        src: T.StridedTensor((rows, cols), source_strides, dtype),
+        dst: T.Tensor((rows, cols), T.float32),
+    ):
+        grid_x = T.ceildiv(cols, 1024) if vectorized else rows
+        grid_y = rows if vectorized else T.ceildiv(cols, 1024)
+        with T.Kernel(grid_x, grid_y, threads=256) as (bx, by):
+            row = by if vectorized else bx
+            block = bx if vectorized else by
+            tx = T.get_thread_binding()
+            if vectorized:
+                T.assume(row_stride % 4 == 0)
+                T.assume(cols % 4 == 0)
+                col = block * 1024 + tx * 4
+                if col + 4 <= cols:
+                    for j in T.vectorized(4):
+                        dst[row, col + j] = T.cast(src[row, col + j], T.float32)
+            else:
+                for j in T.unroll(4):
+                    col = block * 1024 + j * 256 + tx
+                    if col < cols:
+                        dst[row, col] = T.cast(src[row, col], T.float32)
+
+    idx_len = T.dynamic("idx_len")
+
+    @T.prim_func
+    def copy_logits_masked(
+        src: T.StridedTensor((rows, cols), source_strides, dtype),
+        dst: T.Tensor((rows, cols), T.float32),
+        idx_mapping: T.Tensor((idx_len,), idx_dtype),
+    ):
+        grid_x = T.ceildiv(cols, 1024) if vectorized else rows
+        grid_y = rows if vectorized else T.ceildiv(cols, 1024)
+        with T.Kernel(grid_x, grid_y, threads=256) as (bx, by):
+            row = by if vectorized else bx
+            block = bx if vectorized else by
+            tx = T.get_thread_binding()
+            if idx_mapping[row] >= 0:
+                if vectorized:
+                    T.assume(row_stride % 4 == 0)
+                    T.assume(cols % 4 == 0)
+                    col = block * 1024 + tx * 4
+                    if col + 4 <= cols:
+                        for j in T.vectorized(4):
+                            dst[row, col + j] = T.cast(src[row, col + j], T.float32)
+                else:
+                    for j in T.unroll(4):
+                        col = block * 1024 + j * 256 + tx
+                        if col < cols:
+                            dst[row, col] = T.cast(src[row, col], T.float32)
+
+    return copy_logits_masked if has_idx else copy_logits_unmasked
+
+
+def _pitched_logits_copy(logits: torch.Tensor, out: torch.Tensor) -> None:
+    from cuda.bindings import runtime as cudart
+
+    with torch.cuda.device(logits.device):
+        error, = cudart.cudaMemcpy2DAsync(
+            out.data_ptr(), out.stride(0) * 4,
+            logits.data_ptr(), logits.stride(0) * 4,
+            logits.shape[1] * 4, logits.shape[0],
+            cudart.cudaMemcpyKind.cudaMemcpyDeviceToDevice,
+            torch.cuda.current_stream(logits.device).cuda_stream,
+        )
+    if error != cudart.cudaError_t.cudaSuccess:
+        raise RuntimeError(f"pitched logits copy failed: {error}")
+
+
+def copy_logits(
+    logits: torch.Tensor,
+    live_idx_mapping: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """FP32-owned logits for processing; leave the raw logits unchanged.
+
+    Dense FP32 uses PyTorch's DMA path. Wide aligned FP32 matrices above 8 MiB
+    use pitched DMA; smaller copies, casts and other strides use TileLang.
+    When live_idx_mapping is provided, dead rows (live_idx_mapping[row] < 0)
+    are skipped by the TileLang copy kernel.
+    Tensor allocation and views do not launch compute kernels.
+    """
+    if (
+        logits.ndim != 2
+        or not logits.is_cuda
+        or logits.dtype not in (torch.float16, torch.bfloat16, torch.float32)
+    ):
+        raise ValueError("copy_logits requires a 2-D CUDA floating-point tensor")
+    out = torch.empty(logits.shape, dtype=torch.float32, device=logits.device)
+    if not logits.numel():
+        return out
+    if live_idx_mapping is not None:
+        vectorized = (
+            logits.stride(1) == 1
+            and logits.shape[0] <= 65535
+            and logits.shape[1] % 4 == 0
+            and _triton_run(logits) > 1
+        )
+        _kernel(
+            copy_logits_kernel,
+            _DTYPES[logits.dtype],
+            vectorized,
+            _DTYPES[live_idx_mapping.dtype],
+        )(logits, out, live_idx_mapping.contiguous())
+    elif logits.dtype == torch.float32 and logits.is_contiguous():
+        out.copy_(logits)
+    elif (
+        logits.dtype == torch.float32
+        and logits.stride(1) == 1
+        and logits.shape[1] >= 65536
+        and logits.shape[1] % 16 == 0
+        and logits.numel() * 4 >= 8 << 20
+        and logits.stride(0) >= logits.shape[1]
+        and logits.stride(0) % 16 == 0
+        and logits.data_ptr() % 64 == 0
+    ):
+        _pitched_logits_copy(logits, out)
+    else:
+        vectorized = (
+            logits.stride(1) == 1
+            and logits.shape[0] <= 65535
+            and logits.shape[1] % 4 == 0
+            and _triton_run(logits) > 1
+        )
+        _kernel(copy_logits_kernel, _DTYPES[logits.dtype], vectorized)(logits, out)
+    return out
+
+
+def sampling_calls(
+    logits_dtypes: Sequence[torch.dtype],
+    temperature: bool = True,
+    *,
+    logits_strides: Sequence[tuple[torch.dtype, int]] | None = None,
+    temperature_strides: Sequence[int] | None = None,
+) -> list:
+    """The target sampler's calls: Gumbel-max sampling of logits of each of
+    ``logits_dtypes`` without a logits cache (with and without in-kernel
+    temperature scaling), and the temperature of processed FP32 logits."""
+    strides_by_dtype: dict[torch.dtype, list[int]] = {}
+    if logits_strides is not None:
+        for dtype, stride in logits_strides:
+            strides_by_dtype.setdefault(dtype, []).append(stride)
+    apply_temps = (False, True) if temperature else (False,)
+    calls = [
+        _call(
+            gumbel_sample_kernel,
+            *gumbel_sample_key(dtype, RUNNER_IDX_DTYPE, apply_temp, False, run=run),
+        )
+        for dtype in dict.fromkeys(logits_dtypes)
+        for run in _runs(dtype, strides_by_dtype.get(dtype))
+        for apply_temp in apply_temps
+    ]
+    calls += [
+        _call(copy_logits_kernel, _DTYPES[dtype], vectorized)
+        for dtype in dict.fromkeys(logits_dtypes)
+        for vectorized in (False, True)
+    ]
+    calls += [
+        _call(
+            copy_logits_kernel,
+            _DTYPES[dtype],
+            vectorized,
+            _DTYPES[RUNNER_IDX_DTYPE],
+        )
+        for dtype in dict.fromkeys(logits_dtypes)
+        for vectorized in (False, True)
+    ]
+    if temperature:
+        calls += [
+            _call(temperature_kernel, _DTYPES[RUNNER_IDX_DTYPE], run, block)
+            for run in _runs(torch.float32, temperature_strides)
+            for block in _TEMPERATURE_BLOCKS
+        ]
+    return _unique(calls)
+
+
+def gumbel_finish_calls(vocab_size: int) -> list:
+    """The finish of Gumbel-max sampling of ``vocab_size``-wide logits."""
+    num_blocks = -(-vocab_size // GUMBEL_BLOCK)
+    return [_call(gumbel_finish_kernel, *gumbel_finish_key(num_blocks))]
+
+
+def drafting_calls(
+    logits_dtype: torch.dtype,
+    cache_dtype: torch.dtype | None,
+    col_dtype: torch.dtype | None,
+    per_token_col: bool,
+) -> list:
+    """A speculator's draft sampling: temperature applied in the kernel, the
+    drafting noise stream, and the logits cache when there is one."""
+    return [
+        _call(
+            gumbel_sample_kernel,
+            *gumbel_sample_key(
+                logits_dtype,
+                RUNNER_IDX_DTYPE,
+                True,
+                True,
+                cache_dtype,
+                col_dtype,
+                per_token_col,
+                run,
+            ),
+        )
+        for run in _runs(logits_dtype)
+    ]
+
+
+
+
+# --- Sparse top-k draft sampling ----------------------------------------------
+
+
+@tilelang.jit(pass_configs=_PASS)
+def topk_greedy_sample_kernel(
+    logits_dtype: str,
+    index_dtype: str = "int64",
+    threads: int = _THREADS,
+    per_thread: int = 2,
+):
+    """Sparse-support greedy argmax over topk candidate logits and their
+    vocabulary indices cand_indices. Tie-breaking follows _first_argmax
+    on global vocabulary indices (lowest vocabulary index wins ties; NaN beats
+    finite values). When topk < vocab, column 0 of the implicit -inf
+    background is seeded so an all--inf candidate set still selects token 0
+    just as logits.fill_(-inf) + scatter_ + argmax(-1) does."""
+    tokens, topk = T.dynamic("tokens, topk")
+    logits_stride, idx_stride = T.dynamic("logits_stride, idx_stride", "int64")
+    warps = threads // 32
+
+    @T.prim_func
+    def topk_greedy_sample(
+        cand_logits: T.StridedTensor((tokens, topk), (logits_stride, 1), logits_dtype),
+        cand_indices: T.StridedTensor((tokens, topk), (idx_stride, 1), index_dtype),
+        sampled: T.Tensor((tokens,), T.int64),
+        vocab: T.int32,
+    ):
+        with T.Kernel(tokens, threads=threads) as t:
+            T.import_source(_HEADER)
+            tx = T.get_thread_binding()
+            best = T.alloc_local((1,), T.float32)
+            best_index = T.alloc_local((1,), T.int32)
+            other = T.alloc_local((1,), T.float32)
+            other_index = T.alloc_local((1,), T.int32)
+            partial = T.alloc_shared((warps,), T.float32)
+            partial_index = T.alloc_shared((warps,), T.int32)
+
+            best[0] = -T.infinity(T.float32)
+            best_index[0] = T.if_then_else(
+                (tx == 0) & (topk < vocab), T.int32(0), T.int32(_INT32_MAX)
+            )
+            for r in T.unroll(per_thread):
+                c = r * threads + tx
+                if c < topk:
+                    val = T.cast(cand_logits[t, c], T.float32)
+                    idx = T.cast(cand_indices[t, c], T.int32)
+                    _first_keep_or_take(best, best_index, val, idx)
+
+            _first_exchange(best, best_index, other, other_index, 16)
+            _first_exchange(best, best_index, other, other_index, 8)
+            _first_exchange(best, best_index, other, other_index, 4)
+            _first_exchange(best, best_index, other, other_index, 2)
+            _first_exchange(best, best_index, other, other_index, 1)
+            if tx % 32 == 0:
+                partial[tx // 32] = best[0]
+                partial_index[tx // 32] = best_index[0]
+            T.sync_threads()
+            if tx < warps:
+                best[0] = partial[tx]
+                best_index[0] = partial_index[tx]
+            _first_exchange(best, best_index, other, other_index, 2)
+            _first_exchange(best, best_index, other, other_index, 1)
+            if tx == 0:
+                sampled[t] = T.cast(best_index[0], T.int64)
+
+    return topk_greedy_sample
+
+
+def topk_greedy_sample_key(
+    logits_dtype: torch.dtype,
+    index_dtype: torch.dtype = torch.int64,
+    topk: int = 128,
+) -> tuple:
+    per_thread = max(-(-topk // _THREADS), 1)
+    return (_DTYPES[logits_dtype], _DTYPES[index_dtype], _THREADS, per_thread)
+
+
+def topk_greedy_sample(
+    cand_logits: torch.Tensor,
+    cand_indices: torch.Tensor,
+    vocab_size: int,
+) -> torch.Tensor:
+    """Sparse-support argmax(dim=-1) over (cand_logits, cand_indices)."""
+    num_tokens, topk = cand_logits.shape
+    sampled = torch.empty(num_tokens, dtype=torch.int64, device=cand_logits.device)
+    if num_tokens == 0:
+        return sampled
+    if cand_logits.stride(-1) != 1:
+        cand_logits = cand_logits.contiguous()
+    if cand_indices.stride(-1) != 1:
+        cand_indices = cand_indices.contiguous()
+    key = topk_greedy_sample_key(cand_logits.dtype, cand_indices.dtype, topk)
+    _kernel(topk_greedy_sample_kernel, *key)(
+        cand_logits, cand_indices, sampled, int(vocab_size)
+    )
+    return sampled
+
+
+@tilelang.jit(pass_configs=_PASS)
+def topk_gumbel_sample_kernel(
+    logits_dtype: str,
+    idx_dtype: str,
+    apply_temperature: bool,
+    is_drafting: bool,
+    cache_dtype: str | None,
+    col_dtype: str | None,
+    per_token_col: bool,
+    per_thread: int = 2,
+    pos_dtype: str = "int64",
+    cand_idx_dtype: str = "int64",
+):
+    """Sparse-support Gumbel-max sampling over topk candidates (cand_logits,
+    cand_indices). Each candidate's Philox word is drawn at its global vocabulary
+    index index = cand_indices[t, c] using vllm_randint32(word_seed[0], index)
+    so the random stream and tie-breaking match full-vocabulary gumbel_sample on a
+    -inf-masked vocabulary tensor bit for bit. When cache_dtype is given, the
+    previous step's topk cached indices cached_indices[req, col, :] are first
+    cleared to -inf in cache before writing the new topk candidate scores
+    and updating cached_indices."""
+    tokens, topk = T.dynamic("tokens, topk")
+    idx_len, pos_len, seed_len, temp_len = T.dynamic(
+        "idx_len, pos_len, seed_len, temp_len"
+    )
+    logits_stride, cand_idx_stride = T.dynamic(
+        "logits_stride, cand_idx_stride", "int64"
+    )
+    cached = cache_dtype is not None
+    cache_reqs, cache_cols, cache_vocab, num_cols = T.dynamic(
+        "cache_reqs, cache_cols, cache_vocab, num_cols"
+    )
+    cache_stride_0, cache_stride_1 = T.dynamic(
+        "cache_stride_0, cache_stride_1", "int64"
+    )
+    cached_idx_stride_0, cached_idx_stride_1 = T.dynamic(
+        "cached_idx_stride_0, cached_idx_stride_1", "int64"
+    )
+    if not cached:
+        cache_dtype, col_dtype = "float32", "int64"
+
+    @T.prim_func
+    def topk_gumbel_sample(
+        sampled: T.Tensor((tokens,), T.int64),
+        cand_logits: T.StridedTensor((tokens, topk), (logits_stride, 1), logits_dtype),
+        cand_indices: T.StridedTensor((tokens, topk), (cand_idx_stride, 1), cand_idx_dtype),
+        idx_mapping: T.Tensor((idx_len,), idx_dtype),
+        seeds: T.Tensor((seed_len,), T.int64),
+        pos: T.Tensor((pos_len,), pos_dtype),
+        temperature: T.Tensor((temp_len,), T.float32),
+        cache: T.StridedTensor(
+            (cache_reqs, cache_cols, cache_vocab),
+            (cache_stride_0, cache_stride_1, 1),
+            cache_dtype,
+        ),
+        cache_col: T.Tensor((num_cols,), col_dtype),
+        cached_indices: T.StridedTensor(
+            (cache_reqs, cache_cols, topk),
+            (cached_idx_stride_0, cached_idx_stride_1, 1),
+            cand_idx_dtype,
+        ),
+        vocab: T.int32,
+    ):
+        with T.Kernel(tokens, threads=_THREADS) as t:
+            T.import_source(_HEADER)
+            tx = T.get_thread_binding()
+            req = T.alloc_local((1,), T.int64)
+            temp = T.alloc_local((1,), T.float32)
+            seed = T.alloc_local((1,), T.int64)
+            col = T.alloc_local((1,), T.int64)
+            word_seed = T.alloc_local((1,), T.uint32)
+            score = T.alloc_local((1,), T.float32)
+            best = T.alloc_local((1,), T.float32)
+            best_index = T.alloc_local((1,), T.int32)
+            other = T.alloc_local((1,), T.float32)
+            other_index = T.alloc_local((1,), T.int32)
+            partial = T.alloc_shared((_WARPS,), T.float32)
+            partial_index = T.alloc_shared((_WARPS,), T.int32)
+
+            req[0] = T.cast(idx_mapping[t], T.int64)
+            temp[0] = T.float32(0)
+            seed[0] = T.int64(0)
+            if req[0] >= 0:
+                temp[0] = temperature[req[0]]
+                seed[0] = seeds[req[0]]
+            if cached:
+                if per_token_col:
+                    col[0] = T.cast(cache_col[t], T.int64)
+                else:
+                    col[0] = T.cast(cache_col[0], T.int64)
+                seed[0] = seed[0] ^ T.shift_left(col[0], T.int64(32))
+                if req[0] >= 0:
+                    for r in T.unroll(per_thread):
+                        c = r * _THREADS + tx
+                        if c < topk:
+                            old_idx = T.cast(cached_indices[req[0], col[0], c], T.int32)
+                            if (old_idx >= 0) & (old_idx < vocab):
+                                cache[req[0], col[0], old_idx] = T.cast(
+                                    -T.infinity(T.float32), cache_dtype
+                                )
+                T.sync_threads()
+            word_seed[0] = _randint_at(seed[0], pos[t], pos_dtype, is_drafting)
+
+            best[0] = -T.infinity(T.float32)
+            best_index[0] = T.if_then_else(
+                (tx == 0) & (topk < vocab), T.int32(0), T.int32(_INT32_MAX)
+            )
+            if temp[0] != T.float32(0):
+                for r in T.unroll(per_thread):
+                    c = r * _THREADS + tx
+                    if c < topk:
+                        index = T.cast(cand_indices[t, c], T.int32)
+                        word = T.alloc_var(
+                            T.uint32,
+                            init=T.call_extern(
+                                "uint32", "vllm_randint32", word_seed[0], index
+                            ),
+                        )
+                        score[0] = T.cast(cand_logits[t, c], T.float32)
+                        if cached:
+                            if req[0] >= 0:
+                                cache[req[0], col[0], index] = T.cast(
+                                    score[0], cache_dtype
+                                )
+                                cached_indices[req[0], col[0], c] = T.cast(
+                                    index, cand_idx_dtype
+                                )
+                        if apply_temperature:
+                            score[0] = T.call_extern(
+                                "float32", "vllm_div_full", score[0], temp[0]
+                            )
+                        score[0] = T.call_extern(
+                            "float32", "vllm_gumbel_score", score[0], word
+                        )
+                        _first_keep_or_take(best, best_index, score[0], index)
+            else:
+                for r in T.unroll(per_thread):
+                    c = r * _THREADS + tx
+                    if c < topk:
+                        index = T.cast(cand_indices[t, c], T.int32)
+                        score[0] = T.cast(cand_logits[t, c], T.float32)
+                        if cached:
+                            if req[0] >= 0:
+                                cache[req[0], col[0], index] = T.cast(
+                                    score[0], cache_dtype
+                                )
+                                cached_indices[req[0], col[0], c] = T.cast(
+                                    index, cand_idx_dtype
+                                )
+                        _first_keep_or_take(best, best_index, score[0], index)
+
+            _first_exchange(best, best_index, other, other_index, 16)
+            _first_exchange(best, best_index, other, other_index, 8)
+            _first_exchange(best, best_index, other, other_index, 4)
+            _first_exchange(best, best_index, other, other_index, 2)
+            _first_exchange(best, best_index, other, other_index, 1)
+            if tx % 32 == 0:
+                partial[tx // 32] = best[0]
+                partial_index[tx // 32] = best_index[0]
+            T.sync_threads()
+            if tx < _WARPS:
+                best[0] = partial[tx]
+                best_index[0] = partial_index[tx]
+            _first_exchange(best, best_index, other, other_index, 2)
+            _first_exchange(best, best_index, other, other_index, 1)
+            if tx == 0:
+                sampled[t] = T.cast(best_index[0], T.int64)
+
+    return topk_gumbel_sample
+
+
+def topk_gumbel_sample_key(
+    logits_dtype: torch.dtype,
+    idx_dtype: torch.dtype,
+    apply_temperature: bool,
+    is_drafting: bool,
+    cache_dtype: torch.dtype | None = None,
+    col_dtype: torch.dtype | None = None,
+    per_token_col: bool = False,
+    topk: int = 128,
+    pos_dtype: torch.dtype = torch.int64,
+    cand_idx_dtype: torch.dtype = torch.int64,
+) -> tuple:
+    per_thread = max(-(-topk // _THREADS), 1)
+    return (
+        _DTYPES[logits_dtype],
+        _DTYPES[idx_dtype],
+        apply_temperature,
+        is_drafting,
+        None if cache_dtype is None else _DTYPES[cache_dtype],
+        None if cache_dtype is None or col_dtype is None else _DTYPES[col_dtype],
+        bool(cache_dtype is not None and per_token_col),
+        per_thread,
+        _DTYPES[pos_dtype],
+        _DTYPES[cand_idx_dtype],
+    )
+
+
+def topk_gumbel_sample(
+    cand_logits: torch.Tensor,
+    cand_indices: torch.Tensor,
+    idx_mapping: torch.Tensor,
+    temperature: torch.Tensor,
+    seeds: torch.Tensor,
+    pos: torch.Tensor,
+    apply_temperature: bool,
+    vocab_size: int,
+    *,
+    is_drafting: bool = False,
+    logits_cache: torch.Tensor | None = None,
+    logits_cache_col: torch.Tensor | None = None,
+    cached_indices: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Sparse-support gumbel_sample over (cand_logits, cand_indices)."""
+    num_tokens, topk = cand_logits.shape
+    sampled = torch.empty(num_tokens, dtype=torch.int64, device=cand_logits.device)
+    if num_tokens == 0:
+        return sampled
+    if cand_logits.stride(-1) != 1:
+        cand_logits = cand_logits.contiguous()
+    if cand_indices.stride(-1) != 1:
+        cand_indices = cand_indices.contiguous()
+    idx_mapping = idx_mapping.contiguous()
+    pos = pos.contiguous()
+    if logits_cache is None:
+        cache = torch.empty((1, 1, 1), dtype=torch.float32, device=cand_logits.device)
+        col = torch.empty((1,), dtype=torch.int64, device=cand_logits.device)
+        cached_idx = torch.empty(
+            (1, 1, topk), dtype=cand_indices.dtype, device=cand_logits.device
+        )
+        cache_dtype = None
+        col_dtype = None
+        per_token_col = False
+    else:
+        assert logits_cache_col is not None
+        assert cached_indices is not None
+        if logits_cache.stride(-1) != 1:
+            raise ValueError("logits_cache must be contiguous along the vocabulary")
+        cache = logits_cache
+        col = logits_cache_col.contiguous().view(-1)
+        cached_idx = cached_indices
+        cache_dtype = cache.dtype
+        col_dtype = col.dtype
+        per_token_col = col.numel() > 1
+
+    key = topk_gumbel_sample_key(
+        cand_logits.dtype,
+        idx_mapping.dtype,
+        apply_temperature,
+        is_drafting,
+        cache_dtype,
+        col_dtype,
+        per_token_col,
+        topk,
+        pos.dtype,
+        cand_indices.dtype,
+    )
+    _kernel(topk_gumbel_sample_kernel, *key)(
+        sampled,
+        cand_logits,
+        cand_indices,
+        idx_mapping,
+        seeds,
+        pos,
+        temperature,
+        cache,
+        col,
+        cached_idx,
+        int(vocab_size),
+    )
+    return sampled
+
+
+def topk_drafting_calls(
+    logits_dtype: torch.dtype,
+    cache_dtype: torch.dtype | None,
+    col_dtype: torch.dtype | None,
+    per_token_col: bool,
+    topk: int,
+    cand_idx_dtype: torch.dtype = torch.int64,
+) -> list:
+    """Sparse top-k draft sampling calls (greedy and Gumbel-max)."""
+    calls = [
+        _call(
+            topk_greedy_sample_kernel,
+            *topk_greedy_sample_key(logits_dtype, cand_idx_dtype, topk),
+        ),
+        _call(
+            topk_gumbel_sample_kernel,
+            *topk_gumbel_sample_key(
+                logits_dtype,
+                RUNNER_IDX_DTYPE,
+                True,
+                True,
+                cache_dtype,
+                col_dtype,
+                per_token_col,
+                topk,
+                torch.int64,
+                cand_idx_dtype,
+            ),
+        ),
+    ]
+    return _unique(calls)
+
+
+def _unique(calls: list) -> list:
+    """``calls`` without repeats (a call's keyword arguments are unhashable)."""
+    seen: set = set()
+    unique = []
+    for call in calls:
+        key = (id(call[0]), call[1])
+        if key not in seen:
+            seen.add(key)
+            unique.append(call)
+    return unique
+
+
+def sink_calls(
+    *,
+    logits_dtypes: Sequence[torch.dtype],
+    sampled_widths: Sequence[int],
+    num_alternates: int,
+    rejection: bool,
+    num_event_fields: int,
+    logits_mode: bool = False,
+    logits_strides: Sequence[tuple[torch.dtype, int]] | None = None,
+) -> list:
+    """``SinkSampler``'s calls: the flags, with and without dead rows; the policy
+    for each sampled width, with and without logprobs; with rejection on, the
+    candidates of logits of each of
+    ``logits_dtypes`` (a rejected draft masked when more than one row is
+    sampled, with and without dead rows), and the alternates' rows for their
+    logprobs (with ``logits_mode``, their logits too)."""
+    strides_by_dtype: dict[torch.dtype, list[int]] = {}
+    if logits_strides is not None:
+        for dtype, stride in logits_strides:
+            strides_by_dtype.setdefault(dtype, []).append(stride)
+    calls = [_call(sink_flags_kernel, dead_rows) for dead_rows in (False, True)]
+    if rejection:
+        # The cut and its restore, on raw and processed logits and on a rank's
+        # vocabulary shard (FP32), with the runner's int32 input ids as drafts; a
+        # greedy step's shard candidates; the merge of gathered shard candidates and
+        # of the sampled path's.
+        shard_dtypes = dict.fromkeys([*logits_dtypes, torch.float32])
+        calls += [
+            _call(sink_cut_kernel, _DTYPES[dtype], "int32", restore)
+            for dtype in shard_dtypes
+            for restore in (False, True)
+        ]
+        calls += [
+            _call(sink_shard_top_kernel, _DTYPES[dtype], num_alternates + 1)
+            for dtype in shard_dtypes
+        ]
+        calls += [
+            _call(sink_cut_cols_kernel, "int32"),
+            _call(sink_select_top_rows_kernel, num_alternates + 1),
+        ]
+        calls += [
+            _call(sink_merge_kernel, True, num_alternates + 1, num_alternates),
+            _call(sink_merge_kernel, False, 0, num_alternates),
+        ]
+        if num_alternates:
+            calls += [
+                _call(
+                    sink_rows_kernel,
+                    *sink_rows_key(dtype, num_alternates, logits_mode),
+                )
+                for dtype in dict.fromkeys(logits_dtypes)
+            ]
+    calls += [
+        _call(
+            sink_policy_kernel,
+            *sink_policy_key(
+                RUNNER_IDX_DTYPE,
+                num_alternates,
+                rejection,
+                logprobs,
+                width,
+                num_event_fields,
+            ),
+        )
+        for logprobs in (False, True)
+        for width in sampled_widths
+    ]
+    if rejection:
+        calls += [
+            _call(
+                sink_candidates_kernel,
+                *sink_candidates_key(
+                    dtype,
+                    RUNNER_IDX_DTYPE,
+                    num_alternates + 1,
+                    width > 1,
+                    run,
+                    dead_rows=dead_rows,
+                ),
+            )
+            for dtype in dict.fromkeys(logits_dtypes)
+            for run in _runs(dtype, strides_by_dtype.get(dtype))
+            for width in sampled_widths
+            for dead_rows in ((False, True) if width > 1 else (False,))
+        ]
+    return _unique(calls)
+
+
+def greedy_calls(
+    *,
+    markov: Sequence[
+        tuple[torch.dtype, torch.dtype] | tuple[torch.dtype, torch.dtype, bool]
+    ] = (),
+    logits: Sequence[torch.dtype | tuple[torch.dtype, bool]] = (),
+    select: Sequence[tuple[torch.dtype, int, int]] = (),
+    finish_outputs: Sequence[torch.dtype] = (),
+    rejection: Sequence[tuple[int, int, int]] = (),
+    top2: bool = False,
+) -> list:
+    """The greedy reductions' calls: ``greedy_markov_shard_pair`` /
+    ``sample_greedy_markov`` for each ``(base, bias)`` dtype pair, and
+    ``greedy_shard_pair`` for each logits dtype (the 16-byte or element-wise reads
+    matching the rows' alignment); the
+    pair finish when there is a pair, ``select_first_argmax`` for each
+    ``(output dtype, ranks, pair width)``, ``sample_greedy_markov``'s index finish
+    for each of ``finish_outputs``, and greedy verification (its selection of the
+    targets included) for each ``(sampled width, ranks, pair width)`` of
+    ``rejection``."""
+    calls = []
+    for item in markov:
+        if len(item) == 3:
+            base, bias, vec = item
+            vectors = _greedy_vectors((base, bias), vec)
+        else:
+            base, bias = item
+            vectors = _greedy_vectors((base, bias))
+        for vector in vectors:
+            calls.append(
+                _call(partial_argmax_kernel, *partial_argmax_key(base, bias, vector))
+            )
+            if top2:
+                calls.append(
+                    _call(
+                        partial_argmax_kernel,
+                        *partial_argmax_key(base, bias, vector, top2=True),
+                    )
+                )
+
+    for item in logits:
+        if isinstance(item, tuple):
+            dtype, vec = item
+            vectors = _greedy_vectors((dtype,), vec)
+        else:
+            dtype = item
+            vectors = _greedy_vectors((dtype,))
+        for vector in vectors:
+            calls.append(
+                _call(partial_argmax_kernel, *partial_argmax_key(dtype, None, vector))
+            )
+    if markov or logits:
+        calls += [_call(finish_argmax_kernel, "pair", lanes) for lanes in _FINISH_LANES]
+        if top2:
+            calls += [
+                _call(finish_argmax_kernel, "pair_top2", lanes)
+                for lanes in _FINISH_LANES_TOP2
+            ]
+    calls += [
+        _call(finish_argmax_kernel, _DTYPES[dtype], lanes)
+        for dtype in finish_outputs
+        for lanes in _FINISH_LANES
+    ]
+    for dtype, ranks, width in select:
+        calls.append(
+            _call(
+                select_first_argmax_kernel,
+                *select_first_argmax_key(dtype, ranks, 0, width),
+            )
+        )
+        if top2 and width == 4:
+            calls.append(
+                _call(
+                    select_first_argmax_kernel,
+                    *select_first_argmax_key(dtype, ranks, 0, width, top2_branch=True),
+                )
+            )
+    calls += [
+        _call(
+            greedy_rejection_kernel, *greedy_rejection_key(width, dtype, ranks, pairs)
+        )
+        for width, ranks, pairs in rejection
+        for dtype in (torch.int32, torch.int64)
+    ]
+    return _unique(calls)
+
+
+def trace_replay_calls(idx_dtype: torch.dtype = RUNNER_IDX_DTYPE) -> list:
+    return [_call(trace_replay_kernel, *trace_replay_key(idx_dtype))]
+
+
+def compact_sampling_mask_calls(
+    logits_dtypes: Sequence[torch.dtype] = (torch.float32,),
+    sampled_dtype: torch.dtype = torch.int32,
+) -> list:
+    return _unique(
+        [
+            _call(
+                compact_sampling_mask_kernel,
+                *compact_sampling_mask_key(dtype, sampled_dtype),
+            )
+            for dtype in dict.fromkeys(logits_dtypes)
+        ]
+    )
