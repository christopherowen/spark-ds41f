+                if tx == 0:
+                    picked[rank] = best_index[0]
+                    if packed:
+                        chosen = T.cast(
+                            values[
+                                req,
+                                (best_index[0] // k) * 2 * k + k + best_index[0] % k,
+                            ],
+                            T.int64,
+                        )
+                    else:
+                        chosen = indices[req, best_index[0]]
+                    alternates[req, rank] = T.if_then_else(
+                        best[0] == -T.infinity(T.float32), T.int64(-1), chosen
+                    )
+                T.sync_threads()
+
+    return sink_merge
+
