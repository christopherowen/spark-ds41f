+    freq = torch.full_like(rep, 0.25)
+    pres = torch.full_like(rep, -0.1)
+    mask = torch.randint(
+        -(2**31),
+        2**31 - 1,
+        (states, (width + 31) // 32),
+        device="cuda",
+        dtype=torch.int32,
+    )
+    counts = torch.randint(0, 8, (states, width), device="cuda", dtype=torch.int32)
+
