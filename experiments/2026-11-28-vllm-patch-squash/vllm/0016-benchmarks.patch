+                    mapping,
+                    tokens,
+                    tokens.stride(0),
+                    prompt,
+                    prefill,
+                    mask,
+                    mask.stride(0),
+                    counts,
+                    counts.stride(0),
+                    BLOCK_SIZE=1024,
+                )
