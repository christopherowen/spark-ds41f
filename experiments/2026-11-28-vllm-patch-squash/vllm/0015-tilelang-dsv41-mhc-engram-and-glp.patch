+@tilelang.jit(pass_configs=_PASS_CONFIGS)
+def post_collapse_norm_streams(
+    hidden_size: int,
+    eps: float,
+    threads: int = 128,
+    world: int = 1,
+    column: int = -1,
+):
+    """The final decoder layer's ``post``, stream ``collapse`` (with optional sink
+    detector ``column`` extraction), and output ``RMSNorm`` in one 1-CTA-per-token
+    launch, matching ``norm(post_collapse(...))`` and ``collapse(..., column=column)``
+    to the bit without materializing the ``[M, MULT, hidden_size]`` stream buffer or
+    the pre-norm ``[M, hidden_size]`` collapse tensor."""
+    assert hidden_size % (threads * VEC) == 0
+    assert threads == 128 and world >= 1 and column < hidden_size
+    steps = hidden_size // (threads * VEC)
+    warps = threads // 32
+    column_vi = (column // VEC) // threads if column >= 0 else -1
+    column_thread = (column // VEC) % threads if column >= 0 else -1
+    column_element = column % VEC if column >= 0 else 0
+    M = T.dynamic("M")
+
+    @T.macro
+    def _post_collapse_norm_row(
+        X, residual, post, comb, mix, weight, out, columns, token
+    ):
+        pdl.chain()
+        tx = T.get_thread_binding()
+        xv = T.alloc_local((VEC,), T.bfloat16)
+        xp = T.alloc_local((world * VEC,), T.bfloat16)
+        av = T.alloc_local((VEC,), T.float32)
+        rv = T.alloc_local((MULT * VEC,), T.bfloat16)
+        sv = T.alloc_local((MULT * VEC,), T.bfloat16)
+        cv = T.alloc_local((steps * VEC,), T.bfloat16)
+        wv = T.alloc_local((steps * VEC,), T.bfloat16)
+        ov = T.alloc_local((VEC,), T.bfloat16)
+        pm = T.alloc_local((MULT,), T.float32)
+        cm = T.alloc_local((MULT * MULT,), T.float32)
+        mv = T.alloc_local((MULT,), T.float32)
+        sum_local = T.alloc_local((2,), T.float32)
+        sum_val = T.alloc_local((1,), T.float32)
+        rstd = T.alloc_local((1,), T.float32)
+        sum_shared = T.alloc_shared((warps,), T.float32)
+        acc = T.alloc_var(T.float32)
+
+        for n in T.vectorized(MULT):
+            pm[n] = post[token, n]
+        for m in T.unroll(MULT):
+            for n in T.vectorized(MULT):
+                cm[m * MULT + n] = comb[token, m, n]
+        for m in T.vectorized(MULT):
+            mv[m] = mix[token, m]
+        for vi in T.unroll(steps):
+            col = (vi * threads + tx) * VEC
+            for v in T.vectorized(VEC):
+                wv[vi * VEC + v] = weight[col + v]
+
+        sum_local[0] = T.float32(0)
+        sum_local[1] = T.float32(0)
+        for vi in T.unroll(steps):
+            col = (vi * threads + tx) * VEC
+            for m in T.unroll(MULT):
+                for v in T.vectorized(VEC):
+                    rv[m * VEC + v] = residual[token, m, col + v]
+            if world == 1:
+                for v in T.vectorized(VEC):
+                    xv[v] = X[0, token, col + v]
+            else:
+                for r in T.unroll(world):
+                    for v in T.vectorized(VEC):
+                        xp[r * VEC + v] = X[r, token, col + v]
+                for r in T.unroll(world):
+                    for v in T.unroll(VEC):
+                        if r == 0:
+                            av[v] = T.Cast(T.float32, xp[v])
+                        else:
+                            av[v] = av[v] + T.Cast(T.float32, xp[r * VEC + v])
+                for v in T.unroll(VEC):
+                    xv[v] = T.Cast(T.bfloat16, av[v])
+            for n in T.unroll(MULT):
+                for v in T.unroll(VEC):
+                    acc = cm[n] * T.Cast(T.float32, rv[v])
+                    acc = T.fma(pm[n], T.Cast(T.float32, xv[v]), acc)
+                    for m in T.unroll(1, MULT):
+                        acc = T.fma(
+                            cm[m * MULT + n], T.Cast(T.float32, rv[m * VEC + v]), acc
+                        )
+                    sv[n * VEC + v] = T.Cast(T.bfloat16, acc)
+            if column >= 0:
+                if (vi == column_vi) & (tx == column_thread):
+                    for m in T.unroll(MULT):
+                        columns[token, m] = T.Cast(
+                            T.float32, sv[m * VEC + column_element]
+                        )
+            for v in T.unroll(VEC):
+                acc = T.float32(0)
+                for m in T.unroll(MULT):
+                    acc = T.fma(mv[m], T.Cast(T.float32, sv[m * VEC + v]), acc)
+                cv[vi * VEC + v] = T.Cast(T.bfloat16, acc)
+            for v in T.unroll(VEC):
+                sum_local[v % 2] += T.Cast(
+                    T.float32, cv[vi * VEC + v]
+                ) * T.Cast(T.float32, cv[vi * VEC + v])
+
+        sum_val[0] = sum_local[0] + sum_local[1]
+        sum_val[0] += T.shfl_xor(sum_val[0], 16)
+        sum_val[0] += T.shfl_xor(sum_val[0], 8)
+        sum_val[0] += T.shfl_xor(sum_val[0], 4)
+        sum_val[0] += T.shfl_xor(sum_val[0], 2)
+        sum_val[0] += T.shfl_xor(sum_val[0], 1)
+        if tx % 32 == 0:
+            sum_shared[tx // 32] = sum_val[0]
+        T.sync_threads()
+        rstd[0] = T.rsqrt(
+            (((sum_shared[0] + sum_shared[1]) + sum_shared[2]) + sum_shared[3])
+            / hidden_size
+            + eps
+        )
+        for vi in T.unroll(steps):
+            col = (vi * threads + tx) * VEC
+            for v in T.unroll(VEC):
+                ov[v] = T.Cast(
+                    T.bfloat16,
+                    T.Cast(T.float32, cv[vi * VEC + v])
+                    * rstd[0]
+                    * T.Cast(T.float32, wv[vi * VEC + v]),
+                )
+            for v in T.vectorized(VEC):
+                out[token, col + v] = ov[v]
+
+    if column < 0:
+
+        @T.prim_func
+        def mhc_post_collapse_norm(
+            X: T.Tensor((world, M, hidden_size), T.bfloat16),
+            residual: T.Tensor((M, MULT, hidden_size), T.bfloat16),
+            post: T.Tensor((M, MULT), T.float32),
+            comb: T.Tensor((M, MULT, MULT), T.float32),
+            mix: T.Tensor((M, MULT), T.float32),
+            weight: T.Tensor((hidden_size,), T.bfloat16),
+            out: T.Tensor((M, hidden_size), T.bfloat16),
+        ):
+            with T.Kernel(M, threads=threads) as pid:
+                _post_collapse_norm_row(
+                    X, residual, post, comb, mix, weight, out, post, pid
+                )
+
+        return mhc_post_collapse_norm
+
+    @T.prim_func
+    def mhc_post_collapse_norm(
+        X: T.Tensor((world, M, hidden_size), T.bfloat16),
+        residual: T.Tensor((M, MULT, hidden_size), T.bfloat16),
+        post: T.Tensor((M, MULT), T.float32),
+        comb: T.Tensor((M, MULT, MULT), T.float32),
+        mix: T.Tensor((M, MULT), T.float32),
+        weight: T.Tensor((hidden_size,), T.bfloat16),
+        out: T.Tensor((M, hidden_size), T.bfloat16),
+        columns: T.Tensor((M, MULT), T.float32),
+    ):
+        with T.Kernel(M, threads=threads) as pid:
+            _post_collapse_norm_row(
+                X, residual, post, comb, mix, weight, out, columns, pid
+            )
+
+    return mhc_post_collapse_norm
+
+
+# Shared memory each collapse block holds without using it, which caps residency at
+# four blocks an SM. On GB10 the long-prefill collapse reads the four streams faster
+# with fewer blocks resident (TileKernels' kernel is capped by its own shared memory);
+# decode is not limited by residency. Round 4a of the TileLang completion experiment,
+# three passes against TileKernels: -2.2% to -3.0% at 8K and 16K prefill tokens and
+# -4% to -8% at decode.
+_COLLAPSE_RESERVE = 24 * 1024
+
+
+@T.macro
+def _collapse_rows(state, mix, out, sv, token, col, tx, reserve):
+    """One thread's ``VEC`` columns of a token: the streams' weighted sum, as
+    ``collapse_streams`` describes it. Leaves the streams' values in ``sv``."""
+    ov = T.alloc_local((VEC,), T.bfloat16)
+    mv = T.alloc_local((MULT,), T.float32)
+    acc = T.alloc_var(T.float32)
+    if tx == 0:
+        reserve[0] = T.float32(0)
+    for m in T.vectorized(MULT):
+        mv[m] = mix[token, m]
+    for m in T.unroll(MULT):
+        for v in T.vectorized(VEC):
+            sv[m * VEC + v] = state[token, m, col + v]
+    for v in T.unroll(VEC):
+        acc = T.float32(0)
+        for m in T.unroll(MULT):
+            acc = T.fma(mv[m], T.Cast(T.float32, sv[m * VEC + v]), acc)
+        ov[v] = T.Cast(T.bfloat16, acc)
+    for v in T.vectorized(VEC):
+        out[token, col + v] = ov[v]
+
+
+@tilelang.jit(pass_configs=_PASS_CONFIGS)
+def collapse_streams(hidden_size: int, threads: int = 128, column: int = -1):
+    """The streams' weighted sum, TileKernels' ``mhc_pre_apply_mix_fwd`` to the bit:
+    ``out = bf16(sum_m mix[m] * state[m])``.
+
+    Per element, as TileKernels' compiled kernel computes it: from a positive
+    zero, each stream's term added by one fused multiply-add, streams in order,
+    and one rounding to BF16. Starting from zero rather than the first product
+    matters only in sign: four negative-zero products sum to positive zero, as
+    TileKernels' do. The thread mapping is ``post_streams``'; each block holds
+    ``_COLLAPSE_RESERVE`` bytes of shared memory.
+
+    With ``column`` (the sink detector's), the thread that reads it also writes
+    each stream's value there, as FP32, to ``columns`` ([tokens, MULT]): the
+    forward's last collapse hands the detector its column in the same launch.
+    """
+    assert hidden_size % (threads * VEC) == 0
+    assert column < hidden_size
+    blocks = hidden_size // (threads * VEC)
+    M = T.dynamic("M")
+
+    if column < 0:
+
+        @T.prim_func
+        def mhc_collapse(
+            state: T.Tensor((M, MULT, hidden_size), T.bfloat16),
+            mix: T.Tensor((M, MULT), T.float32),
+            out: T.Tensor((M, hidden_size), T.bfloat16),
+        ):
+            with T.Kernel(M * blocks, threads=threads) as pid:
+                pdl.chain()
+                tx = T.get_thread_binding()
+                sv = T.alloc_local((MULT * VEC,), T.bfloat16)
+                # Held, not used: the one write keeps the allocation, and with it
+                # the cap.
+                reserve = T.alloc_shared((_COLLAPSE_RESERVE // 4,), T.float32)
+                _collapse_rows(
+                    state,
+                    mix,
+                    out,
+                    sv,
+                    pid // blocks,
+                    (pid % blocks * threads + tx) * VEC,
+                    tx,
+                    reserve,
+                )
+
+        return mhc_collapse
+
+    # The block, thread and vector element that read ``column``.
+    column_block = column // (threads * VEC)
+    column_thread = column % (threads * VEC) // VEC
+    column_element = column % VEC
+
+    @T.prim_func
+    def mhc_collapse_column(
+        state: T.Tensor((M, MULT, hidden_size), T.bfloat16),
+        mix: T.Tensor((M, MULT), T.float32),
+        out: T.Tensor((M, hidden_size), T.bfloat16),
+        columns: T.Tensor((M, MULT), T.float32),
+    ):
+        with T.Kernel(M * blocks, threads=threads) as pid:
+            pdl.chain()
+            tx = T.get_thread_binding()
+            sv = T.alloc_local((MULT * VEC,), T.bfloat16)
+            reserve = T.alloc_shared((_COLLAPSE_RESERVE // 4,), T.float32)
+            _collapse_rows(
+                state,
+                mix,
+                out,
+                sv,
+                pid // blocks,
+                (pid % blocks * threads + tx) * VEC,
+                tx,
+                reserve,
+            )
+            if (pid % blocks == column_block) & (tx == column_thread):
+                for m in T.unroll(MULT):
+                    columns[pid // blocks, m] = T.Cast(
+                        T.float32, sv[m * VEC + column_element]
+                    )
+
+    return mhc_collapse_column
+
+
+def _project_call(
+    hidden: int, mode: str, world: int, with_aux: bool = False
+) -> prepare.TileLangCall:
+    """The ``project_streams`` call of a sublayer entry."""
+    if not with_aux:
+        return prepare.call(project_streams, hidden, mode, block_M=BLOCK_M, world=world)
+    return prepare.call(
+        project_streams, hidden, mode, block_M=BLOCK_M, world=world, with_aux=True
+    )
+
+
+def _finalize_call(
+    hidden: int, k: int, rms_eps: float, hc_eps: float, iterations: int
+) -> prepare.TileLangCall:
+    """The ``finalize`` call of a sublayer entry projecting ``k`` stream columns."""
+    return prepare.call(finalize, hidden, k, rms_eps, hc_eps, iterations, rms_eps)
+
+
+
+def _post_call(hidden: int, world: int = 1) -> prepare.TileLangCall:
+    """The standalone ``post``'s call."""
+    if world == 1:
+        return prepare.call(post_streams, hidden)
+    return prepare.call(post_streams, hidden, world=world)
+
+
+def _post_collapse_call(hidden: int, world: int = 1) -> prepare.TileLangCall:
+    """The fused ``post_collapse``'s call."""
+    if world == 1:
+        return prepare.call(post_collapse_streams, hidden)
+    return prepare.call(post_collapse_streams, hidden, world=world)
+
+
+def _post_collapse_norm_call(
+    hidden: int, eps: float, world: int = 1, column: int = -1
+) -> prepare.TileLangCall:
+    """The fused ``post_collapse_norm``'s call."""
+    kwargs = {}
+    if world != 1:
+        kwargs["world"] = world
+    if column >= 0:
+        kwargs["column"] = column
+    return prepare.call(post_collapse_norm_streams, hidden, eps, **kwargs)
+
+
+def _collapse_call(hidden: int, column: int = -1) -> prepare.TileLangCall:
+    """The stream collapse's call, and with ``column`` its variant that also writes
+    that column of every stream."""
+    if column < 0:
+        return prepare.call(collapse_streams, hidden)
+    return prepare.call(collapse_streams, hidden, column=column)
+
+
+def _make(call: prepare.TileLangCall):
+    function, args, kwargs = call
+    return function(*args, **kwargs)
+
+
+@cache
+def _project(hidden: int, mode: str, world: int, with_aux: bool = False):
+    return _make(_project_call(hidden, mode, world, with_aux))
+
+
+def _finalize_norm_call(hidden: int, rms_eps: float) -> prepare.TileLangCall:
+    """The critical-path ``finalize_norm`` call."""
+    return prepare.call(finalize_norm, hidden, rms_eps, k_ctas=_norm_ctas(hidden))
+
+
+def _finalize_sinkhorn_call(
+    hidden: int, k: int, rms_eps: float, hc_eps: float, iterations: int
+) -> prepare.TileLangCall:
+    """The off-critical-path ``finalize_sinkhorn`` call."""
+    return prepare.call(finalize_sinkhorn, hidden, k, rms_eps, hc_eps, iterations)
+
+
+@cache
+def _finalize(hidden: int, k: int, rms_eps: float, hc_eps: float, iterations: int):
+    return _make(_finalize_call(hidden, k, rms_eps, hc_eps, iterations))
+
+
+@cache
+def _finalize_norm(hidden: int, rms_eps: float):
+    return _make(_finalize_norm_call(hidden, rms_eps))
+
+
+@cache
+def _finalize_sinkhorn(
+    hidden: int, k: int, rms_eps: float, hc_eps: float, iterations: int
+):
+    return _make(_finalize_sinkhorn_call(hidden, k, rms_eps, hc_eps, iterations))
+
+
+_ASYNC_SINKHORN_MAX_ROWS = 128
+_SINKHORN_STREAMS: dict[torch.device, torch.cuda.Stream] = {}
+_SINKHORN_FORK_EVENTS: dict[torch.device, torch.cuda.Event] = {}
+_SINKHORN_DONE_EVENTS: dict[torch.device, torch.cuda.Event] = {}
+_SINKHORN_PENDING: dict[torch.device, bool] = {}
+_SINKHORN_SCRATCH: dict[torch.device, dict[int, tuple[torch.Tensor, torch.Tensor]]] = {}
+_sinkhorn_state = threading.local()
+
+
+def _normalize_device(device: torch.device | None = None) -> torch.device:
+    if device is None:
+        return torch.device("cuda", torch.cuda.current_device())
+    if device.type == "cuda" and device.index is None:
+        return torch.device("cuda", torch.cuda.current_device())
+    return device
+
+
+def _sinkhorn_stream(device: torch.device) -> torch.cuda.Stream:
+    device = _normalize_device(device)
+    stream = _SINKHORN_STREAMS.get(device)
+    if stream is None:
+        from vllm.utils.torch_utils import aux_stream
+
+        shared = aux_stream()
+        if shared is not None and _normalize_device(shared.device) == device:
+            stream = shared
+        else:
+            try:
+                _, high_priority = torch.cuda.Stream.priority_range()
+                stream = torch.cuda.Stream(device=device, priority=high_priority)
+            except Exception:
+                stream = torch.cuda.Stream(device=device)
+        _SINKHORN_STREAMS[device] = stream
+    return stream
+
+
+def _sinkhorn_scratch(splits: int, tokens: int, device: torch.device) -> tuple[torch.Tensor, torch.Tensor]:
+    device = _normalize_device(device)
+    by_splits = _SINKHORN_SCRATCH.setdefault(device, {})
+    pair = by_splits.get(splits)
+    need_p = splits * tokens * MIXES
+    need_s = splits * tokens
+    if pair is None or pair[0].numel() < need_p or pair[1].numel() < need_s:
+        cap = max(tokens, _ASYNC_SINKHORN_MAX_ROWS)
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError(
+                f"mHC async Sinkhorn buffers for {tokens} rows must be pre-allocated before capture"
+            )
+        pair = (
+            torch.empty((splits * cap * MIXES,), dtype=torch.float32, device=device),
+            torch.empty((splits * cap,), dtype=torch.float32, device=device),
+        )
+        by_splits[splits] = pair
+    return (
+        pair[0][:need_p].view(splits, tokens, 1, MIXES),
+        pair[1][:need_s].view(splits, tokens, 1),
+    )
+
+
+def _async_sinkhorn_active() -> bool:
+    return getattr(_sinkhorn_state, "depth", 0) > 0
+
+
+def _sinkhorn_events(
+    device: torch.device,
+) -> tuple[torch.cuda.Event, torch.cuda.Event]:
+    device = _normalize_device(device)
+    fork_ev = _SINKHORN_FORK_EVENTS.get(device)
+    done_ev = _SINKHORN_DONE_EVENTS.get(device)
+    if fork_ev is None or done_ev is None:
+        with torch.cuda.device(device):
+            fork_ev = torch.cuda.Event()
+            done_ev = torch.cuda.Event()
+        _SINKHORN_FORK_EVENTS[device] = fork_ev
+        _SINKHORN_DONE_EVENTS[device] = done_ev
+    return fork_ev, done_ev
+
+
+@contextlib.contextmanager
+def async_sinkhorn(enabled: bool = True):
+    """Run Sinkhorn on a dedicated side stream across enclosed mHC entry calls."""
+    if not enabled:
+        yield
+        return
+    _sinkhorn_state.depth = getattr(_sinkhorn_state, "depth", 0) + 1
+    try:
+        yield
+    finally:
+        _sinkhorn_state.depth -= 1
+        if _sinkhorn_state.depth == 0:
+            for dev, pending in list(_SINKHORN_PENDING.items()):
+                if pending:
+                    wait_sinkhorn(dev)
+
+
+def wait_sinkhorn(device: torch.device | None = None) -> None:
+    """Join any pending async Sinkhorn launch onto the current CUDA stream."""
+    if device is None and not torch.cuda.is_available():
+        return
+    device = _normalize_device(device)
+    if not _SINKHORN_PENDING.get(device, False):
+        return
+    done_ev = _SINKHORN_DONE_EVENTS.get(device)
+    if done_ev is not None:
+        torch.cuda.current_stream(device).wait_event(done_ev)
+    _SINKHORN_PENDING[device] = False
+
+
+
+@cache
+def _post(hidden: int, world: int = 1):
+    return _make(_post_call(hidden, world))
+
+
+@cache
+def _post_collapse(hidden: int, world: int = 1):
+    return _make(_post_collapse_call(hidden, world))
+
+
+@cache
+def _post_collapse_norm(hidden: int, eps: float, world: int = 1, column: int = -1):
+    return _make(_post_collapse_norm_call(hidden, eps, world, column))
+
+
+@cache
+def _collapse(hidden: int, column: int = -1):
+    return _make(_collapse_call(hidden, column))
+
+
+def _mhc_pre(
+    residual: torch.Tensor,
+    fn: torch.Tensor,
+    scale: torch.Tensor,
+    base: torch.Tensor,
+    norm: torch.Tensor,
+    pre: torch.Tensor,
+    residual_out: torch.Tensor | None,
+    y: torch.Tensor,
+    y_q: torch.Tensor,
+    y_sf: torch.Tensor,
+    post: torch.Tensor,
+    comb: torch.Tensor,
+    pre_out: torch.Tensor,
+    rms_eps: float,
+    hc_eps: float,
+    iterations: int,
+    previous_output: torch.Tensor | None = None,
+    previous_post: torch.Tensor | None = None,
+    previous_comb: torch.Tensor | None = None,
+    aux_out: torch.Tensor | None = None,
+) -> None:
+    tokens, hidden = int(residual.shape[0]), int(residual.shape[-1])
+    if tokens == 0:
+        return
+    if residual.is_cuda:
+        wait_sinkhorn(residual.device)
+    streams = MULT * hidden
+    world = 1
+    with_aux = aux_out is not None
+    # Unused operands of a mode take a buffer of the right shape; none is read.
+    if previous_output is not None:
+        # (T, H), or the ranks' unreduced partials of it, (world, T, H).
+        if previous_output.ndim == 3:
+            world = int(previous_output.shape[0])
+        mode, x, k = "post_pre", previous_output, streams
+        source, updated = residual.view(tokens, streams), residual_out
+        mix_post, mix_comb = previous_post, previous_comb
+    elif residual.ndim == 2:
+        mode, x, k = "broadcast", residual, hidden
+        source, updated = residual_out.view(tokens, streams), residual_out
+        mix_post, mix_comb = pre, comb
+    else:
+        mode, x, k = "pre", y, streams
+        source = residual.view(tokens, streams)
+        updated, mix_post, mix_comb = source, pre, comb
+    splits = hidden // BLOCK_H
+    use_async = (
+        _async_sinkhorn_active()
+        and residual.is_cuda
+        and tokens <= _ASYNC_SINKHORN_MAX_ROWS
+    )
+    if use_async:
+        P, S = _sinkhorn_scratch(splits, tokens, residual.device)
+        scratch = current_workspace_manager().get_simultaneous(
+            ((tokens, hidden), torch.bfloat16),
+            ((splits, tokens), torch.float32),
+        )
+        retain_cuda_graph_capture_resource(scratch)
+        C, Q = scratch
+    else:
+        scratch = current_workspace_manager().get_simultaneous(
+            ((splits, tokens, 1, MIXES), torch.float32),
+            ((splits, tokens, 1), torch.float32),
+            ((tokens, hidden), torch.bfloat16),
+            ((splits, tokens), torch.float32),
+        )
+        retain_cuda_graph_capture_resource(scratch)
+        P, S, C, Q = scratch
+    aux_args = (aux_out.view(tokens, hidden),) if with_aux else ()
+    _project(hidden, mode, world, with_aux)(
+        x if x.ndim == 3 else x.unsqueeze(0),
+        source,
+        mix_post,
+        mix_comb,
+        pre,
+        fn,
+        updated.view(tokens, streams),
+        P,
+        S,
+        C,
+        Q,
+        *aux_args,
+    )
+    if use_async:
+        if not torch.cuda.is_current_stream_capturing():
+            logger.info_once(
+                "[mhc] async Sinkhorn split active (max_rows=%d)",
+                _ASYNC_SINKHORN_MAX_ROWS,
+            )
+        sh_stream = _sinkhorn_stream(residual.device)
+        cur_stream = torch.cuda.current_stream(residual.device)
+        fork_ev, done_ev = _sinkhorn_events(residual.device)
+        fork_ev.record(cur_stream)
+        sh_stream.wait_event(fork_ev)
+        for tensor in (P, S, post, comb, pre_out):
+            tensor.record_stream(sh_stream)
+        with torch.cuda.stream(sh_stream):
+            _finalize_sinkhorn(hidden, k, rms_eps, hc_eps, iterations)(
+                P, S, scale, base, post, comb, pre_out
+            )
+            done_ev.record(sh_stream)
+        _SINKHORN_PENDING[_normalize_device(residual.device)] = True
+        _finalize_norm(hidden, rms_eps)(C, Q, norm, y, y_q, y_sf)
+    else:
+        _finalize(hidden, k, rms_eps, hc_eps, iterations)(
+            P, S, C, Q, scale, base, norm, post, comb, pre_out, y, y_q, y_sf
+        )
+
+
+def _mhc_post(
+    x: torch.Tensor,
+    residual: torch.Tensor,
+    post: torch.Tensor,
+    comb: torch.Tensor,
+    out: torch.Tensor,
+) -> None:
+    tokens, hidden = int(residual.shape[0]), int(residual.shape[-1])
+    if tokens == 0:
+        return
+    if residual.is_cuda:
+        wait_sinkhorn(residual.device)
+    world = int(x.shape[0]) if x.ndim == 3 else 1
+    _post(hidden, world)(
+        (
+            x
+            if x.shape == (world, tokens, hidden)
+            else x.view(world, tokens, hidden)
+        )
+        if world > 1
+        else x.view(tokens, hidden),
+        residual.view(tokens, MULT, hidden),
+        post.view(tokens, MULT),
+        comb.view(tokens, MULT, MULT),
+        out.view(tokens, MULT, hidden),
+    )
+
+
+def _mhc_post_collapse(
+    x: torch.Tensor,
+    residual: torch.Tensor,
+    post: torch.Tensor,
+    comb: torch.Tensor,
+    mix: torch.Tensor,
+    out: torch.Tensor,
+) -> None:
+    tokens, hidden = int(residual.shape[0]), int(residual.shape[-1])
+    if tokens == 0:
+        return
+    if residual.is_cuda:
+        wait_sinkhorn(residual.device)
+    world = int(x.shape[0]) if x.ndim == 3 else 1
+    _post_collapse(hidden, world)(
+        x.view(world, tokens, hidden) if world > 1 else x.view(tokens, hidden),
+        residual.view(tokens, MULT, hidden),
+        post.view(tokens, MULT),
+        comb.view(tokens, MULT, MULT),
+        mix.view(tokens, MULT),
+        out.view(tokens, hidden),
+    )
+
+
+def _mhc_post_collapse_norm(
+    x: torch.Tensor,
+    residual: torch.Tensor,
+    post: torch.Tensor,
+    comb: torch.Tensor,
+    mix: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    out: torch.Tensor,
+    columns: torch.Tensor | None = None,
+    column: int = -1,
+) -> None:
+    tokens, hidden = int(residual.shape[0]), int(residual.shape[-1])
+    if tokens == 0:
+        return
+    if residual.is_cuda:
+        wait_sinkhorn(residual.device)
+    world = int(x.shape[0]) if x.ndim == 3 else 1
+    x_in = x.view(world, tokens, hidden) if world > 1 else x.view(1, tokens, hidden)
+    col_arg = column if columns is not None else -1
+    extra = (columns.view(tokens, MULT),) if columns is not None else ()
+    _post_collapse_norm(hidden, eps, world, col_arg)(
+        x_in,
+        residual.view(tokens, MULT, hidden),
+        post.view(tokens, MULT),
+        comb.view(tokens, MULT, MULT),
+        mix.view(tokens, MULT),
+        weight.view(hidden),
+        out.view(tokens, hidden),
+        *extra,
+    )
+
+
+def _mhc_collapse(state: torch.Tensor, mix: torch.Tensor, out: torch.Tensor) -> None:
+    tokens, hidden = int(state.shape[0]), int(state.shape[-1])
+    if tokens == 0:
+        return
+    if state.is_cuda:
+        wait_sinkhorn(state.device)
+    _collapse(hidden)(
+        state.view(tokens, MULT, hidden),
+        mix.view(tokens, MULT),
+        out.view(tokens, hidden),
+    )
+
+
+def _mhc_collapse_column(
+    state: torch.Tensor,
+    mix: torch.Tensor,
+    out: torch.Tensor,
+    columns: torch.Tensor,
+    column: int,
+) -> None:
+    tokens, hidden = int(state.shape[0]), int(state.shape[-1])
+    if tokens == 0:
+        return
+    if state.is_cuda:
+        wait_sinkhorn(state.device)
+    _collapse(hidden, column)(
+        state.view(tokens, MULT, hidden),
+        mix.view(tokens, MULT),
+        out.view(tokens, hidden),
+        columns.view(tokens, MULT),
+    )
+
+
+# Every layer's constant mixes, by device: (first sublayer's pre-mix, the collapse's
+# mean), and every earlier, shorter pair (a captured graph may still read one).
+_MIXES: dict[torch.device, list[tuple[torch.Tensor, torch.Tensor]]] = {}
+
+
+def _constant_mixes(
+    tokens: int, device: torch.device
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """``tokens`` rows of the first sublayer's pre-mix (stream 0 alone) and of the
+    collapse's mean, slices of buffers every layer shares. torch would otherwise fill
+    them inside every forward (five kernels a target step: the first layer's zeros and
+    fill, and the three auxiliary collapses' fills). The layers build them for the
+    batch limit before CUDA graph capture (``declare_kernels``' bind); a longer batch
+    outside capture (a kernel test) grows them."""
+    built = _MIXES.setdefault(device, [])
+    if not built or built[-1][0].shape[0] < tokens:
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError(
+                f"mHC constant mixes of {tokens} rows must be built before capture"
+            )
+        first = torch.zeros((tokens, MULT), dtype=torch.float32, device=device)
+        first[:, 0] = 1
+        mean = torch.full((tokens, MULT), 0.25, dtype=torch.float32, device=device)
+        built.append((first, mean))
+    first, mean = built[-1]
+    return first[:tokens], mean[:tokens]
+
+
+class TileKernelsMHC(nn.Module):
+    """V4.1 lagged mHC for a decoder layer: pre, post_pre, post and collapse."""
+
+    supports_fused_aux = True
+    supports_async_sinkhorn = True
+
+    def __init__(self, config):
+        super().__init__()
+        if config.hc_mult != MULT:
+            raise ValueError("V4.1 mHC requires four streams")
+        self.hidden_size = config.hidden_size
+        self.rms_eps = config.rms_norm_eps
+        self.hc_eps = config.hc_eps
+        self.iterations = config.hc_sinkhorn_iters
+
+    @staticmethod
+    def _post_worlds() -> tuple[int, ...]:
+        """The world sizes that ``post``, ``post_collapse`` and ``post_collapse_norm``
+        can launch."""
+        if sp_prefill.unreduced_enabled():
+            tp_world = get_tensor_model_parallel_world_size()
+            if tp_world > 1:
+                return (1, tp_world)
+        return (1,)
+
+    def _entries(self) -> list[tuple[str, int]]:
+        """The (mode, world) of every sublayer entry this layer can launch."""
+        entries = [(mode, 1) for mode in ("pre", "post_pre", "broadcast")]
+        if sp_prefill.unreduced_enabled():
+            # Sequence-parallel steps hand post_pre the ranks' unreduced parts.
+            entries.append(("post_pre", get_tensor_model_parallel_world_size()))
+        return entries
+
+    def declare_kernels(self) -> None:
+        """Declare every sublayer entry's kernels, the standalone post and the stream
+        collapse, so that no forward (or CUDA graph capture) compiles."""
+        hidden = self.hidden_size
+        entries = self._entries()
+        post_worlds = self._post_worlds()
+        # The broadcast entry projects one stream; the others all four.
+        widths = (hidden, MULT * hidden)
+        mix = (self.rms_eps, self.hc_eps, self.iterations)
+
+        def calls() -> list[prepare.TileLangCall]:
+            return [
+                *(_project_call(hidden, mode, world) for mode, world in entries),
+                *(
+                    _project_call(hidden, mode, world, with_aux=True)
+                    for mode, world in entries
+                    if mode == "post_pre"
+                ),
+                *(_finalize_call(hidden, k, *mix) for k in widths),
+                _finalize_norm_call(hidden, self.rms_eps),
+                *(_finalize_sinkhorn_call(hidden, k, *mix) for k in widths),
+                *(_post_call(hidden, w) for w in post_worlds),
+                _collapse_call(hidden),
+                *(_post_collapse_call(hidden, w) for w in post_worlds),
+                *(
+                    _post_collapse_norm_call(hidden, self.rms_eps, w)
+                    for w in post_worlds
+                ),
+            ]
+
+        def bind() -> None:
+            # The forward's cached kernels, as its lookups name them.
+            for mode, world in entries:
+                _project(hidden, mode, world)
+                if mode == "post_pre":
+                    _project(hidden, mode, world, True)
+            for k in widths:
+                _finalize(hidden, k, *mix)
+                _finalize_sinkhorn(hidden, k, *mix)
+            _finalize_norm(hidden, self.rms_eps)
+            for w in post_worlds:
+                _post(hidden, w)
+                _post_collapse(hidden, w)
+                _post_collapse_norm(hidden, self.rms_eps, w)
+            _collapse(hidden)
+            device = torch.device("cuda", torch.cuda.current_device())
+            # The constant mixes, before any graph captures.
+            _constant_mixes(
+                get_current_vllm_config().scheduler_config.max_num_batched_tokens,
+                device,
+            )
+            _sinkhorn_stream(device)
+            _sinkhorn_events(device)
+            _sinkhorn_scratch(hidden // BLOCK_H, _ASYNC_SINKHORN_MAX_ROWS, device)
+
+        prepare.declare(calls, bind=bind)
+
+    def pre(
+        self,
+        residual,
+        fn,
+        scale,
+        base,
+        norm,
+        pre,
+        *,
+        previous_output=None,
+        previous_post=None,
+        previous_comb=None,
+        aux_out: torch.Tensor | None = None,
+    ):
+        """A sublayer entry: ``(streams, post-mix, combination, y, new pre-mix,
+        y_mxfp8)``. ``y`` is the sublayer's normalized input and ``y_mxfp8`` its MXFP8
+        cast (``linear.MXFP8Rows``), which the sublayer's block-32 projections read."""
+        tokens, device = int(residual.shape[0]), residual.device
+        if isinstance(previous_output, RankOrderParts):
+            # Added inside the projection kernel, in rank order.
+            previous_output = previous_output.packed
+        if pre is None:
+            pre = _constant_mixes(tokens, device)[0]
+        unchanged = previous_output is None and residual.ndim == 3
+        residual_out = (
+            None
+            if unchanged
+            else torch.empty(
+                (tokens, MULT, self.hidden_size), dtype=residual.dtype, device=device
+            )
+        )
+        y = torch.empty((tokens, self.hidden_size), dtype=residual.dtype, device=device)
+        y_mxfp8 = empty_mxfp8(y)
+        post = torch.empty((tokens, MULT), dtype=torch.float32, device=device)
+        comb = torch.empty((tokens, MULT, MULT), dtype=torch.float32, device=device)
+        pre_out = torch.empty((tokens, MULT), dtype=torch.float32, device=device)
+        _mhc_pre(
+            residual,
+            fn,
+            scale,
+            base,
+            norm,
+            pre,
+            residual_out,
+            y,
+            y_mxfp8.values,
+            y_mxfp8.scales,
+            post,
+            comb,
+            pre_out,
+            self.rms_eps,
+            self.hc_eps,
+            self.iterations,
+            previous_output,
+            previous_post,
+            previous_comb,
+            aux_out,
+        )
+        return residual if unchanged else residual_out, post, comb, y, pre_out, y_mxfp8
+
+    def post_pre(
+        self,
+        x,
+        residual,
+        post,
+        comb,
+        fn,
+        scale,
+        base,
+        norm,
+        pre,
+        *,
+        aux_out: torch.Tensor | None = None,
+    ):
+        return self.pre(
+            residual,
+            fn,
+            scale,
+            base,
+            norm,
+            pre,
+            previous_output=x,
+            previous_post=post,
+            previous_comb=comb,
+            aux_out=aux_out,
+        )
+
+    def post(self, x, residual, post, comb):
+        if isinstance(x, RankOrderParts):
+            x = x.packed
+        out = torch.empty_like(residual)
+        _mhc_post(x, residual, post, comb, out)
+        return out
+
+    def post_collapse(
+        self,
+        x,
+        residual,
+        post,
+        comb,
+        pre: torch.Tensor | None = None,
+        out: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        """The standalone ``post`` followed by ``collapse`` with ``pre`` (or the
+        streams' mean when ``pre`` is None), into ``out`` when given, in one launch
+        without materializing the ``[tokens, MULT, hidden]`` stream buffer."""
+        if isinstance(x, RankOrderParts):
+            x = x.packed
+        tokens, device = int(residual.shape[0]), residual.device
+        if pre is None:
+            pre = _constant_mixes(tokens, device)[1]
+        if out is None:
+            out = torch.empty(
+                (tokens, self.hidden_size),
+                dtype=residual.dtype,
+                device=device,
+            )
+        _mhc_post_collapse(x, residual, post, comb, pre, out)
+        return out
+
+    def post_collapse_norm(
+        self,
+        x,
+        residual,
+        post,
+        comb,
+        pre: torch.Tensor | None,
+        weight: torch.Tensor,
+        eps: float | None = None,
+        *,
+        columns: torch.Tensor | None = None,
+        column: int = -1,
+        out: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        """The standalone ``post`` followed by ``collapse`` (with optional sink
+        detector ``column`` extraction) and ``RMSNorm`` with ``weight`` in one launch."""
+        if isinstance(x, RankOrderParts):
+            x = x.packed
+        tokens, device = int(residual.shape[0]), residual.device
+        if pre is None:
+            pre = _constant_mixes(tokens, device)[1]
+        if out is None:
+            out = torch.empty(
+                (tokens, self.hidden_size),
+                dtype=residual.dtype,
+                device=device,
+            )
+        norm_eps = self.rms_eps if eps is None else eps
+        _mhc_post_collapse_norm(
+            x,
+            residual,
+            post,
+            comb,
+            pre,
+            weight,
+            norm_eps,
+            out,
+            columns=columns,
+            column=column,
+        )
+        return out
+
+    @staticmethod
+    def cast_rows(rows: torch.Tensor) -> MXFP8Rows:
+        """The MXFP8 cast of rows regrouped from an entry's ``y`` (a CED boundary's
+        compact rows, prefill SP's gathered rows), for the projections that read it."""
+        return cast_mxfp8(rows)
+
+    def collapse(
+        self,
+        state: torch.Tensor,
+        pre: torch.Tensor | None = None,
+        columns: torch.Tensor | None = None,
+        column: int = -1,
+        out: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        """The streams' weighted sum with ``pre``, or their mean, into ``out``
+        (contiguous [tokens, hidden]) when given; with ``columns`` ([tokens, MULT]
+        FP32), also each stream's ``column``, in the same launch."""
+        if pre is None:
+            pre = _constant_mixes(int(state.shape[0]), state.device)[1]
+        if out is None:
+            out = torch.empty(
+                (state.shape[0], state.shape[-1]),
+                dtype=state.dtype,
+                device=state.device,
+            )
+        if columns is None:
+            _mhc_collapse(state, pre, out)
+        else:
+            _mhc_collapse_column(state, pre, out, columns, column)
+        return out
+
+    @classmethod
+    def collapse_column_calls(
+        cls, hidden: int, column: int, rms_eps: float | None = None
+    ) -> list:
+        """The declared calls of ``collapse`` and ``post_collapse_norm`` with
+        ``columns`` for ``column``."""
+        calls = [_collapse_call(hidden, column)]
+        if rms_eps is not None:
+            calls.extend(
+                _post_collapse_norm_call(hidden, rms_eps, w, column)
+                for w in cls._post_worlds()
+            )
+        return calls
+
+
+__all__ = [
+    "TileKernelsMHC",
+    "async_sinkhorn",
+    "wait_sinkhorn",
+    "collapse_streams",
+    "finalize",
+    "post_collapse_norm_streams",
+    "post_collapse_streams",
+    "post_streams",
+    "project_streams",
+]
