+            else:
+                for h, d in T.Parallel(block_H, D):
+                    if h0 + h < heads:
+                        Output[row, h0 + h, d] = 0
+
+    @T.macro
+    def decode_body(
+        Q,
+        SwaRecords,
+        SwaIndices,
+        SwaLengths,
+        IdxRecords,
+        IdxIndices,
+        IdxLengths,
+        IdxPageTable,
+        Sinks,
+        Positions,
+        CosSin,
+        Partial,
+        PartialStats,
