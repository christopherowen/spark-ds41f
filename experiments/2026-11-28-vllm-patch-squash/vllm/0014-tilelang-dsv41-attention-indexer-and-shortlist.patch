+def indexer_topk_gather32_v41(
+    width: int,
+    topk: int = INDEX_TOPK,
+    group: int = 1,
+    super_size: int = _BLOCKMAX_BLOCK,
+    threads: int = _TOPK_THREADS,
+):
+    """Exact single-pass top-``topk`` gathered from ``topk`` ``super_size``-position blocks.
+
