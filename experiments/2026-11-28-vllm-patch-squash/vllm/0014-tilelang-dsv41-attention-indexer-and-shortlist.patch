+                        tilelang.cdiv(T.max(IdxLengths[row], 0), G * BI),
+                        segments - (swa_blocks // G),
+                    )
+                    active_end = T.min(active_segs * G, chunks)
+                else:
+                    active_segs = segments
+                    active_end = chunks
+                for seg in T.serial(active_segs):
+                    clear_segment(acc_g, m_g, l_g)
+                    for c in T.serial(G):
+                        chunk = seg * G + c
+                        if chunk < chunks:
+                            T.ptx_wait_group(0)
+                            T.sync_threads()
+                            dequant_chunk(
+                                chunk,
+                                staged_swa,
+                                staged_swa_fp8,
+                                staged_idx_fp8,
+                                staged_idx_fp4,
+                                KV_shared,
+                            )
+                            T.sync_threads()
+                            # The next chunk's records load while this chunk computes.
+                            if chunk + 1 < active_end:
+                                stage_chunk(
+                                    SwaRecords,
+                                    IdxRecords,
+                                    chunk + 1,
+                                    slots,
+                                    (chunk + 1) * BI,
+                                    staged_swa,
+                                    staged_idx,
+                                    copy_slot,
+                                )
+                            chunk_update(
+                                Q_shared,
+                                KV_shared,
+                                slots,
+                                chunk * BI,
+                                P_shared,
+                                acc_s,
+                                acc_g,
+                                m_g,
+                                l_g,
+                                m_prev,
+                                alpha,
+                                row_sum,
+                            )
+                    # Fold the segment into the running state, as the decode merge does,
+                    # in the form no constant can change (see FOLD below).
+                    for h in T.Parallel(block_H):
+                        m_new = T.max(M[h], m_g[h])
+                        a[h] = T.exp2(M[h] - m_new)
+                        b[h] = T.exp2(m_g[h] - m_new)
+                        L[h] = T.fma(l_g[h], b[h], T.fmul(L[h], a[h]))
+                        M[h] = m_new
+                    for h, d in T.Parallel(block_H, D):
+                        acc_o[h, d] = T.fma(acc_g[h, d], b[h], T.fmul(acc_o[h, d], a[h]))
