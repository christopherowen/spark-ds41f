+                    SwaRecords,
+                    SwaIndices,
+                    SwaLengths,
+                    IdxRecords,
+                    IdxIndices,
+                    IdxLengths,
+                    IdxPageTable,
+                    Sinks,
+                    Positions,
+                    CosSin,
+                    Output,
+                )
+
