+            l_g = T.alloc_fragment([block_H], accum_dtype)
+            m_prev = T.alloc_fragment([block_H], accum_dtype)
+            alpha = T.alloc_fragment([block_H], accum_dtype)
+            row_sum = T.alloc_fragment([block_H], accum_dtype)
