+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Base shortlist plan interface for page-summary indexers."""
+
+
+class PageShortlistPlan:
+    """Buffer-free serving plan base class; caller owns all scratch."""
+
+    def scratch_specs(self, rows):
+        return tuple(self._specs(rows).values())
diff --git a/vllm/models/deepseek_v4_1/tilelang/query_reuse.py b/vllm/models/deepseek_v4_1/tilelang/query_reuse.py
new file mode 100644
index 0000000000000000000000000000000000000000..2efe4b468a0816966b0c7ea153fcd31f160b03eb
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/tilelang/query_reuse.py
@@ -0,0 +1,153 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Single shared-memory store per mean element; identical score arithmetic."""
+import math
+
+import tilelang
+import tilelang.language as T
+import torch
+
+from vllm.models.deepseek_v4_1.tilelang import pdl, prepare
+from vllm.models.deepseek_v4_1.tilelang.block_shortlist import (
+    STATE_BYTES,
+    BlockMeanShortlistPlan,
+    block_candidates,
+)
+from vllm.models.deepseek_v4_1.tilelang.coarse_merge import DirectCoarseTopK
+from vllm.models.deepseek_v4_1.tilelang.indexer import (
+    CANDIDATE_BLOCK,
+    CANDIDATE_BLOCKS,
+    IndexerTopK,
+    IndexerV41Plan,
+)
+from vllm.models.deepseek_v4_1.tilelang.raw_wide_coarse import RawWideCoarseTopK
+from vllm.models.deepseek_v4_1.tilelang.shortlist_indexer import decode, remap_blocks
+
+
+@tilelang.jit
+def prepared_scores(width: int, page: int, budget: int, block_c: int = 64):
+    rows,pool_pages,stride = T.dynamic('rows, pool_pages, stride')
+    n = width//8
+    ctas = min(tilelang.cdiv(n,block_c),128)
+
+    @T.prim_func
+    def score(Q: T.Tensor([rows,32,128],T.bfloat16), Scale: T.Tensor([rows,32,4],T.uint8),
+              Weight: T.Tensor([rows,32],T.bfloat16),
+              Pool: T.StridedTensor([pool_pages,page//8,128],[stride,128,1],T.float8_e4m3fn),
+              Table: T.Tensor([rows,width//page],T.int32), Length: T.Tensor([rows],T.int32),
+              Active: T.Tensor([1],T.int32), Score: T.Tensor([rows,n],T.bfloat16),
+              Count: T.Tensor([rows],T.int32)):
+        with T.Kernel(ctas,rows,threads=128) as (cta,row):
+            pdl.chain()
+            a = T.alloc_shared([block_c,128],T.bfloat16)
+            b = T.alloc_shared([32,128],T.bfloat16)
+            acc = T.alloc_fragment([block_c,32],T.float32)
+            terms = T.alloc_shared([block_c,32],T.float32)
+            total = T.alloc_fragment([block_c],T.float32)
+            extent = T.min(T.max(Length[row],0),T.max(T.min(Active[0],width),0))
+            full = extent//page*(page//8)
+            count = T.if_then_else(full <= budget,0,full)
+            if (cta == 0) & (T.get_thread_binding() == 0):
+                Count[row] = count
+            if cta*block_c < count:
+                T.copy(Q[row,0:32,0:128],b)
+                for iteration in T.serial(T.ceildiv(T.max(T.ceildiv(count,block_c)-cta,0),ctas)):
+                    start = (cta+iteration*ctas)*block_c
+                    for part in T.serial(block_c//(page//8)):
+                        first = start+part*(page//8)
+                        if first < count:
+                            physical = Table[row,first//(page//8)]
+                            for c,d in T.Parallel(page//8,128):
+                                a[part*(page//8)+c,d] = T.cast(Pool[physical,c,d],T.bfloat16)
+                        else:
+                            for c,d in T.Parallel(page//8,128):
+                                a[part*(page//8)+c,d] = 0
+                    T.gemm(a,b,acc,transpose_B=True,clear_accum=True)
+                    for c,h in T.Parallel(block_c,32):
+                        dot = T.max(T.cast(T.cast(acc[c,h],T.bfloat16),T.float32),0.)
+                        terms[c,h] = T.cast(T.cast(T.fmul(dot,T.cast(Weight[row,h],T.float32)),T.bfloat16),T.float32)
+                    T.sync_threads()
+                    T.fill(total,0.)
+                    for h in T.serial(32):
+                        for c in T.Parallel(block_c):total[c] += terms[c,h]
+                    for c in T.Parallel(block_c):
+                        if start+c < count:Score[row,start+c] = T.cast(total[c],T.bfloat16)
+    return score
+
+
+@tilelang.jit
+def prepare_queries(width:int,page:int,budget:int):
+    rows = T.dynamic('rows')
+    @T.prim_func
+    def unpack(Q:T.Tensor([rows,32,64],T.uint8),Scale:T.Tensor([rows,32,4],T.uint8),
+               Length:T.Tensor([rows],T.int32),Active:T.Tensor([1],T.int32),
+               Decoded:T.Tensor([rows,32,128],T.bfloat16)):
+        with T.Kernel(rows,threads=128) as row:
+            pdl.chain()
+            extent = T.min(T.max(Length[row],0),T.max(T.min(Active[0],width),0))
+            if extent//page*(page//8) > budget:
+                for h,d in T.Parallel(32,128):
+                    Decoded[row,h,d] = T.cast(decode(Q[row,h,d//2],Scale[row,h,d//32],d),T.bfloat16)
+    return unpack
+
+
+class QueryReusePlan(BlockMeanShortlistPlan):
+    def __init__(self,width,page,*,candidate_blocks=False,budget=None,row_cap=256):
+        self.width,self.page,self.source,self.row_cap = width,page,candidate_blocks,row_cap
+        self.budget = budget or (512 if candidate_blocks else 64)
+        self.block_budget = self.budget*8
+        self.capacity = (self.budget+8)*64
+        self.coarse = (RawWideCoarseTopK(width//8) if self.block_budget == 8192 and width//8 > 8192
+                       else DirectCoarseTopK(width//8) if self.block_budget == 4096 and width//8 > 4096
+                       else IndexerTopK(width//8,self.block_budget))
+        self.assemble = block_candidates(width,page,self.block_budget)
+        self.final = IndexerV41Plan(self.capacity,page,candidates=True)
+        if self.source:
+            self.select_blocks = IndexerTopK(self.capacity,CANDIDATE_BLOCKS,CANDIDATE_BLOCK)
+            self.remap = remap_blocks(self.capacity)
+        self.unpack = prepare_queries(width,page,self.block_budget)
+        self.prepared_score = prepared_scores(width,page,self.block_budget)
+
+    def _specs(self,rows):
+        specs = super()._specs(rows)
+        specs['prepared_q'] = ((min(rows,self.row_cap),32,128),torch.bfloat16)
+        return specs
+
+    @staticmethod
+    def calls(width,page,*,candidate_blocks=False,budget=None,row_cap=256):
+        b = budget or (512 if candidate_blocks else 64)
+        parent = BlockMeanShortlistPlan.calls(width,page,candidate_blocks=candidate_blocks,budget=budget,row_cap=row_cap)
+        return [prepare.call(prepare_queries,width,page,b*8),
+                prepare.call(prepared_scores,width,page,b*8),*parent[1:]]
+
+    def run(self,q,scales,weights,pool,table,lengths,active,candidates=None,candidate_lengths=None,
+            *,out=None,candidate_out=None,candidate_out_lengths=None,scratch=None):
+        if candidates is not None or candidate_lengths is not None:
+            raise ValueError('block summaries cannot consume reindex candidates')
+        if out is None or scratch is None:raise ValueError('outputs and scratch must be admitted')
+        if self.source and (candidate_out is None or candidate_out_lengths is None):
+            raise ValueError('source handoff outputs are required')
+        rows = len(q)
+        specs = self._specs(rows)
+        if len(scratch) != len(specs):raise ValueError('workspace differs from admission')
+        full = dict(zip(specs,scratch))
+        def buffers(name,plan,b):return [b[f'{name}_{i}'] for i in range(len(plan.scratch_specs(1)))]
+        for start in range(0,rows,self.row_cap):
+            end = min(start+self.row_cap,rows)
+            r = end-start
+            current = self._specs(r)
+            b = {name:t.view(-1)[:math.prod(current[name][0])].view(current[name][0]) for name,t in full.items()}
+            qr,sr,wr,tr,lr = q[start:end],scales[start:end],weights[start:end],table[start:end],lengths[start:end]
+            self.unpack(qr.view(torch.uint8),sr.view(torch.uint8).reshape(r,32,4),lr,active,b['prepared_q'])
+            means = pool.view(torch.float8_e4m3fn)[:,self.page*68:self.page*STATE_BYTES].view(len(pool),self.page//8,128)
+            self.prepared_score(b['prepared_q'],sr.view(torch.uint8).reshape(r,32,4),wr,
+                                means,tr,lr,active,b['scores'],b['counts'])
+            self.coarse.run(b['scores'],b['counts'],active,b['selected'],b['values'],scratch=buffers('coarse',self.coarse,b))
+            self.assemble(b['selected'],lr,active,b['candidates'],b['candidate_lengths'])
+            _,scores = self.final.run(qr,sr,wr,pool,tr,lr,active,b['candidates'],b['candidate_lengths'],
+                                     out=out[start:end],scratch=buffers('final',self.final,b))
+            if self.source:
+                self.select_blocks.run(scores,b['candidate_lengths'],active,b['compact'],b['block_values'],
+                                       counts=candidate_out_lengths[start:end],scratch=buffers('blocks',self.select_blocks,b))
+                self.remap(b['compact'],b['candidates'],candidate_out[start:end])
+        return out,None
diff --git a/vllm/models/deepseek_v4_1/tilelang/raw_wide_coarse.py b/vllm/models/deepseek_v4_1/tilelang/raw_wide_coarse.py
new file mode 100644
index 0000000000000000000000000000000000000000..d1472c2e90cc7da909d18badb279a333216f0d60
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/tilelang/raw_wide_coarse.py
@@ -0,0 +1,141 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Exact top8192 from raw16384-entry tiles; eliminate two select-all stages."""
+import tilelang
+import tilelang.language as T
+import torch
+from . import prepare,pdl
+from .indexer import IndexerTopK,_make,_row_extent,_key16,_value16,_select_macros,_final_writer
+
+@tilelang.jit(pass_configs={tilelang.PassConfigKey.TL_DISABLE_THREAD_STORAGE_SYNC:True})
+def raw_wide_pair(width:int):
+    rows=T.dynamic('rows')
+    topk,threads=8192,512
+    span=2*topk;per=span//threads;steps=threads.bit_length()-1
+    groups=tilelang.cdiv(width,span);final=groups==1
+    threshold,_=_select_macros(threads,topk)
+    _,write_empty=_final_writer(threads,topk,1)
+    @T.macro
+    def block_scan(values, tx):
+        carry = T.alloc_var(T.int32)
+        for s in T.serial(steps):
+            off = 1 << s
+            carry = T.if_then_else(tx >= off, values[T.max(tx-off, 0)], 0)
+            T.sync_threads()
+            values[tx] += carry
+            T.sync_threads()
+
+
+    @T.macro
+    def body(Scores,Lengths,Active,Indices,Values):
+        with T.Kernel(groups,rows,threads=threads) as (g,row):
+            pdl.chain()
+            tx=T.get_thread_binding()
+            keys=T.alloc_shared([span],T.int32)
+            hist=T.alloc_shared([257],T.int32)
+            scan=T.alloc_shared([threads],T.int32)
+            params=T.alloc_shared([4],T.int32)
+            extent=_row_extent(Lengths,Active,row,width)
+            base=g*span
+            if base<extent:
+                for i in T.serial(per):
+                    j=i*threads+tx
+                    keys[j]=T.if_then_else(base+j<extent,
+                        _key16(Scores[row,T.min(base+j,width-1)]),0)
+                T.sync_threads()
+                threshold(keys,span,tx,hist,scan,params)
+                key = T.alloc_var(T.int32)
+                n_gt = T.alloc_var(T.int32)
+                n_eq = T.alloc_var(T.int32)
+                sel_eq = T.alloc_var(T.int32)
+                out_pos = T.alloc_var(T.int32)
+                taken = T.alloc_var(T.int32)
+                thr = T.alloc_var(T.int32)
+                need = T.alloc_var(T.int32)
+                thr = params[0]
+                need = params[1]
+                n_gt = 0
+                n_eq = 0
+                for v in T.serial(per):
+                    key = keys[tx*per+v]
+                    if key > thr:
+                        n_gt += 1
+                    elif key == thr:
+                        n_eq += 1
+                scan[tx] = n_eq
+                T.sync_threads()
+                block_scan(scan, tx)
+                sel_eq = T.max(T.min(need-(scan[tx]-n_eq), n_eq), 0)
+                T.sync_threads()
+                scan[tx] = n_gt+sel_eq
+                T.sync_threads()
+                block_scan(scan, tx)
+                out_pos = scan[tx]-n_gt-sel_eq
+                taken = 0
+                # Emit each winner once, retaining input entry order and ties.
+                # The output arrays replace two topk-sized shared staging arrays.
+                for v in T.serial(per):
+                    key = keys[tx*per+v]
+                    if (key > thr) | ((key == thr) & (taken < sel_eq)):
+                        if key == thr:
+                            taken += 1
+                        Values[row, g*topk+out_pos] = _value16(key)
+                        Indices[row, g*topk+out_pos] = base+tx*per+v
+                        out_pos += 1
+                T.sync_threads()
+                total = scan[threads-1]
+                for i in T.serial(T.ceildiv(topk, threads)):
+                    slot = i*threads+tx
+                    if (slot < topk) & (slot >= total):
+                        Values[row, g*topk+slot] = -T.infinity(T.bfloat16)
+                        Indices[row, g*topk+slot] = -1
+
+            elif final:
+                write_empty(Indices,Values,None,row)
+
+    @T.prim_func
+    def run(Scores:T.Tensor([rows,width],T.bfloat16),Lengths:T.Tensor([rows],T.int32),
+            Active:T.Tensor([1],T.int32),Indices:T.Tensor([rows,groups*topk],T.int32),
+            Values:T.Tensor([rows,groups*topk],T.bfloat16)):
+        body(Scores,Lengths,Active,Indices,Values)
+    return run
+
+class RawWideCoarseTopK:
+    """Raw tiles replace the all-entry segment pass and first two merges exactly."""
+    def __init__(self,width):
+        self.width=width
+        self.topk=8192
+        self.groups=tilelang.cdiv(width,16384)
+        segments,first,levels=IndexerTopK.routes(width,self.topk)
+        assert segments>=3 and self.groups==levels[1][2]
+        self.raw=raw_wide_pair(width)
+        self.levels=[(_make(kernel),lists,out) for kernel,lists,out in levels[2:]]
+
+    @staticmethod
+    def calls(width):
+        _,_,levels=IndexerTopK.routes(width,8192)
+        return [prepare.call(raw_wide_pair,width),*(kernel for kernel,_,_ in levels[2:])]
+
+    def scratch_specs(self,rows):
+        if self.groups==1:return ()
+        widest=(self.groups*8192,self.levels[0][2]*8192)
+        return tuple(((rows*cols,),dtype) for cols in widest for dtype in (torch.bfloat16,torch.int32))
+
+    def run(self,scores,lengths,active,indices,values,*,scratch=None):
+        rows=len(scores)
+        if self.groups==1:
+            self.raw(scores,lengths,active,indices,values)
+            return indices
+        specs=self.scratch_specs(rows)
+        if scratch is None:scratch=[torch.empty(shape,dtype=dtype,device='cuda') for shape,dtype in specs]
+        assert len(scratch)==4
+        buffers=((scratch[0],scratch[1]),(scratch[2],scratch[3]))
+        def views(buffer,lists):
+            return tuple(t[:rows*lists*8192].view(rows,lists*8192) for t in buffer)
+        first=views(buffers[0],self.groups)
+        self.raw(scores,lengths,active,first[1],first[0])
+        for level,(kernel,lists,outputs) in enumerate(self.levels):
+            work=views(buffers[level%2],lists)
+            if outputs==1:kernel(*work,lengths,active,indices,values)
+            else:kernel(*work,lengths,active,*views(buffers[(level+1)%2],outputs))
+        return indices
