-
-    def forward(self, x, workspace, *, out):
-        rows = x.shape[0]
-        gate_up = self.w1(x, out=workspace.gate_up[:rows])
-        activated = hyperconnection.run_swiglu(
-            gate_up,
-            limit=float("inf"),
-            round_silu=True,
-            out=workspace.activated[:rows],
-            plan=workspace.swiglu_plan,
-        )
