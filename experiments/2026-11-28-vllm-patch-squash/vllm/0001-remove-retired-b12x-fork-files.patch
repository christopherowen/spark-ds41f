-class _MLP(nn.Module):
-    def __init__(self, config):
-        super().__init__()
-        self.w1 = _Linear(
-            config.vision_dim,
-            2 * config.vision_inter_dim,
-            False,
-            max_rows=_capacity(config),
-        )
-        self.w2 = _Linear(
-            config.vision_inter_dim,
-            config.vision_dim,
-            False,
-            max_rows=_capacity(config),
