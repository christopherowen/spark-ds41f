-    def forward(self, x, height, width, workspace, *, out):
-        rows = x.shape[0]
-        qkv = self.wqkv(x, out=workspace.qkv[:rows])
-        run_rope_qkv(
-            qkv,
-            height,
-            width,
-            workspace.inv_freq,
-            q=workspace.q,
