-            collapse_requests.append(
-                self._collapse_plans[weighted].request(
-                    name=f"deepseek_v41.mhc.{id(layer):x}.collapse.weighted{int(weighted)}",
-                    prepare_call=prepare_collapse,
-                )
-            )
-        return (
-            B12xPreparationUnit(
-                name="V41MHC",
-                key=(id(layer), self.hidden_size, key),
