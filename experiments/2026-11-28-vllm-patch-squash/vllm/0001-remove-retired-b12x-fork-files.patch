-                    layer.hc_attn_scale,
-                    layer.hc_ffn_scale,
-                    layer.hc_attn_base,
-                    layer.hc_ffn_base,
-                    layer.attn_norm.weight,
-                    layer.ffn_norm.weight,
-                ),
-            )
-
-        return prepare
-
-    def pre(
-        self,
-        residual,
-        fn,
