+@pytest.mark.parametrize("out_dtype", [torch.bfloat16, torch.float32])
+def test_packed_head_greedy_pairs_multi_exception_and_zero_exception(out_dtype):
+    from vllm.v1.worker.gpu.spec_decode.greedy_verification import vocab_parallel_pairs
+
+    n, k = 1024, 512
+    weight = (torch.rand(n, k, device=DEVICE) * 0.5 + 0.5).bfloat16()
+    # Zero-exception layer first
+    zero_layer = _packed_layer(weight)
+    assert int(zero_layer.weight_row_offsets[-1].item()) == 0
+    prepare_packed_head(zero_layer, out_dtype)
+    x = (torch.randn(19, k, device=DEVICE) * 0.5).bfloat16()
+    for rows in (1, 6, 16, 19):
+        part = x[:rows].contiguous()
+        expected = vocab_parallel_pairs(
+            project_head(zero_layer, part), n, 0, tp_size=1
+        )
+        actual = project_head_greedy_pairs(zero_layer, part, vocab=n, vocab_start=0)
+        assert torch.equal(actual[:, :2], expected[:, :2]), rows
+
+    # Multiple exceptions per row and on tile boundaries (0, 31, 32, 63)
+    weight[0, [3, 17, 129, 400]] = 1.0e30
+    weight[31, [5, 200, 511]] = 1.2e30
+    weight[32, [0, 64, 128]] = -1.5e-7
+    weight[63, [11, 255]] = 1.1e30
+    exc_layer = _packed_layer(weight)
+    assert int(exc_layer.weight_row_offsets[-1].item()) >= 12
+    prepare_packed_head(exc_layer, out_dtype)
+    for rows in (1, 6, 16, 19):
+        part = x[:rows].contiguous()
+        expected = vocab_parallel_pairs(
+            project_head(exc_layer, part), n, 1000, tp_size=1
+        )
+        actual = project_head_greedy_pairs(exc_layer, part, vocab=n, vocab_start=1000)
+        assert torch.equal(actual[:, :2], expected[:, :2]), rows
