    "set -eu\npython3 - <<'BUILD'\nimport hashlib,json,pathlib,shutil,subprocess,tarfile,time\narchive=pathlib.Path('/inputs/nixnan-inputs-v2.tar.gz');expected='fc369afbeeaa843c7dda7217d3f882a05cd30e5f0a4b0b06d8881bafe95df928';assert hashlib.sha256(archive.read_bytes()).hexdigest()==expected\ninputs=pathlib.Path('/tmp/nvbit-inputs');inputs.mkdir()\nwith tarfile.open(archive) as tar:tar.extractall(inputs,filter='data')\nprint('INPUT FILES',sorted(str(p.relative_to(inputs)) for p in inputs.rglob('*') if p.is_file()),flush=True)\nfor name in ['nixnan_build.py','nvbit_warp_control.cu','nixnan_inputs.json']:\n candidates=list(inputs.rglob(name));assert len(candidates)==1,(name,candidates);shutil.copyfile(candidates[0],'/out/'+name)\ninputs=list(inputs.rglob('nixnan_build.py'))[0].parent\npathlib.Path('/out/tools').mkdir();pathlib.Path('/out/build-logs').mkdir();results=[]\nfor tool in ['instr_count','instr_count_cuda_graph','nixnan','detector','analyzer']:\n output=pathlib.Path('/tmp/build-'+tool);argv=['python3',str(inputs/'nixnan_build.py'),'--inputs',str(inputs),'--output',str(output),'--tool',tool];start=time.monotonic()\n with open('/out/build-logs/'+tool+'.log','wb') as log:\n  try:r=subprocess.run(argv,stdout=log,stderr=subprocess.STDOUT,timeout=240);rc=r.returncode\n  except subprocess.TimeoutExpired:rc=124\n result={'tool':tool,'argv':argv,'exit_code':rc,'elapsed_seconds':time.monotonic()-start}\n if rc==0:\n  binary=output/(tool+'.so');dest=pathlib.Path('/out/tools')/binary.name;shutil.copyfile(binary,dest);result['binary_sha256']=hashlib.sha256(dest.read_bytes()).hexdigest()\n if tool=='instr_count':\n  for p in output.rglob('*'):\n   if p.is_file() and p.name.lower() in ('license','notice','license.txt','notice.txt','copying','copyright'):\n    dest=pathlib.Path('/out/licenses')/p.relative_to(output);dest.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(p,dest)\n results.append(result);pathlib.Path('/out/tool-results.json').write_text(json.dumps(results,indent=2));print(json.dumps(result),flush=True)\nargv=['nvcc','-std=c++17','-arch=sm_121','-O2','-lineinfo','/out/nvbit_warp_control.cu','-o','/out/nvbit-warp-control']\nwith open('/out/build-logs/control.log','wb') as log:r=subprocess.run(argv,stdout=log,stderr=subprocess.STDOUT,timeout=120)\nresults.append({'tool':'control-build','argv':argv,'exit_code':r.returncode});pathlib.Path('/out/tool-results.json').write_text(json.dumps(results,indent=2));print(json.dumps(results,indent=2))\nBUILD\n"
