    "-lc",
    "set -eu\nunset CUDA_LAUNCH_BLOCKING\n/opt/host-cuda/bin/ncu --version\npython3 - <<'JOB'\nimport json,pathlib,subprocess\nargv=['/opt/host-cuda/bin/ncu', '--set', 'basic', '--kernel-name', 'router_partials_kernel', '--launch-count', '1', '--target-processes', 'all', '--cache-control', 'none', '--clock-control', 'none', '--export', '/out/ncu-router', '--force-overwrite', 'python3', '-c', \"import hashlib,json,pathlib,sys,pytest\\ntry:\\n result=pytest.main(['--noconftest','-q','-rA',sys.argv[1]])\\nfinally:\\n files=[]\\n for name,module in sorted(sys.modules.items()):\\n  path=getattr(module,'__file__',None)\\n  if path and (name.startswith(('vllm.','tests.')) or name in ('torch','tilelang','pytest')):\\n   p=pathlib.Path(path)\\n   if p.is_file():files.append({'module':name,'path':str(p),'sha256':hashlib.sha256(p.read_bytes()).hexdigest()})\\n pathlib.Path('/out/imported-files.json').write_text(json.dumps(files,indent=2))\\nsys.exit(result)\\n\", 'tests/kernels/moe/test_deepseek_v41_tilelang_router.py::test_gate_router_matches_the_gate_then_the_router[17-384-6]']\nwith open('/out/ncu-router.stdout-stderr.log','wb') as out:r=subprocess.run(argv,stdout=out,stderr=subprocess.STDOUT,timeout=300)\nresult={'argv':argv,'exit_code':r.returncode}\nif pathlib.Path('/out/ncu-router.ncu-rep').exists():\n export=['/opt/host-cuda/bin/ncu','--import','/out/ncu-router.ncu-rep','--page','details','--csv']\n with open('/out/ncu-router-details.csv','wb') as out:e=subprocess.run(export,stdout=out,stderr=subprocess.STDOUT,timeout=30)\n result['export']={'argv':export,'exit_code':e.returncode}\npathlib.Path('/out/tool-results.json').write_text(json.dumps(result,indent=2));print(json.dumps(result,indent=2))\nJOB\n"
  ],
