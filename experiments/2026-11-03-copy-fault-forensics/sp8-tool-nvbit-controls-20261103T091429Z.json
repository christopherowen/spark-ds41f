    "-lc",
    "set -eu\nunset CUDA_LAUNCH_BLOCKING\npython3 - <<'RUN'\nimport hashlib,json,os,pathlib,subprocess,time\nbuilt=pathlib.Path('/built');hashes=json.loads((built/'sha256.json').read_text());binary=built/'nvbit-warp-control';assert hashlib.sha256(binary.read_bytes()).hexdigest()==hashes['nvbit-warp-control']\nresults=[]\ndef execute(tool,form,mode):\n work=pathlib.Path('/out')/(tool+'-'+form+'-'+mode);work.mkdir();argv=[str(binary),mode,form];env=dict(os.environ)\n if tool!='baseline':\n  so=built/'tools'/(tool+'.so');assert hashlib.sha256(so.read_bytes()).hexdigest()==hashes['tools/'+tool+'.so'];env.update(LD_PRELOAD=str(so),TOOL_VERBOSE='1',PRINT_ILL_INSTR='1',ENABLE_FUN_DETAIL='1',PROPAGATE='1',LINE_INFO='0')\n t=time.monotonic()\n with (work/'stdout-stderr.log').open('wb') as log:\n  try:r=subprocess.run(argv,cwd=work,env=env,stdout=log,stderr=subprocess.STDOUT,timeout=60);rc=r.returncode\n  except subprocess.TimeoutExpired:rc=124\n text=(work/'stdout-stderr.log').read_text(errors='replace');record={'tool':tool,'form':form,'mode':mode,'argv':argv,'cwd':str(work),'env_set':{k:env[k] for k in ('LD_PRELOAD','TOOL_VERBOSE','PRINT_ILL_INSTR','ENABLE_FUN_DETAIL','PROPAGATE','LINE_INFO') if k in env},'exit_code':rc,'elapsed_seconds':time.monotonic()-t,'correct_lanes_reported':'correct_lanes=32/32' in text}\n results.append(record);pathlib.Path('/out/tool-results.json').write_text(json.dumps(results,indent=2));print(json.dumps(record),flush=True);return rc\nfor tool in ['baseline','instr_count','instr_count_cuda_graph','detector','analyzer']:\n if tool!='baseline' and not (built/'tools'/(tool+'.so')).exists():continue\n failed_direct=False\n for form in ['direct','extended','capture','graph']:\n  for mode in ['clean','nan']:\n   rc=execute(tool,form,mode)\n   if rc:\n    if tool=='baseline':raise SystemExit('Uninstrumented control failed')\n    if form=='direct':failed_direct=True\n    break\n  if failed_direct:break\nRUN\n"
  ],
