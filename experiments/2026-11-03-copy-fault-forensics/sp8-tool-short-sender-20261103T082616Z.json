    "-lc",
    "set -eu\nunset CUDA_LAUNCH_BLOCKING\n/opt/host-cuda/compute-sanitizer/compute-sanitizer --version\nsha256sum /out/collective_short_sender.py\npython3 - <<'JOBS'\nimport json,os,pathlib,subprocess\nresults=[]\nfor case in ['equal-finite','short-finite','equal-int-tail','short-int-tail']:\n argv=['python3','/out/collective_short_sender.py','--case',case]\n with open('/out/'+case+'.stdout-stderr.log','wb') as out:r=subprocess.run(argv,stdout=out,stderr=subprocess.STDOUT,timeout=90)\n results.append({'case':case,'tool':'plain','argv':argv,'exit_code':r.returncode})\n if r.returncode:break\nif len(results)==4 and all(r['exit_code']==0 for r in results):\n argv=['/opt/host-cuda/compute-sanitizer/compute-sanitizer','--tool','memcheck','--target-processes','all','--error-exitcode','86','--log-file','/out/short-int-tail.memcheck.%p.log','python3','/out/collective_short_sender.py','--case','short-int-tail']\n with open('/out/short-int-tail.memcheck.stdout-stderr.log','wb') as out:r=subprocess.run(argv,env=dict(os.environ,PYTORCH_NO_CUDA_MEMORY_CACHING='1'),stdout=out,stderr=subprocess.STDOUT,timeout=180)\n results.append({'case':'short-int-tail','tool':'memcheck','argv':argv,'exit_code':r.returncode})\npathlib.Path('/out/tool-results.json').write_text(json.dumps(results,indent=2));print(json.dumps(results,indent=2))\nJOBS\n"
  ],
