    "-lc",
    "set -eu\nunset CUDA_LAUNCH_BLOCKING\n/opt/nsys/target-linux-sbsa-armv8/nsys --version\nnvcc --version\nnvcc -g -G -I/opt/nsys/target-linux-sbsa-armv8/nvtx/include -o /out/fault-control /out/tool-runner-fault-control.cu\nsha256sum /out/tool-runner-fault-control.cu /out/fault-control\npython3 - <<'JOBS'\nimport json,pathlib,subprocess\nnsys='/opt/nsys/target-linux-sbsa-armv8/nsys';results=[]\nfor mode in ['clean','nan']:\n prefix='/out/nsys-control-'+mode\n argv=[nsys,'profile','--trace=cuda,nvtx','--sample=none','--cuda-graph-trace=graph:host-only','--force-overwrite=true','--duration=30','--output='+prefix,'/out/fault-control',mode]\n with open(prefix+'.stdout-stderr.log','wb') as log:r=subprocess.run(argv,stdout=log,stderr=subprocess.STDOUT)\n result={'mode':mode,'argv':argv,'exit_code':r.returncode}\n if pathlib.Path(prefix+'.nsys-rep').exists():\n  export=[nsys,'export','--type=sqlite','--force-overwrite=true','--output='+prefix+'.sqlite',prefix+'.nsys-rep']\n  with open(prefix+'.export.log','wb') as log:e=subprocess.run(export,stdout=log,stderr=subprocess.STDOUT)\n  result['export']={'argv':export,'exit_code':e.returncode}\n results.append(result)\npathlib.Path('/out/tool-results.json').write_text(json.dumps(results,indent=2)+'\\n');print(json.dumps(results,indent=2))\nJOBS\n"
  ],
