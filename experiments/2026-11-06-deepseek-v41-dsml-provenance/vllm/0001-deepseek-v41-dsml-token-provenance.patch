+    assert len(plan) == 1
+    ids = plan + [THINK_END_ID] + marker_ids(tokenizer, CALL)
+    parser, request, prompt_ids = make_parser(tokenizer, True)
+    deltas = [("Pl", plan), (tokenizer.decode(ids)[2:], ids[1:])]
+    assert stream(parser, request, prompt_ids, deltas) == ("Plan", "", [CALC])
