new file mode 100644
index 000000000..80dc24c2b
--- /dev/null
+++ b/tests/parser/engine/test_deepseek_v41_dsml_provenance.py
@@ -0,0 +1,396 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""DeepSeek V4.1: DSML is structure only where its atom is the DSML token.
+
+The model writes structural markers with the ``｜DSML｜`` token and spells a
+quoted copy (a file about DSML, a code sample in a reply) in ordinary pieces.
+These tests pin that a quoted copy stays text: in string tool arguments and in
+reply content, streamed and whole. In the templates below ``G`` stands for the
+genuine DSML token; a literal ``｜DSML｜`` is spelled one character a token.
+"""
+
+import json
+
+import pytest
+
+from tests.parser.engine.replay_harness import (
+    MockTokenizer,
+    _test_request,
+    collect_output,
+    replay_streaming,
+)
+from vllm.parser.parser_manager import ParserManager
+
+ATOM = "｜DSML｜"
+ATOM_ID = 128825
+G = "\x00"
+
+WRITE_TOOLS = [
+    {
+        "type": "function",
+        "function": {
+            "name": "write",
+            "parameters": {
+                "type": "object",
+                "properties": {
+                    "path": {"type": "string"},
+                    "content": {"type": "string"},
+                },
+            },
+        },
+    }
+]
+WEATHER_TOOLS = [
+    {
+        "type": "function",
+        "function": {
+            "name": "get_weather",
+            "parameters": {
+                "type": "object",
+                "properties": {"city": {"type": "string"}},
+            },
+        },
+    }
+]
+
+
+def tokenize(template: str):
+    vocab = {ATOM: ATOM_ID, "<think>": 50, "</think>": 51}
+    tokens: list[tuple[int, str]] = []
+    for ch in template:
+        tokens.append((ATOM_ID, ATOM) if ch == G else (1000 + len(tokens), ch))
+    tokenizer = MockTokenizer(vocab, tokens)
+    # As in the real tokenizer, the DSML atom is an added token, not a special one.
+    tokenizer._special_ids = {50, 51}
+    tokenizer._all_special_tokens = ["<think>", "</think>"]
+    return tokenizer, tokens
+
+
+def write_call(*files: tuple[str, str]) -> str:
+    invokes = "\n".join(
+        f"<{G} invoke name=\"write\">\n"
+        f"<{G} parameter name=\"path\" string=\"true\">{path}</{G} parameter>\n"
+        f"<{G} parameter name=\"content\" string=\"true\">{content}</{G} parameter>\n"
+        f"</{G} invoke>"
+        for path, content in files
+    )
+    return f"<{G} calls>\n{invokes}\n</{G} calls>"
+
+
+def parser_for(tokenizer, thinking: bool = False):
+    cls = ParserManager.get_parser(
+        tool_parser_name="deepseek_v41",
+        reasoning_parser_name="deepseek_v41",
+        enable_auto_tools=True,
+    )
+    assert cls is not None
+    return cls(tokenizer, chat_template_kwargs={"thinking": thinking})
+
+
+def streamed(template, tools, chunk_size, thinking: bool = False):
+    tokenizer, tokens = tokenize(template)
+    return collect_output(
+        replay_streaming(
+            parser_for(tokenizer, thinking=thinking),
+            tokens,
+            chunk_size=chunk_size,
+            finished_on_last=True,
+            tools=tools,
+            prompt_token_ids=[50 if thinking else 51],
+        )
+    )
+
+
+def whole(template, tools, thinking: bool = False):
+    tokenizer, tokens = tokenize(template)
+    p = parser_for(tokenizer, thinking=thinking)
+    p.set_prompt_token_ids([50 if thinking else 51])
+    reasoning, content, calls = p.parse(
+        "".join(text for _, text in tokens),
+        _test_request(tools=tools),
+        enable_auto_tools=True,
+        model_output_token_ids=[tid for tid, _ in tokens],
+    )
+    return (
+        content or "",
+        [(call.name, json.loads(call.arguments)) for call in calls or []],
+    )
+
+
+QUOTED_VALUES = [
+    f"DSML closers:\n</{ATOM} parameter>\n</{ATOM} calls>",
+    f"TOOL_END = \"</{ATOM} calls>\"",
+    f"before </{ATOM} invoke> after",
+    f"<{ATOM} parameter name=\"x\" string=\"true\">not a parameter",
+    f"unclosed tag prefix: <{ATOM} parameter name=\"x\"",
+]
+
+
+@pytest.mark.parametrize("value", QUOTED_VALUES)
+@pytest.mark.parametrize("chunk_size", [1, 2, 3, 4, 5, 6, 10000])
+def test_quoted_dsml_in_string_value_survives_streaming(value, chunk_size):
+    output = streamed(write_call(("notes.md", value)), WRITE_TOOLS, chunk_size)
+    assert [json.loads(call["arguments"]) for call in output.tool_calls] == [
+        {"path": "notes.md", "content": value}
+    ]
+    assert ATOM not in output.content
+
+
+@pytest.mark.parametrize("value", QUOTED_VALUES)
+def test_quoted_dsml_in_string_value_survives_whole(value):
+    content, calls = whole(write_call(("notes.md", value)), WRITE_TOOLS)
+    assert calls == [("write", {"path": "notes.md", "content": value})]
+    assert ATOM not in content
+
+
+@pytest.mark.parametrize("chunk_size", [1, 5, 10000])
+def test_two_calls_first_value_quotes_block_closer(chunk_size):
+    quoted = f"end of block: </{ATOM} calls>"
+    template = write_call(("notes.md", quoted), ("two.md", "two"))
+    output = streamed(template, WRITE_TOOLS, chunk_size)
+    assert [json.loads(call["arguments"]) for call in output.tool_calls] == [
+        {"path": "notes.md", "content": quoted},
+        {"path": "two.md", "content": "two"},
+    ]
+    assert whole(template, WRITE_TOOLS)[1] == [
+        ("write", {"path": "notes.md", "content": quoted}),
+        ("write", {"path": "two.md", "content": "two"}),
+    ]
+
+
+@pytest.mark.parametrize("chunk_size", [1, 5, 10000])
+def test_genuine_call_unchanged(chunk_size):
+    template = write_call(("hello.md", "hello world"))
+    output = streamed(template, WRITE_TOOLS, chunk_size)
+    assert [json.loads(call["arguments"]) for call in output.tool_calls] == [
+        {"path": "hello.md", "content": "hello world"}
+    ]
+    assert whole(template, WRITE_TOOLS)[1] == [
+        ("write", {"path": "hello.md", "content": "hello world"})
+    ]
+
+
+@pytest.mark.parametrize("chunk_size", [1, 5, 10000])
+def test_untrusted_param_tag_after_closed_param_does_not_extend_value(chunk_size):
+    # A literal <｜DSML｜ parameter ...> after a closed parameter must not arm
+    # the incremental string-value extender and append into the closed value.
+    template = (
+        f"<{G} calls><{G} invoke name=\"write\">"
+        f"<{G} parameter name=\"path\" string=\"true\">abc</{G} parameter>"
+        f"<{ATOM} parameter name=\"content\" string=\"true\">x y z"
+        f"</{G} invoke></{G} calls>"
+    )
+    output = streamed(template, WRITE_TOOLS, chunk_size)
+    assert [json.loads(call["arguments"]) for call in output.tool_calls] == [
+        {"path": "abc"}
+    ]
+    assert whole(template, WRITE_TOOLS)[1] == [("write", {"path": "abc"})]
+
+
+@pytest.mark.parametrize("chunk_size", [1, 2, 5, 10000])
+def test_implicit_reasoning_end_splits_across_dsml_calls_tag(chunk_size):
+    # When reasoning ends implicitly at <｜DSML｜ calls> without </think>,
+    # splitting <, ｜DSML｜, and " calls>" across deltas must preserve token
+    # provenance across the reasoning-to-tool transition.
+    template = f"Plan first.{write_call(("hello.md", "hello world"))}"
+    output = streamed(template, WRITE_TOOLS, chunk_size, thinking=True)
+    assert output.reasoning == "Plan first."
+    assert [json.loads(call["arguments"]) for call in output.tool_calls] == [
+        {"path": "hello.md", "content": "hello world"}
+    ]
+
+
+def test_genuine_call_without_tools_kept_as_content():
+    # Without tools (or with tool_choice="none"), DSML markup is preserved as
+    # content rather than executed or dropped.
+    template = write_call(("hello.md", "hello world"))
+    expected = template.replace(G, ATOM)
+    content, calls = whole(template, None)
+    assert calls == []
+    assert content == expected
+    output = streamed(template, None, chunk_size=3)
+    assert output.tool_calls == []
+    assert output.content == expected
+
+
+SAMPLE = (
+    f"<{ATOM} calls>\n<{ATOM} invoke name=\"get_weather\">\n"
+    f"<{ATOM} parameter name=\"city\" string=\"true\">Boston</{ATOM} parameter>\n"
+    f"</{ATOM} invoke>\n</{ATOM} calls>"
+)
+QUOTING_REPLY = f"Here is the markup:\n\n```text\n{SAMPLE}\n```\n\nFINISHED"
+
+
+@pytest.mark.parametrize("tools", [WEATHER_TOOLS, None])
+@pytest.mark.parametrize("chunk_size", [1, 2, 3, 4, 5, 6, 10000])
+def test_reply_quoting_dsml_stays_content(tools, chunk_size):
+    output = streamed(QUOTING_REPLY, tools, chunk_size)
+    assert output.tool_calls == []
+    assert output.content == QUOTING_REPLY
+
+
+@pytest.mark.parametrize("tools", [WEATHER_TOOLS, None])
+def test_reply_quoting_dsml_stays_content_whole(tools):
+    content, calls = whole(QUOTING_REPLY, tools)
+    assert calls == []
+    assert content == QUOTING_REPLY
+
+
+@pytest.mark.parametrize("chunk_size", [1, 5, 10000])
+def test_content_before_multiline_tool_call_keeps_exact_whitespace(chunk_size):
+    # Formatting newlines between </｜DSML｜ invoke> and </｜DSML｜ calls> must
+    # not be appended to assistant content that preceded the tool block.
+    preamble = "I'll check that for you.\n\n"
+    template = preamble + write_call(("hello.md", "hello world"))
+    output = streamed(template, WRITE_TOOLS, chunk_size)
+    assert output.content == preamble
+    assert [json.loads(call["arguments"]) for call in output.tool_calls] == [
+        {"path": "hello.md", "content": "hello world"}
+    ]
+    assert whole(template, WRITE_TOOLS) == (
+        preamble,
+        [("write", {"path": "hello.md", "content": "hello world"})],
+    )
+
+
+@pytest.mark.parametrize("chunk_size", [1, 2, 3, 4, 5, 6, 10000])
+def test_mixed_json_and_string_params_quoting_dsml(chunk_size):
+    code_body = (
+        f"# parser test\n{SAMPLE}\n"
+        "<|DSML|function_calls>\n"
+        f"<{ATOM}function_calls>\n"
+    )
+    meta_json = json.dumps(
+        {"tags": [f"<{ATOM} calls>", f"</{ATOM} parameter>", "<|DSML|invoke>"]}
+    )
+    template = (
+        f"<{G} calls>\n<{G} invoke name=\"write\">\n"
+        f"<{G} parameter name=\"path\" string=\"true\">deepseek_v32_tool_parser.py</{G} parameter>\n"
+        f"<{G} parameter name=\"content\" string=\"true\">{code_body}</{G} parameter>\n"
+        f"<{G} parameter name=\"meta\" string=\"false\">{meta_json}</{G} parameter>\n"
+        f"<{G} parameter name=\"lines\">42</{G} parameter>\n"
+        f"</{G} invoke>\n</{G} calls>"
+    )
+    expected = {
+        "path": "deepseek_v32_tool_parser.py",
+        "content": code_body,
+        "meta": json.loads(meta_json),
+        "lines": 42,
+    }
+    output = streamed(template, WRITE_TOOLS, chunk_size)
+    assert [json.loads(call["arguments"]) for call in output.tool_calls] == [expected]
+    assert whole(template, WRITE_TOOLS) == ("", [("write", expected)])
+
+
+@pytest.mark.parametrize("chunk_size", [1, 3, 6, 10000])
+def test_tool_only_parser_preserves_provenance(chunk_size):
+    cls = ParserManager.get_parser(
+        tool_parser_name="deepseek_v41",
+        reasoning_parser_name=None,
+        enable_auto_tools=True,
+    )
+    assert cls is not None
+
+    # 1. Quoted DSML in assistant reply (#876) stays content in whole and streaming.
+    tokenizer, tokens = tokenize(QUOTING_REPLY)
+    parser = cls(tokenizer, WEATHER_TOOLS)
+    reasoning, content, calls = parser.parse(
+        "".join(text for _, text in tokens),
+        _test_request(tools=WEATHER_TOOLS),
+        enable_auto_tools=True,
+        model_output_token_ids=[tid for tid, _ in tokens],
+    )
+    assert reasoning is None and calls is None and content == QUOTING_REPLY
+    out = collect_output(
+        replay_streaming(
+            cls(tokenizer, WEATHER_TOOLS),
+            tokens,
+            chunk_size=chunk_size,
+            finished_on_last=True,
+            tools=WEATHER_TOOLS,
+        )
+    )
+    assert out.reasoning == "" and out.tool_calls == [] and out.content == QUOTING_REPLY
+
+    # 2. Quoted DSML inside string argument (#948) survives in whole and streaming.
+    call_tmpl = write_call(("notes.md", QUOTED_VALUES[0]))
+    tokenizer2, tokens2 = tokenize(call_tmpl)
+    parser2 = cls(tokenizer2, WRITE_TOOLS)
+    reasoning2, content2, calls2 = parser2.parse(
+        "".join(text for _, text in tokens2),
+        _test_request(tools=WRITE_TOOLS),
+        enable_auto_tools=True,
+        model_output_token_ids=[tid for tid, _ in tokens2],
+    )
+    assert reasoning2 is None and not content2
+    assert [(c.name, json.loads(c.arguments)) for c in calls2 or []] == [
+        ("write", {"path": "notes.md", "content": QUOTED_VALUES[0]})
+    ]
+    out2 = collect_output(
+        replay_streaming(
+            cls(tokenizer2, WRITE_TOOLS),
+            tokens2,
+            chunk_size=chunk_size,
+            finished_on_last=True,
+            tools=WRITE_TOOLS,
+        )
+    )
+    assert [json.loads(c["arguments"]) for c in out2.tool_calls] == [
+        {"path": "notes.md", "content": QUOTED_VALUES[0]}
+    ]
+
+    # 3. Genuine DSML call when request.tools is None stays content.
+    out_no_tools = collect_output(
+        replay_streaming(
+            cls(tokenizer2, None),
+            tokens2,
+            chunk_size=chunk_size,
+            finished_on_last=True,
+            tools=None,
+        )
+    )
+    assert out_no_tools.tool_calls == []
+    assert out_no_tools.content == call_tmpl.replace(G, ATOM)
+
+
+@pytest.mark.parametrize("chunk_size", [1, 3, 6, 10000])
+def test_reasoning_only_parser_preserves_provenance(chunk_size):
+    cls = ParserManager.get_parser(
+        tool_parser_name=None,
+        reasoning_parser_name="deepseek_v41",
+        enable_auto_tools=False,
+    )
+    assert cls is not None
+    vocab = {ATOM: ATOM_ID, "<think>": 50, "</think>": 51}
+    thought = f"Quoting </think> and <{ATOM} calls> in thought."
+    answer = "Final answer."
+    tokens: list[tuple[int, str]] = [
+        (1000 + i, ch) for i, ch in enumerate(thought)
+    ]
+    tokens.append((51, "</think>"))
+    tokens.extend((2000 + i, ch) for i, ch in enumerate(answer))
+    tokenizer = MockTokenizer(vocab, tokens)
+    tokenizer._special_ids = {50, 51}
+    tokenizer._all_special_tokens = ["<think>", "</think>"]
+
+    parser = cls(tokenizer, None, chat_template_kwargs={"thinking": True})
+    parser.set_prompt_token_ids([50])
+    reasoning, content, calls = parser.parse(
+        "".join(text for _, text in tokens),
+        _test_request(tools=None),
+        enable_auto_tools=False,
+        model_output_token_ids=[tid for tid, _ in tokens],
+    )
+    assert reasoning == thought and content == answer and calls is None
+
+    out = collect_output(
+        replay_streaming(
+            cls(tokenizer, None, chat_template_kwargs={"thinking": True}),
+            tokens,
+            chunk_size=chunk_size,
+            finished_on_last=True,
+            tools=None,
+            prompt_token_ids=[50],
+        )
+    )
+    assert out.reasoning == thought and out.content == answer and out.tool_calls == []
