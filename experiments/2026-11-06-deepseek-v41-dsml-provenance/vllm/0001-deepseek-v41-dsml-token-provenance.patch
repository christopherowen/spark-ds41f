@@ -0,0 +1,197 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""DeepSeek V4.1: DSML is structure only where its atom is the DSML token.
+
+The model writes structural markers with the ``｜DSML｜`` token and spells a
+quoted copy (a file about DSML, a code sample in a reply) in ordinary pieces.
+These tests pin that a quoted copy stays text: in string tool arguments and in
+reply content, streamed and whole. In the templates below ``G`` stands for the
+genuine DSML token; a literal ``｜DSML｜`` is spelled one character a token.
+"""
+
+import json
+
+import pytest
+
+from tests.parser.engine.replay_harness import (
+    MockTokenizer,
+    _test_request,
+    collect_output,
+    replay_streaming,
+)
+from vllm.parser.parser_manager import ParserManager
+
+ATOM = "｜DSML｜"
+ATOM_ID = 128825
+G = "\x00"
+
+WRITE_TOOLS = [
+    {
+        "type": "function",
+        "function": {
+            "name": "write",
+            "parameters": {
+                "type": "object",
+                "properties": {
+                    "path": {"type": "string"},
+                    "content": {"type": "string"},
+                },
+            },
+        },
+    }
+]
+WEATHER_TOOLS = [
+    {
+        "type": "function",
+        "function": {
+            "name": "get_weather",
+            "parameters": {
+                "type": "object",
+                "properties": {"city": {"type": "string"}},
+            },
+        },
+    }
+]
+
+
+def tokenize(template: str):
+    vocab = {ATOM: ATOM_ID, "<think>": 50, "</think>": 51}
+    tokens: list[tuple[int, str]] = []
+    for ch in template:
+        tokens.append((ATOM_ID, ATOM) if ch == G else (1000 + len(tokens), ch))
+    tokenizer = MockTokenizer(vocab, tokens)
+    # As in the real tokenizer, the DSML atom is an added token, not a special one.
+    tokenizer._special_ids = {50, 51}
+    tokenizer._all_special_tokens = ["<think>", "</think>"]
+    return tokenizer, tokens
+
+
+def write_call(*files: tuple[str, str]) -> str:
+    invokes = "\n".join(
+        f'<{G} invoke name="write">\n'
+        f'<{G} parameter name="path" string="true">{path}</{G} parameter>\n'
+        f'<{G} parameter name="content" string="true">{content}</{G} parameter>\n'
+        f"</{G} invoke>"
+        for path, content in files
+    )
+    return f"<{G} calls>\n{invokes}\n</{G} calls>"
+
+
+def parser_for(tokenizer):
+    cls = ParserManager.get_parser(
+        tool_parser_name="deepseek_v41",
+        reasoning_parser_name="deepseek_v41",
+        enable_auto_tools=True,
+    )
+    return cls(tokenizer, chat_template_kwargs={"thinking": False})
+
+
+def streamed(template, tools, chunk_size):
+    tokenizer, tokens = tokenize(template)
+    return collect_output(
+        replay_streaming(
+            parser_for(tokenizer),
+            tokens,
+            chunk_size=chunk_size,
+            finished_on_last=True,
+            tools=tools,
+            prompt_token_ids=[51],
+        )
+    )
+
+
+def whole(template, tools):
+    tokenizer, tokens = tokenize(template)
+    reasoning, content, calls = parser_for(tokenizer).parse(
+        "".join(text for _, text in tokens),
+        _test_request(tools=tools),
+        enable_auto_tools=True,
+        model_output_token_ids=[tid for tid, _ in tokens],
+    )
+    return (
+        content or "",
+        [(call.name, json.loads(call.arguments)) for call in calls or []],
+    )
+
+
+QUOTED_VALUES = [
+    f"DSML closers:\n</{ATOM} parameter>\n</{ATOM} calls>",
+    f'TOOL_END = "</{ATOM} calls>"',
+    f"before </{ATOM} invoke> after",
+    f'<{ATOM} parameter name="x" string="true">not a parameter',
+]
+
+
+@pytest.mark.parametrize("value", QUOTED_VALUES)
+@pytest.mark.parametrize("chunk_size", [1, 5, 10000])
+def test_quoted_dsml_in_string_value_survives_streaming(value, chunk_size):
+    output = streamed(write_call(("notes.md", value)), WRITE_TOOLS, chunk_size)
+    assert [json.loads(call["arguments"]) for call in output.tool_calls] == [
+        {"path": "notes.md", "content": value}
+    ]
+    assert ATOM not in output.content
+
+
+@pytest.mark.parametrize("value", QUOTED_VALUES)
+def test_quoted_dsml_in_string_value_survives_whole(value):
+    content, calls = whole(write_call(("notes.md", value)), WRITE_TOOLS)
+    assert calls == [("write", {"path": "notes.md", "content": value})]
+    assert ATOM not in content
+
+
+@pytest.mark.parametrize("chunk_size", [1, 5, 10000])
+def test_two_calls_first_value_quotes_block_closer(chunk_size):
+    quoted = f"end of block: </{ATOM} calls>"
+    template = write_call(("notes.md", quoted), ("two.md", "two"))
+    output = streamed(template, WRITE_TOOLS, chunk_size)
+    assert [json.loads(call["arguments"]) for call in output.tool_calls] == [
+        {"path": "notes.md", "content": quoted},
+        {"path": "two.md", "content": "two"},
+    ]
+    assert whole(template, WRITE_TOOLS)[1] == [
+        ("write", {"path": "notes.md", "content": quoted}),
+        ("write", {"path": "two.md", "content": "two"}),
+    ]
+
+
+@pytest.mark.parametrize("chunk_size", [1, 5, 10000])
+def test_genuine_call_unchanged(chunk_size):
+    template = write_call(("hello.md", "hello world"))
+    output = streamed(template, WRITE_TOOLS, chunk_size)
+    assert [json.loads(call["arguments"]) for call in output.tool_calls] == [
+        {"path": "hello.md", "content": "hello world"}
+    ]
+    assert whole(template, WRITE_TOOLS)[1] == [
+        ("write", {"path": "hello.md", "content": "hello world"})
+    ]
+
+
+def test_genuine_call_without_tools_still_returns_no_calls_whole():
+    # No tools means tool_choice "none": a genuine call's markup is dropped
+    # from the content and no call is returned, as before.
+    content, calls = whole(write_call(("hello.md", "hello world")), None)
+    assert calls == []
+    assert ATOM not in content
+
+
+SAMPLE = (
+    f"<{ATOM} calls>\n<{ATOM} invoke name=\"get_weather\">\n"
+    f'<{ATOM} parameter name="city" string="true">Boston</{ATOM} parameter>\n'
+    f"</{ATOM} invoke>\n</{ATOM} calls>"
+)
+QUOTING_REPLY = f"Here is the markup:\n\n```text\n{SAMPLE}\n```\n\nFINISHED"
+
+
+@pytest.mark.parametrize("tools", [WEATHER_TOOLS, None])
+@pytest.mark.parametrize("chunk_size", [1, 5, 10000])
+def test_reply_quoting_dsml_stays_content(tools, chunk_size):
+    output = streamed(QUOTING_REPLY, tools, chunk_size)
+    assert output.tool_calls == []
+    assert output.content == QUOTING_REPLY
+
+
+@pytest.mark.parametrize("tools", [WEATHER_TOOLS, None])
+def test_reply_quoting_dsml_stays_content_whole(tools):
+    content, calls = whole(QUOTING_REPLY, tools)
+    assert calls == []
+    assert content == QUOTING_REPLY
diff --git a/tests/parser/engine/test_token_id_scanner.py b/tests/parser/engine/test_token_id_scanner.py
index 8723ac282..f02f0a315 100644
--- a/tests/parser/engine/test_token_id_scanner.py
+++ b/tests/parser/engine/test_token_id_scanner.py
@@ -409,6 +409,128 @@ _QUOTE_TID = 104
 _TOK = list(range(200, 215))
 
 
+@pytest.fixture
+def strict_tokenizer():
+    from tokenizers import Tokenizer, decoders, models
+    from transformers import TokenizersBackend
+
+    class CountingTokenizer(TokenizersBackend):
+        decoded_ids = 0
+
+        def decode(self, token_ids, *args, **kwargs):
+            self.decoded_ids += len(token_ids)
+            return super().decode(token_ids, *args, **kwargs)
+
+    backend = Tokenizer(
+        models.WordLevel(
+            {"a": 0, "<bos>": 1, "<call>": 2, "ÿ": 3, "b": 4}, unk_token="a"
+        )
+    )
+    backend.decoder = decoders.ByteLevel()
+    return CountingTokenizer(
+        tokenizer_object=backend,
+        bos_token="<bos>",
+        additional_special_tokens=["<call>"],
+    )
+
+
+@pytest.mark.parametrize("bos_text", ["<bos>", ""])
+def test_strict_scanner_distinguishes_delayed_and_omitted_drop(
+    strict_tokenizer, bos_text
+):
+    """A delayed or skipped BOS must not hide the following trusted terminal."""
+    scanner = TokenIDScanner(
+        {1: DROP_TERMINAL, 2: "TOOL_START"},
+        strict_tokenizer,
+        strict_token_spans=True,
+    )
+    assert scanner.scan("", [1, 2, 0]) == []
+    assert scanner.scan(bos_text[:3], []) == []
+    items = list(scanner.scan(bos_text[3:] + "<call>a", []))
+    items.extend(scanner.flush_pending())
+
+    assert [item.terminal for item in items if isinstance(item, PreLexedTerminal)] == (
+        [DROP_TERMINAL, "TOOL_START"] if bos_text else ["TOOL_START"]
+    )
+    assert "".join(item.text for item in items if isinstance(item, TextChunk)) == "a"
+    assert not scanner.has_pending
+
+
+def test_strict_scanner_delayed_text_has_linear_decode_work(strict_tokenizer):
+    """Releasing a held-back tail must not repeatedly decode all pending IDs."""
+    scanner = TokenIDScanner({}, strict_tokenizer, strict_token_spans=True)
+    token_count = 200
+    items: list[TextChunk | PreLexedTerminal] = []
+    for _ in range(token_count):
+        items.extend(scanner.scan("", [0]))
+    for _ in range(token_count):
+        items.extend(scanner.scan("a", []))
+    items.extend(scanner.flush_pending())
+
+    assert "".join(item.text for item in items) == "a" * token_count
+    assert not scanner.has_pending
+    assert strict_tokenizer.decoded_ids <= 3 * token_count
+
+
+@pytest.mark.parametrize("with_terminal", [False, True])
+def test_strict_scanner_reuses_decode_work_for_aligned_runs(
+    strict_tokenizer, with_terminal
+):
+    """Measure decode work, not timing, on full runs and repeated one-token runs."""
+    scanner = TokenIDScanner(
+        {2: "TOOL_START"}, strict_tokenizer, strict_token_spans=True
+    )
+    ids = [0, 2] if with_terminal else [0, 0]
+    text = "a<call>" if with_terminal else "aa"
+    expected = (
+        [TextChunk("a", token_count=1), PreLexedTerminal("TOOL_START", 2, "<call>")]
+        if with_terminal
+        else [TextChunk("aa", token_count=2)]
+    )
+    for _ in range(32):
+        assert scanner.scan(text, ids) == expected
+    assert not scanner.has_pending
+    assert strict_tokenizer.decoded_ids <= 2
+
+
+def test_composite_terminal_variant_without_atom_stays_content():
+    """A variant lacking its required token atom must fail closed, not crash."""
+    from vllm.parser.engine.incremental_lexer import (
+        CONTENT_TERMINAL,
+        IncrementalLexer,
+        LexToken,
+        terminals_from_literals,
+    )
+
+    atom = "｜DSML｜"
+    trusted = f"<{atom} parameter"
+    lexer = IncrementalLexer(
+        terminals_from_literals({"PARAM_START": (trusted, "parameter")}),
+        token_id_guards={"PARAM_START": atom},
+    )
+    lexer.require_token_ids = True
+    assert lexer.feed("parameter") == [LexToken(CONTENT_TERMINAL, "parameter")]
+    spans = ((1, 1 + len(atom)),)
+    assert lexer.feed(trusted, token_id_spans=spans) == [
+        LexToken("PARAM_START", trusted, token_id_spans=spans)
+    ]
+
+
+def test_strict_scanner_invalid_utf8_does_not_hide_held_back_tokens(strict_tokenizer):
+    """U+FFFD expansion must not make a held-back prefix look byte-aligned."""
+    scanner = TokenIDScanner(
+        {2: "TOOL_START"}, strict_tokenizer, strict_token_spans=True
+    )
+    # ByteLevel piece ÿ represents byte 0xFF; its replacement takes three bytes.
+    assert strict_tokenizer.decode([3, 0, 4]) == "\ufffdab"
+    assert scanner.scan("\ufffd", [3, 0, 4]) == [TextChunk("\ufffd", token_count=1)]
+    assert scanner.scan("ab<call>", [2]) == [
+        TextChunk("ab", token_count=2),
+        PreLexedTerminal("TOOL_START", 2, "<call>"),
+    ]
+    assert not scanner.has_pending
+
+
 def _gemma4_vocab() -> dict[str, int]:
     return {
         _CHANNEL_START_TAG: _CHANNEL_START_TID,
