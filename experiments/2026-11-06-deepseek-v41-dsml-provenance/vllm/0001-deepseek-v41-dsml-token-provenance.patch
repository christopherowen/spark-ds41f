+    middle = text_ids(tokenizer, "note " + INVOKE)
+    last = marker_ids(tokenizer, CALL)
+    ids = first + middle + last
+    cuts = [len(first) + len(text_ids(tokenizer, "note <")), len(ids) - 3, len(ids)]
+    text, deltas, start = tokenizer.decode(ids), [], 0
+    for cut in cuts:
