{
  "experiment": "experiments/2026-11-03-candidate-38-reproduction",
  "run": "candidate-38-loop-reproduction",
  "jobs": [
    {
      "kind": "sync"
    },
    {
      "kind": "measure",
      "profile": "lean",
      "bench": false,
      "arms": [
        {
          "config": "arm-loop.json",
          "label": "candidate38-loop-boot1",
          "startup_memory": true
        },
        {
          "config": "arm-loop.json",
          "label": "candidate38-loop-boot2",
          "startup_memory": true
        }
      ],
      "extras": [
        [
          "loop_probe.py",
          [
            "--run",
            "{run}",
            "--label",
            "{label}",
            "--request-timeout",
            "600"
          ],
          "loop"
        ],
        [
          "collect_runtime.py",
          [
            "--config",
            "experiments/2026-11-03-candidate-38-reproduction/arm-loop.json",
            "--run",
            "{run}",
            "--label",
            "{label}"
          ],
          "runtime"
        ]
      ]
    }
  ]
}
