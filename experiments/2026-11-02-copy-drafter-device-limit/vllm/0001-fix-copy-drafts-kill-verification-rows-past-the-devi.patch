diff --git a/tests/v1/spec_decode/test_copy_drafts.py b/tests/v1/spec_decode/test_copy_drafts.py
index f25ee920f..c28ec738a 100644
--- a/tests/v1/spec_decode/test_copy_drafts.py
+++ b/tests/v1/spec_decode/test_copy_drafts.py
@@ -918,3 +918,227 @@ def test_stale_wide_allocation_rejects_placeholder_tail_and_doubles_cap_without_
     drafter._limits_event = InFlightEvent()  # type: ignore[assignment]
     limits = drafter.sync_slot_draft_limits()
     assert limits.shape == (MAX_REQS,)
+
+
+class _InFlightEvent:
+    """A limit copy that has not landed: the host keeps the previous limits."""
+
+    def query(self) -> bool:
+        return False
+
+    def synchronize(self) -> None:
+        raise AssertionError("sync_slot_draft_limits must not block on GPU")
+
+
+def _manager(monkeypatch, states, drafter, *, device_limits, tau):
+    """The runner's adaptive verification manager beside ``drafter``: the host
+    budget reads its non-blocking limits, the draft combine (with
+    ``device_limits``) its device ones. One rank."""
+    from types import SimpleNamespace
+
+    from vllm.v1.worker.gpu.spec_decode import adaptive_verification as adaptive
+
+    monkeypatch.setattr(adaptive, "get_tp_group", lambda: SimpleNamespace(world_size=1))
+    manager = adaptive.AdaptiveVerificationManager(
+        states,
+        torch.zeros(MAX_REQS + 1, dtype=torch.int32, device=DEVICE),
+        num_bonus_tokens=1,
+        max_total_logits=4096,
+        row_cost=0.035,
+        planned_confidences=True,
+        num_draft_steps=BLOCK,
+        slot_draft_limits=drafter.sync_slot_draft_limits,
+        device_draft_limits=drafter.slot_draft_limits.gpu if device_limits else None,
+    )
+    manager.dead_rows_tau = tau
+    return manager
+
+
+def _propose(states, drafter, managers, idx, num_sampled, verified):
+    """A copy proposal as the runner makes it after a step: the allocation and
+    device limits, the drafts into the request state, and the confidences
+    published twice, so the host budget reads this proposal's planned ones."""
+    from types import SimpleNamespace
+
+    dspark_drafts = torch.zeros((1, BLOCK), dtype=torch.int64, device=DEVICE)
+    dspark_conf = torch.full((1, BLOCK), 0.5, device=DEVICE)
+    drafter.prepare_alloc(idx, num_sampled, verified, None)
+    drafts, confidences, planned = drafter.propose(
+        idx, dspark_drafts, dspark_conf, num_sampled, verified, None, matched=True
+    )
+    states.draft_tokens[idx] = drafts
+    batch = SimpleNamespace(num_reqs=1, idx_mapping=idx)
+    for manager in managers:
+        for _ in range(2):
+            manager.record_confidences(confidences, batch, planned=planned)
+    return drafts[0].tolist()
+
+
+def _verify_step(states, manager, idx, scheduled):
+    """One verification step as the runner prepares it: the host budget over
+    ``scheduled`` scheduler placeholders, the device's allocation of it, the draft
+    combine with the manager's dead rows, and the commit count of a target that
+    takes every row's input as its next token."""
+    from types import SimpleNamespace
+
+    from vllm.v1.worker.gpu.input_batch import (
+        combine_sampled_and_draft_tokens,
+        get_num_sampled_and_rejected,
+    )
+
+    num_tokens = manager.get_num_tokens({"req": 1 + scheduled}, {"req": [-1] * scheduled})
+    eligible = manager._batch_budget[0]["req"]
+    cu_num_logits, query_start_loc, budget, _, _ = manager.reallocate_drafts(
+        ["req"], idx
+    )
+    num_logits = 1 + budget
+    prefill = int(states.prefill_len.np[int(idx[0])])
+    seq_lens = torch.tensor([prefill + num_tokens], dtype=torch.int32, device=DEVICE)
+    input_ids = torch.full((num_tokens,), -7, dtype=torch.int32, device=DEVICE)
+    is_padding = torch.zeros(num_tokens, dtype=torch.bool, device=DEVICE)
+    dead_rows = manager.dead_row_args(is_padding, 1)
+    logits_indices = combine_sampled_and_draft_tokens(
+        input_ids, idx, states.last_sampled_tokens, query_start_loc[:2], seq_lens,
+        states.prefill_len.gpu, states.draft_tokens, cu_num_logits, num_logits, 1,
+        dead_rows=dead_rows,
+    )  # fmt: skip
+    cut = None if dead_rows is None else dead_rows.cut
+    committed, _ = get_num_sampled_and_rejected(
+        torch.full((1,), num_logits, dtype=torch.int32, device=DEVICE),
+        seq_lens,
+        cu_num_logits,
+        idx,
+        states.prefill_len.gpu,
+        dead_row_cut=cut,
+    )
+    torch.accelerator.synchronize()
+    return SimpleNamespace(
+        eligible=eligible,
+        rows=num_tokens,
+        input_ids=input_ids.tolist(),
+        is_padding=is_padding.tolist(),
+        logits_indices=logits_indices.tolist(),
+        cu_num_logits=cu_num_logits.tolist(),
+        cut=None if cut is None else cut.tolist(),
+        committed=int(committed[0]),
+    )
+
+
+def _copy_request(states, drafter, managers, seed):
+    """A decoding request whose context repeats a 32-token span: its first
+    proposal copies INITIAL drafts (columns past them are -1)."""
+    rng = np.random.default_rng(seed)
+    repeated = np.tile(rng.integers(1, VOCAB, 32), 6).tolist()
+    slot = _set_history(states, "req", repeated[:96])
+    states.num_computed_tokens_np[slot] = 96
+    states.last_sampled_tokens[slot] = repeated[95]
+    drafter.add_request(slot)
+    drafter.apply_staged_writes()
+    for manager in managers:
+        manager.add_request(slot)
+        manager.apply_staged_writes()
+    return slot, repeated
+
+
+@pytest.mark.parametrize("tau", [0.0, 0.2])
+def test_stale_wide_host_limit_routes_no_placeholder_row(monkeypatch, tau):
+    """The host still holds an older proposal's wider limit (its copy has not
+    landed, and the read does not wait), so the step verifies 16 rows of an
+    8-draft copy. The device limit is the current proposal's: the rows of drafts
+    8 to 15 (the -1 placeholders) are padding, which routed MoE skips, with the
+    request's last sampled token as their input; the request commits at most the
+    8 drafts and the bonus, whatever the target makes of those rows. With dead
+    rows off, candidate-37's combine routed those rows live with -1 ids."""
+    states = _request_state(8192)
+    drafter = _drafter(states)
+    fix = _manager(monkeypatch, states, drafter, device_limits=True, tau=tau)
+    c37 = _manager(monkeypatch, states, drafter, device_limits=False, tau=tau)
+    slot, repeated = _copy_request(states, drafter, [fix, c37], 23)
+    idx = torch.tensor([slot], dtype=torch.int64, device=DEVICE)
+    one = torch.ones(1, dtype=torch.int32, device=DEVICE)
+    zero = torch.zeros(1, dtype=torch.int32, device=DEVICE)
+    drafts = _propose(states, drafter, [fix, c37], idx, one, zero)
+    assert int(drafter.slot_draft_limits.gpu[slot]) == INITIAL
+    assert drafts[INITIAL:] == [-1] * (LOOKAHEAD - INITIAL)
+    drafter._limits_event = _InFlightEvent()  # type: ignore[assignment]
+    assert int(drafter.sync_slot_draft_limits()[slot]) == LOOKAHEAD  # stale, wide
+
+    step = _verify_step(states, fix, idx, LOOKAHEAD)
+    assert step.eligible == LOOKAHEAD and step.rows == 1 + LOOKAHEAD
+    last = repeated[95]
+    assert step.input_ids == [last, *drafts[:INITIAL]] + [last] * (LOOKAHEAD - INITIAL)
+    assert step.is_padding == [False] * (1 + INITIAL) + [True] * (LOOKAHEAD - INITIAL)
+    assert step.cut == [INITIAL]
+    assert step.committed == INITIAL + 1
+    assert step.logits_indices == list(range(1 + LOOKAHEAD))
+
+    before = _verify_step(states, c37, idx, LOOKAHEAD)
+    assert before.rows == step.rows
+    assert before.input_ids[1 + INITIAL :] == [-1] * (LOOKAHEAD - INITIAL)
+    if tau == 0:
+        assert not any(before.is_padding)  # the placeholders routed live
+    else:
+        assert before.is_padding == step.is_padding  # dead rows by survival
+
+
+@pytest.mark.parametrize("tau", [0.0, 0.2])
+def test_current_host_limits_leave_the_step_bit_identical(monkeypatch, tau):
+    """Where the host's limits are the current proposal's, no row is past the
+    device limit: the step's ids, padding, logits rows and commit count are
+    candidate-37's, bit for bit, with dead rows on and off."""
+    states = _request_state(8192)
+    drafter = _drafter(states)
+    fix = _manager(monkeypatch, states, drafter, device_limits=True, tau=tau)
+    c37 = _manager(monkeypatch, states, drafter, device_limits=False, tau=tau)
+    slot, repeated = _copy_request(states, drafter, [fix, c37], 29)
+    idx = torch.tensor([slot], dtype=torch.int64, device=DEVICE)
+    one = torch.ones(1, dtype=torch.int32, device=DEVICE)
+    zero = torch.zeros(1, dtype=torch.int32, device=DEVICE)
+    for step_num in range(2):
+        _propose(states, drafter, [fix, c37], idx, one, zero)
+        # The limit copy landed: the host's limits are the device's.
+        drafter.slot_draft_limits.np[:] = drafter.slot_draft_limits.gpu.cpu().numpy()
+        ours = _verify_step(states, fix, idx, LOOKAHEAD)
+        theirs = _verify_step(states, c37, idx, LOOKAHEAD)
+        assert ours.eligible == INITIAL * (1 + step_num)
+        for field in ("rows", "input_ids", "logits_indices", "cu_num_logits"):
+            assert getattr(ours, field) == getattr(theirs, field), field
+        assert ours.is_padding == theirs.is_padding
+        assert ours.committed == theirs.committed == ours.rows
+        if tau > 0:
+            assert ours.cut == theirs.cut
+        # The whole copy accepted: the next proposal doubles its cap.
+        _set_history(states, "req", repeated[: 96 + 9 * (step_num + 1)])
+        states.last_sampled_tokens[slot] = repeated[96 + 9 * (step_num + 1) - 1]
+        one = torch.full((1,), INITIAL + 1, dtype=torch.int32, device=DEVICE)
+        zero = torch.full((1,), INITIAL, dtype=torch.int32, device=DEVICE)
+
+
+def test_stale_narrow_host_limit_still_under_admits(monkeypatch):
+    """The device limit only removes rows: when the host holds an older, narrower
+    limit (8) than the current proposal's (16 after its cap doubled), the step
+    verifies 8 of the 16 drafts, as without device limits."""
+    states = _request_state(8192)
+    drafter = _drafter(states)
+    fix = _manager(monkeypatch, states, drafter, device_limits=True, tau=0.0)
+    slot, repeated = _copy_request(states, drafter, [fix], 31)
+    idx = torch.tensor([slot], dtype=torch.int64, device=DEVICE)
+    one = torch.ones(1, dtype=torch.int32, device=DEVICE)
+    zero = torch.zeros(1, dtype=torch.int32, device=DEVICE)
+    _propose(states, drafter, [fix], idx, one, zero)
+    drafter.slot_draft_limits.np[slot] = INITIAL  # landed: the 8-draft copy's
+    # All 8 accepted; the next proposal copies 16, and its limit copy is in flight.
+    _set_history(states, "req", repeated[: 96 + INITIAL + 1])
+    states.last_sampled_tokens[slot] = repeated[96 + INITIAL]
+    num_sampled = torch.full((1,), INITIAL + 1, dtype=torch.int32, device=DEVICE)
+    verified = torch.full((1,), INITIAL, dtype=torch.int32, device=DEVICE)
+    drafts = _propose(states, drafter, [fix], idx, num_sampled, verified)
+    assert int(drafter.slot_draft_limits.gpu[slot]) == 2 * INITIAL
+    assert -1 not in drafts
+    drafter._limits_event = _InFlightEvent()  # type: ignore[assignment]
+
+    step = _verify_step(states, fix, idx, LOOKAHEAD)
+    assert step.eligible == INITIAL and step.rows == 1 + INITIAL
+    assert step.input_ids[1:] == drafts[:INITIAL]
+    assert not any(step.is_padding)
+    assert step.cut == [INITIAL]
diff --git a/tests/v1/worker/test_gpu_tilelang_inputs.py b/tests/v1/worker/test_gpu_tilelang_inputs.py
