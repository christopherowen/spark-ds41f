+++ b/tests/v1/worker/test_gpu_tilelang_inputs.py
@@ -696,6 +696,146 @@ def test_combine_dead_rows(num_reqs):
                 assert torch.equal(r, o), tau
 
 
+def _limit_ref(ids, padding, cut, args, num_new, limits, survival):
+    """The draft limits applied on the host to a combine without them: a decoding
+    request's cut at most its slot's limit (its drafts without survival), the rows
+    from the cut on padding, and the rows past the limit its last sampled token.
+    Any other request's cut never clamps (the block plus one)."""
+    _, idx, last, starts, seq_lens, prefill_len, draft_tokens, cu = args
+    ids, padding, cut = ids.cpu(), padding.cpu(), cut.cpu()
+    idx, last, starts, cu = idx.cpu(), last.cpu(), starts.cpu(), cu.cpu()
+    seq_lens, prefill_len, limits = seq_lens.cpu(), prefill_len.cpu(), limits.cpu()
+    if not survival:
+        cut[:] = triton.next_power_of_2(draft_tokens.shape[-1] + num_new) + 1
+    for b in range(idx.shape[0]):
+        req = int(idx[b])
+        num_drafts = int(cu[b + 1] - cu[b]) - num_new
+        if not (int(seq_lens[b]) > int(prefill_len[req]) and num_drafts > 0):
+            continue
+        limit = int(limits[req])
+        live = int(cut[b]) if survival else num_drafts
+        cut[b] = min(live, limit)
+        first = int(starts[b + 1]) - num_drafts
+        padding[first + int(cut[b]) : first + num_drafts] = True
+        if limit < num_drafts:
+            ids[first + limit : first + num_drafts] = int(last[req, 0])
+    return ids, padding, cut
+
+
+@pytest.mark.parametrize("num_reqs", [1, 3, 8, 16])
+@pytest.mark.parametrize("survival", [False, True])
+def test_combine_draft_limits(num_reqs, survival):
+    """Copy drafts' draft limits, with and without dead rows: a decoding request's
+    rows past its slot's limit are padding with its last sampled token as their
+    input, its cut is at most the limit, and the logits indices are unchanged.
+    Limits no request reaches change nothing: the ids, padding and logits indices
+    of the combine without them, and its cut (its drafts without dead rows)."""
+    gen = _gen(num_reqs + 40)
+    drafts, num_new = 16, 1
+    starts, cu, seq_lens, prefill_len, num_logits, tokens = _combine_case(
+        num_reqs, drafts, num_new, gen
+    )
+    idx = _idx(num_reqs, gen)
+    last = _randint(0, 1 << 17, (MAX_REQS, 1), gen, torch.int64)
+    # A proposal's drafts past its own are -1 (copy_select's padding).
+    draft_tokens = _randint(-1, 1 << 17, (MAX_REQS, drafts), gen, torch.int64)
+    confidence = torch.rand(MAX_REQS, drafts, generator=gen, device=DEVICE) ** 0.1
+    tau = math.log(0.2) if survival else None
+    args = (None, idx, last, starts, seq_lens, prefill_len, draft_tokens, cu)
+
+    def run(limits):
+        ids = _garbage((tokens + 8,), torch.int32, _gen(1))
+        padding = torch.zeros(tokens + 8, dtype=torch.bool, device=DEVICE)
+        padding[::3] = True
+        cut = _garbage((num_reqs,), torch.int32, _gen(2))
+        dead = ib.DeadRows(confidence, padding, cut, tau, limits)
+        if not survival and limits is None:
+            dead = None
+        logits = _combine_ours((ids, *args[1:]), num_logits, num_new, dead)
+        torch.accelerator.synchronize()
+        return ids, padding, cut, logits
+
+    plain = run(None)
+    for limits in (
+        _randint(0, drafts + 2, (MAX_REQS,), gen),
+        torch.zeros(MAX_REQS, dtype=torch.int32, device=DEVICE),
+        torch.full((MAX_REQS,), 5, dtype=torch.int32, device=DEVICE),
+    ):
+        ids, padding, cut, logits = run(limits)
+        ref = _limit_ref(*plain[:3], args, num_new, limits, survival)
+        assert torch.equal(ids.cpu(), ref[0])
+        assert torch.equal(padding.cpu(), ref[1])
+        assert torch.equal(cut.cpu(), ref[2])
+        assert torch.equal(logits, plain[3])
+
+    # Current limits: no request has drafts past its slot's limit.
+    current = torch.full((MAX_REQS,), drafts, dtype=torch.int32, device=DEVICE)
+    ids, padding, cut, logits = run(current)
+    assert torch.equal(ids, plain[0])
+    assert torch.equal(padding, plain[1])
+    assert torch.equal(logits, plain[3])
+    if survival:
+        assert torch.equal(cut, plain[2])
+    else:
+        num_drafts = (cu[1:] - cu[:-1] - num_new).cpu()
+        decoding = (seq_lens.cpu() > prefill_len.cpu()[idx.cpu()]) & (num_drafts > 0)
+        block = triton.next_power_of_2(drafts + num_new)
+        expected = torch.where(decoding, num_drafts, block + 1).to(torch.int32)
+        assert torch.equal(cut.cpu(), expected)
+
+
+@pytest.mark.parametrize("survival", [False, True])
+@pytest.mark.parametrize("draft_limits", [False, True])
+def test_declared_combine_variants(monkeypatch, survival, draft_limits):
+    """The combines a step launches (without drafts, and a verification step's
+    with its dead rows and draft limits) are the ones the runner declares."""
+    launched = set()
+    original = tli._kernel
+
