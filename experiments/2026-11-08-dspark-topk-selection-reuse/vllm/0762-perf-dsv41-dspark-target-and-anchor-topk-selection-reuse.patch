+def test_deepseek_v4_attention_dspark_target_and_step0_topk_reuse(monkeypatch):
+    from vllm.models.deepseek_v4_1 import attention as attn_mod
+    from vllm.models.deepseek_v4_1.tilelang import metadata as tl_metadata
+
+    device = torch.device("cuda")
+    monkeypatch.setattr(
+        tl_metadata,
+        "pages",
+        lambda reqs, lengths, table, out, offset, count, read_width, *, page: out[
+            :count
+        ].zero_(),
+    )
+
+    def _fake_decode_metadata(
+        positions,
+        reqs,
+        table,
+        swa_indices,
+        swa_lengths,
+        top_lengths,
+        visible,
+        starts,
+        req_pos,
+         main_reqs,
+        main_table,
+        main_pages,
+        offset,
+        rows,
+        main_width,
+        *,
+        main_page,
+        **window,
+    ):
+        swa_indices[:rows].zero_()
+        swa_lengths[:rows].fill_(128)
+        top_lengths[:rows].copy_(torch.clamp(visible[:rows], min=0, max=512))
+        main_pages[:rows].zero_()
+
+    monkeypatch.setattr(tl_metadata, "decode_metadata", _fake_decode_metadata)
+
+    for reuse_mode in ("target", "anchor", "full"):
+        context: dict = {}
+        target_l0 = _make_dspark_layer(
+            context,
+            prefix="language_model.model.layers.0.attn",
+            layer_id=0,
+            is_draft=False,
+            is_kv_source=True,
+            is_index_source=True,
+            kv_source_layer_id=0,
+            index_source_layer_id=0,
+            reuse_mode=reuse_mode,
+            topk_indices_buffer=None,
+            device=device,
+        )
+        target_l1 = _make_dspark_layer(
+            context,
+            prefix="language_model.model.layers.1.attn",
+            layer_id=1,
+            is_draft=False,
+            is_kv_source=False,
+            is_index_source=True,
+            kv_source_layer_id=0,
+            index_source_layer_id=1,
+            reuse_mode=reuse_mode,
+            topk_indices_buffer=None,
+            device=device,
+        )
+        draft_buf = torch.full((64, 512), -1, dtype=torch.int32, device=device)
+        draft_idx_src = 1 if reuse_mode == "target" else 2
+        draft_l2 = _make_dspark_layer(
+            context,
+            prefix="model.layers.2.attn",
+            layer_id=2,
+            is_draft=True,
+            is_kv_source=False,
+            is_index_source=(reuse_mode != "target"),
+            kv_source_layer_id=0,
+            index_source_layer_id=draft_idx_src,
+            reuse_mode=reuse_mode,
+            topk_indices_buffer=draft_buf,
+            device=device,
+        )
+        draft_l3 = _make_dspark_layer(
+            context,
+            prefix="model.layers.3.attn",
+            layer_id=3,
+            is_draft=True,
+            is_kv_source=False,
+            is_index_source=False,
+            kv_source_layer_id=0,
+            index_source_layer_id=draft_idx_src,
+            reuse_mode=reuse_mode,
+            topk_indices_buffer=draft_buf,
+            device=device,
+        )
+        draft_l2._is_draft_topk_leader = True
+        draft_l3._is_draft_topk_leader = False
