+def gather_dspark_anchor_topk_indices(
+    target_topk_indices: torch.Tensor,
+    target_query_start_loc: torch.Tensor,
+    num_rejected: torch.Tensor | None,
+    visible_anchor: torch.Tensor,
+    num_reqs: int | torch.Tensor,
