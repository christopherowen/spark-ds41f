+        min=0, max=max_target_row
+    )
+    anchor_topk = target_topk_indices.index_select(0, safe_anchor_row)
+    return broadcast_dspark_step0_topk_indices(
+        anchor_topk,
+        visible_req,
+        num_query_per_req,
+        num_reqs=num_reqs,
+        append_tail=append_tail,
+        out=out,
+    )
