+def test_broadcast_dspark_step0_topk_when_seq_len_le_topk():
+    topk = 512
+    q_per_req = 5
+    # Req 0: visible=64 (well below topk), Req 1: visible=510 (straddles topk=512 across steps 0..4),
+    # Req 2: visible=512 (exact boundary), Req 3: inactive padding (visible=0).
+    visible = torch.tensor([64, 510, 512, 0], dtype=torch.int32)
+    step0 = torch.full((4, topk), -1, dtype=torch.int32)
+    # Include some out-of-bounds/rejected indices >= visible in step0 to verify masking + compaction.
+    step0[0, :64] = torch.arange(64, dtype=torch.int32)
+    step0[0, 64:70] = torch.arange(64, 70, dtype=torch.int32)  # >= 64 -> must be masked out
+    step0[1, :510] = torch.arange(510, dtype=torch.int32)
+    step0[1, 510:] = torch.tensor([510, 515], dtype=torch.int32)  # >= 510 -> must be masked out
+    step0[2, :512] = torch.arange(512, dtype=torch.int32)
+    step0[3, :10] = torch.arange(10, dtype=torch.int32)
+
+    out_no_tail = broadcast_dspark_step0_topk_indices(
+        step0, visible, q_per_req, num_reqs=3, append_tail=False
+    )
+    assert out_no_tail.shape == (20, topk)
+    for s in range(q_per_req):
+        # Req 0: exactly 0..63 valid, rest -1
+        assert torch.equal(out_no_tail[0 * 5 + s, :64], torch.arange(64, dtype=torch.int32))
+        assert torch.all(out_no_tail[0 * 5 + s, 64:] == -1)
+        # Req 1: exactly 0..509 valid, rest -1
+        assert torch.equal(out_no_tail[1 * 5 + s, :510], torch.arange(510, dtype=torch.int32))
+        assert torch.all(out_no_tail[1 * 5 + s, 510:] == -1)
+        # Req 2: 0..511 valid
+        assert torch.equal(out_no_tail[2 * 5 + s], torch.arange(512, dtype=torch.int32))
+        # Req 3 (inactive): all -1
+        assert torch.all(out_no_tail[3 * 5 + s] == -1)
+
+    out_tail = broadcast_dspark_step0_topk_indices(
+        step0, visible, q_per_req, num_reqs=3, append_tail=True
+    )
+    for s in range(q_per_req):
+        # Req 0 (visible=64): step s appends s tail tokens [64 .. 64+s-1] into unused -1 slots
+        expected_r0 = torch.arange(64 + s, dtype=torch.int32)
+        assert torch.equal(out_tail[0 * 5 + s, : 64 + s], expected_r0)
+        assert torch.all(out_tail[0 * 5 + s, 64 + s :] == -1)
+
+        # Req 1 (visible=510):
+        # s=0 -> 510 valid, 2 -1s
+        # s=1 -> 511 valid (0..510), 1 -1
+        # s=2 -> 512 valid (0..511), 0 -1s
+        # s=3 -> 509 historical (0..508) + 3 tail (510, 511, 512)
+        # s=4 -> 508 historical (0..507) + 4 tail (510, 511, 512, 513)
+        row_r1 = out_tail[1 * 5 + s]
+        if 510 + s <= topk:
+            assert torch.equal(row_r1[: 510 + s], torch.arange(510 + s, dtype=torch.int32))
+            assert torch.all(row_r1[510 + s :] == -1)
+        else:
+            keep = topk - s
+            assert torch.equal(row_r1[:keep], torch.arange(keep, dtype=torch.int32))
+            assert torch.equal(
+                row_r1[keep:], torch.arange(510, 510 + s, dtype=torch.int32)
+            )
+
+
+def test_broadcast_dspark_step0_topk_when_seq_len_gt_topk():
+    topk = 512
+    q_per_req = 5
+    visible = torch.tensor([4096, 131072], dtype=torch.int32)
+    step0 = torch.stack(
+        [
+            torch.arange(1000, 1000 + topk, dtype=torch.int32),
+            torch.arange(50000, 50000 + topk, dtype=torch.int32),
+        ],
+        dim=0,
+    )
+
+    out_no_tail = broadcast_dspark_step0_topk_indices(
+        step0, visible, q_per_req, append_tail=False
+    )
+    for r in range(2):
+        for s in range(q_per_req):
+            assert torch.equal(out_no_tail[r * q_per_req + s], step0[r])
+
+    out_tail = broadcast_dspark_step0_topk_indices(
+        step0, visible, q_per_req, append_tail=True
+    )
+    for r in range(2):
+        vis = int(visible[r].item())
+        for s in range(q_per_req):
+            row = out_tail[r * q_per_req + s]
+            keep = topk - s
+            assert torch.equal(row[:keep], step0[r, :keep])
+            if s > 0:
+                assert torch.equal(
+                    row[keep:], torch.arange(vis, vis + s, dtype=torch.int32)
+                )
+
