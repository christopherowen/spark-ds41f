+def test_gather_dspark_anchor_topk_rejected_slots_overwritten_next_step():
+    topk = 512
+    q_per_req = 5
+    # 3 active requests + 1 padded request; each active request verified 6 target tokens.
+    target_qsl = torch.tensor([0, 6, 12, 18, 18], dtype=torch.int32)
+    # Give every target row a distinct signature and include future positions that must be masked
+    # if a previous token in the verification window is chosen as anchor.
+    target_topk = torch.full((24, topk), -1, dtype=torch.int32)
+    for t_row in range(18):
+        req = t_row // 6
+        local_step = t_row % 6
+        base_vis = (req + 1) * 100 + local_step
+        # Fill first 80 slots with valid historical [0..79], and slots 80..85 with [base_vis - 2 .. base_vis + 3]
+        target_topk[t_row, :80] = torch.arange(80, dtype=torch.int32)
+        target_topk[t_row, 80:86] = torch.arange(
+            base_vis - 2, base_vis + 4, dtype=torch.int32
+        )
+
+    # Step 1: num_rejected = [0, 2, 5, 0]
+    # Req 0: anchor_row = 6 - 0 - 1 = 5, visible = 105
+    # Req 1: anchor_row = 12 - 2 - 1 = 9, visible = 203
+    # Req 2: anchor_row = 18 - 5 - 1 = 12, visible = 300
+    num_rejected_step1 = torch.tensor([0, 2, 5, 0], dtype=torch.int32)
+    visible_step1 = torch.tensor([105, 203, 300, 0], dtype=torch.int32)
+    out_buf = torch.full((20, topk), 999999, dtype=torch.int32)
+
+    gather_dspark_anchor_topk_indices(
+        target_topk,
+        target_qsl,
+        num_rejected_step1,
+        visible_step1,
+        num_reqs=3,
+        num_query_per_req=q_per_req,
+        append_tail=True,
+        out=out_buf,
+    )
+
+    for r, expected_vis in enumerate([105, 203, 300]):
+        for s in range(q_per_req):
+            row = out_buf[r * q_per_req + s]
+            # Valid historical entries at anchor are < expected_vis: 80 + 2 = 82 entries,
+            # plus s tail entries [expected_vis .. expected_vis + s - 1].
+            valid_entries = row[row >= 0]
+            assert valid_entries.numel() == 82 + s
+            assert int(valid_entries.max().item()) < expected_vis + s
+            if s > 0:
+                assert torch.equal(
+                    valid_entries[-s:],
+                    torch.arange(expected_vis, expected_vis + s, dtype=torch.int32),
+                )
+    # Padded request 3 is all -1
+    assert torch.all(out_buf[15:20] == -1)
+
+    # Verify position-offset path (num_rejected=None) produces bit-identical output
+    target_req_pos = torch.tensor([100, 200, 300, -1], dtype=torch.int64)
+    draft_req_pos = torch.tensor([105, 203, 300, -1], dtype=torch.int64)
+    out_pos_path = gather_dspark_anchor_topk_indices(
+        target_topk,
+        target_qsl,
+        None,
+        visible_step1,
+        num_reqs=3,
+        num_query_per_req=q_per_req,
+        target_request_positions=target_req_pos,
+        draft_request_positions=draft_req_pos,
+        append_tail=True,
+    )
+    assert torch.equal(out_buf, out_pos_path)
+
+    # Step 2: Suppose draft tokens from Step 1 were rejected on the next step, so
+    # Req 0 only advanced to visible=106 (rejecting positions 106..109 that were written into out_buf!),
+    # and Req 2 had all 6 tokens rejected (edge case clamping to q_start).
+    num_rejected_step2 = torch.tensor([4, 3, 6, 0], dtype=torch.int32)
+    visible_step2 = torch.tensor([106, 204, 300, 0], dtype=torch.int32)
+    # Contaminate target_topk at anchor rows with rejected draft positions >= visible_step2
+    target_topk[1, 90:95] = torch.tensor([106, 107, 108, 109, 110], dtype=torch.int32)
+
+    gather_dspark_anchor_topk_indices(
+        target_topk,
+        target_qsl,
+        num_rejected_step2,
+        visible_step2,
+        num_reqs=3,
+        num_query_per_req=q_per_req,
+        append_tail=False,
+        out=out_buf,
+    )
+    for r, expected_vis in enumerate([106, 204, 300]):
+        for s in range(q_per_req):
+            row = out_buf[r * q_per_req + s]
+            valid = row[row >= 0]
+            assert torch.all(valid < expected_vis), (
+                f"Rejected slot >= {expected_vis} survived in req {r} step {s}"
+            )
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA required for CUDAGraph test")
+def test_dspark_topk_reuse_cudagraph_capture_and_replay():
+    device = torch.device("cuda")
+    topk = 512
+    max_reqs = 4
+    q_per_req = 5
+    target_topk = torch.full((max_reqs * 6, topk), -1, dtype=torch.int32, device=device)
+    target_qsl = torch.tensor([0, 6, 12, 18, 24], dtype=torch.int32, device=device)
+    num_rejected = torch.zeros(max_reqs, dtype=torch.int32, device=device)
+    visible_anchor = torch.tensor([128, 1024, 510, 4096], dtype=torch.int32, device=device)
+    num_reqs_t = torch.tensor(4, dtype=torch.int32, device=device)
+    out_graph = torch.empty((max_reqs * q_per_req, topk), dtype=torch.int32, device=device)
+
+    stream = torch.cuda.Stream(device=device)
+    with torch.cuda.stream(stream):
+        for _ in range(3):
+            gather_dspark_anchor_topk_indices(
+                target_topk,
+                target_qsl,
+                num_rejected,
+                visible_anchor,
+                num_reqs_t,
+                q_per_req,
+                append_tail=True,
+                out=out_graph,
+            )
+    torch.cuda.synchronize(device)
+
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph, stream=stream):
+        gather_dspark_anchor_topk_indices(
+            target_topk,
+            target_qsl,
+            num_rejected,
+            visible_anchor,
+            num_reqs_t,
+            q_per_req,
+            append_tail=True,
+            out=out_graph,
+        )
+
+    # Replay 1: mixed seq_len <= topk and seq_len > topk, 3 active requests
+    for row in range(24):
+        target_topk[row] = torch.arange(row * 10, row * 10 + topk, dtype=torch.int32, device=device)
+    num_rejected.copy_(torch.tensor([1, 2, 4, 0], dtype=torch.int32, device=device))
+    visible_anchor.copy_(torch.tensor([200, 510, 4096, 8192], dtype=torch.int32, device=device))
+    num_reqs_t.fill_(3)
+    graph.replay()
+    torch.cuda.synchronize(device)
+
+    expected_1 = gather_dspark_anchor_topk_indices(
+        target_topk,
+        target_qsl,
+        num_rejected,
+        visible_anchor,
+        num_reqs_t,
+        q_per_req,
+        append_tail=True,
+    )
+    assert torch.equal(out_graph, expected_1)
+
+    # Replay 2: next step after rejection, overwriting rejected draft slots
+    num_rejected.copy_(torch.tensor([5, 0, 3, 2], dtype=torch.int32, device=device))
+    visible_anchor.copy_(torch.tensor([150, 2048, 300, 1024], dtype=torch.int32, device=device))
+    num_reqs_t.fill_(4)
+    graph.replay()
+    torch.cuda.synchronize(device)
+
+    expected_2 = gather_dspark_anchor_topk_indices(
+        target_topk,
+        target_qsl,
+        num_rejected,
+        visible_anchor,
+        num_reqs_t,
+        q_per_req,
+        append_tail=True,
+    )
+    assert torch.equal(out_graph, expected_2)
+
+
+def _make_dspark_layer(
+    context: dict,
+    *,
+    prefix: str,
+    layer_id: int,
+    is_draft: bool,
+    is_kv_source: bool,
+    is_index_source: bool,
+    kv_source_layer_id: int,
+    index_source_layer_id: int,
+    reuse_mode: str,
+    topk_indices_buffer: torch.Tensor | None,
+    device: torch.device,
+) -> DeepseekV4Attention:
+    from vllm.models.deepseek_v4_1.tilelang.attention import (
+        DeepseekV41TileLangAttention,
+    )
+
+    module = DeepseekV41TileLangAttention.__new__(DeepseekV41TileLangAttention)
+    torch.nn.Module.__init__(module)
+    module.prefix = prefix
+    module.layer_id = layer_id
+    module.is_draft = is_draft
+    module.is_ced_decoder = False
+    module._draft_replays = False
+    module._draft_replay_start = None
+    module.window_size = 128
+    module.swa_width = 136 if is_draft else 128
+    module.capacity = 64
+    module.max_model_len = 8192
+    module.compress_ratio = 1
+    module._main_page = module._index_page = 64
+    module._main_width = module._index_width = 128
+    module.is_kv_source = is_kv_source
+    module.is_index_source = is_index_source
+    module.kv_source_layer_id = kv_source_layer_id
+    module.index_source_layer_id = index_source_layer_id
+    module.candidate_source_layer = 0
+    module.n_local_heads = 16
+    module.head_dim = 512
+    module.q_lora_rank = 128
+    module._context = context
+    context[prefix] = module
+    module._dspark_num_query_tokens = 5 if is_draft else 1
+    module._dspark_topk_reuse = reuse_mode
+    module._dspark_append_tail = True
+    module._is_draft_topk_leader = True
+    module._target_topk_prepared = False
+    module._target_num_rejected = None
+    module.topk_indices_buffer = topk_indices_buffer
+    module.compressor = None
+    module.swa_cache_layer = SimpleNamespace(
+        prefix=f"{prefix}.swa_cache",
+        block_size=64,
+        kv_cache=torch.zeros((16, 64 * 528), dtype=torch.uint8, device=device),
+    )
+    if is_index_source:
+        k_cache = (
+            SimpleNamespace(
+                prefix=f"{prefix}.indexer.k_cache",
+                kv_cache=torch.zeros((16, 64 * 68), dtype=torch.uint8, device=device),
+            )
+            if is_kv_source
+            else module._resolve_layer(kv_source_layer_id).indexer.k_cache
+        )
+        module.indexer = SimpleNamespace(heads=32, owns_k=is_kv_source, k_cache=k_cache)
+    else:
+        module.indexer = None
+    module.config = SimpleNamespace(
+        scheduler_config=SimpleNamespace(max_num_seqs=8),
+        speculative_config=SimpleNamespace(
+            num_speculative_tokens=5,
+            parallel_drafting=True,
+            num_verification_tokens=5,
+        ),
+        compilation_config=SimpleNamespace(max_cudagraph_capture_size=64),
+    )
+    module.rotary_emb = SimpleNamespace(
+        cos_sin_cache=torch.zeros((8192, 64), dtype=torch.float32, device=device)
+    )
+    module._ready = False
+    return module
+
+
+def _stub_layer_kernels(
+    layer: DeepseekV4Attention, index_calls: list, attend_calls: list
+):
+    layer._check_attention_rows = lambda mode, rows: None
+    layer._attention_scratch_specs = lambda mode, rows: ()
+
+    def _index_chunk(mode, rows, *, output_indices, cache_lengths, **kwargs):
+        index_calls.append((layer.layer_id, mode, rows, cache_lengths.clone()))
+        for r in range(rows):
+            vis = min(int(cache_lengths[r].item()), 512)
+            output_indices[r].fill_(-1)
+            if vis > 0:
+                output_indices[r, :vis] = torch.arange(
+                    vis, device=output_indices.device, dtype=torch.int32
+                )
+
+    def _attend(mode, q, output, *, scratch, positions, **indices):
+        attend_calls.append(
+            (
+                layer.layer_id,
+                mode,
+                q.shape[0],
+                indices["indexed_indices"].clone()
+                if "indexed_indices" in indices
+                else None,
+            )
+        )
+        output.zero_()
+
+    layer._index_chunk = _index_chunk
+    layer._attend = _attend
+
+
+@pytest.mark.skipif(
