+    """Gather each request's accepted anchor row from the target model's top-k
+    buffer and broadcast it across that request's DSpark draft query rows."""
+    if (
+        visible_anchor.ndim == 1
+        and num_query_per_req > 1
+        and visible_anchor.shape[0] > target_query_start_loc.shape[0] - 1
+        and visible_anchor.shape[0] % num_query_per_req == 0
+    ):
+        visible_req = visible_anchor[0::num_query_per_req]
+    else:
+        visible_req = visible_anchor
+    max_reqs = min(visible_req.shape[0], target_query_start_loc.shape[0] - 1)
+    visible_req = visible_req[:max_reqs]
+    device = target_topk_indices.device
+    req_ids = torch.arange(max_reqs, device=device, dtype=torch.int32)
+    limit = (
+        num_reqs.to(device=device, dtype=torch.int32)
+        if isinstance(num_reqs, torch.Tensor)
+        else int(num_reqs)
+    )
