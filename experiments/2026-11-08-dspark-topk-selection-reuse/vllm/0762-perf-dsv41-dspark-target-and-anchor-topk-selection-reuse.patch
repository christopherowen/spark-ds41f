+def broadcast_dspark_step0_topk_indices(
+    step0_topk_indices: torch.Tensor,
+    visible_anchor: torch.Tensor,
+    num_query_per_req: int,
+    *,
+    num_reqs: int | torch.Tensor | None = None,
+    append_tail: bool = False,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Broadcast per-request anchor/step-0 top-k KV indices across DSpark draft rows.
+
+    Each request's step-0 row holds historical KV positions selected at the
+    accepted anchor position. Any invalid or rejected position (>= visible_anchor
+    or < 0) is masked to -1 and valid entries are compacted to the left so
+    sparse MLA's top_lengths prefix reads every kept index. When ``append_tail``
+    is True, draft step ``s`` (``0 <= s < num_query_per_req``) appends the ``s``
+    newly drafted causal positions ``visible_anchor .. visible_anchor + s - 1``.
+    """
+    max_reqs, topk = step0_topk_indices.shape
+    if (
+        visible_anchor.ndim == 1
+        and num_query_per_req > 1
+        and visible_anchor.shape[0] == max_reqs * num_query_per_req
+    ):
+        visible_req = visible_anchor[0::num_query_per_req]
+    else:
+        visible_req = visible_anchor[:max_reqs]
+    device = step0_topk_indices.device
+    req_ids = torch.arange(max_reqs, device=device, dtype=torch.int32)
+    active_req = visible_req > 0
+    if num_reqs is not None:
+        limit = (
+            num_reqs.to(device=device, dtype=torch.int32)
+            if isinstance(num_reqs, torch.Tensor)
+            else int(num_reqs)
+        )
+        active_req = active_req & (req_ids < limit)
+    vis_col = visible_req.to(dtype=torch.int32).unsqueeze(1)
+    valid_mask = (
+        active_req.unsqueeze(1)
+        & (step0_topk_indices >= 0)
+        & (step0_topk_indices < vis_col)
+    )
+    masked = torch.where(valid_mask, step0_topk_indices, -1)
+    valid_int = valid_mask.to(dtype=torch.int64)
+    valid_rank = valid_int.cumsum(dim=-1) - 1
+    invalid_rank = (
+        valid_int.sum(dim=-1, keepdim=True) + (1 - valid_int).cumsum(dim=-1) - 1
+    )
+    dst_col = torch.where(valid_mask, valid_rank, invalid_rank)
+    compacted = torch.empty_like(masked)
+    compacted.scatter_(1, dst_col, masked)
+    expanded = compacted.unsqueeze(1).expand(max_reqs, num_query_per_req, topk)
+    if append_tail and num_query_per_req > 1:
+        valid_count = valid_mask.sum(dim=-1, dtype=torch.int32).view(max_reqs, 1, 1)
+        step_ids = torch.arange(
+            num_query_per_req, device=device, dtype=torch.int32
+        ).view(1, num_query_per_req, 1)
+        base_slot = torch.minimum(valid_count, topk - step_ids).clamp(min=0)
+        col_ids = torch.arange(topk, device=device, dtype=torch.int32).view(
+            1, 1, topk
+        )
+        tail_offset = col_ids - base_slot
+        in_tail = (
+            active_req.view(max_reqs, 1, 1)
+            & (tail_offset >= 0)
+            & (tail_offset < step_ids)
+        )
+        tail_vals = visible_req.to(dtype=torch.int32).view(max_reqs, 1, 1) + tail_offset
+        expanded = torch.where(in_tail, tail_vals, expanded)
+    flat = expanded.reshape(max_reqs * num_query_per_req, topk)
+    if out is None:
+        return flat.contiguous()
+    out[: max_reqs * num_query_per_req].copy_(flat)
+    return out[: max_reqs * num_query_per_req]
+
