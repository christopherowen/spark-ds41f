{
 "experiment": "experiments/2026-10-24-prompt-logprobs-sink",
 "run": "prompt-logprobs-sink",
 "jobs": [
  {
   "kind": "sync"
  },
  {
   "kind": "measure",
   "profile": "lean",
   "bench": false,
   "bracket": false,
   "extras": [
    [
     "prompt_logprobs_check.py",
     [
      "--label",
      "{label}",
      "--reference-labels",
      "candidate4,production",
      "--prompt-logprobs",
      "2",
      "--tokens",
      "96"
     ],
     "prompt-logprobs"
    ]
   ],
   "arms": [
    {
     "config": "experiments/2026-10-23-next-release/rc4/rc-tp4.json",
     "label": "candidate4"
    },
    {
     "config": "fix-tp4.json",
     "label": "candidate4-fix"
    },
    {
     "config": "production-fix-tp4.json",
     "label": "production-fix"
    },
    {
     "config": "production-tp4.json",
     "label": "production"
    }
   ]
  }
 ]
}
