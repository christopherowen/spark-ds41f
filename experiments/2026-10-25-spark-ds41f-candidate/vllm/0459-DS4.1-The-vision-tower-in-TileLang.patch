+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""DeepSeek-V4.1's TileLang vision tower against B12X's arithmetic and DeepSeek's
+reference.
+
+Bit for bit (compared as bits): the patch padding and the spatial merge (copies),
+the residual add with RMSNorm, the 2-D RoPE, the exact GELU epilogue and the bias
+epilogue's single rounding, against torch models of B12X's arithmetic (``_b12x_*``,
+read from its CuTe kernels: the same reduction tree, FMAs where libNVVM contracts,
+the same FP32 constants). Where b12x is importable, the same operations and the
+SwiGLU epilogue against B12X's own kernels, bit for bit; a mismatch names the
+arithmetic B12X's kernel matched instead.
+
+Against FP64 references, with tolerances no looser than B12X's own error on the
+same inputs (both measured and reported): the projections, attention, and the whole
+tower and aligner (DeepSeek's ``deepseek_v4/common/vision.py`` math in FP64, rounded
+to BF16 where its modules return BF16) at grids from 1x1 to the capacity, odd sizes
+included for the merge padding. Then non-finite values (the reference's positions),
+stale capacity rows, CUDA graph replay, the data-parallel runner and declaration
+coverage.
+"""
+
+import math
+from types import SimpleNamespace
+
+import pytest
+import torch
+import torch.nn.functional as F
+
+from vllm.platforms import current_platform
+
+if not (
+    current_platform.is_cuda() and current_platform.is_device_capability_family(120)
+):
+    pytest.skip("TileLang V4.1 kernels target SM120/SM121", allow_module_level=True)
+
+pytest.importorskip("tilelang")
+
+from tests.kernels.deepseek_v41_contracts import (  # noqa: E402
+    INF,
+    NAN,
+    assert_finite_equal,
+    assert_other_rows_equal,
+    assert_same_nonfinite,
+)
+from vllm.models.deepseek_v4_1.nvidia import tilelang_vision  # noqa: E402
+from vllm.models.deepseek_v4_1.tilelang import prepare, vision  # noqa: E402
+
+DEVICE = "cuda"
+
+
+def _config(**overrides) -> SimpleNamespace:
+    base = dict(
+        vision_patch_size=2,
+        vision_dim=128,
+        vision_n_heads=2,
+        vision_inter_dim=192,
+        vision_n_layers=2,
+        vision_rope_theta=10000.0,
+        vision_downsample_ratio=3,
+        hidden_size=256,
+        vision_max_n_token=16,
+    )
+    return SimpleNamespace(**{**base, **overrides})
+
+
+# Two blocks of narrow widths, capacity 144 rows.
+SMALL = _config()
+# DeepSeek-V4.1's widths (1024 wide, 16 heads of 64, 2816, 14-pixel patches, a
+# 5120-wide aligner), one block and a 576-row capacity.
+REAL = _config(
+    vision_patch_size=14,
+    vision_dim=1024,
+    vision_n_heads=16,
+    vision_inter_dim=2816,
+    vision_n_layers=1,
+    hidden_size=5120,
+    vision_max_n_token=64,
+)
+# Grids from one patch to the capacity; odd sizes pad the 3x3 merge.
+SMALL_GRIDS = [(1, 1), (1, 7), (4, 7), (5, 5), (7, 11), (12, 12), (3, 48), (1, 144)]
+REAL_GRIDS = [(1, 1), (5, 7), (13, 17), (24, 24), (1, 576)]
+
+
+# --- Construction ---------------------------------------------------------------
+
+
+@torch.no_grad()
+def _init(module: torch.nn.Module, seed: int) -> None:
+    """Random weights at serving scale: unit-variance projections, small biases,
+    norm weights near one."""
+    gen = torch.Generator(device=DEVICE).manual_seed(seed)
+    for name, parameter in module.named_parameters():
+        noise = torch.randn(parameter.shape, generator=gen, device=DEVICE)
+        if "norm" in name:
+            parameter.copy_(1 + 0.1 * noise)
+        elif name.endswith("bias"):
+            parameter.copy_(0.1 * noise)
+        else:
+            parameter.copy_(noise / math.sqrt(parameter.shape[1]))
+
+
+def _build(config, seed: int = 411):
+    with torch.device(DEVICE):
+        vit = tilelang_vision.DeepseekV4ViT(config)
+        aligner = tilelang_vision.DeepseekV4Aligner(config)
+    _init(vit, seed)
+    _init(aligner, seed + 1)
+    return vit, aligner
+
+
+def _towers(config, seed: int = 411):
+    vit, aligner = _build(config, seed)
+    vit.declare_kernels()
+    aligner.declare_kernels()
+    return vit, aligner
+
+
+@pytest.fixture(scope="module")
+def small():
+    return _towers(SMALL)
+
+
+@pytest.fixture(scope="module")
+def real():
