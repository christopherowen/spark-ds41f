+            k=ws.k,
+            v=ws.v,
+            cu_seqlens=ws.cu,
+            plan=ws.rope_plan,
+        )
+        theirs = torch.cat(
+            [t[:rows].reshape(rows, hidden) for t in (ws.q, ws.k, ws.v)], -1
+        )
