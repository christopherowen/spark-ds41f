+# --- Projections ------------------------------------------------------------------
+
+
+def _projection_error(out, a, weight, bias):
+    """Max ``|out - ref|`` in BF16 steps at the FP64 reference plus FP32 accumulation
+    noise (``sqrt(K) 2^-24 sum |a w|``), and how many outputs differ from the
+    correctly rounded reference, of how many."""
+    a64, w64 = a.double(), weight.double()
+    ref, scale = a64 @ w64.T, a64.abs() @ w64.abs().T
+    if bias is not None:
+        ref, scale = ref + bias.double(), scale + bias.double().abs()
+    noise = scale * math.sqrt(a.shape[1]) * 2.0**-24
+    error = ((out.double() - ref).abs() / (_bf16_ulp(ref) + noise)).max().item()
+    return error, int((out != ref.bfloat16()).sum()), out.numel()
+
+
+def _check_projection(name, ours, theirs):
+    """Ours within one BF16 step of the reference (plus accumulation noise), or at
+    most B12X's worst; and off the correctly rounded value no more often than
+    B12X (1.5x, plus four values for sampling noise)."""
+    error, off, total = ours
+    message = f"{name}: ours {error:.3f} steps, {off} of {total} off; "
+    if theirs is None:
+        assert error <= 1.0 and off <= 0.01 * total + 4, message + "B12X unavailable"
+        return
+    b12x_error, b12x_off, _ = theirs
+    message += f"B12X {b12x_error:.3f} steps, {b12x_off} off"
+    assert error <= max(1.0, b12x_error), message
+    assert off <= 1.5 * b12x_off + 4, message
+
+
+def _projection_cases(vit, aligner):
+    """Each projection: its TileLang kernel (the declared one, or for the two with
+    an epilogue the plain GEMM their epilogues start from), its layer, and its
+    module path (the same in B12X's tower)."""
+    block, out_dim = vit.blocks[0], aligner.out_dim
+    gate_up = block.mlp.w1.weight.shape
+    return {
+        "qkv": (_kernel(vit, "qkv"), block.attn.wqkv, "blocks.0.attn.wqkv"),
+        "wo": (_kernel(vit, "wo"), block.attn.wo, "blocks.0.attn.wo"),
+        "mlp gate/up": (
+            vision.resolve(vision.linear_call(*gate_up, bias=False)),
+            block.mlp.w1,
+            "blocks.0.mlp.w1",
+        ),
+        "mlp down": (_kernel(vit, "mlp_out"), block.mlp.w2, "blocks.0.mlp.w2"),
+        "aligner w1": (
+            vision.resolve(
+                vision.linear_call(out_dim, aligner.w1.weight.shape[1], bias=True)
+            ),
+            aligner.w1,
+            "w1",
+        ),
+        "aligner w2": (_kernel(aligner, "w2"), aligner.w2, "w2"),
+    }
+
+
+def _optional(request, name: str):
+    """A B12X fixture, or None where b12x is not importable."""
+    try:
+        return request.getfixturevalue(name)
+    except pytest.skip.Exception:
+        return None
+
+
+# B12X plans its aligner projections for the merged capacity (192 rows here).
+@pytest.mark.parametrize("rows", [1, 77, 192])
+def test_projections_against_fp64(real, rows, request):
+    vit, aligner = real
+    b12x = _optional(request, "b12x_real")
+    for name, (kernel, layer, path) in _projection_cases(vit, aligner).items():
+        a = _randn(rows, layer.weight.shape[1], seed=rows + layer.weight.shape[0])
+        out = torch.empty(
+            rows, layer.weight.shape[0], dtype=torch.bfloat16, device=DEVICE
+        )
+        if layer.bias is None:
+            kernel(a, layer.weight, out)
+        else:
+            kernel(a, layer.weight, layer.bias, out)
+        ours = _projection_error(out, a, layer.weight, layer.bias)
+        theirs = None
+        if b12x is not None:
+            root = b12x.aligner if name.startswith("aligner") else b12x.vit
+            b12x_out = torch.empty_like(out)
+            root.get_submodule(path)(a, out=b12x_out)
+            theirs = _projection_error(b12x_out, a, layer.weight, layer.bias)
+        _check_projection(f"{name} at {rows} rows", ours, theirs)
+
