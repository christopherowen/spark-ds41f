From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Sun, 25 Oct 2026 11:06:00 +0100
Subject: [PATCH 489/490] Tests: CED's scatter round trip on rows of whole
 16-byte packs

Candidate 5's release tests: scatter_rows zeroes its output with TileLang's
16-byte fill since 3622c1185 (every serving shape is whole packs: the hidden
rows and the FP32 sink columns), which refuses the round trip's 7 x 3 x 5 FP32
rows (420 bytes). The test keeps its trailing dimensions, transpose and
invalid rows on 7 x 3 x 4. Package files are unchanged.
---
 tests/v1/attention/test_b12x_v41_ced_metadata.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tests/v1/attention/test_b12x_v41_ced_metadata.py b/tests/v1/attention/test_b12x_v41_ced_metadata.py
index ebfb9efb6..bc52f85c6 100644
--- a/tests/v1/attention/test_b12x_v41_ced_metadata.py
+++ b/tests/v1/attention/test_b12x_v41_ced_metadata.py
@@ -305,7 +305,9 @@ def test_skipped_chunks_require_the_complete_successor(monkeypatch):
 @cuda
 @pytest.mark.parametrize("transpose", [False, True])
 def test_packing_trailing_dimensions_invalid_rows_and_scatter(transpose):
-    source = torch.arange(7 * 3 * 5, device="cuda", dtype=torch.float32).view(7, 3, 5)
+    # scatter_rows zeroes its output with TileLang's fill of whole 16-byte packs
+    # (columns.zero_), as every serving shape is: rows of 3 x 4 FP32 values here.
+    source = torch.arange(7 * 3 * 4, device="cuda", dtype=torch.float32).view(7, 3, 4)
     if transpose:
         source = source.transpose(1, 2)
     indices = torch.tensor([6, 1, -1, 3, 99], device="cuda")
