+def _reset_rows(case: str, states: int, gen: torch.Generator) -> list[int]:
+    if case == "one":
+        return [states - 1]
+    if case == "repeated":
+        return [0, 3, 0]
+    if case == "negative":
+        return [-1, 2, -states]
+    # More requests than a block's threads, negative ones and repeats among them.
+    return torch.randint(-states, states, (300,), generator=gen).tolist()
+
+
