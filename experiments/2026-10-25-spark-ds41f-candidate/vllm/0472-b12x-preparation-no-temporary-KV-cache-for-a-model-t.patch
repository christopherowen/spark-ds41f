         assert after.block_stride == before.block_stride
 
 
+def test_tuning_pool_is_not_built_for_a_model_that_declared_no_unit(monkeypatch):
+    # A model whose kernels need no preparation (DeepSeek V4.1 under TileLang)
+    # builds no temporary KV cache, so the state stage has nothing to run.
+    initialized = []
+    cache = SimpleNamespace(num_gpu_blocks=None, num_gpu_blocks_override=None)
+    worker = SimpleNamespace(
+        use_v2_model_runner=True,
+        cache_config=cache,
+        model_runner=SimpleNamespace(
+            initialize_kv_cache=lambda c, **kw: initialized.append((c, kw))
+        ),
+    )
+    monkeypatch.setattr(b12x_prepare, "b12x_native_supported", lambda _: True)
+    assert not b12x_prepare.initialize_b12x_tuning_cache(worker, object())
+    assert initialized == []
+    assert cache.num_gpu_blocks is None and cache.num_gpu_blocks_override is None
+    assert not getattr(worker, "_b12x_tuning_cache", False)
+
+
+def test_collection_records_whether_any_unit_was_declared(monkeypatch) -> None:
+    monkeypatch.setattr(b12x_prepare, "b12x_unit_providers", lambda: [])
+    model = torch.nn.Module()
+    model.layer = torch.nn.Module()
+    worker = _worker(model)
+    assert b12x_prepare.collect_b12x_units(worker, _workload("weights")) == []
+    assert b12x_prepare.collect_b12x_units(worker, _workload("state")) == []
+    assert not getattr(worker, "_b12x_units_declared", False)
+
+    # A unit of the other stage counts: the state stage tunes it.
+    model.layer.b12x_preparation_provider = _Provider("state")
+    assert b12x_prepare.collect_b12x_units(worker, _workload("weights")) == []
+    assert worker._b12x_units_declared
+
+
 @pytest.mark.parametrize("failure", [False, True])
 def test_tuning_pool_teardown_batches_plan_release_even_on_failure(
     monkeypatch, failure
diff --git a/vllm/model_executor/warmup/b12x_prepare.py b/vllm/model_executor/warmup/b12x_prepare.py
index bc15f4d48..3cf49bd87 100644
--- a/vllm/model_executor/warmup/b12x_prepare.py
+++ b/vllm/model_executor/warmup/b12x_prepare.py
@@ -388,6 +388,10 @@ def collect_b12x_units(
                 replace(unit, workspace_lanes=tuple(sorted({0, lane})))
                 for unit in hook(provider, workload)
             )
+    if units:
+        # Only a model that declares units, of either stage, tunes its state
+        # against a temporary cache (initialize_b12x_tuning_cache).
+        worker._b12x_units_declared = True
     # The state stage also carries the weights-stage units: their prepared
     # plans are skipped by the session, and any plan a layer declared for a
     # count that only the state stage exposes is prepared before capture.
@@ -606,6 +610,10 @@ def initialize_b12x_tuning_cache(worker: Worker, kv_cache_config) -> bool:
     """Use final cache groups and layout with a small disposable block pool."""
     if not b12x_native_supported(worker) or not worker.use_v2_model_runner:
         return False
+    # A model that declared no unit, in its weights stage or against the
+    # profiling pools, has nothing to tune.
+    if not getattr(worker, "_b12x_units_declared", False):
+        return False
     # HiSparse has a separate shared host-pool lifecycle.
     if worker.vllm_config.attention_config.hisparse_config is not None:
         return False
diff --git a/vllm/v1/worker/gpu_worker.py b/vllm/v1/worker/gpu_worker.py
