From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Sun, 25 Oct 2026 03:35:31 +0100
Subject: [PATCH 463/488] [DS4.1] Image span: host-to-device copies by keyword;
 Engram fixture delimiters

async_tensor_h2d takes the device before the dtype; the span builder and
the merge passed them the other way round (run 21's image-span tests).
The Engram model tests' hand-built VL root gets the learned delimiters
loading now stacks into the span's table.
---
 tests/models/test_deepseek_v4_1_engram.py    | 10 ++++++++++
 vllm/models/deepseek_v4_1/nvidia/vl_model.py |  8 +++++---
 2 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/tests/models/test_deepseek_v4_1_engram.py b/tests/models/test_deepseek_v4_1_engram.py
index 742bd9e1c..1a39bf880 100644
--- a/tests/models/test_deepseek_v4_1_engram.py
+++ b/tests/models/test_deepseek_v4_1_engram.py
@@ -155,6 +155,16 @@ def tiny_engram_checkpoint(tmp_path, dist_init):
         language.hf_to_vllm_mapper = WeightsMapper()
         root = DeepseekV41ForCausalLM.__new__(DeepseekV41ForCausalLM)
         nn.Module.__init__(root)
+        # The image span's learned delimiters, which loading stacks into a table.
+        root.embed_dtype = torch.bfloat16
+        for name in ("image_start", "image_end", "image_newline"):
+            setattr(
+                root,
+                name,
+                nn.Parameter(
+                    torch.zeros(config.hidden_size, device="cuda"), requires_grad=False
+                ),
+            )
         root.language_model = language
         root.hf_to_vllm_mapper = _make_deepseek_v4_vl_weights_mapper(
             "fp4", "weight_scale_inv"
diff --git a/vllm/models/deepseek_v4_1/nvidia/vl_model.py b/vllm/models/deepseek_v4_1/nvidia/vl_model.py
index fe8df1ac8..166234fe7 100644
--- a/vllm/models/deepseek_v4_1/nvidia/vl_model.py
+++ b/vllm/models/deepseek_v4_1/nvidia/vl_model.py
@@ -195,13 +195,13 @@ class DeepseekV41ForCausalLM(UpstreamDeepseekV41ForCausalLM):
         span = image_embeds.new_empty(len(kinds), image_embeds.shape[-1])
         ced_kernels.copy_rows(
             self._image_delimiters,
-            async_tensor_h2d(delimiter_rows, torch.int64, device),
+            async_tensor_h2d(delimiter_rows, device=device, dtype=torch.int64),
             span,
             scatter=False,
         )
         ced_kernels.copy_rows(
             image_embeds,
-            async_tensor_h2d(image_slots, torch.int64, device),
+            async_tensor_h2d(image_slots, device=device, dtype=torch.int64),
             span,
             scatter=True,
         )
@@ -243,7 +243,9 @@ class DeepseekV41ForCausalLM(UpstreamDeepseekV41ForCausalLM):
             ced_kernels.copy_rows(
                 span,
                 async_tensor_h2d(
-                    slots[offset : offset + rows], torch.int64, inputs_embeds.device
+                    slots[offset : offset + rows],
+                    device=inputs_embeds.device,
+                    dtype=torch.int64,
                 ),
                 inputs_embeds,
                 scatter=True,
