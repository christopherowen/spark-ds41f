diff --git a/tests/kernels/test_deepseek_v41_tilelang_metadata.py b/tests/kernels/test_deepseek_v41_tilelang_metadata.py
index 92d598e8c..d7d559294 100644
--- a/tests/kernels/test_deepseek_v41_tilelang_metadata.py
+++ b/tests/kernels/test_deepseek_v41_tilelang_metadata.py
@@ -19,6 +19,55 @@ from vllm.models.deepseek_v4_1.sparse_mla import _requests, _tokens  # noqa: E40
 from vllm.models.deepseek_v4_1.tilelang import metadata  # noqa: E402
 from vllm.triton_utils import triton  # noqa: E402
 
+
+@pytest.mark.parametrize("max_requests", [1, 8, 16, 32])
+@pytest.mark.parametrize("nr", [0, 1, 3])
+def test_ced_requests_preserves_compaction_and_replay_bounds(max_requests, nr):
+    """Per-request limits preserve the old 128/full-row metadata, including padding."""
+    from vllm.models.deepseek_v4_1.ced import _decoder_requests
+    from vllm.models.deepseek_v4_1.tilelang import ced
+
+    nr = min(nr, max_requests)
+    for lengths in ([0] * nr, [1] * nr, [129 + i * 511 for i in range(nr)]):
+        starts = torch.tensor(
+            [0, *torch.tensor(lengths).cumsum(0).tolist()],
+            dtype=torch.int32,
+            device="cuda",
+        )
+        seq = torch.full((max_requests,), 5000, dtype=torch.int32, device="cuda")
+        prefix = torch.arange(max_requests, dtype=torch.int64, device="cuda") * 17
+        full = torch.arange(max_requests, device="cuda") % 2 == 0
+        limits = torch.where(full, 2**31 - 1, 128).to(torch.int32)
+        outputs = []
+        for implementation in ("triton", "tilelang"):
+            out = torch.full((max_requests + 1,), 7, dtype=torch.int32, device="cuda")
+            positions = torch.full((max_requests,), 7, dtype=torch.int64, device="cuda")
+            replay = torch.full_like(positions, 7)
+            counts = torch.full((2,), 7, dtype=torch.int32, device="cuda")
+            if implementation == "triton":
+                _decoder_requests[(1,)](
+                    starts,
+                    seq,
+                    full,
+                    prefix,
+                    out,
+                    positions,
+                    replay,
+                    counts,
+                    nr,
+                    max_requests,
+                    triton.next_power_of_2(max_requests + 1),
+                    128,
+                )
+            else:
+                ced.requests(
+                    starts, seq, limits, prefix, out, positions, replay, counts, nr
+                )
+            outputs.append((out, positions, replay, counts))
+        for reference, actual in zip(*outputs):
+            assert torch.equal(reference, actual)
+
+
 DEVICE = "cuda"
 R, CAP, COLS = 16, 1024, 40
 
diff --git a/vllm/models/deepseek_v4_1/tilelang/ced.py b/vllm/models/deepseek_v4_1/tilelang/ced.py
new file mode 100644
index 000000000..a53bbe7a4
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/tilelang/ced.py
@@ -0,0 +1,62 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Integer row selection for the DeepSeek-V4.1 CED decoder."""
+
+import tilelang
+import tilelang.language as T
+
+_PASS = {tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True}
+
+
+@tilelang.jit(pass_configs=_PASS)
+def requests_kernel(max_requests: int):
+    starts_len = T.dynamic("starts_len")
+    seq_len = T.dynamic("seq_len")
+    block = max(32, 1 << max_requests.bit_length())
+
+    @T.prim_func
+    def ced_requests(
+        starts: T.Tensor((starts_len,), T.int32),
+        seq: T.Tensor((seq_len,), T.int32),
+        limits: T.Tensor((max_requests,), T.int32),
+        prefix: T.Tensor((max_requests,), T.int64),
+        out_starts: T.Tensor((max_requests + 1,), T.int32),
+        positions: T.Tensor((max_requests,), T.int64),
+        replay: T.Tensor((max_requests,), T.int64),
+        counts: T.Tensor((2,), T.int32),
+        nr: T.int32,
+    ):
+        with T.Kernel(1, threads=128):
+            kept = T.alloc_fragment((block,), T.int32)
+            cumulative = T.alloc_fragment((block,), T.int32)
+            for r in T.Parallel(block):
+                kept[r] = T.if_then_else(
+                    r < nr, T.min(starts[r + 1] - starts[r], limits[r]), 0
+                )
+            T.copy(kept, cumulative)
+            T.cumsum(cumulative, dim=0)
+            for r in T.Parallel(max_requests + 1):
+                out_starts[r] = T.if_then_else(
+                    r < nr, cumulative[r] - kept[r], cumulative[block - 1]
+                )
+            for r in T.Parallel(max_requests):
+                if r < nr:
+                    q = starts[r + 1] - starts[r]
+                    position = T.cast(seq[r], T.int64) - kept[r]
+                    positions[r] = position
+                    replay[r] = T.max(
+                        prefix[r], T.if_then_else(q > kept[r], position, 0)
+                    )
+                else:
+                    positions[r] = -1
+                    replay[r] = 0
+            for i in T.Parallel(2):
+                counts[i] = T.if_then_else(i == 0, cumulative[block - 1], nr)
+
+    return ced_requests
+
+
+def requests(starts, seq, limits, prefix, out_starts, positions, replay, counts, nr):
+    requests_kernel(positions.shape[0])(
+        starts, seq, limits, prefix, out_starts, positions, replay, counts, nr
+    )
