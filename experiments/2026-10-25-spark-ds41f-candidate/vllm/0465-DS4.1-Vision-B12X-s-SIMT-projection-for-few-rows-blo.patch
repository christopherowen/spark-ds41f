+            weights = T.alloc_local((parts * _VEC,), T.bfloat16)
+            values = T.alloc_local((_VEC,), T.bfloat16)
+            partial = T.alloc_shared((sums, warps), T.float32)
+            total = T.alloc_var(T.float32)
+            for i in T.unroll(sums):
