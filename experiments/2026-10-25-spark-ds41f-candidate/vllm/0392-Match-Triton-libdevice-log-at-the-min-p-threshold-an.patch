-    rows, out_cols, mask_cols, topk_cols, states, custom_cols = T.dynamic(
-        "rows, out_cols, mask_cols, topk_cols, states, custom_cols"
+    rows, out_cols, mask_cols, topk_rows, topk_cols, states, custom_cols = T.dynamic(
