Subject: [PATCH 392/488] Match Triton libdevice log at the min-p threshold and
 cover zero-top-k alias

The benchmark reproducer differs at one token of seed 48294: approximate log2 times ln(2) moves the threshold by one ULP. Use the same inline libdevice arithmetic as the sampling family. The unused top-k pointer can have state-capacity rows.
---
 tests/v1/worker/test_gpu_sampling_controls.py |  3 ++
 .../worker/gpu/sample/tilelang_auxiliary.py   |  6 +--
 .../v1/worker/gpu/sample/tilelang_controls.py | 40 +++++++++++++++++--
 3 files changed, 43 insertions(+), 6 deletions(-)

diff --git a/tests/v1/worker/test_gpu_sampling_controls.py b/tests/v1/worker/test_gpu_sampling_controls.py
index de147f5bb..03194b2b2 100644
--- a/tests/v1/worker/test_gpu_sampling_controls.py
+++ b/tests/v1/worker/test_gpu_sampling_controls.py
@@ -275,6 +275,9 @@ def test_custom_logprob_ids_override_topk_without_touching_padding(index_dtype,
     count = torch.zeros(states, device="cuda", dtype=torch.int32)
     count[mapping[::2]] = 17
     custom = torch.randint(129280, (states, 17), device="cuda", dtype=torch.int32)
+    if topk == 0:
+        # The owner reuses the state-capacity tensor as an unused pointer.
+        top_ids = custom
     expected, expected_valid = output.clone(), valid.clone()
     _fill_logprob_token_ids_kernel[(rows,)](
         expected,
