 .../v1/worker/gpu/sample/tilelang_sampling.py | 133 +++++++++++-------
 1 file changed, 82 insertions(+), 51 deletions(-)

diff --git a/vllm/v1/worker/gpu/sample/tilelang_sampling.py b/vllm/v1/worker/gpu/sample/tilelang_sampling.py
index 7428899d2..6a67d9788 100644
