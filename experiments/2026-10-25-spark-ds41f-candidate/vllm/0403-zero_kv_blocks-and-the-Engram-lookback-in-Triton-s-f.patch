@@ -16,8 +19,34 @@ import torch
 
 from vllm.tilelang_utils import T, tilelang
 
-_THREADS = 128
+_THREADS = 32  # a warp a row: the window is a few tokens
 _DTYPES = {torch.int32: "int32", torch.int64: "int64"}
+_LOAD_BITS = {"int32": 32, "int64": 64}
