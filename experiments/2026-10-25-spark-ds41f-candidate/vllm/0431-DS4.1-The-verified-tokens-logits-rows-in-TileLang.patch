+    sampled = _randint(0, 1 << 17, (num_reqs + 2, DRAFTS + 3), gen, torch.int64)
+    num_logits = int(cu[-1]) + tail
+    expected = torch.zeros(num_logits, dtype=torch.int64, device=DEVICE)
+    _flatten_sampled_kernel[(num_reqs,)](
