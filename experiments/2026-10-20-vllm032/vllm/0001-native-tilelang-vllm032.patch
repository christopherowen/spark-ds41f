+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""DeepSeek-V4.1 kernels in TileLang for SM120 / SM121.
+
+Selected by ``VLLM_DS41_KERNEL_BACKEND=tilelang``:
+
+
+- ``sparse_mla``: compressed sparse MLA over the SWA and indexed caches;
+- ``indexer``: MXFP4 index scores, exact top-k and candidate lists;
+- ``gemm``: MXFP8 block-scaled and BF16 GEMMs;
+- ``moe``: routed-expert dispatch, grouped FP8 x FP4 GEMMs and combine;
+- ``attention``, ``linear``, ``norm``: the vLLM layers and methods built on them.
+
+Importing a kernel module requires TileLang; the layers also use DeepSeek's
+TileKernels for MXFP8 casts, the fused SwiGLU and RMSNorm.
+"""
diff --git a/vllm/models/deepseek_v4_1/tilelang/activation.py b/vllm/models/deepseek_v4_1/tilelang/activation.py
new file mode 100644
index 0000000000000000000000000000000000000000..9e88588ba1206d33e82f3a970b1f45f067f2883e
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/tilelang/activation.py
@@ -0,0 +1,101 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The shared expert's clamped SwiGLU at DeepSeek's reference precision.
+
+DeepSeek's reference (``Expert.forward``) widens the gate and up projections to FP32,
+clamps the gate from above and the up projection on both sides at ``swiglu_limit``,
+multiplies ``silu(gate)`` by ``up`` in FP32 and rounds the product to BF16 once.
+vLLM's ``SiluAndMulWithClamp`` rounds ``silu(gate)`` to BF16 before the multiply.
+This kernel follows the reference: one launch, eight values a thread.
+"""
+
+# No `from __future__ import annotations`: TileLang reads the prim_func
+# annotations eagerly, and the symbolic shape must resolve.
+from functools import cache
+
+import tilelang
+import tilelang.language as T
+import torch
+from torch import nn
+
+from vllm.models.deepseek_v4_1.tilelang import prepare
+
+_VEC = 8
+
+
+@tilelang.jit
+def swiglu_clamp_kernel(n: int, limit: float, threads: int = 128):
+    """``Y[m, j] = bf16(silu(min(G, limit)) * clamp(U, -limit, limit))`` in FP32, for
+    ``X = [G | U]`` of shape ``[M, 2n]`` (BF16). The clamps compare and select, as
+    ``torch.clamp`` does, so a NaN passes through; ``min``/``max`` (``fminf``,
+    ``fmaxf``) would return the limit and hide it."""
+    assert n % _VEC == 0
+    M = T.dynamic("M")
+    per_block = threads * _VEC
+
+    @T.prim_func
+    def activation_swiglu_clamp(
+        X: T.Tensor((M, 2 * n), T.bfloat16),
+        Y: T.Tensor((M, n), T.bfloat16),
+    ):
+        with T.Kernel(T.ceildiv(n, per_block), M, threads=threads) as (bx, by):
+            col = (bx * threads + T.get_thread_binding()) * _VEC
+            gate = T.alloc_local((_VEC,), T.bfloat16)
+            up = T.alloc_local((_VEC,), T.bfloat16)
+            out = T.alloc_local((_VEC,), T.bfloat16)
+            if col < n:
+                for v in T.vectorized(_VEC):
+                    gate[v] = X[by, col + v]
+                for v in T.vectorized(_VEC):
+                    up[v] = X[by, n + col + v]
+                for v in T.unroll(_VEC):
+                    g = T.alloc_var(T.float32, init=T.Cast(T.float32, gate[v]))
+                    u = T.alloc_var(T.float32, init=T.Cast(T.float32, up[v]))
+                    g = T.if_then_else(g > limit, T.float32(limit), g)
+                    u = T.if_then_else(u > limit, T.float32(limit), u)
+                    u = T.if_then_else(u < -limit, T.float32(-limit), u)
+                    out[v] = T.Cast(T.bfloat16, g / (1.0 + T.exp(-g)) * u)
+                for v in T.vectorized(_VEC):
+                    Y[by, col + v] = out[v]
+
+    return activation_swiglu_clamp
+
+
+@cache
+def _kernel(n: int, limit: float):
+    return swiglu_clamp_kernel(n, limit)
+
+
+class SiluAndMulClampFP32(nn.Module):
+    """Drop-in for ``SiluAndMulWithClamp`` with the reference's FP32 product.
+
+    ``width`` is the gate (and up) width its owner runs it on, ``[M, 2 * width]``
+    inputs; the module declares that kernel. Without it (kernel tests) nothing is
+    declared.
+    """
+
+    def __init__(self, swiglu_limit: float, width: int | None = None):
+        super().__init__()
+        self.limit = float(swiglu_limit)
+        self.width = width
+
+    def declare_kernels(self) -> None:
+        """Declare the kernel of the owner's width, and keep it in ``_kernel``."""
+        if self.width is None:
+            return
+        width, limit = self.width, self.limit
+        prepare.declare(
+            lambda: [prepare.call(swiglu_clamp_kernel, width, limit)],
+            bind=lambda: _kernel(width, limit),
+        )
+
+    def forward(self, gate_up: torch.Tensor) -> torch.Tensor:
+        n = gate_up.shape[-1] // 2
+        x = gate_up.reshape(-1, 2 * n).contiguous()
+        out = torch.empty((x.shape[0], n), dtype=torch.bfloat16, device=x.device)
+        if x.shape[0]:
+            _kernel(n, self.limit)(x, out)
+        return out.view(*gate_up.shape[:-1], n)
+
+
+__all__ = ["SiluAndMulClampFP32", "swiglu_clamp_kernel"]
diff --git a/vllm/models/deepseek_v4_1/tilelang/attention.py b/vllm/models/deepseek_v4_1/tilelang/attention.py
new file mode 100644
index 0000000000000000000000000000000000000000..64da43927786de4198c77dfabb88bc6eeef62ce5
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/tilelang/attention.py
@@ -0,0 +1,292 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""TileLang kernels behind the DeepSeek-V4.1 attention layer.
+
+``--attention-backend TILELANG`` selects this layer. It keeps the shared
+layer's caches, metadata and Full/Reindex/Reuse ownership, and runs the
+indexer (MXFP4 query quantization, index-key writes, scores, top-k and the
+candidate list) and the sparse MLA with this package's kernels.
+
+The kernels hold no buffers. Their scratch comes from vLLM's workspace,
+reserved for the worst case before memory profiling, beside the attention
+metadata arena exactly as B12X's scratch is.
+"""
+
+import functools
+from types import SimpleNamespace
+
+import torch
+
+from vllm.models.deepseek_v4_1.attention import DeepseekV4Attention
+from vllm.models.deepseek_v4_1.sparse_mla import DeepseekV41B12xBackend
+from vllm.v1.worker.workspace import (
+    current_workspace_manager,
+    retain_cuda_graph_capture_resource,
+)
+
+from . import prepare
+from .indexer import (
+    CANDIDATE_BLOCK,
+    CANDIDATE_BLOCKS,
+    IndexerV41Plan,
+    page_bytes,
+    quantize_call,
+    quantize_mxfp4,
+    write_index_keys,
+)
+from .sparse_mla import SparseMlaV41Plan
+
+
+class DeepseekV41TileLangBackend(DeepseekV41B12xBackend):
+    """The V4.1 cache layout and metadata builder, under the TileLang name."""
+
+    @staticmethod
+    def get_name() -> str:
+        return "TILELANG"
+
+
+def _mla_options(heads, swa_width, idx_width, idx_page, swa_page, max_rows, device):
+    """``SparseMlaV41Plan``'s arguments for one layer shape."""
+    return (heads, swa_width, idx_width, idx_page), dict(
+        swa_page_size=swa_page, max_rows=max_rows, device=device
+    )
+
+
+# Plans are kernels only, so layers of one shape share them.
+@functools.cache
+def _mla_plan(*shape):
+    args, kwargs = _mla_options(*shape)
+    return SparseMlaV41Plan(*args, **kwargs)
+
+
+def _mla_calls(*shape) -> list:
+    """The kernel calls ``_mla_plan(*shape)`` makes."""
+    args, kwargs = _mla_options(*shape)
+    return SparseMlaV41Plan.calls(*args, **kwargs)
+
+
+@functools.cache
+def _index_plan(width, page_size, candidates, candidate_blocks):
+    return IndexerV41Plan(
+        width, page_size, candidates=candidates, candidate_blocks=candidate_blocks
+    )
+
+
+def _index_calls(width, page_size, candidates, candidate_blocks) -> list:
+    """The kernel calls ``_index_plan`` of these arguments makes."""
+    return IndexerV41Plan.calls(
+        width, page_size, candidates=candidates, candidate_blocks=candidate_blocks
+    )
+
+
+class DeepseekV41TileLangAttention(DeepseekV4Attention):
+    backend_cls = DeepseekV41TileLangBackend
+
+    def _declare_mla(self, mode, capacity, metadata_specs, device):
+        return None
+
+    def get_b12x_preparation_units(self, layer, workload):
+        # B12X's state unit prepares its own sparse MLA and indexer plans,
+        # which this layer never launches.
+        return ()
+
+    def declare_kernels(self) -> None:
+        """Also declare the sparse MLA, indexer and MXFP4 quantizer kernels; binding
+        builds the plans and reserves their scratch, before memory profiling."""
+        super().declare_kernels()
+        calls = self._plan_calls()
+        prepare.declare(lambda: calls, bind=self._bind_plans)
+
+    def _plan_args(self) -> tuple[tuple, dict, dict]:
+        """``_mla_plan``'s arguments, and per index mode ``_index_plan``'s
+        arguments and the chunk rows its scratch covers."""
+        self._attention_geometry()
+        mla = (
+            self.n_local_heads,
+            self.swa_width,
+            512 if self.compress_ratio else 0,
+            self._main_page,
+            self.swa_cache_layer.block_size,
+            self.capacity,
+            self.rotary_emb.cos_sin_cache.device,
+        )
+        index, chunks = {}, {}
+        if self.indexer is not None:
+            reindex = self.layer_id > self.candidate_source_layer
+            width = (
+                CANDIDATE_BLOCKS * CANDIDATE_BLOCK
+                if reindex
+                else self._index_width * self._index_page
+            )
+            full = (
+                width,
+                self._index_page,
+                reindex,
+                self.layer_id == self.candidate_source_layer,
+            )
+            index = {"decode": full, "prefill": full}
+            chunks = {"decode": self.DECODE_CHUNK, "prefill": self.INDEX_CHUNK}
+            if self._short_index_shape is not None:
+                rows, pages = self._short_index_shape
+                index["prefill_short"] = (
+                    pages * self._index_page,
+                    self._index_page,
+                    False,
+                    False,
+                )
+                chunks["prefill_short"] = rows
+        return mla, index, chunks
+
+    def _plan_calls(self) -> list:
+        """The kernels this layer's plans make (``_build_tilelang_plans``) and its
+        MXFP4 quantizers launch, as ``prepare.call``s."""
+        mla, index, _ = self._plan_args()
+        calls = _mla_calls(*mla)
+        # Decode and prefill share one plan.
+        for args in dict.fromkeys(index.values()):
+            calls.extend(_index_calls(*args))
+        if self.indexer is not None:
+            calls.append(quantize_call())  # _quantize_index_query
+        if self.compressor is not None:
+            calls.append(quantize_call(self._index_page))  # _write_index_keys
+        return calls
+
+    def _bind_plans(self) -> None:
+        self._tilelang_plans = self._build_tilelang_plans()
+
+    def _tilelang(self) -> SimpleNamespace:
+        """This layer's plans (built when its kernels are bound; the cache pages
+        are checked on first use)."""
+        plans = self.__dict__.get("_tilelang_plans")
+        if plans is None:
+            raise RuntimeError(
+                "V4.1 TileLang attention plans are built when the layer's kernels "
+                "are bound: declare_kernels() was not run for this layer"
+            )
+        if not self.__dict__.get("_cache_pages_checked"):
+            self._check_cache_pages()
+            self._cache_pages_checked = True
+        return plans
+
+    def _check_cache_pages(self) -> None:
+        """Each cache page must be exactly the records the kernels address in it.
+
+        Rows may be strided (BLHNC interleaves layers); a width that differs
+        from the configured page means the page holds a different number of
+        tokens than the plans assume.
+        """
+        caches = [
+            (
+                "SWA",
+                self.swa_cache_layer.kv_cache,
+                self.swa_cache_layer.block_size * 528,
+            )
+        ]
+        if self.compress_ratio:
+            caches.append(("indexed", self._owner().kv_cache, self._main_page * 288))
+        if self.indexer is not None:
+            caches.append(
+                ("index K", self.indexer.k_cache.kv_cache, page_bytes(self._index_page))
+            )
+        for name, cache, page in caches:
+            if cache.dim() != 2 or cache.dtype != torch.uint8 or cache.shape[1] != page:
+                raise ValueError(
+                    f"{self.prefix}: {name} cache pages {tuple(cache.shape)} "
+                    f"{cache.dtype} are not {page}-byte pages"
+                )
+
+    def _build_tilelang_plans(self) -> SimpleNamespace:
+        mla_args, index_args, chunks = self._plan_args()
+        mla = _mla_plan(*mla_args)
+        index = {mode: _index_plan(*args) for mode, args in index_args.items()}
+        # Reserve the largest scratch each phase borrows: indexing, then the
+        # attention metadata arena with the decode route's segment workspace.
+        workspace = current_workspace_manager()
+        for mode, plan in index.items():
+            workspace.reserve_all(*plan.scratch_specs(chunks[mode]))
+        split_rows = min(mla.decode_max_rows, self.capacity)
+        for metadata_specs in self._attention_workspace_specs.values():
+            workspace.reserve_all(*metadata_specs, *mla.scratch_specs(split_rows))
+        return SimpleNamespace(mla=mla, index=index)
+
+    def _check_attention_rows(self, mode: str, rows: int) -> None:
+        capacity = self._tilelang().mla.max_rows
+        if rows > capacity:
+            raise ValueError(f"V4.1 {mode} rows {rows} exceed capacity {capacity}")
+
+    def _attention_scratch_specs(self, mode: str, rows: int):
+        return self._tilelang().mla.scratch_specs(rows)
+
+    def _quantize_index_query(self, mode: str, iq, iq_data, iq_scale) -> None:
+        quantize_mxfp4(iq, iq_data, iq_scale)
+
+    def _write_index_keys(self, key, slot_mapping) -> None:
+        write_index_keys(
+            key, self.indexer.k_cache.kv_cache, slot_mapping, self._index_page
+        )
+
+    def _index_chunk(
+        self,
+        mode: str,
+        rows: int,
+        *,
+        output_indices,
+        q_mxfp4,
+        q_scales,
+        query_weights,
+        page_table,
+        cache_lengths,
+        score_width=None,
+        candidate_indices=None,
+        candidate_lengths=None,
+        candidate_output=None,
+        candidate_output_lengths=None,
+    ):
+        # The kernels bound their work by each row's live length on device,
+        # so the host-side ``score_width`` hint has nothing left to trim.
+        del score_width
+        plan = self._tilelang().index[mode]
+        scratch = current_workspace_manager().get_simultaneous(
+            *plan.scratch_specs(rows)
+        )
+        retain_cuda_graph_capture_resource(scratch)
+        plan.run(
+            q_mxfp4,
+            q_scales,
+            query_weights,
+            self.indexer.k_cache.kv_cache,
+            page_table,
+            cache_lengths,
+            self._active,
+            candidate_indices,
+            candidate_lengths,
+            out=output_indices,
+            candidate_out=candidate_output,
+            candidate_out_lengths=candidate_output_lengths,
+            scratch=scratch,
+        )
+
+    def _attend(self, mode: str, q, output, *, scratch, positions, **indices):
+        indexed = {}
+        if "indexed_indices" in indices:
+            indexed = dict(
+                idx_cache=self._owner().kv_cache,
+                idx_indices=indices["indexed_indices"],
+                idx_lengths=indices["indexed_lengths"],
+                idx_page_table=indices["indexed_page_table"],
+            )
+        self._tilelang().mla.run(
+            q,
+            self.swa_cache_layer.kv_cache,
+            indices["swa_indices"],
+            indices["swa_lengths"],
+            self.attn_sink,
+            positions,
+            self.rotary_emb.cos_sin_cache,
+            output,
+            scratch=scratch or None,
+            **indexed,
+        )
+
+
+__all__ = ["DeepseekV41TileLangAttention", "DeepseekV41TileLangBackend"]
diff --git a/vllm/models/deepseek_v4_1/tilelang/cache_writer.py b/vllm/models/deepseek_v4_1/tilelang/cache_writer.py
new file mode 100644
index 0000000000000000000000000000000000000000..6dd8a6353c35276038d63fde93871cd305c6f586
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/tilelang/cache_writer.py
@@ -0,0 +1,216 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""TileLang writers of DeepSeek-V4.1's paged KV-cache records.
+
+A token's 512 latent values become one record at its slot (``slot // page_size``
+selects the page, ``slot % page_size`` the record; negative or out-of-range slots
+are skipped):
+
+- ``swa`` (528 bytes): 16 groups of 32 values as E4M3, then 16 UE8M0 scales.
+  A group's scale is ``max(amax, 1e-4) * fp32(1/448)`` rounded up to a power of
+  two (the exponent is bumped when the mantissa is nonzero).
+- ``indexed`` (288 bytes): 32 groups of 16 values as packed E2M1 (low nibble
+  first), then 32 E4M3 scales. A group's scale is ``max(amax, 6 * 2^-9) / 6``
+  (IEEE division) rounded to E4M3, saturating; the values are divided by its
+  decoded value (a rounded reciprocal would move exact E2M1 midpoints off their
+  ties-to-even) and converted by ``cvt.rn.satfinite.e2m1x2.f32`` (nearest even,
+  saturating), B12X's instruction.
+
+The arithmetic is B12X's ``write_cache`` for ``cache_format="deepseek_v41"``,
+step for step, so the records are the same bytes.
+"""
+
+# No `from __future__ import annotations`: TileLang reads the prim_func
+# annotations eagerly, and the symbolic shape must resolve.
+import tilelang
+import tilelang.language as T
+import torch
+
+from . import prepare
+
+DIM = 512
+RECORD_BYTES = {"swa": 528, "indexed": 288}
+_GROUP = {"swa": 32, "indexed": 16}
+_E4M3_MAX = 448.0
+
+
+# Payload bytes, TileLang and torch types of one thread's word: four values each.
+_WORD = {"swa": (4, T.uint32, torch.uint32), "indexed": (2, T.uint16, torch.uint16)}
+_PER_THREAD = 4
+
+# Four FP32 values to four E4M3 bytes or E2M1 codes, first value lowest: B12X's
+# paired conversions in its operand order (the second source fills the low half).
+_CVT_HEADER = r"""
+__device__ __forceinline__ unsigned int dsv41_e4m3x4(float v0, float v1,
+                                                    float v2, float v3) {
+  unsigned int packed;
+  asm("{\n"
+      ".reg .b16 lo, hi;\n"
+      "cvt.rn.satfinite.e4m3x2.f32 lo, %2, %1;\n"
+      "cvt.rn.satfinite.e4m3x2.f32 hi, %4, %3;\n"
+      "mov.b32 %0, {lo, hi};\n"
+      "}"
+      : "=r"(packed)
+      : "f"(v0), "f"(v1), "f"(v2), "f"(v3));
+  return packed;
+}
+
+__device__ __forceinline__ unsigned short dsv41_e2m1x4(float v0, float v1,
+                                                      float v2, float v3) {
+  unsigned short packed;
+  asm("{\n"
+      ".reg .b8 lo, hi;\n"
+      "cvt.rn.satfinite.e2m1x2.f32 lo, %2, %1;\n"
+      "cvt.rn.satfinite.e2m1x2.f32 hi, %4, %3;\n"
+      "mov.b16 %0, {lo, hi};\n"
+      "}"
+      : "=h"(packed)
+      : "f"(v0), "f"(v1), "f"(v2), "f"(v3));
+  return packed;
+}
+"""
+
+
+@tilelang.jit(pass_configs={tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True})
+def cache_writer_kernel(cache_kind: str, page_size: int, slot_dtype: str = "int64"):
+    """One record per token, 128 threads, four values per thread, payload stored in
+    whole words through a word view of the pages (scales through the byte view),
+    the group's amax shuffled across its lanes. ``swa``: eight lanes per 32-value
+    group, one 32-bit word of E4M3 each. ``indexed``: four lanes per 16-value
+    group, one 16-bit word of packed E2M1 each."""
+    threads = 128
+    group_size = _GROUP[cache_kind]
+    groups = DIM // group_size
+    word_bytes, word_dtype, _ = _WORD[cache_kind]
+    per_thread = _PER_THREAD  # values per thread
+    lanes = group_size // per_thread  # threads per group: 8 or 4
+    per_token = groups * lanes  # 128 either way
+    tokens_per_block = threads // per_token
+    record = RECORD_BYTES[cache_kind]
+    payload = DIM if cache_kind == "swa" else DIM // 2  # scale bytes follow
+    tokens, kv_stride = T.dynamic("tokens, kv_stride")
+    pages, page_bytes, page_stride = T.dynamic("pages, page_bytes, page_stride")
+    page_words, word_stride = T.dynamic("page_words, word_stride")
+
+    @T.prim_func
+    def cache_writer(
+        kv: T.StridedTensor((tokens, DIM), (kv_stride, 1), T.bfloat16),
+        cache: T.StridedTensor((pages, page_bytes), (page_stride, 1), T.uint8),
+        words: T.StridedTensor((pages, page_words), (word_stride, 1), word_dtype),
+        slots: T.Tensor((tokens,), slot_dtype),
+    ):
+        with T.Kernel(T.ceildiv(tokens, tokens_per_block), threads=threads) as bx:
+            T.import_source(_CVT_HEADER)
+            tx = T.get_thread_binding()
+            token = bx * tokens_per_block + tx // per_token
+            item = tx % per_token
+            group, lane = item // lanes, item % lanes
+            col = group * group_size + lane * per_thread
+            values = T.alloc_local((per_thread,), T.float32)
+            amax = T.alloc_var(T.float32)
+            word = T.alloc_var(word_dtype)
+            amax = 0.0
+            if token < tokens:
+                for i in T.unroll(per_thread):
+                    values[i] = T.cast(kv[token, col + i], T.float32)
+                    amax = T.max(amax, T.abs(values[i]))
+            amax = T.max(amax, T.shfl_xor(amax, 1))
+            amax = T.max(amax, T.shfl_xor(amax, 2))
+            if lanes == 8:
+                amax = T.max(amax, T.shfl_xor(amax, 4))
+            if token < tokens:
+                slot = T.cast(slots[token], T.int64)
+                page = slot // page_size
+                if (slot >= 0) & (page < pages):
+                    base = (slot % page_size) * record
+                    word = T.cast(0, word_dtype)
+                    if cache_kind == "swa":
+                        bits = T.reinterpret(
+                            T.fmul(T.max(amax, 1e-4), T.float32(1.0 / _E4M3_MAX)),
+                            T.uint32,
+                        )
+                        bumped = T.if_then_else(
+                            (bits & 0x7FFFFF) != 0, (bits + 0x800000) & 0x7F800000, bits
+                        )
+                        exponent = T.cast(T.shift_right(bumped, 23) & 0xFF, T.int32)
+                        # The exact reciprocal of the power-of-two scale.
+                        inverse = T.reinterpret(
+                            T.cast(T.shift_left(254 - exponent, 23), T.uint32),
+                            T.float32,
+                        )
+                        word = T.call_extern(
+                            "uint32",
+                            "dsv41_e4m3x4",
+                            T.fmul(values[0], inverse),
+                            T.fmul(values[1], inverse),
+                            T.fmul(values[2], inverse),
+                            T.fmul(values[3], inverse),
+                        )
+                        words[page, (base + col) // word_bytes] = word
+                        if lane == 0:
+                            cache[page, base + payload + group] = T.cast(
+                                exponent, T.uint8
+                            )
+                    else:
+                        scale = T.max(amax, 6.0 * 2.0**-9) / 6.0
+                        scale_code = T.cast(T.min(scale, _E4M3_MAX), T.float8_e4m3fn)
+                        decoded = T.cast(scale_code, T.float32)
+                        word = T.call_extern(
+                            "uint16",
+                            "dsv41_e2m1x4",
+                            values[0] / decoded,
+                            values[1] / decoded,
+                            values[2] / decoded,
+                            values[3] / decoded,
+                        )
+                        words[page, (base + col // 2) // word_bytes] = word
+                        if lane == 0:
+                            cache[page, base + payload + group] = T.reinterpret(
+                                scale_code, T.uint8
+                            )
+
+    return cache_writer
+
+
+def write_cache(
+    kv: torch.Tensor,
+    cache: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    *,
+    page_size: int,
+    cache_kind: str,
+) -> None:
+    """Write ``kv`` ([T, 512] BF16, unit column stride) into ``cache`` (``[pages,
+    page bytes]`` or ``[pages, records, record bytes]`` bytes, any page stride) at
+    ``slot_mapping`` ([T] int32 or int64)."""
+    if kv.shape[0] == 0:
+        return
+    if kv.dtype != torch.bfloat16 or kv.shape[1] != DIM or kv.stride(1) != 1:
+        raise ValueError("V4.1 cache records come from [T, 512] BF16 rows")
+    pages = cache.view(torch.uint8)
+    if pages.dim() > 2:  # [pages, records, record bytes]
+        pages = pages.flatten(1)
+    if pages.shape[1] < page_size * RECORD_BYTES[cache_kind]:
+        raise ValueError(
+            f"cache pages hold fewer than {page_size} {cache_kind} records"
+        )
+    word_bytes, _, word_torch = _WORD[cache_kind]
+    if pages.stride(0) % word_bytes or pages.shape[1] % word_bytes:
+        raise ValueError(f"cache pages are not whole {word_bytes}-byte words")
+    function, args, kwargs = writer_call(cache_kind, page_size, slot_mapping.dtype)
+    kernel = function(*args, **kwargs)
+    kernel(kv, pages, pages.view(word_torch), slot_mapping)
+
+
+def writer_call(cache_kind: str, page_size: int, slot_dtype: torch.dtype):
+    """The kernel ``write_cache`` launches for ``slot_dtype`` slots, as a
+    ``prepare.call``."""
+    return prepare.call(
+        cache_writer_kernel,
+        cache_kind,
+        page_size,
+        str(slot_dtype).removeprefix("torch."),
+    )
+
+
+__all__ = ["RECORD_BYTES", "cache_writer_kernel", "write_cache", "writer_call"]
