+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Native vocabulary projections with the official logits-processing interface."""
+
+import torch
+from torch import nn
+
+from vllm.model_executor.layers.linear import UnquantizedLinearMethod
+from vllm.model_executor.layers.logits_processor import LogitsProcessor
+from vllm.model_executor.layers.vocab_parallel_embedding import (
+    ParallelLMHead,
+    UnquantizedEmbeddingMethod,
+)
+from vllm.model_executor.models.qwen3_dspark import DSparkMarkovHead
+from vllm.model_executor.models.utils import maybe_prefix
+
+from .packed_bf16 import PackedBf16LmHeadMethod
+
+
+class NativeLogitsProcessor(LogitsProcessor):
+    def __init__(self, vocab_size):
+        super().__init__(vocab_size)
+        self._tilelang_vocab_heads = []
+
+    def prepare_b12x_vocab_projection(self, head):
+        if isinstance(head.quant_method, PackedBf16LmHeadMethod):
+            return
+        if (
+            not isinstance(
+                head.quant_method, (UnquantizedEmbeddingMethod, UnquantizedLinearMethod)
+            )
+            or head.weight.dtype != torch.bfloat16
+        ):
+            raise ValueError("Native vocabulary projections require BF16 weights")
+        if not hasattr(head, "tilelang_vocab_dtype"):
+            head.tilelang_vocab_dtype = self.head_dtype or head.weight.dtype
+            self._tilelang_vocab_heads.append(head)
+
+    def declare_kernels(self):
+        from .tilelang.vocab import prepare_bf16_head
+
+        for head in self._tilelang_vocab_heads:
+            prepare_bf16_head(head, head.tilelang_vocab_dtype)
+
+    def _apply_head(self, lm_head, hidden_states, embedding_bias):
+        from .tilelang.vocab import project_head
+
+        if embedding_bias is not None:
+            raise ValueError("Native vocabulary projections do not support bias")
+        if not hasattr(lm_head, "tilelang_vocab"):
+            raise RuntimeError("Native vocabulary kernels have not been prepared")
+        if lm_head.tilelang_vocab_dtype != (self.head_dtype or hidden_states.dtype):
+            raise ValueError("Native vocabulary projection has the wrong output dtype")
+        flat = hidden_states.reshape(-1, hidden_states.shape[-1])
+        return project_head(lm_head, flat).reshape(*hidden_states.shape[:-1], -1)
+
+
+class NativeDSparkMarkovHead(DSparkMarkovHead):
+    def __init__(
+        self, vocab_size, draft_vocab_size, markov_rank, prefix, vocab_parallel=False
+    ):
+        nn.Module.__init__(self)
+        self.markov_w1 = nn.Embedding(vocab_size, markov_rank)
+        self.markov_w2 = ParallelLMHead(
+            draft_vocab_size,
+            markov_rank,
+            prefix=maybe_prefix(prefix, "markov_w2"),
+            disable_tp=not vocab_parallel,
+        )
+        self.markov_w2._retain_weight_for_gather = False
+        self.markov_w2.is_w4a16_nvfp4 = False
