+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""TileLang linear methods for DeepSeek-V4.1 (``--linear-backend tilelang``).
+
+Block-32 FP8 projections quantize activations to MXFP8 with TileKernels'
+per-token cast (DeepSeek's E4M3, one UE8M0 scale per 32 elements) and run
+``mxfp8_gemm``; decode rows go through whole 16-, 32- or 64-row activation
+tiles from the padded workspace. Unquantized projections run ``bf16_gemm``;
+projections with few output tiles (the router) split K over the SMs for
+decode rows and reduce the FP32 partials in a fixed order. Every path keeps
+each row's accumulation order fixed, so results do not depend on the batch.
+
+The kernels run inside custom ops, which keeps them opaque to torch.compile,
+and borrow activation scratch from vLLM's workspace.
+"""
+
+import functools
+import math
+from weakref import WeakValueDictionary
+
+import torch
+from torch import nn
+
+from vllm.model_executor.layers.linear import UnquantizedLinearMethod
+from vllm.models.deepseek_v4_1.quant_config import Block32FP8LinearMethod
+from vllm.models.deepseek_v4_1.tilelang import prepare
+from vllm.v1.worker.workspace import (
+    current_preallocated_workspace,
+    current_workspace_manager,
+    retain_cuda_graph_capture_resource,
+)
+
+from .gemm import (
+    BF16_SPLIT_ROWS,
+    DECODE_ROWS,
+    DECODE_TILE_ROWS,
+    SF_BLOCK,
+    SPLIT_BF16,
+    SPLIT_DECODE_ROWS,
+    SPLIT_FP8,
+    WIDE_DECODE,
+    bf16_gemm,
+    bf16_gemm_partials,
+    bf16_gemm_splitk,
+    bf16_gemm_two,
+    bf16_shards,
+    decode_tile_rows,
+    fp8_decode_config,
+    fp8_prefill_config,
+    mxfp8_gemm,
+    mxfp8_gemm_decode,
+    mxfp8_gemm_partials,
+    pack_scale_words,
+    scale_words,
+    split_bucket,
+    split_row_tile,
+    splitk_reduce,
+)
+
+_LAYERS: WeakValueDictionary[int, nn.Module] = WeakValueDictionary()
+_TORCH_TO_TL = {torch.bfloat16: "bfloat16", torch.float32: "float32"}
+
+
+def _tile_kernels():
+    import tile_kernels
+
+    return tile_kernels
+
+
+def _activation_specs(rows: int, k: int, decode_rows: int = DECODE_ROWS):
+    """MXFP8 activations and packed scales; decode rows fill whole tiles.
+
+    TileKernels pads each row's packed UE8M0 exponents to whole words. Rows
+    past ``rows`` in a decode tile are never stored by the GEMM. A layer whose
+    decode tiles serve more than DECODE_ROWS rows pads to whole DECODE_ROWS tiles.
+    """
+    if rows <= DECODE_ROWS:
+        tile_rows = DECODE_ROWS
+    elif rows <= decode_rows:
+        tile_rows = -(-rows // DECODE_ROWS) * DECODE_ROWS
+    else:
+        tile_rows = rows
+    return (
+        ((tile_rows, k), torch.float8_e4m3fn),
+        ((tile_rows, 4 * scale_words(k)), torch.uint8),
+    )
+
+
+# Row tiles of the split-K partials kernel. A 64-row tile computes one decode
+# row in twice the time of a 16-row tile; every height gives the same
+# partials bit for bit, so each row count takes the smallest tile that fits.
+PARTIAL_ROW_TILES = (16, 32, 64)
+
+
+def partials_kernel(layer: nn.Module, rows: int):
+    """The layer's split-K partials kernel with the smallest row tile for ``rows``."""
+    for block_M in PARTIAL_ROW_TILES:
+        if rows <= block_M:
+            return layer.tilelang_partials[block_M]
+    return layer.tilelang_partials[PARTIAL_ROW_TILES[-1]]
+
+
+def _partial_specs(layer: nn.Module, rows: int):
+    """FP32 split-K partials of a BF16 projection's decode rows, if it splits."""
+    shards = layer.tilelang_shards
+    if shards == 1 or rows > layer.tilelang_split_rows:
+        return ()
+    return (((shards, rows, layer.weight.shape[0]), torch.float32),)
+
+
+def _spec_bytes(specs) -> int:
+    total = 0
+    for shape, dtype in specs:
+        nbytes = dtype.itemsize
+        for dim in shape:
+            nbytes *= dim
+        total += (nbytes + 255) // 256 * 256
+    return total
+
+
+def _scratch(specs, scratch: torch.Tensor | None):
+    """Views of ``specs`` in the caller's scratch, else in vLLM's workspace."""
+    if scratch is None:
+        scratch = current_preallocated_workspace()
+    if scratch is not None:
+        return _carve(scratch.view(-1).view(torch.uint8), specs)
+    views = current_workspace_manager().get_simultaneous(*specs)
+    retain_cuda_graph_capture_resource(views[0])
+    return views
+
+
+def _carve(scratch: torch.Tensor, specs):
+    """Views of ``specs`` laid out back to back, 256-byte aligned, in ``scratch``."""
+    views, offset = [], 0
+    for shape, dtype in specs:
+        nbytes = dtype.itemsize
+        for dim in shape:
+            nbytes *= dim
+        views.append(scratch[offset : offset + nbytes].view(dtype).view(shape))
+        offset += (nbytes + 255) // 256 * 256
+    return views
+
+
+@torch.library.custom_op(
+    "vllm::dsv41_tilelang_block32_linear", mutates_args=("out", "scratch")
+)
+def _block32_linear(
+    x: torch.Tensor, out: torch.Tensor, key: int, scratch: torch.Tensor | None
+) -> None:
+    layer = _LAYERS[key]
+    n, k = layer.weight.shape
+    k *= layer.tilelang_groups  # a grouped weight reads every group's columns
+    x = x.reshape(-1, k)
+    rows = x.shape[0]
+    if layer.tilelang_shards > 1 and rows <= layer.tilelang_split_rows:
+        _block32_split(layer, x, out.view(rows, n), scratch)
+        return
+    xq, sf = _scratch(_activation_specs(rows, k, layer.tilelang_decode_rows), scratch)
+    _tile_kernels().quant.per_token_cast(
+        x,
+        "e4m3",
+        SF_BLOCK,
+        round_sf=True,
+        use_packed_ue8m0=True,
+        out=(xq[:rows], sf[:rows]),
+    )
+    _block32_gemm(layer, xq, sf, out.view(rows, n), rows)
+
+
+def _block32_gemm(layer, xq, sf, out, rows: int) -> None:
+    """The GEMM of a block-32 projection without split-K on its MXFP8 activations
+    (``_activation_specs`` buffers, the first ``rows`` rows live)."""
+    if rows > layer.tilelang_decode_rows:
+        gemm = layer.tilelang_prefill
+    else:
+        gemm = layer.tilelang_decode[decode_tile_rows(rows, layer.tilelang_wide)]
+    gemm(xq, layer.weight, sf.view(torch.uint32), layer.tilelang_weight_sf, out)
+
+
+@_block32_linear.register_fake
+def _block32_linear_fake(x, out, key, scratch):
+    return None
+
+
+def _split_specs(layer, rows: int):
+    """Split-K decode scratch: MXFP8 activations and scales padded to whole row
+    tiles, and the FP32 partials of the live rows."""
+    n, k = layer.weight.shape
+    tile = split_row_tile(rows)
+    padded = -(-rows // tile) * tile
+    return (
+        ((padded, k), torch.float8_e4m3fn),
+        ((padded, 4 * scale_words(k)), torch.uint8),
+        ((layer.tilelang_shards, rows, n), torch.float32),
+    )
+
+
+def _block32_split(layer, x: torch.Tensor, out: torch.Tensor, scratch) -> None:
+    rows = x.shape[0]
+    xq, sf, partials = _scratch(_split_specs(layer, rows), scratch)
+    _tile_kernels().quant.per_token_cast(
+        x,
+        "e4m3",
+        SF_BLOCK,
+        round_sf=True,
+        use_packed_ue8m0=True,
+        out=(xq[:rows], sf[:rows]),
+    )
+    layer.tilelang_partials[split_bucket(rows)](
+        xq, layer.weight, sf.view(torch.uint32), layer.tilelang_weight_sf, partials
+    )
+    layer.tilelang_reduce(partials, out)
+
+
+@torch.library.custom_op(
+    "vllm::dsv41_tilelang_bf16_linear", mutates_args=("out", "scratch")
+)
+def _bf16_linear(
+    x: torch.Tensor, out: torch.Tensor, key: int, scratch: torch.Tensor | None
+) -> None:
+    layer = _LAYERS[key]
+    n, k = layer.weight.shape
+    rows = x.numel() // k
+    x, out = x.reshape(rows, k), out.view(rows, n)
+    specs = _partial_specs(layer, rows)
+    if specs:
+        (partials,) = _scratch(specs, scratch)
+        partials_kernel(layer, rows)(x, layer.weight, partials)
+        layer.tilelang_reduce(partials, out)
+    else:
+        layer.tilelang_gemm(x, layer.weight, out)
+
+
+@_bf16_linear.register_fake
+def _bf16_linear_fake(x, out, key, scratch):
+    return None
+
+
+def _block32_kernels(n: int, k: int, groups: int = 1) -> dict:
+    """Every kernel of a block-32 FP8 projection of an E4M3 ``[n, k]`` weight, as the
+    calls ``_bind_block32`` makes.
+
+    With ``groups`` > 1 the weight stacks ``groups`` blocks of ``n / groups`` rows,
+    each applied to its own K columns of ``groups * k``-wide activations.
+    """
+    split = SPLIT_FP8.get((n, k)) if groups == 1 else None
+    if split:
+        # A narrow projection: split-K decode rows, and prefill tiles that add the
+        # same shards in the same order.
+        shards = split["shards"]
+        return {
+            "partials": {
+                bucket: prepare.call(
+                    mxfp8_gemm_partials, n, k, shards, block_M=min(bucket, 64), **config
+                )
+                for bucket, config in split["decode"].items()
+            },
+            "reduce": prepare.call(splitk_reduce, n, shards),
+            "prefill": prepare.call(
+                mxfp8_gemm, n, k, **split["prefill"], shards=shards
+            ),
+        }
+    part = n // groups
+    wide = WIDE_DECODE.get((n, k), {}) if groups == 1 else {}
+    # The wide decode table can name a tile taller than DECODE_ROWS (WO-B's 96).
+    heights = sorted({*DECODE_TILE_ROWS, *wide.values()})
+    return {
+        "decode": {
+            block_M: prepare.call(
+                mxfp8_gemm_decode,
+                part,
+                k,
+                **fp8_decode_config(part, k, block_M, groups),
+                padded_rows=True,
+                groups=groups,
+            )
+            for block_M in heights
+        },
+        "prefill": prepare.call(
+            mxfp8_gemm, part, k, **fp8_prefill_config(part, k, groups), groups=groups
+        ),
+    }
+
+
+def _calls(kernels: dict) -> list[prepare.TileLangCall]:
+    """The calls of a ``*_kernels`` table (values are calls or dicts of calls)."""
+    out = []
+    for value in kernels.values():
+        out.extend(value.values() if isinstance(value, dict) else [value])
+    return out
+
+
+def _launch(kernels: dict) -> dict:
+    """A ``*_kernels`` table with each call made (prepared: cache hits)."""
+
+    def make(entry):
+        function, args, kwargs = entry
+        return function(*args, **kwargs)
+
+    return {
+        name: {key: make(c) for key, c in value.items()}
+        if isinstance(value, dict)
+        else make(value)
+        for name, value in kernels.items()
+    }
+
+
+def _max_rows() -> int:
+    from vllm.config import get_current_vllm_config
+
+    return get_current_vllm_config().scheduler_config.max_num_batched_tokens
+
+
+@functools.cache
+def _warm_cast(k: int, rows: int) -> None:
+    """TileKernels' MXFP8 per-token cast of ``rows`` x ``k`` BF16 activations, run once
+    on zeros, so its kernel (keyed by K, the row stride and the small-batch bucket)
+    is compiled before the cache freezes."""
+    x = torch.zeros((rows, k), dtype=torch.bfloat16, device="cuda")
+    xq, sf = (
+        torch.empty(shape, dtype=dtype, device="cuda")
+        for shape, dtype in _activation_specs(rows, k)
+    )
+    _tile_kernels().quant.per_token_cast(
+        x,
+        "e4m3",
+        SF_BLOCK,
+        round_sf=True,
+        use_packed_ue8m0=True,
+        out=(xq[:rows], sf[:rows]),
+    )
+
+
+# TileKernels' per-token cast compiles a small-batch kernel for calls of at most this
+# many rows (SMALL_BATCH_THRESHOLD, a local of per_token_cast_impl; a test reads it).
+CAST_SMALL_BATCH_ROWS = 4096
+
+
+def _warm_casts(k: int) -> None:
+    """Each of TileKernels' cast buckets the projection can launch: small batches
+    always, large ones when a forward can exceed the small-batch rows."""
+    _warm_cast(k, 1)
+    if _max_rows() > CAST_SMALL_BATCH_ROWS:
+        _warm_cast(k, CAST_SMALL_BATCH_ROWS + 1)
+
+
+def _declare_block32(layer, groups: int = 1, cast: bool = True) -> None:
+    """Configure a block-32 FP8 projection of ``layer.weight`` (E4M3 ``[N, K]``),
+    register it for the custom op, and declare its kernels. ``cast=False``: the
+    caller hands the GEMMs MXFP8 activations (WO-B), so no per-token cast launches."""
+    n, k = layer.weight.shape
+    kernels = _block32_kernels(n, k, groups)
+    layer.tilelang_groups = groups
+    layer.tilelang_wide = WIDE_DECODE.get((n, k), {}) if groups == 1 else {}
+    layer.tilelang_decode_rows = max(layer.tilelang_wide, default=DECODE_ROWS)
+    split = SPLIT_FP8.get((n, k)) if groups == 1 else None
+    layer.tilelang_shards = split["shards"] if split else 1
+    if split:
+        layer.tilelang_split_rows = split["rows"]
+    layer.tilelang_key = id(layer)
+    _LAYERS[layer.tilelang_key] = layer
+
+    def bind() -> None:
+        for name, kernel in _launch(kernels).items():
+            setattr(layer, f"tilelang_{name}", kernel)
+
+    prepare.declare(
+        lambda: _calls(kernels),
+        bind=bind,
+        warm=(lambda: _warm_casts(k * groups)) if cast else None,
+    )
+
+
+def _block32_scale_words(layer) -> None:
+    """The 32x32 block scales become per-row words of four K32 exponents."""
+    layer.tilelang_weight_sf = pack_scale_words(
+        layer.weight_scale_inv.view(torch.uint8), rows=layer.weight.shape[0]
+    )
+
+
+def _apply_block32(layer, x: torch.Tensor) -> torch.Tensor:
+    out = torch.empty(
+        (*x.shape[:-1], layer.weight.shape[0]),
+        dtype=torch.bfloat16,
+        device=x.device,
+    )
+    scratch = (
+        None if torch.compiler.is_compiling() else current_preallocated_workspace()
+    )
+    _block32_linear(x, out, layer.tilelang_key, scratch)
+    return out
+
+
+class TileLangFP8LinearMethod(Block32FP8LinearMethod):
+    """Checkpoint block-32 FP8 weights with MXFP8 activations."""
+
+    def declare_layer_kernels(self, layer):
+        _declare_block32(layer)
+
+    def process_weights_after_loading(self, layer):
+        _block32_scale_words(layer)
+
+    def get_workspace_size(self, layer, num_tokens: int) -> int:
+        return _spec_bytes(
+            _activation_specs(
+                num_tokens, layer.weight.shape[1], layer.tilelang_decode_rows
+            )
+        )
+
+    def apply(self, layer, x, bias=None):
+        if bias is not None:
+            raise ValueError("V4.1 block32 projections require bias-free weights")
+        return _apply_block32(layer, x)
+
+
+class TileLangBlock32Rows:
+    """Output rows ``start:`` of a loaded block-32 FP8 projection as their own GEMM.
+
+    The DSpark drafter projects the target's hidden states through only the KV
+    rows of each layer's fused Q-A/KV weight. Views of the weight and its scales
+    share the checkpoint storage; the owner must keep this object alive.
+    """
+
+    def __init__(self, layer: nn.Module, start: int):
+        if start % 32:
+            raise ValueError(f"rows from {start} do not start on a 32-row scale block")
+        self.weight = layer.weight[start:]
+        self.weight_scale_inv = layer.weight_scale_inv[start // 32 :]
+        _block32_scale_words(self)
+
+    def declare_kernels(self) -> None:
+        """Declare the projection's kernels (its owner calls this when preparing)."""
+        _declare_block32(self)
+
+    def __call__(self, x: torch.Tensor) -> torch.Tensor:
+        return _apply_block32(self, x)
+
+
+def _out_dtype(layer: nn.Module) -> str:
+    """The layer's output dtype as the GEMMs name it (set after construction)."""
+    return _TORCH_TO_TL[getattr(layer, "out_dtype", torch.bfloat16)]
+
+
+def _bf16_kernels(layer: nn.Module) -> dict:
+    """Every kernel of a BF16 projection of ``layer.weight``, as calls."""
+    n, k = layer.weight.shape
+    out_dtype = _out_dtype(layer)
+    shards = bf16_shards(n, k)
+    kernels = {
+        "gemm": prepare.call(bf16_gemm, n, k, out_dtype=out_dtype, shards=shards)
+    }
+    if shards > 1:
+        kernels["partials"] = {
+            block_M: prepare.call(bf16_gemm_partials, n, k, shards, block_M=block_M)
+            for block_M in PARTIAL_ROW_TILES
+        }
+        kernels["reduce"] = prepare.call(splitk_reduce, n, shards, out_dtype=out_dtype)
+    return kernels
+
+
+class TileLangLinearMethod(UnquantizedLinearMethod):
+    """BF16 weights, BF16 or FP32 output (``layer.out_dtype``)."""
+
+    def declare_layer_kernels(self, layer: nn.Module) -> None:
+        n, k = layer.weight.shape
+        layer.tilelang_shards = bf16_shards(n, k)
+        layer.tilelang_split_rows = BF16_SPLIT_ROWS.get((n, k), DECODE_ROWS)
+        layer.tilelang_key = id(layer)
+        _LAYERS[layer.tilelang_key] = layer
+
+        def bind() -> None:
+            for name, kernel in _launch(_bf16_kernels(layer)).items():
+                setattr(layer, f"tilelang_{name}", kernel)
+
+        prepare.declare(lambda: _calls(_bf16_kernels(layer)), bind=bind)
+
+    def process_weights_after_loading(self, layer: nn.Module) -> None:
+        """The checkpoint weight is used as loaded."""
+
+    def apply(
+        self, layer: nn.Module, x: torch.Tensor, bias: torch.Tensor | None = None
+    ) -> torch.Tensor:
+        if bias is not None:
+            raise ValueError("V4.1 native projections require bias-free weights")
+        out = torch.empty(
+            (*x.shape[:-1], layer.weight.shape[0]),
+            dtype=getattr(layer, "out_dtype", torch.bfloat16),
+            device=x.device,
+        )
+        scratch = (
+            None if torch.compiler.is_compiling() else current_preallocated_workspace()
+        )
+        _bf16_linear(x, out, layer.tilelang_key, scratch)
+        return out
+
+    def get_workspace_size(self, layer, num_tokens: int) -> int:
+        return _spec_bytes(_partial_specs(layer, num_tokens))
+
+
+class TileLangScaledLinearMethod(TileLangLinearMethod):
+    """``TileLangLinearMethod`` with a power-of-two output scale folded into the
+    weight at load. Scaling by a power of two is exact in BF16 and commutes with
+    the FP32 accumulation, so the output equals the unscaled projection's times
+    ``scale``, bit for bit (checked on the weight), without a separate pass."""
+
+    def __init__(self, scale: float):
+        super().__init__()
+        if scale <= 0 or math.frexp(scale)[0] != 0.5:
+            raise ValueError(f"{scale} is not a power of two")
+        self.scale = scale
+
+    def process_weights_after_loading(self, layer: nn.Module) -> None:
+        weight = layer.weight.data
+        scaled = weight * self.scale
+        if not torch.equal(scaled / self.scale, weight):
+            raise ValueError(f"{self.scale} does not scale this weight exactly")
+        weight.copy_(scaled)
+
+
+class TileLangSplitLinearMethod(UnquantizedLinearMethod):
+    """A BF16 weight of equal row blocks (the compressor's wkv and wgate), each
+    projected into its own output by one launch over the whole weight.
+
+    Decode rows (up to ``SPLIT_DECODE_ROWS``) split K over the SMs and add the FP32
+    partials in shard order into the outputs; prefill rows run one GEMM that adds
+    the same shards in the same order, so a row's bits do not depend on the batch.
+    """
+
+    def __init__(self, parts: int):
+        super().__init__()
+        if parts not in (1, 2):
+            raise ValueError("the split projection has one or two parts")
+        self.parts = parts
+
+    def _split(self, layer: nn.Module) -> dict:
+        n, k = layer.weight.shape
+        split = SPLIT_BF16.get((n, k)) or dict(shards=bf16_shards(n, k), blocked=False)
+        decode = split.get("decode", {})
+        if any("block_K" in config for config in decode.values()):
+            raise ValueError(
+                "split-K decode tiles keep block_K (it sets the sum order)"
+            )
+        return dict(shards=split["shards"], blocked=split["blocked"], decode=decode)
+
+    def _kernels(self, layer: nn.Module) -> dict:
+        """Every kernel of the split projection, as calls."""
+        n, k = layer.weight.shape
+        out_dtype = _out_dtype(layer)
+        split = self._split(layer)
+        shards, blocked, decode = split["shards"], split["blocked"], split["decode"]
+        if self.parts == 2:
+            gemm = prepare.call(
+                bf16_gemm_two,
+                n // 2,
+                k,
+                out_dtype=out_dtype,
+                shards=shards,
+                blocked=blocked,
+            )
+        else:
+            gemm = prepare.call(
+                bf16_gemm, n, k, out_dtype=out_dtype, shards=shards, blocked=blocked
+            )
+        # Decode rows: one launch per call (the last CTA of a tile adds the shards).
+        splitk = {
+            block_M: prepare.call(
+                bf16_gemm_splitk,
+                n,
+                k,
+                shards,
+                block_M=block_M,
+                out_dtype=out_dtype,
+                parts=self.parts,
+                blocked=blocked,
+                **decode.get(block_M, {}),
+            )
+            for block_M in PARTIAL_ROW_TILES
+        }
+        return {"gemm": gemm, "splitk": splitk}
+
+    def declare_layer_kernels(self, layer: nn.Module) -> None:
+        n, k = layer.weight.shape
+        if n % self.parts:
+            raise ValueError(f"{n} rows do not split into {self.parts} parts")
+        layer.tilelang_parts = self.parts
+        layer.tilelang_shards = self._split(layer)["shards"]
+        layer.tilelang_key = id(layer)
+        _LAYERS[layer.tilelang_key] = layer
+
+        def bind() -> None:
+            for name, kernel in _launch(self._kernels(layer)).items():
+                setattr(layer, f"tilelang_{name}", kernel)
+            # One zeroed counter per tile of the narrowest decode tile; every
+            # call leaves them zeroed.
+            decode = self._split(layer)["decode"]
+            block_N = min(
+                config.get("block_N", 64) for config in (*decode.values(), {})
+            )
+            layer.tilelang_counters = torch.zeros(
+                (-(-SPLIT_DECODE_ROWS // PARTIAL_ROW_TILES[0])) * (-(-n // block_N)),
+                dtype=torch.int32,
+                device=layer.weight.device,
+            )
+
+        prepare.declare(lambda: _calls(self._kernels(layer)), bind=bind)
+
+    def get_workspace_size(self, layer, num_tokens: int) -> int:
+        rows = min(num_tokens, SPLIT_DECODE_ROWS)
+        n = layer.weight.shape[0]
+        return _spec_bytes((((layer.tilelang_shards, rows, n), torch.float32),))
+
+
+def _split_bf16(x, outputs, key, scratch) -> None:
+    layer = _LAYERS[key]
+    n, k = layer.weight.shape
+    rows = x.shape[0]
+    if rows <= SPLIT_DECODE_ROWS:
+        (partials,) = _scratch(
+            (((layer.tilelang_shards, rows, n), torch.float32),), scratch
+        )
+        block_M = next(
+            (bm for bm in PARTIAL_ROW_TILES if rows <= bm), PARTIAL_ROW_TILES[-1]
+        )
+        layer.tilelang_splitk[block_M](
+            x, layer.weight, partials, layer.tilelang_counters, *outputs
+        )
+    else:
+        layer.tilelang_gemm(x, layer.weight, *outputs)
+
+
+@torch.library.custom_op(
+    "vllm::dsv41_tilelang_split_linear_one", mutates_args=("out", "scratch")
+)
+def _split_linear_one(
+    x: torch.Tensor, out: torch.Tensor, key: int, scratch: torch.Tensor | None
+) -> None:
+    _split_bf16(x, (out,), key, scratch)
+
+
+@_split_linear_one.register_fake
+def _split_linear_one_fake(x, out, key, scratch):
+    return None
+
+
+@torch.library.custom_op(
+    "vllm::dsv41_tilelang_split_linear_two", mutates_args=("out0", "out1", "scratch")
+)
+def _split_linear_two(
+    x: torch.Tensor,
+    out0: torch.Tensor,
+    out1: torch.Tensor,
+    key: int,
+    scratch: torch.Tensor | None,
+) -> None:
+    _split_bf16(x, (out0, out1), key, scratch)
+
+
+@_split_linear_two.register_fake
+def _split_linear_two_fake(x, out0, out1, key, scratch):
+    return None
+
+
+def project_parts(layer: nn.Module, x: torch.Tensor, outputs, rows: int) -> None:
+    """Project ``x`` (rows x K) through a split layer: each row block into the
+    first ``rows`` rows of its output."""
+    scratch = (
+        None if torch.compiler.is_compiling() else current_preallocated_workspace()
+    )
+    if layer.tilelang_parts == 2:
+        _split_linear_two(
+            x, outputs[0][:rows], outputs[1][:rows], layer.tilelang_key, scratch
+        )
+    else:
+        _split_linear_one(x, outputs[0][:rows], layer.tilelang_key, scratch)
+
+
+__all__ = [
+    "TileLangBlock32Rows",
+    "TileLangFP8LinearMethod",
+    "TileLangLinearMethod",
+    "TileLangScaledLinearMethod",
+    "TileLangSplitLinearMethod",
+    "project_parts",
+]
diff --git a/vllm/models/deepseek_v4_1/tilelang/metadata.py b/vllm/models/deepseek_v4_1/tilelang/metadata.py
new file mode 100644
index 0000000000000000000000000000000000000000..332cd731aeeb9884d8088d37addac214aba887b1
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/tilelang/metadata.py
@@ -0,0 +1,401 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""TileLang sparse-MLA metadata for DeepSeek-V4.1: integer kernels, exact.
+
+The same contracts as the Triton kernels they replace (``sparse_mla._requests``,
+``_tokens``, ``attention._chunk`` and ``_pages``), element for element, including
+which rows each launch writes:
+
+- ``requests``: request starts (``nt`` past the live requests), each request's first
+  position (``seq - query``, -1 past them) and the live counts ``[nt, nr]``.
+- ``tokens``: per token its request, position, ring or paged slot (-1 unless the
+  state is emitted) and visible compressed length, over the rows of the first
+  ``ceil(nt / 128)`` blocks of 128 (the readable domain; capacity rows past it keep
+  their contents).
+- ``chunk``: per row its sliding-window page indices (-1 holes), window length and
+  top-k length.
+- ``pages``: per row its request's page table, block 0 and holes as -1.
+"""
+
+# No `from __future__ import annotations`: TileLang reads the prim_func
+# annotations eagerly, and the symbolic shape must resolve.
+import tilelang
+import tilelang.language as T
+
+_PASS = {tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True}
+_BLOCK = 128
+_TOP = 512  # top-k length cap
+
+
+def _search_steps(requests: int) -> int:
+    """Binary-search iterations over ``requests`` (+1 for the empty tail)."""
+    return max(1, (requests + 1).bit_length())
+
+
+@tilelang.jit(pass_configs=_PASS)
+def requests_kernel(max_requests: int):
+    starts_len = T.dynamic("starts_len")
+    seq_len = T.dynamic("seq_len")
+
+    @T.prim_func
+    def metadata_requests(
+        starts: T.Tensor((starts_len,), T.int32),
+        seq: T.Tensor((seq_len,), T.int32),
+        out_starts: T.Tensor((max_requests + 1,), T.int32),
+        positions: T.Tensor((max_requests,), T.int64),
+        counts: T.Tensor((2,), T.int32),
+        nr: T.int32,
+        nt: T.int32,
+    ):
+        with T.Kernel(T.ceildiv(max_requests + 1, _BLOCK), threads=_BLOCK) as bx:
+            r = bx * _BLOCK + T.get_thread_binding()
+            if r <= max_requests:
+                start = T.if_then_else(r <= nr, starts[r], nt)
+                end = T.if_then_else(r < nr, starts[r + 1], nt)
+                out_starts[r] = start
+                if r < max_requests:
+                    positions[r] = T.if_then_else(
+                        r < nr,
+                        T.Cast(T.int64, seq[r] - (end - start)),
+                        T.int64(-1),
+                    )
+            if r == 0:
+                counts[0] = nt
+                counts[1] = nr
+
+    return metadata_requests
+
+
+@tilelang.jit(pass_configs=_PASS)
+def tokens_kernel(max_requests: int, page: int, ratio: int, circular: bool):
+    cover = T.dynamic("cover")  # rows written: the first ceil(nt / 128) blocks
+    starts_len = T.dynamic("starts_len")
+    seq_len = T.dynamic("seq_len")
+    table_rows = T.dynamic("table_rows")
+    table_cols = T.dynamic("table_cols")
+    table_stride = T.dynamic("table_stride")
+    slot_rows = T.dynamic("slot_rows")
+    steps = _search_steps(max_requests)
+
+    @T.prim_func
+    def metadata_tokens(
+        starts: T.Tensor((starts_len,), T.int32),
+        seq: T.Tensor((seq_len,), T.int32),
+        table: T.StridedTensor((table_rows, table_cols), (table_stride, 1), T.int32),
+        input_slots: T.Tensor((slot_rows,), T.int64),
+        positions: T.Tensor((cover,), T.int64),
+        reqs: T.Tensor((cover,), T.int32),
+        slots: T.Tensor((cover,), T.int64),
+        visible: T.Tensor((cover,), T.int32),
+        nr: T.int32,
+        nt: T.int32,
+    ):
+        with T.Kernel(T.ceildiv(cover, _BLOCK), threads=_BLOCK) as bx:
+            t = bx * _BLOCK + T.get_thread_binding()
+            bounds = T.alloc_local((2,), T.int32)
+            if t < cover:
+                # The request whose rows contain t (Triton's upper-bound search).
+                bounds[0] = 0
+                bounds[1] = nr
+                for _ in T.serial(steps):
+                    if bounds[0] < bounds[1]:
+                        mid = (bounds[0] + bounds[1]) // 2
+                        end_mid = T.if_then_else(mid < nr, starts[mid + 1], nt)
+                        if end_mid <= t:
+                            bounds[0] = mid + 1
+                        else:
+                            bounds[1] = mid
+                lo = bounds[0]
+                live = (t < nt) & (lo < nr)
+                start = T.if_then_else(live, starts[lo], 0)
+                end = T.if_then_else(live, starts[lo + 1], 0)
+                sq = T.if_then_else(live, seq[lo], 0)
+                pos = T.Cast(T.int64, sq) - T.Cast(T.int64, end - start) + (t - start)
+                input_slot = T.if_then_else(t < nt, input_slots[t], T.int64(-1))
+                if circular:
+                    valid0 = live & (pos >= 0)
+                else:
+                    valid0 = live & (pos >= 0) & (input_slot >= 0)
+                logical = T.truncdiv(pos, ratio)
+                page_col = T.int64(0) if circular else T.truncdiv(logical, page)
+                valid1 = valid0 & (page_col < table_cols)
+                block = T.if_then_else(
+                    valid1, T.Cast(T.int64, table[lo, page_col]), T.int64(0)
+                )
+                valid = valid1 & (block > 0)
+                slot = block * page + T.truncmod(logical, page)
+                emit = valid & (T.truncmod(pos + 1, ratio) == 0)
+                if circular:
+                    # Only a request's last ring-size rows take a ring slot: the
+                    # earlier rows of a long chunk would share them.
+                    emit = emit & (t >= end - page)
+                positions[t] = T.if_then_else(valid, pos, T.int64(-1))
+                reqs[t] = T.if_then_else(valid, lo, -1)
+                slots[t] = T.if_then_else(emit, slot, T.int64(-1))
+                visible[t] = T.if_then_else(
+                    valid, T.Cast(T.int32, T.truncdiv(pos + 1, ratio)), 0
+                )
+
+    return metadata_tokens
+
+
+def _window_macro(page, window, width, draft, replay, threads, per_thread):
+    """One row's sliding-window metadata (``attention._chunk``), for a block of
+    ``threads`` threads."""
+
+    @T.macro
+    def window_row(
+        row, tx, info, positions, reqs, table, swa, lengths, top_lengths, visible,
+        starts, request_positions, replay_start, offset,
+    ):  # fmt: skip
+        req = reqs[offset + row]
+        pos = positions[offset + row]
+        valid = (req >= 0) & (pos >= 0)
+        if draft:
+            first = T.if_then_else(valid, T.Cast(T.int64, starts[req]), T.int64(0))
+            end = T.if_then_else(valid, T.Cast(T.int64, starts[req + 1]), T.int64(0))
+            prefix = T.if_then_else(valid, request_positions[req], T.int64(0))
+            info[0] = T.max(prefix - window, T.int64(0))
+            length = prefix + end - first - info[0]
+        else:
+            info[0] = T.max(pos + 1 - window, T.int64(0))
+            if replay:
+                info[0] = T.max(
+                    info[0], T.if_then_else(valid, replay_start[req], T.int64(0))
+                )
+            length = pos + 1 - info[0]
+        info[1] = T.if_then_else(
+            valid, T.min(T.max(length, T.int64(0)), T.int64(width)), T.int64(0)
+        )
+        for k in T.serial(per_thread):
+            col = k * threads + tx
+            if col < width:
+                logical = info[0] + col
+                inside = valid & (logical >= 0) & (col < info[1])
+                page_id = T.if_then_else(
+                    inside,
+                    T.Cast(T.int64, table[req, T.truncdiv(logical, page)]),
+                    T.int64(-1),
+                )
+                physical = page_id * page + T.truncmod(logical, page)
+                swa[row, col] = T.if_then_else(
+                    (page_id > 0) & (logical >= 0) & (col < info[1]),
+                    T.Cast(T.int32, physical),
+                    -1,
+                )
+        if tx == 0:
+            lengths[row] = T.Cast(T.int32, T.max(info[1], T.int64(0)))
+            top_lengths[row] = T.if_then_else(
+                valid, T.min(T.max(visible[offset + row], 0), _TOP), 0
+            )
+
+    return window_row
+
+
+def _threads(width: int) -> tuple[int, int]:
+    threads = min(256, max(32, (width + 31) // 32 * 32))
+    return threads, (width + threads - 1) // threads
+
+
+@tilelang.jit(pass_configs=_PASS)
+def chunk_kernel(page: int, window: int, width: int, draft: bool, replay: bool):
+    rows = T.dynamic("rows")
+    src_rows = T.dynamic("src_rows")
+    table_rows = T.dynamic("table_rows")
+    table_cols = T.dynamic("table_cols")
+    table_stride = T.dynamic("table_stride")
+    req_count = T.dynamic("req_count")
+    starts_len = T.dynamic("starts_len")
+    replay_len = T.dynamic("replay_len")
+    threads, per_thread = _threads(width)
+    window_row = _window_macro(page, window, width, draft, replay, threads, per_thread)
+
+    @T.prim_func
+    def metadata_chunk(
+        positions: T.Tensor((src_rows,), T.int64),
+        reqs: T.Tensor((src_rows,), T.int32),
+        table: T.StridedTensor((table_rows, table_cols), (table_stride, 1), T.int32),
+        swa: T.Tensor((rows, width), T.int32),
+        lengths: T.Tensor((rows,), T.int32),
+        top_lengths: T.Tensor((rows,), T.int32),
+        visible: T.Tensor((src_rows,), T.int32),
+        starts: T.Tensor((starts_len,), T.int32),
+        request_positions: T.Tensor((req_count,), T.int64),
+        replay_start: T.Tensor((replay_len,), T.int64),
+        offset: T.int32,
+    ):
+        with T.Kernel(rows, threads=threads) as row:
+            tx = T.get_thread_binding()
+            info = T.alloc_local((2,), T.int64)  # window start, clamped length
+            window_row(
+                row, tx, info, positions, reqs, table, swa, lengths, top_lengths,
+                visible, starts, request_positions, replay_start, offset,
+            )  # fmt: skip
+
+    return metadata_chunk
+
+
+@tilelang.jit(pass_configs=_PASS)
+def decode_metadata_kernel(
+    page: int, window: int, width: int, draft: bool, replay: bool, main_width: int
+):
+    """``chunk`` and ``pages`` of the main cache in one launch, a block for each part
+    of each row: the window metadata and the main page table (block 0 and holes as
+    -1)."""
+    rows = T.dynamic("rows")
+    src_rows = T.dynamic("src_rows")
+    table_rows = T.dynamic("table_rows")
+    table_cols = T.dynamic("table_cols")
+    table_stride = T.dynamic("table_stride")
+    main_src_rows = T.dynamic("main_src_rows")
+    main_rows = T.dynamic("main_rows")
+    main_cols = T.dynamic("main_cols")
+    main_stride = T.dynamic("main_stride")
+    req_count = T.dynamic("req_count")
+    starts_len = T.dynamic("starts_len")
+    replay_len = T.dynamic("replay_len")
+    # Blocks as wide as the window part; the page part loops (idle threads cost the
+    # prefill rows' blocks).
+    threads, per_thread = _threads(width)
+    window_row = _window_macro(page, window, width, draft, replay, threads, per_thread)
+    main_per_thread = (main_width + threads - 1) // threads
+
+    @T.prim_func
+    def metadata_decode(
+        positions: T.Tensor((src_rows,), T.int64),
+        reqs: T.Tensor((src_rows,), T.int32),
+        table: T.StridedTensor((table_rows, table_cols), (table_stride, 1), T.int32),
+        swa: T.Tensor((rows, width), T.int32),
+        lengths: T.Tensor((rows,), T.int32),
+        top_lengths: T.Tensor((rows,), T.int32),
+        visible: T.Tensor((src_rows,), T.int32),
+        starts: T.Tensor((starts_len,), T.int32),
+        request_positions: T.Tensor((req_count,), T.int64),
+        replay_start: T.Tensor((replay_len,), T.int64),
+        main_reqs: T.Tensor((main_src_rows,), T.int32),
+        main_table: T.StridedTensor((main_rows, main_cols), (main_stride, 1), T.int32),
+        main_pages: T.Tensor((rows, main_width), T.int32),
+        offset: T.int32,
+        main_read_width: T.int32,
+    ):
+        # Two blocks a row, one launch: the window metadata, then the page table.
+        with T.Kernel(rows, 2, threads=threads) as (row, part):
+            tx = T.get_thread_binding()
+            info = T.alloc_local((2,), T.int64)  # window start, clamped length
+            if part == 0:
+                window_row(
+                    row, tx, info, positions, reqs, table, swa, lengths, top_lengths,
+                    visible, starts, request_positions, replay_start, offset,
+                )  # fmt: skip
+            else:
+                req = main_reqs[offset + row]
+                for k in T.serial(main_per_thread):
+                    col = k * threads + tx
+                    if col < main_width:
+                        page_id = T.if_then_else(
+                            (req >= 0) & (col < main_read_width),
+                            main_table[req, col],
+                            -1,
+                        )
+                        main_pages[row, col] = T.if_then_else(page_id > 0, page_id, -1)
+
+    return metadata_decode
+
+
+@tilelang.jit(pass_configs=_PASS)
+def pages_kernel(width: int):
+    rows = T.dynamic("rows")
+    src_rows = T.dynamic("src_rows")
+    table_rows = T.dynamic("table_rows")
+    table_cols = T.dynamic("table_cols")
+    table_stride = T.dynamic("table_stride")
+
+    @T.prim_func
+    def metadata_pages(
+        reqs: T.Tensor((src_rows,), T.int32),
+        table: T.StridedTensor((table_rows, table_cols), (table_stride, 1), T.int32),
+        out: T.Tensor((rows, width), T.int32),
+        offset: T.int32,
+        read_width: T.int32,
+    ):
+        with T.Kernel(rows, T.ceildiv(width, _BLOCK), threads=_BLOCK) as (row, cb):
+            col = cb * _BLOCK + T.get_thread_binding()
+            if col < width:
+                req = reqs[offset + row]
+                page_id = T.if_then_else(
+                    (req >= 0) & (col < read_width), table[req, col], -1
+                )
+                # vLLM reserves physical block zero; page tables use -1 for holes.
+                out[row, col] = T.if_then_else(page_id > 0, page_id, -1)
+
+    return metadata_pages
+
+
+def requests(starts, seq, out_starts, positions, counts, nr: int, nt: int) -> None:
+    """``sparse_mla._requests``."""
+    requests_kernel(positions.shape[0])(
+        starts, seq, out_starts, positions, counts, nr, nt
+    )
+
+
+def tokens(
+    starts, seq, table, input_slots, positions, reqs, slots, visible, nr: int,
+    nt: int, *, max_requests: int, page: int, ratio: int, circular: bool,
+) -> None:  # fmt: skip
+    """``sparse_mla._tokens``: rows of the first ``max(1, ceil(nt / 128))`` blocks."""
+    cover = min(positions.shape[0], max(1, -(-nt // _BLOCK)) * _BLOCK)
+    tokens_kernel(max_requests, page, ratio, circular)(
+        starts, seq, table, input_slots, positions[:cover], reqs[:cover],
+        slots[:cover], visible[:cover], nr, nt,
+    )  # fmt: skip
+
+
+def chunk(
+    positions, reqs, table, swa, lengths, top_lengths, visible, starts,
+    request_positions, offset: int, rows: int, *, page: int, window: int,
+    draft: bool, replay_start=None,
+) -> None:  # fmt: skip
+    """``attention._chunk`` for ``rows`` rows from source row ``offset``."""
+    width = swa.shape[1]
+    replay = replay_start is not None and not draft
+    chunk_kernel(page, window, width, draft, replay)(
+        positions, reqs, table, swa[:rows], lengths[:rows], top_lengths[:rows],
+        visible, starts, request_positions,
+        replay_start if replay_start is not None else request_positions, offset,
+    )  # fmt: skip
+
+
+def decode_metadata(
+    positions, reqs, table, swa, lengths, top_lengths, visible, starts,
+    request_positions, main_reqs, main_table, main_pages, offset: int, rows: int,
+    main_read_width: int, *, page: int, window: int, draft: bool, replay_start=None,
+) -> None:  # fmt: skip
+    """``chunk`` then ``pages`` of the main cache for ``rows`` rows, one launch."""
+    width, main_width = swa.shape[1], main_pages.shape[1]
+    replay = replay_start is not None and not draft
+    decode_metadata_kernel(page, window, width, draft, replay, main_width)(
+        positions, reqs, table, swa[:rows], lengths[:rows], top_lengths[:rows],
+        visible, starts, request_positions,
+        replay_start if replay_start is not None else request_positions, main_reqs,
+        main_table, main_pages[:rows], offset, main_read_width,
+    )  # fmt: skip
+
+
+def pages(reqs, table, out, offset: int, rows: int, read_width: int) -> None:
+    """``attention._pages`` for ``rows`` rows from source row ``offset``; ``out`` is
+    ``[*, width]`` and columns at or past ``read_width`` are -1."""
+    pages_kernel(out.shape[1])(reqs, table, out[:rows], offset, read_width)
+
+
+__all__ = [
+    "chunk",
+    "chunk_kernel",
+    "decode_metadata",
+    "decode_metadata_kernel",
+    "pages",
+    "pages_kernel",
+    "requests",
+    "requests_kernel",
+    "tokens",
+    "tokens_kernel",
+]
diff --git a/vllm/models/deepseek_v4_1/tilelang/mhc.py b/vllm/models/deepseek_v4_1/tilelang/mhc.py
new file mode 100644
index 0000000000000000000000000000000000000000..ea229b519116a14f9ed7a20c5ef6793b2375ae44
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/tilelang/mhc.py
@@ -0,0 +1,699 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""DeepSeek-V4.1 lagged mHC on TileKernels (``--linear-backend tilelang``).
+
+V4.1's hyper-connections keep four residual streams. Each sublayer's ``pre``
+projects the flattened streams through ``fn`` (RMS-normalized), splits the 24
+mixes into a pre-mix (sigmoid), a post-mix (2 * sigmoid) and a 4 x 4
+combination (softmax, then Sinkhorn), and feeds the sublayer the streams
+collapsed with the *incoming* pre-mix, RMS-normalized with the norm weight.
+The new pre-mix is returned for the next sublayer (the lag). ``post`` folds a
+sublayer's output back into the streams.
+
+TileKernels provides DeepSeek's mHC kernels. A standalone ``post`` and the
+final stream collapse use them as they are. A sublayer's entry needs more:
+DeepSeek moved the projection GEMM to DeepGEMM, which does not run on
+SM120/SM121, TileKernels' fused pre step applies the mix it has just computed
+rather than the lagged one, and in prefill the four streams are large enough
+that reading them once matters. Two TileLang kernels make each entry:
+
+- ``project_streams``: per hidden block, the previous sublayer's ``post``
+  (writing the updated streams), the projection's split partials on TF32
+  tensor cores at FP32 precision (fn split into exact TF32 parts) with the
+  streams' sum of squares, and
+  the streams collapsed with the incoming pre-mix in BF16, with its sum of
+  squares. Each thread folds and accumulates one token's columns in
+  registers; the GEMM reads the folded streams from shared memory. The split
+  is fixed and every token tile accumulates in the same order, so a token's
+  results do not depend on the batch.
+- ``finalize``: per token, TileKernels' fused reduce, RMS, mix split and
+  Sinkhorn (``mhc_pre_big_fuse``), emitting the new pre-mix, beside the
+  collapse's RMSNorm with the sublayer's weight.
+"""
+
+from functools import cache
+
+import tilelang
+import tilelang.language as T
+import torch
+from torch import nn
+
+from vllm.distributed import get_tensor_model_parallel_world_size
+from vllm.models.deepseek_v4_1 import sp_prefill
+from vllm.models.deepseek_v4_1.tilelang import prepare
+from vllm.models.deepseek_v4_1.tilelang.collectives import RankOrderParts
+from vllm.v1.worker.workspace import (
+    current_workspace_manager,
+    retain_cuda_graph_capture_resource,
+)
+
+MULT = 4  # residual streams
+MIXES = (2 + MULT) * MULT  # pre, post and combination mixes
+BLOCK_H = 128  # hidden columns per projection split, fixed for batch invariance
+BLOCK_M = 16  # token tile of project_streams; larger tiles measured slower
+VEC = 8  # BF16 elements per vector access
+
+_PASS_CONFIGS = {
+    tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True,
+    tilelang.PassConfigKey.TL_DISABLE_VECTORIZE_256: True,
+}
+
+
+@tilelang.jit(pass_configs=_PASS_CONFIGS)
+def project_streams(
+    hidden_size: int,
+    mode: str,
+    block_M: int = 16,
+    block_H: int = BLOCK_H,
+    world: int = 1,
+):
+    """The streams' projection partials and their collapse, for one hidden block.
+
+    ``mode`` is the sublayer's entry: ``"post_pre"`` first folds the previous
+    sublayer's output into the streams (``post``) and writes them, ``"pre"``
+    reads streams already updated, and ``"broadcast"`` expands an embedding to
+    four copies (the first layer, whose ``fn`` is the stream blocks summed).
+    ``X`` is ``(world, M, H)``: with ``world`` > 1 (``"post_pre"`` only) the
+    previous output arrives as the ranks' unreduced partials, which each thread
+    adds in FP32 in rank order and rounds once, as the rank-order reduce-scatter
+    does, so the output has the same bits as that sum read back.
+
+    Each CTA owns ``block_H`` hidden columns of every stream, a K split of the
+    projection, for ``block_M`` tokens. Each thread owns one token's
+    ``block_H / 8`` contiguous columns: it loads them for every stream into
+    registers, folds the previous output in, writes the updated streams, and
+    keeps its share of the streams' sum of squares ``S`` and of the collapse
+    with the incoming pre-mix. The projection ``P = streams @ fn^T`` runs on
+    TF32 tensor cores at FP32 precision, one stream at a time: the streams are
+    BF16 (exact in TF32) and each FP32 ``fn`` value is split exactly into three
+    TF32-representable parts, so every product is exact and the three GEMMs
+    accumulate in FP32, as DeepSeek's reference computes the mixes. The
+    collapse is rounded to BF16, with its sum of squares ``Q``.
+    """
+    assert hidden_size % block_H == 0 and mode in ("pre", "post_pre", "broadcast")
+    assert 1 <= world <= 4 and (world == 1 or mode == "post_pre")
+    splits = hidden_size // block_H
+    streams = 1 if mode == "broadcast" else MULT
+    K = streams * hidden_size
+    N = 32  # the 24 mixes, padded
+    LANES = 8  # threads per token: adjacent lanes of one warp
+    COLS = block_H // LANES  # contiguous columns per thread
+    threads = block_M * LANES
+    H = hidden_size
+    M = T.dynamic("M")
+
+    @T.macro
+    def load_split_tf32(Fn, k0, F_shared, F_mid, F_low):
+        # fn = high + middle + low, each exact in TF32 (11 significant bits): the
+        # high part keeps fn's top 11 bits, the middle the next 11, the low the rest.
+        # Each value goes from global memory through registers into the three tiles
+        # in one pass.
+        for i, j in T.Parallel(MIXES, block_H):
+            f = Fn[i, k0 + j]
+            high = T.reinterpret(T.reinterpret(f, T.uint32) & 0xFFFFE000, T.float32)
+            rest = f - high
+            middle = T.reinterpret(
+                T.reinterpret(rest, T.uint32) & 0xFFFFE000, T.float32
+            )
+            F_shared[i, j] = high
+            F_mid[i, j] = middle
+            F_low[i, j] = rest - middle
+
+    @T.prim_func
+    def mhc_project_streams(
+        X: T.Tensor((world, M, H), T.bfloat16),
+        R: T.Tensor((M, MULT * H), T.bfloat16),
+        post: T.Tensor((M, MULT), T.float32),
+        comb: T.Tensor((M, MULT, MULT), T.float32),
+        pre_in: T.Tensor((M, MULT), T.float32),
+        Fn: T.Tensor((MIXES, K), T.float32),
+        R_out: T.Tensor((M, MULT * H), T.bfloat16),
+        P: T.Tensor((splits, M, 1, MIXES), T.float32),
+        S: T.Tensor((splits, M, 1), T.float32),
+        C: T.Tensor((M, H), T.bfloat16),
+        Q: T.Tensor((splits, M), T.float32),
+    ):
+        with T.Kernel(splits, T.ceildiv(M, block_M), threads=threads) as (sp, by):
+            h0 = sp * block_H
+            A_shared = T.alloc_shared((block_M, block_H), T.float32)
+            F_shared = T.alloc_shared((N, block_H), T.float32)
+            F_mid = T.alloc_shared((N, block_H), T.float32)
+            F_low = T.alloc_shared((N, block_H), T.float32)
+            C_local = T.alloc_fragment((block_M, N), T.float32)
+            xv = T.alloc_local((COLS,), T.bfloat16)
+            rv = T.alloc_local((MULT * COLS,), T.bfloat16)
+            nv = T.alloc_local((COLS,), T.bfloat16)
+            av = T.alloc_local((COLS,), T.float32)
+            sq = T.alloc_local((COLS,), T.float32)
+            col = T.alloc_local((COLS,), T.float32)
+            coef = T.alloc_local((2 * MULT + MULT * MULT,), T.float32)
+            red = T.alloc_local((1,), T.float32)
+            tx = T.get_thread_binding()
+            row = tx // LANES
+            c0 = (tx % LANES) * COLS
+            token = by * block_M + row
+            src = T.min(token, M - 1)
+            T.clear(C_local)
+            # The padding mixes stay zero; each stream's copy fills the rest.
+            for i, j in T.Parallel(N - MIXES, block_H):
+                F_shared[MIXES + i, j] = 0.0
+                F_mid[MIXES + i, j] = 0.0
+                F_low[MIXES + i, j] = 0.0
+            # This thread's token: its mixes, then its columns of x and the streams.
+            for k in T.unroll(MULT):
+                coef[k] = pre_in[src, k]
+            if mode == "post_pre":
+                for k in T.unroll(MULT):
+                    coef[MULT + k] = post[src, k]
+                for k in T.unroll(MULT * MULT):
+                    coef[2 * MULT + k] = comb[src, k // MULT, k % MULT]
+            if mode != "pre" and world == 1:
+                for v in T.vectorized(COLS):
+                    xv[v] = X[0, src, h0 + c0 + v]
+            if world > 1:
+                # The first part as is (signed zeros survive), then the others.
+                for r in T.unroll(world):
+                    for v in T.vectorized(COLS):
+                        xv[v] = X[r, src, h0 + c0 + v]
+                    for v in T.unroll(COLS):
+                        if r == 0:
+                            av[v] = T.Cast(T.float32, xv[v])
+                        else:
+                            av[v] = av[v] + T.Cast(T.float32, xv[v])
+                for v in T.unroll(COLS):
+                    xv[v] = T.Cast(T.bfloat16, av[v])
+            if mode != "broadcast":
+                for m in T.unroll(MULT):
+                    for v in T.vectorized(COLS):
+                        rv[m * COLS + v] = R[src, m * H + h0 + c0 + v]
+            for v in T.unroll(COLS):
+                sq[v] = 0.0
+                col[v] = 0.0
+
+            if mode == "broadcast":
+                # Four copies of the embedding; fn already sums the blocks.
+                for v in T.unroll(COLS):
+                    av[v] = T.Cast(T.float32, xv[v])
+                    A_shared[row, c0 + v] = av[v]
+                    sq[v] = av[v] * av[v]
+                for n in T.unroll(MULT):
+                    if token < M:
+                        for v in T.vectorized(COLS):
+                            R_out[token, n * H + h0 + c0 + v] = xv[v]
+                    for v in T.unroll(COLS):
+                        col[v] += coef[n] * av[v]
+                load_split_tf32(Fn, h0, F_shared, F_mid, F_low)
+                T.sync_threads()
+                T.gemm(A_shared, F_shared, C_local, transpose_B=True)
+                T.gemm(A_shared, F_mid, C_local, transpose_B=True)
+                T.gemm(A_shared, F_low, C_local, transpose_B=True)
+            else:
+                for n in T.unroll(MULT):
+                    if mode == "post_pre":
+                        # post[n] * x + sum_m comb[m, n] * streams[m], in FP32.
+                        for v in T.unroll(COLS):
+                            av[v] = coef[MULT + n] * T.Cast(T.float32, xv[v])
+                            for m in T.unroll(MULT):
+                                av[v] += coef[2 * MULT + m * MULT + n] * T.Cast(
+                                    T.float32, rv[m * COLS + v]
+                                )
+                            nv[v] = T.Cast(T.bfloat16, av[v])
+                        if token < M:
+                            for v in T.vectorized(COLS):
+                                R_out[token, n * H + h0 + c0 + v] = nv[v]
+                    else:
+                        for v in T.unroll(COLS):
+                            nv[v] = rv[n * COLS + v]
+                    for v in T.unroll(COLS):
+                        av[v] = T.Cast(T.float32, nv[v])
+                        A_shared[row, c0 + v] = av[v]
+                        sq[v] += av[v] * av[v]
+                        col[v] += coef[n] * av[v]
+                    load_split_tf32(Fn, n * H + h0, F_shared, F_mid, F_low)
+                    T.sync_threads()
+                    T.gemm(A_shared, F_shared, C_local, transpose_B=True)
+                    T.gemm(A_shared, F_mid, C_local, transpose_B=True)
+                    T.gemm(A_shared, F_low, C_local, transpose_B=True)
+                    T.sync_threads()
+
+            # The collapse in BF16 and its sum of squares, then the streams'.
+            for v in T.unroll(COLS):
+                nv[v] = T.Cast(T.bfloat16, col[v])
+            if token < M:
+                for v in T.vectorized(COLS):
+                    C[token, h0 + c0 + v] = nv[v]
+            red[0] = 0.0
+            for v in T.unroll(COLS):
+                red[0] += T.Cast(T.float32, nv[v]) * T.Cast(T.float32, nv[v])
+            red[0] += T.shfl_xor(red[0], 4)
+            red[0] += T.shfl_xor(red[0], 2)
+            red[0] += T.shfl_xor(red[0], 1)
+            if tx % LANES == 0 and token < M:
+                Q[sp, token] = red[0]
+            red[0] = 0.0
+            for v in T.unroll(COLS):
+                red[0] += sq[v]
+            red[0] += T.shfl_xor(red[0], 4)
+            red[0] += T.shfl_xor(red[0], 2)
+            red[0] += T.shfl_xor(red[0], 1)
+            if tx % LANES == 0 and token < M:
+                S[sp, token, 0] = red[0]
+            for i, j in T.Parallel(block_M, MIXES):
+                if by * block_M + i < M:
+                    P[sp, by * block_M + i, 0, j] = C_local[i, j]
+
+    return mhc_project_streams
+
+
+@tilelang.jit(pass_configs=_PASS_CONFIGS)
+def finalize(
+    hidden_size: int,
+    rms_group_size: int,
+    rms_eps: float,
+    hc_eps: float,
+    sinkhorn_repeat: int,
+    norm_eps: float,
+    post_mult: float = 2.0,
+    block_H: int = BLOCK_H,
+    threads: int = 128,
+):
+    """One token per CTA: warp 0 turns the projection partials into the new
+    pre-mix, the post-mix and the Sinkhorn combination (TileKernels'
+    ``mhc_pre_big_fuse``); the other warps RMS-normalize the collapse."""
+    assert hidden_size % VEC == 0
+    splits = hidden_size // block_H
+    chunks = hidden_size // VEC
+    workers = threads - 32
+    M = T.dynamic("M")
+
+    @T.prim_func
+    def mhc_finalize(
+        P: T.Tensor((splits, M, 1, MIXES), T.float32),
+        S: T.Tensor((splits, M, 1), T.float32),
+        C: T.Tensor((M, hidden_size), T.bfloat16),
+        Q: T.Tensor((splits, M), T.float32),
+        scale: T.Tensor((3,), T.float32),
+        base: T.Tensor((MIXES,), T.float32),
+        weight: T.Tensor((hidden_size,), T.bfloat16),
+        post: T.Tensor((M, MULT), T.float32),
+        comb: T.Tensor((M, MULT, MULT), T.float32),
+        pre_out: T.Tensor((M, MULT), T.float32),
+        y: T.Tensor((M, hidden_size), T.bfloat16),
+    ):
+        with T.Kernel(M, threads=threads) as pid:
+            tx = T.get_thread_binding()
+            mixes_shared = T.alloc_shared((MIXES,), T.float32)
+            xv = T.alloc_local((VEC,), T.bfloat16)
+            wv = T.alloc_local((VEC,), T.bfloat16)
+            yv = T.alloc_local((VEC,), T.bfloat16)
+            total = T.alloc_local((1,), T.float32)
+
+            if tx < 32:
+                # Reduce the split partials; RMS over the flattened streams.
+                rms = T.alloc_fragment(1, T.float32)
+                mixes = T.alloc_fragment(MIXES, T.float32)
+                rms[0] = 0
+                for i_split in T.serial(splits):
+                    rms[0] += S[i_split, pid, 0]
+                rms[0] = T.rsqrt(rms[0] / rms_group_size + rms_eps)
+                for j in T.Parallel(MIXES):
+                    mixes[j] = 0
+                    for i_split in T.serial(splits):
+                        mixes[j] += P[i_split, pid, 0, j]
+                    mixes[j] *= rms[0]
+                T.copy(mixes, mixes_shared, disable_tma=True)
+
+            if tx < 32:
+                # The new pre-mix, the post-mix and the Sinkhorn combination.
+                cm = T.alloc_fragment((MULT, MULT), T.float32)
+                for j in T.Parallel(MULT):
+                    pre_out[pid, j] = (
+                        T.sigmoid(mixes_shared[j] * scale[0] + base[j]) + hc_eps
+                    )
+                    post[pid, j] = (
+                        T.sigmoid(mixes_shared[j + MULT] * scale[1] + base[j + MULT])
+                        * post_mult
+                    )
+                for j, k in T.Parallel(MULT, MULT):
+                    cm[j, k] = (
+                        mixes_shared[j * MULT + k + MULT * 2] * scale[2]
+                        + base[j * MULT + k + MULT * 2]
+                    )
+                row_sum = T.alloc_fragment(MULT, T.float32)
+                col_sum = T.alloc_fragment(MULT, T.float32)
+                row_max = T.alloc_fragment(MULT, T.float32)
+                T.reduce_max(cm, row_max, dim=1)
+                for j, k in T.Parallel(MULT, MULT):
+                    cm[j, k] = T.exp(cm[j, k] - row_max[j])
+                T.reduce_sum(cm, row_sum, dim=1)
+                for j, k in T.Parallel(MULT, MULT):
+                    cm[j, k] = cm[j, k] / row_sum[j] + hc_eps
+                T.reduce_sum(cm, col_sum, dim=0)
+                for j, k in T.Parallel(MULT, MULT):
+                    cm[j, k] = cm[j, k] / (col_sum[k] + hc_eps)
+                for _ in T.serial(sinkhorn_repeat - 1):
+                    T.reduce_sum(cm, row_sum, dim=1)
+                    for j, k in T.Parallel(MULT, MULT):
+                        cm[j, k] = cm[j, k] / (row_sum[j] + hc_eps)
+                    T.reduce_sum(cm, col_sum, dim=0)
+                    for j, k in T.Parallel(MULT, MULT):
+                        cm[j, k] = cm[j, k] / (col_sum[k] + hc_eps)
+                for j, k in T.Parallel(MULT, MULT):
+                    comb[pid, j, k] = cm[j, k]
+            else:
+                # RMSNorm of the collapse, with the sublayer's weight.
+                worker = tx - 32
+                total[0] = 0
+                for i_split in T.serial(splits):
+                    total[0] += Q[i_split, pid]
+                total[0] = T.rsqrt(total[0] / hidden_size + norm_eps)
+                for step in T.serial(T.ceildiv(chunks, workers)):
+                    chunk = step * workers + worker
+                    if chunk < chunks:
+                        for v in T.vectorized(VEC):
+                            yv[v] = C[pid, chunk * VEC + v]
+                        for v in T.vectorized(VEC):
+                            wv[v] = weight[chunk * VEC + v]
+                        for v in T.unroll(VEC):
+                            xv[v] = T.Cast(
+                                T.bfloat16,
+                                T.Cast(T.float32, yv[v])
+                                * total[0]
+                                * T.Cast(T.float32, wv[v]),
+                            )
+                        for v in T.vectorized(VEC):
+                            y[pid, chunk * VEC + v] = xv[v]
+
+    return mhc_finalize
+
+
+def _project_call(hidden: int, mode: str, world: int) -> prepare.TileLangCall:
+    """The ``project_streams`` call of a sublayer entry."""
+    return prepare.call(project_streams, hidden, mode, block_M=BLOCK_M, world=world)
+
+
+def _finalize_call(
+    hidden: int, k: int, rms_eps: float, hc_eps: float, iterations: int
+) -> prepare.TileLangCall:
+    """The ``finalize`` call of a sublayer entry projecting ``k`` stream columns."""
+    return prepare.call(finalize, hidden, k, rms_eps, hc_eps, iterations, rms_eps)
+
+
+def _make(call: prepare.TileLangCall):
+    function, args, kwargs = call
+    return function(*args, **kwargs)
+
+
+@cache
+def _project(hidden: int, mode: str, world: int):
+    return _make(_project_call(hidden, mode, world))
+
+
+@cache
+def _finalize(hidden: int, k: int, rms_eps: float, hc_eps: float, iterations: int):
+    return _make(_finalize_call(hidden, k, rms_eps, hc_eps, iterations))
+
+
+def _tile_kernels_mhc():
+    import tile_kernels
+
+    return tile_kernels.mhc
+
+
+@torch.library.custom_op(
+    "vllm::dsv41_tilelang_mhc_pre",
+    mutates_args=("residual_out", "y", "post", "comb", "pre_out"),
+)
+def _mhc_pre(
+    residual: torch.Tensor,
+    fn: torch.Tensor,
+    scale: torch.Tensor,
+    base: torch.Tensor,
+    norm: torch.Tensor,
+    pre: torch.Tensor,
+    residual_out: torch.Tensor | None,
+    y: torch.Tensor,
+    post: torch.Tensor,
+    comb: torch.Tensor,
+    pre_out: torch.Tensor,
+    rms_eps: float,
+    hc_eps: float,
+    iterations: int,
+    previous_output: torch.Tensor | None = None,
+    previous_post: torch.Tensor | None = None,
+    previous_comb: torch.Tensor | None = None,
+) -> None:
+    tokens, hidden = int(residual.shape[0]), int(residual.shape[-1])
+    if tokens == 0:
+        return
+    streams = MULT * hidden
+    world = 1
+    # Unused operands of a mode take a buffer of the right shape; none is read.
+    if previous_output is not None:
+        # (T, H), or the ranks' unreduced partials of it, (world, T, H).
+        if previous_output.ndim == 3:
+            world = int(previous_output.shape[0])
+        mode, x, k = "post_pre", previous_output, streams
+        source, updated = residual.view(tokens, streams), residual_out
+        mix_post, mix_comb = previous_post, previous_comb
+    elif residual.ndim == 2:
+        mode, x, k = "broadcast", residual, hidden
+        source, updated = residual_out.view(tokens, streams), residual_out
+        mix_post, mix_comb = pre, comb
+    else:
+        mode, x, k = "pre", y, streams
+        source = residual.view(tokens, streams)
+        updated, mix_post, mix_comb = source, pre, comb
+    splits = hidden // BLOCK_H
+    scratch = current_workspace_manager().get_simultaneous(
+        ((splits, tokens, 1, MIXES), torch.float32),
+        ((splits, tokens, 1), torch.float32),
+        ((tokens, hidden), torch.bfloat16),
+        ((splits, tokens), torch.float32),
+    )
+    retain_cuda_graph_capture_resource(scratch)
+    P, S, C, Q = scratch
+    _project(hidden, mode, world)(
+        x if x.ndim == 3 else x.unsqueeze(0),
+        source,
+        mix_post,
+        mix_comb,
+        pre,
+        fn,
+        updated.view(tokens, streams),
+        P,
+        S,
+        C,
+        Q,
+    )
+    _finalize(hidden, k, rms_eps, hc_eps, iterations)(
+        P, S, C, Q, scale, base, norm, post, comb, pre_out, y
+    )
+
+
+@_mhc_pre.register_fake
+def _mhc_pre_fake(
+    residual,
+    fn,
+    scale,
+    base,
+    norm,
+    pre,
+    residual_out,
+    y,
+    post,
+    comb,
+    pre_out,
+    rms_eps,
+    hc_eps,
+    iterations,
+    previous_output=None,
+    previous_post=None,
+    previous_comb=None,
+):
+    return None
+
+
+@torch.library.custom_op("vllm::dsv41_tilelang_mhc_post", mutates_args=("out",))
+def _mhc_post(
+    x: torch.Tensor,
+    residual: torch.Tensor,
+    post: torch.Tensor,
+    comb: torch.Tensor,
+    out: torch.Tensor,
+) -> None:
+    tokens, hidden = int(residual.shape[0]), int(residual.shape[-1])
+    if tokens == 0:
+        return
+    _tile_kernels_mhc().mhc_post_fwd(
+        x.view(1, tokens, hidden),
+        residual.view(1, tokens, MULT, hidden),
+        post.view(1, tokens, MULT, 1),
+        comb.view(1, tokens, MULT, MULT),
+        out=out.view(1, tokens, MULT, hidden),
+    )
+
+
+@_mhc_post.register_fake
+def _mhc_post_fake(x, residual, post, comb, out):
+    return None
+
+
+@torch.library.custom_op("vllm::dsv41_tilelang_mhc_collapse", mutates_args=("out",))
+def _mhc_collapse(state: torch.Tensor, mix: torch.Tensor, out: torch.Tensor) -> None:
+    if state.shape[0] == 0:
+        return
+    _tile_kernels_mhc().mhc_pre_apply_mix_fwd(state, mix, out)
+
+
+@_mhc_collapse.register_fake
+def _mhc_collapse_fake(state, mix, out):
+    return None
+
+
+@cache
+def _warm_post_and_collapse(hidden: int) -> None:
+    """TileKernels' post and stream collapse, run once on one zero token, so their
+    eager kernels (keyed by the stream count, the hidden size and TileKernels' PDL
+    switch) are compiled before the cache freezes."""
+    x = torch.zeros((1, hidden), dtype=torch.bfloat16, device="cuda")
+    residual = torch.zeros((1, MULT, hidden), dtype=torch.bfloat16, device="cuda")
+    mix = torch.zeros((1, MULT), dtype=torch.float32, device="cuda")
+    comb = torch.zeros((1, MULT, MULT), dtype=torch.float32, device="cuda")
+    _mhc_post(x, residual, mix, comb, torch.empty_like(residual))
+    _mhc_collapse(residual, mix, torch.empty_like(x))
+
+
+class TileKernelsMHC(nn.Module):
+    """V4.1 lagged mHC for a decoder layer, with ``B12xMHC``'s interface."""
+
+    def __init__(self, config):
+        super().__init__()
+        if config.hc_mult != MULT:
+            raise ValueError("V4.1 mHC requires four streams")
+        self.hidden_size = config.hidden_size
+        self.rms_eps = config.rms_norm_eps
+        self.hc_eps = config.hc_eps
+        self.iterations = config.hc_sinkhorn_iters
+
+    def _entries(self) -> list[tuple[str, int]]:
+        """The (mode, world) of every sublayer entry this layer can launch."""
+        entries = [(mode, 1) for mode in ("pre", "post_pre", "broadcast")]
+        if sp_prefill.unreduced_enabled():
+            # Sequence-parallel steps hand post_pre the ranks' unreduced parts.
+            entries.append(("post_pre", get_tensor_model_parallel_world_size()))
+        return entries
+
+    def declare_kernels(self) -> None:
+        """Declare every sublayer entry's kernels and warm TileKernels' post and
+        stream collapse, so that no forward (or CUDA graph capture) compiles."""
+        hidden = self.hidden_size
+        entries = self._entries()
+        # The broadcast entry projects one stream; the others all four.
+        widths = (hidden, MULT * hidden)
+        mix = (self.rms_eps, self.hc_eps, self.iterations)
+
+        def calls() -> list[prepare.TileLangCall]:
+            return [
+                *(_project_call(hidden, mode, world) for mode, world in entries),
+                *(_finalize_call(hidden, k, *mix) for k in widths),
+            ]
+
+        def bind() -> None:
+            # The forward's cached kernels, as its lookups name them.
+            for mode, world in entries:
+                _project(hidden, mode, world)
+            for k in widths:
+                _finalize(hidden, k, *mix)
+
+        prepare.declare(calls, bind=bind, warm=lambda: _warm_post_and_collapse(hidden))
+
+    def pre(
+        self,
+        residual,
+        fn,
+        scale,
+        base,
+        norm,
+        pre,
+        *,
+        previous_output=None,
+        previous_post=None,
+        previous_comb=None,
+    ):
+        tokens, device = int(residual.shape[0]), residual.device
+        if isinstance(previous_output, RankOrderParts):
+            # Added inside the projection kernel, in rank order.
+            previous_output = previous_output.packed
+        if pre is None:
+            pre = torch.zeros((tokens, MULT), dtype=torch.float32, device=device)
+            pre[:, 0].fill_(1)
+        unchanged = previous_output is None and residual.ndim == 3
+        residual_out = (
+            None
+            if unchanged
+            else torch.empty(
+                (tokens, MULT, self.hidden_size), dtype=residual.dtype, device=device
+            )
+        )
+        y = torch.empty((tokens, self.hidden_size), dtype=residual.dtype, device=device)
+        post = torch.empty((tokens, MULT), dtype=torch.float32, device=device)
+        comb = torch.empty((tokens, MULT, MULT), dtype=torch.float32, device=device)
+        pre_out = torch.empty((tokens, MULT), dtype=torch.float32, device=device)
+        _mhc_pre(
+            residual,
+            fn,
+            scale,
+            base,
+            norm,
+            pre,
+            residual_out,
+            y,
+            post,
+            comb,
+            pre_out,
+            self.rms_eps,
+            self.hc_eps,
+            self.iterations,
+            previous_output,
+            previous_post,
+            previous_comb,
+        )
+        return residual if unchanged else residual_out, post, comb, y, pre_out
+
+    def post_pre(self, x, residual, post, comb, fn, scale, base, norm, pre):
+        return self.pre(
+            residual,
+            fn,
+            scale,
+            base,
+            norm,
+            pre,
+            previous_output=x,
+            previous_post=post,
+            previous_comb=comb,
+        )
+
+    def post(self, x, residual, post, comb):
+        if isinstance(x, RankOrderParts):
+            x = x.sum()
+        out = torch.empty_like(residual)
+        _mhc_post(x, residual, post, comb, out)
+        return out
+
+    def collapse(
+        self, state: torch.Tensor, pre: torch.Tensor | None = None
+    ) -> torch.Tensor:
+        """The streams' weighted sum with ``pre``, or their mean."""
+        if pre is None:
+            pre = torch.full(
+                (state.shape[0], MULT), 0.25, dtype=torch.float32, device=state.device
+            )
+        out = torch.empty(
+            (state.shape[0], state.shape[-1]), dtype=state.dtype, device=state.device
+        )
+        _mhc_collapse(state, pre, out)
+        return out
+
+
+__all__ = ["TileKernelsMHC", "finalize", "project_streams"]
