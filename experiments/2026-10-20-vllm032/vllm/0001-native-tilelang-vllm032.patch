@@ -0,0 +1,53 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import torch
+from torch.utils._python_dispatch import TorchDispatchMode
+from torch.utils._pytree import tree_flatten
+
+
+class DirectCheckpointCopies(TorchDispatchMode):
+    _metadata = {
+        "aten::alias",
+        "aten::as_strided",
+        "aten::detach",
+        "aten::narrow",
+        "aten::permute",
+        "aten::select",
+        "aten::slice",
+        "aten::split",
+        "aten::split_with_sizes",
+        "aten::t",
+        "aten::transpose",
+        "aten::unbind",
+        "aten::view",
+        "aten::_unsafe_view",
+        "prim::device",
+        "prim::dtype",
+        "prim::layout",
+    }
+
+    def __init__(self, session):
+        super().__init__()
+        self.session = session
+
+    def __torch_dispatch__(self, func, types, args=(), kwargs=None):
+        kwargs = kwargs or {}
+        if func is torch.ops.aten.copy_.default:
+            destination, source = args[:2]
+            if destination.is_cuda and self.session(destination, source):
+                return destination
+            if source.is_meta and not destination.is_meta:
+                raise RuntimeError("Direct checkpoint copy requires a CUDA destination")
+        tensors = [
+            value
+            for value in tree_flatten((args, kwargs))[0]
+            if isinstance(value, torch.Tensor)
+        ]
+        if func._schema.name not in self._metadata:
+            if any(t.is_meta for t in tensors):
+                raise NotImplementedError(
+                    f"Direct checkpoint metadata requires an explicit transform: {func}"
+                )
+            if any(t.is_cuda for t in tensors):
+                self.session.flush()
+        return func(*args, **kwargs)
