+def test_disk_rows_register_original_checkpoint_ranges(tmp_path):
+    path = tmp_path / "model.safetensors"
+    save_file(
+        {
+            "embed.weight": torch.arange(32, dtype=torch.uint8).reshape(4, 8),
+            "embed.scale": torch.ones((4, 1), dtype=torch.uint8),
+        },
