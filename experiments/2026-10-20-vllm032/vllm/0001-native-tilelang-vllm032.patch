+def test_unsupported_meta_transform_releases_session(tmp_path):
+    session = DirectWeightSession.__new__(DirectWeightSession)
+    fd = os.open(tmp_path / "checkpoint", os.O_CREAT | os.O_RDWR, 0o600)
+    session.shared_read_group = None
