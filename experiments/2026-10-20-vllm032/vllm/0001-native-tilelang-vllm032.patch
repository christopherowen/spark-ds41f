--- /dev/null
+++ b/vllm/models/deepseek_v4_1/min_tokens.py
@@ -0,0 +1,82 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import torch
+
+from vllm.model_executor.warmup.jit_warmup_triton_helper import (
+    TritonWarmupTensor,
+    triton_kernel_dispatcher_with_warmup,
+    triton_warmup_inputs,
+)
+from vllm.triton_utils import tl, triton
+from vllm.v1.worker.gpu.sample.logit_bias import MAX_NUM_STOP_TOKEN_IDS
+
+
+@triton.jit
+def _mask_kernel(
+    logits,
+    logits_stride,
+    positions,
+    requests,
+    min_lens,
+    stop_counts,
+    stop_ids,
+    stop_stride,
+    vocab_start,
+    vocab,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    request = tl.load(requests + row).to(tl.int64)
+    position = tl.load(positions + row)
+    min_len = tl.load(min_lens + request, request >= 0, other=0)
+    if (request >= 0) & (position + 1 < min_len):
+        count = tl.load(stop_counts + request)
+        index = tl.arange(0, BLOCK)
+        token = tl.load(
+            stop_ids + request * stop_stride + index, index < count, other=-1
+        )
+        column = token - vocab_start
+        owned = (index < count) & (column >= 0) & (column < vocab)
+        tl.store(logits + row * logits_stride + column, -float("inf"), owned)
+
+
+def _warmup_inputs(*, dtype, stride, stop_stride, vocab_start, vocab):
+    int32 = TritonWarmupTensor(torch.int32)
+    return triton_warmup_inputs(
+        _mask_kernel,
+        TritonWarmupTensor(dtype),
+        stride,
+        TritonWarmupTensor(torch.int64),
+        TritonWarmupTensor(torch.int64),
+        int32,
+        int32,
+        int32,
+        stop_stride,
+        vocab_start,
+        vocab,
+        grid=(1,),
+        BLOCK=MAX_NUM_STOP_TOKEN_IDS,
+    )
+
+
+_mask = triton_kernel_dispatcher_with_warmup(warmup_inputs=_warmup_inputs)(_mask_kernel)
+
+
+def register_min_token_mask(**kwargs):
+    _mask.register_warmup(**kwargs)
+
+
+def mask_min_tokens(logits, positions, requests, bias, vocab_start, vocab):
+    _mask[(logits.shape[0],)](
+        logits,
+        logits.stride(0),
+        positions,
+        requests,
+        bias.min_lens.gpu,
+        bias.num_stop_token_ids.gpu,
+        bias.stop_token_ids.gpu,
+        bias.stop_token_ids.gpu.stride(0),
+        vocab_start,
+        vocab,
+        BLOCK=MAX_NUM_STOP_TOKEN_IDS,
+    )
diff --git a/vllm/models/deepseek_v4_1/mxfp4_csf.py b/vllm/models/deepseek_v4_1/mxfp4_csf.py
