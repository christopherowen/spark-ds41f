+def test_mixed_shard_preserves_tables_without_reading_payload(checkpoint, monkeypatch):
+    loader, path, tensors = checkpoint
+    session = DirectWeightSession.__new__(DirectWeightSession)
+    session.files, session.file_identities, session.sources = [], {}, {}
+    session.shared_read_group = session.reader = None
+    session.metadata_bytes = 0
+    reads = []
+
+    def read(reader, fd, offset, count):
+        reads.append((offset, count))
+        return os.pread(fd, count, offset)
+
+    session.native = SimpleNamespace(direct_bytes=read)
+    loader._session = session
+    source = DefaultModelLoader.Source(
+        str(path.parent),
+        None,
+        prefix="mapped.",
+        file_weight_filter=lambda name: name.endswith(("embed.weight", "embed.scale")),
+        is_unused_weight=lambda name: name == "unused",
+    )
+    original_open = os.open
+    monkeypatch.setattr(
+        "b12x.loader._checkpoint.os.open",
+        lambda path, flags: original_open(path, flags & ~os.O_DIRECT),
+    )
+    try:
+        pairs = dict(loader._get_weights_iterator(source))
+        assert len(pairs) == 7 and "mapped.unused" not in pairs
+        for name in ("embed.weight", "embed.scale"):
+            tensor = pairs["mapped.layers.4.engram." + name]
+            descriptor = get_file_tensor_source(tensor)
+            assert descriptor.path == str(path)
+            assert descriptor.shape == tuple(tensors["layers.4.engram." + name].shape)
+            assert tensor.is_meta
+            assert tensor.untyped_storage()._cdata not in session.sources
+        for name in ("q_weight", "k_weight", "wkv.weight", "wkv.scale"):
+            tensor = pairs["mapped.layers.4.engram." + name]
+            assert tensor.is_meta
+            assert tensor.untyped_storage()._cdata in session.sources
+        assert torch.equal(
+            pairs["mapped.layer_multipliers"], tensors["layer_multipliers"]
+        )
+        with path.open("rb") as checkpoint_file:
+            payload_start = 8 + int.from_bytes(checkpoint_file.read(8), "little")
+        payload_reads = [count for offset, count in reads if offset >= payload_start]
+        assert payload_reads == [tensors["layer_multipliers"].nbytes]
+    finally:
+        for fd in session.files:
+            os.close(fd)
