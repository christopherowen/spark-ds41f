index 0000000000000000000000000000000000000000..c6cf61f69f82bc9787e92b769536fd554074b6ac
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/greedy.py
@@ -0,0 +1,201 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import os
+
+import numpy as np
+
+from vllm.distributed import get_tensor_model_parallel_world_size
+from vllm.v1.worker.gpu.input_batch import get_num_sampled_and_rejected
+from vllm.v1.worker.gpu.sample.bad_words import BadWordsState
+from vllm.v1.worker.gpu.sample.logit_bias import LogitBiasState
+from vllm.v1.worker.gpu.sample.output import SamplerOutput
+from vllm.v1.worker.gpu.sample.penalties import PenaltiesState
+from vllm.v1.worker.gpu.sample.sampler import Sampler
+from vllm.v1.worker.gpu.spec_decode.rejection_sampler import (
+    RejectionSampler,
+    gather_draft_sampled,
+)
+
+from .greedy_verification import (
+    greedy_rejection_sample,
+    register_greedy_verification_warmups,
+    vocab_parallel_argmax,
+)
+from .logits import NativeLogitsProcessor
+
+
+def _language_model(model):
+    while getattr(model, "lm_head", None) is None and hasattr(model, "language_model"):
+        model = model.language_model
+    return model
+
+
+def _available(runner):
+    cached = getattr(runner, "_native_greedy_verification", None)
+    if cached is not None:
+        return cached
+    model = _language_model(runner.model)
+    head = getattr(model, "lm_head", None)
+    processor = getattr(model, "logits_processor", None)
+    sampler = runner.sampler
+    rejection = runner.rejection_sampler
+    runner._native_greedy_verification = bool(
+        os.environ.get("VLLM_GREEDY_VERIFICATION", "1") == "1"
+        and type(rejection) is RejectionSampler
+        and rejection.watermark_key is None
+        and rejection.synthetic_conditional_rates is None
+        and type(sampler) is Sampler
+        and not sampler.compute_nans
+        and not sampler.return_sampling_mask
+        and sampler.trace_replay_state is None
+        and all(
+            type(p) in {LogitBiasState, PenaltiesState, BadWordsState}
+            for p in sampler.logits_processors
+        )
+        and runner.batch_sharder is None
+        and callable(getattr(runner.model, "compute_logits_local", None))
+        and hasattr(getattr(head, "shard_indices", None), "num_org_elements")
+        and type(processor) is NativeLogitsProcessor
+        and processor.scale == 1.0
+        and processor.soft_cap is None
+    )
+    return runner._native_greedy_verification
+
+
+def _default_processors(sampler):
+    processors = sampler.logits_processors
+    if tuple(type(p) for p in processors) != (
+        LogitBiasState,
+        PenaltiesState,
+        BadWordsState,
+    ):
+        return None
+    return processors
+
+
+def _minimum_token_bias(sampler, idx):
+    if os.environ.get("SPARK3_GREEDY_MIN_TOKENS", "0") != "1":
+        return None
+    processors = _default_processors(sampler)
+    if processors is None:
+        return None
+    bias, penalties, bad_words = processors
+    thinking = sampler.thinking_budget_state
+    states = sampler.sampling_states
+    if (
+        np.any(bias.num_allowed_token_ids.np[idx])
+        or np.any(bias.num_logit_bias.np[idx])
+        or np.any(bias.restore_when_all_masked.np[idx])
+        or np.any(penalties.use_penalty[idx])
+        or np.any(bad_words.num_bad_words.np[idx])
+        or (thinking.enabled and np.any(thinking.use_thinking_budget[idx]))
+        or np.any(states.min_p.np[idx] != 0.0)
+        or np.any(states.top_p.np[idx] != 1.0)
+        or np.any(states.top_k.np[idx] != states.vocab_size)
+        or not np.any(bias.num_stop_token_ids.np[idx])
+    ):
+        return None
+    return bias
+
+
+def prepare_greedy_verification(runner):
+    if not _available(runner):
+        return
+    model = _language_model(runner.model)
+    head = model.lm_head
+    shard = head.shard_indices
+    with runner.jit_warmup_registry.activate():
+        register_greedy_verification_warmups(
+            logits_dtype=model.logits_processor.head_dtype or runner.model_config.dtype,
+            logits_stride=head.num_embeddings_per_partition,
+            vocab=shard.num_org_elements,
+            vocab_start=shard.org_vocab_start_index,
+            tp_size=get_tensor_model_parallel_world_size(),
+            num_speculative_steps=runner.rejection_sampler.num_speculative_steps,
+        )
+        processors = _default_processors(runner.sampler)
+        if (
+            os.environ.get("SPARK3_GREEDY_MIN_TOKENS", "0") == "1"
+            and processors is not None
+        ):
+            from .min_tokens import register_min_token_mask
+
+            bias = processors[0]
+            register_min_token_mask(
+                dtype=model.logits_processor.head_dtype or runner.model_config.dtype,
+                stride=head.num_embeddings_per_partition,
+                stop_stride=bias.stop_token_ids.gpu.stride(0),
+                vocab_start=shard.org_vocab_start_index,
+                vocab=shard.num_org_elements,
+            )
+
+
+def try_greedy_verification(runner, hidden_states, batch, grammar_output):
+    if (
+        grammar_output is not None
+        or batch.num_reqs == 0
+        or batch.num_draft_tokens == 0
+        or not _available(runner)
+    ):
+        return None
+    sampler = runner.sampler
+    idx = batch.idx_mapping_np
+    if (
+        not np.all(sampler.sampling_states.temperature.np[idx] == 0.0)
+        or sampler.get_logprobs_dims(idx) is not None
+    ):
+        return None
+    bias = None
+    if np.any(sampler.needs_logits_processing[idx]):
+        bias = _minimum_token_bias(sampler, idx)
+        if bias is None:
+            return None
+    shard = _language_model(runner.model).lm_head.shard_indices
+    local_logits = runner.model.compute_logits_local(hidden_states)
+    draft_ids, positions = gather_draft_sampled(
+        batch.input_ids,
+        batch.positions,
+        batch.logits_indices,
+        batch.expanded_idx_mapping,
+        batch.expanded_local_pos,
+        sampler.req_states.prefill_len.gpu,
+    )
+    if bias is not None:
+        from .min_tokens import mask_min_tokens
+
+        mask_min_tokens(
+            local_logits,
+            positions,
+            batch.expanded_idx_mapping,
+            bias,
+            shard.org_vocab_start_index,
+            shard.num_org_elements,
+        )
+    target_ids = vocab_parallel_argmax(
+        local_logits,
+        shard.num_org_elements,
+        shard.org_vocab_start_index,
+        get_tensor_model_parallel_world_size(),
+    )
+    sampled, counts = greedy_rejection_sample(
+        target_ids,
+        draft_ids,
+        batch.cu_num_logits,
+        runner.rejection_sampler.num_speculative_steps,
+    )
+    counts, rejected = get_num_sampled_and_rejected(
+        counts,
+        batch.seq_lens,
+        batch.cu_num_logits,
+        batch.idx_mapping,
+        sampler.req_states.prefill_len.gpu,
+        dead_row_cut=getattr(runner, "_dead_row_cut", None),
+    )
+    output = SamplerOutput(
+        sampled_token_ids=sampled,
+        logprobs_tensors=None,
+        num_nans=None,
+        num_sampled=counts,
+        num_rejected=rejected,
+    )
+    return output, counts, rejected
diff --git a/vllm/models/deepseek_v4_1/greedy_verification.py b/vllm/models/deepseek_v4_1/greedy_verification.py
