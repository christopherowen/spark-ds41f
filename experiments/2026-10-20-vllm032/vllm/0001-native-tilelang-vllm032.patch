+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA")
+@pytest.mark.parametrize("padding", [False, True])
+def test_minimum_mask_owns_stop_ids_and_preserves_padding_at_boundary(padding):
+    from vllm.models.deepseek_v4_1.min_tokens import mask_min_tokens
+
+    stops = (1, 8, 17, 28)
+    _, _, _, bias, params = _minimum_state("cuda", stop_ids=stops)
+    assert params.all_stop_token_ids == set(stops)
+    positions = torch.tensor([102, 203, 5], dtype=torch.int64, device="cuda")
+    requests = torch.tensor(
+        [0, -1 if padding else 1, 2], dtype=torch.int64, device="cuda"
+    )
+    if padding:
+        positions[1] = 0
+    for rank in range(4):
+        start, width = rank * 8, min(8, 29 - rank * 8)
+        logits = torch.arange(24, dtype=torch.float32, device="cuda").reshape(3, 8)
+        expected = logits.clone()
+        for row in (0, 2):
+            for token in stops:
+                if start <= token < start + width:
+                    expected[row, token - start] = -float("inf")
+        mask_min_tokens(logits, positions, requests, bias, start, width)
+        assert torch.equal(logits, expected)
