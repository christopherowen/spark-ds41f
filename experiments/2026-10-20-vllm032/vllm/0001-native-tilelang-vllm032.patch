+
+@pytest.mark.parametrize("builtins", [False, True])
+def test_minimum_mask_warmup_matches_runtime_indices(builtins, monkeypatch):
+    from vllm.model_executor.warmup.jit_warmup import JitWarmupRegistry
+    from vllm.models.deepseek_v4_1 import min_tokens
+
+    monkeypatch.setenv("SPARK3_GREEDY_MIN_TOKENS", "1")
+    monkeypatch.setattr(greedy, "get_tensor_model_parallel_world_size", lambda: 1)
+    runner, batch, logits, _, _ = _minimum_state()
+    if not builtins:
+        runner.sampler.logits_processors = []
+    runner.model.logits_processor.head_dtype = logits.dtype
+    runner.model.lm_head.num_embeddings_per_partition = logits.shape[1]
+    runner.model_config = SimpleNamespace(dtype=logits.dtype)
+    registry = runner.jit_warmup_registry = JitWarmupRegistry(None)
+    greedy.prepare_greedy_verification(runner)
+    registrations = registry._registrations.get(min_tokens._mask, [])
+    assert bool(registrations) is builtins
+    if builtins:
+        if not hasattr(min_tokens._mask_kernel, "arg_names"):
+            monkeypatch.setattr(
+                min_tokens._mask_kernel,
+                "arg_names",
+                tuple(inspect.signature(min_tokens._mask_kernel).parameters),
+                raising=False,
+            )
+        ((args, kwargs),) = registrations
+        inputs = min_tokens._warmup_inputs(*args, **kwargs)
+        assert (
+            inputs["requests"].dtype == batch.expanded_idx_mapping.dtype == torch.int64
+        )
+        assert inputs["positions"].dtype == batch.positions.dtype == torch.int64
+        assert inputs["logits"].dtype == logits.dtype
+
+
+@pytest.mark.parametrize(
+    "other",
+    [
+        "allowed",
+        "bias",
+        "restore",
+        "penalty",
+        "bad_words",
+        "thinking",
+        "min_p",
+        "top_p",
+        "top_k",
+        "duplicate",
+        "disabled",
+    ],
+)
+def test_minimum_coexisting_processing_falls_back(other, monkeypatch):
+    monkeypatch.setenv("SPARK3_GREEDY_MIN_TOKENS", "1")
+    runner, batch, _, bias, _ = _minimum_state()
+    sampler = runner.sampler
+    if other == "allowed":
+        bias.num_allowed_token_ids.np[1] = 1
+    elif other == "bias":
+        bias.num_logit_bias.np[1] = 1
+    elif other == "restore":
+        bias.restore_when_all_masked.np[1] = 1
+    elif other == "penalty":
+        sampler.penalties_state.use_penalty[1] = True
+    elif other == "bad_words":
+        sampler.logits_processors[2].num_bad_words.np[1] = 1
+    elif other == "thinking":
+        sampler.thinking_budget_state.enabled = True
+        sampler.thinking_budget_state.use_thinking_budget[1] = True
+    elif other == "min_p":
+        sampler.sampling_states.min_p.np[1] = 0.1
+    elif other == "top_p":
+        sampler.sampling_states.top_p.np[1] = 0.9
+    elif other == "top_k":
+        sampler.sampling_states.top_k.np[1] = 3
+    elif other == "duplicate":
+        sampler.logits_processors.append(bias)
+    else:
+        monkeypatch.setenv("SPARK3_GREEDY_MIN_TOKENS", "0")
+    assert greedy._minimum_token_bias(sampler, batch.idx_mapping_np) is None
+    assert greedy.try_greedy_verification(runner, None, batch, None) is None
+    runner.model.compute_logits_local.assert_not_called()
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA")
+@pytest.mark.parametrize("minimum", [1, 2, 3, 4, 5])
+def test_minimum_greedy_matches_full_masked_verification(minimum, monkeypatch):
+    monkeypatch.setenv("SPARK3_GREEDY_MIN_TOKENS", "1")
+    runner, batch, logits, _, _ = _minimum_state("cuda", minimum)
+    runner._dead_row_cut = torch.tensor([1, 2, 2], dtype=torch.int32, device="cuda")
+    monkeypatch.setattr(greedy, "get_tensor_model_parallel_world_size", lambda: 1)
+    assert batch.expanded_idx_mapping.dtype == torch.int64
+    original = logits.clone()
+    reference = runner.rejection_sampler(
+        original, batch, dead_row_cut=runner._dead_row_cut
+    )
+    output, counts, rejected = greedy.try_greedy_verification(
+        runner, logits, batch, None
+    )
+    assert torch.equal(counts, reference.num_sampled)
+    assert torch.equal(rejected, reference.num_rejected)
+    for row, count in enumerate(counts.tolist()):
+        assert torch.equal(
+            output.sampled_token_ids[row, :count],
+            reference.sampled_token_ids[row, :count],
+        )
+    assert output.logprobs_tensors is output.sampling_mask_tensors is None
+
