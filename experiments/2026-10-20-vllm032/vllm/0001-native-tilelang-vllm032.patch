+++ b/vllm/models/deepseek_v4_1/packed_bf16_format.py
@@ -0,0 +1,200 @@
+"""Exact 12-bit storage for BF16 vocabulary weights.
+
+A BF16 value is a sign bit, an 8-bit exponent and a 7-bit mantissa. Each value
+here keeps its sign and mantissa in one byte and its exponent in a 4-bit code:
+code ``c`` in 1..15 means exponent ``base + c - 1`` for one 15-exponent window
+chosen per tensor, and code 0 means exponent 0 (zero and subnormal values keep
+their bits exactly). The rare values whose exponent falls outside the window
+are exceptions: their slot holds +0 and their exact BF16 bits sit in a per-row
+list that the projection adds after the main dot product.
+
+Row layout, ``K + K / 2`` bytes: the ``K`` sign-and-mantissa bytes, then the
+codes. Byte ``j`` of each 128-column group's 64 code bytes holds the code of
+column ``j`` in its low nibble and of column ``j + 64`` in its high nibble.
+
+``pack`` streams the BF16 weight through three fused GPU passes (exponent
+histogram, per-row exception counts, then the packed bytes and exceptions) and
+allocates nothing large but its result; ``pack(..., in_place=True)`` writes
+the result into the weight's own storage instead. The write pass decodes every value it
+encodes and compares it with the source bits; ``pack`` refuses unless all of
+them match, so a packed tensor is the checkpoint tensor, not an approximation.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import torch
+import triton
+import triton.language as tl
+
+GROUP = 128
+WINDOW = 15
+_GROUP = tl.constexpr(GROUP)
+_WINDOW = tl.constexpr(WINDOW)
+
+
+@dataclass(frozen=True)
+class PackedBf16Weight:
+    """A packed ``[out_features, in_features]`` BF16 weight."""
+
+    values: torch.Tensor
+    exponent_base: int
+    exception_rows: torch.Tensor
+    exception_entries: torch.Tensor
+    row_offsets: torch.Tensor
+    exceptions: int
+
+    @property
+    def out_features(self) -> int:
+        return int(self.values.shape[0])
+
+    @property
+    def in_features(self) -> int:
+        return int(self.values.shape[1]) * 2 // 3
+
+
+@triton.jit
+def _exponent_histogram_kernel(weight, histogram, K: tl.constexpr):
+    row = weight + tl.program_id(0).to(tl.int64) * K
+    lane = tl.arange(0, _GROUP)
+    counts = tl.zeros((256,), tl.int32)
+    for column in range(0, K, _GROUP):
+        bits = tl.load(row + column + lane).to(tl.int32) & 0xFFFF
+        counts += tl.histogram((bits >> 7) & 0xFF, 256)
+    tl.atomic_add(histogram + tl.arange(0, 256), counts)
+
+
+@triton.jit
+def _outside(bits, base):
+    exponent = (bits >> 7) & 0xFF
+    return (exponent != 0) & ((exponent < base) | (exponent >= base + _WINDOW))
+
+
+@triton.jit
+def _exception_count_kernel(weight, counts, base, K: tl.constexpr):
+    row = weight + tl.program_id(0).to(tl.int64) * K
+    lane = tl.arange(0, _GROUP)
+    total = tl.full((), 0, tl.int32)
+    for column in range(0, K, _GROUP):
+        bits = tl.load(row + column + lane).to(tl.int32) & 0xFFFF
+        total += tl.sum(_outside(bits, base).to(tl.int32), 0)
+    tl.store(counts + tl.program_id(0), total)
+
+
+@triton.jit
+def _encode_half(source, columns, row_index, base, rows, entries, written):
+    """Low bytes, codes and exceptions of 64 columns; returns codes, new count, mismatches."""
+    bits = tl.load(source + columns).to(tl.int32) & 0xFFFF
+    exponent = (bits >> 7) & 0xFF
+    outside = _outside(bits, base)
+    code = tl.where((exponent != 0) & ~outside, exponent - base + 1, 0)
+    low = tl.where(outside, 0, ((bits >> 8) & 0x80) | (bits & 0x7F))
+    decoded = ((low & 0x80) << 8) | (tl.where(code == 0, 0, code + base - 1) << 7) | (low & 0x7F)
+    mismatches = tl.sum((~outside & (decoded != bits)).to(tl.int32), 0)
+    flag = outside.to(tl.int32)
+    position = written + tl.cumsum(flag, 0) - flag
+    tl.store(rows + position, row_index + tl.zeros_like(flag), mask=outside)
+    tl.store(entries + position, (columns << 16) | bits, mask=outside)
+    return low, code, written + tl.sum(flag, 0), mismatches
+
+
+@triton.jit
+def _pack_rows_kernel(weight, values, offsets, rows, entries, mismatches, base, row_start, K: tl.constexpr):
+    """Pack rows ``row_start + program`` into row ``program`` of ``values``."""
+    row_index = row_start + tl.program_id(0)
+    source = weight + row_index.to(tl.int64) * K
+    out = values + tl.program_id(0).to(tl.int64) * (K + K // 2)
+    lane = tl.arange(0, _GROUP // 2)
+    written = tl.load(offsets + row_index)
+    bad = tl.full((), 0, tl.int32)
+    for group in range(0, K // _GROUP):
+        column = group * _GROUP
+        low_a, code_a, written, bad_a = _encode_half(source, column + lane, row_index, base, rows, entries, written)
+        low_b, code_b, written, bad_b = _encode_half(source, column + _GROUP // 2 + lane, row_index, base, rows,
+                                                     entries, written)
+        tl.store(out + column + lane, low_a.to(tl.uint8))
+        tl.store(out + column + _GROUP // 2 + lane, low_b.to(tl.uint8))
+        tl.store(out + K + group * (_GROUP // 2) + lane, (code_a | (code_b << 4)).to(tl.uint8))
+        bad += bad_a + bad_b
+    bad += (written != tl.load(offsets + row_index + 1)).to(tl.int32)
+    tl.atomic_add(mismatches, bad)
+
+
+def _check_weight(weight: torch.Tensor) -> None:
+    if weight.ndim != 2 or weight.dtype != torch.bfloat16:
+        raise TypeError("packing needs a 2-D torch.bfloat16 weight")
+    if not weight.is_cuda or not weight.is_contiguous():
+        raise ValueError("packing needs a contiguous CUDA weight")
+    if weight.shape[0] == 0 or weight.shape[1] == 0 or weight.shape[1] % GROUP:
+        raise ValueError(f"packing needs rows and K divisible by {GROUP}, got {tuple(weight.shape)}")
+
+
+_BLOCK_ROWS = 1_024
+
+
+def pack(weight: torch.Tensor, *, in_place: bool = False) -> PackedBf16Weight:
+    """Pack ``weight`` exactly; raise if any value would not round-trip.
+
+    Out of place, it allocates the result plus the 256-bin histogram, the
+    mismatch counter and a row-count prefix sum. ``in_place=True`` writes the
+    packed rows into the first three quarters of ``weight``'s own storage, so
+    the only other allocation is one 1,024-row staging block (7.5 MiB at
+    K=5,120); ``weight`` must not be read as BF16 afterwards. A packed row is
+    shorter than a BF16 row, so each block's packed bytes land only on rows
+    already read: blocks are packed into staging while their own rows are
+    intact, then copied into place, in row order.
+    """
+    _check_weight(weight)
+    out_features, in_features = map(int, weight.shape)
+    width = in_features + in_features // 2
+    device = weight.device
+    bits = weight.view(torch.int16)
+    histogram = torch.zeros(256, dtype=torch.int32, device=device)
+    _exponent_histogram_kernel[(out_features,)](bits, histogram, K=in_features)
+    hist = histogram.to(torch.int64).cpu()
+    hist[0] = 0
+    windows = hist.unfold(0, WINDOW, 1).sum(1)
+    windows[0] = -1
+    base = int(windows.argmax())  # the lowest of equally good windows
+    row_offsets = torch.zeros(out_features + 1, dtype=torch.int32, device=device)
+    _exception_count_kernel[(out_features,)](bits, row_offsets[1:], base, K=in_features)
+    row_offsets[1:] = torch.cumsum(row_offsets[1:], 0, dtype=torch.int32)
+    exceptions = int(row_offsets[-1])
+    # Kernels take a valid pointer even when the row offsets select nothing.
+    rows = torch.zeros(max(exceptions, 1), dtype=torch.int32, device=device)
+    entries = torch.zeros_like(rows)
+    mismatches = torch.zeros(1, dtype=torch.int32, device=device)
+    if in_place:
+        values = weight.view(torch.uint8).view(-1)[: out_features * width].view(out_features, width)
+        staging = torch.empty((min(_BLOCK_ROWS, out_features), width), dtype=torch.uint8, device=device)
+        for start in range(0, out_features, _BLOCK_ROWS):
+            count = min(_BLOCK_ROWS, out_features - start)
+            _pack_rows_kernel[(count,)](bits, staging, row_offsets, rows, entries, mismatches, base, start,
+                                        K=in_features)
+            values[start:start + count].copy_(staging[:count])
+        del staging
+    else:
+        values = torch.empty((out_features, width), dtype=torch.uint8, device=device)
+        _pack_rows_kernel[(out_features,)](bits, values, row_offsets, rows, entries, mismatches, base, 0,
+                                           K=in_features)
+    if int(mismatches) != 0:
+        raise ValueError(f"packed BF16 weight does not round-trip ({int(mismatches)} mismatches)")
+    return PackedBf16Weight(values, base, rows, entries, row_offsets, exceptions)
+
+
+def unpack(packed: PackedBf16Weight) -> torch.Tensor:
+    """The exact BF16 weight that ``packed`` stores (for tests and inspection; allocates freely)."""
+    count, width = packed.values.shape
+    k = width * 2 // 3
+    low = packed.values[:, :k].to(torch.int32)
+    codes = packed.values[:, k:].to(torch.int32).view(count, k // GROUP, 1, GROUP // 2)
+    code = torch.cat((codes & 0xF, codes >> 4), dim=2).reshape(count, k)
+    exponent = torch.where(code == 0, 0, code + packed.exponent_base - 1)
+    bits = ((low & 0x80) << 8) | (exponent << 7) | (low & 0x7F)
+    if packed.exceptions:
+        entries = packed.exception_entries[: packed.exceptions]
+        bits[packed.exception_rows[: packed.exceptions].long(), (entries >> 16).long()] = entries & 0xFFFF
+    return bits.to(torch.int16).view(torch.bfloat16)
+
+
+__all__ = ["GROUP", "PackedBf16Weight", "WINDOW", "pack", "unpack"]
