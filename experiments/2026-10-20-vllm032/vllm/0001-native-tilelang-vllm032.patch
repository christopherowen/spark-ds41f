+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The exact packed BF16 vocabulary head used by the native kernel family."""
+
+import torch
+
+from vllm.config import get_current_vllm_config
+from vllm.model_executor.layers.linear import UnquantizedLinearMethod
+from vllm.model_executor.layers.vocab_parallel_embedding import (
+    UnquantizedEmbeddingMethod,
+)
+from vllm.model_executor.utils import replace_parameter
+
+
+class PackedBf16LmHeadMethod(UnquantizedEmbeddingMethod):
+    def process_weights_after_loading(self, layer):
+        if hasattr(layer, "packed_bf16_exponent_base"):
+            return
+        from .packed_bf16_format import pack
+
+        in_features = layer.weight.shape[1]
+        packed = pack(layer.weight.data, in_place=True)
+        for name, value in (
+            ("weight", packed.values),
+            ("weight_exception_rows", packed.exception_rows),
+            ("weight_exception_entries", packed.exception_entries),
+            ("weight_row_offsets", packed.row_offsets),
+        ):
+            replace_parameter(layer, name, value)
+        layer.packed_bf16_in_features = in_features
+        layer.packed_bf16_exponent_base = packed.exponent_base
+        layer.packed_bf16_exceptions = packed.exceptions
+        config = get_current_vllm_config().model_config
+        layer.tilelang_vocab_dtype = config.head_dtype or torch.bfloat16
+
+    def declare_layer_kernels(self, layer):
+        from .tilelang.vocab import prepare_packed_head
+
+        prepare_packed_head(layer, layer.tilelang_vocab_dtype)
+
+    def apply(self, layer, x, bias=None):
+        raise RuntimeError("Packed BF16 heads require the native logits processor")
+
+    def embedding(self, layer, input_):
+        raise RuntimeError("Packed BF16 heads cannot be used as input embeddings")
+
+
+def configure_packed_head(head, vllm_config):
+    config = vllm_config.model_config.hf_text_config
+    if getattr(config, "tie_word_embeddings", False):
+        raise ValueError("Packed BF16 heads require untied checkpoint weights")
+    if not isinstance(
+        head.quant_method, (UnquantizedEmbeddingMethod, UnquantizedLinearMethod)
+    ):
+        raise ValueError("Packed BF16 heads require unquantized checkpoint weights")
+    if head.weight.dtype != torch.bfloat16 or head.embedding_dim % 128:
+        raise ValueError(
+            "Packed BF16 heads require BF16 weights and K divisible by 128"
+        )
+    head.quant_method = PackedBf16LmHeadMethod()
+    head.runtime_lm_head_quantization = "packed_bf16"
