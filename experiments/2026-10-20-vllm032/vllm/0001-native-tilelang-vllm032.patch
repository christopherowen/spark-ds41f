+/* SPDX-License-Identifier: Apache-2.0
+ * SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+ *
+ * Disk readers for DeepSeek-V4.1's Engram tables on one rank.
+ *
+ * One worker thread serves every reader's steps in the order the model submits
+ * them: per step, the first Engram layer's table, then the second's, so the rows
+ * the forward needs first are read first and the two tables never compete for the
+ * disk. A step's lookups split by when their row IDs exist. Those the host already
+ * hashed (prompt tokens: the runner prepares a step before the GPU runs it) come
+ * with the step as its early IDs, and the worker reads them as soon as the GPU has
+ * finished gathering the reader's previous step (the GPU writes that step's
+ * sequence number into the control block after its gather), so they are read while
+ * the previous step computes. The rest (tokens the GPU samples) are known when the
+ * GPU has written the step's sequence number into the control block (the stream
+ * writes it after copying the row IDs to the host); the worker then reads those,
+ * and publishes the step by writing its sequence number into the control block. A
+ * step with no early IDs is read entirely the second way; one whose IDs are all
+ * early does not wait for the GPU's. The worker never takes the GIL and never calls CUDA, so nothing
+ * another thread does in Python or in the CUDA driver can hold back the rows. A
+ * failed step is recorded and not published, and the control block says so: the
+ * GPU's wait then stops it at once with a named record instead of letting it read
+ * stale rows.
+ *
+ * Request planning (_row_plan.h) and io_uring execution come from b12x's PLE
+ * reader (local-inference-lab/b12x b12x/loader/_ple_reader.c, Apache-2.0): rows
+ * are sorted, deduplicated and coalesced into 4 KiB-aligned O_DIRECT reads into
+ * registered staging buffers, then scattered to their lookup slots. A short read
+ * continues into the rest of its buffer; only the end of the file fails it.
+ */
+#define _GNU_SOURCE
+#define PY_SSIZE_T_CLEAN
+#include <Python.h>
+
+#include <errno.h>
+#include <liburing.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/prctl.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+typedef struct {
+    char message[512];
+} failure_t;
+
+static void system_error(failure_t *failure, const char *operation) {
+    snprintf(failure->message, sizeof(failure->message), "%s: %s", operation, strerror(errno));
+}
+
+#include "_row_plan.h"
+
+#define READER_CAPSULE "vllm.engram_rows.reader"
+#define ABI_VERSION 5
+
+/* Control block: 32-bit words in mapped host memory, one 64-byte line per writer. */
+#define CTRL_IDS_SEQ 0      /* the GPU stream: the step whose row IDs are on the host */
+#define CTRL_CONSUMED_SEQ 1 /* the GPU: the step whose rows it has gathered */
+#define CTRL_ROWS_SEQ 16    /* the worker: the step whose rows are in the buffers */
+#define CTRL_TIMEOUT_US 32  /* the host: how long the GPU waits for a step's rows */
+#define CTRL_WAITED_US 33   /* the GPU: how long a timed-out wait waited */
+#define CTRL_FAILED_SEQ 34  /* the GPU: the step a timed-out wait was for */
+#define CTRL_GPU_WAIT_SEQ 40 /* debug (timeline): the step the GPU last waited for */
+#define CTRL_GPU_WAIT_NS 41  /* debug (timeline): how long that wait took, ns */
+#define CTRL_PHASE 48       /* the worker: PHASE_* */
+#define CTRL_PHASE_SEQ 49   /* the worker: the step it is on */
+#define CTRL_WORDS 64
+
+enum { PHASE_IDLE = 0, PHASE_WAITING_IDS = 1, PHASE_READING = 2, PHASE_FAILED = 3, PHASE_WAITING_CONSUMED = 4 };
+
+/* An early ID the host does not know: the GPU's ID for that lookup is read later. */
+#define UNKNOWN_ID INT64_MIN
+
+#define QUEUE 64u /* steps queued across all readers */
+
+typedef struct {
+    char *buffer;
+    size_t job;
+    unsigned done; /* bytes of the job read so far: a short read continues */
+} slot_t;
+
+typedef struct {
+    uint32_t sequence;
+    uint32_t count;
+    int64_t *early;   /* the host's IDs (UNKNOWN_ID where only the GPU knows), or NULL */
+    bool has_unknown; /* some lookup needs the GPU's ID */
+    uint64_t submitted; /* when the host queued the step (CLOCK_MONOTONIC ns) */
+} step_t;
+
+/* Debug (timeline): one record per served step, times in CLOCK_MONOTONIC ns. The GPU's
+ * wait is the last one it recorded when the step's service began: the previous step's. */
+typedef struct {
+    uint32_t sequence, count, early, gpu_sequence, gpu_wait_ns;
+    uint64_t submitted, started, consumed, ids, read, published, plan_ns;
+} record_t;
+#define TIMELINE 8192
+
+typedef struct {
+    ple_plan_t plan;
+    bool poisoned;
+    unsigned slots_count;
+    slot_t *slots;
+    char *buffers;
+    struct io_uring ring;
+    bool ring_ready;
+    bool files_registered;
+    int *registered_fds;
+    struct iovec *iovecs;
+    unsigned *free_slots;
+    /* Mapped host buffers, owned by the Python wrapper for the reader's lifetime. */
+    const char *ids;
+    char *weights, *scales;
+    uint32_t *control;
+    int64_t *late; /* the GPU's IDs of a step's lookups the host did not know, -1 elsewhere */
+    bool check_early; /* debug: an early ID must equal the GPU's */
+    record_t *timeline; /* debug: the last TIMELINE served steps (mutex), or NULL */
+    uint64_t timeline_next, timeline_read;
+    uint64_t step_plan_ns; /* debug (timeline): the served step's planning time, worker only */
+    /* Serving: started (sources fixed) and closing are set once; pending (steps
+     * queued or being read) is guarded by the queue's mutex, the rest by mutex. */
+    bool started, closing;
+    unsigned pending;
+    pthread_mutex_t mutex;
+    uint64_t ids_timeout_ns, delay_ns;
+    failure_t failure; /* the first failure; no step is read after it */
+    uint64_t steps_done, lookups_done, early_lookups;
+    double ids_wait_seconds, read_seconds, consumed_wait_seconds, early_read_seconds;
+} reader_t;
+
+static uint64_t now_ns(void) {
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return (uint64_t)now.tv_sec * 1000000000ull + (uint64_t)now.tv_nsec;
+}
+
+static bool reached(uint32_t value, uint32_t target) { return (int32_t)(value - target) >= 0; }
+
+static void control_store(reader_t *reader, int word, uint32_t value) {
+    __atomic_store_n(&reader->control[word], value, __ATOMIC_RELAXED);
+}
+
+/* --- io_uring execution, from b12x's PLE reader ------------------------------ */
+
+static void ple_error(reader_t *reader, const char *operation, int error) {
+    if (!reader->plan.failure.message[0])
+        snprintf(reader->plan.failure.message, sizeof(reader->plan.failure.message), "%s: %s",
+                 operation, strerror(error));
+}
+
+/* Copy a completed job's fragments from its slot buffer to their lookup slots. */
+static void ple_scatter(reader_t *reader, size_t index, const char *buffer) {
+    ple_job_t *job = &reader->plan.jobs[index];
+    for (size_t i = job->begin; i < job->end; i++) {
+        ple_fragment_t *fragment = &reader->plan.fragments[i];
+        memcpy((fragment->scale ? reader->scales : reader->weights) + fragment->destination,
+               buffer + (fragment->offset - job->offset), fragment->length);
+    }
+}
+
+/* Queue a read of the rest of the slot's job into the rest of its buffer. */
+static bool ple_prepare(reader_t *reader, unsigned slot) {
+    struct io_uring_sqe *sqe = io_uring_get_sqe(&reader->ring);
+    if (!sqe) {
+        ple_error(reader, "io_uring SQ capacity", ENOSPC);
+        reader->poisoned = true;
+        return false;
+    }
+    slot_t *s = &reader->slots[slot];
+    ple_job_t *job = &reader->plan.jobs[s->job];
+    io_uring_prep_read_fixed(sqe, (int)job->file, s->buffer + s->done, job->length - s->done,
+                             job->offset + s->done, (int)slot);
+    sqe->flags |= IOSQE_FIXED_FILE;
+    io_uring_sqe_set_data64(sqe, slot);
+    return true;
+}
+
+/* Submit every prepared SQE. A short positive submit accounts for exactly that many
+ * SQEs; retry only the rest. A failed submit may leave prepared SQEs, so stop
+ * issuing, drain every submitted CQE, and retire the ring without submitting them. */
+static void ple_flush(reader_t *reader, unsigned prepared, unsigned *outstanding) {
+    while (prepared) {
+        reader->plan.submit_calls++;
+        int result = io_uring_submit(&reader->ring);
+        if (result == -EINTR) continue;
+        if (result <= 0) {
+            ple_error(reader, "io_uring submit", result < 0 ? -result : EIO);
+            reader->poisoned = true;
+            return;
+        }
+        *outstanding += (unsigned)result;
+        prepared -= (unsigned)result;
+    }
+}
+
+/* Account one completion of the slot's job. Returns whether the slot is free again;
+ * a partial read (or EAGAIN/EINTR) queues the rest and *continued counts it. */
+static bool ple_complete(reader_t *reader, unsigned slot, int status, unsigned *continued) {
+    slot_t *s = &reader->slots[slot];
+    ple_job_t *job = &reader->plan.jobs[s->job];
+    reader->plan.read_calls++;
+    if (status == -EAGAIN || status == -EINTR) {
+        if (ple_prepare(reader, slot)) {
+            (*continued)++;
+            return false;
+        }
+        return true;
+    }
+    if (status < 0) {
+        ple_error(reader, "io_uring READ_FIXED", -status);
+        return true;
+    }
+    reader->plan.read_bytes += (unsigned)status;
+    s->done += (unsigned)status;
+    if (s->done >= job->expected) {
+        ple_scatter(reader, s->job, s->buffer);
+        return true;
+    }
+    if (status == 0) {
+        if (!reader->plan.failure.message[0])
+            snprintf(reader->plan.failure.message, sizeof(reader->plan.failure.message),
+                     "short Engram row read at offset %lld: the file ended %u bytes early; the "
+                     "checkpoint changed or was truncated",
+                     (long long)job->offset, job->expected - s->done);
+        return true;
+    }
+    if (ple_prepare(reader, slot)) {
+        (*continued)++;
+        return false;
+    }
+    return true;
+}
+
+/* Assign the next jobs to free slots and queue their reads; returns how many. */
+static unsigned ple_prepare_wave(reader_t *reader, unsigned free_count, size_t *next) {
+    size_t remaining = reader->plan.job_count - *next;
+    unsigned count = remaining < free_count ? (unsigned)remaining : free_count;
+    unsigned prepared = 0;
+    for (unsigned i = 0; i < count; i++) {
+        unsigned slot = reader->free_slots[i];
+        reader->slots[slot].job = (*next)++;
+        reader->slots[slot].done = 0;
+        if (!ple_prepare(reader, slot)) break;
+        prepared++;
+    }
+    return prepared;
+}
+
+static void ple_uring_run(reader_t *reader) {
+    unsigned outstanding = 0;
+    size_t next = 0;
+    for (unsigned i = 0; i < reader->slots_count; i++) reader->free_slots[i] = i;
+    ple_flush(reader, ple_prepare_wave(reader, reader->slots_count, &next), &outstanding);
+    while (outstanding) {
+        struct io_uring_cqe *cqe = NULL;
+        /* wait/peek do not submit pending SQEs when draining a failed submit. */
+        int result = io_uring_wait_cqe(&reader->ring, &cqe);
+        if (result < 0) {
+            if (result != -EINTR && result != -EAGAIN) {
+                ple_error(reader, "io_uring completion wait", -result);
+                reader->poisoned = true;
+            }
+            continue;
+        }
+        unsigned seen = 0, free_count = 0, continued = 0, head;
+        io_uring_for_each_cqe(&reader->ring, head, cqe) {
+            unsigned slot = (unsigned)io_uring_cqe_get_data64(cqe);
+            int status = cqe->res;
+            seen++;
+            outstanding--;
+            if (ple_complete(reader, slot, status, &continued)) reader->free_slots[free_count++] = slot;
+            if (!outstanding) break;
+        }
+        io_uring_cq_advance(&reader->ring, seen);
+        /* Do not prepare refill SQEs until every collected completion has been
+         * checked. An I/O error therefore leaves no speculative refill entries. */
+        unsigned prepared = continued;
+        if (!reader->plan.failure.message[0] && !reader->poisoned && next < reader->plan.job_count)
+            prepared += ple_prepare_wave(reader, free_count, &next);
+        ple_flush(reader, prepared, &outstanding);
+    }
+    if (reader->poisoned) {
+        io_uring_queue_exit(&reader->ring);
+        reader->ring_ready = false;
+    }
+}
+
+static int ple_register_files(ple_plan_t *plan, void *owner) {
+    (void)plan;
+    reader_t *reader = owner;
+    int *fds = realloc(reader->registered_fds, reader->plan.file_count * sizeof(*fds));
+    if (!fds) return -ENOMEM;
+    reader->registered_fds = fds;
+    for (size_t i = 0; i < reader->plan.file_count; i++) fds[i] = reader->plan.files[i].fd;
+    if (reader->files_registered) {
+        int error = io_uring_unregister_files(&reader->ring);
+        if (error < 0) {
+            reader->poisoned = true;
+            return error;
+        }
+        reader->files_registered = false;
+    }
+    int error = io_uring_register_files(&reader->ring, fds, (unsigned)reader->plan.file_count);
+    if (!error) reader->files_registered = true;
+    else reader->poisoned = true;
+    return error;
+}
+
+/* Read the rows of ``count`` lookups whose IDs are ``ids`` into their lookup slots; an
+ * ID outside this rank's shard (or -1, or UNKNOWN_ID) leaves its slot untouched. */
+static failure_t read_rows(reader_t *reader, const char *ids, uint32_t count) {
+    reader->plan.failure.message[0] = 0;
+    reader->plan.lookups = count;
+    reader->plan.requested_bytes = reader->plan.read_bytes = reader->plan.read_calls = 0;
+    reader->plan.unique_blocks = reader->plan.coalesced_reads = reader->plan.submit_calls = 0;
+    if (reader->poisoned) {
+        snprintf(reader->plan.failure.message, sizeof(reader->plan.failure.message),
+                 "Engram reader is unusable after an io_uring submission or completion failure");
+        return reader->plan.failure;
+    }
+    uint64_t planning = now_ns();
+    bool planned = ple_plan(&reader->plan, ids, count);
+    reader->step_plan_ns += now_ns() - planning;
+    if (planned && reader->plan.job_count) ple_uring_run(reader);
+    return reader->plan.failure;
+}
+
+/* --- worker ------------------------------------------------------------------ */
+
+/* Wait until the GPU has written ``target`` (or later) into control word ``word``: spin
+ * for 200 us (a step the GPU is already on answers within it), then poll every 10 us. */
+static bool wait_for_gpu(reader_t *reader, int word, uint32_t target, failure_t *failure,
+                         const char *what, const char *hint) {
+    uint64_t start = now_ns();
+    for (;;) {
+        if (reached(__atomic_load_n(&reader->control[word], __ATOMIC_ACQUIRE), target))
+            return true;
+        if (__atomic_load_n(&reader->closing, __ATOMIC_RELAXED)) {
+            snprintf(failure->message, sizeof(failure->message), "Engram reader closed before %s %u", what,
+                     target);
+            return false;
+        }
+        if (now_ns() - start > reader->ids_timeout_ns) {
+            snprintf(failure->message, sizeof(failure->message), "%s %u did not come within %.1f s: %s", what,
+                     target, (double)reader->ids_timeout_ns * 1e-9, hint);
+            return false;
+        }
+        if (now_ns() - start > 200000) {
+            struct timespec pause = {0, 10000};
+            nanosleep(&pause, NULL);
+        } else {
+#if defined(__aarch64__)
+            __asm__ volatile("yield");
+#endif
+        }
+    }
+}
+
+static void pause_for_delay(reader_t *reader) {
+    if (reader->delay_ns) {
+        struct timespec pause = {(time_t)(reader->delay_ns / 1000000000ull),
+                                 (long)(reader->delay_ns % 1000000000ull)};
+        nanosleep(&pause, NULL);
+    }
+}
+
+/* The step's early part: wait until the GPU has gathered the reader's previous step
+ * (its rows are in the same buffers), then read the lookups the host hashed. */
+static bool read_early(reader_t *reader, step_t step, failure_t *failure, double *consumed_wait,
+                       double *early_read, uint64_t *early_count) {
+    control_store(reader, CTRL_PHASE, PHASE_WAITING_CONSUMED);
+    uint64_t start = now_ns();
+    /* Sequences run 1, 2, ... 0xFFFFFFFF, 1: the step before 1 is 0xFFFFFFFF (or none,
+     * when the control block's 0 has reached it already). */
+    uint32_t previous = step.sequence == 1 ? 0xFFFFFFFFu : step.sequence - 1;
+    if (!wait_for_gpu(reader, CTRL_CONSUMED_SEQ, previous, failure,
+                      "the GPU's gather of the rows of Engram step",
+                      "the GPU never gathered the previous step's rows"))
+        return false;
+    uint64_t consumed_at = now_ns();
+    pause_for_delay(reader);
+    control_store(reader, CTRL_PHASE, PHASE_READING);
+    *failure = read_rows(reader, (const char *)step.early, step.count);
+    *consumed_wait = (double)(consumed_at - start) * 1e-9;
+    *early_read = (double)(now_ns() - consumed_at) * 1e-9;
+    for (uint32_t i = 0; i < step.count; i++) *early_count += step.early[i] != UNKNOWN_ID;
+    return !failure->message[0];
+}
+
+/* The GPU's IDs: check the early ones (debug) and keep only those the host did not know. */
+static bool late_ids(reader_t *reader, step_t step, failure_t *failure) {
+    const int64_t *gpu = (const int64_t *)reader->ids;
+    for (uint32_t i = 0; i < step.count; i++) {
+        int64_t id;
+        memcpy(&id, gpu + i, sizeof(id));
+        if (step.early && step.early[i] != UNKNOWN_ID) {
+            if (reader->check_early && step.early[i] != id) {
+                snprintf(failure->message, sizeof(failure->message),
+                         "Engram step %u lookup %u: the host hashed row %lld, the GPU row %lld", step.sequence,
+                         i, (long long)step.early[i], (long long)id);
+                return false;
+            }
+            reader->late[i] = -1;
+        } else {
+            reader->late[i] = id;
+        }
+    }
+    return true;
+}
+
+static void serve(reader_t *reader, step_t step) {
+    failure_t failure = {{0}};
+    uint64_t started = now_ns();
+    uint32_t gpu_sequence = 0, gpu_wait_ns = 0;
+    reader->step_plan_ns = 0;
+    if (reader->timeline) {
+        gpu_sequence = __atomic_load_n(&reader->control[CTRL_GPU_WAIT_SEQ], __ATOMIC_ACQUIRE);
+        gpu_wait_ns = __atomic_load_n(&reader->control[CTRL_GPU_WAIT_NS], __ATOMIC_RELAXED);
+    }
+    control_store(reader, CTRL_PHASE_SEQ, step.sequence);
+    uint64_t early_count = 0;
+    double consumed_wait = 0.0, early_read = 0.0;
+    bool ok = !step.early || read_early(reader, step, &failure, &consumed_wait, &early_read, &early_count);
+    uint64_t start = now_ns(), ids_at = start, read_at = start;
+    if (ok && (step.has_unknown || reader->check_early)) {
+        control_store(reader, CTRL_PHASE, PHASE_WAITING_IDS);
+        ok = wait_for_gpu(reader, CTRL_IDS_SEQ, step.sequence, &failure, "the row IDs of Engram step",
+                          "the GPU is blocked before the step's Engram staging");
+        ids_at = now_ns();
+        if (ok && !step.early) pause_for_delay(reader);
+        if (ok) ok = late_ids(reader, step, &failure);
+        if (ok && step.has_unknown) {
+            control_store(reader, CTRL_PHASE, PHASE_READING);
+            failure = read_rows(reader, (const char *)reader->late, step.count);
+        }
+        read_at = now_ns();
+    }
+    pthread_mutex_lock(&reader->mutex);
+    if (failure.message[0]) {
+        if (!reader->failure.message[0]) reader->failure = failure;
+    } else {
+        reader->steps_done++;
+        reader->lookups_done += step.count;
+        reader->early_lookups += early_count;
+        reader->consumed_wait_seconds += consumed_wait;
+        reader->early_read_seconds += early_read;
+        reader->ids_wait_seconds += (double)(ids_at - start) * 1e-9;
+        reader->read_seconds += (double)(read_at - ids_at) * 1e-9;
+    }
+    pthread_mutex_unlock(&reader->mutex);
+    if (failure.message[0]) {
+        control_store(reader, CTRL_PHASE, PHASE_FAILED);
+        return;
+    }
+    /* The rows are in place before the GPU can see the step. */
+    __atomic_store_n(&reader->control[CTRL_ROWS_SEQ], step.sequence, __ATOMIC_RELEASE);
+    control_store(reader, CTRL_PHASE, PHASE_IDLE);
+    if (reader->timeline) {
+        record_t record = {step.sequence, step.count, (uint32_t)early_count, gpu_sequence, gpu_wait_ns,
+                           step.submitted, started, started + (uint64_t)(consumed_wait * 1e9),
+                           ids_at, read_at, now_ns(), reader->step_plan_ns};
+        pthread_mutex_lock(&reader->mutex);
+        reader->timeline[reader->timeline_next++ % TIMELINE] = record;
+        pthread_mutex_unlock(&reader->mutex);
+    }
+}
+
+/* The process's one worker and its queue of (reader, step) jobs. */
+typedef struct {
+    reader_t *reader;
+    step_t step;
+} job_t;
+
+static struct {
+    pthread_mutex_t mutex;
+    pthread_cond_t wake, space, idle;
+    job_t jobs[QUEUE];
+    uint64_t head, tail; /* tail - head jobs are queued */
+    bool started;
+} queue = {.mutex = PTHREAD_MUTEX_INITIALIZER};
+
+static pthread_once_t queue_once = PTHREAD_ONCE_INIT;
+
+static void queue_init(void) {
+    pthread_condattr_t monotonic;
+    pthread_condattr_init(&monotonic);
+    pthread_condattr_setclock(&monotonic, CLOCK_MONOTONIC);
+    pthread_cond_init(&queue.wake, &monotonic);
+    pthread_cond_init(&queue.space, &monotonic);
+    pthread_cond_init(&queue.idle, &monotonic);
+    pthread_condattr_destroy(&monotonic);
+}
+
+static void *worker_main(void *arg) {
+    (void)arg;
+    /* Sleep as asked: the default 50 us timer slack would stretch every 10 us poll. */
+    prctl(PR_SET_TIMERSLACK, 1UL, 0, 0, 0);
+    pthread_mutex_lock(&queue.mutex);
+    for (;;) {
+        while (queue.head == queue.tail) pthread_cond_wait(&queue.wake, &queue.mutex);
+        job_t job = queue.jobs[queue.head % QUEUE];
+        queue.head++;
+        pthread_cond_broadcast(&queue.space);
+        pthread_mutex_unlock(&queue.mutex);
+        pthread_mutex_lock(&job.reader->mutex);
+        bool failed = job.reader->failure.message[0] != 0;
+        pthread_mutex_unlock(&job.reader->mutex);
+        if (!failed) serve(job.reader, job.step);
+        free(job.step.early);
+        pthread_mutex_lock(&queue.mutex);
+        job.reader->pending--;
+        pthread_cond_broadcast(&queue.idle);
+    }
+    return NULL;
+}
+
+/* Close the reader: its queued steps fail at once, then it is freed. */
+static void release(reader_t *reader) {
+    if (!reader) return;
+    pthread_mutex_lock(&queue.mutex);
+    __atomic_store_n(&reader->closing, true, __ATOMIC_RELAXED);
+    while (reader->pending) pthread_cond_wait(&queue.idle, &queue.mutex);
+    pthread_mutex_unlock(&queue.mutex);
+    if (reader->ring_ready) io_uring_queue_exit(&reader->ring);
+    free(reader->iovecs);
+    free(reader->late);
+    free(reader->timeline);
+    free(reader->free_slots);
+    free(reader->registered_fds);
+    ple_plan_release(&reader->plan);
+    free(reader->buffers);
+    free(reader->slots);
+    pthread_mutex_destroy(&reader->mutex);
+    free(reader);
+}
+
+static void delete_capsule(PyObject *capsule) {
+    reader_t *reader = PyCapsule_GetPointer(capsule, READER_CAPSULE);
+    if (reader) {
+        Py_BEGIN_ALLOW_THREADS
+        release(reader);
+        Py_END_ALLOW_THREADS
+    }
+}
+
+/* --- Python surface ---------------------------------------------------------- */
+
+static reader_t *get_reader(PyObject *capsule) {
+    return PyCapsule_GetPointer(capsule, READER_CAPSULE);
+}
+
+/* reader(table_rows, shard_start, shard_end, columns, max_lookups, queue_depth, ids, weights,
+ *        scales, control, ids_timeout_s, delay_s, check_early, timeline): the rank reads the
+ * rows in [shard_start, shard_end) of the hash columns in the 24-bit mask ``columns``
+ * (lookup i is column i % 24); the four buffers
+ * are addresses of host memory that outlives the reader; check_early (debug) fails a step
+ * whose early ID differs from the GPU's; timeline (debug) records each served step. */
+static PyObject *py_reader(PyObject *self, PyObject *args) {
+    (void)self;
+    long long table_rows, shard_start, shard_end, max_lookups;
+    unsigned int columns;
+    int depth;
+    unsigned long long ids, weights, scales, control;
+    double ids_timeout, delay;
+    int check_early, timeline;
+    if (!PyArg_ParseTuple(args, "LLLILiKKKKddpp", &table_rows, &shard_start, &shard_end, &columns, &max_lookups,
+                          &depth, &ids, &weights, &scales, &control, &ids_timeout, &delay, &check_early,
+                          &timeline))
+        return NULL;
+    if (table_rows <= 0 || shard_start < 0 || shard_end < shard_start || shard_end > table_rows ||
+        !columns || (columns & ~PLE_ALL_COLUMNS) ||
+        max_lookups <= 0 || max_lookups > UINT32_MAX || depth <= 0 || depth > 32768 || !ids ||
+        !weights || !scales || !control || !(ids_timeout > 0) || delay < 0)
+        return PyErr_Format(PyExc_ValueError, "invalid Engram reader geometry, buffers or times");
+    reader_t *reader = calloc(1, sizeof(*reader));
+    if (!reader) return PyErr_NoMemory();
+    pthread_mutex_init(&reader->mutex, NULL);
+    /* One whole-table source per plane: shard 0 spans every row. */
+    int error = ple_plan_init(&reader->plan, table_rows, table_rows, shard_start, shard_end, columns, 256, 8,
+                              max_lookups);
+    if (error) {
+        release(reader);
+        return error == ENOMEM ? PyErr_NoMemory()
+                               : PyErr_Format(PyExc_ValueError, "Engram row plan: %s", strerror(error));
+    }
+    reader->ids = (const char *)(uintptr_t)ids;
+    reader->weights = (char *)(uintptr_t)weights;
+    reader->scales = (char *)(uintptr_t)scales;
+    reader->control = (uint32_t *)(uintptr_t)control;
+    reader->ids_timeout_ns = (uint64_t)(ids_timeout * 1e9);
+    reader->delay_ns = (uint64_t)(delay * 1e9);
+    reader->check_early = check_early != 0;
+    if (timeline && !(reader->timeline = calloc(TIMELINE, sizeof(*reader->timeline)))) {
+        release(reader);
+        return PyErr_NoMemory();
+    }
+    reader->late = malloc((size_t)max_lookups * sizeof(*reader->late));
+    if (!reader->late) {
+        release(reader);
+        return PyErr_NoMemory();
+    }
+    reader->slots_count = (unsigned)depth;
+    reader->slots = calloc(reader->slots_count, sizeof(*reader->slots));
+    error = posix_memalign((void **)&reader->buffers, PLE_BLOCK, (size_t)reader->slots_count * PLE_READ_MAX);
+    if (!reader->slots || error) {
+        release(reader);
+        return PyErr_NoMemory();
+    }
+    for (unsigned i = 0; i < reader->slots_count; i++)
+        reader->slots[i].buffer = reader->buffers + (size_t)i * PLE_READ_MAX;
+    error = io_uring_queue_init(reader->slots_count, &reader->ring, 0);
+    if (error < 0) {
+        release(reader);
+        return PyErr_Format(PyExc_RuntimeError,
+                            "io_uring initialization failed: %s; enable io_uring in the kernel and "
+                            "container policy",
+                            strerror(-error));
+    }
+    reader->ring_ready = true;
+    reader->iovecs = calloc(reader->slots_count, sizeof(*reader->iovecs));
+    reader->free_slots = calloc(reader->slots_count, sizeof(*reader->free_slots));
+    if (!reader->iovecs || !reader->free_slots) {
+        release(reader);
+        return PyErr_NoMemory();
+    }
+    for (unsigned i = 0; i < reader->slots_count; i++) {
+        reader->iovecs[i].iov_base = reader->slots[i].buffer;
+        reader->iovecs[i].iov_len = PLE_READ_MAX;
+    }
+    error = io_uring_register_buffers(&reader->ring, reader->iovecs, reader->slots_count);
+    if (error < 0) {
+        release(reader);
+        return PyErr_Format(PyExc_RuntimeError,
+                            "io_uring buffer registration failed: %s; raise the locked-memory limit "
+                            "or reduce queue_depth",
+                            strerror(-error));
+    }
+    PyObject *capsule = PyCapsule_New(reader, READER_CAPSULE, delete_capsule);
+    if (!capsule) release(reader);
+    return capsule;
+}
+
+/* add(reader, path, offset, scale): register the table's weight or scale plane. */
+static PyObject *py_add(PyObject *self, PyObject *args) {
+    (void)self;
+    PyObject *capsule;
+    const char *path;
+    long long offset;
+    int scale;
+    if (!PyArg_ParseTuple(args, "OsLp", &capsule, &path, &offset, &scale)) return NULL;
+    reader_t *reader = get_reader(capsule);
+    if (!reader) return NULL;
+    int error;
+    failure_t failure = {{0}};
+    Py_BEGIN_ALLOW_THREADS
+    pthread_mutex_lock(&reader->mutex);
+    if (__atomic_load_n(&reader->started, __ATOMIC_RELAXED)) {
+        error = EBUSY;
+    } else {
+        reader->plan.failure.message[0] = 0;
+        error = ple_add_source(&reader->plan, 0, path, offset, scale != 0, ple_register_files, reader);
+        failure = reader->plan.failure;
+    }
+    pthread_mutex_unlock(&reader->mutex);
+    Py_END_ALLOW_THREADS
+    if (error == EBUSY) return PyErr_Format(PyExc_RuntimeError, "Engram sources are fixed once steps run");
+    if (failure.message[0]) return PyErr_Format(PyExc_RuntimeError, "%s", failure.message);
+    if (error) return PyErr_Format(PyExc_ValueError, "Engram source: %s", strerror(error));
+    Py_RETURN_NONE;
+}
+
+/* submit(reader, sequence, count, wait_s, early): queue one step behind every step
+ * already queued. ``early`` is None or ``count`` int64 IDs the host hashed
+ * (UNKNOWN_ID where only the GPU knows the ID), copied here. Returns at once unless
+ * the queue is full; then it waits for space, without the GIL. */
+static PyObject *py_submit(PyObject *self, PyObject *args) {
+    (void)self;
+    PyObject *capsule, *early_object = Py_None;
+    unsigned int sequence, count;
+    double wait;
+    uint64_t submitted = now_ns();
+    if (!PyArg_ParseTuple(args, "OIId|O", &capsule, &sequence, &count, &wait, &early_object)) return NULL;
+    reader_t *reader = get_reader(capsule);
+    if (!reader) return NULL;
+    if (count > reader->plan.max_lookups)
+        return PyErr_Format(PyExc_ValueError, "Engram step of %u lookups exceeds the reader's capacity", count);
+    int64_t *early = NULL;
+    bool has_unknown = true;
+    if (early_object != Py_None) {
+        Py_buffer view;
+        if (PyObject_GetBuffer(early_object, &view, PyBUF_C_CONTIGUOUS) < 0) return NULL;
+        if (view.len != (Py_ssize_t)count * (Py_ssize_t)sizeof(int64_t)) {
+            PyBuffer_Release(&view);
+            return PyErr_Format(PyExc_ValueError, "Engram early IDs must be %u int64 values", count);
+        }
+        early = malloc((size_t)count * sizeof(*early) + 1);
+        if (!early) {
+            PyBuffer_Release(&view);
+            return PyErr_NoMemory();
+        }
+        memcpy(early, view.buf, (size_t)count * sizeof(*early));
+        PyBuffer_Release(&view);
+        has_unknown = false;
+        for (uint32_t i = 0; i < count && !has_unknown; i++) has_unknown = early[i] == UNKNOWN_ID;
+    }
+    const char *problem = NULL;
+    failure_t failure = {{0}};
+    Py_BEGIN_ALLOW_THREADS
+    struct timespec deadline;
+    clock_gettime(CLOCK_MONOTONIC, &deadline);
+    deadline.tv_sec += (time_t)wait;
+    deadline.tv_nsec += (long)((wait - (double)(time_t)wait) * 1e9);
+    if (deadline.tv_nsec >= 1000000000L) {
+        deadline.tv_sec++;
+        deadline.tv_nsec -= 1000000000L;
+    }
+    pthread_mutex_lock(&queue.mutex);
+    for (;;) {
+        pthread_mutex_lock(&reader->mutex);
+        failure = reader->failure;
+        pthread_mutex_unlock(&reader->mutex);
+        if (failure.message[0] || queue.tail - queue.head < QUEUE) break;
+        if (pthread_cond_timedwait(&queue.space, &queue.mutex, &deadline) == ETIMEDOUT) break;
+    }
+    if (!failure.message[0]) {
+        if (queue.tail - queue.head >= QUEUE) {
+            problem = "Engram readers fell more than 64 steps behind";
+        } else if (!queue.started) {
+            pthread_t thread;
+            pthread_attr_t attr;
+            pthread_attr_init(&attr);
+            pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+            if (pthread_create(&thread, &attr, worker_main, NULL)) problem = "Engram reader thread did not start";
+            else queue.started = true;
+            pthread_attr_destroy(&attr);
+        }
+        if (!problem) {
+            __atomic_store_n(&reader->started, true, __ATOMIC_RELAXED);
+            queue.jobs[queue.tail % QUEUE] = (job_t){reader, {sequence, count, early, has_unknown, submitted}};
+            early = NULL;
+            queue.tail++;
+            reader->pending++;
+            pthread_cond_signal(&queue.wake);
+        }
+    }
+    pthread_mutex_unlock(&queue.mutex);
+    Py_END_ALLOW_THREADS
+    free(early); /* not queued */
+    if (failure.message[0]) return PyErr_Format(PyExc_RuntimeError, "%s", failure.message);
+    if (problem) return PyErr_Format(PyExc_RuntimeError, "%s", problem);
+    Py_RETURN_NONE;
+}
+
+/* status(reader): the first failure (or None) and the worker's counters. */
+static PyObject *py_status(PyObject *self, PyObject *capsule) {
+    (void)self;
+    reader_t *reader = get_reader(capsule);
+    if (!reader) return NULL;
+    failure_t failure;
+    uint64_t steps, lookups, queued, early;
+    double ids_wait, read, consumed_wait, early_read;
+    Py_BEGIN_ALLOW_THREADS
+    pthread_mutex_lock(&queue.mutex);
+    queued = reader->pending;
+    pthread_mutex_unlock(&queue.mutex);
+    pthread_mutex_lock(&reader->mutex);
+    failure = reader->failure;
+    steps = reader->steps_done;
+    lookups = reader->lookups_done;
+    ids_wait = reader->ids_wait_seconds;
+    read = reader->read_seconds;
+    early = reader->early_lookups;
+    consumed_wait = reader->consumed_wait_seconds;
+    early_read = reader->early_read_seconds;
+    pthread_mutex_unlock(&reader->mutex);
+    Py_END_ALLOW_THREADS
+    PyObject *message = failure.message[0] ? PyUnicode_FromString(failure.message) : Py_NewRef(Py_None);
+    if (!message) return NULL;
+    PyObject *result = Py_BuildValue("{s:N,s:K,s:K,s:K,s:K,s:d,s:d,s:d,s:d}", "failure", message, "steps",
+                                     (unsigned long long)steps, "lookups", (unsigned long long)lookups,
+                                     "early_lookups", (unsigned long long)early, "queued",
+                                     (unsigned long long)queued, "ids_wait_seconds", ids_wait,
+                                     "read_seconds", read, "consumed_wait_seconds", consumed_wait,
+                                     "early_read_seconds", early_read);
+    return result;
+}
+
+/* timeline(reader) (debug): the records of the steps served since the last call (at most
+ * the last TIMELINE), oldest first, as tuples in record_t's field order; [] when off. */
+static PyObject *py_timeline(PyObject *self, PyObject *capsule) {
+    (void)self;
+    reader_t *reader = get_reader(capsule);
+    if (!reader) return NULL;
+    PyObject *result = PyList_New(0);
+    if (!result || !reader->timeline) return result;
+    record_t *copy = malloc(TIMELINE * sizeof(*copy));
+    if (!copy) {
+        Py_DECREF(result);
+        return PyErr_NoMemory();
+    }
+    uint64_t first, last;
+    pthread_mutex_lock(&reader->mutex);
+    last = reader->timeline_next;
+    first = reader->timeline_read + TIMELINE < last ? last - TIMELINE : reader->timeline_read;
+    for (uint64_t i = first; i < last; i++) copy[i - first] = reader->timeline[i % TIMELINE];
+    reader->timeline_read = last;
+    pthread_mutex_unlock(&reader->mutex);
+    for (uint64_t i = 0; i < last - first; i++) {
+        record_t *r = &copy[i];
+        PyObject *row = Py_BuildValue("(IIIIIKKKKKKK)", r->sequence, r->count, r->early, r->gpu_sequence,
+                                      r->gpu_wait_ns, (unsigned long long)r->submitted,
+                                      (unsigned long long)r->started, (unsigned long long)r->consumed,
+                                      (unsigned long long)r->ids, (unsigned long long)r->read,
+                                      (unsigned long long)r->published, (unsigned long long)r->plan_ns);
+        if (!row || PyList_Append(result, row) < 0) {
+            Py_XDECREF(row);
+            Py_DECREF(result);
+            free(copy);
+            return NULL;
+        }
+        Py_DECREF(row);
+    }
+    free(copy);
+    return result;
+}
+
+static PyMethodDef methods[] = {
+    {"reader", py_reader, METH_VARARGS, NULL},
+    {"add", py_add, METH_VARARGS, NULL},
+    {"submit", py_submit, METH_VARARGS, NULL},
+    {"status", py_status, METH_O, NULL},
+    {"timeline", py_timeline, METH_O, NULL},
+    {NULL, NULL, 0, NULL},
+};
+
+static PyModuleDef module = {
+    PyModuleDef_HEAD_INIT, .m_name = "_engram_rows_reader", .m_size = -1, .m_methods = methods,
+};
+
+PyMODINIT_FUNC PyInit__engram_rows_reader(void) {
+    pthread_once(&queue_once, queue_init);
+    PyObject *result = PyModule_Create(&module);
+    if (!result) return NULL;
+    if (PyModule_AddIntConstant(result, "ABI_VERSION", ABI_VERSION) < 0 ||
+        PyModule_AddIntConstant(result, "CTRL_IDS_SEQ", CTRL_IDS_SEQ) < 0 ||
+        PyModule_AddIntConstant(result, "CTRL_CONSUMED_SEQ", CTRL_CONSUMED_SEQ) < 0 ||
+        PyModule_AddIntConstant(result, "CTRL_ROWS_SEQ", CTRL_ROWS_SEQ) < 0 ||
+        PyModule_AddIntConstant(result, "CTRL_TIMEOUT_US", CTRL_TIMEOUT_US) < 0 ||
+        PyModule_AddIntConstant(result, "CTRL_WAITED_US", CTRL_WAITED_US) < 0 ||
+        PyModule_AddIntConstant(result, "CTRL_FAILED_SEQ", CTRL_FAILED_SEQ) < 0 ||
+        PyModule_AddIntConstant(result, "CTRL_GPU_WAIT_SEQ", CTRL_GPU_WAIT_SEQ) < 0 ||
+        PyModule_AddIntConstant(result, "CTRL_GPU_WAIT_NS", CTRL_GPU_WAIT_NS) < 0 ||
+        PyModule_AddIntConstant(result, "CTRL_PHASE", CTRL_PHASE) < 0 ||
+        PyModule_AddIntConstant(result, "CTRL_PHASE_SEQ", CTRL_PHASE_SEQ) < 0 ||
+        PyModule_AddIntConstant(result, "CTRL_WORDS", CTRL_WORDS) < 0) {
+        Py_DECREF(result);
+        return NULL;
+    }
+    return result;
+}
diff --git a/vllm/models/deepseek_v4_1/engram_rows/_row_plan.h b/vllm/models/deepseek_v4_1/engram_rows/_row_plan.h
new file mode 100644
index 0000000000000000000000000000000000000000..7e0f8a2ebdbf00745fd67b64403ff4159cecb6e3
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/engram_rows/_row_plan.h
@@ -0,0 +1,299 @@
+/* SPDX-License-Identifier: Apache-2.0
+ * Row planning for the Engram disk reader, from b12x's PLE reader
+ * (local-inference-lab/b12x b12x/loader/_row_plan.h, Apache-2.0): immutable source
+ * registration and allocation-free planning of 4 KiB-aligned direct reads. Unlike
+ * b12x's, it leaves the slots of other ranks' rows untouched: a rank owns the rows in
+ * [tp_start, tp_end) of the hash columns in its mask (lookup i is column i % 24). */
+
+#ifndef B12X_ROW_PLAN_H
+#define B12X_ROW_PLAN_H
+#include <fcntl.h>
+#include <time.h>
+#define PLE_BLOCK 4096u
+#define PLE_READ_MAX 65536u
+#define PLE_COLUMNS 24u
+#define PLE_ALL_COLUMNS ((1u << PLE_COLUMNS) - 1u)
+
+typedef struct {
+    int fd;
+    dev_t device;
+    ino_t inode;
+    int64_t bytes;
+} ple_file_t;
+
+typedef struct {
+    int64_t shard;
+    int64_t offset;
+    size_t file;
+    bool scale;
+} ple_source_t;
+
+typedef struct {
+    size_t file;
+    int64_t offset;
+    unsigned length;
+    size_t destination;
+    bool scale;
+} ple_fragment_t;
+
+typedef struct {
+    size_t file, begin, end;
+    int64_t offset;
+    unsigned length, expected;
+} ple_job_t;
+
+typedef struct {
+    int64_t shard_rows, padded_rows, tp_start, tp_end;
+    uint32_t columns;
+    size_t weight_bytes, scale_bytes, max_lookups, capacity;
+    ple_fragment_t *fragments;
+    ple_job_t *jobs;
+    size_t fragment_count, job_count;
+    ple_file_t *files;
+    ple_source_t *sources;
+    size_t file_count, source_count;
+    failure_t failure;
+    uint64_t lookups, requested_bytes, read_bytes, read_calls;
+    uint64_t unique_blocks, coalesced_reads, submit_calls;
+    double execution_seconds, planning_seconds;
+} ple_plan_t;
+
+static inline int ple_source_compare(const void *left, const void *right) {
+    const ple_source_t *a = left, *b = right;
+    if (a->shard != b->shard) return a->shard < b->shard ? -1 : 1;
+    return (int)a->scale - (int)b->scale;
+}
+
+static inline void ple_plan_release(ple_plan_t *reader) {
+    for (size_t i = 0; i < reader->file_count; i++) close(reader->files[i].fd);
+    free(reader->files);
+    free(reader->sources);
+    free(reader->fragments);
+    free(reader->jobs);
+}
+
+static inline int ple_plan_init(ple_plan_t *reader, int64_t shard_rows,
+        int64_t padded_rows, int64_t tp_start, int64_t tp_end, uint32_t columns,
+        int64_t weight_bytes, int64_t scale_bytes, int64_t max_lookups) {
+    if (shard_rows <= 0 || padded_rows <= 0 || tp_start < 0 || tp_end < tp_start ||
+        !columns || (columns & ~PLE_ALL_COLUMNS) ||
+        tp_end > padded_rows || weight_bytes <= 0 || scale_bytes < 0 || max_lookups <= 0 ||
+        weight_bytes > PY_SSIZE_T_MAX / max_lookups ||
+        scale_bytes > PY_SSIZE_T_MAX / max_lookups || max_lookups > PY_SSIZE_T_MAX / 8)
+        return EINVAL;
+    size_t per_row = (size_t)weight_bytes / PLE_BLOCK + 2;
+    if (scale_bytes) per_row += (size_t)scale_bytes / PLE_BLOCK + 2;
+    if ((size_t)max_lookups > SIZE_MAX / per_row ||
+        (size_t)max_lookups * per_row > SIZE_MAX / sizeof(ple_fragment_t) ||
+        (size_t)max_lookups * per_row > SIZE_MAX / sizeof(ple_job_t)) return EOVERFLOW;
+    reader->shard_rows = shard_rows;
+    reader->padded_rows = padded_rows;
+    reader->tp_start = tp_start;
+    reader->tp_end = tp_end;
+    reader->columns = columns;
+    reader->weight_bytes = weight_bytes;
+    reader->scale_bytes = scale_bytes;
+    reader->max_lookups = max_lookups;
+    reader->capacity = (size_t)max_lookups * per_row;
+    reader->fragments = calloc(reader->capacity, sizeof(*reader->fragments));
+    reader->jobs = calloc(reader->capacity, sizeof(*reader->jobs));
+    return reader->fragments && reader->jobs ? 0 : ENOMEM;
+}
+
+static inline int ple_add_source(ple_plan_t *reader, int64_t shard, const char *path,
+        int64_t offset, bool scale, int (*register_files)(ple_plan_t *, void *), void *owner) {
+    if (shard < 0 || shard > (reader->padded_rows - 1) / reader->shard_rows || offset < 0 ||
+        (scale && !reader->scale_bytes)) return EINVAL;
+    int64_t first = shard * reader->shard_rows;
+    int64_t rows = reader->padded_rows - first;
+    if (rows > reader->shard_rows) rows = reader->shard_rows;
+    size_t row_bytes = scale ? reader->scale_bytes : reader->weight_bytes;
+    if (rows > (INT64_MAX - offset) / (int64_t)row_bytes) return EOVERFLOW;
+    if (first >= reader->tp_end || first + rows <= reader->tp_start) return 0;
+    failure_t failure = {{0}};
+    ple_source_t key = {.shard = shard, .scale = scale};
+    if (reader->source_count && bsearch(&key, reader->sources, reader->source_count,
+                                        sizeof(key), ple_source_compare)) {
+        snprintf(failure.message, sizeof(failure.message), "PLE source shard/plane is already registered");
+    } else {
+        /* Reject FIFOs via fstat without blocking waiting for a writer. */
+        int fd = open(path, O_RDONLY | O_CLOEXEC | O_NONBLOCK | O_DIRECT);
+        struct stat status;
+        if (fd < 0) system_error(&failure, "open PLE source");
+        else if (fstat(fd, &status) != 0) system_error(&failure, "fstat PLE source");
+        else if (!S_ISREG(status.st_mode) || offset + rows * (int64_t)row_bytes > status.st_size)
+            snprintf(failure.message, sizeof(failure.message), "PLE source range exceeds a regular file's size");
+        else {
+            size_t file = 0;
+            while (file < reader->file_count &&
+                   (reader->files[file].device != status.st_dev || reader->files[file].inode != status.st_ino)) file++;
+            ple_source_t *sources = realloc(reader->sources, (reader->source_count + 1) * sizeof(*sources));
+            if (!sources) snprintf(failure.message, sizeof(failure.message), "could not allocate PLE source descriptor");
+            else {
+                reader->sources = sources;
+                if (file == reader->file_count) {
+                    ple_file_t *files = realloc(reader->files, (file + 1) * sizeof(*files));
+                    if (!files) snprintf(failure.message, sizeof(failure.message), "could not allocate PLE file descriptor");
+                    else {
+                        reader->files = files;
+                        reader->files[file] = (ple_file_t){fd, status.st_dev, status.st_ino, status.st_size};
+                        reader->file_count++;
+                        fd = -1;
+                        int error = register_files ? register_files(reader, owner) : 0;
+                        if (error < 0) {
+                            snprintf(failure.message, sizeof(failure.message),
+                                     "row file registration failed: %s", strerror(-error));
+                        }
+                    }
+                } else if (reader->files[file].bytes != status.st_size) {
+                    snprintf(failure.message, sizeof(failure.message), "PLE source file size changed during registration");
+                }
+                if (!failure.message[0]) {
+                    reader->sources[reader->source_count++] = (ple_source_t){shard, offset, file, scale != 0};
+                    qsort(reader->sources, reader->source_count, sizeof(*sources), ple_source_compare);
+                }
+            }
+        }
+        if (fd >= 0) close(fd);
+    }
+    if (failure.message[0] && !reader->failure.message[0]) reader->failure = failure;
+    return failure.message[0] ? EIO : 0;
+}
+
+static inline int ple_fragment_compare(const void *left, const void *right) {
+    const ple_fragment_t *a = left, *b = right;
+    if (a->file != b->file) return a->file < b->file ? -1 : 1;
+    return a->offset < b->offset ? -1 : a->offset > b->offset;
+}
+
+/* libc qsort may allocate a merge buffer on every run. Heap-sort in place to
+ * keep all batch metadata persistent, including for duplicate-heavy batches. */
+static inline void ple_sift(ple_fragment_t *items, size_t root, size_t count) {
+    ple_fragment_t value = items[root];
+    while (root < count / 2) {
+        size_t child = root * 2 + 1;
+        if (child + 1 < count && ple_fragment_compare(&items[child], &items[child + 1]) < 0)
+            child++;
+        if (ple_fragment_compare(&value, &items[child]) >= 0) break;
+        items[root] = items[child];
+        root = child;
+    }
+    items[root] = value;
+}
+
+static inline void ple_sort(ple_plan_t *reader) {
+    ple_fragment_t *items = reader->fragments;
+    size_t count = reader->fragment_count;
+    if (count < 1024) {
+        for (size_t i = count / 2; i > 0; i--) ple_sift(items, i - 1, count);
+        for (size_t end = count; end > 1; end--) {
+            ple_fragment_t value = items[end - 1];
+            items[end - 1] = items[0];
+            items[0] = value;
+            ple_sift(items, 0, end - 1);
+        }
+        return;
+    }
+    /* Jobs are built only after sorting. Reuse that fixed-capacity allocation
+     * as radix scratch instead of allocating another prefill-sized buffer. */
+    _Static_assert(sizeof(ple_job_t) >= sizeof(ple_fragment_t),
+                   "job allocation must cover fragment sort scratch");
+    ple_fragment_t *scratch = (ple_fragment_t *)reader->jobs;
+    ple_fragment_t *source = items, *target = scratch;
+    uint64_t offset_variation = 0, file_variation = 0;
+    for (size_t i = 1; i < count; i++) {
+        offset_variation |= (uint64_t)(items[i].offset ^ items[0].offset);
+        file_variation |= (uint64_t)(items[i].file ^ items[0].file);
+    }
+    /* Stable LSD passes sort offset first, then the primary file key. Skip
+     * constant bytes, including the file key for a single-container table. */
+    for (int file = 0; file < 2; file++) {
+        uint64_t variation = file ? file_variation : offset_variation;
+        for (unsigned shift = 0; shift < 64; shift += 8) {
+            if (((variation >> shift) & 255) == 0) continue;
+            size_t positions[256] = {0};
+            for (size_t i = 0; i < count; i++) {
+                uint64_t key = file ? (uint64_t)source[i].file : (uint64_t)source[i].offset;
+                positions[(key >> shift) & 255]++;
+            }
+            size_t prefix = 0;
+            for (unsigned i = 0; i < 256; i++) {
+                size_t size = positions[i];
+                positions[i] = prefix;
+                prefix += size;
+            }
+            for (size_t i = 0; i < count; i++) {
+                uint64_t key = file ? (uint64_t)source[i].file : (uint64_t)source[i].offset;
+                target[positions[(key >> shift) & 255]++] = source[i];
+            }
+            ple_fragment_t *swap = source;
+            source = target;
+            target = swap;
+        }
+    }
+    if (source != items) memcpy(items, source, count * sizeof(*items));
+}
+
+static inline bool ple_plan(ple_plan_t *reader, const char *ids, size_t count) {
+    reader->fragment_count = reader->job_count = 0;
+    for (size_t i = 0; i < count; i++) {
+        int64_t id;
+        memcpy(&id, ids + i * sizeof(id), sizeof(id));
+        /* Another rank's row (or a dead lookup): its slot is not read; the gather writes
+         * zeros for it without loading the slot. */
+        if (id < reader->tp_start || id >= reader->tp_end ||
+            !((reader->columns >> (i % PLE_COLUMNS)) & 1u))
+            continue;
+        for (int plane = 0; plane < (reader->scale_bytes ? 2 : 1); plane++) {
+            ple_source_t key = {.shard = id / reader->shard_rows, .scale = plane != 0};
+            ple_source_t *source = reader->source_count ? bsearch(&key, reader->sources,
+                reader->source_count, sizeof(key), ple_source_compare) : NULL;
+            if (!source) {
+                snprintf(reader->failure.message, sizeof(reader->failure.message),
+                         "missing PLE %s source for shard %lld", plane ? "scale" : "weight", (long long)key.shard);
+                return false;
+            }
+            size_t bytes = plane ? reader->scale_bytes : reader->weight_bytes;
+            size_t destination = i * bytes;
+            int64_t offset = source->offset + (id % reader->shard_rows) * (int64_t)bytes;
+            reader->requested_bytes += bytes;
+            while (bytes) {
+                unsigned length = PLE_BLOCK - (uint64_t)offset % PLE_BLOCK;
+                if (bytes < length) length = (unsigned)bytes;
+                reader->fragments[reader->fragment_count++] =
+                    (ple_fragment_t){source->file, offset, length, destination, plane != 0};
+                offset += length;
+                destination += length;
+                bytes -= length;
+            }
+        }
+    }
+    ple_sort(reader);
+    size_t cursor = 0;
+    while (cursor < reader->fragment_count) {
+        size_t begin = cursor;
+        ple_fragment_t *fragment = &reader->fragments[cursor];
+        size_t file = fragment->file;
+        int64_t first = fragment->offset & ~(int64_t)(PLE_BLOCK - 1);
+        int64_t last = first;
+        reader->unique_blocks++;
+        cursor++;
+        while (cursor < reader->fragment_count) {
+            fragment = &reader->fragments[cursor];
+            int64_t block = fragment->offset & ~(int64_t)(PLE_BLOCK - 1);
+            if (fragment->file != file || (block != last &&
+                (block - last != PLE_BLOCK || block - first >= PLE_READ_MAX))) break;
+            if (block != last) { reader->unique_blocks++; last = block; }
+            cursor++;
+        }
+        unsigned aligned = (unsigned)(last - first) + PLE_BLOCK;
+        int64_t available = reader->files[file].bytes - first;
+        unsigned expected = available < aligned ? (unsigned)available : aligned;
+        reader->jobs[reader->job_count++] = (ple_job_t){file, begin, cursor, first, aligned, expected};
+        if (last != first) reader->coalesced_reads++;
+    }
+    return true;
+}
+
+
+#endif
diff --git a/vllm/models/deepseek_v4_1/engram_rows/host_hash.py b/vllm/models/deepseek_v4_1/engram_rows/host_hash.py
new file mode 100644
index 0000000000000000000000000000000000000000..e5bba8888f39ab2f1dc888ecce29d88a61960de6
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/engram_rows/host_hash.py
@@ -0,0 +1,101 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The Engram n-gram hash on the host, for the tokens whose ids the host already has.
+
+A step's Engram lookups split by when their row IDs can exist. A prompt token's id
+is on the host when the runner prepares the step, a step before the GPU runs it, so
+its rows can be read while the previous step computes; a token the GPU samples (a
+decode token or a draft) is known only to the GPU when the step starts. This module
+hashes the first kind exactly as ``tilelang/engram_hash.py`` does on the GPU (the
+same int64 arithmetic: wrapping multiplies, XOR, TileLang's floor remainder), so the
+reader can be handed those rows early and the GPU's ids for them are never needed.
+
+``UNKNOWN`` marks a lookup whose id only the GPU will know; ``-1`` is a known "no
+row" (a padding token past the step's live tokens), as the GPU writes it.
+"""
+
+import numpy as np
+
+HEADS = 24
+LAGS = 4
+PAD_TOKEN = 2
+IMAGE_SENTINEL = 129264
+UNKNOWN = np.iinfo(np.int64).min
+
+
+class HostEngramHash:
+    """The hash geometry and tokenizer map of a model's Engram layers, on the host."""
+
+    def __init__(self, token_map, multipliers, primes, offsets):
+        self.token_map = np.asarray(token_map, dtype=np.int64)
+        self.multipliers = np.asarray(multipliers, dtype=np.int64)  # [layers, 4]
+        self.primes = np.asarray(primes, dtype=np.int64)  # [layers, 24]
+        self.offsets = np.asarray(offsets, dtype=np.int64)  # [layers, 24]
+        self.layers = self.multipliers.shape[0]
+        if self.multipliers.shape != (self.layers, LAGS) or self.primes.shape != (
+            self.layers,
+            HEADS,
+        ):
+            raise ValueError(
+                "Engram hash geometry must be [layers, 4] multipliers and "
+                "[layers, 24] primes"
+            )
+        self.pad = self.token_map[PAD_TOKEN]
+        self.vocab = self.token_map.shape[0]
+
+    def compress(self, raw: np.ndarray) -> np.ndarray:
+        """Compressed ids of raw token ids; -1 for a missing token (negative), an
+        image token or one outside the tokenizer map."""
+        raw = np.asarray(raw, dtype=np.int64)
+        valid = (raw >= 0) & (raw < self.vocab) & (raw != IMAGE_SENTINEL)
+        return np.where(valid, self.token_map[np.where(valid, raw, 0)], -1)
+
+    def hash_positions(self, tokens: np.ndarray, positions: np.ndarray) -> np.ndarray:
+        """Row ids ``[len(positions), layers, 24]`` of the tokens at ``positions``
+        of one request whose token ids up to the last position are ``tokens`` (prompt
+        order; the GPU's query tokens and committed history are the same ids)."""
+        positions = np.asarray(positions, dtype=np.int64)
+        lags = positions[:, None] - np.arange(LAGS, dtype=np.int64)[None, :]  # [T, 4]
+        raw = np.where(lags >= 0, tokens[np.maximum(lags, 0)], -1)
+        sources = self.compress(raw)
+        # From the first missing source on, every lag takes the pad id.
+        blocked = np.logical_or.accumulate(sources == -1, axis=1)
+        values = np.where(blocked, self.pad, sources)
+        # value * multiplier in wrapping int64, as the GPU computes it.
+        products = (
+            values[:, None, :].astype(np.uint64)
+            * self.multipliers[None, :, :].astype(np.uint64)
+        ).view(np.int64)  # [T, layers, 4]
+        mixed2 = products[..., 0] ^ products[..., 1]
+        mixed3 = mixed2 ^ products[..., 2]
+        mixed4 = mixed3 ^ products[..., 3]
+        # Heads 0-7 hash 2-grams, 8-15 3-grams, 16-23 4-grams.
+        mixed = np.concatenate(
+            [np.repeat(m[..., None], 8, axis=-1) for m in (mixed2, mixed3, mixed4)],
+            axis=-1,
+        )  # [T, layers, 24]
+        # The floor remainder (the sign of the divisor), as TileLang's int64 %. The
+        # model's bounded multipliers keep ``mixed`` non-negative, where it equals
+        # C's truncating one.
+        return np.remainder(mixed, self.primes[None]) + self.offsets[None]
+
+    def step_ids(self, num_tokens: int, requests) -> np.ndarray:
+        """A step's row ids ``[num_tokens, layers, 24]``: ``requests`` yields, per
+        request in the step's token order, ``(first_row, rows, tokens, positions)``:
+        the request's first row and row count in the step, its token ids, and the
+        positions of its leading rows whose ids the host has (the rest of its rows are
+        ``UNKNOWN``). Rows past the last request's rows are padding, -1 as the GPU
+        writes them."""
+        out = np.full((num_tokens, self.layers, HEADS), UNKNOWN, dtype=np.int64)
+        live = 0
+        for first_row, rows, tokens, positions in requests:
+            live = max(live, first_row + rows)
+            if len(positions):
+                out[first_row : first_row + len(positions)] = self.hash_positions(
+                    tokens, positions
+                )
+        out[live:] = -1
+        return out
+
+
+__all__ = ["HEADS", "UNKNOWN", "HostEngramHash"]
diff --git a/vllm/models/deepseek_v4_1/engram_rows/rows.py b/vllm/models/deepseek_v4_1/engram_rows/rows.py
new file mode 100644
index 0000000000000000000000000000000000000000..5210e786471dab931e63b60a74878e4bad324ee0
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/engram_rows/rows.py
@@ -0,0 +1,304 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""One Engram table's rows on one rank, read from its checkpoint file as steps ask.
+
+A step's lookups split by when their row IDs exist. The IDs the host hashed when the
+runner prepared the step (prompt tokens, ``host_hash.py``) come with the step as its
+early IDs, and the native reader (``_reader.c``), which never takes the GIL or calls
+CUDA, reads those rows as soon as the GPU has gathered the previous step, so they are
+read while the previous step computes. For the rest (tokens the GPU samples) the
+step's row IDs are copied to the host on the model's stream and the stream writes the
+step's sequence number into the control block; the reader then reads those rows and
+publishes the step. One worker serves every table in the order the steps are staged
+(layer order), so the first Engram layer's rows are never held back by the second's.
+In the forward, one thread waits for the table's step, bounded by a timeout, and stops
+the GPU with a record of the step if the rows do not come or the reader failed; then
+the gather dequantizes this rank's rows and tells the reader the buffers are free. No
+Python thread, CUDA event or stream wait is involved, so the rows arrive however busy
+the Python side is.
+"""
+
+import math
+import sys
+from contextlib import suppress
+
+import numpy as np
+import torch
+
+from vllm.models.deepseek_v4_1.engram_rows._native import load
+
+ROW_BYTES = 256  # E4M3 values of one row
+SCALE_BYTES = 8  # E8M0 scales of one row, one per 32 values
+PHASES = {
+    0: "idle",
+    1: "waiting for the step's row IDs",
+    2: "reading",
+    3: "failed",
+    4: "waiting for the GPU to gather the previous step's rows",
+}
+
+
+def _check(result, operation: str):
+    """Unpack a CUDA runtime or driver result (both report success as 0)."""
+    error, *values = result
+    if getattr(error, "value", error) != 0:
+        raise RuntimeError(f"{operation} failed: {error}")
+    return values[0] if values else None
+
+
+def _indexed(device) -> torch.device:
+    """``device`` with its index: a storage and its tensor must name the same one."""
+    device = torch.device(device)
+    if device.type == "cuda" and device.index is None:
+        return torch.device("cuda", torch.cuda.current_device())
+    return device
+
+
+def _tensor_at(pointer: int, shape, dtype, device) -> torch.Tensor:
+    nbytes = math.prod(shape) * dtype.itemsize
+    storage = torch._C._construct_storage_from_data_pointer(
+        int(pointer), device, nbytes
+    )
+    strides = [math.prod(shape[i + 1 :]) for i in range(len(shape))]
+    return torch.empty(0, dtype=dtype, device=device).set_(storage, 0, shape, strides)
+
+
+class MappedHostAllocation:
+    """Page-locked host memory the GPU reads and writes in place, with a CPU and a
+    CUDA tensor over it."""
+
+    def __init__(self, shape, dtype, device: torch.device, *, write_combined: bool):
+        from cuda.bindings import runtime as cudart
+
+        flags = cudart.cudaHostAllocMapped
+        if write_combined:  # only the CPU writes it, only the GPU reads it
+            flags |= cudart.cudaHostAllocWriteCombined
+        self.device = device = _indexed(device)
+        self.nbytes = math.prod(shape) * dtype.itemsize
+        with torch.cuda.device(device):
+            self.pointer = int(
+                _check(cudart.cudaHostAlloc(self.nbytes, flags), "cudaHostAlloc")
+            )
+            try:
+                device_pointer = _check(
+                    cudart.cudaHostGetDevicePointer(self.pointer, 0),
+                    "cudaHostGetDevicePointer",
+                )
+                self.host = _tensor_at(self.pointer, shape, dtype, torch.device("cpu"))
+                self.device_view = _tensor_at(int(device_pointer), shape, dtype, device)
+            except Exception:
+                cudart.cudaFreeHost(self.pointer)
+                self.pointer = 0
+                raise
+
+    def close(self) -> None:
+        from cuda.bindings import runtime as cudart
+
+        if self.pointer:
+            _check(cudart.cudaFreeHost(self.pointer), "cudaFreeHost")
+            self.pointer = 0
+
+    def __del__(self):
+        if self.pointer and sys is not None and not sys.is_finalizing():
+            with suppress(Exception):
+                self.close()
+
+
+ALL_COLUMNS = (1 << 24) - 1
+
+
+class EngramDiskRows:
+    """Rows ``[shard_start, shard_end)`` of the hash columns in ``columns``, a 24-bit
+    mask, of one Engram table (lookup i is column i % 24), ``max_lookups`` per step.
+
+    ``ids_timeout_s`` bounds the reader's waits for the GPU (a step's row IDs, or its
+    gather of the previous step) and ``rows_timeout_s`` the GPU's wait for its rows;
+    ``delay_s`` (tests only) delays every read; ``check_early`` (debug) fails a step
+    whose early ID differs from the GPU's.
+    """
+
+    def __init__(
+        self,
+        *,
+        device,
+        table_rows: int,
+        shard_start: int,
+        shard_end: int,
+        max_lookups: int,
+        columns: int = ALL_COLUMNS,
+        queue_depth: int = 128,
+        ids_timeout_s: float = 20.0,
+        rows_timeout_s: float = 10.0,
+        delay_s: float = 0.0,
+        check_early: bool = False,
+        timeline: bool = False,
+    ):
+        self.native = load()
+        self.device = _indexed(device)
+        self.shard_start, self.shard_end = int(shard_start), int(shard_end)
+        self.table_rows = int(table_rows)
+        self.columns = int(columns)
+        if not 0 < self.columns <= ALL_COLUMNS:
+            raise ValueError(
+                f"Engram reader columns must be a nonzero 24-bit mask: {columns:#x}"
+            )
+        self.max_lookups = int(max_lookups)
+        self.check_early = bool(check_early)
+        self.timeline_enabled = bool(timeline)
+        self._allocations = []
+        self.ids = torch.empty(self.max_lookups, dtype=torch.int64, pin_memory=True)
+        self.weights = self._mapped((self.max_lookups, ROW_BYTES), torch.uint8, True)
+        self.scales = self._mapped((self.max_lookups, SCALE_BYTES), torch.uint8, True)
+        self.control = self._mapped((self.native.CTRL_WORDS,), torch.int32, False)
+        self.control.host.zero_()
+        self._control = self.control.host.numpy().view(np.uint32)
+        self._control[self.native.CTRL_TIMEOUT_US] = int(rows_timeout_s * 1e6)
+        self.rows_e4m3 = self.weights.device_view.view(torch.float8_e4m3fn)
+        self._reader = self.native.reader(
+            table_rows,
+            self.shard_start,
+            self.shard_end,
+            self.columns,
+            self.max_lookups,
+            queue_depth,
+            self.ids.data_ptr(),
+            self.weights.pointer,
+            self.scales.pointer,
+            self.control.pointer,
+            float(ids_timeout_s),
+            float(delay_s),
+            self.check_early,
+            self.timeline_enabled,
+        )
+        self._ids_seq_device = (
+            self.control.device_view.data_ptr() + 4 * self.native.CTRL_IDS_SEQ
+        )
+        self._sequence = 0
+
+    def _mapped(self, shape, dtype, write_combined: bool) -> MappedHostAllocation:
+        allocation = MappedHostAllocation(
+            shape, dtype, self.device, write_combined=write_combined
+        )
+        self._allocations.append(allocation)
+        return allocation
+
+    def add_source(self, path: str, offset: int, *, scale: bool) -> None:
+        """Register the table's E4M3 rows (``scale=False``) or E8M0 scale rows, which
+        start at ``offset`` in the immutable file ``path``."""
+        self.native.add(self._reader, path, int(offset), bool(scale))
+
+    def stage(
+        self,
+        stream: torch.cuda.Stream,
+        ids: torch.Tensor,
+        count: int,
+        early: np.ndarray | None = None,
+    ) -> None:
+        """Queue a step: ``ids`` holds its ``count`` row IDs (contiguous int64 on the
+        device, written by the GPU's hash); ``early`` (``count`` int64 on the host, or
+        None) the IDs the host hashed, ``host_hash.UNKNOWN`` where only the GPU knows
+        one. Returns at once; the forward's ``gather`` waits for the rows."""
+        self.raise_if_failed()
+        from cuda.bindings import driver
+
+        if early is not None:
+            early = np.ascontiguousarray(early, dtype=np.int64).reshape(-1)
+            if early.shape[0] != count:
+                raise ValueError(
+                    f"Engram early IDs: {early.shape[0]} for a step of {count} lookups"
+                )
+        self._sequence = (self._sequence + 1) & 0xFFFFFFFF or 1
+        with torch.cuda.stream(stream):
+            self.ids[:count].copy_(ids.view(-1)[:count], non_blocking=True)
+        _check(
+            driver.cuStreamWriteValue32(
+                stream.cuda_stream, self._ids_seq_device, self._sequence, 0
+            ),
+            "cuStreamWriteValue32",
+        )
+        self.native.submit(self._reader, self._sequence, count, 60.0, early)
+
+    def gather(
+        self, out: torch.Tensor, ids: torch.Tensor, num_tokens: torch.Tensor
+    ) -> None:
+        """Wait for the staged step's rows and dequantize the first ``num_tokens``
+        tokens' rows into ``out`` (``[tokens, 24 * 256]`` BF16), zero elsewhere and for
+        rows outside this rank's shard or columns. Capturable in a CUDA graph."""
+        from vllm.models.deepseek_v4_1.tilelang.engram_rows import engram_rows_gather
+
+        engram_rows_gather(
+            ids,
+            num_tokens,
+            self.rows_e4m3,
+            self.scales.device_view,
+            self.control.device_view,
+            out,
+            self.shard_start,
+            self.shard_end,
+            self.columns,
+        )
+
+    def failure(self) -> str | None:
+        """Why the rows stopped, or None: the reader's failure or the GPU's timeout."""
+        n = self.native
+        status = n.status(self._reader)
+        failed = int(self._control[n.CTRL_FAILED_SEQ])
+        if status["failure"] is None and not failed:
+            return None
+        parts = []
+        if failed:
+            parts.append(
+                f"the GPU waited {int(self._control[n.CTRL_WAITED_US])} us "
+                "for the rows of "
+                f"Engram step {failed} and stopped"
+            )
+        phase = PHASES.get(int(self._control[n.CTRL_PHASE]), "unknown")
+        parts.append(
+            f"the reader is {phase} on step {int(self._control[n.CTRL_PHASE_SEQ])}, "
+            f"last published {int(self._control[n.CTRL_ROWS_SEQ])}"
+        )
+        if status["failure"] is not None:
+            parts.append(status["failure"])
+        return "; ".join(parts)
+
+    def raise_if_failed(self) -> None:
+        """Two control-block reads per step; the message is built only on a failure."""
+        n = self.native
+        if self._control[n.CTRL_PHASE] == 3 or self._control[n.CTRL_FAILED_SEQ]:
+            raise RuntimeError(f"Engram rows: {self.failure()}")
+
+    def stats(self) -> dict:
+        return self.native.status(self._reader)
+
+    TIMELINE_FIELDS = (
+        "sequence",
+        "count",
+        "early",
+        "gpu_sequence",
+        "gpu_wait_ns",
+        "submitted",
+        "started",
+        "consumed",
+        "ids",
+        "read",
+        "published",
+        "plan_ns",
+    )
+
+    def timeline(self) -> list[dict]:
+        """Debug: the steps served since the last call, oldest first (``timeline`` on).
+        Times are CLOCK_MONOTONIC ns: the host queued the step (submitted), the worker
+        began it (started), saw the previous step gathered (consumed, early rows only),
+        saw the GPU's IDs (ids), read the rows (read) and published them (published).
+        gpu_wait_ns is the GPU's wait for gpu_sequence, the step before this one;
+        plan_ns is the time spent planning (sorting and merging its lookups)."""
+        rows = self.native.timeline(self._reader)
+        return [dict(zip(self.TIMELINE_FIELDS, row)) for row in rows]
+
+    def close(self) -> None:
+        """Stop the reader, then free the buffers; the GPU must be done with them."""
+        self._reader = None
+        torch.cuda.synchronize(self.device)
+        for allocation in self._allocations:
+            allocation.close()
+        self._allocations = []
diff --git a/vllm/models/deepseek_v4_1/greedy.py b/vllm/models/deepseek_v4_1/greedy.py
