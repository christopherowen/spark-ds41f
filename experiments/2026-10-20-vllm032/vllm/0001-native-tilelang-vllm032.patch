+def test_model_load_keeps_descriptors_and_finishes_before_return(checkpoint):
+    loader, path, tensors = checkpoint
+    events = []
+
+    class CpuSession:
+        def weights(self, files, *, prefix, skip, **kwargs):
+            for path in files:
+                with safe_open(path, framework="pt") as data:
+                    for name in sorted(data.keys()):
+                        if not skip(name):
+                            events.append(("read", name))
+                            yield prefix + name, data.get_tensor(name)
+
+        def finish(self):
+            events.append(("finish",))
+
+    class Fixture(nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.weight = nn.Parameter(torch.empty((2, 4)), requires_grad=False)
+            self.tables = []
+
+        def checkpoint_file_weight_filter(self, name):
+            return name.endswith(("embed.weight", "embed.scale"))
+
+        def is_unused_checkpoint_weight(self, name):
+            return (
+                name != "layers.4.engram.q_weight"
+                and not self.checkpoint_file_weight_filter(name)
+            )
+
+        def load_weights(self, weights):
+            for name, tensor in weights:
+                if self.checkpoint_file_weight_filter(name):
+                    self.tables.append(get_file_tensor_source(tensor))
+                else:
+                    self.weight.copy_(tensor[2:4])
+            return {"weight"}
+
+    loader._session = CpuSession()
+    loader._init_ep_weight_filter = lambda config: None
+    loader._init_mm_encoder_only_weight_filter = lambda model, config: None
+    fixture = Fixture()
+    loader.load_weights(
+        fixture,
+        SimpleNamespace(
+            model=str(path.parent), revision=None, quantization="deepseek_v41_fp8"
+        ),
+    )
+    assert torch.equal(fixture.weight, tensors["layers.4.engram.q_weight"][2:4])
+    assert len(fixture.tables) == 2 and all(fixture.tables)
+    assert events == [("read", "layers.4.engram.q_weight"), ("finish",)]
