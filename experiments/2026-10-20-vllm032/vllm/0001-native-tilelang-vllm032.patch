+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import inspect
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.config.compilation import CUDAGraphMode
+from vllm.models.deepseek_v4_1.speculator import DSparkSpeculator
+from vllm.v1.attention.backends.utils import PAD_SLOT_ID
+from vllm.v1.worker.gpu.spec_decode.dflash import speculator as module
+
+
+@pytest.mark.parametrize("query_per_request", [5, 6])
+def test_dspark_reused_graph_padding_does_not_clear_context_capacity(
+    query_per_request, monkeypatch
+):
+    capacity, max_requests, sentinel = 8192, 16, 987654321
+    query_capacity = max_requests * query_per_request
+    spec = object.__new__(DSparkSpeculator)
+    spec.num_query_per_req = query_per_request
+    spec.num_speculative_steps = 5
+    spec.max_num_tokens = capacity
+    spec.max_num_reqs = max_requests
+    spec.max_model_len = 1048576
+    spec.hidden_states = torch.zeros((capacity, 1))
+    spec.context_positions = torch.full((capacity,), sentinel)
+    spec._context_slot_mappings = torch.full((2, capacity), sentinel)
+    spec.sample_indices = spec.sample_pos = spec.sample_idx_mapping = None
+    spec.temperature = spec.seeds = None
+    spec.input_buffers = None
+    spec.pcp_manager = spec._context_preparer = spec._layer_group_idx = None
+    spec.draft_kv_cache_group_id = 0
+    spec.draft_kv_cache_group_ids = [0, 1]
+    spec.dcp_size = 1
+    spec.parallel_drafting_token_id = 0
+    spec.sample_from_anchor = query_per_request == 5
+    spec.dp_size, spec.dp_rank = 1, 0
+    spec.supports_decode_metadata_update = True
+    spec.draft_tokens = torch.zeros((max_requests, 5), dtype=torch.int64)
+    spec.block_tables = SimpleNamespace(
+        slot_mappings=torch.full((2, capacity), sentinel),
+        input_block_tables=[None, None],
+        block_sizes=[256, 128],
+        cp_rank=0,
+        cp_interleave=1,
+    )
+    spec.prepare_context_anchor = lambda *args: None
+    spec._prepare_eplb_forward = lambda *args: None
+    spec.model = SimpleNamespace(capture_context_preparation=lambda: None)
+    preparation_signature = inspect.signature(module.prepare_dflash_inputs)
+    context_views, replay_views = [], []
+
+    def prepare(*args):
+        values = preparation_signature.bind(*args).arguments
+        batch = values["input_batch"]
+        live = batch.num_reqs * values["num_query_per_req"]
+        slots = values["query_slot_mapping"]
+        slots[:live] = torch.arange(live) + 1
+        slots[live : values["max_num_tokens"]] = PAD_SLOT_ID
+        count = batch.num_tokens
+        values["context_positions"][:count].copy_(batch.positions)
+        values["context_slot_mapping"][:count] = torch.arange(count) + 1
+
+    def precompute(states, positions, slots):
+        context_views.append((states, positions, slots))
+
+    def replay(descriptor):
+        replay_views.append(spec.block_tables.slot_mappings[:, : descriptor.num_tokens])
+
+    spec.model.precompute_and_store_context_kv = precompute
+    spec.query_cudagraph_manager = SimpleNamespace(run_fullgraph=replay)
+    monkeypatch.setattr(module, "prepare_dflash_inputs", prepare)
+    monkeypatch.setattr(
+        module,
+        "dispatch_cg_and_sync_dp",
+        lambda *args, **kwargs: (
+            SimpleNamespace(
+                cg_mode=CUDAGraphMode.FULL,
+                num_tokens=query_capacity,
+                num_reqs=max_requests,
+            ),
+            None,
+        ),
+    )
+    slots_pointer = spec.block_tables.slot_mappings.data_ptr()
+    for requests, context_tokens in [(16, 96), (1, 1024), (8, 48)]:
+        batch = SimpleNamespace(
+            num_reqs=requests,
+            num_tokens=context_tokens,
+            positions=torch.arange(context_tokens) + 100,
+            seq_lens_cpu_upper_bound=torch.full((requests,), 1000),
+        )
+        result = spec.propose(
+            batch,
+            {},
+            {},
+            torch.ones((context_tokens, 1)),
+            None,
+            torch.ones(requests),
+            torch.zeros(requests),
+            None,
+            None,
+            None,
+            None,
+        )
+        live = requests * query_per_request
+        assert result.shape == (requests, 5)
+        assert replay_views[-1].data_ptr() == slots_pointer
+        assert torch.equal(replay_views[-1][0, :live], torch.arange(live) + 1)
+        assert torch.all(replay_views[-1][:, live:] == PAD_SLOT_ID)
+        assert torch.all(
+            spec.block_tables.slot_mappings[:, query_capacity:] == sentinel
+        )
+        states, positions, slots = context_views[-1]
+        assert states.shape[0] == context_tokens
+        assert torch.equal(positions, batch.positions)
+        assert slots.shape == (context_tokens,)
+        assert torch.equal(slots, torch.arange(context_tokens) + 1)
+        assert spec._context_slot_mappings.shape == (2, capacity)
