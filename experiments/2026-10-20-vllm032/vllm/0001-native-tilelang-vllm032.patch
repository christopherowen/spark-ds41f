+def _minimum_state(device="cpu", minimum=4, stop_ids=(1, 6)):
+    from vllm.sampling_params import SamplingParams
+
+    class Buffer:
+        def __init__(self, shape, dtype=np.int32):
+            self.np = np.zeros(shape, dtype=dtype)
+            self.gpu = torch.from_numpy(self.np).to(device)
+
+        def stage_write(self, row, start, values):
+            values = list(values)
+            self.np[row, start : start + len(values)] = values
+
+        def sync(self):
+            self.gpu.copy_(torch.from_numpy(self.np))
+
+    runner, batch, logits = _runner(device)
+    batch.idx_mapping = batch.idx_mapping.to(torch.int64)
+    batch.expanded_idx_mapping = batch.expanded_idx_mapping.to(torch.int64)
+    bias = object.__new__(greedy.LogitBiasState)
+    bias.prompt_len_np = np.array([100, 200, 3])
+    bias.use_logit_bias = np.zeros(3, dtype=bool)
+    for name in (
+        "num_allowed_token_ids",
+        "num_logit_bias",
+        "min_lens",
+        "num_stop_token_ids",
+        "restore_when_all_masked",
+    ):
+        setattr(bias, name, Buffer(3))
+    for name in (
+        "allowed_token_ids",
+        "logit_bias_token_ids",
+        "logit_bias",
+        "stop_token_ids",
+    ):
+        dtype = np.float32 if name == "logit_bias" else np.int32
+        setattr(bias, name, Buffer((3, 128), dtype))
+    params = SamplingParams(
+        temperature=0,
+        min_tokens=minimum,
+        max_tokens=max(minimum, 4),
+        ignore_eos=True,
+        stop=[],
+    )
+    params.update_from_generation_config(
+        {"eos_token_id": list(stop_ids)}, eos_token_id=stop_ids[0]
+    )
+    for row in range(3):
+        runner.sampler.needs_logits_processing[row] = bias.add_request(row, params)
+    for value in vars(bias).values():
+        if isinstance(value, Buffer):
+            value.sync()
+    penalties = object.__new__(greedy.PenaltiesState)
+    penalties.use_penalty = np.zeros(3, dtype=bool)
+    bad_words = object.__new__(greedy.BadWordsState)
+    bad_words.num_bad_words = Buffer(3)
+    sampler = runner.sampler
+    sampler.logits_processors = [bias, penalties, bad_words]
+    sampler.penalties_state = penalties
+    sampler.req_states.max_num_reqs = 3
+    sampler.req_states.device = torch.device(device)
+    sampler.thinking_budget_state = ThinkingBudgetState(sampler.req_states, None)
+    sampler.thinking_budget_state.use_thinking_budget = np.zeros(3, dtype=bool)
+    states = object.__new__(SamplingStates)
+    states.temperature = sampler.sampling_states.temperature
+    states.seeds = sampler.sampling_states.seeds
+    states.seeds_set = np.zeros(3, dtype=bool)
+    states.num_logprobs = np.full(3, NO_LOGPROBS, dtype=np.int32)
+    sampler.sampling_states = states
+    states.vocab_size = 8
+    states.min_p = SimpleNamespace(np=np.zeros(3))
+    states.top_p = SimpleNamespace(np=np.ones(3))
+    states.top_k = SimpleNamespace(np=np.full(3, 8))
+    return runner, batch, logits, bias, params
