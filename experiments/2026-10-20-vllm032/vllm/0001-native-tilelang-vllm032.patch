+    assert config.engram_config.disk_offload
+    assert config.engram_config.get_parallel_size(config.parallel_config) == tp_size
+
+
+@pytest.mark.parametrize(
+    "unsupported", ["backend", "model", "v1", "loader", "eager", "threads", "dp"]
+)
+def test_native_disk_config_rejects_unsupported_execution(unsupported, monkeypatch):
+    monkeypatch.setattr(envs, "VLLM_DS41_KERNEL_BACKEND", "tilelang")
