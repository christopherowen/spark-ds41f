+
+    # SWA-only layers (idx_width == 0) compile without the indexed tensors.
+    if schedule == "extend":
+        if idx_blocks:
+
+            @T.prim_func
+            def sparse_mla(
+                Q: T.Tensor([rows, heads, D], dtype),
+                SwaRecords: T.StridedTensor(
