index 0000000000000000000000000000000000000000..b70c23acee396999c1b7a7c0bb5ff938c9e01e1f
--- /dev/null
+++ b/vllm/models/deepseek_v4_1/greedy_verification.py
@@ -0,0 +1,162 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Greedy verification without gathering the target's logits.
+
+When every request in a step is greedy and nothing reads or changes its logits
+(no logprobs, penalties, logit bias, bad words, thinking budget, grammar, top-k,
+top-p or min-p), verification needs only the target's argmax at each verified
+position. Each tensor-parallel rank reduces its vocabulary shard to one
+``(max, global index)`` pair per row; the pairs are all-gathered (8 bytes per row
+and rank instead of the shard's logits) and reduced to the first maximum, which
+is ``torch.argmax`` of the full row, ties and NaNs included. The acceptance rule
+is ``rejection_sample``'s greedy branch: a draft is accepted while it equals the
+target's argmax; the first mismatch commits the argmax, and a fully accepted
+block commits the argmax at the bonus position.
+"""
+
+from typing import Any
+
+import torch
+
+from vllm.distributed import tensor_model_parallel_all_gather
+from vllm.model_executor.warmup.jit_warmup_triton_helper import (
+    TritonWarmupTensor,
+    triton_kernel_dispatcher_with_warmup,
+    triton_warmup_inputs,
+)
+from vllm.triton_utils import tl, triton
+from vllm.v1.worker.gpu.spec_decode.dspark.greedy import (
+    greedy_shard_pair,
+    register_greedy_shard_pair_warmup,
+    register_select_first_argmax_warmup,
+    scratch_shape,
+    select_first_argmax,
+)
+
+
+def vocab_parallel_argmax(
+    local_logits: torch.Tensor, vocab: int, vocab_start: int, tp_size: int
+) -> torch.Tensor:
+    """The full-vocabulary argmax of each row ([rows], int64) from this rank's
+    shard of the logits (``vocab`` real columns starting at ``vocab_start``)."""
+    rows = local_logits.shape[0]
+    shape = scratch_shape(rows, vocab)
+    values = torch.empty(shape, dtype=torch.float32, device=local_logits.device)
+    indices = torch.empty(shape, dtype=torch.int32, device=local_logits.device)
+    pairs = torch.empty((rows, 2), dtype=torch.float32, device=local_logits.device)
+    greedy_shard_pair(local_logits, vocab, vocab_start, pairs, values, indices)
+    if tp_size > 1:
+        pairs = tensor_model_parallel_all_gather(pairs, dim=-1)
+    ids = torch.empty(rows, dtype=torch.int64, device=local_logits.device)
+    select_first_argmax(pairs, ids)
+    return ids
+
+
+@triton.jit
+def _greedy_rejection_kernel(
+    sampled_ptr,
+    sampled_stride,
+    num_sampled_ptr,
+    target_ids_ptr,
+    draft_sampled_ptr,
+    cu_num_logits_ptr,
+):
+    req_idx = tl.program_id(0)
+    start_idx = tl.load(cu_num_logits_ptr + req_idx).to(tl.int64)
+    end_idx = tl.load(cu_num_logits_ptr + req_idx + 1).to(tl.int64)
+    num_draft_tokens = end_idx - start_idx - 1
+    accepted_length = tl.zeros((), tl.int64)
+    verifying = True
+    for i in range(num_draft_tokens):
+        if verifying:
+            draft = tl.load(draft_sampled_ptr + start_idx + i + 1).to(tl.int64)
+            target = tl.load(target_ids_ptr + start_idx + i)
+            # -1 is a placeholder draft that is always rejected.
+            accepted = (target == draft) & (draft >= 0)
+            tl.store(
+                sampled_ptr + req_idx * sampled_stride + i,
+                tl.where(accepted, draft, target),
+            )
+            verifying = accepted
+            accepted_length += accepted.to(tl.int64)
+    if accepted_length == num_draft_tokens:
+        # Every draft accepted: the bonus position's argmax.
+        tl.store(
+            sampled_ptr + req_idx * sampled_stride + num_draft_tokens,
+            tl.load(target_ids_ptr + start_idx + num_draft_tokens),
+        )
+    tl.store(num_sampled_ptr + req_idx, (accepted_length + 1).to(tl.int32))
+
+
+def _greedy_rejection_warmup_inputs(*, num_speculative_steps: int) -> dict[str, Any]:
+    return triton_warmup_inputs(
+        _greedy_rejection_kernel,
+        TritonWarmupTensor(torch.int64),
+        num_speculative_steps + 1,
+        TritonWarmupTensor(torch.int32),
+        TritonWarmupTensor(torch.int64),
+        TritonWarmupTensor(torch.int32),
+        TritonWarmupTensor(torch.int32),
+        grid=(1,),
+        num_warps=1,
+    )
+
+
+_greedy_rejection_launcher = triton_kernel_dispatcher_with_warmup(
+    warmup_inputs=_greedy_rejection_warmup_inputs
+)(_greedy_rejection_kernel)
+
+
+def register_greedy_verification_warmups(
+    *,
+    logits_dtype: torch.dtype,
+    logits_stride: int,
+    vocab: int,
+    vocab_start: int,
+    tp_size: int,
+    num_speculative_steps: int,
+) -> None:
+    """Register the kernels ``vocab_parallel_argmax`` and ``greedy_rejection_sample``
+    launch: this rank's shard of ``compute_logits_local`` (``logits_dtype``, rows
+    ``logits_stride`` elements apart, ``vocab`` real columns from global index
+    ``vocab_start``), drafts and logits offsets from the input batch (int32)."""
+    register_greedy_shard_pair_warmup(
+        logits_dtype=logits_dtype,
+        logits_stride=logits_stride,
+        vocab=vocab,
+        vocab_start=vocab_start,
+    )
+    register_select_first_argmax_warmup(
+        ranks=tp_size, output_dtype=torch.int64, output_stride=1, output_aligned=True
+    )
+    _greedy_rejection_launcher.register_warmup(
+        num_speculative_steps=num_speculative_steps
+    )
+
+
+def greedy_rejection_sample(
+    target_ids: torch.Tensor,
+    draft_sampled: torch.Tensor,
+    cu_num_logits: torch.Tensor,
+    num_speculative_steps: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """``rejection_sample`` for an all-greedy batch from the target's argmax ids.
+
+    Returns ``sampled`` ([num_reqs, num_speculative_steps + 1], int64) and
+    ``num_sampled`` ([num_reqs], int32), the committed prefix of each row.
+    """
+    num_reqs = cu_num_logits.shape[0] - 1
+    sampled = draft_sampled.new_empty(
+        num_reqs, num_speculative_steps + 1, dtype=torch.int64
+    )
+    num_sampled = sampled.new_empty(num_reqs, dtype=torch.int32)
+    _greedy_rejection_launcher[(num_reqs,)](
+        sampled,
+        sampled.stride(0),
+        num_sampled,
+        target_ids,
+        draft_sampled,
+        cu_num_logits,
+        num_warps=1,
+    )
+    return sampled, num_sampled
