@@ -0,0 +1,178 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+from __future__ import annotations
+
+import dataclasses
+import heapq
+import json
+import math
+import time
+from pathlib import Path
+
+import torch
+
+from vllm import envs
+from vllm.logger import init_logger
+from vllm.model_executor.model_loader.default_loader import DefaultModelLoader
+from vllm.model_executor.model_loader.ep_weight_filter import should_skip_weight
+from vllm.model_executor.model_loader.weight_utils import (
+    file_source_tensor,
+    safetensors_file_sources,
+)
+from vllm.model_executor.weight_transfer import weight_transfer
+from vllm.platforms import current_platform
+
+from .checkpoint_copy import DirectCheckpointCopies
+
+logger = init_logger(__name__)
+
+
+class NativeB12xModelLoader(DefaultModelLoader):
+    def __init__(self, load_config):
+        options = dict(load_config.model_loader_extra_config)
+        self.io_threads = options.pop("io_threads", 8)
+        if type(self.io_threads) is not int or not 1 <= self.io_threads <= 16:
+            raise ValueError("native_b12x io_threads must be between 1 and 16")
+        if options.get("enable_multithread_load"):
+            raise ValueError("native_b12x requires single-threaded weight routing")
+        if load_config.safetensors_load_strategy not in (None, "lazy"):
+            raise ValueError("native_b12x requires lazy checkpoint metadata")
+        super().__init__(
+            dataclasses.replace(
+                load_config,
+                load_format="safetensors",
+                model_loader_extra_config=options,
+            )
+        )
+        self._session = None
+
+    def load_model(self, vllm_config, model_config, prefix=""):
+        if (
+            envs.VLLM_DS41_KERNEL_BACKEND != "tilelang"
+            or model_config.architecture
+            not in {"DeepseekV41ForCausalLM", "DSparkV41DraftModel"}
+            or not current_platform.is_cuda()
+            or not current_platform.is_device_capability_family(120)
+            or vllm_config.parallel_config.data_parallel_size != 1
+            or vllm_config.parallel_config.enable_expert_parallel
+            or vllm_config.is_mm_encoder_only
+        ):
+            raise ValueError("native_b12x requires native V4.1 TileLang on SM12x DP1")
+        from b12x.loader._checkpoint import DirectWeightSession
+
+        device = torch.device(
+            self.load_config.device or vllm_config.device_config.device
+        )
+        if device.type != "cuda":
+            raise ValueError("native_b12x requires CUDA weight allocations")
+        index = device.index
+        if index is None:
+            index = torch.accelerator.current_device_index()
+        with (
+            DirectWeightSession(
+                index, io_threads=self.io_threads, read_mode="bounce"
+            ) as session,
+            weight_transfer(session),
+        ):
+            self._session = session
+            try:
+                model = super().load_model(vllm_config, model_config, prefix)
+                model._b12x_loader_storage = {"io": session.stats()}
+            finally:
+                self._session = None
+        return model
+
+    def load_weights(self, model, model_config):
+        if self._session is None:
+            raise RuntimeError("native_b12x requires an initial-load session")
+        self._init_ep_weight_filter(model_config)
+        self._init_mm_encoder_only_weight_filter(model, model_config)
+        with DirectCheckpointCopies(self._session):
+            loaded_weights = model.load_weights(
+                self.get_all_weights(model_config, model)
+            )
+        self._session.finish()
+        self.counter_after_loading_weights = time.perf_counter()
+        logger.info(
+            "Native direct checkpoint loading took %.2f seconds",
+            self.counter_after_loading_weights - self.counter_before_loading_weights,
+        )
+        if self.enable_weights_track or (
+            self.enable_weights_track is None
+            and model_config.quantization is None
+            and loaded_weights is not None
+        ):
+            self.track_weights_loading(
+                model, loaded_weights, quantized=model_config.quantization is not None
+            )
+
+    @staticmethod
+    def _needs_values(entry):
+        return math.prod(entry.shape) == 1 or entry.name.rsplit(".", 1)[-1] in {
+            "layer_multipliers",
+            "ngram_heads_offsets",
+            "ngram_heads_vocab_sizes",
+        }
+
+    def _get_weights_iterator(self, source):
+        session = self._session
+        if session is None:
+            raise RuntimeError("native_b12x requires an initial-load session")
+        folder, files, safetensors, index_file = self._prepare_weights(
+            source.model_or_path,
+            source.subfolder,
+            source.revision,
+            False,
+            source.allow_patterns_overrides,
+        )
+        if not safetensors:
+            raise ValueError("native_b12x requires safetensors checkpoints")
+        index_path = Path(folder) / index_file
+        weight_map = (
+            json.loads(index_path.read_text())["weight_map"]
+            if index_path.is_file()
+            else None
+        )
+        if not self.counter_before_loading_weights:
+            self.counter_before_loading_weights = time.perf_counter()
+        for path in files:
+            sources = safetensors_file_sources(path)
+            resolved_path = Path(path).resolve()
+
+            def skip(name, resolved_path=resolved_path):
+                return (
+                    (
+                        source.is_unused_weight is not None
+                        and source.is_unused_weight(name)
+                    )
+                    or should_skip_weight(name, self.local_expert_ids)
+                    or (
+                        weight_map is not None
+                        and (
+                            name not in weight_map
+                            or Path(folder, weight_map[name]).resolve() != resolved_path
+                        )
+                    )
+                )
+
+            file_names = {
+                name
+                for name in sources
+                if source.file_weight_filter is not None
+                and source.file_weight_filter(name)
+            }
+            file_backed = (
+                (source.prefix + name, file_source_tensor(sources[name]))
+                for name in sorted(file_names)
+                if not skip(name)
+            )
+            ordinary = session.weights(
+                [path],
+                prefix=source.prefix,
+                index_path=index_path,
+                needs_values=self._needs_values,
+                skip=lambda name, file_names=file_names, skip=skip: (
+                    name in file_names or skip(name)
+                ),
+            )
+            yield from heapq.merge(file_backed, ordinary, key=lambda item: item[0])
