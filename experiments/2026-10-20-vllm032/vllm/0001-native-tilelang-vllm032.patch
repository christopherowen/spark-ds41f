+    elif fallback == "non_native_head":
+        runner.model.logits_processor = SimpleNamespace(scale=1.0, soft_cap=None)
+    elif fallback == "custom_native_head":
+        custom_type = type("CustomHead", (NativeLogitsProcessor,), {})
