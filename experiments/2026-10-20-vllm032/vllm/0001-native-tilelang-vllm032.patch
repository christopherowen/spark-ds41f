+# Declaring a plan warms TileKernels' token cast for the scheduler's batch buckets.
+pytestmark = pytest.mark.usefixtures("default_vllm_config")
+
+DEVICE = "cuda"
+E2M1 = (
+    0.0,
+    0.5,
+    1.0,
+    1.5,
+    2.0,
+    3.0,
+    4.0,
+    6.0,
+    -0.0,
+    -0.5,
+    -1.0,
+    -1.5,
+    -2.0,
+    -3.0,
+    -4.0,
+    -6.0,
+)
+LIMIT = 10.0
