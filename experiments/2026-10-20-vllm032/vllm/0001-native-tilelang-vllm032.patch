+@pytest.mark.parametrize("with_finalizer", [False, True])
+@pytest.mark.parametrize(
+    "mode,num_ubatches",
+    [(CUDAGraphMode.FULL, 1), (CUDAGraphMode.PIECEWISE, 1), (CUDAGraphMode.FULL, 2)],
+)
+def test_capture_finalizes_inputs_after_attention(
+    monkeypatch, mode, num_ubatches, with_finalizer
+):
+    events = []
+    state = SimpleNamespace(generation=0, prepare_dummy_inputs=lambda nr, nt: {})
+
+    def prepare_attention(*args, **kwargs):
+        state.generation += 1
+        events.append("attention")
+        return {}, {}
+
+    def finalize(inputs, cg_mode):
+        assert events[-1] == "attention" and cg_mode == mode
+        inputs["ced_indices"] = state.generation
+        events.append("finalize")
+
+    if with_finalizer:
+        state.finalize_cudagraph_inputs = finalize
+
+    def model(**inputs):
+        if with_finalizer:
+            assert inputs["ced_indices"] == state.generation
+        else:
+            assert "ced_indices" not in inputs
+        events.append("model")
+        return torch.ones(4, 2)
+
+    class UBatch:
+        def prepare(self, *args, **kwargs):
+            prepare_attention()
+            return object()
+
+        def begin_capturable_run(self, model, inputs, ubatch_state, **kwargs):
+            return lambda: model(**inputs)
+
+    manager = cgu.ModelCudaGraphManager.__new__(cgu.ModelCudaGraphManager)
+    manager.vllm_config = SimpleNamespace(
+        parallel_config=SimpleNamespace(data_parallel_size=1)
+    )
