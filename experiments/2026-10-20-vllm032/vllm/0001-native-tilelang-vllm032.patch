+    if unsupported == "backend":
+        monkeypatch.setattr(envs, "VLLM_DS41_KERNEL_BACKEND", "b12x")
+    elif unsupported == "model":
+        config.model_config.architecture = "LlamaForCausalLM"
+    elif unsupported == "v1":
+        config.use_v2_model_runner = False
+    elif unsupported == "loader":
+        config.load_config.load_format = "safetensors"
+    elif unsupported == "eager":
+        config.load_config.safetensors_load_strategy = "eager"
+    elif unsupported == "threads":
+        config.load_config.model_loader_extra_config["enable_multithread_load"] = True
+    else:
+        config.parallel_config.data_parallel_size = 2
+    with pytest.raises(ValueError):
