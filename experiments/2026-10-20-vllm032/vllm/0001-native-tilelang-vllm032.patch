+                        T.sync_threads()
+                        # The next chunk's records load while this chunk computes.
+                        if chunk + 1 < chunks:
+                            stage_chunk(
+                                SwaRecords,
+                                IdxRecords,
+                                chunk + 1,
+                                slots,
+                                (chunk + 1) * BI,
