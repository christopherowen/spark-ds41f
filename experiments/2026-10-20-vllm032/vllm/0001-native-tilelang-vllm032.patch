+def test_tp_views_queue_copies_and_numeric_consumers_flush():
+    records = []
+
+    class Session:
+        def __call__(self, destination, source):
+            records.append((tuple(source.shape), source.storage_offset(), source.dtype))
+            return True
+
+        def flush(self):
+            records.append("flush")
+
+    with FakeTensorMode():
+        destination = torch.empty((2, 4), device="cuda:0")
+        source = torch.empty((8, 4), device="meta")
+        scales = torch.empty((32,), dtype=torch.float8_e8m0fnu, device="meta")
+        with DirectCheckpointCopies(Session()):
+            assert destination.copy_(source[2:4]) is destination
+            view = destination.view(8)
+            assert records == [((2, 4), 8, torch.float32)]
+            byte_scales = scales.view(torch.uint8)[8:24]
+            assert byte_scales.storage_offset() == 8
+            assert (
+                byte_scales.untyped_storage()._cdata == scales.untyped_storage()._cdata
+            )
+            view.fill_(0)
+            assert records[-1] == "flush"
