+        rejection.synthetic_conditional_rates = torch.ones(1)
+    elif fallback == "trace":
+        sampler.trace_replay_state = object()
+    elif fallback == "nans":
+        sampler.compute_nans = True
+    elif fallback == "batch_shard":
