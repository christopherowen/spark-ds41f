From 2cb41dc63864e6500f9afd30e9e7814d187a91a0 Mon Sep 17 00:00:00 2001
From: Christopher Owen <root@your.mom>
Date: Thu, 5 Nov 2026 14:48:40 +0100
Subject: [PATCH] Transfer native ID columns without device packing

Upstream base: 1f33102547e4da5c64712390604695d1abd577c4 (candidate-38). Rationale: both wire inventories show an extra ATen packing launch for strided zero-alternative IDs. Transfer the validated physical column span and reconstruct its CPU view, retaining native dtype and avoiding a device packing buffer. Quality: logical values, bounds, ownership and async semantics remain under PyTorch allocator/stream tracking; CPU views support existing NumPy consumers. Tests: 50 cases cover offsets, strides, dtypes, empty outputs, boundaries and side-stream lifetime; final two-boot GPU and full-transfer checks pending. Upstream status: local experiment, not submitted.
---
 tests/v1/test_outputs.py | 47 ++++++++++++++++++++++++++++++++++++++++
 vllm/v1/outputs.py       | 13 ++++++++++-
 2 files changed, 59 insertions(+), 1 deletion(-)

diff --git a/tests/v1/test_outputs.py b/tests/v1/test_outputs.py
index 50abb221ad..84236a5b68 100644
--- a/tests/v1/test_outputs.py
+++ b/tests/v1/test_outputs.py
@@ -258,3 +258,50 @@ def test_with_ec_conn_output_copies_shared_empty_output():
     assert result is not EMPTY_MODEL_RUNNER_OUTPUT
     assert result.ec_connector_output is ec_output
     assert EMPTY_MODEL_RUNNER_OUTPUT.ec_connector_output is None
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA")
+@pytest.mark.parametrize("dtype", [torch.int32, torch.int64])
+@pytest.mark.parametrize("rows", [0, 1, 3, 96])
+@pytest.mark.parametrize("stride", [1, 2, 33])
+def test_native_column_transfer(dtype, rows, stride):
+    # Shifted storage offset and inter-row holes, including an empty result.
+    storage = torch.arange(7 + max(rows, 1) * stride, dtype=dtype, device="cuda")
+    ids = storage[7 : 7 + rows * stride : stride].unsqueeze(1)
+    scores = torch.randn((rows, 1), device="cuda")
+    ranks = torch.arange(rows, device="cuda", dtype=torch.int64)
+    boundaries = torch.tensor([0, rows], device="cuda", dtype=torch.int32)
+    gpu = LogprobsTensors(ids, scores, ranks, None, boundaries)
+    cpu = gpu.to_cpu_nonblocking()
+    torch.cuda.synchronize()
+    assert torch.equal(cpu.logprob_token_ids, ids.cpu())
+    assert torch.equal(cpu.logprobs, scores.cpu())
+    assert torch.equal(cpu.selected_token_ranks, ranks.cpu())
+    assert cpu.logprob_token_ids.dtype == dtype
+    if rows > 1:
+        assert cpu.logprob_token_ids.stride() == ids.stride()
+    assert cpu.tolists().cu_num_generated_tokens == [0, rows]
+    assert cpu.to_cpu_nonblocking() is cpu
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA")
+@pytest.mark.parametrize("dtype", [torch.int32, torch.int64])
+def test_side_stream_result_lifetime(dtype):
+    stream = torch.cuda.Stream()
+    with torch.cuda.stream(stream):
+        ids = torch.arange(96 * 33, dtype=dtype, device="cuda")[::33, None]
+        expected = ids.cpu()
+        gpu = LogprobsTensors(
+            ids,
+            torch.ones((96, 1), device="cuda"),
+            torch.ones(96, device="cuda", dtype=torch.int64),
+        )
+        cpu = gpu.to_cpu_nonblocking()
+        done = torch.cuda.Event()
+        done.record()
+        del gpu, ids
+        # Reuse the allocator while the transfer's originating stream is live.
+        scratch = torch.empty(96 * 33, device="cuda", dtype=dtype)
+        scratch.fill_(-1)
+    done.synchronize()
+    assert torch.equal(cpu.logprob_token_ids, expected)
diff --git a/vllm/v1/outputs.py b/vllm/v1/outputs.py
index 6ee37e56bd..cabec7333d 100644
--- a/vllm/v1/outputs.py
+++ b/vllm/v1/outputs.py
@@ -111,8 +111,19 @@ class LogprobsTensors(NamedTuple):
         cu_tensor = self.cu_num_generated_tokens_tensor
         if cu_tensor is not None:
             cu_tensor = cu_tensor.to("cpu", non_blocking=True)
+        ids = self.logprob_token_ids
+        if ids.ndim == 2 and ids.shape[1] == 1 and not ids.is_contiguous():
+            # A native sampled-ID column can have holes between rows. Copy its
+            # physical span with DMA and keep the view on the CPU, avoiding a
+            # device-side contiguous packing kernel. PyTorch owns both copies'
+            # stream/allocator tracking, including the pinned CPU allocation.
+            span = (ids.shape[0] - 1) * ids.stride(0) + 1
+            cpu_ids = ids.as_strided((span,), (1,)).to("cpu", non_blocking=True)
+            cpu_ids = cpu_ids.as_strided(ids.shape, ids.stride())
+        else:
+            cpu_ids = ids.to("cpu", non_blocking=True)
         return LogprobsTensors(
-            self.logprob_token_ids.to("cpu", non_blocking=True),
+            cpu_ids,
             self.logprobs.to("cpu", non_blocking=True),
             self.selected_token_ranks.to("cpu", non_blocking=True),
             self.cu_num_generated_tokens,
