 .../test_glm5next_l2_prefetch_tilelang.py     | 54 ++++++++++++++
 vllm/models/glm5next/nvidia/l2_prefetch.py    | 21 ++++++
 .../glm5next/nvidia/l2_prefetch_tilelang.py   | 73 +++++++++++++++++++
 3 files changed, 148 insertions(+)
