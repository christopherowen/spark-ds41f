From 509565bcead0b57c1a55d2a0820814717ccab13c Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Sat, 10 Oct 2026 09:43:50 +0200
Subject: [PATCH] TileLang context-KV split-K tiles from the window 4 sweep

The 16-row tile takes three stages, the 64-row tile 32 columns and the
128-row tile (64-row CTAs) 64 columns at two stages: the winners of the
kernel lab's split-K sweep at 6-128 rows (0.77-0.88x B12X's worst case
warm, cold and after its own prefetch). Tiles change speed, not bits.
---
 vllm/models/deepseek_v4_1/tilelang/gemm.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/vllm/models/deepseek_v4_1/tilelang/gemm.py b/vllm/models/deepseek_v4_1/tilelang/gemm.py
index c6b70bf15..4a34f0acc 100644
--- a/vllm/models/deepseek_v4_1/tilelang/gemm.py
+++ b/vllm/models/deepseek_v4_1/tilelang/gemm.py
@@ -780,10 +780,10 @@ SPLIT_FP8: dict[tuple[int, int], dict] = {
         shards=5,
         rows=SPLIT_DECODE_ROWS,
         decode={
-            16: dict(block_N=32, block_K=256, num_stages=2, threads=128),
+            16: dict(block_N=32, block_K=256, num_stages=3, threads=128),
             32: dict(block_N=32, block_K=256, num_stages=2, threads=128),
-            64: dict(block_N=64, block_K=128, num_stages=3, threads=128),
-            128: dict(block_N=128, block_K=128, num_stages=2, threads=128),
+            64: dict(block_N=32, block_K=128, num_stages=3, threads=128),
+            128: dict(block_N=64, block_K=128, num_stages=2, threads=128),
         },
         prefill=dict(block_M=128, block_N=64, block_K=128, num_stages=2),
     ),
