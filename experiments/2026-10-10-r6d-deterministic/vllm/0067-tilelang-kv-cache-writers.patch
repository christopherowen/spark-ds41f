 .../deepseek_v4_1/tilelang/cache_writer.py    | 134 ++++++++++++++++++
 2 files changed, 234 insertions(+)
 create mode 100644 tests/kernels/test_deepseek_v41_tilelang_cache_writer.py
 create mode 100644 vllm/models/deepseek_v4_1/tilelang/cache_writer.py

diff --git a/tests/kernels/test_deepseek_v41_tilelang_cache_writer.py b/tests/kernels/test_deepseek_v41_tilelang_cache_writer.py
