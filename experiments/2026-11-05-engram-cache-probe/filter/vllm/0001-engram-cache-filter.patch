From e6fe9fb614d1b6488bb1310044a408822feaa6f6 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Thu, 5 Nov 2026 23:58:53 +0000
Subject: [PATCH] Reduce Engram cache lookup cost with filter metadata

Upstream base: local-inference-lab/vllm
19f2c20ed4d64ae22bd009ceacadd85e2a81e354, after candidate-38
1f33102547e4da5c64712390604695d1abd577c4.

Rationale: probing IDs interleaved with cached payloads costs CPU
time on populated-cache misses.
Add a compact 64-bit per-set miss filter, rebuilt from the current
four exact IDs after insertion. A filter collision always falls
through to exact ID comparison. The extra allocation is 128 KiB
per default reader.

Quality: preserve row bytes, exact ID matching, capacity, four-way
replacement, admission/probe limits and the reader schedule. No
model arithmetic, quantization or batch-dependent numerical change.

Tests: thirteen-layout native CPU screen on GB10, forward and reverse
process order, including TP3 6/48-row and TP4 96-row points, cold
lookups and eviction-heavy cache states. The final source is queued
for exact-source native reader, sanitizer and GPU validation; serving
boot/repeat qualification is pending. No serving gain is claimed.

Upstream status: experimental local patch; not submitted upstream.
---
 .../deepseek_v4_1/engram_rows/_row_plan.h     | 21 +++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/vllm/models/deepseek_v4_1/engram_rows/_row_plan.h b/vllm/models/deepseek_v4_1/engram_rows/_row_plan.h
index 9c9546985..ba052b164 100644
--- a/vllm/models/deepseek_v4_1/engram_rows/_row_plan.h
+++ b/vllm/models/deepseek_v4_1/engram_rows/_row_plan.h
@@ -74,6 +74,7 @@ typedef struct {
     uint64_t unique_blocks, coalesced_reads, submit_calls;
     double execution_seconds, planning_seconds;
     ple_cache_set_t *cache;
+    uint64_t *cache_filter;
     size_t cache_sets, cache_set_mask;
     uint64_t cache_populated;
     uint32_t *miss_lookups;
@@ -97,6 +98,7 @@ static inline void ple_plan_release(ple_plan_t *reader) {
     free(reader->fragments);
     free(reader->jobs);
     free(reader->cache);
+    free(reader->cache_filter);
     free(reader->miss_lookups);
     free(reader->miss_ids);
     free(reader->miss_weights);
@@ -143,11 +145,12 @@ static inline int ple_plan_init(ple_plan_t *reader, int64_t shard_rows,
         reader->cache_sets = sets;
         reader->cache_set_mask = sets - 1;
         reader->cache = calloc(sets, sizeof(*reader->cache));
+        reader->cache_filter = calloc(sets, sizeof(*reader->cache_filter));
         reader->miss_lookups = malloc(miss_cap * sizeof(*reader->miss_lookups));
         reader->miss_ids = malloc(miss_cap * sizeof(*reader->miss_ids));
         reader->miss_weights = malloc((size_t)PLE_CACHE_MAX_LOOKUPS * 256u);
         reader->miss_scales = malloc((size_t)PLE_CACHE_MAX_LOOKUPS * 8u);
-        if (!reader->cache || !reader->miss_lookups || !reader->miss_ids ||
+        if (!reader->cache || !reader->cache_filter || !reader->miss_lookups || !reader->miss_ids ||
             !reader->miss_weights || !reader->miss_scales)
             return ENOMEM;
         for (size_t s = 0; s < sets; s++) {
@@ -397,6 +400,14 @@ static inline void ple_stash_job(ple_plan_t *reader, size_t index) {
     job->saved_buffer = NULL;
 }
 
+/* Exact row IDs remain authoritative. This four-bit-at-most summary
+ * rejects most misses before touching the much larger payload array.
+ * A collision only falls through to the ordinary exact comparison. */
+static inline uint64_t ple_cache_filter_bit(int64_t id) {
+    uint64_t h = (uint64_t)id * 0x9E3779B97F4A7C15ULL;
+    return UINT64_C(1) << ((h >> 48) & 63);
+}
+
 static inline void ple_cache_insert(ple_plan_t *reader, int64_t id,
         const char *weight_src, const char *scale_src) {
     size_t set_idx = ple_cache_set_index(id, reader->cache_set_mask);
@@ -407,6 +418,11 @@ static inline void ple_cache_insert(ple_plan_t *reader, int64_t id,
     unsigned w = set->clock & (PLE_CACHE_WAYS - 1);
     set->clock = (uint8_t)((w + 1) & (PLE_CACHE_WAYS - 1));
     set->ids[w] = id;
+    uint64_t bits = 0;
+    for (unsigned k = 0; k < PLE_CACHE_WAYS; k++) {
+        if (set->ids[k] >= 0) bits |= ple_cache_filter_bit(set->ids[k]);
+    }
+    reader->cache_filter[set_idx] = bits;
     memcpy(set->weights[w], weight_src, 256u);
     memcpy(set->scales[w], scale_src, 8u);
     reader->cache_populated++;
@@ -462,7 +478,8 @@ static inline bool ple_plan(ple_plan_t *reader, const char *ids, size_t count,
             }
             phys_id = id - reader->col_delta[col];
         }
-        if (check_cache) {
+        if (check_cache && (reader->cache_filter[ple_cache_set_index(id, reader->cache_set_mask)] &
+                            ple_cache_filter_bit(id))) {
             size_t set_idx = ple_cache_set_index(id, reader->cache_set_mask);
             ple_cache_set_t *set = &reader->cache[set_idx];
             int hit_way = -1;
