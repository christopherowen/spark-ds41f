From f3c6d0fe262f1ed061d825d6cc3b851d4760a912 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Thu, 5 Nov 2026 22:55:00 +0000
Subject: [PATCH] Reuse warm Engram rows in bounded larger batches

Upstream base: local-inference-lab/vllm
19f2c20ed4d64ae22bd009ceacadd85e2a81e354; applied after candidate-38
1f33102547e4da5c64712390604695d1abd577c4.

Rationale: direct-to-mapped steps above 64 rows bypass populated cache
entries, including the 96 rows of a full TP4 decode batch. Probe through
128 rows while retaining the existing admission limit and cache size.
Longer direct-to-mapped prefills keep the current bypass.

Quality: copy the same immutable weight and scale bytes. No arithmetic,
quantization, eviction, packing, worker or interrupt-policy change.
Add GPU regression coverage for exact cached/uncached output, dead IDs,
rank masks and retaining hot rows after repeated larger misses.

Tests: offline native-planner byte oracle and cache-retention checks,
two bounded CPU fixture runs; GCC AddressSanitizer/UndefinedBehaviorSanitizer
over 26 paired fixtures. Python syntax and git diff --check pass.
GPU regression and serving boot/repeat qualification are pending.
Synthetic planned reads are not measurements of NVMe or serving speed.

Upstream status: experimental local patch; not submitted upstream.
---
 .../kernels/test_deepseek_v41_engram_rows.py  | 51 +++++++++++++++++++
 .../deepseek_v4_1/engram_rows/_row_plan.h     |  7 ++-
 2 files changed, 57 insertions(+), 1 deletion(-)

diff --git a/tests/kernels/test_deepseek_v41_engram_rows.py b/tests/kernels/test_deepseek_v41_engram_rows.py
index 21bd6918a..bc540d2dc 100644
--- a/tests/kernels/test_deepseek_v41_engram_rows.py
+++ b/tests/kernels/test_deepseek_v41_engram_rows.py
@@ -887,6 +887,57 @@ def test_user_space_row_cache_hits_evicts_and_matches_reference(columns):
         rows.close()
 
 
+@pytest.mark.parametrize("columns", [ALL_COLUMNS, TP3_RANK1])
+@pytest.mark.parametrize("early", [False, True])
+@pytest.mark.parametrize("tokens", [65, 96, 128])
+def test_large_steps_reuse_hot_rows_without_admitting_misses(columns, early, tokens):
+    """The direct-to-mapped path probes hot rows above the 64-token admission limit.
+
+    Repeated large misses must still read disk and must not evict warmed decode
+    rows. Include dead IDs and poison the destination to detect skipped copies.
+    """
+    codes, scales, paths = _write_table(_table_dir(), seed=59)
+    rows = _rows(paths, tokens=128, columns=columns, cache_rows=64)
+
+    def run(ids):
+        rows.weights.host.fill_(0x7F)
+        rows.scales.host.fill_(0xFF)
+        out, _ = _step(rows, ids.cuda(), len(ids),
+                       early=ids.numpy() if early else None)
+        torch.cuda.synchronize()
+        deadline = time.monotonic() + 5.0
+        while rows.stats()["queued"] and time.monotonic() < deadline:
+            time.sleep(0.001)
+        assert rows.stats()["queued"] == 0
+        torch.testing.assert_close(
+            out.cpu(), _reference(codes, scales, ids, len(ids), 0, TABLE_ROWS, columns),
+            rtol=0, atol=0, equal_nan=True,
+        )
+        return rows.stats(), out.cpu()
+
+    try:
+        small = torch.arange(24, dtype=torch.int64)[None].repeat(16, 1)
+        hot = small.repeat(8, 1)[:tokens].contiguous()
+        hot[0, 1] = -1
+        _, uncached = run(hot)
+        warm_stats, _ = run(small)
+        hot_stats, cached = run(hot)
+        assert _same(cached, uncached)
+        assert hot_stats["read_calls"] == warm_stats["read_calls"]
+        assert hot_stats["cache_hits"] > warm_stats["cache_hits"]
+        cold = torch.arange(1000, 1024, dtype=torch.int64)[None].repeat(tokens, 1)
+        first, _ = run(cold)
+        second, _ = run(cold)
+        assert first["read_calls"] > hot_stats["read_calls"]
+        assert second["read_calls"] > first["read_calls"]
+        assert second["cache_hits"] == first["cache_hits"]
+        final, cached = run(hot)
+        assert final["read_calls"] == second["read_calls"]
+        assert _same(cached, uncached)
+    finally:
+        rows.close()
+
+
 def test_background_prefetch_warms_row_cache_without_touching_step_buffers():
     """rows.prefetch(ids) populates the user-space row cache on the worker thread without
     modifying mapped weights/scales or control sequence words, so the subsequent step
diff --git a/vllm/models/deepseek_v4_1/engram_rows/_row_plan.h b/vllm/models/deepseek_v4_1/engram_rows/_row_plan.h
index 9c9546985..07776fa05 100644
--- a/vllm/models/deepseek_v4_1/engram_rows/_row_plan.h
+++ b/vllm/models/deepseek_v4_1/engram_rows/_row_plan.h
@@ -19,6 +19,7 @@
 #define PLE_DEFAULT_CACHE_ROWS 65536
 #define PLE_CACHE_MAX_TOKENS 64u
 #define PLE_CACHE_MAX_LOOKUPS (PLE_CACHE_MAX_TOKENS * PLE_COLUMNS)
+#define PLE_CACHE_PROBE_MAX_LOOKUPS (128u * PLE_COLUMNS)
 
 typedef struct {
     int64_t ids[PLE_CACHE_WAYS];
@@ -438,7 +439,11 @@ static inline bool ple_plan(ple_plan_t *reader, const char *ids, size_t count,
     reader->fragment_count = reader->job_count = 0;
     reader->miss_count = 0;
     bool use_cache = reader->cache_sets > 0 && (count <= PLE_CACHE_MAX_LOOKUPS || dst_is_cached);
-    bool check_cache = use_cache && reader->cache_populated > 0;
+    /* Include the 96 rows of TP4's full decode batch without admitting their
+     * misses. Larger direct-to-mapped prefills still bypass the cache: probing
+     * random rows costs CPU time even when no disk reads can be avoided. */
+    bool check_cache = reader->cache_sets > 0 && reader->cache_populated > 0 &&
+                       (count <= PLE_CACHE_PROBE_MAX_LOOKUPS || dst_is_cached);
     bool fill_cache = use_cache;
     reader->miss_src_weights = dst_is_cached ? dst_weights : NULL;
     reader->miss_src_scales = dst_is_cached ? dst_scales : NULL;
