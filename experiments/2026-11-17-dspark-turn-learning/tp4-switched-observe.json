        ["{checkout}/experiments/2026-11-17-dspark-turn-learning/overlay/vllm/v1/worker/gpu/spec_decode/dspark/speculator.py", "/opt/spark-ds41f/candidate/vllm/vllm/v1/worker/gpu/spec_decode/dspark/speculator.py", "ro"],
        ["{checkout}/experiments/2026-11-17-dspark-turn-learning/overlay/vllm/v1/worker/gpu/model_runner.py", "/opt/spark-ds41f/candidate/vllm/vllm/v1/worker/gpu/model_runner.py", "ro"]
