{
  "description": "The turn learner's TileLang kernels against Python references: observe (capture, labels, reset, turn counters) and shadow (block-maxima capture, the end-of-turn score and update across simulated ranks), on candidate-60's image with the overlay.",
  "image": "spark-ds41f:candidate-60",
  "verdict": "exit",
  "env": {
    "PYTHONPATH": "/b:/opt/spark-ds41f/candidate/vllm",
    "TILELANG_CACHE_DIR": "/c/tilelang-dspark-turn-learning"
  },
  "workdir": "vllm",
  "mounts": [
    [
      "test_dspark_turn_learning.py",
      "/b/test_dspark_turn_learning.py"
    ],
    [
      "tblib_stub.py",
      "/b/tblib_stub.py"
    ],
    [
      "offline_skip.py",
      "/b/offline_skip.py"
    ],
    [
      "test_dspark_turn_learning_shadow.py",
      "/b/test_dspark_turn_learning_shadow.py"
    ]
  ],
  "argv": [
    "-m",
    "pytest",
    "-q",
    "-p",
    "tblib_stub",
    "-p",
    "offline_skip",
    "/b/test_dspark_turn_learning.py",
    "/b/test_dspark_turn_learning_shadow.py"
  ]
}
