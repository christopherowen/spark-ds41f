From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Mon, 12 Oct 2026 13:40:02 +0200
Subject: [PATCH] [Test] Gate SM120 source checks on CUDA build support

Upstream base: fd2ddda1a7b8dec637c592eb92bbca46030ed585, plus preceding entries in this series.
Rationale: Gate source lowering on CUDA build support and reject compact MXFP4 scales.
Quality implications: preserve native operand bits and per-K-atom scale selectors; no requantization.
Tests: current native CUDA compiler rebuilt; MX suites 20 passed, 7 GPU tests skipped;
MXFP8, FP8 x FP4, and MXFP4 compile for sm_120a and sm_121a.
Upstream status: submitted as https://github.com/tile-ai/tilelang/pull/3495.
---
 ..._tilelang_language_mxf8f6f4_mma_block_scale.py |  4 ++++
 ...est_tilelang_language_mxfp4_mma_block_scale.py | 15 ++++++++++++++-
 tilelang/cuda/language/tir.py                     |  6 ++++--
 3 files changed, 22 insertions(+), 3 deletions(-)

diff --git a/testing/python/language/test_tilelang_language_mxf8f6f4_mma_block_scale.py b/testing/python/language/test_tilelang_language_mxf8f6f4_mma_block_scale.py
index e93935ab..2d58d156 100644
--- a/testing/python/language/test_tilelang_language_mxf8f6f4_mma_block_scale.py
+++ b/testing/python/language/test_tilelang_language_mxf8f6f4_mma_block_scale.py
@@ -124,6 +124,7 @@ def _make_mxfp8_matmul_kernel(M, N, K, block_K=128, fragment_a=False, in_dtype=T
     return main
 
 
+@tilelang.testing.requires_cuda(support_required="compile-only")
 @pytest.mark.parametrize("arch", ["sm_120a", "sm_121a"])
 def test_mxf8f6f4_codegen(arch):
     target = tvm.target.Target({"kind": "cuda", "arch": arch})
@@ -136,6 +137,7 @@ def test_mxf8f6f4_codegen(arch):
     assert "SM120MmaBlockScaledKind::kMxf4nvf4" not in src
 
 
+@tilelang.testing.requires_cuda(support_required="compile-only")
 def test_mxf8f6f4_fp4_operand_codegen():
     target = tvm.target.Target({"kind": "cuda", "arch": "sm_121a"})
     with target:
@@ -145,12 +147,14 @@ def test_mxf8f6f4_fp4_operand_codegen():
     assert "tl::SM120MmaOperandType::kE4M3, tl::SM120MmaOperandType::kE2M1" in src
 
 
+@tilelang.testing.requires_cuda(support_required="compile-only")
 def test_mxf8f6f4_rejects_fragment_a():
     target = tvm.target.Target({"kind": "cuda", "arch": "sm_121a"})
     with target, pytest.raises(Exception, match="mxf8f6f4 block-scaled GEMM currently requires A in shared memory"):
         tilelang.lower(_make_mxfp8_matmul_kernel(64, 64, 128, fragment_a=True), target=target, enable_device_compile=False)
 
 
+@tilelang.testing.requires_cuda(support_required="compile-only")
 def test_mxf8f6f4_rejects_compact_kmajor_scales():
     @T.prim_func
     def main(O: T.Tensor((64, 64), T.float32)):
diff --git a/testing/python/language/test_tilelang_language_mxfp4_mma_block_scale.py b/testing/python/language/test_tilelang_language_mxfp4_mma_block_scale.py
index c47929b2..b8b4eba0 100644
--- a/testing/python/language/test_tilelang_language_mxfp4_mma_block_scale.py
+++ b/testing/python/language/test_tilelang_language_mxfp4_mma_block_scale.py
@@ -46,7 +46,7 @@ def test_mxfp4_emitter_selects_scale_halves():
     assert [emitter._scale_word_k(0, ki, 32) for ki in range(4)] == [0, 0, 1, 1]
 
 
-def _make_mxfp4_matmul_kernel(M, N, K):
+def _make_mxfp4_matmul_kernel(M, N, K, sf_layout="rowmajor"):
     words = K // 128
 
     @T.prim_func
@@ -83,12 +83,14 @@ def _make_mxfp4_matmul_kernel(M, N, K):
                     k_start=0,
                     sf_a_granularity_k=32,
                     sf_b_granularity_k=32,
+                    sf_layout=sf_layout,
                 )
             T.copy(C_local, C[by * 64, bx * 64])
 
     return main
 
 
+@tilelang.testing.requires_cuda(support_required="compile-only")
 @pytest.mark.parametrize("arch", ["sm_120a", "sm_121a"])
 def test_mxfp4_codegen(arch):
     target = tvm.target.Target({"kind": "cuda", "arch": arch})
@@ -97,6 +99,17 @@ def test_mxfp4_codegen(arch):
     assert "tl::SM120MmaBlockScaledKind::kMxf4nvf4, 2, tl::SM120MmaScaleType::kUE8M0" in result.kernel_source
 
 
+@tilelang.testing.requires_cuda(support_required="compile-only")
+def test_mxfp4_rejects_compact_kmajor_scales():
+    target = tvm.target.Target({"kind": "cuda", "arch": "sm_121a"})
+    with target, pytest.raises(Exception, match="MXFP4 block-scaled GEMM currently requires sf_layout='rowmajor'"):
+        tilelang.lower(
+            _make_mxfp4_matmul_kernel(64, 64, 128, sf_layout="blockscaled_chunk_kmajor"),
+            target=target,
+            enable_device_compile=False,
+        )
+
+
 def _random_mxfp4(rows, K, seed):
     """Packed E2M1 codes and power-of-two UE8M0 scales; products sum exactly in FP32."""
     import torch
