{
  "image": "spark-ds41f:1030",
  "env": {
    "HF_HUB_OFFLINE": "1",
    "VLLM_NO_USAGE_STATS": "1",
    "DO_NOT_TRACK": "1",
    "TILELANG_CACHE_DIR": "/c/tilelang"
  },
  "workdir": "vllm",
  "mounts": [
    [
      "../bundle/check.py",
      "/tmp/clustered-indexer-check.py"
    ],
    [
      "../bundle/overlay/vllm/models/deepseek_v4_1/tilelang/clustered_indexer.py",
      "/opt/spark-ds41f/candidate/vllm/vllm/models/deepseek_v4_1/tilelang/clustered_indexer.py"
    ],
    [
      "../bundle/overlay/vllm/models/deepseek_v4_1/tilelang/indexer.py",
      "/opt/spark-ds41f/candidate/vllm/vllm/models/deepseek_v4_1/tilelang/indexer.py"
    ],
    [
      "../bundle/envelope_reference.py",
      "/tmp/envelope_reference.py"
    ]
  ],
  "verdict": "status",
  "argv": [
    "/tmp/clustered-indexer-check.py",
    "--cuda-graph",
    "--repeats",
    "15"
  ]
}
