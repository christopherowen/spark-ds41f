    def test_cancelling_one_utility_does_not_remove_another_pending_call():
        async def run():
            client = make_client(True, "wait_reply")
            first = asyncio.create_task(client.call_utility_async("first"))
            await asyncio.wait_for(client.entered.wait(), 2)
            first_id = client.call_id
            client.entered.clear()
            second = asyncio.create_task(client.call_utility_async("second"))
            await asyncio.wait_for(client.entered.wait(), 2)
            second_id = client.call_id
