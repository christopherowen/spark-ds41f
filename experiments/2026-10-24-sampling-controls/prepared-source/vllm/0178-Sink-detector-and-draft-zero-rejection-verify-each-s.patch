+    keep = logits.topk(2, dim=-1).indices
+    masked.fill_(float("-inf"))
+    masked.scatter_(1, keep, logits.gather(1, keep))
+    alternates = sink.alternates_of(
+        masked,
+        _cu([1] * num_reqs),
+        torch.ones(num_reqs, dtype=torch.int32, device=DEVICE),
+        keep[:, :1].contiguous(),
