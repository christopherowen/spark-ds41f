+def _random_logits(rows: int, vocab: int, seed: int = 0) -> torch.Tensor:
+    gen = torch.Generator(device=DEVICE).manual_seed(seed)
+    return torch.randn(rows, vocab, generator=gen, device=DEVICE) * 2.0
