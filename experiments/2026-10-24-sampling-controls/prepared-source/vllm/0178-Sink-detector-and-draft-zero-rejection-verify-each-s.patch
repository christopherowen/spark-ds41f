+    @property
+    def num_flagged_rows(self) -> int:
+        return (
+            self.num_flagged_draft_zero
+            + self.num_flagged_drafter
+            + self.num_flagged_prompt
+        )
+
+    @property
+    def empty(self) -> bool:
+        return self.num_flagged_rows == 0
