+    )
+    order, tile_expert = layout["order"], layout["tile_expert"]
+    a_rows = rows if gather else order.shape[0]
+    x = (torch.randn((a_rows, k), generator=gen, device=DEVICE) * 0.5).bfloat16()
+    xq, sf = tile_kernels.quant.per_token_cast(
