+    extra = (tails,) if tails is not None else ()
+    plain = grouped_fp8_fp4_gemm(experts, n, k, topk, gather, 32, block_N)
+    coded = grouped_fp8_fp4_gemm(
+        experts, n, k, topk, gather, 32, block_N, coded_scales=True
