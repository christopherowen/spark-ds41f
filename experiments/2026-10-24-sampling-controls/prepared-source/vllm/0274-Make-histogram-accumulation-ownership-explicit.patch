From 8decb3e8d5438c9c7126f7e0be03f43b61a0dfcc Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Sat, 24 Oct 2026 19:28:00 +0200
Subject: [PATCH 274/274] Make histogram accumulation ownership explicit

The candidate replaces the atomic histogram kernel, while the existing owner retains selected-row clearing. Cover accumulation into preexisting prompt bits and output counts as well as zeroed buffers.


diff --git a/benchmarks/kernels/benchmark_sampling_controls.py b/benchmarks/kernels/benchmark_sampling_controls.py
index 113f215be..5976b4056 100644
--- a/benchmarks/kernels/benchmark_sampling_controls.py
+++ b/benchmarks/kernels/benchmark_sampling_controls.py
@@ -48,7 +48,7 @@ def make_case(kind, rows, width, seed, count):
         def invoke(index, ours):
             mask, counts = buffers[index]
             if ours:
-                candidate.bincount(
+                candidate.accumulate_bincount(
                     mapping, tokens, prompt, prefill, mask, counts, width
                 )
             else:
