From e4729693c10da205593918a57f12733863eb4c9f Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Sat, 24 Oct 2026 18:45:53 +0200
Subject: [PATCH 259/274] V2 runner: DFlash inputs in Triton's tile form

The decode path issued its loads in rounds behind branches (the request index,
then the positions, then the block table, each in its own conditional block):
+0.5 us against Triton, whose kernel issues its nine loads together and stores
under masks. Every load is now issued up front at an index that exists whatever
the masks say, the masks are selects and the stores predicated; every value
written is unchanged.

diff --git a/vllm/v1/worker/gpu/tilelang_inputs.py b/vllm/v1/worker/gpu/tilelang_inputs.py
index 1deaf9866..7c0706f58 100644
--- a/vllm/v1/worker/gpu/tilelang_inputs.py
+++ b/vllm/v1/worker/gpu/tilelang_inputs.py
@@ -828,6 +828,11 @@ __device__ __forceinline__ void vllm_store_if_b32(void* p, int v, bool ok) {
                " @q st.global.b32 [%0], %1;\n}"
                :: "l"(p), "r"(v), "r"((int)ok) : "memory");
 }
+__device__ __forceinline__ void vllm_store_if_f32(void* p, float v, bool ok) {
+  asm volatile("{\n .reg .pred q;\n setp.ne.b32 q, %2, 0;\n"
+               " @q st.global.f32 [%0], %1;\n}"
+               :: "l"(p), "f"(v), "r"((int)ok) : "memory");
+}
 """
 
 _STORE_BITS = {"int32": 32, "int64": 64}
