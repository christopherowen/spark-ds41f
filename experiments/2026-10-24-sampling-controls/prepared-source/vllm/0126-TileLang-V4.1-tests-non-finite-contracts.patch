+        (1, n + 5, NAN),  # up
+        (2, 7, INF),  # gate: silu(limit)
+        (3, 9, -INF),  # gate: silu(-inf) is NaN
+        (4, n + 11, INF),  # up saturates at the limit
+        (5, n + 13, -INF),
+    ):
