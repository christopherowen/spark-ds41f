+@pytest.mark.parametrize("heads, dim, ratio", [(16, 512, 1), (1, 128, 4)])
+@pytest.mark.parametrize("inverse", [False, True])
+def test_rope_nonfinite(heads, dim, ratio, inverse, rows=9):
+    """A NaN or an infinity in a rotated pair reaches both outputs of that pair as
+    the FP64 rotation's, a non-finite leading column stays put, and no other row
+    moves."""
+    gen = torch.Generator(device=DEVICE).manual_seed(heads + dim)
+    x = torch.randn((rows, heads, dim), generator=gen, device=DEVICE).bfloat16()
+    positions = torch.randint(1, POSITIONS, (rows,), generator=gen, device=DEVICE)
+    table = _table()
+
+    def rotate(values):
+        out = values.clone()
+        flat = out if heads > 1 else out.view(rows, dim)
+        rope_(flat, positions, table, ratio, inverse)
+        return out
+
+    clean = rotate(x)
+    poisoned = [2, 5, 6, 7]
+    x[2, 0, dim - ROPE + 4] = NAN
+    x[5, -1, dim - ROPE + 9] = INF
+    x[6, 0, dim - 1] = -INF
+    x[7, 0, 3] = NAN  # a leading column
+    out = rotate(x)
+    cos, sin = table.double()[positions // ratio * ratio].chunk(2, dim=-1)
+    sin = -sin if inverse else sin
+    pairs = x[..., -ROPE:].double().unflatten(-1, (ROPE // 2, 2))
+    first, second = pairs[..., 0], pairs[..., 1]
+    cos, sin = cos[:, None], sin[:, None]
+    ref = x.double()
+    ref[..., -ROPE:] = torch.stack(
+        (first * cos - second * sin, first * sin + second * cos), -1
+    ).flatten(-2)
+    assert_same_nonfinite(out, ref)
+    assert_finite_equal(out[..., :-ROPE], x[..., :-ROPE])
+    assert_other_rows_equal(out, clean, poisoned)
