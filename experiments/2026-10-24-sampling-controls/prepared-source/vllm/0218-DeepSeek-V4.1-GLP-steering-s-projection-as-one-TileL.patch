From fd40ab1ef2ba61862c4df2d205c2d455849f5840 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Fri, 23 Oct 2026 17:04:38 +0200
Subject: [PATCH 218/274] DeepSeek-V4.1: GLP steering's projection as one
 TileLang launch

With a GLP file set, every layer projects its direction off the folded
hyper-connection streams. The projection ran as torch ops (a widening
copy, an FP32 GEMV for h . d and the update), which Inductor compiled into
a cuBLAS call and a generated elementwise kernel. It is now one TileLang
kernel (tilelang/glp.py): a block per stream of a token widens the stream
to FP32 once, reduces h . d in a fixed order and writes
bf16(h - (alpha (h . d)) d). Rows are independent, so a token's result
does not depend on the batch; alpha zero and a zero direction (a layer
the file does not steer) return the stream bit for bit.

GLPSteering declares the kernel for the model's [T, hc_mult, hidden]
streams, so kernel preparation compiles it before the cache freezes, and
refuses any other shape or dtype. glp_steering takes hc_mult.

Tests: tests/kernels/test_deepseek_v41_tilelang_glp.py checks the kernel
against FP64 (within one BF16 rounding, correctly rounded at least as
often as the FP32 torch projection), batch independence, repeatability,
in-place rows of the layer stack, non-finite propagation and its
declaration; the model tests run the projection on the GPU at the serving
width. benchmarks/kernels/benchmark_deepseek_v41_glp.py times it against
the compiled torch projection at decode and long-prefill shapes.

diff --git a/benchmarks/kernels/benchmark_deepseek_v41_glp.py b/benchmarks/kernels/benchmark_deepseek_v41_glp.py
new file mode 100644
index 000000000..8e0ec7cdf
--- /dev/null
+++ b/benchmarks/kernels/benchmark_deepseek_v41_glp.py
@@ -0,0 +1,101 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Paired per-call timing of GLP steering's TileLang projection against the torch
+projection it replaces, compiled as the model's forward compiles it (Inductor: a
+cuBLAS GEMV for ``h @ d`` and a fused elementwise kernel), at serving shapes.
+
+Each shape is measured on eight fresh inputs; on each, CUDA graphs of 100 calls of
+both run back to back, alternating which goes first, and the case's 95% interval
+comes from the eight per-input differences. The gate (``--gate``) is that the
+TileLang projection is not slower at any serving shape: a decode step (16 requests
+of 1 + 5 drafted tokens) and a long-prefill chunk.
+"""
+
+import argparse
+import json
+import math
+import statistics
+
+import torch
+
+from vllm.models.deepseek_v4_1.tilelang import glp
+
+STREAMS, HIDDEN = 4, 5120
+SHAPES = {"decode c1": 6, "decode c16": 96, "prefill 8K": 8192, "prefill 16K": 16384}
+GATED = ("decode c16", "prefill 16K")
+
+
+def _torch_projection(h, direction, alpha):
+    x = h.float()
+    return (x - (alpha * (x @ direction)).unsqueeze(-1) * direction).to(h.dtype)
+
+
+def graph(function):
+    side = torch.cuda.Stream()
+    side.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(side):
+        for _ in range(3):
+            function()
+    torch.cuda.current_stream().wait_stream(side)
+    torch.cuda.synchronize()
+    capture = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(capture):
+        for _ in range(100):
+            function()
+    return capture
+
+
+def elapsed(capture) -> float:
+    start = torch.cuda.Event(enable_timing=True)
+    end = torch.cuda.Event(enable_timing=True)
+    start.record()
+    capture.replay()
+    end.record()
+    end.synchronize()
+    return start.elapsed_time(end) * 10  # ms / 100 calls to microseconds
+
+
+def measure(tokens: int, compiled, samples: int = 8) -> dict:
+    ours_us, torch_us, differences = [], [], []
+    for sample in range(samples):
+        generator = torch.Generator(device="cuda").manual_seed(sample)
+        h = torch.randn(
+            tokens, STREAMS, HIDDEN, generator=generator, device="cuda"
+        ).bfloat16()
+        d = torch.randn(HIDDEN, generator=generator, device="cuda")
+        d /= d.norm()
+        alpha = torch.tensor([0.75], device="cuda")
+        out = torch.empty_like(h)
+        ours = graph(lambda: glp.glp_project(h, d, alpha, out))
+        theirs = graph(lambda: compiled(h, d, alpha))
+        pair = (ours, theirs) if sample % 2 == 0 else (theirs, ours)
+        times = {id(capture): elapsed(capture) for capture in pair}
+        ours_us.append(times[id(ours)])
+        torch_us.append(times[id(theirs)])
+        differences.append(times[id(ours)] - times[id(theirs)])
+    mean = statistics.fmean(differences)
+    half = 2.365 * statistics.stdev(differences) / math.sqrt(samples)  # t(7), 95%
+    return {
+        "tokens": tokens,
+        "tilelang_us": statistics.median(ours_us),
+        "torch_us": statistics.median(torch_us),
+        "difference_us": mean,
+        "interval_us": [mean - half, mean + half],
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--gate", action="store_true")
+    args = parser.parse_args()
+    compiled = torch.compile(_torch_projection, dynamic=False)
+    results = {name: measure(tokens, compiled) for name, tokens in SHAPES.items()}
+    print(json.dumps(results, indent=1))
+    if args.gate:
+        slower = [name for name in GATED if results[name]["interval_us"][0] > 0]
+        if slower:
+            raise SystemExit(f"TileLang projection slower at {', '.join(slower)}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/kernels/test_deepseek_v41_tilelang_glp.py b/tests/kernels/test_deepseek_v41_tilelang_glp.py
new file mode 100644
index 000000000..ffddfdf6e
--- /dev/null
+++ b/tests/kernels/test_deepseek_v41_tilelang_glp.py
@@ -0,0 +1,152 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GLP steering's TileLang projection against FP64 and the FP32 torch projection
+it replaces (``h - (alpha (h @ d)) d`` in FP32, then BF16)."""
+
+import pytest
+import torch
+
+from vllm.platforms import current_platform
+
+if not (
+    current_platform.is_cuda() and current_platform.is_device_capability_family(120)
+):
+    pytest.skip("TileLang V4.1 kernels target SM120/SM121", allow_module_level=True)
+
+pytest.importorskip("tilelang")
+
+from tests.kernels.deepseek_v41_contracts import (  # noqa: E402
+    INF,
+    NAN,
+    assert_same_nonfinite,
+)
+from vllm.model_executor.warmup.jit_warmup import JitWarmupRegistry  # noqa: E402
+from vllm.models.deepseek_v4_1.tilelang import glp, prepare  # noqa: E402
+
+STREAMS, HIDDEN = 4, 5120
+
+
+def _inputs(tokens: int, seed: int = 0, layers: int = 3):
+    generator = torch.Generator(device="cuda").manual_seed(seed)
+    streams = torch.randn(
+        tokens, STREAMS, HIDDEN, generator=generator, device="cuda"
+    ).bfloat16()
+    directions = torch.randn(layers, HIDDEN, generator=generator, device="cuda")
+    directions /= directions.double().norm(dim=-1, keepdim=True).float()
+    return streams, directions
+
+
+def _project(streams, direction, alpha: float) -> torch.Tensor:
+    out = torch.empty_like(streams)
+    glp.glp_project(
+        streams, direction, torch.tensor([alpha], device="cuda"), out
+    )
+    return out
+
+
+def _fp64(streams, direction, alpha: float) -> torch.Tensor:
+    h, d = streams.double(), direction.double()
+    return h - (alpha * (h @ d)).unsqueeze(-1) * d
+
+
+def _fp32_torch(streams, direction, alpha: float) -> torch.Tensor:
+    """The projection as GLP steering first ran it, in eager torch."""
+    h = streams.float()
+    return (h - (alpha * (h @ direction)).unsqueeze(-1) * direction).bfloat16()
+
+
+def _ulp(x: torch.Tensor) -> torch.Tensor:
+    """BF16's spacing at ``|x|`` (eight significant bits)."""
+    _, exponent = torch.frexp(x.abs().clamp_min(2.0**-126))
+    return torch.ldexp(torch.ones_like(x), exponent - 8)
+
+
+@pytest.mark.parametrize("tokens", [1, 7, 96, 384, 2048])
+@pytest.mark.parametrize("alpha", [0.75, 1.0, 2.0])
+def test_within_one_rounding_of_fp64(tokens, alpha):
+    streams, directions = _inputs(tokens, seed=tokens)
+    out = _project(streams, directions[1], alpha)
+    exact = _fp64(streams, directions[1], alpha)
+    assert out.dtype == torch.bfloat16 and out.shape == streams.shape
+    # One rounding to BF16, plus the FP32 dot product's own error where an output
+    # cancels to nearly zero (about 1e-8 here; 2^-24 bounds it).
+    assert ((out.double() - exact).abs() <= _ulp(exact) + 2.0**-24).all()
+    # At least as often correctly rounded as the FP32 torch projection.
+    rounded = exact.bfloat16()
+    ours = (out != rounded).double().mean().item()
+    torch_path = (_fp32_torch(streams, directions[1], alpha) != rounded)
+    assert ours <= torch_path.double().mean().item() + 1e-4, (ours, torch_path)
+
+
+def test_the_direction_is_removed():
+    streams, directions = _inputs(256)
+    d = directions[2].double()
+    out = _project(streams, directions[2], 1.0).double()
+    # What remains along d is the outputs' own BF16 rounding.
+    assert (out @ d).abs().max().item() < 0.02
+
+
+def test_alpha_zero_and_a_zero_direction_change_nothing():
+    streams, directions = _inputs(96)
+    assert torch.equal(_project(streams, directions[0], 0.0), streams)
+    zero = torch.zeros(HIDDEN, device="cuda")
+    assert torch.equal(_project(streams, zero, 0.75), streams)
+
+
+def test_rows_independent_of_batch():
+    streams, directions = _inputs(130)
+    full = _project(streams, directions[1], 0.75)
+    for tokens in (1, 7, 64, 129):
+        assert torch.equal(
+            _project(streams[:tokens], directions[1], 0.75), full[:tokens]
+        ), tokens
+
+
+def test_repeatable():
+    streams, directions = _inputs(384)
+    first = _project(streams, directions[1], 0.75)
+    for _ in range(3):
+        assert torch.equal(_project(streams, directions[1], 0.75), first)
+
+
+def test_a_row_of_the_layer_stack_is_read_in_place():
+    """The model passes ``directions[layer]``, a view into the stack."""
+    streams, directions = _inputs(16, layers=5)
+    for layer in range(5):
+        assert torch.equal(
+            _project(streams, directions[layer], 0.75),
+            _project(streams, directions[layer].clone(), 0.75),
+        )
+
+
+def test_nonfinite_like_the_torch_projection():
+    """A NaN or an infinity in a stream reaches its whole row, as through
+    ``h @ d``; other rows keep their bits."""
+    streams, directions = _inputs(8)
+    clean = _project(streams, directions[1], 0.75)
+    for token, stream, col, value in ((0, 1, 3, NAN), (2, 0, 9, INF), (5, 3, 17, -INF)):
+        streams[token, stream, col] = value
+    out = _project(streams, directions[1], 0.75)
+    assert_same_nonfinite(out, _fp32_torch(streams, directions[1], 0.75))
+    poisoned = {(0, 1), (2, 0), (5, 3)}
+    for token in range(8):
+        for stream in range(STREAMS):
+            if (token, stream) not in poisoned:
+                assert torch.equal(out[token, stream], clean[token, stream])
+
+
+def test_no_tokens_launch_nothing():
+    streams, directions = _inputs(0)
+    out = torch.empty_like(streams)
+    glp.glp_project(streams, directions[0], torch.tensor([0.75], device="cuda"), out)
+
+
+def test_declared_as_the_forward_calls_it():
+    registry = JitWarmupRegistry(vllm_config=None)
+    with registry.activate():
+        glp.declare(STREAMS, HIDDEN)
+    calls = [
+        (function, args, kwargs)
+        for function, args, kwargs in prepare.declared_calls(registry)
+    ]
+    assert calls == [(glp.glp_project_kernel, (STREAMS, HIDDEN), {})]
