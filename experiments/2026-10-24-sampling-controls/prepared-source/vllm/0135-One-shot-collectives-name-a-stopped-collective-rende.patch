From dfb93679e3c6321e94b448938782f98d582a7eb0 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Wed, 14 Oct 2026 23:37:46 +0200
Subject: [PATCH 135/274] One-shot collectives: name a stopped collective;
 rendezvous at startup

sparknet API 2 stops the GPU when a collective wait times out, so CUDA raises
a launch failure at the next sync. The worker now re-raises it as sparknet's
failure report (the peer waited for, its HCA lane, the sequence and the time
waited) in execute_model, sample_tokens and asynchronous outputs.

Ranks on cold disks and JIT caches finish loading and compiling minutes apart
(a three-node r6h deployment saw 39 s against 123 s of JIT warm-up). They now
meet on the CPU group before memory profiling and after the local JIT warm-up,
through a monitored barrier (VLLM_STARTUP_RENDEZVOUS_TIMEOUT_MS, 30 min) that
names a missing rank, so slow ranks are waited for on the host, not by GPUs
spinning in a collective. Collectives keep one timeout from boot onward: a
kernel that compiles inside a collective phase is a defect to fix, not a wait
to lengthen.

Tests: CPU checks that a stopped collective is named as the cause in a step
and in an asynchronous output, that other errors pass unchanged, and that the
communicator reports the one-shot runtime's failure.

Reported-by: huxiaofengtiger (NVIDIA Developer Forums, DeepSeek 4.1 Flash recipe thread, post 16)

diff --git a/tests/distributed/test_roce_policy_no_fallback.py b/tests/distributed/test_roce_policy_no_fallback.py
index 40308bcea..876ddac77 100644
--- a/tests/distributed/test_roce_policy_no_fallback.py
+++ b/tests/distributed/test_roce_policy_no_fallback.py
@@ -12,6 +12,7 @@ import pytest
 import torch
 import torch.distributed
 
+import vllm.envs as envs
 from vllm.distributed.device_communicators import cuda_communicator
 from vllm.distributed.device_communicators.base_device_communicator import (
     DeviceCommunicatorBase,
@@ -117,3 +118,20 @@ def test_no_inherited_collective_uses_the_process_group():
         if getattr(cuda_communicator.CudaCommunicator, name) is method:
             inherited.append(name)
     assert inherited == []
+
+
+class _SparknetAdapter(_OneShot):
+    def __init__(self, report: str | None = None):
+        self.report = report
+
+    def failure(self) -> str | None:
+        return self.report
+
+
+def test_failure_report_comes_from_the_one_shot_runtime(monkeypatch):
+    monkeypatch.setattr(envs, "VLLM_DS41_KERNEL_BACKEND", "tilelang", raising=False)
+    comm = _policy_communicator()
+    comm.b12x_ar_comm = _SparknetAdapter(report="saw nothing from rank 2")
+    assert comm.roce_failure() == "saw nothing from rank 2"
+    comm.b12x_ar_comm.report = None
+    assert comm.roce_failure() is None
diff --git a/tests/v1/worker/test_b12x_roce_health.py b/tests/v1/worker/test_b12x_roce_health.py
index 976b7c6c4..abac53410 100644
--- a/tests/v1/worker/test_b12x_roce_health.py
+++ b/tests/v1/worker/test_b12x_roce_health.py
@@ -93,3 +93,49 @@ def test_no_roce_communicator_means_no_wrapping(monkeypatch):
         assert worker._b12x_roce_guarded(output) is output
         async_output = _AsyncOutput(output, [])
         assert worker._b12x_roce_guarded(async_output) is async_output
+
+
+REPORT = (
+    "RoCE collective on rank 0 saw nothing from rank 2, HCA 1, for 10.001 s "
+    "(timeout 10 s) at sequence 4855; the GPU was stopped there"
+)
+
+
+class _StoppedAsyncOutput(AsyncModelRunnerOutput):
+    def get_output(self) -> ModelRunnerOutput:
+        raise RuntimeError("CUDA error: unspecified launch failure")
+
+
+def _worker_with_failure(monkeypatch, report) -> Worker:
+    worker = Worker.__new__(Worker)
+    communicator = SimpleNamespace(b12x_ar_comm=Mock(), roce_failure=lambda: report)
+    group = SimpleNamespace(device_communicator=communicator)
+    monkeypatch.setattr(gpu_worker_module, "get_tp_group", lambda: group)
+    return worker
+
+
+def test_a_stopped_collective_is_named_as_the_cause(monkeypatch):
+    """A one-shot collective that timed out stopped the GPU; CUDA's launch
+    failure is re-raised as the collective's report, in a step and when an
+    asynchronous output completes."""
+    worker = _worker_with_failure(monkeypatch, REPORT)
+    with (
+        pytest.raises(RuntimeError, match="saw nothing from rank 2") as raised,
+        gpu_worker_module._collective_cause(worker._roce_failure),
+    ):
+        raise RuntimeError("CUDA error: unspecified launch failure")
+    assert "unspecified launch failure" in str(raised.value.__cause__)
+    wrapped = worker._b12x_roce_guarded(_StoppedAsyncOutput())
+    with pytest.raises(RuntimeError, match="saw nothing from rank 2"):
+        wrapped.get_output()
+
+
+def test_errors_without_a_stopped_collective_pass_unchanged(monkeypatch):
+    worker = _worker_with_failure(monkeypatch, None)
+    error = ValueError("unrelated")
+    with (
+        pytest.raises(ValueError) as raised,
+        gpu_worker_module._collective_cause(worker._roce_failure),
+    ):
+        raise error
+    assert raised.value is error
