From 96bd7949af6b15f80dc80676f91f80636a48394e Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Mon, 19 Oct 2026 10:52:14 +0200
Subject: [PATCH 209/274] CED row copy: switch the packing ops to the TileLang
 copy and remove the old one

gather_rows and scatter_rows copy with the TileLang kernel. CEDState declares
the packed-row layouts it registered with Triton's warmup, through
packed_copy_rows_key, so they compile before the cache freezes; a source view
of wider rows would stop its first CED step with KernelNotPreparedError rather
than compile mid-forward. The Triton copy, its warmup inputs and its launcher
are removed; the kernel tests compare against the benchmark's copy of it, and
the startup test clears the CED kernels' in-memory caches before freezing, so
an undeclared call cannot hide behind an earlier test's compile.

diff --git a/tests/kernels/test_deepseek_v41_tilelang_metadata.py b/tests/kernels/test_deepseek_v41_tilelang_metadata.py
index 6002233ff..4622eb13f 100644
--- a/tests/kernels/test_deepseek_v41_tilelang_metadata.py
+++ b/tests/kernels/test_deepseek_v41_tilelang_metadata.py
@@ -2,6 +2,8 @@
 # SPDX-FileCopyrightText: Copyright contributors to the vLLM project
 """DeepSeek-V4.1 TileLang sparse-MLA metadata against the Triton kernels, exactly."""
 
+import math
+
 import pytest
 import torch
 
@@ -87,6 +89,36 @@ DEVICE = "cuda"
 R, CAP, COLS = 16, 1024, 40
 
 
+def _triton_copy(source, indices, rows, scatter):
+    """Triton's row copy, which the TileLang copy replaced (the benchmark's copy)."""
+    from benchmarks.kernels.ced_reference import _copy_rows
+
+    tail = tuple(source.shape[1:])
+    width = math.prod(tail)
+    output = source.new_zeros((rows, *tail))
+    _copy_rows[(triton.cdiv((source.shape[0] if scatter else rows) * width, 512),)](
+        source,
+        indices,
+        output,
+        source.shape[0],
+        rows,
+        tail,
+        source.stride(),
+        width,
+        scatter,
+        512,
+    )
+    return output
+
+
+def gather_rows(source, indices):
+    return _triton_copy(source, indices, indices.numel(), False)
+
+
+def scatter_rows(source, indices, rows):
+    return _triton_copy(source, indices, rows, True)
+
+
