From 6431ac2a084b74945f484ea55c1809e97017d9e3 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Mon, 19 Oct 2026 11:37:05 +0200
Subject: [PATCH 211/274] CED state: declare the pre-mix scatter only under
 pipeline parallelism

Only a pipeline stage that is not the last scatters the float32 pre-mix back to
every row, so a deployment without pipeline parallelism no longer compiles that
copy at startup. CEDState.warmup takes whether the deployment is pipeline parallel.

diff --git a/tests/v1/attention/test_b12x_v41_ced_metadata.py b/tests/v1/attention/test_b12x_v41_ced_metadata.py
index e4705cf83..50250e7dd 100644
--- a/tests/v1/attention/test_b12x_v41_ced_metadata.py
+++ b/tests/v1/attention/test_b12x_v41_ced_metadata.py
@@ -539,7 +539,7 @@ def test_startup_warmup_covers_live_compaction_without_jit(monkeypatch):
     # The packings compile with the runner's JIT warmup, as under the worker.
     registry = JitWarmupRegistry(None)
     with registry.activate():
-        state.warmup(hidden_size=8, hc_mult=4)
+        state.warmup(hidden_size=8, hc_mult=4, pipeline=False)
     registry.warmup()
     from vllm.models.deepseek_v4_1.tilelang import prepare
 
diff --git a/vllm/models/deepseek_v4_1/ced.py b/vllm/models/deepseek_v4_1/ced.py
index 85e2c06c8..1a13f60c0 100644
--- a/vllm/models/deepseek_v4_1/ced.py
+++ b/vllm/models/deepseek_v4_1/ced.py
@@ -109,10 +109,11 @@ class CEDState:
         self.prefix_start = torch.empty_like(self.request_positions)
         self.plan: CEDPlan | None = None
 
-    def warmup(self, hidden_size: int, hc_mult: int) -> None:
+    def warmup(self, hidden_size: int, hc_mult: int, *, pipeline: bool) -> None:
         """Resolve the row mapping before graph capture, and declare the metadata
-        kernels and both packing directions for preparation (compiled before memory
-        profiling).
+        kernels and the packing layouts the deployment launches for preparation
+        (compiled before memory profiling); ``pipeline``: pipeline parallel, whose
+        stages also scatter the pre-mix.
         """
         device = self.indices.device
         if torch.cuda.is_current_stream_capturing():
@@ -135,10 +136,10 @@ class CEDState:
             (torch.float32, mixes, False),
             (torch.float32, (hc_mult, hc_mult), False),
             # Scattered back to every row: hidden states (collapsed, or the MTP
-            # buffer's streams) and a pipeline stage's pre-mix.
+            # buffer's streams or a pipeline stage's), and a stage's pre-mix.
             (torch.bfloat16, rows, True),
             (torch.bfloat16, streams, True),
-            (torch.float32, mixes, True),
+            *(((torch.float32, mixes, True),) if pipeline else ()),
         )
 
         def warm_metadata():
diff --git a/vllm/models/deepseek_v4_1/nvidia/model_state.py b/vllm/models/deepseek_v4_1/nvidia/model_state.py
