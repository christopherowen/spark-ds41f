From f7b940c6d779831536c6f3b5c190d57561f6590a Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Tue, 13 Oct 2026 18:35:55 +0100
Subject: [PATCH 122/274] TileLang V4.1 WO: WO-A tiles as tall as the bucket
 from 65 rows

From the 2026-10-13 sweep at four shards: split 96-row tiles at 65-96 rows
(27.9-29.5 against 34.5 us), split 128-row tiles at 97-128, and 96-row tiles
inside the kernel past 128 (512 rows 119.1 against 131.8 us, 8192 rows 1675
against 1758 us). Bits depend on neither path nor tile; the tests cover each
bucket's edges.

diff --git a/tests/kernels/quantization/test_deepseek_v41_tilelang_wo.py b/tests/kernels/quantization/test_deepseek_v41_tilelang_wo.py
index 4e4f8e3b5..7c79752c7 100644
--- a/tests/kernels/quantization/test_deepseek_v41_tilelang_wo.py
+++ b/tests/kernels/quantization/test_deepseek_v41_tilelang_wo.py
@@ -26,7 +26,7 @@ from vllm.v1.worker.workspace import use_preallocated_workspace  # noqa: E402
 DEVICE = "cuda"
 # TP4: 16 heads of 512 in 2 groups, rank 1024, hidden 5120.
 HEADS, HEAD_DIM, GROUPS, RANK, HIDDEN, ROPE = 16, 512, 2, 1024, 5120, 64
-ROWS = (1, 7, 16, 33, 64, 65, 200)
+ROWS = (1, 7, 16, 33, 64, 65, 96, 97, 128, 129, 200)
 
 
 def _gen(seed):
@@ -180,5 +180,5 @@ def test_wo_a_keeps_bf16_activations():
         dim=1,
     )
     assert error.mean() < 0.25 * (quantized - ref).abs().mean()
-    for rows in (1, 7, 16, 17, 33, 64, 65, 100, 128, 129, 200):
+    for rows in (1, 7, 16, 17, 33, 64, 65, 96, 97, 100, 128, 129, 200):
         assert torch.equal(project(rows), full[:rows]), rows
diff --git a/vllm/models/deepseek_v4_1/tilelang/wo.py b/vllm/models/deepseek_v4_1/tilelang/wo.py
index f031de1bb..e808aa57b 100644
--- a/vllm/models/deepseek_v4_1/tilelang/wo.py
+++ b/vllm/models/deepseek_v4_1/tilelang/wo.py
@@ -29,16 +29,18 @@ from .rope import rope_
 # added in shard order, so a row's bits do not depend on the path. A bucket either
 # splits the shards over CTAs (FP32 partials, then splitk_reduce: the SMs a narrow grid
 # leaves idle at decode) or adds them inside the kernel (no partials to write and read
-# back). Path and tile per bucket from the split sweep (bits depend on neither): 64
-# columns and two stages throughout; four shards beat two at decode.
+# back). Path and tile per bucket from the split sweeps (bits depend on neither): 64
+# columns and two stages throughout; four shards beat two at decode, and tiles as tall
+# as the bucket from 65 rows (2026-10-13 sweep 2: 72-96 rows 27.9-29.5 against 34.5 us,
+# 512 rows 119.1 against 131.8 us, 8192 rows 1675 against 1758 us).
 _WO_A_SHARDS = 4
 _WO_A_TILES = {
     16: dict(split=True, block_M=16),
     32: dict(split=True, block_M=32),
     64: dict(split=True, block_M=64),
-    96: dict(split=False, block_M=32),
-    128: dict(split=True, block_M=64),
-    None: dict(split=False, block_M=64),
+    96: dict(split=True, block_M=96),
+    128: dict(split=True, block_M=128),
+    None: dict(split=False, block_M=96),
 }
 _WO_A_COMMON = dict(block_N=64, num_stages=2)
 
@@ -50,7 +52,8 @@ class _Weight:
         self.weight = layer.weight.detach()
         self.weight_scale_inv = layer.weight_scale_inv.detach()
         _prepare_block32(self, groups)
-        # 16-stream steps (up to 96 rows) stay on decode tiles, two of 64 rows.
+        # Verification steps stay on decode tiles to 128 rows: one 96-row tile to 96
+        # (WIDE_DECODE), two of 64 rows past it.
         self.tilelang_decode_rows = 128
 
 
