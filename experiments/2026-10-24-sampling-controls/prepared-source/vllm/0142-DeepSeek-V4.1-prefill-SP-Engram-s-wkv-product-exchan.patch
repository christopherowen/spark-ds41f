From 93ee808c5c1a0a3532d59b1f338ea37aa7252923 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Fri, 16 Oct 2026 11:40:48 +0200
Subject: [PATCH 142/274] DeepSeek V4.1 prefill SP: Engram's wkv product
 exchanged all-to-all

Under prefill sequence parallelism every rank projected all T rows of an
Engram layer with its column block of wkv, all-gathered the [T, 25632]
product and then used only its own L rows. On TP3 that all-gather was
50 ms of a 16K prefill (eight [4048, 8544] gathers on dgx3), and the
gathered output was sliced and copied in full.

Each rank now sends every other rank that rank's rows of its column block
(an equal-block all-to-all: PyNCCL grouped send/recv, a registered
collective so compiled graphs see it) and copies the blocks it receives
side by side in rank order, the column order the all-gather gave, into
packed rows (the TileLang gate requires them). It moves 1/N of the
all-gather's bytes; the arithmetic is unchanged. Decode, which runs on
full rows, keeps the all-gather.

Test: every rank's exchanged rows are packed and equal its rows of the
gathered product, with the other ranks' blocks simulated (3 and 4 ranks,
padded last rank, a wholly padded last block).

diff --git a/tests/models/test_deepseek_v41_sp_project_reduce_scatter.py b/tests/models/test_deepseek_v41_sp_project_reduce_scatter.py
index 21e0fbac5..38ba5b7cc 100644
--- a/tests/models/test_deepseek_v41_sp_project_reduce_scatter.py
+++ b/tests/models/test_deepseek_v41_sp_project_reduce_scatter.py
@@ -119,3 +119,39 @@ def test_unreduced_parts_hold_every_block(monkeypatch, tokens, rank, slices, per
         sp_prefill.materialize(sp_prefill.unreduced_parts(parts)),
         collectives.rank_order_sum(list(parts)),
     )
+
+
+@pytest.mark.parametrize("tokens", [37, 40, 205])
+@pytest.mark.parametrize("world", [3, 4])
+def test_column_exchange_gives_each_rank_its_rows_of_the_product(
+    monkeypatch, tokens, world
+):
+    """Every rank's exchanged rows equal its rows of the gathered product cut to the
+    logical width (the other ranks' all-to-all blocks simulated)."""
+    width, block = 50, 17  # logical width over world * block padded columns
+    product = torch.randn(tokens, world * block, device="cuda")
+    ranks = [
+        sp_prefill.SPRows(num_tokens=tokens, world_size=world, rank=r)
+        for r in range(world)
+    ]
+    padded = []
+    for r, rows in enumerate(ranks):
+        local = torch.zeros(rows.padded_rows, block, device="cuda")
+        local[:tokens] = product[:, r * block : (r + 1) * block]
+        padded.append(local)
+    for r, rows in enumerate(ranks):
+        own = rows.local_rows
+
+        def all_to_all(x, r=r, own=own):  # block s of the result comes from rank s
+            assert torch.equal(x, padded[r])
+            return torch.cat([padded[s][r * own : (r + 1) * own] for s in range(world)])
+
+        monkeypatch.setattr(sp_prefill, "tensor_model_parallel_all_to_all", all_to_all)
+        local = product[:, r * block : (r + 1) * block]
+        result = rows.exchange_columns(local, width)
+        assert result.shape == (own, width) and result.is_contiguous()
+        real = rows.real_rows
+        assert torch.equal(
+            result[:real], product[rows.start : rows.start + real, :width]
+        )
+        assert torch.equal(result[real:], torch.zeros_like(result[real:]))
