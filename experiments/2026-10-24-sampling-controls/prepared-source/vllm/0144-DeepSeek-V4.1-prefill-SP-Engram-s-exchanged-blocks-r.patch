 )
-from vllm.models.deepseek_v4_1.tilelang.engram import CLAMP, engram_gate  # noqa: E402
+from vllm.models.deepseek_v4_1.tilelang.engram import (  # noqa: E402
+    CLAMP,
+    engram_gate,
+    engram_gate_blocked,
