From 146769ffe89e51a99e052cff32b8ad892172edb5 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Sat, 17 Oct 2026 11:21:41 +0200
Subject: [PATCH 167/274] Tests: cover the TileLang kernel family where only
 B12X was covered

- DS4.1 kernel-family routing: both families' attention backend and class, and
  TileLang's linear and MoE backends (the B12X-only test also no longer matched
  the error message).
- Kernel preparation: the TileLang order (declare, compile, warm, step kernels,
  registry, heap release, freeze, bind, JIT monitor).
- The custom-op boundary lint reads the TileLang modules that define custom ops.

diff --git a/tests/model_executor/test_b12x_op_boundary.py b/tests/model_executor/test_b12x_op_boundary.py
index 360150abf..6344c66ea 100644
--- a/tests/model_executor/test_b12x_op_boundary.py
+++ b/tests/model_executor/test_b12x_op_boundary.py
@@ -83,7 +83,7 @@ def op_boundary_violations(root=PACKAGE):
     violations = []
     for path in sorted(root.rglob("*.py")):
         text = path.read_text()
-        if "b12x" not in text:
+        if "b12x" not in text and "tilelang" not in text:
             continue
         tree = ast.parse(text, filename=str(path))
         for function in _op_functions(tree):
