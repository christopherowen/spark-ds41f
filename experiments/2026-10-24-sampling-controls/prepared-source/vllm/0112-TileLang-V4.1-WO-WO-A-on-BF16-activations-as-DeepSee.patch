+def test_wo_a_keeps_bf16_activations():
+    """WO-A within one BF16 rounding of the FP64 product of the BF16 activations and
+    the exactly dequantized weights, well inside what MXFP8 activations give, with the
+    same bits at every row count (every row tile runs one K loop)."""
+    from vllm.models.deepseek_v4_1.tilelang.wo import _GroupedBF16
+
+    width = HEADS // GROUPS * HEAD_DIM
+    layer = _block32(GROUPS * RANK, width, 7)
+    wo_a = _GroupedBF16(layer, GROUPS)
+    x = torch.randn((300, GROUPS * width), generator=_gen(8), device=DEVICE).bfloat16()
+    w = _dequant(layer)
+
+    def project(rows):
+        out = torch.empty((rows, GROUPS * RANK), dtype=torch.bfloat16, device=DEVICE)
+        wo_a(x[:rows], out)
+        return out
+
+    full = project(300)
+    ref = torch.cat(
+        [
+            x[:, g * width : (g + 1) * width].double() @ w[g * RANK : (g + 1) * RANK].T
+            for g in range(GROUPS)
+        ],
+        dim=1,
+    )
+    error = (full.double() - ref).abs()
+    assert (error <= ref.abs() * 2**-8 + 1e-3 * ref.abs().max()).all()
+    quantized = torch.cat(
+        [
+            _mxfp8_values(x[:, g * width : (g + 1) * width])
+            @ w[g * RANK : (g + 1) * RANK].T
+            for g in range(GROUPS)
+        ],
+        dim=1,
+    )
+    assert error.mean() < 0.25 * (quantized - ref).abs().mean()
+    for rows in (1, 7, 16, 17, 33, 64, 65, 100, 128, 129, 200):
+        assert torch.equal(project(rows), full[:rows]), rows
diff --git a/vllm/models/deepseek_v4_1/tilelang/gemm.py b/vllm/models/deepseek_v4_1/tilelang/gemm.py
index d91ac4711..f7b6bd5fd 100644
--- a/vllm/models/deepseek_v4_1/tilelang/gemm.py
+++ b/vllm/models/deepseek_v4_1/tilelang/gemm.py
@@ -373,6 +373,66 @@ def bf16_gemm(
     return gemm_bf16
 
 
+@tilelang.jit
+def fp8w_bf16_gemm(
+    N: int,
+    K: int,
+    groups: int = 1,
+    block_M: int = 16,
+    block_N: int = 32,
+    block_K: int = 64,
+    num_stages: int = 2,
+    threads: int = 128,
+):
+    """``C[:, g*N:(g+1)*N] = A[:, g*K:(g+1)*K] @ W_g^T`` for every group ``g`` in one
+    launch: BF16 activations ``A[M, groups*K]`` against block-32 FP8 weights
+    ``W[groups*N, K]`` (E4M3, one UE8M0 exponent per 32x32 block in ``E``), each weight
+    tile expanded exactly to BF16 (an E4M3 value times a power of two fits BF16) and
+    multiplied on BF16 tensor cores with FP32 accumulation; BF16 out. This is DeepSeek's
+    reference WO-A: BF16 activations on the FP8 weights dequantized by ``convert.py``.
+
+    Every M tile runs the same K loop, so a row's bits do not depend on its batch.
+    """
+    assert K % block_K == 0 and block_K % 32 == 0 and N % block_N == 0
+    M = T.dynamic("M")
+    k_blocks = K // block_K
+    n_tiles = N // block_N
+
+    @T.prim_func
+    def main(
+        A: T.Tensor((M, groups * K), T.bfloat16),
+        W: T.Tensor((groups * N, K), T.float8_e4m3fn),
+        E: T.Tensor((groups * N // 32, K // 32), T.uint8),
+        C: T.Tensor((M, groups * N), T.bfloat16),
+    ):
+        with T.Kernel(groups * n_tiles, T.ceildiv(M, block_M), threads=threads) as (
+            bx,
+            by,
+        ):
+            g = bx // n_tiles
+            n0 = g * N + (bx % n_tiles) * block_N
+            A_shared = T.alloc_shared((block_M, block_K), T.bfloat16)
+            W_shared = T.alloc_shared((block_N, block_K), T.float8_e4m3fn)
+            B_shared = T.alloc_shared((block_N, block_K), T.bfloat16)
+            C_local = T.alloc_fragment((block_M, block_N), T.float32)
+            T.clear(C_local)
+            for ko in T.Pipelined(k_blocks, num_stages=num_stages):
+                T.copy(A[by * block_M, g * K + ko * block_K], A_shared)
+                T.copy(W[n0, ko * block_K], W_shared)
+                for i, j in T.Parallel(block_N, block_K):
+                    exponent = T.Cast(
+                        T.uint32, E[(n0 + i) // 32, (ko * block_K + j) // 32]
+                    )
+                    scale = T.reinterpret(T.shift_left(exponent, 23), T.float32)
+                    B_shared[i, j] = T.Cast(
+                        T.bfloat16, T.Cast(T.float32, W_shared[i, j]) * scale
+                    )
+                T.gemm(A_shared, B_shared, C_local, transpose_B=True)
+            T.copy(C_local, C[by * block_M, n0])
+
+    return main
+
+
 @tilelang.jit
 def splitk_reduce_two(
     N: int,
