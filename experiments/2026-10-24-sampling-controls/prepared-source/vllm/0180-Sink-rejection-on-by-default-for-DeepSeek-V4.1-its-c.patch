+@pytest.fixture
+def unset_sink_env(monkeypatch: pytest.MonkeyPatch) -> pytest.MonkeyPatch:
+    for name in (
+        "VLLM_SINK_DETECTOR_COLUMN",
+        "VLLM_SINK_DETECTOR_THRESHOLD",
+        "VLLM_SINK_REJECTION",
