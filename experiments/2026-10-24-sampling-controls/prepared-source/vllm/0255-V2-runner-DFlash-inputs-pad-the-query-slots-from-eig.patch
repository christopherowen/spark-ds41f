From baf8ce86c2f9e5596d057ff4cbd99d9b1586536d Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Sat, 24 Oct 2026 18:28:09 +0200
Subject: [PATCH 255/274] V2 runner: DFlash inputs pad the query slots from
 eight extra blocks

The last request's first block padded the query slot mapping out to
max_num_tokens alone (16,384 rows of 8 bytes in the benchmark), the kernel's
longest path at decode: +0.47 us against Triton, whose stores are 16 bytes. The
padding is now a slice for each of eight extra blocks in the last request's
row; every row written is unchanged.

diff --git a/vllm/v1/worker/gpu/tilelang_inputs.py b/vllm/v1/worker/gpu/tilelang_inputs.py
index 2392c9935..7c24aaed8 100644
--- a/vllm/v1/worker/gpu/tilelang_inputs.py
+++ b/vllm/v1/worker/gpu/tilelang_inputs.py
@@ -1334,6 +1334,8 @@ def post_update(
 # --- DFlash drafting ----------------------------------------------------------
 
 _DFLASH_THREADS = 256  # Triton's BLOCK_SIZE: a thread a context or query row
+# Blocks a step (in the last request's row) that pad the query slots past the batch.
+_DFLASH_PAD_BLOCKS = 8
 
 
 @tilelang.jit(pass_configs=_PASS)
