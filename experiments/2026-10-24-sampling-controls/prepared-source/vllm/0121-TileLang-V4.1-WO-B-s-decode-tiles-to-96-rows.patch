From 4cb439babf69ba4e8ca4551b2c849499473a806f Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Tue, 13 Oct 2026 17:59:11 +0100
Subject: [PATCH 121/274] TileLang V4.1: WO-B's decode tiles to 96 rows

From the 2026-10-13 sweep against today's path (bits equal to the prefill
GEMM): a 64-row tile with 128 columns and two stages (0.87 at 48-64 rows),
and a 96-row wide decode tile (0.91 of the prefill tile at 72-96 rows).
The decode kernels now include any height the wide table names.

diff --git a/vllm/models/deepseek_v4_1/tilelang/gemm.py b/vllm/models/deepseek_v4_1/tilelang/gemm.py
index 4ade1adaf..7fb01fbd9 100644
--- a/vllm/models/deepseek_v4_1/tilelang/gemm.py
+++ b/vllm/models/deepseek_v4_1/tilelang/gemm.py
@@ -919,6 +919,10 @@ DECODE_FP8_CONFIGS: dict[tuple[int, ...], dict[int, dict]] = {
     },
     (5120, 2048): {
         16: dict(block_N=128, block_K=128, num_stages=3),
+        # 2026-10-13 sweep (experiments/2026-10-13-tilelang-fp8-cast): 0.87 of the
+        # default tile at 48-64 rows; a 96-row tile 0.91 of the prefill tile at 72-96.
+        64: dict(block_N=128, block_K=128, num_stages=2),
+        96: dict(block_N=64, block_K=128, num_stages=2),
     },
     # TP4 DSpark main projection.
     (6400, 6144): {
@@ -1001,6 +1005,7 @@ WIDE_DECODE: dict[tuple[int, int], dict[int, int]] = {
     (1792, 5120): {96: 32, 128: 64},
     (1152, 5120): {128: 64},
     (5120, 576): {96: 32},
+    (5120, 2048): {96: 96},
 }
 
 # BF16 projections whose split-K decode path serves rows past DECODE_ROWS, by
diff --git a/vllm/models/deepseek_v4_1/tilelang/linear.py b/vllm/models/deepseek_v4_1/tilelang/linear.py
index 3dba62b77..750c36c62 100644
--- a/vllm/models/deepseek_v4_1/tilelang/linear.py
+++ b/vllm/models/deepseek_v4_1/tilelang/linear.py
@@ -269,6 +269,8 @@ def _prepare_block32(layer, groups: int = 1) -> None:
         layer.tilelang_key = id(layer)
         _LAYERS[layer.tilelang_key] = layer
         return
+    # The wide decode table can name a tile taller than DECODE_ROWS (WO-B's 96).
+    heights = sorted({*DECODE_TILE_ROWS, *layer.tilelang_wide.values()})
     layer.tilelang_decode = {
         block_M: mxfp8_gemm_decode(
             part,
@@ -277,7 +279,7 @@ def _prepare_block32(layer, groups: int = 1) -> None:
             padded_rows=True,
             groups=groups,
         )
-        for block_M in DECODE_TILE_ROWS
+        for block_M in heights
     }
     layer.tilelang_prefill = mxfp8_gemm(
         part, k, **fp8_prefill_config(part, k, groups), groups=groups
