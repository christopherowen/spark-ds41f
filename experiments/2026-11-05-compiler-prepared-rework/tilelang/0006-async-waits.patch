+                T.reads(A[i * 4 : i * 4 + 4])
+                T.writes(SA[0:4])
+                T.copy(A[i * 4 : i * 4 + 4], SA[0:4])
+            with T.sblock("consume_a"):
+                T.reads(SA[0:4])
+                T.writes(C[i * 4 : i * 4 + 4])
