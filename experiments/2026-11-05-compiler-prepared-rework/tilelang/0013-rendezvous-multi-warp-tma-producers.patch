From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Christopher Owen <christopherowen@users.noreply.github.com>
Date: Sat, 7 Nov 2026 00:06:12 +0100
Subject: [PATCH] Rendezvous multi-warp TileLang TMA producers after
 empty-barrier waits

Upstream-base: tile-ai/tilelang@2123e412ce2217b324c50c4ec967213906456ac5
Local-base: 90c5970515e1f4a3c2bd7a93927319d5717e7696

Rationale: When a warp-specialized producer warpgroup spans multiple warps (!producer_is_single_warp), every producer warp waits on the stage empty mbarrier, but only the elected lane or individual warps issue subsequent TMA loads, prefix/SIMT work, and forward arrivals. Without a warpgroup rendezvous after each back-pressure wait, the elected lane can launch TMA and advance the stage parity while peer producer warps are still entering the same wait, causing an mbarrier parity ABA stall. Emit a shared-storage warpgroup sync (lowered by ThreadPartialSyncRewriter to tl::__sync_thread_partial) immediately after each back-pressure wait when !producer_is_single_warp.

Quality: Changes multi-warp producer synchronization only. Single-warp TMA-only producers remain restricted to warp 0.

Tests: Codegen and numerical checks across indexed/leading TMA producers, synchronous FP8 conversion, and multi-group TMA producers pass across two GPU boots.

Upstream-status: local candidate, not yet submitted.
---
 src/cuda/transform/producer_consumer_ws.cc    | 14 +++-
 ...issue_ws_simt_copy_full_producer_extent.py | 65 +++++++++++++++++++
 2 files changed, 78 insertions(+), 1 deletion(-)

diff --git a/src/cuda/transform/producer_consumer_ws.cc b/src/cuda/transform/producer_consumer_ws.cc
index 3b0351c3..86e3583d 100644
--- a/src/cuda/transform/producer_consumer_ws.cc
+++ b/src/cuda/transform/producer_consumer_ws.cc
@@ -574,6 +574,11 @@ static Stmt MakeArriveBarrier(const Buffer &barrier_buf, PrimExpr barrier_id) {
       Call(DataType::Handle(), builtin::ptx_arrive_barrier(), {ref}));
 }
 
+static Stmt MakeProducerRendezvous() {
+  return Evaluate(Call(DataType::Int(32), builtin::tvm_storage_sync(),
+                       {StringImm("shared")}));
+}
+
 // ---------------------------------------------------------------------------
 // Convert tl.tileop.copy → tl.tileop.tma_copy with barrier annotation
 // ---------------------------------------------------------------------------
@@ -1670,11 +1675,18 @@ private:
         PrimExpr fwd_id = IntImm(DataType::Int(32), fwd_base) + p_stage_expr;
         PrimExpr bp_id = IntImm(DataType::Int(32), bp_base) + p_stage_expr;
 
-        // Back-pressure wait (only once when barriers are merged)
+        // Back-pressure wait (only once when barriers are merged).
+        // A multi-warp producer must rendezvous across the producer warpgroup
+        // after each back-pressure wait so no warp issues prefix/SIMT work,
+        // elected TMA loads, or forward arrivals before every producer warp
+        // has observed the stage release.
         if (!can_merge_tma_barriers || tma_idx == 0) {
           producer_stmts.push_back(MakeParityWait(
               barrier_buf, bp_id,
               bitwise_xor(p_parity_expr, IntImm(DataType::Int(32), 1))));
+          if (!producer_is_single_warp) {
+            producer_stmts.push_back(MakeProducerRendezvous());
+          }
         }
 
         // After the first bp_wait, emit all SIMT/cp.async producers
diff --git a/testing/python/issue/test_tilelang_issue_ws_simt_copy_full_producer_extent.py b/testing/python/issue/test_tilelang_issue_ws_simt_copy_full_producer_extent.py
index dff81714..3d2f5e76 100644
--- a/testing/python/issue/test_tilelang_issue_ws_simt_copy_full_producer_extent.py
+++ b/testing/python/issue/test_tilelang_issue_ws_simt_copy_full_producer_extent.py
@@ -115,6 +115,12 @@ def test_ws_tma_producer_participation(coordinate):
     assert ("arrive_and_expect_tx" in producer) == fast_path, src
     assert re.findall(r"mbarrier\[\d+\]\.init\((\d+)\);", src) == ["1" if fast_path else "128"] * 2 + ["128"] * 2, src
     assert producer.count(".arrive();") == (0 if fast_path else 1), src
+    assert bool(
+        re.search(
+            r"mbarrier\[[^\]]+\]\.wait\([^;]+\);\s*tl::__sync_thread_partial\(\d+, 128\);",
+            producer,
+        )
+    ) == (not fast_path), src
 
     a = torch.randn(M, K, device="cuda", dtype=torch.float16)
     b = torch.randn(K, N, device="cuda", dtype=torch.float16)
@@ -150,6 +156,12 @@ def test_ws_publishes_synchronous_fp8_conversion():
             T.copy(acc, C[bm * 16, bn * 16])
 
     kernel = _compile_tvm_ffi(main)
+    src = kernel.get_kernel_source()
+    flat_src = " ".join(src.split())
+    assert re.search(
+        r"mbarrier\[[^\]]+\]\.wait\([^;]+\);\s*tl::__sync_thread_partial\(\d+, 64\);",
+        flat_src,
+    ), src
     row_tags = torch.arange(M, device="cuda") // 16 % 4 + 1
     k_tags = torch.arange(K, device="cuda") // 128 + 1
     a = (row_tags[:, None] * k_tags[None, :]).bfloat16()
@@ -162,5 +174,58 @@ def test_ws_publishes_synchronous_fp8_conversion():
         torch.testing.assert_close(c, expected, rtol=0, atol=0)
 
 
+@tilelang.testing.requires_cuda
+@tilelang.testing.requires_cuda_compute_version_ge(9, 0)
+def test_ws_multi_group_tma_producer_rendezvous_after_each_empty_wait():
+    """Multi-group TMA producers with a multi-warp warpgroup must rendezvous after each empty-barrier wait."""
+    M, N, K = 128, 128, 256
+    block_M, block_N, block_K = 64, 64, 64
+
+    @T.prim_func
+    def main(
+        A: T.Tensor((M, K), T.float16),
+        B1: T.Tensor((K, N), T.float16),
+        B2: T.Tensor((K, N), T.float16),
+        I: T.Tensor((K // block_K,), T.int32),
+        C: T.Tensor((M, N), T.float32),
+    ):
+        with T.Kernel(T.ceildiv(N, block_N), T.ceildiv(M, block_M), threads=128) as (bx, by):
+            A_shared = T.alloc_shared((block_M, block_K), T.float16)
+            B1_shared = T.alloc_shared((block_K, block_N), T.float16)
+            B2_shared = T.alloc_shared((block_K, block_N), T.float16)
+            C_frag = T.alloc_fragment((block_M, block_N), T.float32)
+            T.clear(C_frag)
+            for k in T.Pipelined(T.ceildiv(K, block_K), num_stages=2):
+                idx = I[k] * block_K
+                T.copy(A[by * block_M, idx], A_shared)
+                T.copy(B1[idx, bx * block_N], B1_shared)
+                T.gemm(A_shared, B1_shared, C_frag)
+                T.copy(B2[idx, bx * block_N], B2_shared)
+                T.gemm(A_shared, B2_shared, C_frag)
+            T.copy(C_frag, C[by * block_M, bx * block_N])
+
+    kernel = _compile_tvm_ffi(main)
+    src = kernel.get_kernel_source()
+    flat_src = " ".join(src.split())
+    producer = flat_src.split("if (((int)threadIdx.x) < 128) {", 1)[1].split("} else {", 1)[0]
+    waits = re.findall(
+        r"mbarrier\[[^\]]+\]\.wait\([^;]+\);\s*tl::__sync_thread_partial\(\d+, 128\);",
+        producer,
+    )
+    assert len(waits) == producer.count(".wait(") >= 2, src
+
+    a = torch.randn(M, K, device="cuda", dtype=torch.float16)
+    b1 = torch.randn(K, N, device="cuda", dtype=torch.float16)
+    b2 = torch.randn(K, N, device="cuda", dtype=torch.float16)
+    indices = torch.arange(K // block_K - 1, -1, -1, device="cuda", dtype=torch.int32)
+    c = torch.empty(M, N, device="cuda", dtype=torch.float32)
+    kernel(a, b1, b2, indices, c)
+    ref_a = a.reshape(M, K // block_K, block_K)[:, indices.long()].reshape(M, K)
+    ref_b1 = b1.reshape(K // block_K, block_K, N)[indices.long()].reshape(K, N)
+    ref_b2 = b2.reshape(K // block_K, block_K, N)[indices.long()].reshape(K, N)
+    expected = ref_a.float() @ (ref_b1.float() + ref_b2.float())
+    torch.testing.assert_close(c, expected, rtol=1e-2, atol=1e-2)
+
+
 if __name__ == "__main__":
     tilelang.testing.main()
