+                    T.sync_threads()
+                    best[0] = maximum[0]
+                    total[0] = T.call_extern(
+                        "float32", "vllm_other_exp", values[0], best[0]
+                    )
+                    ties[0] = T.call_extern("float32", "vllm_tie", values[0], best[0])
