+                                T.float32,
+                                init=T.if_then_else(
+                                    owns_draft,
+                                    T.cast(
+                                        logits[
+                                            t,
+                                            T.min(
+                                                T.max(
+                                                    T.cast(draft_col, T.int32), 0
+                                                ),
+                                                vocab - 1,
+                                            ),
+                                        ],
+                                        T.float32,
+                                    ),
+                                    T.float32(0),
+                                ),
+                            )
