@@ -306,6 +305,40 @@ class EngineCoreRequestType(enum.Enum):
     EXECUTOR_FAILED = b"\x04"
     # Sentinel to wake up input_queue.get() during shutdown.
     WAKEUP = b"\x05"
+    ADD_ATOMIC_TEXT_BATCH = b"\x06"
+
+
+ATOMIC_TEXT_BATCH_LIMIT = 16
+
+
+def validate_atomic_text_batch(requests: list[EngineCoreRequest]) -> None:
+    """Private TP8 experiment: bounded, greedy, plain text requests only."""
+    if not 1 <= len(requests) <= ATOMIC_TEXT_BATCH_LIMIT:
+        raise ValueError(
+            f"Atomic admission requires one to {ATOMIC_TEXT_BATCH_LIMIT} requests"
+        )
+    if len({r.request_id for r in requests}) != len(requests):
+        raise ValueError("Atomic admission requires distinct request IDs")
+    for r in requests:
+        p = r.sampling_params
+        if (
+            p is None
+            or p.n != 1
+            or p.temperature != 0
+            or not 1 <= (p.max_tokens or 0) <= 256
+            or p.structured_outputs is not None
+            or r.prompt_token_ids is None
+            or not 1 <= len(r.prompt_token_ids) <= 2048
+            or r.mm_features
+            or r.prompt_embeds is not None
+            or r.lora_request is not None
+            or r.pooling_params is not None
+            or r.resumable
+            or r.data_parallel_rank not in (None, 0)
+        ):
+            raise ValueError(
+                "Atomic admission is limited to short greedy text requests"
+            )
 
 
 class ReconfigureDistributedRequest(msgspec.Struct):
