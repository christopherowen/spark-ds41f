+    async def generate_atomic_text_batch(self, calls):
+        """Register every collector, then submit one message before reading output."""
+        if self.vllm_config.parallel_config.data_parallel_size != 1:
+            raise VLLMValidationError("Atomic admission requires one engine core")
+        if not 1 <= len(calls) <= ATOMIC_TEXT_BATCH_LIMIT:
+            raise VLLMValidationError(
+                f"Atomic admission requires one to {ATOMIC_TEXT_BATCH_LIMIT} prompts"
+            )
+        self.check_admission(len(calls))
+        pending: list[EngineCoreRequest] = []
+        queues: list[RequestOutputCollector] = []
+        finished = False
+        try:
+            for prompt, params, request_id, kwargs in calls:
+                queues.append(
+                    await self.add_request(
+                        request_id, prompt, params, _deferred_atomic=pending, **kwargs
+                    )
+                )
+            await self.engine_core.add_atomic_text_batch_async(pending)
+            # Each collector continues to receive outputs independently from the
+            # usual background handler. This HTTP endpoint returns them together.
+            for i, q in enumerate(queues):
+                while True:
+                    out = q.get_nowait() or await q.get()
+                    assert isinstance(out, RequestOutput)
+                    if out is not STREAM_FINISHED:
+                        yield i, out
+                    if out.finished:
+                        break
+            finished = True
+        finally:
+            try:
+                if pending and not finished:
+                    try:
+                        await self.abort(
+                            [request.request_id for request in pending], internal=True
+                        )
+                    except (Exception, asyncio.CancelledError):
+                        logger.exception("Failed to abort atomic submission")
+            finally:
+                for q in queues:
+                    q.close()
+
