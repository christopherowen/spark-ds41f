+def test_project_exchange_routes_to_oneshot_adapter_when_eligible(monkeypatch):
+    from types import SimpleNamespace
+
+    world, rank, tokens = 4, 1, 40
+    rows = sp_prefill.SPRows(
+        num_tokens=tokens, world_size=world, rank=rank, unreduced=True
+    )
+    local = rows.local_rows
+    source = torch.randn(tokens, 8, dtype=torch.bfloat16, device="cuda")
+    exchanged = []
+
+    class _RoceComm:
+        disabled = False
+
+        def should_exchange(self, chunks, parts=None):
+            return True
+
+        def exchange_into(self, chunks, parts):
+            exchanged.append(tuple(chunks.shape))
+            for peer in range(world):
+                if peer != rank:
+                    parts[peer].copy_(chunks[peer])
+            return parts
+
+    roce_comm = _RoceComm()
+    group = SimpleNamespace(
+        device_communicator=SimpleNamespace(
+            b12x_ar_comm=roce_comm, pynccl_comm="unused_pynccl"
+        )
+    )
+    monkeypatch.setattr(sp_prefill, "get_tp_group", lambda: group)
+
+    parts = rows.project_reduce_scatter(
+        lambda start, stop, out: out.copy_(source[start:stop]),
+        (8,),
+        source.dtype,
+        source.device,
+        slices=2,
+    )
+    torch.cuda.synchronize()
+    assert exchanged == [(4, local // 2, 8), (4, local - local // 2, 8)]
+    blocks = source.view(world, local, 8)
+    for peer in range(world):
+        assert torch.equal(parts[peer], blocks[peer])
+
