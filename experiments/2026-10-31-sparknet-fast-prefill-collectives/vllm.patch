+def test_oneshot_adapter_hooks_for_exchange_reduce_scatter_and_all_reduce():
+    world, rank = 4, 2
+
+    class _Adapter:
+        disabled = False
+
+        def __init__(self):
+            self.ops = []
+
+        def should_exchange(self, chunks, parts=None):
+            return True
+
+        def exchange_into(self, chunks, parts):
+            self.ops.append(("exchange_into", tuple(chunks.shape)))
+            for p in range(world):
+                if p != rank:
+                    parts[p].copy_(chunks[p] + 100.0 * p)
+            return parts
+
+        def should_reduce_scatter(self, inp, dim=0):
+            return dim == 0
+
+        def reduce_scatter(self, inp, dim=0):
+            self.ops.append(("reduce_scatter", tuple(inp.shape), dim))
+            return inp.view(world, -1, *inp.shape[1:])[rank] * float(world)
+
+        def should_all_gather(self, inp, dim=0):
+            return dim == 0
+
+        def all_gather(self, inp, dim=0):
+            self.ops.append(("all_gather", tuple(inp.shape), dim))
+            return torch.cat([inp + float(r) for r in range(world)], dim=0)
+
+    adapter = _Adapter()
+    chunks = torch.ones(world, 3, 8, dtype=torch.bfloat16)
+    parts = torch.zeros_like(chunks)
+    exchange_into(adapter, chunks, parts, rank, world)
+    for p in range(world):
+        if p == rank:
+            assert torch.all(parts[p] == 0)
+        else:
+            assert torch.equal(parts[p], chunks[p] + 100.0 * p)
+
+    inp = torch.ones(12, 8, dtype=torch.bfloat16)
+    rs = reduce_scatter_rank_order(None, inp, rank, world, roce_comm=adapter)
+    assert rs.shape == (3, 8)
+    assert torch.all(rs == 4.0)
+
+    ar = all_reduce_rank_order(None, inp[:10], rank, world, roce_comm=adapter)
+    assert ar.shape == (10, 8)
+    assert adapter.ops == [
+        ("exchange_into", (4, 3, 8)),
+        ("reduce_scatter", (12, 8), 0),
+        ("reduce_scatter", (12, 8), 0),
+        ("all_gather", (3, 8), 0),
+    ]
+
