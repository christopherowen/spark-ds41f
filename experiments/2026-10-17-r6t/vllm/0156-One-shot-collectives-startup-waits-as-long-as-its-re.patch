+++ b/tests/v1/worker/test_b12x_roce_health.py
@@ -8,6 +8,7 @@ completion: immediately for a synchronous output (or ``None``), and only after
 ``get_output()`` for an asynchronous output.
 """
 
+import contextlib
 from types import SimpleNamespace
 from unittest.mock import Mock
 
@@ -139,3 +140,69 @@ def test_errors_without_a_stopped_collective_pass_unchanged(monkeypatch):
     ):
         raise error
     assert raised.value is error
+
+
+class _TimedCommunicator:
+    """A communicator on the TileLang family's RoCE policy: its wait can be set."""
+
+    def __init__(self, timeout_ms: int) -> None:
+        self.timeout_ms = timeout_ms
+        self.calls: list[int] = []
+
+    def set_roce_timeout_ms(self, timeout_ms: int) -> int:
+        self.calls.append(timeout_ms)
+        previous, self.timeout_ms = self.timeout_ms, timeout_ms
+        return previous
+
+
+def _worker_on(monkeypatch, communicator) -> Worker:
+    worker = Worker.__new__(Worker)
+    group = SimpleNamespace(device_communicator=communicator)
+    monkeypatch.setattr(gpu_worker_module, "get_tp_group", lambda: group)
+    return worker
+
+
+def test_startup_waits_as_long_as_its_rendezvous_then_serving_again(monkeypatch):
+    """Ranks compile inside profiling and warm-up for as long as each JIT cache
+    needs; startup's collectives wait as long as the rendezvous, and the serving
+    wait returns once, after warm-up."""
+    communicator = _TimedCommunicator(10_000)
+    worker = _worker_on(monkeypatch, communicator)
+    worker._startup_roce_timeout()
+    startup = gpu_worker_module.envs.VLLM_STARTUP_RENDEZVOUS_TIMEOUT_MS
+    assert communicator.timeout_ms == startup
+    worker._serving_roce_timeout()
+    assert communicator.timeout_ms == 10_000
+    worker._serving_roce_timeout()
+    assert communicator.calls == [startup, 10_000]
+
+
+def test_without_the_roce_policy_nothing_is_timed(monkeypatch):
+    # No setter (another communicator), or a setter whose policy is off.
+    off = SimpleNamespace(set_roce_timeout_ms=lambda _: None)
+    for communicator in (SimpleNamespace(), off):
+        worker = _worker_on(monkeypatch, communicator)
+        worker._startup_roce_timeout()
+        worker._serving_roce_timeout()
+        assert getattr(worker, "_serving_roce_timeout_ms", None) is None
+
+
+def test_profiling_and_warm_up_name_a_stopped_collective(monkeypatch):
+    """Memory profiling and warm-up run the model outside execute_model; a
+    collective that stops the GPU there is named as the cause too."""
+    worker = _worker_with_failure(monkeypatch, REPORT)
+
+    def stopped(*args, **kwargs):
+        raise RuntimeError("CUDA error: unspecified launch failure")
+
+    monkeypatch.setattr(Worker, "_determine_available_memory", stopped)
+    with pytest.raises(RuntimeError, match="saw nothing from rank 2") as raised:
+        worker.determine_available_memory()
+    assert "unspecified launch failure" in str(raised.value.__cause__)
+    monkeypatch.setattr(Worker, "_compile_or_warm_up_model_after_preparation", stopped)
+    monkeypatch.setattr(
+        gpu_worker_module, "set_current_vllm_config", lambda _: contextlib.nullcontext()
+    )
+    worker.vllm_config = None
+    with pytest.raises(RuntimeError, match="saw nothing from rank 2"):
+        worker.compile_or_warm_up_model()
