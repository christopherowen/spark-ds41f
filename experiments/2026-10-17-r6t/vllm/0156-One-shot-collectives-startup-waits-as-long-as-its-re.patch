+    def _determine_available_memory(self) -> int:
         maybe_apply_startup_plan(self)
         # Loading compiled each rank's kernels for as long as its cache needed.
         self._startup_rendezvous("memory profiling")
@@ -959,7 +968,10 @@ class Worker(WorkerBase):
 
     @instrument(span_name="Warmup (GPU)")
     def compile_or_warm_up_model(self) -> CompilationTimes:
-        with set_current_vllm_config(self.vllm_config):
+        with (
+            set_current_vllm_config(self.vllm_config),
+            _collective_cause(self._roce_failure),
+        ):
             return self._compile_or_warm_up_model_after_preparation()
 
     def _compile_or_warm_up_model_after_preparation(self) -> CompilationTimes:
@@ -1142,6 +1154,9 @@ class Worker(WorkerBase):
 
             trigger_inductor_lazy_init(self.device)
 
+        # Warm-up is over, so a collective's wait is serving's again.
+        self._serving_roce_timeout()
+
         # All warmup is done — start monitoring for unexpected JIT
         # compilations that would cause latency spikes during inference.
         from vllm.utils.jit_monitor import activate as activate_jit_monitor
@@ -1376,6 +1391,37 @@ class Worker(WorkerBase):
         failure = getattr(communicator, "roce_failure", None)
         return None if failure is None else failure()
 
+    def _startup_roce_timeout(self) -> None:
+        """Let startup's one-shot collectives wait as long as its rendezvous.
+
+        Kernels still compile inside memory profiling and warm-up, for as long
+        as each rank's JIT cache needs, so a rank with a warm cache waits in
+        the next collective for one compiling. A cold or uneven cache puts
+        ranks minutes apart; the serving wait would stop the GPU there.
+        """
+        communicator = get_tp_group().device_communicator
+        setter = getattr(communicator, "set_roce_timeout_ms", None)
+        if setter is None:
+            return
+        startup = envs.VLLM_STARTUP_RENDEZVOUS_TIMEOUT_MS
+        serving = setter(startup)
+        if serving is not None:
+            self._serving_roce_timeout_ms = serving
+            logger.info(
+                "One-shot collectives wait up to %g s during startup, then %g s.",
+                startup / 1000,
+                serving / 1000,
+            )
+
+    def _serving_roce_timeout(self) -> None:
+        """Restore the one-shot collectives' serving wait, on every rank after
+        warm-up."""
+        serving = getattr(self, "_serving_roce_timeout_ms", None)
+        if serving is None:
+            return
+        get_tp_group().device_communicator.set_roce_timeout_ms(serving)
+        self._serving_roce_timeout_ms = None
+
     def _startup_rendezvous(self, phase: str) -> None:
         """Wait on the host until every rank reaches ``phase``.
 
