{
 "notes": "DSpark alone on the copy build at tp4-ring: the recipe with the copy recipe's ladder and budget (the long-prefill threshold unchanged), no copy_drafts.",
 "extends": {
  "config": "config/cluster.json",
  "shape": "tp4-ring"
 },
 "set": {
  "container": {
   "image": "spark-ds41f:19f2c20ed4d6-copy-drafts"
  }
 },
 "serve_options": {
  "--max-num-batched-tokens": "16395",
  "--max-cudagraph-capture-size": "107",
  "--compilation-config": "{\"cudagraph_mode\":\"FULL_AND_PIECEWISE\",\"custom_ops\":[\"all\"],\"cudagraph_capture_sizes\":[1,2,3,4,6,8,12,16,20,24,28,32,40,48,56,64,72,80,88,96,104,107]}",
  "--long-prefill-token-threshold": "16288",
  "--speculative-config": "{\"method\":\"dspark\",\"num_speculative_tokens\":5,\"draft_tensor_parallel_size\":4,\"attention_backend\":\"TILELANG\",\"draft_sample_method\":\"greedy\",\"rejection_sample_method\":\"block\",\"enable_adaptive_verification\":true,\"adaptive_verification_row_cost\":0.035}"
 }
}
