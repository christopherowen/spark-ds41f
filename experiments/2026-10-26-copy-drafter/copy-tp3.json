{
 "notes": "DSpark with copy drafts on the copy build at tp3-triangle: copy_drafts min_match 16, max_drafts 16, initial_drafts 8; the control's sizing.",
 "extends": {
  "config": "config/cluster.json",
  "shape": "tp3-triangle"
 },
 "set": {
  "container": {
   "image": "spark-ds41f:19f2c20ed4d6-copy-drafts"
  }
 },
 "serve_options": {
  "--max-num-batched-tokens": "8203",
  "--max-cudagraph-capture-size": "59",
  "--compilation-config": "{\"cudagraph_mode\":\"FULL_AND_PIECEWISE\",\"custom_ops\":[\"all\"],\"cudagraph_capture_sizes\":[1,2,3,4,6,8,12,16,20,24,28,32,40,48,56,59]}",
  "--long-prefill-token-threshold": "8144",
  "--speculative-config": "{\"method\":\"dspark\",\"num_speculative_tokens\":5,\"draft_tensor_parallel_size\":3,\"attention_backend\":\"TILELANG\",\"draft_sample_method\":\"greedy\",\"rejection_sample_method\":\"block\",\"enable_adaptive_verification\":true,\"adaptive_verification_row_cost\":0.035,\"copy_drafts\":{\"min_match\":16,\"initial_drafts\":8,\"max_drafts\":16}}"
 }
}
