+@contextmanager
+def _frozen_kernels(reason):
+    """Refuse every TileLang kernel not yet compiled, as serving does after kernel
+    preparation (capture compiles nothing)."""
+    from tilelang.cache import freeze, thaw
+
+    freeze(reason)
+    try:
+        yield
+    finally:
+        thaw()
