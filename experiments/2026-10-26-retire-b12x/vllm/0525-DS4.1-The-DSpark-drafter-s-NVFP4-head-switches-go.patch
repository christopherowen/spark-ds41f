Date: Mon, 26 Oct 2026 08:22:10 +0100
Subject: [PATCH 525/528] [DS4.1] The DSpark drafter's NVFP4 head switches go

VLLM_DS41_DRAFT_NVFP4_HEAD (a drafter-owned NVFP4 vocabulary head) and
VLLM_DS41_MARKOV_NVFP4 (an NVFP4 Markov transition head) select B12X's
NVFP4 linear kernel. Both are off by default and spark-ds41f-1025 already
dropped them from the recipe as settings for kernels serving does not run;
they lower the heads' precision, and without B12X in the image either would
quietly fall back to the native head. They go: the drafter shares the
target's (packed) head and the Markov head is BF16, as served today.

envs.py's comment for VLLM_DS41_PACKED_BF16_LM_HEAD now says the head is
packed and projected by TileLang.
---
 vllm/envs.py                               | 18 +++---------------
 vllm/models/deepseek_v4_1/nvidia/dspark.py | 20 +-------------------
 2 files changed, 4 insertions(+), 34 deletions(-)

diff --git a/vllm/envs.py b/vllm/envs.py
index d651e1ce3..74681e705 100755
--- a/vllm/envs.py
+++ b/vllm/envs.py
@@ -219,8 +219,6 @@ if TYPE_CHECKING:
     VLLM_QWEN3_8_FLASH_NEXT_MTP_COMPACT: bool = True
     VLLM_GDN_SPEC_DECODE_METADATA_FASTPATH: bool = True
     VLLM_MTP_NVFP4_LM_HEAD: bool = True
-    VLLM_DS41_MARKOV_NVFP4: bool = False
-    VLLM_DS41_DRAFT_NVFP4_HEAD: bool = False
     VLLM_DS41_PACKED_BF16_LM_HEAD: bool = False
     VLLM_DS41_HEAD_DTYPE: Literal["float32", "model"] = "float32"
     VLLM_STARTUP_HEARTBEAT_TIMEOUT_S: float = 120.0
@@ -1884,19 +1882,9 @@ environment_variables: dict[str, Callable[[], Any]] = {
     "VLLM_MTP_NVFP4_LM_HEAD": lambda: bool(
         int(os.getenv("VLLM_MTP_NVFP4_LM_HEAD", "1"))
     ),
-    # Quantize the DeepSeek V4.1 DSpark Markov transition head to NVFP4 (fits
-    # the GB10 L2; draft graph 3.57 -> 3.0 ms). Off until its effect on
-    # acceptance is measured.
-    "VLLM_DS41_MARKOV_NVFP4": lambda: bool(
-        int(os.getenv("VLLM_DS41_MARKOV_NVFP4", "0"))
-    ),
-    # Give the DeepSeek V4.1 DSpark drafter its own NVFP4 vocabulary head.
-    "VLLM_DS41_DRAFT_NVFP4_HEAD": lambda: bool(
-        int(os.getenv("VLLM_DS41_DRAFT_NVFP4_HEAD", "0"))
-    ),
-    # Store the DeepSeek V4/V4.1 target vocabulary head (which the DSpark
-    # drafter shares when it has no head of its own) in B12X's exact 12-bit
-    # packed BF16 form: every weight bit is kept, in 75% of the bytes.
+    # Store the DeepSeek V4.1 target vocabulary head (which the DSpark drafter
+    # shares) in its exact 12-bit packed BF16 form (B12X's format, packed and
+    # projected by TileLang): every weight bit is kept, in 75% of the bytes.
     "VLLM_DS41_PACKED_BF16_LM_HEAD": lambda: bool(
         int(os.getenv("VLLM_DS41_PACKED_BF16_LM_HEAD", "0"))
     ),
diff --git a/vllm/models/deepseek_v4_1/nvidia/dspark.py b/vllm/models/deepseek_v4_1/nvidia/dspark.py
index 9c645e313..70615620d 100644
--- a/vllm/models/deepseek_v4_1/nvidia/dspark.py
+++ b/vllm/models/deepseek_v4_1/nvidia/dspark.py
@@ -32,7 +32,6 @@ from vllm.model_executor.layers.fused_moe import (
 )
 from vllm.model_executor.layers.linear import ReplicatedLinear
 from vllm.model_executor.layers.logits_processor import LogitsProcessor
-from vllm.model_executor.layers.vocab_parallel_embedding import ParallelLMHead
 from vllm.model_executor.model_loader.weight_utils import default_weight_loader
 from vllm.model_executor.models.qwen3_dspark import (
     DSparkConfidenceHead,
@@ -310,9 +309,6 @@ class DSparkDeepseekV4Model(nn.Module):
             draft_vocab_size,
             config.dspark_markov_rank,
             prefix=maybe_prefix(prefix, "markov_head"),
-            # An NVFP4 transition head fits the GB10 L2, so the sequential
-            # draft positions after the first reread it from L2.
-            lm_head_quantization="nvfp4" if envs.VLLM_DS41_MARKOV_NVFP4 else None,
             vocab_parallel=_vocab_parallel_greedy(),
         )
         self.confidence_head: DSparkConfidenceHead | None = None
@@ -469,23 +465,9 @@ class DSparkDeepseekV4ForCausalLM(nn.Module):
         self.model = DSparkDeepseekV4Model(
             vllm_config=vllm_config, prefix=maybe_prefix(prefix, "model")
         )
-        # Bound by load_dspark_model after loading. An unused online-quantized
-        # head otherwise remains on meta and cannot be natively precompiled.
+        # The target's head, bound by load_dspark_model after loading.
         self.lm_head: nn.Module | None = None
         self.logits_processor = LogitsProcessor(self.config.vocab_size)
-        if envs.VLLM_DS41_DRAFT_NVFP4_HEAD:
-            # A drafter-owned NVFP4 vocabulary head reads half the bytes of
-            # the shared MXFP8 target head; only draft acceptance depends on it.
-            head = ParallelLMHead(
-                self.config.vocab_size,
-                self.config.hidden_size,
-                prefix=maybe_prefix(prefix, "lm_head"),
-                lm_head_quantization="nvfp4",
-            )
-            if head.runtime_lm_head_quantization == "nvfp4":
-                self.lm_head = head
-                self.has_own_lm_head = True
-                self.checkpoint_weight_name_prefixes = ("mtp.", "head.")
 
