+                if valid < local_part and not param.is_meta:
+                    param.data[p * local_part + valid : (p + 1) * local_part].zero_()
+            return
+        # Row-parallel bias is added once on rank 0; non-zero ranks hold zeros.
+        if self.tp_rank == 0:
