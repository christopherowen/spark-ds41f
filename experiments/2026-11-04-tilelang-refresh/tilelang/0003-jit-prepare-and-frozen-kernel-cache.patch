+
+def prepare(
+    calls: Iterable[tuple[JITImpl, tuple[Any, ...], dict[str, Any]]],
+    num_workers: int | None = None,
+    progress: Callable[[int, int], None] | None = None,
+) -> list[JITKernel]:
+    """Compile lazy-mode JIT functions' call forms ahead of their calls, in one thread pool.
+
+    Each call is ``(jit_function, args, kwargs)``, with the arguments exactly as the call
+    site passes them. Every distinct call is elaborated, then compiled (or loaded from the
+    disk cache) on a shared thread pool (lowering releases the GIL and nvcc is a
+    subprocess), and its kernel is kept under the key ``__call__`` computes for the same
+    call, so the call itself is a cache hit. ``progress(done, total)`` is called as
+    kernels finish.
+
+    Parameters
+    ----------
+    calls : Iterable[tuple[JITImpl, tuple, dict]]
+        The function, positional arguments and keyword arguments of each call.
+    num_workers : int, optional
+        Compile threads; defaults to the available CPUs, capped at the kernel count.
+    progress : Callable[[int, int], None], optional
+        Called with (kernels done, kernels to prepare).
+
+    Returns
+    -------
+    List[JITKernel]
+        The kernel of each call, in order.
+    """
+    calls = [(impl, tuple(args), dict(kwargs)) for impl, args, kwargs in calls]
+    keys = []
+    pending: dict[tuple[int, Any], tuple[JITImpl, Any, PrimFunc]] = {}
+    for impl, args, kwargs in calls:
+        impl.initialize_jit_mode(*args, **kwargs)
+        if not impl.is_lazy_mode():
+            raise ValueError("prepare() compiles lazy-mode kernels (functions that return a PrimFunc)")
+        key = impl.func.parse_args(*args, **kwargs)[0]
+        keys.append((impl, key))
+        if key not in impl._kernel_cache and (id(impl), key) not in pending:
+            pending[(id(impl), key)] = (impl, key, impl.get_tir(*args, **kwargs))
+    total = len(pending)
+    if progress is not None:
+        progress(0, total)
+    if pending:
+        workers = num_workers or min(total, get_available_cpu_count())
+        with concurrent.futures.ThreadPoolExecutor(workers, "tl-prepare") as executor:
+            futures = {
+                executor.submit(
+                    compile,
+                    func=func,
+                    out_idx=impl.out_idx,
+                    execution_backend=impl.execution_backend,
+                    target=impl.target,
+                    target_host=impl.target_host,
+                    verbose=impl.verbose,
+                    pass_configs=impl.pass_configs,
+                    compile_flags=impl.compile_flags,
+                ): (impl, key)
+                for impl, key, func in pending.values()
+            }
+            for done, future in enumerate(concurrent.futures.as_completed(futures), 1):
+                impl, key = futures[future]
+                impl._kernel_cache[key] = future.result()
+                if progress is not None:
+                    progress(done, total)
+    return [impl._kernel_cache[key] for impl, key in keys]
+
 ExecutionBackend = Literal["auto", "tvm_ffi", "cython", "nvrtc", "torch", "cutedsl", "pto"]
 
 
