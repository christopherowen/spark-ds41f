diff --git a/tilelang/cache/kernel_cache.py b/tilelang/cache/kernel_cache.py
index 92a07099a..547252f82 100644
--- a/tilelang/cache/kernel_cache.py
+++ b/tilelang/cache/kernel_cache.py
@@ -32,6 +32,47 @@ from tilelang.contrib.hip_resource_info import dump_to_file, load_from_file
 from tilelang import __version__
 
 
+class KernelNotPreparedError(RuntimeError):
+    """A kernel was requested after the kernel cache was frozen, and it is not in memory."""
+
+
+_freeze_lock = threading.Lock()
+_frozen_reason: str | None = None
+
+
+def freeze(reason: str) -> None:
+    """Refuse every kernel that is not already in memory, from now on.
+
+    A request that would load a kernel from the disk cache or compile it raises
+    ``KernelNotPreparedError`` instead. Prepare the kernels a program needs, then freeze:
+    a missing one then fails by name in every process alike, whatever each process's
+    disk cache holds, instead of compiling at an arbitrary point.
+    """
+    global _frozen_reason
+    with _freeze_lock:
+        _frozen_reason = reason
+
+
+def thaw() -> None:
+    """Allow loading and compiling again (tests, and re-preparation)."""
+    global _frozen_reason
+    with _freeze_lock:
+        _frozen_reason = None
+
+
+def frozen() -> str | None:
+    """Why the cache is frozen, or None while it is not."""
+    return _frozen_reason
+
+
+def _refuse_if_frozen(func) -> None:
+    reason = _frozen_reason
+    if reason is not None:
+        raise KernelNotPreparedError(
+            f"TileLang kernel {get_prim_func_name(func, '<unknown>')!r} was not prepared: the kernel cache is frozen ({reason})"
+        )
+
+
 class KernelCache:
