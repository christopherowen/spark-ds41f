+                        chosen_score = 0.0
+                        if lane < num_topk:
+                            chosen_score = T.reinterpret(
+                                warp_count[warp, chosen_idx], T.float32
+                            )
+                        total = chosen_score
+                        for i in T.unroll(0, 5):
+                            total += T.shfl_xor(total, 1 << (4 - i))
+                        total += 1e-20
+                        if lane < num_topk:
+                            topk_idx_s[row, lane] = chosen_idx
+                            topk_weights_s[row, lane] = (
+                                chosen_score / total * routed_scaling_factor
+                            )
+                        T.sync_warp()
+
+            T.sync_threads()
+            count = T.alloc_var(T.int32)
+            routes = rows * num_topk
+            expert, rank = rank_routes(topk_idx_s, routes, 0, num_topk, tx, warp_count)
+            count = T.if_then_else(
+                tx < num_experts, warp_count[warps, T.min(tx, num_experts - 1)], 0
+            )
+            offset = layout(
+                count,
+                block_M,
+                tx,
+                scan,
+                ExpertCount,
+                ExpertOffset,
+                Psum,
+                Order,
+                LayoutWeights,
+                TileExpert,
+                NumTiles,
+                tiles,
+            )
+            T.sync_threads()
+            if tx < num_experts:
+                scan[tx] = offset
+            T.sync_threads()
+            if tx < routes:
+                if expert >= 0:
+                    Order[scan[expert] + rank] = tx
+                    LayoutWeights[scan[expert] + rank] = topk_weights_s[
+                        tx // num_topk, tx % num_topk
+                    ]
+                    RoutePos[tx // num_topk, tx % num_topk] = scan[expert] + rank
+                else:
+                    RoutePos[tx // num_topk, tx % num_topk] = -1
