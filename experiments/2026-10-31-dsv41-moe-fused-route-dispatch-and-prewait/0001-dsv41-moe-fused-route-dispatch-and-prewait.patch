+_FUSED_DISPATCH_MAX_ROWS = 32
+
+
+@tilelang.jit(
+    pass_configs={
+        tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True,
+        tilelang.PassConfigKey.TL_DISABLE_OUT_OF_BOUND_WARNING: True,
+        tilelang.PassConfigKey.TL_DISABLE_THREAD_STORAGE_SYNC: True,
+    },
+)
+def route_and_dispatch_partials(
+    num_topk: int,
+    num_experts: int,
+    shards: int,
+    block_M: int,
+    image_mask: bool,
+    routing_mask: bool,
+    image_ids: str | None = None,
+    image_lo: int = 0,
+    image_count: int = 0,
+    padding: bool = False,
+    max_rows: int = _FUSED_DISPATCH_MAX_ROWS,
+):
+    """Fused decode split-K partial reduction, sqrtsoftplus top-k routing, and
+    contiguous MoE dispatch in a single 1-CTA kernel launch for ``rows <= max_rows``."""
+    from .moe import _CHUNK, _dispatch_macros
+
+    threads = _CHUNK
+    warps = threads // _WARP
+    assert num_topk <= _WARP and num_experts % _VECTOR == 0
+    assert max_rows * num_topk <= threads
+    per_lane = tilelang.cdiv(tilelang.cdiv(num_experts, _WARP), _VECTOR) * _VECTOR
+    rows, image_len, mask_len, tiles = T.dynamic("rows, image_len, mask_len, tiles")
+    image_dtype = image_ids if image_ids is not None else T.bool
+    rank_routes, layout = _dispatch_macros(num_experts, threads)
+
+    @T.prim_func
+    def router_and_dispatch_partials(
+        P: T.Tensor((shards, rows, num_experts), T.float32),
+        bias: T.Tensor((num_experts,), T.float32),
+        image_bias: T.Tensor((num_experts,), T.float32),
+        image_token_mask: T.Tensor((image_len,), image_dtype),
+        route_mask: T.Tensor((mask_len,), T.bool),
+        routed_scaling_factor: T.float32,
+        Order: T.Tensor((tiles * block_M,), T.int32),
+        LayoutWeights: T.Tensor((tiles * block_M,), T.float32),
+        RoutePos: T.Tensor((rows, num_topk), T.int32),
+        TileExpert: T.Tensor((tiles,), T.int32),
+        ExpertCount: T.Tensor((num_experts,), T.int32),
+        ExpertOffset: T.Tensor((num_experts,), T.int32),
+        Psum: T.Tensor((num_experts,), T.int32),
+        NumTiles: T.Tensor((1,), T.int32),
+    ):
+        with T.Kernel(1, threads=threads):
+            pdl.chain()
+            warp_count = T.alloc_shared((warps + 1, num_experts), T.int32)
+            scan = T.alloc_shared((threads,), T.int32)
+            topk_idx_s = T.alloc_shared((max_rows, num_topk), T.int32)
+            topk_weights_s = T.alloc_shared((max_rows, num_topk), T.float32)
+
+            tx = T.get_thread_binding()
+            warp = tx // _WARP
+            lane = tx % _WARP
+
+            bias_local = T.alloc_local((per_lane,), T.float32)
+            scores = T.alloc_local((per_lane,), T.float32)
+            ids = T.alloc_local((per_lane,), T.int32)
+            finite = T.alloc_var(T.bool, init=True)
+            best_score = T.alloc_var(T.float32)
+            best_idx = T.alloc_var(T.int32, init=-1)
+            previous = T.alloc_var(T.int32, init=-1)
+            chosen_idx = T.alloc_var(T.int32, init=-1)
