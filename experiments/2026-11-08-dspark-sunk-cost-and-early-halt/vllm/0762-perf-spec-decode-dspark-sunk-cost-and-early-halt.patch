             num_speculative_steps, dtype=torch.float32, device=device
         )
 
+    @property
+    def is_calibrated(self) -> bool:
+        """Whether per-position intercepts are calibrated (via warm-start prior or online refit)."""
+        return bool(getattr(self, "_warm_started", False) or self._refits > 0)
+
     @classmethod
     def for_confidence_head(
         cls,
         max_num_reqs: int,
         num_speculative_steps: int,
         device: torch.device,
+        *,
