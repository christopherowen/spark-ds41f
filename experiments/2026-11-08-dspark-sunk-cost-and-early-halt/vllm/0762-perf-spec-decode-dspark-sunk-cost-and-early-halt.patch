+# Empirical per-position log-odds calibration intercepts fitted across DSpark's
+# 5-step Markov confidence head on DeepSeek-V4.1-Flash (positions 0..4).
+# Maps DSpark's overconfident raw head (~[0.78, 0.72, 0.71, 0.71, 0.73]) onto
+# empirical conditional acceptance (~[0.678, 0.576, 0.484, 0.511, 0.563]) from
+# step 0, avoiding cold-boot dead_rows_tau=0.20 starvation and tail censorship
+# during the initial REFIT_INTERVAL steps while still adapting online via IRLS.
+_WARM_CONFIDENCE_HEAD_INTERCEPTS: tuple[float, ...] = (
+    -0.52,
+    -0.64,
+    -0.96,
+    -0.85,
+    -0.74,
+)
