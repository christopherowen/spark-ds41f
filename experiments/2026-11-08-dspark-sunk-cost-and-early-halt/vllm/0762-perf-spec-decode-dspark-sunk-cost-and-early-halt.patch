     step = token_idx - batch_idx * NUM_SPECULATIVE_STEPS
 
     raw_prob = tl.load(conf_ptr + batch_idx * conf_stride + step).to(tl.float32)
+    if raw_prob <= 0.0:
+        tl.store(conf_ptr + batch_idx * conf_stride + step, 0.0)
+        return
     eps = 1e-6
     clamped = tl.minimum(tl.maximum(raw_prob, eps), 1.0 - eps)
     feature = tl.log(clamped / (1.0 - clamped))
