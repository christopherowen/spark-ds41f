+def test_single_tile_sunk_draft_cost_retains_positive_throughput_drafts_at_c1_and_c2():
+    """Including sunk sequential drafting cost (DRAFT_COST_RATIO) and single-tile
+    marginal row slope (SINGLE_TILE_ROW_COST_SCALE) retains position 4 on c1/c2
+    while preserving multi-tile c8/c16 budgets."""
+    # Empirical 1107 calibrated conditional acceptance -> survival [0.667, 0.384, 0.1855, 0.0948, 0.0535]
+    emp_cond = np.array([[0.667, 0.576, 0.483, 0.511, 0.564]], dtype=np.float32)
+
+    # Without sunk draft cost or single-tile slope, c1 discards position 4 (budget=4).
+    legacy_c1 = make_manager(emp_cond.copy(), row_cost=0.035)
+    legacy_c1.req_states.req_id_to_index = {"r0": 0}
+    legacy_c1.dead_rows_tau = 0.20
+    legacy_c1.calibrated_confidence = True
+    legacy_c1.single_tile_row_cost_scale = 1.0
+    legacy_c1.draft_cost_ratio = 0.0
+    legacy_c1.get_num_tokens({"r0": 6}, {"r0": [1, 2, 3, 4, 5]})
+    assert legacy_c1._batch_budget[2] == 4
+
+    # With single-tile slope (0.42) and sunk draft cost (0.55), c1 (6 rows <= 16)
+    # and c2 (12 rows <= 16) retain all 5 already-drafted tokens per request.
+    cand_c1 = make_manager(emp_cond.copy(), row_cost=0.035)
+    cand_c1.req_states.req_id_to_index = {"r0": 0}
+    cand_c1.dead_rows_tau = 0.20
+    cand_c1.calibrated_confidence = True
+    assert cand_c1.get_num_tokens({"r0": 6}, {"r0": [1, 2, 3, 4, 5]}) == 6
+    assert cand_c1._batch_budget[2] == 5
+
+    cand_c2 = make_manager(np.tile(emp_cond, (2, 1)), row_cost=0.035)
+    cand_c2.req_states.req_id_to_index = {"r0": 0, "r1": 1}
+    cand_c2.dead_rows_tau = 0.20
+    cand_c2.calibrated_confidence = True
+    assert (
+        cand_c2.get_num_tokens(
+            {"r0": 6, "r1": 6}, {"r0": [1, 2, 3, 4, 5], "r1": [1, 2, 3, 4, 5]}
+        )
+        == 12
+    )
+    assert cand_c2._batch_budget[2] == 10
+
+    # Multi-tile c8 (32 total rows, 3 drafts/req) and c16 (48 total rows, 2 drafts/req).
+    for n_reqs, expected_drafts in ((8, 24), (16, 32)):
+        mgr = make_manager(np.tile(emp_cond, (n_reqs, 1)), row_cost=0.035)
+        rids = [f"r{i}" for i in range(n_reqs)]
+        mgr.req_states.req_id_to_index = {rid: i for i, rid in enumerate(rids)}
+        mgr.dead_rows_tau = 0.20
+        mgr.calibrated_confidence = True
+        total = mgr.get_num_tokens(
+            {rid: 6 for rid in rids},
+            {rid: [1, 2, 3, 4, 5] for rid in rids},
+        )
+        assert mgr._batch_budget[2] == expected_drafts
+        assert total == n_reqs + expected_drafts
+
+
+def test_max_draft_steps_for_batch_bounds_sequential_draft_depth():
+    """max_draft_steps_for_batch bounds verifiable per-request draft steps by
+    _max_total_logits and max_draft_steps_per_req."""
+    manager = make_manager(np.ones((16, 5), dtype=np.float32), row_cost=0.035)
+    manager._max_total_logits = 20
+    assert manager.max_draft_steps_for_batch(1) == 5
+    assert manager.max_draft_steps_for_batch(8) == 5
+    # At c16 with max_total_logits=20 and 1 bonus token/req, only 4 draft rows fit.
+    assert manager.max_draft_steps_for_batch(16) == 4
+    assert manager.max_draft_steps_for_batch(20) == 0
+
+    # Once calibrated, multi-tile batches bound sequential draft depth at the
+    # 16-row Tensor Core MMA tile knee (c1/c2 -> 5, c8 -> 4, c16 -> 3).
+    manager._max_total_logits = 2048
+    manager.calibrated_confidence = True
+    assert manager.max_draft_steps_for_batch(1) == 5
+    assert manager.max_draft_steps_for_batch(2) == 5
+    assert manager.max_draft_steps_for_batch(8) == 4
+    assert manager.max_draft_steps_for_batch(16) == 3
+
+    manager.max_draft_steps_per_req = 3
+    assert manager.max_draft_steps_for_batch(1) == 3
+    assert manager.max_draft_steps_for_batch(8) == 3
