+@pytest.mark.parametrize("device_name", ["cpu", "cuda"])
+def test_warm_start_confidence_head_calibrates_from_step_zero_and_preserves_halted_zeros(
+    device_name,
+):
+    """Warm-started confidence_head estimator is calibrated at step 0 and keeps
+    halted (0.0) draft positions at exact 0.0 without polluting features."""
+    device = torch.device(device_name)
+    estimator = OnlineAcceptanceEstimator.for_confidence_head(
+        MAX_NUM_REQS, 5, device, warm_start=True
+    )
+    assert estimator.is_calibrated
+    assert estimator._refits == 0
+
+    # Raw DSpark confidence head output at c1: ~[0.78, 0.72, 0.71, 0.71, 0.73].
+    # Request 0 drafts all 5 steps; request 1 halted early after 2 steps (cols 2..4 = 0.0).
+    raw = torch.tensor(
+        [
+            [0.78, 0.72, 0.71, 0.71, 0.73],
+            [0.45, 0.30, 0.0, 0.0, 0.0],
+        ],
+        device=device,
+        dtype=torch.float32,
+    )
+    probs = raw.clone()
+    slots = torch.tensor([2, 5], device=device, dtype=torch.int32)
+    estimator.features[5] = torch.tensor(
+        [10.0, 20.0, 30.0, 40.0, 50.0], device=device
+    )
+    estimator.predictions[5] = torch.tensor(
+        [0.5, 0.5, 0.5, 0.5, 0.5], device=device
+    )
+    estimator.calibrate_confidence_probs(probs, slots)
+
+    # Request 0 survival matches 1107 empirical c1 survival [0.667, 0.384, 0.185, 0.095, 0.053]
+    # within MAE < 0.006 from step 0 without waiting 100 steps for a refit.
+    emp_survival = torch.tensor(
+        [0.667, 0.384, 0.185, 0.095, 0.053], device=device
+    )
+    cal_survival = torch.cumprod(probs[0], dim=0)
+    assert (cal_survival - emp_survival).abs().mean().item() < 0.006
+
+    # Request 1's halted positions (2..4) remain exact 0.0 and preserve prior slot state.
+    assert probs[1, :2].gt(0.0).all()
+    assert torch.equal(probs[1, 2:], torch.zeros(3, device=device))
+    torch.testing.assert_close(
+        estimator.features[5, 2:],
+        torch.tensor([30.0, 40.0, 50.0], device=device),
+    )
+    torch.testing.assert_close(
+        estimator.predictions[5, 2:],
+        torch.tensor([0.5, 0.5, 0.5], device=device),
+    )
