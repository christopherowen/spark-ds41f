+@pytest.mark.parametrize("batch_size", [1, 8, 16])
+def test_dspark_early_draft_halting_and_dynamic_loop_depth(batch_size, monkeypatch):
+    """DSparkSpeculator._sample_sequential and _sample_sequential_topk bound the
+    executed Markov loop depth by max_active_draft_steps and halt early on low
+    cumulative confidence while preserving TP rank determinism."""
+    from vllm.v1.worker.gpu import tilelang_inputs
+    from vllm.v1.worker.gpu.spec_decode.dspark.speculator import DSparkSpeculator
+
+    monkeypatch.setattr(
+        tilelang_inputs, "gather_hidden_rows", lambda src, idx: src[idx]
+    )
+    n_spec = 5
+    vocab_size = 16
+    hidden_dim = 8
+
+    # 1. Dynamic draft depth cap via adaptive_verification.max_draft_steps_for_batch
+    cap_for_batch = {1: 5, 8: 4, 16: 3}[batch_size]
+    executed_steps = []
+
+    def embed(ids):
+        executed_steps.append(ids.clone())
+        return torch.ones((ids.shape[0], 4), dtype=torch.float32)
+
+    base = torch.zeros((batch_size * n_spec, vocab_size), dtype=torch.float32)
+    for s in range(n_spec):
+        base[s::n_spec, s + 1] = 5.0
+
+    def compute_conf(h, m, out=None):
+        probs = torch.full((h.shape[0],), 0.8, dtype=torch.float32)
+        if out is not None:
+            out.copy_(probs)
+            return out
+        return probs
+
+    model = SimpleNamespace(
+        supports_local_draft_argmax=lambda: True,
+        compute_local_draft_logits=lambda h: base,
+        markov_embed=embed,
+        compute_local_markov_bias=lambda x: torch.zeros(
+            (x.shape[0], vocab_size), dtype=torch.float32
+        ),
+        sample_local_draft_logits=lambda b, bias: (b + bias).argmax(dim=-1),
+        compute_confidence=compute_conf,
+    )
+    av = SimpleNamespace(max_draft_steps_for_batch=lambda n: cap_for_batch)
+    spec = SimpleNamespace(
+        _draft_topk=None,
+        num_speculative_steps=n_spec,
+        sample_from_anchor=True,
+        model=model,
+        sample_indices=torch.arange(batch_size * n_spec),
+        sample_idx_mapping=torch.arange(batch_size * n_spec),
+        sample_pos=torch.arange(batch_size * n_spec),
+        use_confidence_head=True,
+        input_buffers=SimpleNamespace(
+            input_ids=torch.full((batch_size * n_spec,), 7, dtype=torch.int64)
+        ),
+        _anchor_idx=torch.arange(batch_size) * n_spec,
+        draft_tokens=torch.full((batch_size, n_spec), -1, dtype=torch.int64),
+        draft_token_confidence_probs=torch.full(
+            (batch_size, n_spec), -1.0, dtype=torch.float32
+        ),
+        draft_logits=None,
+        acceptance_estimator=None,
+        adaptive_verification=av,
+        early_halt_tau=0.0,
+    )
+    spec._vocab_parallel_greedy = MethodType(
+        DSparkSpeculator._vocab_parallel_greedy, spec
+    )
+    hidden = torch.zeros((batch_size * n_spec, hidden_dim), dtype=torch.float32)
+    DSparkSpeculator._sample_sequential(spec, batch_size, hidden)
+
+    assert len(executed_steps) == cap_for_batch
+    for s in range(cap_for_batch):
+        assert (spec.draft_tokens[:, s] == s + 1).all()
+        assert torch.allclose(
+            spec.draft_token_confidence_probs[:, s], torch.tensor(0.8)
+        )
+    if cap_for_batch < n_spec:
+        assert (spec.draft_tokens[:, cap_for_batch:] == 0).all()
+        assert (spec.draft_token_confidence_probs[:, cap_for_batch:] == 0.0).all()
+
+    # 2. Confidence-gated early draft halting (early_halt_tau = 0.15):
+    # Step confidences [0.65, 0.55, 0.25, 0.80, 0.80] -> survival [0.65, 0.3575, 0.0894 < 0.15].
+    # Step 2's confidence is evaluated before step 2's Markov bias/sample, halting at step 2
+    # so only steps 0 and 1 sample tokens and steps 2..4 are skipped and zeroed.
+    step_confs = [0.65, 0.55, 0.25, 0.80, 0.80]
+    conf_call_idx = 0
+    sample_calls = 0
+
+    def compute_conf_halt(h, m, out=None):
+        nonlocal conf_call_idx
+        p = step_confs[min(conf_call_idx, len(step_confs) - 1)]
+        conf_call_idx += 1
+        probs = torch.full((h.shape[0],), p, dtype=torch.float32)
+        if out is not None:
+            out.copy_(probs)
+            return out
+        return probs
+
+    def sample_local(b, bias):
+        nonlocal sample_calls
+        sample_calls += 1
+        return (b + bias).argmax(dim=-1)
+
+    model.compute_confidence = compute_conf_halt
+    model.sample_local_draft_logits = sample_local
+    spec.adaptive_verification = None
+    spec.early_halt_tau = 0.15
+    spec.draft_tokens.fill_(-1)
+    spec.draft_token_confidence_probs.fill_(-1.0)
+
+    DSparkSpeculator._sample_sequential(spec, batch_size, hidden)
+    assert sample_calls == 2
+    assert conf_call_idx == 3
+    assert (spec.draft_tokens[:, 0] == 1).all()
+    assert (spec.draft_tokens[:, 1] == 2).all()
+    assert (spec.draft_tokens[:, 2:] == 0).all()
+    assert torch.allclose(
+        spec.draft_token_confidence_probs[:, 0], torch.tensor(0.65)
+    )
+    assert torch.allclose(
+        spec.draft_token_confidence_probs[:, 1], torch.tensor(0.55)
+    )
+    assert (spec.draft_token_confidence_probs[:, 2:] == 0.0).all()
