                     num_new_tokens = min(
                         num_new_tokens,
                         prefill_interleave_step.token_budget(
@@ -1762,7 +1770,12 @@ class Scheduler(SchedulerInterface):
                             # prefill compute to a cadence-aligned step.
                             break
                     request_token_budget = min(token_budget, input_budget - draft_slots)
-                    if interleaved_local_prefill:
+                    if (
+                        interleaved_local_prefill
+                        and not self.scheduler_config.align_prefill_chunks
+                    ):
+                        # Aligned chunks are not split to a lane's share (see the
+                        # running pass).
                         assert prefill_interleave_step is not None
                         request_token_budget = min(
                             request_token_budget,
