 tests/v1/core/test_aligned_prefill_lanes.py | 100 ++++++++++++++++++++
 vllm/config/scheduler.py                    |   5 +-
 vllm/v1/core/sched/scheduler.py             |  17 +++-
 3 files changed, 118 insertions(+), 4 deletions(-)
 create mode 100644 tests/v1/core/test_aligned_prefill_lanes.py

diff --git a/tests/v1/core/test_aligned_prefill_lanes.py b/tests/v1/core/test_aligned_prefill_lanes.py
