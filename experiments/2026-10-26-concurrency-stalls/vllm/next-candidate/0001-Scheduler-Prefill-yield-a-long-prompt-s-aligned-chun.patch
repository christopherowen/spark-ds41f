@@ -2086,6 +2189,17 @@ class Scheduler(SchedulerInterface):
             if not defer_prefills:
                 self.prefill_capacity_bound = bool(self.waiting)
 
+        if (
+            deferred_long
+            and not first_decode_due
+            and not admitted_short
+            and token_budget > 0
