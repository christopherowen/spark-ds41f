diff --git a/tests/kernels/test_deepseek_v41_engram_rows.py b/tests/kernels/test_deepseek_v41_engram_rows.py
index eb7496e..4005166 100644
--- a/tests/kernels/test_deepseek_v41_engram_rows.py
+++ b/tests/kernels/test_deepseek_v41_engram_rows.py
@@ -1197,3 +1197,161 @@ def test_multi_cta_step_kernel_matches_three_launch_across_batches(columns: int,
             torch.testing.assert_close(out_step.cpu(), expected, rtol=0, atol=0, equal_nan=True)
     finally:
