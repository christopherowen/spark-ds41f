+def test_engram_slices():
+    assert sp_prefill.engram_slices(2047) == 1
+    assert sp_prefill.engram_slices(2048) == 2
+    assert sp_prefill.engram_slices(8192) == 2
+    assert sp_prefill.engram_slices(16384) == 2
