+@pytest.mark.parametrize("world", [3, 4])
+@pytest.mark.parametrize("short", [0, 3, 9, 25])
+@pytest.mark.parametrize("slices", [1, 2])
+def test_project_exchange_rows_over_cabled_pairs(
+    monkeypatch, topology, world, short, slices, rows=10
+):
+    """``SPRows.project_exchange_rows`` over ``_Fabric`` on CUDA streams: each rank
+    projects peer blocks into send slots, exchanges them on the side stream with
+    ``copy_self=False``, projects its own block straight into ``out[rank]``, and
+    produces the exact same BF16 blocks as ``all_to_all_rows``."""
+    from types import SimpleNamespace
+
+    total = max(1, world * rows - short)
+    fabric = _Fabric(world)
+    inputs = [
+        torch.randn(total, 6, device="cuda", dtype=torch.bfloat16)
+        for _ in range(world)
+    ]
+    outputs: list[torch.Tensor | None] = [None] * world
+    local_comm = threading.local()
+    monkeypatch.setattr(
+        sp_prefill,
+        "get_tp_group",
+        lambda: SimpleNamespace(
+            device_communicator=SimpleNamespace(
+                pynccl_comm=local_comm.comm, b12x_ar_comm=None
+            )
+        ),
+    )
+    errors = []
+
+    def run(rank: int) -> None:
+        try:
+            local_comm.comm = fabric.comm(rank)
+            sp = sp_prefill.SPRows(num_tokens=total, world_size=world, rank=rank)
+            outputs[rank] = sp.project_exchange_rows(
+                lambda start, stop, dest: dest.copy_(inputs[rank][start:stop]),
+                (6,),
+                torch.bfloat16,
+                inputs[rank].device,
+                slices=slices,
+            )
+            torch.cuda.synchronize()
+        except BaseException as error:
+            errors.append((rank, error))
+            fabric.barrier.abort()
+
+    threads = [threading.Thread(target=run, args=(r,)) for r in range(world)]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join()
+    assert not errors, errors
+    for me in range(world):
+        real = max(0, min(rows, total - me * rows))
+        for source in range(world):
+            got = outputs[me][source]
+            assert torch.equal(
+                got[:real].view(torch.int16),
+                inputs[source][me * rows : me * rows + real].view(torch.int16),
+            )
