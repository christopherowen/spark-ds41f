+            T.sync_threads()
+            count = T.alloc_var(T.int32)
+            routes = rows * num_topk
+            expert, rank = rank_routes(topk_idx_s, routes, 0, num_topk, tx, warp_count)
+            count = T.if_then_else(
+                tx < num_experts, warp_count[warps, T.min(tx, num_experts - 1)], 0
