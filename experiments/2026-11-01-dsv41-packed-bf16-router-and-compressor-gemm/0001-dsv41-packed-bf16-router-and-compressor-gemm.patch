+    oa[2 * w + 1] = (la23 & 0x807F807Fu) | expa23;
+    ob[2 * w + 0] = (lb01 & 0x807F807Fu) | expb01;
+    ob[2 * w + 1] = (lb23 & 0x807F807Fu) | expb23;
