+            offset = layout(
+                count,
+                block_M,
+                tx,
+                scan,
+                ExpertCount,
+                ExpertOffset,
+                Psum,
+                Order,
+                LayoutWeights,
+                TileExpert,
+                NumTiles,
+                tiles,
+            )
+            T.sync_threads()
+            if tx < num_experts:
+                scan[tx] = offset
+            T.sync_threads()
+            if tx < routes:
+                if expert >= 0:
+                    Order[scan[expert] + rank] = tx
+                    LayoutWeights[scan[expert] + rank] = topk_weights_s[
