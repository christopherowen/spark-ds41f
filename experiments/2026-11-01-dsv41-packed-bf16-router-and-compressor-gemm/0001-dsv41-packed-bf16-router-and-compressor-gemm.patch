+@pytest.mark.parametrize("parts, out_dtype", [(1, torch.bfloat16), (2, torch.float32)])
+def test_packed_linear_and_split_linear_with_exceptions(parts, out_dtype, k=5120):
+    """Wide exponent outliers, subnormals, and signed zeros stored in the CSR
+    exception table are accumulated identically across decode split-K and prefill."""
+    from torch import nn
+
+    from vllm.models.deepseek_v4_1.tilelang.linear import (
+        TileLangLinearMethod,
+        TileLangSplitLinearMethod,
+        project_parts,
+    )
+    from vllm.v1.worker.workspace import use_preallocated_workspace
+
+    gen = _gen(41)
+    n = 512 * parts
+    # Wide exponent distribution + explicit zeros and extreme magnitudes so exceptions > 0.
+    weight = (torch.randn((n, k), generator=gen, device=DEVICE) * 0.5).bfloat16()
+    weight[:, ::64] = 0.0
+    weight[:, 1::128] = 1e-6
+    weight[:, 3::128] = 64.0
+    x = torch.randn((max(ROWS), k), generator=_gen(42), device=DEVICE).bfloat16()
+
+    if parts == 1:
+        linear_layer = nn.Module()
+        linear_layer.weight = nn.Parameter(weight[:384].clone(), requires_grad=False)
+        linear_method = TileLangLinearMethod()
+        linear_method.process_weights_after_loading(linear_layer)
+        assert linear_layer.packed_bf16_exceptions > 0
+        linear_method.declare_layer_kernels(linear_layer)
+        scratch_lin = torch.empty(16 << 20, dtype=torch.uint8, device=DEVICE)
+        ref_lin = x.float() @ weight[:384].float().T
+        with use_preallocated_workspace(scratch_lin):
+            full_lin = linear_method.apply(linear_layer, x)
+            torch.testing.assert_close(
+                full_lin.float(), ref_lin, rtol=1e-2, atol=1e-2 * ref_lin.abs().max().item()
+            )
+            for rows in ROWS:
+                out_lin = linear_method.apply(linear_layer, x[:rows])
+                assert torch.equal(out_lin, full_lin[:rows]), f"linear rows={rows}"
+
+    layer = nn.Module()
+    layer.weight = nn.Parameter(weight.clone(), requires_grad=False)
+    layer.out_dtype = out_dtype
+    method = TileLangSplitLinearMethod(parts)
+    method.process_weights_after_loading(layer)
+    assert layer.packed_bf16_exceptions > 0
+    method.declare_layer_kernels(layer)
+    scratch = torch.empty(
+        method.get_workspace_size(layer, max(ROWS)), dtype=torch.uint8, device=DEVICE
+    )
+
+    def project(rows):
+        outs = [
+            torch.full((max(ROWS), 512), float("nan"), dtype=out_dtype, device=DEVICE)
+            for _ in range(parts)
+        ]
+        with use_preallocated_workspace(scratch):
+            project_parts(layer, x[:rows], outs, rows)
+        return outs
+
+    full = project(max(ROWS))
+    for index, out in enumerate(full):
+        ref = x.float() @ weight[index * 512 : (index + 1) * 512].float().T
+        torch.testing.assert_close(
+            out.float(), ref, rtol=1e-2, atol=1e-2 * ref.abs().max().item()
+        )
+    for rows in ROWS:
+        for out, whole in zip(project(rows), full):
+            assert torch.equal(out[:rows], whole[:rows]), f"split rows={rows}"
+            assert out[rows:].isnan().all()
+    assert not layer.tilelang_counters.any()
+
