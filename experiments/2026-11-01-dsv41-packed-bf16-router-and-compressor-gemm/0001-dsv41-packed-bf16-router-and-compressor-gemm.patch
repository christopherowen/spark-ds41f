+@pytest.mark.parametrize("n, k", [(32, 5120), (128, 5120), (384, 5120), (512, 5120)])
+def test_packed_bf16_gemm_and_partials_match_bf16(n, k):
+    """Packed 12-bit BF16 GEMMs and split-K partials with zero exceptions match
+    unpacked ``bf16_gemm`` and ``bf16_gemm_partials`` bit for bit."""
+    from vllm.models.deepseek_v4_1.tilelang.gemm import (
+        packed_bf16_gemm,
+        packed_bf16_gemm_partials,
+    )
+    from vllm.models.deepseek_v4_1.tilelang.linear import PARTIAL_ROW_TILES
+    from vllm.models.deepseek_v4_1.tilelang.vocab import pack_bf16_weight
+
+    gen = _gen(31)
+    # Narrow exponent spread so exceptions == 0 (all values representable in 12-bit).
+    weight = (torch.rand((n, k), generator=gen, device=DEVICE, dtype=torch.float32) + 1.0).bfloat16()
+    packed = pack_bf16_weight(weight)
+    assert packed.exceptions == 0
+    x = torch.randn((max(ROWS), k), generator=gen, device=DEVICE).bfloat16()
+    shards = bf16_shards(n, k)
+
+    ref_prefill = bf16_gemm(n, k, out_dtype="bfloat16", shards=shards)
+    pack_prefill = packed_bf16_gemm(
+        n,
+        k,
+        out_dtype="bfloat16",
+        shards=shards,
+        exponent_base=packed.exponent_base,
+    )
+    out_ref = torch.empty((max(ROWS), n), dtype=torch.bfloat16, device=DEVICE)
+    out_pack = torch.empty_like(out_ref)
+    ref_prefill(x, weight, out_ref)
+    pack_prefill(
+        x,
+        packed.values,
+        packed.exception_rows,
+        packed.exception_entries,
+        packed.row_offsets,
+        out_pack,
+    )
+    assert torch.equal(out_pack, out_ref)
+
+    for blocked in (False, True):
+        for block_M in PARTIAL_ROW_TILES:
+            ref_part = bf16_gemm_partials(
+                n, k, shards, block_M=block_M, blocked=blocked
+            )
+            pack_part = packed_bf16_gemm_partials(
+                n,
+                k,
+                shards,
+                block_M=block_M,
+                blocked=blocked,
+                exponent_base=packed.exponent_base,
+            )
+            for rows in (1, 7, block_M):
+                p_ref = torch.empty((shards, rows, n), dtype=torch.float32, device=DEVICE)
+                p_pack = torch.empty_like(p_ref)
+                ref_part(x[:rows], weight, p_ref)
+                pack_part(
+                    x[:rows],
+                    packed.values,
+                    packed.exception_rows,
+                    packed.exception_entries,
+                    packed.row_offsets,
+                    p_pack,
+                )
+                assert torch.equal(p_pack, p_ref), (
+                    f"n={n} blocked={blocked} block_M={block_M} rows={rows}"
+                )
+
