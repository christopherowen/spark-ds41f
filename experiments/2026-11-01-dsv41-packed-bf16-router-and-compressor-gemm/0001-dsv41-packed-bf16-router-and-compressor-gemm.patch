+@pytest.mark.parametrize("experts,topk", [(384, 6), (128, 3)])
+@pytest.mark.parametrize("rows", [1, 6, 16, 17, 32])
+@pytest.mark.parametrize("vision", [False, True])
+def test_fused_route_and_dispatch_partials_matches_separate_route_and_dispatch(
+    plain_scratch, padded_step, experts, topk, rows, vision
+):
+    """When paired with a MoeDispatchV41Plan (dispatch_block_M=32), decode routing
+    and dispatch fuse into a single 1-CTA launch that produces the exact same
+    layout tensors bit-for-bit as separate route_partials + moe_dispatch_v41."""
+    from vllm.models.deepseek_v4_1.tilelang import prepare
+    from vllm.models.deepseek_v4_1.tilelang.linear import _calls
+    from vllm.models.deepseek_v4_1.tilelang.moe import (
+        MoeDispatchV41Plan,
+        carve,
+        workspace_bytes,
+    )
+
+    padded_step(rows, 1 if rows >= 4 else 0)
+    gate = _Gate(experts, seed=experts + rows)
+    generator = torch.Generator(device="cuda").manual_seed(rows * 13 + int(vision))
+    x = torch.randn(rows, 5120, device="cuda", generator=generator).to(torch.bfloat16)
+    bias = torch.randn(experts, device="cuda", generator=generator) * 0.1
+    kwargs = dict(
+        top_k=topk,
+        global_num_experts=experts,
+        e_score_correction_bias=bias,
+        renormalize=True,
+        routed_scaling_factor=SCALE,
+        scoring_func="sqrtsoftplus",
+    )
+    input_ids = None
+    if vision:
+        kwargs.update(
+            bias_vl=torch.nn.Parameter(
+                torch.randn(experts, device="cuda", generator=generator) * 0.1,
+                requires_grad=False,
+            ),
+            image_sentinel_lo=LO,
+            image_sentinel_count=1,
+        )
+        input_ids = torch.randint(0, 1000, (rows,), device="cuda", generator=generator)
+        input_ids[::2] = LO
+
+    dispatch = MoeDispatchV41Plan(experts, topk, 32, 5120, torch.int64, torch.bfloat16)
+    prepare.declare(lambda: _calls(dispatch.kernels()), bind=dispatch.bind)
+    specs = dispatch.workspace_specs(rows)
+
+    # 1. Separate route_partials + moe_dispatch_v41
+    separate_router = tilelang_router.TileLangGateRouter(gate=gate, **kwargs)
+    separate_router.declare_kernels()
+    sep_w, sep_ids = separate_router._compute_routing(
+        None, x, None, input_ids=input_ids
+    )
+    ws_sep = torch.zeros(workspace_bytes(specs), dtype=torch.uint8, device="cuda")
+    layout_sep = dispatch.dispatch(sep_ids, sep_w, carve(ws_sep, specs))
+
+    # 2. Fused route_and_dispatch_partials
+    fused_router = tilelang_router.TileLangGateRouter(gate=gate, **kwargs)
+    fused_router.dispatch_block_M = 32
+    fused_router.declare_kernels()
+    fused_w, fused_ids = fused_router._compute_routing(
+        None, x, None, input_ids=input_ids
+    )
+    ws_fused = torch.zeros(workspace_bytes(specs), dtype=torch.uint8, device="cuda")
+    layout_fused = dispatch.dispatch(fused_ids, fused_w, carve(ws_fused, specs))
+
+    for name in dispatch._LAYOUT:
+        a, b = layout_fused[name], layout_sep[name]
+        if a.dtype == torch.float32:
+            assert torch.equal(a.view(torch.int32), b.view(torch.int32)), name
+        else:
+            assert torch.equal(a, b), name
+
