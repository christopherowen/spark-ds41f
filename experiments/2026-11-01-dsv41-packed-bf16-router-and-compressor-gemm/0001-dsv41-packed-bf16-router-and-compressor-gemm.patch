+
+    return router_and_dispatch_partials
+
+
+_DEFERRED_PARTIALS_DISPATCH: list[tuple[int, tuple[int, ...], object]] = []
+_DECODE_PARTIALS_BUFFERS: dict[tuple[torch.device, int], torch.Tensor] = {}
+
+
+def _decode_partials_buffer(
+    device: torch.device, shards: int, rows: int, num_experts: int
+) -> torch.Tensor:
+    cap = shards * max(rows, _FUSED_DISPATCH_MAX_ROWS) * num_experts
+    buf = _DECODE_PARTIALS_BUFFERS.get((device, cap))
+    if buf is None or buf.numel() < cap:
+        buf = torch.empty(cap, dtype=torch.float32, device=device)
+        _DECODE_PARTIALS_BUFFERS[(device, cap)] = buf
+    return buf[: shards * rows * num_experts].view(shards, rows, num_experts)
+
+
+def defer_partials_dispatch(ids_handle: torch.Tensor, launcher) -> None:
+    """Register a deferred ``route_and_dispatch_partials`` launch for ``ids_handle``."""
+    _DEFERRED_PARTIALS_DISPATCH.append(
+        (ids_handle.data_ptr(), tuple(ids_handle.shape), launcher)
+    )
+
+
+def consume_partials_dispatch(ids_handle: torch.Tensor):
+    """Consume and return the deferred ``route_and_dispatch_partials`` launch for
+    ``ids_handle``, or None when ``ids_handle`` carries materialized routes."""
+    ptr = ids_handle.data_ptr()
+    shape = tuple(ids_handle.shape)
+    for i in range(len(_DEFERRED_PARTIALS_DISPATCH) - 1, -1, -1):
+        entry_ptr, entry_shape, launcher = _DEFERRED_PARTIALS_DISPATCH[i]
+        if entry_ptr == ptr and entry_shape == shape:
+            _DEFERRED_PARTIALS_DISPATCH.pop(i)
+            return launcher
+    return None
