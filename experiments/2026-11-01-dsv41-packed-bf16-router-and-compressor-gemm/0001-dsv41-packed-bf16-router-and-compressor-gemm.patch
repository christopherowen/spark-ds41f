+    K: int,
+    exponent_base: int,
+    block_M: int = 64,
+    block_N: int = 64,
+    num_stages: int = 2,
+    threads: int = 128,
+    out_dtype: T.dtype = T.bfloat16,
+    shards: int = 1,
+    blocked: bool = False,
