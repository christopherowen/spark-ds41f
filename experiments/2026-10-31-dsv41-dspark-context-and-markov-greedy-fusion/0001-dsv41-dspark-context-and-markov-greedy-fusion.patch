+    from vllm.v1.worker.gpu import tilelang_inputs
+    from vllm.v1.worker.gpu.spec_decode.dspark import speculator as speculator_mod
+    from vllm.v1.worker.gpu.spec_decode.dspark.speculator import DSparkSpeculator
+
+    monkeypatch.setattr(
+        tilelang_inputs, "gather_hidden_rows", lambda source, indices: source[indices]
+    )
+    monkeypatch.setattr(
+        speculator_mod, "tensor_model_parallel_all_gather", lambda x, dim=-1: x
+    )
+
+    fused_calls = []
+
+    def fused_shard_pair(markov_embed, base_logits_step, vocab, vocab_start, out):
+        fused_calls.append((markov_embed.clone(), vocab, vocab_start))
+        scores = base_logits_step.float() + markov_embed.float().expand(-1, vocab)
+        vals, idx = scores.max(dim=-1)
+        out.zero_()
+        out[:, 0] = vals
+        out[:, 1].view(torch.int32).copy_(idx.to(torch.int32) + vocab_start)
+        return out
+
+    def select_argmax(pairs, out, pair_width=4, embed=None):
+        out.copy_(pairs[:, 1].view(torch.int32).to(torch.int64))
+
+    monkeypatch.setattr(speculator_mod, "select_first_argmax", select_argmax)
+
+    base = torch.tensor(
+        [[3.0, 0.0], [0.0, 3.0], [3.0, 0.0], [0.0, 3.0]], dtype=torch.bfloat16
+    )
+    model = SimpleNamespace(
+        supports_local_draft_argmax=lambda: False,
+        can_fuse_markov_greedy_local=lambda: True,
+        draft_id_to_target_id=None,
+        draft_vocab_shard=(0, 2),
+        compute_draft_logits_local=Mock(return_value=base),
+        compute_draft_logits=Mock(return_value=base),
+        markov_embed=lambda ids: ids[:, None].bfloat16(),
+        markov_greedy_shard_pair_local=Mock(side_effect=fused_shard_pair),
+        markov_bias_local=Mock(side_effect=AssertionError("bias_local materialized")),
+        markov_bias=Mock(side_effect=AssertionError("bias materialized")),
+    )
+    spec = SimpleNamespace(
+        _draft_topk=None,
+        num_speculative_steps=2,
+        sample_from_anchor=True,
+        model=model,
+        sample_indices=torch.arange(4),
+        sample_idx_mapping=torch.tensor([0, 0, 1, 1]),
+        sample_pos=torch.arange(4),
+        use_confidence_head=False,
+        input_buffers=SimpleNamespace(input_ids=torch.tensor([5, 9])),
+        _anchor_idx=torch.tensor([0, 1]),
+        draft_tokens=torch.full((2, 2), -1, dtype=torch.int64),
+        draft_logits=None,
+        acceptance_estimator=None,
+        _greedy_shard_pairs=torch.zeros((2, 4), dtype=torch.float32),
+        _vocab_parallel_greedy=lambda local_head: vocab_parallel,
+        _markov_table=lambda: None,
+    )
+    hidden = torch.zeros((4, 8), dtype=torch.bfloat16)
+    DSparkSpeculator._sample_sequential(spec, 2, hidden)
+    assert len(fused_calls) == 2
+    assert spec.draft_tokens.tolist() == [[0, 1], [0, 1]]
