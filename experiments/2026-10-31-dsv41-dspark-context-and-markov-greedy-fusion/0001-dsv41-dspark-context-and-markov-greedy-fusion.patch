+@pytest.mark.parametrize("n", [32320, 43092])
+def test_bf16_head_markov_greedy_pairs_match_greedy_markov_shard_pair(n):
+    from vllm.v1.worker.gpu.spec_decode.dspark.greedy import (
+        greedy_markov_shard_pair,
+        scratch_shape,
+    )
+
+    k = 256
+    generator = torch.Generator(device=DEVICE).manual_seed(n + 101)
+    weight = (torch.randn(n, k, generator=generator, device=DEVICE) * 0.05).bfloat16()
+    weight[100] = weight[5]
+    weight[500] = weight[5]
+    layer = SimpleNamespace(weight=weight, tilelang_max_rows=64)
+    prepare_bf16_head(layer)
+    x = torch.randn(64, k, generator=generator, device=DEVICE, dtype=torch.bfloat16)
+    base_3d = torch.randn(
+        64, 5, n, generator=generator, device=DEVICE, dtype=torch.bfloat16
+    )
+    for vocab, vocab_start in ((n, 0), (n - 37, 32320)):
+        for rows in (1, 5, 16, 17, 33, 64):
+            part = x[:rows].contiguous()
+            base_step = base_3d[:rows, 2]
+            bias = project_head(layer, part)
+            expected = torch.empty((rows, 4), dtype=torch.float32, device=DEVICE)
+            shape = scratch_shape(rows, vocab)
+            values = torch.empty(shape, dtype=torch.float32, device=DEVICE)
+            indices = torch.empty(shape, dtype=torch.int32, device=DEVICE)
+            greedy_markov_shard_pair(
+                base_step[:, :vocab],
+                bias[:, :vocab],
+                vocab_start,
+                expected,
+                values,
+                indices,
+            )
+            actual = torch.empty((rows, 4), dtype=torch.float32, device=DEVICE)
+            project_head_markov_greedy_pairs(
+                layer,
+                part,
+                base_step,
+                vocab=vocab,
+                vocab_start=vocab_start,
+                out=actual,
+            )
+            assert torch.equal(actual[:, :2], expected[:, :2]), (rows, vocab)
+
+
+def test_packed_head_greedy_pairs_multi_and_zero_exceptions():
+    from vllm.v1.worker.gpu.spec_decode.greedy_verification import vocab_parallel_pairs
+
+    n, k = 640, 384
+    weight = (torch.rand(n, k, device=DEVICE) * 0.5 + 0.5).bfloat16()
+    zero_layer = _packed_layer(weight)
+    prepare_packed_head(zero_layer)
+    x = (torch.randn(9, k, device=DEVICE) * 0.5).bfloat16()
+    expected_zero = vocab_parallel_pairs(project_head(zero_layer, x), n, 0, tp_size=1)
+    actual_zero = project_head_greedy_pairs(zero_layer, x, vocab=n, vocab_start=0)
+    assert torch.equal(actual_zero[:, :2], expected_zero[:, :2])
+
+    weight_exc = torch.full((n, k), 0.01, dtype=torch.bfloat16, device=DEVICE)
+    weight_exc[5, 17] = 1.0e20
+    weight_exc[5, 99] = 2.0e20
+    weight_exc[5, 211] = -5.0e19
+    exc_layer = _packed_layer(weight_exc)
+    prepare_packed_head(exc_layer)
+    expected_exc = vocab_parallel_pairs(project_head(exc_layer, x), n, 0, tp_size=1)
+    actual_exc = project_head_greedy_pairs(exc_layer, x, vocab=n, vocab_start=0)
+    assert torch.equal(actual_exc[:, :2], expected_exc[:, :2])
