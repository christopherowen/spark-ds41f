+@pytest.mark.parametrize("world_size", [3, 4])
+@pytest.mark.parametrize("rows", [6, 24])
+def test_decode_indexer_splits_rows_across_tp_ranks(monkeypatch, world_size, rows):
+    """On multi-rank decode (``rows >= tp_size``), ``_forward`` splits ``_index_query``
+    and ``forward_mqa`` selection across TP ranks, caches each rank's decode page-table
+    slice across index layers, keeps candidate source/consumer slices rank-local, and
+    all-gathers a ``topk_indices_buffer`` identical to the unsplit path."""
+    from vllm.models.deepseek_v4_1 import attention, sp_prefill
+    from vllm.models.deepseek_v4_1.tilelang import metadata as tl_metadata
+    from vllm.models.deepseek_v4_1.tilelang.linear import MXFP8Rows
+
+    monkeypatch.setattr(torch.cuda, "is_current_stream_capturing", lambda: False)
+    monkeypatch.setattr(attention, "current_workspace_manager", lambda: SimpleNamespace(get_simultaneous=lambda *specs: []))
+
+    im = SimpleNamespace(
+        req_id_per_token=torch.arange(rows, dtype=torch.int32),
+        cache_lengths=torch.full((rows,), 256, dtype=torch.int32),
+        block_table=torch.arange(rows * 16, dtype=torch.int32).view(rows, 16),
+        max_seq_len=32768,
+        decoder=None,
+    )
+    pages_calls = []
+
+    def fake_pages(reqs, lengths, table, out, offset, count, read_width, *, page):
+        pages_calls.append((offset, count))
+        out[:count] = table[offset : offset + count, : out.shape[1]]
+
+    monkeypatch.setattr(tl_metadata, "pages", fake_pages)
+
+    def make_layer(layer_id, tp_size, tp_rank, context_dict):
+        layer = _tilelang_layer(layer_id=layer_id)
+        layer._context = context_dict
+        layer.prefix = f"model.layers.{layer_id}.self_attn"
+        context_dict[layer.prefix] = layer
+        layer.compress_ratio = 0
+        layer.candidate_source_layer = 20
+        layer.q_lora_rank = 16
+        layer.n_local_heads = 2
+        layer.hidden_size = 32
+        layer.tp_size = tp_size
+        layer.tp_rank = tp_rank
+        layer.is_draft = False
+        layer._draft_replays = False
+        layer.is_ced_decoder = layer_id >= 20
+        layer._l2pf_wo = None
+        layer._l2pf_comp = None
+        layer._attention_geometry()
+        layer._short_index_shape = None
+        layer.topk_indices_buffer = torch.full((128, 512), -9, dtype=torch.int32)
+        layer.INDEX_CHUNK = 64
+        layer.DECODE_CHUNK = 64
+        layer._index_pages = torch.full((64, 16), -1, dtype=torch.int32)
+        layer._active = torch.tensor([16 * 64], dtype=torch.int32)
+        if layer_id == 20:
+            layer._candidates = torch.full((128, 512), -9, dtype=torch.int32)
+            layer._candidate_lens = torch.full((128,), -9, dtype=torch.int32)
+        layer._ready = True
+        layer.swa_cache_layer = SimpleNamespace(prefix="swa")
+        layer.fused_wqa_wkv = lambda h: (torch.ones((h.shape[0], 16 + 512)), None)
+        layer._front = lambda qr_kv, pos: (
+            torch.arange(qr_kv.shape[0] * 16, dtype=torch.float32).view(qr_kv.shape[0], 16),
+            torch.zeros((qr_kv.shape[0], 512)),
+            MXFP8Rows(
+                torch.zeros((qr_kv.shape[0], 16)),
+                torch.arange(64 * 16, dtype=torch.uint8).view(64, 16),
+                torch.ones((64, 1), dtype=torch.uint8),
+            ),
+        )
+        layer.wq_b = lambda qr: torch.zeros((qr.shape[0], 2 * 512))
+        layer._rope = lambda x, pos, role: x
+        layer._prepare_global_kv = lambda pos, h: None
+        layer.indexer = SimpleNamespace(
+            heads=4,
+            k_cache=SimpleNamespace(prefix="idx"),
+            wq_b=lambda qr: torch.ones((qr.shape[0], 4 * 128)),
+            weights_proj=lambda h: torch.arange(
+                h.shape[0] * 4, dtype=torch.float32
+            ).view(h.shape[0], 4),
+        )
+        layer._quantize_index_query = (
+            lambda mode, iq, data, scale, positions=None: (
+                data.copy_(
+                    positions[:, None, None].to(torch.uint8).expand_as(data)
+                ),
+                scale.fill_(127),
+            )
+        )
+        layer._attention_scratch_specs = lambda mode, rows: {}
+        layer._alloc_scratch = lambda specs, stream=None: {}
+        layer._shared_decode_metadata = lambda *a, **kw: (torch.zeros(128, 1), torch.zeros(128), torch.zeros(128))
+        layer._attend = lambda *a, **kw: None
+        layer._check_attention_rows = lambda *a, **kw: None
+        layer._attend_split = lambda *a, **kw: None
+        layer._o_proj = lambda output, sp_rows=None: output.view(output.shape[0], -1)
+
+        def fake_index_chunk(
+            mode,
+            count,
+            *,
+            q_mxfp4,
+            q_scales,
+            query_weights,
+            page_table,
+            cache_lengths,
+            score_width,
+            output_indices,
+            candidate_output=None,
+            candidate_output_lengths=None,
+            candidate_indices=None,
+            candidate_lengths=None,
+        ):
+            base = q_mxfp4[:, 0, 0].to(torch.int32) * 1000 + page_table[:, 0]
+            output_indices[:] = base[:, None] + torch.arange(512, dtype=torch.int32)
+            if candidate_output is not None:
+                candidate_output[:] = base[:, None] + 7
+                candidate_output_lengths[:] = cache_lengths + 1
+            if candidate_indices is not None:
+                output_indices[:] += candidate_indices[:, :512] + candidate_lengths[:, None]
+
+        layer._index_chunk = fake_index_chunk
+        return layer
+
+    positions = torch.arange(10, 10 + rows, dtype=torch.int64)
+    hidden = torch.ones((rows, 32), dtype=torch.bfloat16)
+
+    # 1. Unsplit reference (tp_size=1) across layers 2, 8, 20, 26
+    ref_ctx_dict = {}
+    ref_layers = {
+        lid: make_layer(lid, 1, 0, ref_ctx_dict) for lid in (2, 8, 20, 26)
+    }
+    ref_fwd_ctx = SimpleNamespace(
+        attn_metadata={
+            "swa": SimpleNamespace(is_decode=True, num_decode_tokens=rows, decoder=None),
+            "idx": im,
+        }
+    )
+    monkeypatch.setattr(attention, "get_forward_context", lambda: ref_fwd_ctx)
+    for lid in (2, 8, 20, 26):
+        ref_layers[lid]._forward(positions, hidden)
+
+    # 2. Split across world_size ranks
+    rank_contexts = [{} for _ in range(world_size)]
+    rank_layers = [
+        {lid: make_layer(lid, world_size, r, rank_contexts[r]) for lid in (2, 8, 20, 26)}
+        for r in range(world_size)
+    ]
+    rank_fwd_ctxs = [
+        SimpleNamespace(
+            attn_metadata={
+                "swa": SimpleNamespace(is_decode=True, num_decode_tokens=rows, decoder=None),
+                "idx": im,
+            }
+        )
+        for _ in range(world_size)
+    ]
+
+    for lid in (2, 8, 20, 26):
+        pages_calls.clear()
+        staged_selected = {}
+
+        def record_gather(self_sp, x, _staged=staged_selected):
+            _staged[self_sp.rank] = x.clone()
+            return torch.zeros((self_sp.num_tokens, x.shape[1]), dtype=x.dtype)
+
+        monkeypatch.setattr(sp_prefill.SPRows, "gather", record_gather)
+        for r in range(world_size):
+            monkeypatch.setattr(
+                attention, "get_forward_context", lambda c=rank_fwd_ctxs[r]: c
+            )
+            rank_layers[r][lid]._forward(positions, hidden)
+
+        full_gathered = torch.cat(
+            [staged_selected[r] for r in range(world_size)], dim=0
+        )[:rows]
+        assert torch.equal(
+            full_gathered, ref_layers[lid].topk_indices_buffer[:rows]
+        ), f"layer {lid} gathered topk mismatch"
+        if lid == 8:
+            # Layer 8 reuses layer 2 cached decode page table on every rank with real rows.
+            assert pages_calls == []
