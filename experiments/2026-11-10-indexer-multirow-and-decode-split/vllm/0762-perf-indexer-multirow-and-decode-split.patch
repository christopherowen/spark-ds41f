+@pytest.mark.parametrize("rows", [1, 2, 3, 5, 6, 8])
+def test_indexer_dense_multirow_key_tile_reuse(rows, page_size=128, context=4096):
+    """Dense indexer pairs consecutive rows to reuse staged 64-key tiles when both
+    rows cover the full tile and map to the same physical page, while falling back
+    to per-row loads on partial tiles, odd trailing rows, and request boundaries
+    with 0-ULP score and top-k identity against single-row runs."""
+    inp = _index_inputs(rows, context, page_size, seed=rows + 77)
+    width = (context + page_size - 1) // page_size * page_size
+    # Share page table across pairs (0, 1) and (2, 3) when present, keep later rows distinct.
+    if rows >= 2:
+        inp["page_table"][1] = inp["page_table"][0]
+        inp["lengths"][0] = 3200
+        inp["lengths"][1] = 3205  # shares full 64-key tiles < 3200, differs in tail tile
+    if rows >= 4:
+        inp["page_table"][3] = inp["page_table"][2]
+        inp["lengths"][2] = 100
+        inp["lengths"][3] = 3900  # shares first tile [0, 64), diverges from tile 64 onward
+    plan = IndexerV41Plan(width, page_size)
+    names = (
+        "q_packed",
+        "q_scales",
+        "weights",
+        "pool",
+        "page_table",
+        "lengths",
+        "active",
+    )
+    out, scores = plan.run(*(inp[k] for k in names))
+    scores = scores.clone()
+    out = out.clone()
+    extent = _dense_extent(inp, width)
+    ref = _ref_scores(
+        inp, page_size, extent, lambda r: torch.arange(extent[r], device=DEVICE)
+    )
+    for r in range(rows):
+        assert torch.equal(scores[r, : extent[r]], ref[r]), f"row {r} scores differ from ref"
+        single_out, single_scores = plan.run(
+            inp["q_packed"][r : r + 1],
+            inp["q_scales"][r : r + 1],
+            inp["weights"][r : r + 1],
+            inp["pool"],
+            inp["page_table"][r : r + 1],
+            inp["lengths"][r : r + 1],
+            inp["active"],
+        )
+        assert torch.equal(
+            scores[r, : extent[r]], single_scores[0, : extent[r]]
+        ), f"row {r} scores differ from single-row run"
+        assert torch.equal(out[r], single_out[0]), f"row {r} topk differs from single-row run"
