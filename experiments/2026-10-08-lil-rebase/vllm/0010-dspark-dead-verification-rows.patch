 import numpy as np
 import torch
@@ -419,11 +419,20 @@ def _combine_sampled_and_draft_tokens_kernel(
     draft_tokens_stride,
     cu_num_logits_ptr,
     logits_indices_ptr,
+    confidence_ptr,
+    confidence_stride,
+    is_padding_ptr,
+    dead_cut_ptr,
+    log_tau,
     BLOCK_SIZE: tl.constexpr,
