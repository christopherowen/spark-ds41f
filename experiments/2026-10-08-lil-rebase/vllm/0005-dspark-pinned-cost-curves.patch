From f837a0cbf530f814b8adb0e892dff580c92cef7d Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Sat, 26 Sep 2026 23:09:28 +0200
Subject: [PATCH] feat(spec-decode): pin DSpark adaptive verification cost
 curves

Adaptive verification prices every draft budget from cost curves profiled
at startup (the median of five replays of each shape). Those curves move
from boot to boot, and with them the verified draft counts, so otherwise
identical boots differ by about 3% in throughput and A/B comparisons need
many boots. The profile is also slow: six rounds over every captured shape
and the eager sizes past the capture limit, 24 s of a 102 s boot on four
DGX Sparks.

With SPARK3_DSPARK_COST_DIR set, the curves of a shape set are pinned to a
file keyed by configuration alone: TP size, draft count, request and token
limits, capture limit, profile context length, and the shapes a profile
would time, named as its curves name them. Before profiling, TP rank 0
looks the key up and broadcasts what it finds, so every rank takes the
same path. With pinned curves the timed rounds are skipped, and the eager
shapes run once so their kernels compile before the first long prefill;
without them the boot profiles as before and rank 0 pins the result.
Unset, behavior is unchanged.

Tests: tests/v1/spec_decode/test_adaptive_verification.py (a pinned shape
set skips the profile; the key named before profiling is the one the
profiled curves imply; only rank 0 reads and writes).
---
 .../spec_decode/test_adaptive_verification.py | 117 +++++++++++++
 .../gpu/spec_decode/adaptive_verification.py  | 160 +++++++++++++++++-
 2 files changed, 274 insertions(+), 3 deletions(-)

diff --git a/tests/v1/spec_decode/test_adaptive_verification.py b/tests/v1/spec_decode/test_adaptive_verification.py
index 028e3540d..66ceee8fa 100644
--- a/tests/v1/spec_decode/test_adaptive_verification.py
+++ b/tests/v1/spec_decode/test_adaptive_verification.py
@@ -675,3 +675,120 @@ def test_budget_probes_after_steps_without_drafts():
         manager.get_num_tokens({"low": 3}, {"low": [1, 2]})
         budgets.append(manager._batch_budget[2])
     assert budgets == ([0] * (idle - 1) + [1]) * 2
+
+
+def _pinning_manager() -> AdaptiveVerificationManager:
+    manager = AdaptiveVerificationManager.__new__(AdaptiveVerificationManager)
+    manager.num_speculative_steps = 3
+    manager.req_states = SimpleNamespace(max_num_reqs=8, max_num_batched_tokens=64)
+    manager.curves = {}
+    manager.set_cost_curves = lambda draft, verify, **kwargs: manager.curves.update(
+        draft=draft, verify=verify, **kwargs
+    )
+    return manager
+
+
+def _tp_group(rank: int, answer=lambda value: value):
+    return SimpleNamespace(
+        rank_in_group=rank,
+        world_size=3,
+        broadcast_object=lambda value, src: answer(value),
+    )
+
+
+_CAPTURE_SIZES = [1, 2, 8]
+_FULL_SHAPES = [(1, 1), (2, 1), (8, 1), (8, 2)]
+
+
+def _profile(manager: AdaptiveVerificationManager, cost: float = 1.0):
+    """profile_costs on fake dummy runs; returns (shape, timed) per run."""
+    runs = []
+
+    class TimingCollector:
+        samples = None
+
+        @contextmanager
+        def collect(self):
+            self.samples = []
+            try:
+                yield self.samples
+            finally:
+                self.samples = None
+
+    timing = TimingCollector()
+
+    def run_dummy(num_tokens, context_len, profile_num_reqs=None):
+        runs.append(((num_tokens, profile_num_reqs), timing.samples is not None))
+        if timing.samples is not None:
+            num_reqs = profile_num_reqs or min(num_tokens, 8)
+            timing.samples.append(
+                StepTimingSample(
+                    cost * num_tokens,
+                    cost,
+                    num_tokens,
+                    num_reqs,
+                    full_cudagraph=profile_num_reqs is not None,
+                )
+            )
+
+    manager.profile_costs(run_dummy, timing, _CAPTURE_SIZES, _FULL_SHAPES)
+    return runs
+
+
+def test_pinned_cost_curves_skip_the_profile(monkeypatch, tmp_path):
+    monkeypatch.setattr(adaptive_module, "_COST_DIR", str(tmp_path))
+    monkeypatch.setattr(adaptive_module, "get_tp_group", lambda: _tp_group(0))
+    first = _pinning_manager()
+    runs = _profile(first)
+    assert any(timed for _, timed in runs)
+    assert len(list(tmp_path.glob("dspark-costs-*.json"))) == 1
+
+    # A later boot with the same shapes reads the first profile and times
+    # nothing; only the shapes past the capture limit run, once.
+    second = _pinning_manager()
+    runs = _profile(second, cost=9.0)
+    assert runs == [((n, None), False) for n in (12, 16, 32, 64)]
+    assert second.curves == first.curves
+
+    # Other shapes get their own profile and file.
+    third = _pinning_manager()
+    third.req_states.max_num_batched_tokens = 128
+    assert any(timed for _, timed in _profile(third))
+    assert len(list(tmp_path.glob("dspark-costs-*.json"))) == 2
+
+
+def test_pin_key_names_the_profiled_shapes(monkeypatch, tmp_path):
+    """The key computed before profiling is the one the curves imply, so
+    tables pinned from a profile keep matching."""
+    monkeypatch.setattr(adaptive_module, "_COST_DIR", str(tmp_path))
+    monkeypatch.setattr(adaptive_module, "get_tp_group", lambda: _tp_group(0))
+    manager = _pinning_manager()
+    _profile(manager)
+    key = manager._pin_key(_CAPTURE_SIZES, _FULL_SHAPES)
+    curves = manager.curves
+    assert key["draft_sizes"] == [x for x, _ in curves["draft"]]
+    assert key["verify_sizes"] == [x for x, _ in curves["verify"]]
+    assert key["full_shapes"] == {
+        str(n): [x for x, _ in curve]
+        for n, curve in sorted(curves["verify_curves_by_num_reqs"].items())
+    }
+
+
+def test_pinned_cost_curves_only_from_rank_zero(monkeypatch, tmp_path):
+    monkeypatch.setattr(adaptive_module, "_COST_DIR", str(tmp_path))
+    # Without rank 0's curves, rank 1 profiles but never writes.
+    monkeypatch.setattr(
+        adaptive_module, "get_tp_group", lambda: _tp_group(1, lambda value: None)
+    )
+    assert any(timed for _, timed in _profile(_pinning_manager()))
+    assert not list(tmp_path.iterdir())
+
+    # With them, it skips the profile like rank 0, whatever it holds itself.
+    pinned = ([[1, 2.0]], [[4, 40.0]], {"1": [[4, 40.0]]})
+    monkeypatch.setattr(
+        adaptive_module, "get_tp_group", lambda: _tp_group(1, lambda value: pinned)
+    )
+    manager = _pinning_manager()
+    assert not any(timed for _, timed in _profile(manager))
+    assert manager.curves["draft"] == [(1, 2.0)]
+    assert manager.curves["verify_curves_by_num_reqs"] == {1: [(4, 40.0)]}
diff --git a/vllm/v1/worker/gpu/spec_decode/adaptive_verification.py b/vllm/v1/worker/gpu/spec_decode/adaptive_verification.py
index af15b9742..15ac44632 100644
--- a/vllm/v1/worker/gpu/spec_decode/adaptive_verification.py
+++ b/vllm/v1/worker/gpu/spec_decode/adaptive_verification.py
@@ -2,6 +2,9 @@
 # SPDX-FileCopyrightText: Copyright contributors to the vLLM project
 """Adaptive verification for DSpark speculative decoding."""
 
+import hashlib
+import json
+import os
 from collections import defaultdict
 from collections.abc import Callable, Iterable, Iterator, Mapping
 from typing import TYPE_CHECKING
@@ -25,6 +28,10 @@ from vllm.v1.worker.gpu.attn_utils import (
 
 logger = init_logger(__name__)
 _PROFILE_REPLAYS = 5
+# Directory of pinned cost curves: rank 0 saves the first profile of a shape
+# set, and later boots with the same shapes read it instead of profiling, so
+# the draft budget does not depend on one boot's startup timing noise.
+_COST_DIR = os.environ.get("SPARK3_DSPARK_COST_DIR") or None
 
 if TYPE_CHECKING:
     from vllm.config import VllmConfig
@@ -251,7 +258,25 @@ class AdaptiveVerificationManager:
         capture_sizes: list[int],
         full_batch_shapes: list[tuple[int, int]],
     ) -> None:
-        """Warm every shape, then sample rounds to limit startup/order bias."""
+        """Price the shapes from pinned curves, or profile them.
+
+        A profile warms every shape, then samples rounds to limit startup and
+        order bias. Pinned curves for the shape set skip it; the shapes past
+        the capture limit, which run without graphs, still run once so their
+        kernels compile before the first long prefill does.
+        """
+        key = self._pin_key(capture_sizes, full_batch_shapes)
+        pinned = self._load_pinned_curves(key)
+        if pinned is not None:
+            for batch in self.batches_to_profile(capture_sizes, [], replays=1):
+                run_dummy(**batch)
+            draft_curve, verify_curve, verify_curves_by_num_reqs = pinned
+            self.set_cost_curves(
+                draft_curve,
+                verify_curve,
+                verify_curves_by_num_reqs=verify_curves_by_num_reqs,
+            )
+            return
         for batch in self.batches_to_profile(
             capture_sizes, full_batch_shapes, replays=1
         ):
@@ -259,9 +284,11 @@ class AdaptiveVerificationManager:
         with step_timing.collect() as timings:
             for batch in self.batches_to_profile(capture_sizes, full_batch_shapes):
                 run_dummy(**batch)
-        self.set_initial_cost_curves(timings)
+        self.set_initial_cost_curves(timings, pin_key=key)
 
-    def set_initial_cost_curves(self, samples: list[StepTimingSample]) -> None:
+    def set_initial_cost_curves(
+        self, samples: list[StepTimingSample], pin_key: dict | None = None
+    ) -> None:
         def median_curve(
             points: Iterable[tuple[int, float]],
         ) -> list[tuple[int, float]]:
@@ -288,12 +315,139 @@ class AdaptiveVerificationManager:
             )
             for num_reqs in sorted({s.num_reqs for s in samples if s.full_cudagraph})
         }
+        if pin_key is not None:
+            self._save_pinned_curves(
+                pin_key, draft_curve, verify_curve, verify_curves_by_num_reqs
+            )
         self.set_cost_curves(
             draft_curve,
             verify_curve,
             verify_curves_by_num_reqs=verify_curves_by_num_reqs,
         )
 
+    def _pin_key(
+        self,
+        capture_sizes: list[int],
+        full_batch_shapes: list[tuple[int, int]],
+    ) -> dict | None:
+        """The pinned-curve key of a shape set, or None without a cost directory.
+
+        Configuration only, so a boot looks its curves up before profiling:
+        TP size, draft count, request and token limits, capture limit, profile
+        context length, and the shapes a profile would time, listed as its
+        curves list them (drafter by FULL graph request count, verification by
+        token count, FULL graph token counts by request count).
+        """
+        if _COST_DIR is None or not full_batch_shapes:
+            return None
+        tokens_by_num_reqs: defaultdict[int, list[int]] = defaultdict(list)
+        for num_tokens, num_reqs in sorted(full_batch_shapes):
+            tokens_by_num_reqs[num_reqs].append(num_tokens)
+        max_num_tokens = self.req_states.max_num_batched_tokens
+        tail = preparation_tail_sizes(capture_sizes, max_num_tokens)
+        return {
+            "tp": get_tp_group().world_size,
+            "num_speculative_steps": self.num_speculative_steps,
+            "max_num_reqs": self.req_states.max_num_reqs,
+            "max_num_batched_tokens": max_num_tokens,
+            "cudagraph_limit": capture_sizes[-1] if capture_sizes else 0,
+            "profile_context_len": envs.VLLM_ADAPTIVE_VERIFICATION_PROFILE_CONTEXT_LEN,
+            "draft_sizes": sorted(tokens_by_num_reqs),
+            "verify_sizes": sorted({n for n, _ in full_batch_shapes} | set(tail)),
+            "full_shapes": {
+                str(n): tokens for n, tokens in sorted(tokens_by_num_reqs.items())
+            },
+        }
+
+    @staticmethod
+    def _pin_path(key: dict) -> str:
+        assert _COST_DIR is not None
+        digest = hashlib.sha256(json.dumps(key, sort_keys=True).encode()).hexdigest()
+        return os.path.join(_COST_DIR, f"dspark-costs-{digest[:16]}.json")
+
+    def _load_pinned_curves(
+        self, key: dict | None
+    ) -> (
+        tuple[
+            list[tuple[int, float]],
+            list[tuple[int, float]],
+            dict[int, list[tuple[int, float]]],
+        ]
+        | None
+    ):
+        """Rank 0's pinned curves for this key, or None to profile.
+
+        Rank 0 reads the file and broadcasts the answer, so every rank either
+        profiles or skips the profile, and their collectives match.
+        """
+        if key is None:
+            return None
+        tp_group = get_tp_group()
+        pinned = None
+        if tp_group.rank_in_group == 0:
+            path = self._pin_path(key)
+            if os.path.exists(path):
+                with open(path) as f:
+                    saved = json.load(f)
+                if saved.get("key") == key:
+                    logger.info("Using pinned DSpark cost curves from %s", path)
+                    pinned = (
+                        saved["draft_curve"],
+                        saved["verify_curve"],
+                        saved["verify_curves_by_num_reqs"],
+                    )
+                else:
+                    logger.warning(
+                        "Ignoring pinned DSpark cost curves with another key: %s", path
+                    )
+        pinned = tp_group.broadcast_object(pinned, src=0)
+        if pinned is None:
+            return None
+        draft_curve, verify_curve, verify_curves_by_num_reqs = pinned
+        return (
+            [tuple(p) for p in draft_curve],
+            [tuple(p) for p in verify_curve],
+            {
+                int(n): [tuple(p) for p in curve]
+                for n, curve in verify_curves_by_num_reqs.items()
+            },
+        )
+
+    def _save_pinned_curves(
+        self,
+        key: dict,
+        draft_curve: list[tuple[int, float]],
+        verify_curve: list[tuple[int, float]],
+        verify_curves_by_num_reqs: Mapping[int, list[tuple[int, float]]],
+    ) -> None:
+        """Pin rank 0's profile for later boots with the same shape set."""
+        if get_tp_group().rank_in_group != 0:
+            return
+
+        def plain(curve: list[tuple[int, float]]) -> list[list[int | float]]:
+            return [[int(x), float(y)] for x, y in curve]
+
+        path = self._pin_path(key)
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        tmp = f"{path}.{os.getpid()}.tmp"
+        with open(tmp, "w") as f:
+            json.dump(
+                {
+                    "key": key,
+                    "profile_replays": _PROFILE_REPLAYS,
+                    "draft_curve": plain(draft_curve),
+                    "verify_curve": plain(verify_curve),
+                    "verify_curves_by_num_reqs": {
+                        str(n): plain(curve)
+                        for n, curve in verify_curves_by_num_reqs.items()
+                    },
+                },
+                f,
+                indent=1,
+            )
+        os.replace(tmp, path)
+        logger.info("Pinned DSpark cost curves to %s", path)
+
     def set_cost_curves(
         self,
         draft_curve: list[tuple[int, float]],
