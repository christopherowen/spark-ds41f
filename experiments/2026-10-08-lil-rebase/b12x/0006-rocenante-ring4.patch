+def test_ring4_routes_only_neighbours(rank, width):
+    peers = ((rank - 1) % 4, (rank + 1) % 4)
+    routes = {p: tuple(f"hca{p}_{i}" for i in range(width)) for p in peers}
+    names, resolved, stripes = _resolve_hca_topology(
