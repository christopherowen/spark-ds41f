@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+"""CPU protocol stress of the production C proxy; does not qualify GPU/RDMA."""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parent
+with tempfile.TemporaryDirectory(prefix="roce-proxy-") as tmp:
+    binary = str(Path(tmp) / "simulate")
+    subprocess.run([os.environ.get("CC", "cc"), "-O1", "-g", "-std=gnu11",
+                    "-Wall", "-Wextra", "-Werror", "-fsanitize=address,undefined",
+                    "-pthread", "-I" + str(root), str(root / "simulate.c"), "-o", binary],
+                   check=True, timeout=60)
+    subprocess.run([binary], check=True, timeout=60)
+
+# Execute the production topology resolver in isolation on CPU-only builders.
+# Its normal module imports CUDA components unrelated to topology validation.
+import ast
+import json
+import typing
+source = root.parents[2] / "b12x/comm/roce/roce_oneshot.py"
+tree = ast.parse(source.read_text())
+functions = [node for node in tree.body if isinstance(node, ast.FunctionDef)
+             and node.name in ("_resolve_hca_topology", "_peer_hca_names_from_env")]
+namespace = dict(vars(typing), os=os, json=json, MAX_STRIPES=2, MAX_LOCAL_HCAS=4)
+exec(compile(ast.Module(body=functions, type_ignores=[]), str(source), "exec"), namespace)
+resolve = namespace["_resolve_hca_topology"]
+os.environ.pop("B12X_ROCE_PEER_HCAS", None)
+for rank in range(4):
+    for width in (1, 2):
+        peers = ((rank - 1) % 4, (rank + 1) % 4)
+        routes = {p: tuple(f"hca{p}_{i}" for i in range(width)) for p in peers}
+        names, result, stripes = resolve(world_size=4, rank=rank, hca_names=None,
+            peer_hca_names=routes, gid_index=3, topology="ring4")
+        assert len(names) == 2 * width and stripes == width
+        assert result[rank] == result[(rank + 2) % 4] == ()
+        assert {p: result[p] for p in peers} == routes
+for world, routes in ((3, {1:("a",), 2:("b",)}), (4, None),
+                       (4, {1:("a",), 2:("b",), 3:("c",)})):
+    try:
+        resolve(world_size=world, rank=0, hca_names=("a", "b"),
+                peer_hca_names=routes, gid_index=3, topology="ring4")
+    except ValueError:
+        pass
+    else:
+        raise AssertionError("invalid ring4 geometry accepted")
+print("PASS: Python neighbour routing and geometry rejection")
