+
+# Exercise the actual constructor/cache-key code without importing CUDA. The
+# C simulator above represents the GPU endpoint; these checks tie its flag
+# geometry to BOTH device launchers and prevent a stale prepared kernel reuse.
+import types
+for module, class_name in (("_oneshot_cute.py", "_RoceOneshotLaunch"),
+                           ("_allgather_cute.py", "_RoceAllGatherLaunch")):
+    source = root.parents[2] / "b12x/comm/roce" / module
+    tree = ast.parse(source.read_text())
+    cls = next(n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == class_name)
+    kernel = next(n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name == "kernel")
+    cls.body = [n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name == "__init__"]
+    key = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == "_process_key")
+    namespace = {"_DTYPE_PACK_ELEMS": {"bfloat16": 8}}
+    exec(compile(ast.Module(body=[cls, key], type_ignores=[]), str(source), "exec"), namespace)
+    prefix = ("bfloat16",) if module == "_oneshot_cute.py" else ()
+    for width in (1, 2):
+        for rank in range(4):
+            args = prefix + (4, rank, 128, 2, 64, width)
+            launch = namespace[class_name](*args, True)
+            assert launch._hca_count == 2 * width and launch._neighbor_lanes == width
+            assert namespace["_process_key"](*args, 0, True) != namespace["_process_key"](*args, 0, False)
+            # Execute the kernel's actual active-flag selection, preserving
+            # its expressions rather than duplicating them in a simulator.
+            wait = next(n for n in ast.walk(kernel) if isinstance(n, ast.If)
