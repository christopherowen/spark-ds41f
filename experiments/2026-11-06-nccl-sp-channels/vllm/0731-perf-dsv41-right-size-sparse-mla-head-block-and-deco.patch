--- a/tests/kernels/attention/test_deepseek_v41_tilelang.py
+++ b/tests/kernels/attention/test_deepseek_v41_tilelang.py
@@ -1220,9 +1220,9 @@ def _wo_input_kernel(heads: int, block_heads: int, threads: int):
     return kernel
 
 
-# The extend kernel's head block (32 heads, 256 threads) and the decode merge's (one
-# head, 128 threads).
-@pytest.mark.parametrize(("block_heads", "threads"), [(32, 256), (1, 128)])
+# The extend kernel's head blocks (16 heads / 128 threads, 32 heads / 256 threads)
+# and the decode merge's (one head, 128 threads).
+@pytest.mark.parametrize(("block_heads", "threads"), [(16, 128), (32, 256), (1, 128)])
 def test_wo_input_is_the_reference_rotation_and_act_quant(block_heads, threads):
     """The sparse MLA's output store gives WO-A's input bit for bit as the reference
     prepares it: TileKernels' inverse rotation in BF16, then per_token_cast's values
@@ -1244,3 +1244,45 @@ def test_wo_input_is_the_reference_rotation_and_act_quant(block_heads, threads):
     want = wo_input_reference(o, positions, table)
     differ = int((out.view(torch.int16) != want.view(torch.int16)).sum())
     assert differ == 0, f"{differ} of {out.numel()} values differ from the reference"
+
+
+def test_sparse_mla_plan_routes_right_sizes_head_block_and_decode_waves(monkeypatch):
+    """16-head ranks (TP3 rank 2 and TP4) use a 16-head, 128-thread block in extend
+    and decode instead of padding to 32 heads / 256 threads, and multi-segment layers
+    keep segment-split decode until unsplit extend fills one wave of SMs."""
+    from types import SimpleNamespace
+
+    monkeypatch.setattr(
+        torch.cuda,
+        "get_device_properties",
+        lambda _device: SimpleNamespace(multi_processor_count=48),
+    )
+    r16 = SparseMlaV41Plan.routes(16, 128, 512, 128, swa_page_size=128, max_rows=2048)
+    assert r16.segments == 5
+    assert r16.split_max_rows == 9
+    assert r16.decode_max_rows == 48
+    assert r16.kernels["extend"][2]["block_H"] == 16
+    assert r16.kernels["extend"][2]["threads"] == 128
+    assert r16.kernels["decode"][2]["block_H"] == 16
+    assert r16.kernels["decode"][2]["threads"] == 128
+    assert r16.kernels["decode"][2].get("skip_inactive", True) is True
+    assert r16.kernels["split"][2]["block_H"] == 16
+    assert r16.kernels["split"][2]["threads"] == 128
+    assert r16.kernels["split"][2]["skip_inactive"] is False
+
+    r24 = SparseMlaV41Plan.routes(24, 128, 512, 128, swa_page_size=128, max_rows=2048)
+    assert r24.segments == 5
+    assert r24.split_max_rows == 4
+    assert r24.decode_max_rows == 48
+    assert r24.kernels["extend"][2]["block_H"] == 32
+    assert r24.kernels["extend"][2]["threads"] == 256
+    assert r24.kernels["decode"][2]["block_H"] == 32
+    assert r24.kernels["decode"][2]["threads"] == 256
+    assert r24.kernels["split"][2]["block_H"] == 16
+    assert r24.kernels["split"][2]["threads"] == 128
+    assert r24.kernels["split"][2]["skip_inactive"] is False
+
+    swa24 = SparseMlaV41Plan.routes(24, 128, 0, 128, swa_page_size=128, max_rows=2048)
+    assert swa24.segments == 1
+    assert swa24.split_max_rows == 24
+    assert swa24.decode_max_rows == 144
