@@ -28,6 +28,11 @@ class InputBuffers:
         self.device = device
 
         self.input_ids = torch.zeros(max_num_tokens, dtype=torch.int32, device=device)
+        # Token ids the next dummy batches take for their first rows (int32, on
+        # the device), which are then real rows rather than padding; None (the
+        # default): every dummy row is token 0 and padding. Set only by the engine
+        # grid, so its steps route the MoE as text does.
+        self.dummy_input_ids: torch.Tensor | None = None
         self.positions = torch.zeros(max_num_tokens, dtype=torch.int64, device=device)
         self.is_padding = torch.zeros(max_num_tokens, dtype=torch.bool, device=device)
         self.logits_indices = torch.zeros(
@@ -258,6 +263,13 @@ class InputBatch:
         positions = input_buffers.positions[:num_tokens].zero_()
 
         input_buffers.is_padding[:num_tokens].fill_(True)
+        given = input_buffers.dummy_input_ids
+        if given is not None:
+            # The engine grid's rows: its token ids, routed as real rows. Rows past
+            # them (a CUDA graph's padding) stay token 0 and padding, as in serving.
+            live = min(int(given.numel()), num_tokens)
+            input_ids[:live].copy_(given[:live])
+            input_buffers.is_padding[:live].fill_(False)
         is_padding = input_buffers.is_padding[:num_tokens]
 
         # int64, as a real step's: the dummy runs the kernels serving runs.
