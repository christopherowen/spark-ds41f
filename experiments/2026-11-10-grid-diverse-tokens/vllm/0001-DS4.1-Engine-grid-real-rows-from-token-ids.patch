+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import pytest
+import torch
+
+from vllm.v1.worker.gpu.input_batch import InputBatch, InputBuffers
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA")
+def test_dummy_batches_take_the_engine_grids_token_ids_as_real_rows():
+    buffers = InputBuffers(max_num_reqs=4, max_num_tokens=16, device=torch.device("cuda"))
+    buffers.input_ids.fill_(7)
+    batch = InputBatch.make_dummy(2, 8, buffers)
+    assert batch.input_ids.cpu().tolist() == [0] * 8
+    assert bool(batch.is_padding.all())
+
+    # Six ids for an eight-row batch: the two rows past them pad it, as a CUDA
+    # graph's padding rows do in serving.
+    buffers.dummy_input_ids = torch.arange(100, 106, dtype=torch.int32, device="cuda")
+    batch = InputBatch.make_dummy(2, 8, buffers)
+    assert batch.input_ids.cpu().tolist() == [100, 101, 102, 103, 104, 105, 0, 0]
+    assert batch.is_padding.cpu().tolist() == [False] * 6 + [True] * 2
+
+    buffers.dummy_input_ids = None
+    batch = InputBatch.make_dummy(2, 8, buffers)
+    assert batch.input_ids.cpu().tolist() == [0] * 8
+    assert bool(batch.is_padding.all())
diff --git a/vllm/v1/worker/gpu/input_batch.py b/vllm/v1/worker/gpu/input_batch.py
