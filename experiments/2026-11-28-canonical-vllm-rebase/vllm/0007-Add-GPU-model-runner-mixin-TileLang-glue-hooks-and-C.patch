+    def attach_copy_draft_alloc(
+        self,
+        copy_draft_alloc: Any,
+        copy_stream: torch.Stream,
+        main_stream: torch.Stream,
+        *,
+        num_reqs: int | None = None,
+        alloc_event: torch.Event | None = None,
+    ) -> None:
+        self.copy_draft_alloc_event = (
+            alloc_event if alloc_event is not None else torch.Event(blocking=True)
+        )
+        if hasattr(copy_draft_alloc, "copy_to_cpu"):
+            n = copy_draft_alloc.gpu.shape[0] if num_reqs is None else num_reqs
+            self.copy_draft_alloc = copy_draft_alloc.gpu[:n]
+            with stream(copy_stream, main_stream):
+                copy_stream.wait_stream(main_stream)
+                copy_draft_alloc.copy_to_cpu(n)
+                self.copy_draft_alloc_np = copy_draft_alloc.np[:n]
+                self.copy_draft_alloc_event.record(copy_stream)
+            return
+        self.copy_draft_alloc = copy_draft_alloc.clone()
+        with stream(copy_stream, main_stream):
+            copy_stream.wait_stream(main_stream)
+            self.copy_draft_alloc_np = async_copy_to_np(self.copy_draft_alloc)
+            self.copy_draft_alloc_event.record(copy_stream)
+
