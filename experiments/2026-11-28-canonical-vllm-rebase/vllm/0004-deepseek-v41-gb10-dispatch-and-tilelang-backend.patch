From 3a07105d49e203dddbf569c3d5aa66223ff1bec7 Mon Sep 17 00:00:00 2001
From: Christopher Owen <christopherowen@users.noreply.github.com>
Date: Sat, 28 Nov 2026 08:28:49 +0100
Subject: [PATCH] models: wire GB10 spark_ds41 dispatch, TILELANG attention
 backend, and packed BF16 head

---
 .../model_executor/layers/logits_processor.py | 20 ++++
 vllm/models/deepseek_v41/__init__.py          | 16 +++
 vllm/v1/attention/backends/registry.py        |  1 +
 vllm/v1/kv_cache_interface.py                 | 99 +++++++++++++++++++
 vllm/v1/worker/gpu/cudagraph_utils.py         | 56 +++++++++++
 5 files changed, 192 insertions(+)

diff --git a/vllm/model_executor/layers/logits_processor.py b/vllm/model_executor/layers/logits_processor.py
index 4be952a4d773d0ccadddf1a7d5424b2424612624..eb97226b3b6199ddbb4f581f11f7e924584bf647 100644
--- a/vllm/model_executor/layers/logits_processor.py
+++ b/vllm/model_executor/layers/logits_processor.py
@@ -336,3 +336,23 @@ class LogitsProcessor(PluggableLayer):
         s += f", org_vocab_size={self.org_vocab_size}"
         s += f", scale={self.scale}, logits_as_input={self.logits_as_input}"
         return s
+
+
+def _is_packed_head(head: torch.nn.Module) -> bool:
+    from spark_ds41.worker.packed_bf16 import PackedBf16LmHeadMethod
+
+    return isinstance(getattr(head, "quant_method", None), PackedBf16LmHeadMethod)
+
+
+def _is_plain_bf16_head(head: torch.nn.Module) -> bool:
+    """A loaded, unquantized, contiguous BF16 vocabulary head on the GPU."""
+    return (
+        isinstance(head, VocabParallelEmbedding)
+        and isinstance(
+            head.quant_method, (UnquantizedEmbeddingMethod, UnquantizedLinearMethod)
+        )
+        and head.weight.ndim == 2
+        and head.weight.dtype == torch.bfloat16
+        and head.weight.is_cuda
+        and head.weight.is_contiguous()
+    )
diff --git a/vllm/models/deepseek_v41/__init__.py b/vllm/models/deepseek_v41/__init__.py
index b69e1c6dcdd8e85a2cef78c751a44ee0738bc201..1ebfbd3bb8307943f2ee519eb52f9e55784ab63f 100644
--- a/vllm/models/deepseek_v41/__init__.py
+++ b/vllm/models/deepseek_v41/__init__.py
@@ -2,13 +2,29 @@
 # SPDX-FileCopyrightText: Copyright contributors to the vLLM project
 """DeepSeek V4.1 hardware-isolated model entry point."""
 
+import importlib.util
+
+import torch
+
 from vllm.platforms import current_platform
 
 from .quant_config import DeepseekV4FP8Config
 
+
+def _use_spark_tilelang() -> bool:
+    if not current_platform.is_cuda():
+        return False
+    if importlib.util.find_spec("spark_ds41") is None:
+        return False
+    return torch.cuda.is_available() and torch.cuda.get_device_capability() == (12, 1)
+
+
 if current_platform.is_rocm():
     from .amd.dspark import DSparkDeepseekV4ForCausalLM
     from .amd.vl_model import DeepseekV41ForCausalLM
+elif _use_spark_tilelang():
+    from spark_ds41.model.dspark import DSparkDeepseekV4ForCausalLM
+    from spark_ds41.model.vl_model import DeepseekV41ForCausalLM
 else:
     from .nvidia.dspark import DSparkDeepseekV4ForCausalLM
     from .nvidia.vl_model import DeepseekV41ForCausalLM
