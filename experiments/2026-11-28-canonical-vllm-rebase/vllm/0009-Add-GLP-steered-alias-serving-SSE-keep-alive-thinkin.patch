 import asyncio
 import contextlib
+import math
+import os
 from collections.abc import AsyncGenerator
+from typing import Any
 
 SSE_KEEP_ALIVE_COMMENT = ": keep-alive\n\n"
+DEFAULT_SSE_KEEP_ALIVE_INTERVAL_S = 15.0
+
+
+def get_sse_keep_alive_interval(
+    raw_request: Any = None,
+    default: float = DEFAULT_SSE_KEEP_ALIVE_INTERVAL_S,
+) -> float:
+    for env_name in ("VLLM_SSE_KEEPALIVE_INTERVAL_S", "VLLM_SSE_KEEPALIVE_INTERVAL"):
+        env_val = os.environ.get(env_name)
+        if env_val is not None and env_val.strip() != "":
+            try:
+                val = float(env_val)
+            except ValueError:
+                return 0.0
+            return val if 0.0 < val < float("inf") else 0.0
+
+    app = getattr(raw_request, "app", None)
+    state = getattr(app, "state", None)
+    args = getattr(state, "args", None)
+    if args is not None:
+        if getattr(args, "sse_keep_alive_disabled", False):
+            return 0.0
+        arg_val = getattr(args, "sse_keep_alive_interval", None)
+        if arg_val is not None:
+            try:
+                val = float(arg_val)
+            except (TypeError, ValueError):
+                val = 0.0
+            if 0.0 < val < float("inf"):
+                return val
+            if val < 0.0:
+                return 0.0
+
+    return default if 0.0 < default < float("inf") and math.isfinite(default) else 0.0
 
 
 def with_sse_keep_alive(
     generator: AsyncGenerator[str, None],
-    interval: float,
+    interval: float = DEFAULT_SSE_KEEP_ALIVE_INTERVAL_S,
 ) -> AsyncGenerator[str, None]:
     """Emit an SSE keep-alive comment when `generator` is idle.
 
