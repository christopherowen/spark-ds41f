@@ -153,6 +153,7 @@ class SharedExperts(torch.nn.Module):
         assert self._stream is not None
         idx = self._output_idx
         assert self._output[idx] is None
+        shared_experts_input.record_stream(self._stream)
         self._input_ready_event[idx].record(current_stream())
         with torch.cuda.stream(self._stream):
             self._input_ready_event[idx].wait(self._stream)
@@ -164,6 +165,20 @@ class SharedExperts(torch.nn.Module):
         """Block the main stream until `maybe_forward_async` output is ready."""
         assert self._stream is not None
         self._output_ready_event[self._output_idx].wait(current_stream())
+        output = self._output[self._output_idx]
+        if output is not None:
+            output.record_stream(current_stream())
+
+    def peek_output(self) -> torch.Tensor | None:
+        """The finished output, left in place for `output` to take."""
+        return self._output[self._output_idx]
+
+    def wait_output(self) -> torch.Tensor:
+        """`wait`, then the finished output, left in place for `output`."""
+        self.wait()
+        output = self.peek_output()
+        assert output is not None
+        return output
 
     @property
     def _output_idx(self) -> int:
