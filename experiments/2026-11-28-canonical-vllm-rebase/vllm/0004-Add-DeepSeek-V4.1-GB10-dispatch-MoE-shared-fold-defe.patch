+    def _spark_fused_experts(self):
+        moe_kernel = getattr(self._quant_method, "moe_kernel", None)
+        if moe_kernel is None:
+            return None
+        impl = getattr(moe_kernel, "impl", moe_kernel)
+        return getattr(impl, "fused_experts", None)
+
+    def _shared_output_fold(
+        self, shared_experts_input: torch.Tensor | None
+    ):
+        if (
+            self._shared_experts is None
+            or shared_experts_input is None
+            or self._fused_output_is_reduced
+            or getattr(self.routed_output_transform, "accumulates_residual", False)
+            or self.routed_output_transform is not None
+        ):
+            return None
+        experts = self._spark_fused_experts()
+        if experts is None or not getattr(experts, "folds_shared_output", False):
+            return None
+        order = self._shared_experts._determine_shared_experts_order(
+            shared_experts_input
+        )
+        if order == SharedExpertsOrder.MULTI_STREAM_OVERLAPPED:
+            supported = getattr(experts, "folds_deferred_shared_output", False)
+        else:
+            supported = order == SharedExpertsOrder.NO_OVERLAP
+        return experts if supported else None
+
+    def _reduce_scatter_final_output(
+        self,
+        shared_output: torch.Tensor | None,
+        fused_output: torch.Tensor,
+        padded_rows: int,
+        trunc_size: int | None,
+        output_is_reduced: bool,
+        combine=None,
+    ) -> torch.Tensor:
+        if (
+            output_is_reduced
+            or self.moe_config.is_sequence_parallel
+            or self.moe_config.skip_final_all_reduce
+            or isinstance(self.router, ZeroExpertRouter)
+        ):
+            raise NotImplementedError("MoE reduce-scatter needs an unreduced output")
+        rows = fused_output.shape[0]
+        if combine is not None and self.moe_config.tp_size > 1:
+            from vllm.distributed.communication_op import tensor_model_parallel_reduce_scatter
+            tp = self.moe_config.tp_size
+            shard = padded_rows // tp
+            states = torch.zeros(
+                (padded_rows, fused_output.shape[-1]),
+                dtype=self.moe_config.in_dtype,
+                device=fused_output.device,
+            )
+            combine(0, rows, states[:rows])
+            if trunc_size is not None:
+                states = states[..., :trunc_size]
+            return tensor_model_parallel_reduce_scatter(states, dim=0)
+        states = torch.zeros(
+            (padded_rows, fused_output.shape[-1]),
+            dtype=self.moe_config.in_dtype,
+            device=fused_output.device,
+        )
+        if shared_output is None:
+            states[:rows].copy_(fused_output)
+        else:
+            torch.add(shared_output, fused_output, out=states[:rows])
+        if trunc_size is not None:
+            states = states[..., :trunc_size]
+        if self.moe_config.tp_size == 1:
+            return states
+        from vllm.distributed.communication_op import tensor_model_parallel_reduce_scatter
+        return tensor_model_parallel_reduce_scatter(states, dim=0)
+
     def forward(
