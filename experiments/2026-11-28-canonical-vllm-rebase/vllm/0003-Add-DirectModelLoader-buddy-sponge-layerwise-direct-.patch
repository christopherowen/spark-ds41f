diff --git a/vllm/v1/utils.py b/vllm/v1/utils.py
index b28681a..4cda291 100644
--- a/vllm/v1/utils.py
+++ b/vllm/v1/utils.py
@@ -108,6 +108,27 @@ class ConstantList(Generic[T], Sequence):
         return self._x.copy()
 
 
+
+_LIBC_MLOCK = None
+
+
+def mlock_memory(addr: int, nbytes: int) -> bool:
+    global _LIBC_MLOCK
+    if _LIBC_MLOCK is False:
+        return False
+    if _LIBC_MLOCK is None:
+        try:
+            import ctypes
+            libc = ctypes.CDLL(None, use_errno=True)
+            libc.mlock.argtypes = [ctypes.c_void_p, ctypes.c_size_t]
+            libc.mlock.restype = ctypes.c_int
+            _LIBC_MLOCK = libc.mlock
+        except Exception:
+            _LIBC_MLOCK = False
+            return False
+    return _LIBC_MLOCK(addr, nbytes) == 0
+
+
 class CpuGpuBuffer:
     """Buffer to easily copy tensors between CPU and GPU."""
 
