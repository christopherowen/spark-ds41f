+    def all_reduce_in_place(self, input_: torch.Tensor) -> torch.Tensor:
+        """Use NCCL's aliasing contract for a caller-donated intermediate."""
+        if self._roce_policy:
+            # The policy reduces with the one-shot runtime or the rank-order
+            # exchange. NCCL's in-place ring adds in another order, and no model
+            # served on this policy reduces in place.
+            raise RuntimeError("RoCEnante policy has no in-place all-reduce")
+        pynccl_comm = self.pynccl_comm
+        if (
+            pynccl_comm is None
+            or pynccl_comm.disabled
+            or pynccl_comm.all_reduce(input_, out_tensor=input_) is None
+        ):
+            torch.distributed.all_reduce(input_, group=self.device_group)
+        return input_
+
+    def all_to_all_rows(self, input_: torch.Tensor, rows: int) -> torch.Tensor:
+        """Row blocks of ``rows``: block r goes to rank r; the output's [s] holds
+        rank s's block (rows past this rank's real rows unwritten)."""
+        self._require_roce_policy()
+        b12x_ar_comm = self.b12x_ar_comm
+        should_a2a = getattr(b12x_ar_comm, "should_all_to_all_rows", None)
+        a2a = getattr(b12x_ar_comm, "all_to_all_rows", None)
+        if (
+            b12x_ar_comm is not None
+            and not b12x_ar_comm.disabled
+            and should_a2a is not None
+            and should_a2a(input_, rows)
+        ):
+            assert a2a is not None
+            return a2a(input_, rows)
+        pynccl_comm = self.pynccl_comm
+        if pynccl_comm is None or pynccl_comm.disabled:
+            raise RuntimeError("all_to_all_rows needs the PyNCCL communicator")
+        input_ = input_.contiguous()
+        output = input_.new_empty((self.world_size, rows, *input_.shape[1:]))
+        pynccl_comm.all_to_all_rows(output, input_, rows)
+        return output
