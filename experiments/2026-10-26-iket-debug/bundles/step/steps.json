[
 [
  "decode steps, on, under run-iket",
  [
   "run-iket",
   "--context-buffer-size",
   "8G",
   "--output-dir",
   "{out}/trace",
   "profile",
   "--postprocess",
   "all",
   "--",
   "{python}",
   "/b/iket_step.py",
   "on",
   "--iket",
   "{out}/trace-run/iket",
   "--ctas",
   "4",
   "--out",
   "{out}/trace-run"
  ],
  7200
 ],
 [
  "decode steps, nsys, off",
  [
   "/opt/nsys/bin/nsys",
   "profile",
   "--trace=cuda",
   "--sample=none",
   "--cpuctxsw=none",
   "--export=sqlite",
   "--force-overwrite=true",
   "--output",
   "{out}/nsys-off",
   "--cuda-graph-trace=node",
   "{python}",
   "/b/iket_step.py",
   "off",
   "--out",
   "{out}/nsys-off-run"
  ],
  5400
 ],
 [
  "decode-step table",
  [
   "{python}",
   "/b/iket_table.py",
   "{out}/trace",
   "--sources",
   "{out}/trace-run/iket/sources",
   "--between",
   "iket_step_marker_kernel",
   "--nsys",
   "off={out}/nsys-off.sqlite",
   "--json",
   "{out}/table.json"
  ],
  1800
 ]
]
