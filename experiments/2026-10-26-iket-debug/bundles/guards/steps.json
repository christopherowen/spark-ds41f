 [
  "the dry run's maximum",
  [
   "{python}",
   "-c",
   "import glob, sys\nfor p in sorted(glob.glob(sys.argv[1] + '/tracker/pid_*/smodel.injection.log')):\n    for line in open(p, errors='replace'):\n        if 'MaxTimestamp' in line or 'recommended' in line:\n            print(p.split('/')[-2], line.rstrip()[:300])",
