[
 [
  "IKET mode tests",
  [
   "{python}",
   "-m",
   "pytest",
   "-q",
   "-rfEs",
   "-p",
   "no:cacheprovider",
   "--noconftest",
   "--basetemp",
   "{out}/pytest",
   "tests/kernels/test_deepseek_v41_tilelang_iket.py"
  ],
  1800
 ],
 [
  "off",
  [
   "{python}",
   "/b/iket_hot.py",
   "off",
   "--out",
   "{out}/off"
  ],
  3600
 ],
 [
  "on, outside the profiler",
  [
   "{python}",
   "/b/iket_hot.py",
   "on",
   "--iket",
   "{out}/on/iket",
   "--out",
   "{out}/on"
  ],
  3600
 ],
 [
  "on, under run-iket",
  [
   "run-iket",
   "--output-dir",
   "{out}/trace",
   "profile",
   "--postprocess",
   "all",
   "--",
   "{python}",
   "/b/iket_hot.py",
   "on",
   "--iket",
   "{out}/trace-run/iket",
   "--out",
   "{out}/trace-run",
   "--iters",
   "3"
  ],
  5400
 ],
 [
  "all-reduce, peers 20 us late, under run-iket",
  [
   "run-iket",
   "--output-dir",
   "{out}/trace-late",
   "profile",
   "--postprocess",
   "all",
   "--",
   "{python}",
   "/b/iket_hot.py",
   "on",
   "--iket",
   "{out}/trace-late-run/iket",
   "--out",
   "{out}/trace-late-run",
   "--iters",
   "3",
   "--only",
   "allreduce",
   "--delay-us",
   "20"
  ],
  3600
 ],
 [
  "nsys, off",
  [
   "/opt/nsys/bin/nsys",
   "profile",
   "--trace=cuda",
   "--sample=none",
   "--cpuctxsw=none",
   "--export=sqlite",
   "--force-overwrite=true",
   "--output",
   "{out}/nsys-off",
   "{python}",
   "/b/iket_hot.py",
   "off",
   "--out",
   "{out}/nsys-off-run",
   "--iters",
   "50"
  ],
  3600
 ],
 [
  "nsys, on",
  [
   "/opt/nsys/bin/nsys",
   "profile",
   "--trace=cuda",
   "--sample=none",
   "--cpuctxsw=none",
   "--export=sqlite",
   "--force-overwrite=true",
   "--output",
   "{out}/nsys-on",
   "{python}",
   "/b/iket_hot.py",
   "on",
   "--iket",
   "{out}/nsys-on-run/iket",
   "--out",
   "{out}/nsys-on-run",
   "--iters",
   "50"
  ],
  3600
 ],
 [
  "per-phase table",
  [
   "{python}",
   "/b/iket_table.py",
   "{out}/trace",
   "--sources",
   "{out}/trace-run/iket/sources",
   "--nsys",
   "off={out}/nsys-off.sqlite",
   "on={out}/nsys-on.sqlite",
   "--json",
   "{out}/table.json"
  ],
  600
 ],
 [
  "per-phase table, peers 20 us late",
  [
   "{python}",
   "/b/iket_table.py",
   "{out}/trace-late",
   "--sources",
   "{out}/trace-late-run/iket/sources",
   "--json",
   "{out}/table-late.json"
  ],
  600
 ]
]
