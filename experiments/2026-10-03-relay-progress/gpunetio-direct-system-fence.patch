+++ b/examples/gpunetio_verbs_write_lat/gpunetio_verbs_write_lat_kernel.cu
@@ -122,10 +122,7 @@ __global__ void write_lat(struct doca_gpu_dev_verbs_qp *qp, uint32_t num_iters,
 #endif
             } else {
                 doca_gpu_dev_verbs_submit<DOCA_GPUNETIO_VERBS_RESOURCE_SHARING_MODE_EXCLUSIVE,
-                                          nic_handler == DOCA_GPUNETIO_VERBS_NIC_HANDLER_CPU_PROXY
-                                              ? DOCA_GPUNETIO_VERBS_SYNC_SCOPE_SYS
-                                              : DOCA_GPUNETIO_VERBS_SYNC_SCOPE_GPU,
-                                          nic_handler>(
+                                          DOCA_GPUNETIO_VERBS_SYNC_SCOPE_SYS, nic_handler>(
                     qp, (wqe_idx + 1),
                     DOCA_GPUNETIO_VERBS_GPU_CODE_OPT_CPU_PROXY_UPDATE_PI);  // Useful only in case
                                                                             // of CPU proxy
