+    blobs[2].stream_window ^= 2;
     for(int r=0;r<world;r++) assert(!roce_connect(ranks[r],blobs,sizeof(blobs)));
 }
 static void cleanup(void) {
@@ -365,7 +368,11 @@ int main(void) {
         run(1000,0);run(1000,UINT32_MAX-100);failures();independent_directions();
     }
     stream_chunk=0;partial_streaming();
-    printf("PASS: streaming plus direct3/ring4/mesh4, 1/2/4 paths, 32000 collectives, bidirectional byte balance, independent directions, no duplicate packs, wrap, delayed DMA, stop/errors (%llu writes)\n", (unsigned long long)messages);
+    for(stream_window=2;stream_window<=4;stream_window*=2) {
+        stream_chunk=64;run(1000,0);run(1000,UINT32_MAX-100);failures();independent_directions();partial_streaming();
+    }
+    stream_window=0;
+    printf("PASS: streaming plus direct3/ring4/mesh4, 1/2/4 paths, 36000 collectives, bidirectional byte balance, independent directions, no duplicate packs, wrap, delayed DMA, stop/errors (%llu writes)\n", (unsigned long long)messages);
 }
 
