+static void partial_streaming(void) {
+    stream_chunk=64;
+    for (int ready_peer=1;ready_peer<=3;ready_peer+=2) {
+        setup(0);
+        roce_ctx_t *c=ranks[0];
+        const uint32_t seq=1, bytes=4096;
+        const int lane=0, direction=ready_peer==3?0:1, dest=(ready_peer+2)%4;
+        uint32_t stripe_offset,packs;
+        stripe_range(bytes,stripes,lane,&stripe_offset,&packs);
+        uint32_t chunk=stream_chunk_size(c,packs*16);
+        uint32_t first=(packs+((seq+lane)&1u))/2;
+        uint32_t begin=direction==0?0:first*16;
+        uint32_t index=begin/chunk, length=(index+1)*chunk-begin;
+        uint8_t *recv=c->region+c->recv_off+((size_t)ready_peer*2+1)*c->slot_bytes;
+        for (unsigned i=0;i<bytes;i++) recv[i]=pattern(ready_peer,seq,i);
+        // Publish ONE chunk only. The full-lane flag and every other chunk
+        // remain absent; forwarding must start without either becoming ready.
+        __atomic_store_n(&flag(c,ready_peer,seq,lane)[index+1],seq,__ATOMIC_RELEASE);
+        uint32_t *ctrl=(uint32_t *)(c->region+c->ctrl_off);
+        assert(!roce_start(c));
+        __atomic_store_n(&ctrl[5],bytes,__ATOMIC_RELEASE);
+        __atomic_store_n(ctrl,seq,__ATOMIC_RELEASE);
+        uint32_t *seen=&flag(ranks[dest],ready_peer,seq,2*lane+direction)[index+1];
+        for(int i=0;i<10000 && __atomic_load_n(seen,__ATOMIC_ACQUIRE)!=seq;i++) {
+            progress();usleep(10);
+        }
+        assert(__atomic_load_n(seen,__ATOMIC_ACQUIRE)==seq);
+        assert(__atomic_load_n(flag(ranks[dest],ready_peer,seq,2*lane+direction),__ATOMIC_ACQUIRE)==0);
+        uint8_t *received=ranks[dest]->region+ranks[dest]->recv_off+
+            ((size_t)ready_peer*2+1)*c->slot_bytes;
+        for(unsigned i=begin;i<begin+length;i++) assert(received[i]==pattern(ready_peer,seq,i));
+        roce_stop(c);assert(roce_failed(c));cleanup();
+    }
+    stream_chunk=0;
+}
