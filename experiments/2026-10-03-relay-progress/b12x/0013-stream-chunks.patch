+
+// Word zero retains the GPU's whole-fragment contract. Words 1..31 are
+// independent epoch flags for ordered chunks; no torn multiword progress record.
+static uint32_t stream_chunk_size(roce_ctx_t *c, uint32_t stripe_bytes) {
+    uint32_t minimum = (stripe_bytes / 31 + (stripe_bytes % 31 != 0) + 15) & ~15u;
+    return c->stream_chunk_bytes > minimum ? c->stream_chunk_bytes : minimum;
+}
+
 static void stripe_range(uint32_t nbytes, int width, int lane,
                          uint32_t *offset, uint32_t *packs) {
     uint32_t total = nbytes / 16, remainder = total % (uint32_t)width;
@@ -653,8 +680,26 @@ static int post_path(roce_ctx_t *c, uint32_t seq, uint32_t nbytes,
     uint32_t offset, packs;
     stripe_range(nbytes, peer_width(c->world, c->rank, p, c->n_stripes),
                  lane, &offset, &packs);
-    return post_fragment(c, seq, origin, p, send, lane,
-                         (uint64_t)offset * 16, packs * 16, lane);
+    uint32_t bytes = packs * 16;
+    if (!c->stream_chunk_bytes || bytes <= c->stream_chunk_bytes)
+        return post_fragment(c, seq, origin, p, send, lane,
+                             (uint64_t)offset * 16, bytes, lane);
+    uint32_t chunk = stream_chunk_size(c, bytes);
+    uint32_t count = (bytes + chunk - 1) / chunk;
+    // Send the half this neighbour relays first. Both directions can begin
+    // forwarding before their unrelated half arrives at the same neighbour.
+    uint32_t first_pack = (packs + ((seq + (uint32_t)lane) & 1u)) / 2;
+    uint32_t first_chunk = p == (c->rank + c->world - 1) % c->world
+        ? (first_pack * 16) / chunk : 0;
+    for (uint32_t i = 0; i < count; i++) {
+        uint32_t index = (first_chunk + i) % count;
+        uint32_t begin = index * chunk;
+        uint32_t length = bytes - begin < chunk ? bytes - begin : chunk;
+        if (post_fragment_word(c, seq, origin, p, send, lane,
+                (uint64_t)offset * 16 + begin, length, lane, index + 1)) return -1;
+    }
+    // RC ordering makes this flag cover every chunk, regardless of send order.
+    return post_fragment(c, seq, origin, p, send, lane, 0, 0, lane);
 }
 
