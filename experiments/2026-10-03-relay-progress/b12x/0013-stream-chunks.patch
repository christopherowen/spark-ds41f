+            uint32_t cursor = half_begin + forwarded[fragment];
+            uint32_t length = half_end - cursor;
+            unsigned out_word = 0;
             uint32_t observed = __atomic_load_n(flag, __ATOMIC_ACQUIRE);
+            if (c->stream_chunk_bytes && stripe_bytes > c->stream_chunk_bytes && length) {
