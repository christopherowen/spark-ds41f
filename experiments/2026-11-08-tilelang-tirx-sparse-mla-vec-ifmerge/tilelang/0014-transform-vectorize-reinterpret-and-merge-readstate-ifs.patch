 src/transform/loop_vectorize.cc |   3 +-
 src/transform/merge_if_stmt.cc  | 167 +++++++++++++++++++++++---------
 2 files changed, 125 insertions(+), 45 deletions(-)

diff --git a/src/transform/loop_vectorize.cc b/src/transform/loop_vectorize.cc
index 7a23c82..b0c0614 100644
--- a/src/transform/loop_vectorize.cc
+++ b/src/transform/loop_vectorize.cc
@@ -734,7 +734,8 @@ private:
         Op::GetAttrMap<TVectorizable>("TVectorizable");
 
     auto optional_op = node->op.as<Op>();
-    bool vectorizable = op_vectorizable_.get(optional_op.value(), false) &&
+    bool vectorizable = (op_vectorizable_.get(optional_op.value(), false) ||
+                         node->op.same_as(builtin::reinterpret())) &&
                         !node->dtype.is_scalable_vector();
     if (vectorizable) {
       return arith::IRMutatorWithAnalyzer::VisitExpr_(node);
diff --git a/src/transform/merge_if_stmt.cc b/src/transform/merge_if_stmt.cc
index 6544117..f72e56b 100644
--- a/src/transform/merge_if_stmt.cc
+++ b/src/transform/merge_if_stmt.cc
@@ -1,5 +1,5 @@
 /*!
- * \file if_stmt_binding.cc
+ * \file merge_if_stmt.cc
  * \brief Merge the If Stmt in SeqStmt
  */
 
@@ -12,6 +12,8 @@
 #include <tvm/tirx/stmt_functor.h>
 #include <tvm/tirx/transform.h>
 
+#include <unordered_set>
+
 #include "../op/builtin.h"
 
 namespace tvm {
@@ -29,12 +31,81 @@ public:
 
   static Stmt Apply(Stmt stmt) {
     auto rewriter = MergeIfStmtRewriter();
+    rewriter.CollectWritesAndDefs(stmt, &rewriter.func_written_buffers_,
+                                  nullptr);
     return rewriter(stmt);
   }
 
 private:
+  using VarSet = std::unordered_set<Var, ObjectPtrHash, ObjectPtrEqual>;
+
   MergeIfStmtRewriter() = default;
 
+  static void CollectConditionReads(const PrimExpr &cond, VarSet *read_buffers,
+                                    VarSet *read_vars) {
+    PostOrderVisit(cond, [&](const ObjectRef &node) {
+      if (const auto *load = node.as<BufferLoadNode>()) {
+        read_buffers->insert(load->buffer->data);
+      } else if (const auto *var = node.as<VarNode>()) {
+        read_vars->insert(GetRef<Var>(var));
+      } else if (const auto *call = node.as<CallNode>()) {
+        if ((call->op.same_as(builtin::tvm_access_ptr()) ||
+             call->op.same_as(tl::access_ptr())) &&
+            call->args.size() >= 2) {
+          if (const auto *buf_var = call->args[1].as<VarNode>()) {
+            read_buffers->insert(GetRef<Var>(buf_var));
+          }
+        }
+      }
+    });
+  }
+
+  static void CollectWritesAndDefs(const Stmt &stmt, VarSet *written_buffers,
+                                   VarSet *defined_vars) {
+    PostOrderVisit(stmt, [&](const ObjectRef &node) {
+      if (const auto *store = node.as<BufferStoreNode>()) {
+        if (written_buffers) {
+          written_buffers->insert(store->buffer->data);
+        }
+      } else if (const auto *bind = node.as<BindNode>()) {
+        if (defined_vars) {
+          defined_vars->insert(bind->var);
+        }
+      } else if (const auto *call = node.as<CallNode>()) {
+        if (call->op.same_as(builtin::tvm_access_ptr()) &&
+            call->args.size() >= 5) {
+          const auto *mask = call->args[4].as<IntImmNode>();
+          if (!mask || mask->value != 1) {
+            if (const auto *buf_var = call->args[1].as<VarNode>()) {
+              if (written_buffers) {
+                written_buffers->insert(GetRef<Var>(buf_var));
+              }
+            }
+          }
+        } else if (call->op.same_as(tl::access_ptr()) &&
+                   call->args.size() >= 3) {
+          const auto *mask = call->args[2].as<IntImmNode>();
+          if (!mask || mask->value != 1) {
+            if (const auto *load = call->args[0].as<BufferLoadNode>()) {
+              if (written_buffers) {
+                written_buffers->insert(load->buffer->data);
+              }
+            }
+          }
+        }
+      }
+    });
+  }
+
+  static bool Disjoint(const VarSet &a, const VarSet &b) {
+    for (const Var &v : a) {
+      if (b.count(v)) {
+        return false;
+      }
+    }
+    return true;
+  }
+
   void FlattenAppend(const Stmt &s, Array<Stmt> *out) {
     if (const auto *seq = s.as<SeqStmtNode>()) {
       for (const Stmt &e : seq->seq) {
@@ -46,50 +117,22 @@ private:
   }
 
   Stmt VisitStmt_(const SeqStmtNode *op) final {
-    // First, recursively flatten nested SeqStmt so that
-    //   SeqStmt{ if, SeqStmt{ if, SeqStmt{ if } } }
-    // becomes a single-level sequence of [if, if, if].
     Array<Stmt> flat_seq;
     for (const Stmt &stmt : op->seq) {
       Stmt new_stmt = this->VisitStmt(stmt);
       FlattenAppend(new_stmt, &flat_seq);
     }
 
-    // Then, merge consecutive IfThenElse (without else) that share the same
-    // condition.
     Array<Stmt> new_seq;
     PrimExpr current_condition;
     Span current_span;
     Array<Stmt> current_if_bodies;
+    VarSet current_cond_buffers;
+    VarSet current_cond_vars;
+    VarSet current_written_buffers;
+    VarSet current_defined_vars;
 
-    for (const Stmt &stmt : flat_seq) {
-      if (const auto *if_node = stmt.as<IfThenElseNode>()) {
-        if (!if_node->else_case.defined()) {
-          if (current_condition.defined() &&
-              SideEffect(current_condition) <= CallEffectKind::kPure &&
-              ExprDeepEqual()(current_condition, if_node->condition)) {
-            current_if_bodies.push_back(if_node->then_case);
-            continue;
-          } else {
-            if (!current_if_bodies.empty()) {
-              auto if_stmt =
-                  IfThenElse(current_condition,
-                             current_if_bodies.size() == 1
-                                 ? current_if_bodies[0]
-                                 : this->VisitStmt(SeqStmt(current_if_bodies)),
-                             Stmt(), current_span);
-              new_seq.push_back(if_stmt);
-              current_if_bodies.clear();
-            }
-
-            current_condition = if_node->condition;
-            current_span = if_node->span;
-            current_if_bodies.push_back(if_node->then_case);
-            continue;
-          }
-        }
-      }
-
+    auto flush = [&]() {
       if (!current_if_bodies.empty()) {
         auto if_stmt =
             IfThenElse(current_condition,
@@ -100,23 +143,59 @@ private:
         new_seq.push_back(if_stmt);
         current_condition = PrimExpr();
         current_if_bodies.clear();
+        current_cond_buffers.clear();
+        current_cond_vars.clear();
+        current_written_buffers.clear();
+        current_defined_vars.clear();
       }
+    };
 
-      new_seq.push_back(stmt);
-    }
+    for (const Stmt &stmt : flat_seq) {
+      if (const auto *if_node = stmt.as<IfThenElseNode>()) {
+        if (!if_node->else_case.defined() &&
+            SideEffect(if_node->condition) <= CallEffectKind::kReadState) {
+          VarSet cond_buffers, cond_vars;
+          CollectConditionReads(if_node->condition, &cond_buffers, &cond_vars);
+          VarSet body_writes, body_defs;
+          CollectWritesAndDefs(if_node->then_case, &body_writes, &body_defs);
+
+          bool can_merge =
+              current_condition.defined() &&
+              ExprDeepEqual()(current_condition, if_node->condition) &&
+              (SideEffect(current_condition) <= CallEffectKind::kPure ||
+               (Disjoint(current_cond_buffers, current_written_buffers) &&
+                Disjoint(current_cond_vars, current_defined_vars) &&
+                Disjoint(current_cond_buffers, func_written_buffers_)));
+
+          if (can_merge) {
+            current_if_bodies.push_back(if_node->then_case);
+            current_written_buffers.insert(body_writes.begin(),
+                                           body_writes.end());
+            current_defined_vars.insert(body_defs.begin(), body_defs.end());
+            continue;
+          }
 
-    if (!current_if_bodies.empty()) {
-      auto if_stmt =
-          IfThenElse(current_condition,
-                     current_if_bodies.size() == 1
-                         ? current_if_bodies[0]
-                         : this->VisitStmt(SeqStmt(current_if_bodies)),
-                     Stmt(), current_span);
-      new_seq.push_back(if_stmt);
+          flush();
+          current_condition = if_node->condition;
+          current_span = if_node->span;
+          current_if_bodies.push_back(if_node->then_case);
+          current_cond_buffers = std::move(cond_buffers);
+          current_cond_vars = std::move(cond_vars);
+          current_written_buffers = std::move(body_writes);
+          current_defined_vars = std::move(body_defs);
+          continue;
+        }
+      }
+
+      flush();
+      new_seq.push_back(stmt);
     }
 
+    flush();
     return new_seq.size() == 1 ? new_seq[0] : SeqStmt(new_seq, op->span);
   }
+
+  VarSet func_written_buffers_;
 };
 
 PrimFunc MergeIfStmtSubstitute(PrimFunc &f) {
