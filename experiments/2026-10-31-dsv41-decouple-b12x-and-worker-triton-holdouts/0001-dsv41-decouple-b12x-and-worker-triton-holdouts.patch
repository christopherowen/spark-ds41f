+            num_passes = T.ceildiv(vocab_size, _COMPACT_MASK_BLOCK)
+            for p in T.serial(num_passes):
+                byte_idx = p * threads + tx
+                col0 = byte_idx * 8
+                mask_byte = T.alloc_var(T.int32, init=0)
+                thread_kept = T.alloc_var(T.int32, init=0)
