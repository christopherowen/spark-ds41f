From be32c2acc7efba617562d740f920de01f1ce3eae Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Mon, 5 Oct 2026 03:37:57 +0200
Subject: [PATCH] Mark the DSpark drafter's padding rows for the MoE routers

The target marks the rows that pad its batch, and every row of a dummy
batch, as padding in the forward context, and the MoE routers skip them
(VLLM_MOE_SKIP_PADDING). The DFlash/DSpark drafter set no mask, so its
routers routed CUDA graph padding rows and the dummy rows of graph
capture and the memory profiles. Those rows read the null block, which
dummy runs fill with other cache groups' records; TileKernels' gate
refused their non-finite logits at TP3.

The drafter keeps a persistent padding mask in its forward context. It
starts as all padding, so capture routes no dummy row; each step marks
rows past the live query rows as padding before the graph replays, and a
profiling batch is all padding, like the target's.
---
 .../worker/gpu/spec_decode/dflash/speculator.py | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/vllm/v1/worker/gpu/spec_decode/dflash/speculator.py b/vllm/v1/worker/gpu/spec_decode/dflash/speculator.py
index e209f6829..3e24b90d9 100644
--- a/vllm/v1/worker/gpu/spec_decode/dflash/speculator.py
+++ b/vllm/v1/worker/gpu/spec_decode/dflash/speculator.py
@@ -52,6 +52,12 @@ class DFlashSpeculator(DraftModelSpeculator):
         self.hidden_states = torch.zeros(
             self.max_num_tokens, self.hidden_size, dtype=self.dtype, device=device
         )
+        # Rows that pad the query batch, as the MoE routers read them from the
+        # forward context (VLLM_MOE_SKIP_PADDING). Every row starts as padding,
+        # so CUDA graph capture routes no dummy row; each step marks its live
+        # rows. Persistent: captured graphs read it on replay.
+        self._is_padding = torch.ones(self.max_num_tokens, dtype=torch.bool, device=device)
+        self._row_index = torch.arange(self.max_num_tokens, device=device)
 
         # Multimodal inputs not currently supported.
         self.supports_mm_inputs = False
@@ -425,6 +431,7 @@ class DFlashSpeculator(DraftModelSpeculator):
             num_tokens_across_dp=num_tokens_across_dp,
             slot_mapping=slot_mappings,
             batch_descriptor=batch_descriptor,
+            is_padding=self._is_padding[:num_tokens],
         ):
             last_hidden_states = self.model(
                 input_ids=self.input_buffers.input_ids[:num_tokens],
@@ -593,6 +600,8 @@ class DFlashSpeculator(DraftModelSpeculator):
             # DFlash processes all speculative tokens in one forward pass,
             # so the real token count is num_query_tokens.
             self._prepare_eplb_forward(num_query_tokens)
+            # A memory-profile batch is all padding, like the target's.
+            self._is_padding[:num_query_tokens].fill_(True)
             self._generate_draft(
                 num_reqs,
                 num_query_tokens,
@@ -725,6 +734,14 @@ class DFlashSpeculator(DraftModelSpeculator):
         # so the real token count is num_query_tokens.
         self._prepare_eplb_forward(num_query_tokens)
 
+        # Rows past the live query rows pad the batch; a profiling batch is all
+        # padding, like the target's dummy batches. Written eagerly before the
+        # graph replays, so the routers skip exactly these rows.
+        live = 0 if dummy_run and is_profile else num_query_tokens
+        self._is_padding[:num_tokens_padded].copy_(
+            self._row_index[:num_tokens_padded] >= live
+        )
+
         if batch_desc.cg_mode == CUDAGraphMode.FULL:
             assert self.query_cudagraph_manager is not None
             self.query_cudagraph_manager.run_fullgraph(batch_desc)
