From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Sun, 4 Oct 2026 22:13:33 +0200
Subject: [PATCH] Debug flag: count non-finite TileLang gate inputs instead of
 trapping

With SPARK3_DEBUG_ROUTER_NONFINITE=1 each TileLang gate router counts the
rows whose input or gate logits are non-finite, split into routed and
masked rows, records the first routed one and its batch size, and zeroes
the logits so the step completes. The model runner logs the counts after
graph capture and after the DSpark cost profile. Off by default.
---
 vllm/models/deepseek_v4_1/tilelang/router.py | 78 ++++++++++++++++++++
 vllm/v1/worker/gpu/model_runner.py           | 12 +++
 2 files changed, 90 insertions(+)

diff --git a/vllm/models/deepseek_v4_1/tilelang/router.py b/vllm/models/deepseek_v4_1/tilelang/router.py
index 4476b85dd..852c5dde6 100644
--- a/vllm/models/deepseek_v4_1/tilelang/router.py
+++ b/vllm/models/deepseek_v4_1/tilelang/router.py
@@ -27,6 +27,8 @@ memory and each MoE layer runs one launch fewer. At prefill the gate runs its
 own GEMM and TileKernels routes the logits.
 """
 
+import os
+
 import tilelang
 import tilelang.language as T
 import torch
@@ -38,6 +40,75 @@ from vllm.model_executor.layers.fused_moe.router.fused_topk_bias_router import (
 )
 
 
+# Debug only (SPARK3_DEBUG_ROUTER_NONFINITE=1): instead of trapping on non-finite
+# gate logits, count them per router (split into routed and masked rows), zero
+# them so the step completes, and report with ``debug_report``. Off by default;
+# the checks are tensor ops on one persistent buffer, so CUDA graphs keep them.
+_DEBUG_NONFINITE = os.environ.get("SPARK3_DEBUG_ROUTER_NONFINITE") == "1"
+_DEBUG_FIELDS = (
+    "calls",
+    "rows",
+    "bad_x",
+    "bad_routed",
+    "bad_masked",
+    "first_bad_row",
+    "first_bad_batch",
+)
+_DEBUG_SLOTS = 256
+_debug_names: list[str] = []
+_debug_stats: torch.Tensor | None = None
+
+
+def _debug_slot(num_experts: int) -> int:
+    global _debug_stats
+    if _debug_stats is None:
+        _debug_stats = torch.zeros(
+            (_DEBUG_SLOTS, len(_DEBUG_FIELDS)), dtype=torch.int64, device="cuda"
+        )
+        _debug_stats[:, 5:].fill_(-1)
+    kind = "target" if num_experts == 384 else f"draft{num_experts}"
+    index = sum(1 for name in _debug_names if name.startswith(kind + "."))
+    _debug_names.append(f"{kind}.{index}")
+    assert len(_debug_names) <= _DEBUG_SLOTS
+    return len(_debug_names) - 1
+
+
+def _debug_check(slot, x, logits, route_mask) -> None:
+    """Count non-finite rows of ``x`` and ``logits``, then zero ``logits``' non-finite values."""
+    stats = _debug_stats[slot]
+    rows = logits.shape[-2]
+    bad = ~torch.isfinite(logits).reshape(-1, rows, logits.shape[-1]).all(-1).all(0)
+    routed = route_mask if route_mask is not None else torch.ones_like(bad)
+    bad_routed = bad & routed
+    stats[0] += 1
+    stats[1] += rows
+    stats[2] += (~torch.isfinite(x).all(-1)).sum()
+    stats[3] += bad_routed.sum()
+    stats[4] += (bad & ~routed).sum()
+    index = torch.arange(rows, device=logits.device)
+    first = torch.where(bad_routed, index, rows).min()
+    new = (stats[5] < 0) & bad_routed.any()
+    stats[5] = torch.where(new, first, stats[5])
+    stats[6] = torch.where(new, bad_routed.new_full((), rows, dtype=torch.int64), stats[6])
+    logits.nan_to_num_(nan=0.0, posinf=0.0, neginf=0.0)
+
+
+def debug_report() -> list[str]:
+    """One line per router whose inputs were ever non-finite, and a summary."""
+    if _debug_stats is None:
+        return []
+    stats = _debug_stats[: len(_debug_names)].tolist()
+    lines = [
+        f"router non-finite {name}: "
+        + ", ".join(f"{field}={value}" for field, value in zip(_DEBUG_FIELDS, row))
+        for name, row in zip(_debug_names, stats)
+        if row[2] or row[3] or row[4]
+    ]
+    flagged = len(lines)
+    lines.append(f"router non-finite: {flagged} of {len(_debug_names)} routers flagged")
+    return lines
+
+
 def _image_token_mask(input_ids: torch.Tensor, lo: int, count: int) -> torch.Tensor:
     """Image sentinel tokens of this step, computed once and shared by every layer."""
     context = get_forward_context() if is_forward_context_available() else None
@@ -274,6 +345,9 @@ class TileLangGateRouter(TileKernelsRouter):
         super().__init__(*args, **kwargs)
         self.gate = gate
         self._kernels: dict[tuple[bool, bool], object] = {}
+        self._debug_slot = (
+            _debug_slot(gate.weight.shape[0]) if _DEBUG_NONFINITE else None
+        )
         # Text-only layers pass no image tokens; one all-false mask serves them.
         self._no_image = None
 
@@ -292,6 +366,8 @@ class TileLangGateRouter(TileKernelsRouter):
         specs = _partial_specs(gate, x.shape[0])
         if not specs:
             logits, _ = gate(x)
+            if self._debug_slot is not None:
+                _debug_check(self._debug_slot, x, logits, _routing_mask(x.shape[0]))
             return super()._compute_routing(
                 hidden_states, logits, indices_type, input_ids=input_ids
             )
@@ -305,6 +381,8 @@ class TileLangGateRouter(TileKernelsRouter):
         if image and input_ids is None:
             raise ValueError("DeepSeek V4.1 vision routing requires input_ids")
         route_mask = _routing_mask(x.shape[0])
+        if self._debug_slot is not None:
+            _debug_check(self._debug_slot, x, partials, route_mask)
         key = (image, route_mask is not None)
         if key not in self._kernels:
             self._kernels[key] = route_partials(
