+
     @contextlib.contextmanager
     def _profile_token_ids(self, real_rows: bool | None = None):
         """Feed distinct token ids to the adaptive-verification cost profile.
@@ -1280,6 +1290,7 @@ class GPUModelRunner(LoRAModelRunnerMixin):
                         with use_workspace_lane(self._draft_workspace_lane):
                             self.speculator.capture()
                     if self.adaptive_verification is not None:
+                        self._log_router_nonfinite("after capture")
                         with self._profile_token_ids():
                             self.adaptive_verification.profile_costs(
                                 self._dummy_run,
@@ -1290,6 +1301,7 @@ class GPUModelRunner(LoRAModelRunnerMixin):
                                     self._profile_token_ids, True
                                 ),
                             )
+                        self._log_router_nonfinite("after cost profile")
                     self.kv_connector.reset_capture_state()
 
             end_free_gpu_memory = torch.accelerator.get_memory_info()[0]
