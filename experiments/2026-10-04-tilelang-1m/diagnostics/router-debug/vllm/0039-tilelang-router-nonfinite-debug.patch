+# Debug only (SPARK3_DEBUG_ROUTER_NONFINITE=1): instead of trapping on non-finite
+# gate logits, count them per router (split into routed and masked rows), zero
+# them so the step completes, and report with ``debug_report``. ``probe`` adds
+# the same count at any other point. Every check takes the next value of one
+# device counter, so the earliest first-bad sequence marks where non-finite
+# rows begin. Off by default; the checks are tensor ops on persistent buffers,
+# so CUDA graphs keep them.
+_DEBUG_NONFINITE = os.environ.get("SPARK3_DEBUG_ROUTER_NONFINITE") == "1"
+_DEBUG_FIELDS = (
+    "calls",
+    "rows",
+    "bad_x",
+    "bad_routed",
+    "bad_masked",
+    "first_bad_row",
+    "first_bad_batch",
+    "first_bad_seq",
+)
+_DEBUG_SLOTS = 1024
+_debug_names: list[str] = []
+_debug_probes: dict[str, int] = {}
+_debug_stats: torch.Tensor | None = None
+_debug_seq: torch.Tensor | None = None
+
+
+def _debug_new_slot(name: str) -> int:
+    global _debug_stats, _debug_seq
+    if _debug_stats is None:
+        _debug_stats = torch.zeros(
+            (_DEBUG_SLOTS, len(_DEBUG_FIELDS)), dtype=torch.int64, device="cuda"
+        )
+        _debug_stats[:, 5:].fill_(-1)
+        _debug_seq = torch.zeros((), dtype=torch.int64, device="cuda")
+    _debug_names.append(name)
+    assert len(_debug_names) <= _DEBUG_SLOTS
+    return len(_debug_names) - 1
+
+
+def _debug_slot(num_experts: int) -> int:
+    kind = "router.target" if num_experts == 384 else f"router.draft{num_experts}"
+    index = sum(1 for name in _debug_names if name.startswith(kind + "."))
+    return _debug_new_slot(f"{kind}.{index}")
+
+
+def _debug_record(stats, seq, bad, bad_x, bad_routed, bad_masked) -> None:
+    rows = bad.shape[0]
+    seq += 1
+    stats[0] += 1
+    stats[1] += rows
+    stats[2] += bad_x.sum()
+    stats[3] += bad_routed.sum()
+    stats[4] += bad_masked.sum()
+    index = torch.arange(rows, device=bad.device)
+    flagged = bad_routed | bad_x
+    first = torch.where(flagged, index, rows).min()
+    new = (stats[5] < 0) & flagged.any()
+    stats[5] = torch.where(new, first, stats[5])
+    stats[6] = torch.where(new, flagged.new_full((), rows, dtype=torch.int64), stats[6])
+    stats[7] = torch.where(new, seq, stats[7])
+
+
+@torch.library.custom_op(
+    "vllm::dsv41_debug_nonfinite_probe", mutates_args=("stats", "seq")
+)
+def _probe_op(x: torch.Tensor, stats: torch.Tensor, seq: torch.Tensor, slot: int) -> None:
+    if x.numel() == 0:
+        return
+    bad = ~torch.isfinite(x.reshape(x.shape[0], -1)).all(-1)
+    none = torch.zeros_like(bad)
+    _debug_record(stats[slot], seq, bad, bad, none, none)
+
+
+@_probe_op.register_fake
+def _probe_op_fake(x, stats, seq, slot) -> None:
+    return None
+
+
+def probe(name: str, x: torch.Tensor) -> None:
+    """Count ``x``'s non-finite rows under ``name`` (debug flag only)."""
+    if not _DEBUG_NONFINITE:
+        return
+    slot = _debug_probes.get(name)
+    if slot is None:
+        slot = _debug_probes[name] = _debug_new_slot(f"probe.{name}")
+    _probe_op(x, _debug_stats, _debug_seq, slot)
+
+
+def _debug_check(slot, x, logits, route_mask) -> None:
+    """Count non-finite rows of ``x`` and ``logits``, then zero ``logits``' non-finite values."""
+    rows = logits.shape[-2]
+    bad = ~torch.isfinite(logits).reshape(-1, rows, logits.shape[-1]).all(-1).all(0)
+    routed = route_mask if route_mask is not None else torch.ones_like(bad)
+    bad_x = ~torch.isfinite(x).all(-1)
+    _debug_record(
+        _debug_stats[slot], _debug_seq, bad, bad_x, bad & routed, bad & ~routed
+    )
+    logits.nan_to_num_(nan=0.0, posinf=0.0, neginf=0.0)
+
+
+def debug_report() -> list[str]:
+    """Checks that ever saw non-finite rows, earliest first, and a summary."""
+    if _debug_stats is None:
+        return []
+    stats = _debug_stats[: len(_debug_names)].tolist()
+    flagged = sorted(
+        (row[7], name, row)
+        for name, row in zip(_debug_names, stats)
+        if row[2] or row[3] or row[4]
+    )
+    lines = [
+        f"router non-finite {name}: "
+        + ", ".join(f"{field}={value}" for field, value in zip(_DEBUG_FIELDS, row))
+        for _, name, row in flagged
+    ]
+    lines.append(
+        f"router non-finite: {len(flagged)} of {len(_debug_names)} checks flagged"
+    )
+    return lines
+
