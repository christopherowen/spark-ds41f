+COALESCED_ROW_COST_KNEE = 32
+COALESCED_ROW_COST_SCALE = 0.28
+COALESCED_MIN_REQS = 10
+SATURATED_ROW_COST_KNEE = 64
+SATURATED_ROW_COST_SCALE = 0.28
+MMA_TILE_STEP_ROWS = 0.0
