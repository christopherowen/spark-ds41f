+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA")
+@pytest.mark.parametrize("tp_rank", [0, 3])
+@torch.inference_mode()
+def test_disk_rows_pack_and_read_rank_compacted_files(
+    tmp_path, dist_init, monkeypatch, tp_rank
+):
+    """When ENGRAM_PACKED_DIR is set, open_disk_rows packs this rank's hash columns
+    into a single-plane 264-byte file on first open, reuses it on subsequent opens, and
+    gathers identical BF16 rows."""
+    import os
+
+    packed_dir = os.path.join(
+        os.environ.get("ENGRAM_ROWS_TEST_DIR", "/cache/engram-rows-test"),
+        f"packed-model-{os.getpid()}-r{tp_rank}",
+    )
+    monkeypatch.setattr(engram_module, "ENGRAM_PACKED_DIR", packed_dir)
+    device = torch.device("cuda", torch.cuda.current_device())
+    capacity = 7
+    geometry = native.build_geometry(base_table_size=19, compressed_vocab_size=32)
+    caps = native.Caps(
+        device=device,
+        max_tokens=capacity,
+        max_seqs=2,
+        max_requests=2,
+        vocab_size=32,
+        layer_id=1,
+        tp_size=4,
+        tp_rank=tp_rank,
+    )
+    layout = SimpleNamespace(
+        caps=(caps,),
+        lookup_plans=(None,),
+        geometry=geometry,
+        table_memory="disk",
+        projection_tp=False,
+    )
+    config = SimpleNamespace(hidden_size=64, hc_mult=4, rms_norm_eps=1e-3)
+    old_dtype = torch.get_default_dtype()
+    try:
+        torch.set_default_dtype(torch.bfloat16)
+        with torch.device(device):
+            module = Engram(config, None, layout, 0, False, "engram_packed_test")
+    finally:
+        torch.set_default_dtype(old_dtype)
+    embed = module.embed_tokens
+    row_values = torch.arange(embed.table_rows).remainder(7).add(1)
+    weight = row_values[:, None].expand(-1, 256).to(torch.float8_e4m3fn).contiguous()
+    scales = torch.full((embed.table_rows, 8), 127, dtype=torch.uint8)
+    for name, tensor, offset, scale in (
+        ("weight.bin", weight, 4093, False),
+        ("scale.bin", scales, 123, True),
+    ):
+        path = os.path.join(packed_dir, name)
+        os.makedirs(packed_dir, exist_ok=True)
+        with open(path, "wb") as stream:
+            stream.write(bytes(offset))
+            stream.write(tensor.view(torch.uint8).numpy().tobytes())
+        embed._disk_sources.append((path, offset, scale))
+    embed.open_disk_rows()
+    packed_files = [f for f in os.listdir(packed_dir) if f.endswith(".packed")]
+    assert len(packed_files) == 1
+    offsets = np.asarray(geometry.offsets[0], dtype=np.int64)
+    ends = np.append(offsets[1:], embed.table_rows)
+    ids_np = np.empty((capacity, 24), dtype=np.int64)
+    for c in range(24):
+        ids_np[:, c] = offsets[c] + (np.arange(capacity) % (ends[c] - offsets[c]))
+    ids = torch.from_numpy(ids_np).to(device)
+    count = torch.tensor([capacity], device=device, dtype=torch.int32)
+    try:
+        output = module.staged_rows
+        embed.hashes[:capacity].copy_(ids)
+        embed.num_tokens.copy_(count)
+        module.stage_rows(capacity, torch.cuda.current_stream())
+        embed.gather_rows(output)
+        owned = [h for h in range(24) if embed.column_mask >> h & 1]
+        reference = weight.float()[ids.cpu()[:, owned]].flatten(1)
+        torch.testing.assert_close(
+            output.cpu(), reference.bfloat16(), rtol=0, atol=0
+        )
+    finally:
+        embed.close()
+        for f in os.listdir(packed_dir):
+            os.unlink(os.path.join(packed_dir, f))
+        os.rmdir(packed_dir)
