@@ -621,8 +629,55 @@ class ParallelEngramEmbedding(nn.Module):
             check_early=ENGRAM_CHECK_EARLY_IDS,
             timeline=ENGRAM_TIMELINE,
         )
-        for path, offset, scale in self._disk_sources:
-            rows.add_source(path, offset, scale=scale)
+        if ENGRAM_PACKED_DIR and self.columns is not None:
+            import hashlib
+
+            by_plane = {scale: (path, offset) for path, offset, scale in self._disk_sources}
+            w_path, w_offset = by_plane[False]
+            s_path, s_offset = by_plane[True]
+            col_start, col_end, col_delta, owned_starts, owned_rows = (
+                column_compaction_map(
+                    self.geometry.offsets[self.layer_index],
+                    self.table_rows,
+                    self.columns,
+                )
+            )
+            w_stat, s_stat = os.stat(w_path), os.stat(s_path)
+            digest = hashlib.sha256(
+                f"{w_path}:{w_offset}:{w_stat.st_size}:{w_stat.st_mtime_ns}:"
+                f"{s_path}:{s_offset}:{s_stat.st_size}:{s_stat.st_mtime_ns}:"
+                f"{self.table_rows}:{self.column_mask:#x}".encode()
+            ).hexdigest()[:16]
+            os.makedirs(ENGRAM_PACKED_DIR, exist_ok=True)
+            packed_path = os.path.join(
+                ENGRAM_PACKED_DIR,
+                f"engram-layer{self.caps.layer_id}-tp{self.caps.tp_size}"
+                f"-rank{self.caps.tp_rank}-{digest}.packed",
+            )
+            expected_bytes = int(owned_rows.sum()) * PACKED_ROW_BYTES
+            if (
+                not os.path.exists(packed_path)
+                or os.path.getsize(packed_path) != expected_bytes
+            ):
+                pack_engram_columns(
+                    w_path,
+                    w_offset,
+                    s_path,
+                    s_offset,
+                    packed_path,
+                    owned_starts,
+                    owned_rows,
+                )
+            rows.add_packed_source(
+                packed_path,
+                0,
+                col_start=col_start,
