+# --- batch-invariance per-stage row checksums (diagnostic; off unless BI_TRACE_DIR is set) ---
+import os as _bi_os2
+
+_BI_ON = bool(_bi_os2.environ.get("BI_TRACE_DIR")) and bool(_bi_os2.environ.get("BI_TRACE_LAYERS"))
+_BI_CAP = 64
+
+
+def _bi_put(mod, tag, x):
+    if not _BI_ON or not isinstance(x, torch.Tensor) or x.ndim < 1 or not x.is_cuda:
+        return
+    d = mod.__dict__
+    key = "_bi_" + tag
+    buf = d.get(key)
+    if buf is None:
+        buf = d[key] = torch.zeros(_BI_CAP + 1, dtype=torch.int64, device=x.device)
+    r = min(int(x.shape[0]), _BI_CAP)
+    buf[_BI_CAP].fill_(int(x.shape[0]))
+    if r == 0:
+        return
+    v = x[:r].contiguous()
+    if v.dtype in (torch.bfloat16, torch.float16):
+        v = v.view(torch.int16)
+    elif v.dtype == torch.float32:
+        v = v.view(torch.int32)
+    v = v.reshape(r, -1).to(torch.int64)
+    w = (torch.arange(v.shape[1], device=v.device, dtype=torch.int64) % 8191) + 1
+    buf[:r].copy_((v * w).sum(-1))
