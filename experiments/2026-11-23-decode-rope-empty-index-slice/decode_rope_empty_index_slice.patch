+            def issue_pending_aux():
+                # The overlapped decode path leaves q's RoPE and the shared decode
+                # metadata to run on the aux stream beside this rank's index
+                # scoring. They are due once per forward even when a rank-split
+                # step deals this rank no rows and it scores nothing (the last
+                # rank of 25..28 rows on 8 ranks), so the caller issues them
