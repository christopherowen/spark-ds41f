{
 "notes": "vLLM's safetensors loader (memory-mapped reads through the page cache) at tp4-ring with the weight digest; VLLM_PLUGINS names no plugin. The evidence arm.",
 "extends": {
  "config": "config/cluster.json",
  "shape": "tp4-ring"
 },
 "set": {
  "environment": {
   "SPARK_DS41F_WEIGHT_DIGEST": "1",
   "VLLM_PLUGINS": ""
  },
  "container": {
   "mounts": [
    [
     "{home}/projects/spark-ds41f/cache",
     "/cache",
     "rw"
    ],
    [
     "{home}/projects/spark-ds41f/experiments/2026-10-25-final-names/loader/bundles/digest/overlay/vllm/model_executor/model_loader/base_loader.py",
     "/opt/spark-ds41f/candidate/vllm/vllm/model_executor/model_loader/base_loader.py",
     "ro"
    ],
    [
     "{home}/projects/spark-ds41f/experiments/2026-10-25-final-names/loader/bundles/digest/overlay/vllm/model_executor/model_loader/weight_digest.py",
     "/opt/spark-ds41f/candidate/vllm/vllm/model_executor/model_loader/weight_digest.py",
     "ro"
    ]
   ]
  }
 },
 "serve_options": {
  "--load-format": "safetensors"
 }
}
