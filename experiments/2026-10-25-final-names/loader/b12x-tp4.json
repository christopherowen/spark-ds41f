{
 "notes": "B12X's loader (--load-format b12x, VLLM_PLUGINS=b12x_loader) at tp4-ring with the weight digest (SPARK_DS41F_WEIGHT_DIGEST=1, bundles/digest).",
 "extends": {
  "config": "config/cluster.json",
  "shape": "tp4-ring"
 },
 "set": {
  "environment": {
   "SPARK_DS41F_WEIGHT_DIGEST": "1",
   "VLLM_PLUGINS": "b12x_loader"
  },
  "container": {
   "mounts": [
    [
     "{checkout}/cache",
     "/cache",
     "rw"
    ],
    [
     "{checkout}/experiments/2026-10-25-final-names/loader/bundles/digest/overlay/vllm/model_executor/model_loader/base_loader.py",
     "/opt/spark-ds41f/candidate/vllm/vllm/model_executor/model_loader/base_loader.py",
     "ro"
    ],
    [
     "{checkout}/experiments/2026-10-25-final-names/loader/bundles/digest/overlay/vllm/model_executor/model_loader/weight_digest.py",
     "/opt/spark-ds41f/candidate/vllm/vllm/model_executor/model_loader/weight_digest.py",
     "ro"
    ]
   ]
  }
 },
 "serve_options": {
  "--load-format": "b12x"
 }
}
