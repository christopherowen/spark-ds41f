     "ro"
    ],
    [
     "{checkout}/experiments/2026-10-25-final-names/loader/bundles/direct/overlay/vllm/model_executor/model_loader/weight_digest.py",
     "/opt/spark-ds41f/candidate/vllm/vllm/model_executor/model_loader/weight_digest.py",
     "ro"
    ]
   ]
  }
 },
