{
 "notes": "The direct loader (--load-format direct, bundles/direct) at tp4-ring with the weight digest; VLLM_PLUGINS names no plugin.",
 "extends": {
  "config": "config/cluster.json",
  "shape": "tp4-ring"
 },
 "set": {
  "environment": {
   "SPARK_DS41F_WEIGHT_DIGEST": "1",
   "VLLM_PLUGINS": ""
  },
  "container": {
   "mounts": [
    [
     "{checkout}/cache",
     "/cache",
     "rw"
    ],
    [
     "{checkout}/experiments/2026-10-25-final-names/loader/bundles/direct/overlay/vllm/config/load.py",
     "/opt/spark-ds41f/candidate/vllm/vllm/config/load.py",
     "ro"
    ],
    [
     "{checkout}/experiments/2026-10-25-final-names/loader/bundles/direct/overlay/vllm/model_executor/model_loader/__init__.py",
     "/opt/spark-ds41f/candidate/vllm/vllm/model_executor/model_loader/__init__.py",
     "ro"
    ],
    [
     "{checkout}/experiments/2026-10-25-final-names/loader/bundles/direct/overlay/vllm/model_executor/model_loader/base_loader.py",
     "/opt/spark-ds41f/candidate/vllm/vllm/model_executor/model_loader/base_loader.py",
     "ro"
    ],
    [
     "{checkout}/experiments/2026-10-25-final-names/loader/bundles/direct/overlay/vllm/model_executor/model_loader/direct_io/__init__.py",
     "/opt/spark-ds41f/candidate/vllm/vllm/model_executor/model_loader/direct_io/__init__.py",
     "ro"
    ],
    [
     "{checkout}/experiments/2026-10-25-final-names/loader/bundles/direct/overlay/vllm/model_executor/model_loader/direct_io/_batch.c",
     "/opt/spark-ds41f/candidate/vllm/vllm/model_executor/model_loader/direct_io/_batch.c",
     "ro"
    ],
    [
     "{checkout}/experiments/2026-10-25-final-names/loader/bundles/direct/overlay/vllm/model_executor/model_loader/direct_io/_bounce.c",
     "/opt/spark-ds41f/candidate/vllm/vllm/model_executor/model_loader/direct_io/_bounce.c",
     "ro"
    ],
    [
     "{checkout}/experiments/2026-10-25-final-names/loader/bundles/direct/overlay/vllm/model_executor/model_loader/direct_io/_checkpoint.py",
     "/opt/spark-ds41f/candidate/vllm/vllm/model_executor/model_loader/direct_io/_checkpoint.py",
     "ro"
    ],
    [
     "{checkout}/experiments/2026-10-25-final-names/loader/bundles/direct/overlay/vllm/model_executor/model_loader/direct_io/_cuda_range.h",
     "/opt/spark-ds41f/candidate/vllm/vllm/model_executor/model_loader/direct_io/_cuda_range.h",
     "ro"
    ],
    [
     "{checkout}/experiments/2026-10-25-final-names/loader/bundles/direct/overlay/vllm/model_executor/model_loader/direct_io/_direct.c",
     "/opt/spark-ds41f/candidate/vllm/vllm/model_executor/model_loader/direct_io/_direct.c",
     "ro"
    ],
    [
     "{checkout}/experiments/2026-10-25-final-names/loader/bundles/direct/overlay/vllm/model_executor/model_loader/direct_io/_native.py",
     "/opt/spark-ds41f/candidate/vllm/vllm/model_executor/model_loader/direct_io/_native.py",
     "ro"
    ],
    [
     "{checkout}/experiments/2026-10-25-final-names/loader/bundles/direct/overlay/vllm/model_executor/model_loader/direct_io/_storage.c",
     "/opt/spark-ds41f/candidate/vllm/vllm/model_executor/model_loader/direct_io/_storage.c",
