{
 "notes": "spark-ds41f-1030 with per-type L2 weight prefetch windows for owner (COMP/WO) and Engram (ENGRAM/NEXT) layers (vLLM 70d18e1a1; make_bundles.py).",
 "extends": {
  "config": "config/production-tp4.json"
 },
 "set": {
  "container": {
   "mounts": [
    [
     "{checkout}/cache",
     "/cache",
     "rw"
    ],
    [
     "{checkout}/experiments/2026-10-30-l2-prefetch-pertype/overlay/vllm/models/deepseek_v4_1/attention.py",
     "/opt/spark-ds41f/candidate/vllm/vllm/models/deepseek_v4_1/attention.py",
     "ro"
    ],
    [
     "{checkout}/experiments/2026-10-30-l2-prefetch-pertype/overlay/vllm/models/deepseek_v4_1/common/engram.py",
     "/opt/spark-ds41f/candidate/vllm/vllm/models/deepseek_v4_1/common/engram.py",
     "ro"
    ],
    [
     "{checkout}/experiments/2026-10-30-l2-prefetch-pertype/overlay/vllm/models/deepseek_v4_1/l2_prefetch.py",
     "/opt/spark-ds41f/candidate/vllm/vllm/models/deepseek_v4_1/l2_prefetch.py",
     "ro"
    ],
    [
     "{checkout}/experiments/2026-10-30-l2-prefetch-pertype/overlay/vllm/models/deepseek_v4_1/nvidia/model.py",
     "/opt/spark-ds41f/candidate/vllm/vllm/models/deepseek_v4_1/nvidia/model.py",
     "ro"
    ]
   ]
  }
 }
}
