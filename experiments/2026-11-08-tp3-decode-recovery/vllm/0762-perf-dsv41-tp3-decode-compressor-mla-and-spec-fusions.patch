+@pytest.mark.parametrize("device", [torch.device("cpu"), torch.device("cuda")])
+def test_step_fuses_dead_row_cut_sink_events_and_copy_state_filtering(device):
+    """Fused ``step`` filtering for dead-row cut, sink rejection, and CopyDrafter
+    slots matches explicit host/tensor pre-filtering on both CPU and CUDA."""
+    num_reqs = 4
+    est_fused = OnlineAcceptanceEstimator.for_confidence_head(8, NUM_STEPS, device)
+    est_ref = OnlineAcceptanceEstimator.for_confidence_head(8, NUM_STEPS, device)
+
+    feats = torch.tensor(
+        [
+            [1.2, 0.8, 0.4, -0.2],
+            [0.9, 0.5, 0.1, -0.5],
+            [1.5, 1.1, 0.7, 0.3],
+            [0.6, 0.2, -0.3, -0.8],
+        ],
+        dtype=torch.float32,
+        device=device,
+    )
+    preds = torch.sigmoid(feats)
+    for est in (est_fused, est_ref):
+        est.features[:num_reqs].copy_(feats)
+        est.predictions[:num_reqs].copy_(preds)
+
+    idx_mapping = torch.tensor([0, 1, 2, 3], dtype=torch.int32, device=device)
+    num_sampled = torch.tensor([2, 1, 3, 2], dtype=torch.int32, device=device)
+    num_rejected = torch.tensor([3, 4, 2, 3], dtype=torch.int32, device=device)
+    dead_row_cut = torch.tensor([2, 3, 3, 4], dtype=torch.int32, device=device)
+    # Req 1 had sink outcome REJECTED (code 2); Req 2 came from CopyDrafter (col 1 > 0)
+    sink_events = torch.tensor(
+        [[0, 0], [2, 0], [0, 0], [1, 0]], dtype=torch.int32, device=device
+    )
+    copy_int_state = torch.zeros((8, 4), dtype=torch.int32, device=device)
+    copy_int_state[2, 1] = 1
+
+    est_fused.step(
+        idx_mapping,
+        num_sampled,
+        num_rejected,
+        dead_row_cut=dead_row_cut,
+        sink_events=sink_events,
+        copy_int_state=copy_int_state,
+    )
+
+    ref_accepted = (num_sampled - 1).clamp_min(0)
+    ref_live_rejected = (dead_row_cut - ref_accepted).clamp_min(0)
+    ref_rejected = torch.minimum(num_rejected, ref_live_rejected)
+    ref_rejected = ref_rejected.masked_fill(sink_events[:, 0] == 2, 0)
+    ref_idx = torch.where(copy_int_state[idx_mapping, 1] > 0, -1, idx_mapping)
+    est_ref.step(ref_idx, num_sampled, ref_rejected)
+
+    torch.testing.assert_close(est_fused.info, est_ref.info)
+    torch.testing.assert_close(est_fused.grad, est_ref.grad)
+    torch.testing.assert_close(est_fused.counts, est_ref.counts)
