diff --git a/tests/kernels/test_deepseek_v41_tilelang_confidence.py b/tests/kernels/test_deepseek_v41_tilelang_confidence.py
index 05d1bec60..8f2d3a7d6 100644
--- a/tests/kernels/test_deepseek_v41_tilelang_confidence.py
+++ b/tests/kernels/test_deepseek_v41_tilelang_confidence.py
@@ -212,4 +212,65 @@ def test_declared_as_the_head_calls_it():
     with registry.activate():
         confidence.declare(HIDDEN, RANK)
     calls = list(prepare.declared_calls(registry))
-    assert calls == [(confidence.dspark_confidence_kernel, (HIDDEN, RANK), {})]
+    assert calls == [
+        (confidence.dspark_confidence_kernel, (HIDDEN, RANK), {}),
+        (confidence.dspark_confidence_calibrate_kernel, (HIDDEN, RANK, 5), {}),
+    ]
