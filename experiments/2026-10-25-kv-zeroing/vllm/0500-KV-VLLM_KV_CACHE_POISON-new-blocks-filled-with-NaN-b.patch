+        num_blocks=4,
+        kv_cache_tensors=[],
+        kv_cache_groups=[
+            KVCacheGroupSpec(
+                [name],
+                UniformTypeKVCacheSpecs(block_size=4, kv_cache_specs={name: spec}),
