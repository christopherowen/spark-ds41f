From 5cc36f7662f77330efe7d40c141e1d79d38e2c37 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Thu, 5 Nov 2026 23:01:29 +0000
Subject: [PATCH] fix: honor grouped expert GEMM prefill swizzle

The prefill plan passes a positive swizzle panel, but the kernel did not
apply it. Emit TileLang's block rasterization when requested, retaining
the panel-zero path. Cover emitted code for gather, TP4 tail, and TP3
aligned cases so numerical equality cannot mask a no-op option.

Upstream-base: 19f2c20ed4d6 (candidate-38 ordered series)
Prepared-base: 1f33102547e4da5c64712390604695d1abd577c4
Rationale: make the existing scheduling parameter effective.
Quality: route IDs, weights, reductions and arithmetic are unchanged in
source; GPU bit equality, batch invariance and model evaluation pending.
Tests: CPU TileLang lowering before/after, six cases each; diff check.
Pre-commit/ruff: existing baseline failures retained in experiment logs.
Upstream-status: experimental; no performance or promotion claim.
---
 .../moe/test_deepseek_v41_tilelang_moe.py     | 21 +++++++++++++++++++
 vllm/models/deepseek_v4_1/tilelang/moe.py     |  2 ++
 2 files changed, 23 insertions(+)

diff --git a/tests/kernels/moe/test_deepseek_v41_tilelang_moe.py b/tests/kernels/moe/test_deepseek_v41_tilelang_moe.py
index 281bcd09c..ed4477f5b 100644
--- a/tests/kernels/moe/test_deepseek_v41_tilelang_moe.py
+++ b/tests/kernels/moe/test_deepseek_v41_tilelang_moe.py
@@ -836,6 +836,27 @@ def test_narrow_and_wide_codes_give_the_uncoded_gemm_bits(rows, n, k, gather):
     )
 
 
+@pytest.mark.parametrize("gather,k", [(True, 512), (False, 576), (False, 768)])
+def test_grouped_gemm_emits_requested_prefill_swizzle(gather, k):
+    """Bit equality alone cannot detect a scheduling option that is ignored."""
+    for panel in (0, 3):
+        kernel = grouped_fp8_fp4_gemm(
+            32,
+            384,
+            k,
+            6,
+            gather,
+            64,
+            128,
+            coded_scales=True,
+            narrow_codes=True,
+            trigger_after_loop=True,
+            swizzle_panel=panel,
+        )
+        source = kernel.get_kernel_source()
+        assert ("rasterization2DRow<3>" in source) == (panel == 3)
+
+
 def test_grouped_fp8_fp4_gemm_defers_barrier_init_and_down_stages():
     """Empty CTAs return before barrier initialization, and decode down GEMMs use
     two stages (2 CTAs/SM) with identical bits to three stages."""
diff --git a/vllm/models/deepseek_v4_1/tilelang/moe.py b/vllm/models/deepseek_v4_1/tilelang/moe.py
index fc4eb8ff7..9754272a5 100644
--- a/vllm/models/deepseek_v4_1/tilelang/moe.py
+++ b/vllm/models/deepseek_v4_1/tilelang/moe.py
@@ -807,6 +807,8 @@ def grouped_fp8_fp4_gemm(
     @T.macro
     def body(A, SFA, B, BT, SFB, SFBase, Order, TileExpert, C, SFB8=None, Narrow=None):
         with T.Kernel(T.ceildiv(N, block_N), tiles, threads=threads) as (bx, t):
+            if swizzle_panel > 0:
+                T.use_swizzle(panel_size=swizzle_panel)
             if gather or trigger_after_loop:
                 if trigger_after_loop:
                     pdl.wait()
-- 
