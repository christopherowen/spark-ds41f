-def test_grouped_gemm_emits_requested_prefill_swizzle(gather, k):
-    """Bit equality alone cannot detect a scheduling option that is ignored."""
-    for panel in (0, 3):
-        kernel = grouped_fp8_fp4_gemm(
-            32,
-            384,
-            k,
-            6,
-            gather,
-            64,
