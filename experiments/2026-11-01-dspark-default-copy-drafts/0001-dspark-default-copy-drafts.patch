+def test_dspark_greedy_adaptive_verification_enables_copy_drafts_by_default(tmp_path):
+    from vllm.config import (
+        CompilationConfig,
+        ModelConfig,
+        ParallelConfig,
+        SchedulerConfig,
+        VllmConfig,
+    )
+
+    (tmp_path / "config.json").write_text(
+        json.dumps(
+            {**_OPT_CONFIG, "max_position_embeddings": 32768, "n_predict": BLOCK}
+        )
+    )
+    target = ModelConfig(
+        model=str(tmp_path), tokenizer_mode="skip", max_model_len=32768
+    )
+    spec = SpeculativeConfig(
+        model=str(tmp_path),
+        method="dspark",
+        num_speculative_tokens=BLOCK,
+        enable_adaptive_verification=True,
+        draft_sample_method="greedy",
+        target_model_config=target,
+        target_parallel_config=ParallelConfig(),
+    )
+    assert spec.copy_drafts == CopyDraftsConfig(
+        min_match=16, max_drafts=LOOKAHEAD, initial_drafts=8
+    )
+    assert spec.num_verification_tokens == LOOKAHEAD
+
+    non_adaptive = SpeculativeConfig(
+        model=str(tmp_path),
+        method="dspark",
+        num_speculative_tokens=BLOCK,
+        enable_adaptive_verification=False,
+        draft_sample_method="greedy",
+        target_model_config=target,
+        target_parallel_config=ParallelConfig(),
+    )
+    assert non_adaptive.copy_drafts is None
+
+    probabilistic = SpeculativeConfig(
+        model=str(tmp_path),
+        method="dspark",
+        num_speculative_tokens=BLOCK,
+        enable_adaptive_verification=True,
+        draft_sample_method="probabilistic",
+        target_model_config=target,
+        target_parallel_config=ParallelConfig(),
+    )
+    assert probabilistic.copy_drafts is None
+
+    tp3_ladder = [1, 2, 3, 4, 6, 8, 12, 16, 20, 24, 28, 32, 40, 48]
+    vllm_config = VllmConfig(
+        model_config=target,
+        speculative_config=spec,
+        scheduler_config=SchedulerConfig(
+            max_model_len=32768,
+            is_encoder_decoder=False,
+            max_num_seqs=8,
+            max_num_batched_tokens=6144,
+            long_prefill_token_threshold=6096,
+            async_scheduling=True,
+        ),
+        compilation_config=CompilationConfig(
+            max_cudagraph_capture_size=48,
+            cudagraph_capture_sizes=list(tp3_ladder),
+        ),
+    )
+    assert vllm_config.max_decode_rows == 59
+    assert vllm_config.scheduler_config.long_prefill_token_threshold == 6096
+    assert vllm_config.scheduler_config.max_num_batched_tokens == 6155
+    assert vllm_config.scheduler_config.max_num_scheduled_tokens == 6155
+    assert vllm_config.compilation_config.max_cudagraph_capture_size == 59
+    assert vllm_config.compilation_config.cudagraph_capture_sizes == [
+        *tp3_ladder,
+        56,
+        59,
+    ]
+
