+                    second = T.cast(k_y[last, 2 * j + 1], T.float32)
+                    cosine = cs[j]
+                    sine = cs[_VEC // 2 + j]
+                    k_y[last, 2 * j] = T.cast(
+                        T.ieee_fmaf(first, cosine, -(second * sine)), T.bfloat16
+                    )
+                    k_y[last, 2 * j + 1] = T.cast(
+                        T.ieee_fmaf(first, sine, second * cosine), T.bfloat16
+                    )
