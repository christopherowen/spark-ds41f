+    assert bool((out_lsa == -1).all().item())
+    if source:
+        assert bool((cand_lsa == -1).all().item())
+        assert bool((cand_len_lsa == 0).all().item())
+
+    lengths.copy_(saved_lengths)
+    graph.replay()
+    torch.cuda.synchronize()
+    assert torch.equal(out_lsa, eager_out)
