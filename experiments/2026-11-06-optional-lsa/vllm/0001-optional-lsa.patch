 @tilelang.jit
+def summarize_blocks(page: int, slot_dtype: str = 'int64'):
+    rows,pool_pages,stride = T.dynamic('rows, pool_pages, stride')
+    groups = (page//8)*4
+    assert page in (128,256)
+
+    @T.prim_func
+    def update(Pool: T.StridedTensor([pool_pages,page*STATE_BYTES],[stride,1],T.uint8),
+               Half: T.StridedTensor([pool_pages,page*STATE_BYTES//2],[stride//2,1],T.bfloat16),
+               Slots: T.Tensor([rows],slot_dtype)):
+        with T.Kernel(rows,threads=512) as row:
+            pdl.chain()
+            means = T.alloc_fragment([groups,32],T.float32)
+            slot = Slots[row]
+            if (slot >= 0) & (slot%page == page-1) & (slot//page < pool_pages):
+                physical = slot//page
+                T.fill(means,0.)
+                for k in T.serial(8):
+                    for g,i in T.Parallel(groups,32):
+                        d = (g%4)*32+i
+                        token = (g//4)*8+k
+                        means[g,i] += decode(Pool[physical,token*64+d//2],
+                            Pool[physical,page*64+token*4+g%4],d)*.125
+                for g,i in T.Parallel(groups,32):
+                    Half[physical,page*68//2+g*32+i] = T.cast(means[g,i],T.bfloat16)
+    return update
+
