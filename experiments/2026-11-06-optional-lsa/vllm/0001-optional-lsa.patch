+def test_lsa_opt_in_32k_to_1m_routing_and_metadata_wiring(monkeypatch):
+    from vllm.models.deepseek_v4_1.tilelang import attention as tl_attn
+    from vllm.models.deepseek_v4_1.tilelang.paged_shortlist import PageShortlistPlan
+
+    class DummyNativePlan:
+        def __init__(self, width, page, *, candidates=False, candidate_blocks=False):
+            self.kind = "native"
+            self.width = width
+            self.page = page
+            self.candidates = candidates
+            self.candidate_blocks = candidate_blocks
+
+        def scratch_specs(self, rows):
+            return (((rows, self.width), torch.int32),)
+
+    class DummyShortlistPlan(PageShortlistPlan):
+        def __init__(
+            self, width, page, *, candidate_blocks=False, budget=None, row_cap=256
+        ):
+            self.kind = "shortlist"
+            self.width = width
+            self.page = page
+            self.candidate_blocks = candidate_blocks
+            self.budget = budget or (512 if candidate_blocks else 64)
+            self.block_budget = self.budget * 8
+            self.row_cap = row_cap
+            self.coarse_kind = (
+                "RawWideCoarseTopK"
+                if self.block_budget == 8192 and width // 8 > 8192
+                else "DirectCoarseTopK"
+                if self.block_budget == 4096 and width // 8 > 4096
+                else "IndexerTopK"
+            )
+
+        def _specs(self, rows):
+            return {
+                "scratch": (
+                    (min(rows, self.row_cap), self.width, self.budget),
+                    torch.int32,
+                )
+            }
+
+    monkeypatch.setenv("VLLM_DS41_LSA", "1")
+    monkeypatch.setattr(tl_attn, "IndexerV41Plan", DummyNativePlan)
+    monkeypatch.setattr(tl_attn, "BlockMeanShortlistPlan", DummyShortlistPlan)
+    monkeypatch.setattr(
+        tl_attn,
+        "current_workspace_manager",
+        lambda: SimpleNamespace(get_simultaneous=lambda *specs: list(specs)),
+    )
+    monkeypatch.setattr(tl_attn, "retain_cuda_graph_capture_resource", lambda *a: None)
+    tl_attn._index_plan.cache_clear()
+    tl_attn._source_short_plan.cache_clear()
+
+    def build_layer(layer_id: int, compress_ratio: int, candidate_blocks: bool):
+        layer = tl_attn.DeepseekV41TileLangAttention.__new__(
+            tl_attn.DeepseekV41TileLangAttention
+        )
+        torch.nn.Module.__init__(layer)
+        layer.layer_id = layer_id
+        layer.candidate_source_layer = 20
+        layer.compress_ratio = compress_ratio
+        layer.is_ced_decoder = False
+        layer.is_index_source = candidate_blocks
+        layer.n_local_heads = 16
+        layer._index_page = 128 if compress_ratio == 2 else 256
+        layer._index_width = (
+            524288 if compress_ratio == 2 else 1048576
+        ) // layer._index_page
+        layer._short_index_shape = (256, 128) if compress_ratio == 2 else None
+        layer._main_page = 64
+        layer._main_width = 16
+        layer.swa_width = 16
+        layer.capacity = 8192
+        layer._decode_capacity = 96
+        layer.swa_cache_layer = SimpleNamespace(block_size=64, kv_cache=torch.zeros(4, 64 * 528, dtype=torch.uint8))
+        layer._owner = lambda: SimpleNamespace(kv_cache=torch.zeros(4, 64 * 288, dtype=torch.uint8))
+        layer.rotary_emb = SimpleNamespace(cos_sin_cache=torch.zeros(16, 64))
+        layer._attention_workspace_specs = {"decode": (), "prefill": ()}
+        layer.config = SimpleNamespace(
+            scheduler_config=SimpleNamespace(max_num_seqs=4),
+            speculative_config=None,
+            compilation_config=SimpleNamespace(max_cudagraph_capture_size=24),
+        )
+        layer.indexer = SimpleNamespace(
+            heads=32,
+            k_cache=SimpleNamespace(
+                kv_cache=torch.zeros(4, layer._index_page * 100, dtype=torch.uint8)
+            ),
+        )
+        layer._active = torch.tensor(
+            [layer._index_width * layer._index_page], dtype=torch.int32
+        )
+        layer.topk_indices_buffer = torch.zeros(256, 512, dtype=torch.int32)
+        monkeypatch.setattr(
+            tl_attn,
+            "_mla_plan",
+            lambda *args: SimpleNamespace(
+                max_rows=8192, decode_max_rows=96, scratch_specs=lambda r: ()
+            ),
+        )
+        layer._tilelang_plans = layer._build_tilelang_plans()
+        return layer
+
+    dense_layer = build_layer(layer_id=2, compress_ratio=2, candidate_blocks=False)
+    source_layer = build_layer(layer_id=20, compress_ratio=1, candidate_blocks=True)
+
+    def dispatch(layer, mode: str, rows: int, score_width: int | None):
+        chosen = {}
+        plans = layer._tilelang()
+        all_plans = [
+            *plans.index.values(),
+            *plans.native_index.values(),
+            *([plans.source_short] if plans.source_short is not None else []),
+        ]
+        for p in all_plans:
+            p.run = lambda *a, _p=p, **kw: chosen.setdefault(
+                "plan",
+                (
+                    _p.kind,
+                    _p.width,
+                    getattr(_p, "budget", None),
+                    getattr(_p, "coarse_kind", None),
+                ),
+            )
+        q = torch.zeros(rows, 32, 64, dtype=torch.uint8)
+        s = torch.zeros(rows, 32, dtype=torch.float32)
+        w = torch.zeros(rows, 32, dtype=torch.bfloat16)
+        pages = torch.zeros(rows, 16, dtype=torch.int32)
+        lengths = torch.full((rows,), score_width or 32768, dtype=torch.int32)
+        out = torch.zeros(rows, 512, dtype=torch.int32)
+        layer._index_chunk(
+            mode,
+            rows,
+            output_indices=out,
+            q_mxfp4=q,
+            q_scales=s,
+            query_weights=w,
+            page_table=pages,
+            cache_lengths=lengths,
+            score_width=score_width,
+        )
+        return chosen["plan"]
+
+    # Dense layer routing across 4K..1M
+    assert dispatch(dense_layer, "prefill_short", 64, 2048) == (
+        "native",
+        16384,
+        None,
+        None,
+    )
+    assert dispatch(dense_layer, "prefill_short", 64, 4096) == (
+        "native",
+        16384,
+        None,
+        None,
+    )
+    assert dispatch(dense_layer, "prefill_short", 64, 8192) == (
+        "shortlist",
+        16384,
+        64,
+        "IndexerTopK",
+    )
+    assert dispatch(dense_layer, "prefill_short", 64, 16384) == (
+        "shortlist",
+        16384,
+        64,
+        "IndexerTopK",
+    )
+    assert dispatch(dense_layer, "prefill_short", 8, 16384) == (
+        "shortlist",
+        16384,
+        64,
+        "IndexerTopK",
+    )
+    assert dispatch(dense_layer, "decode", 1, 16384) == ("native", 524288, None, None)
+    for tokens in (65536, 131072, 262144, 524288, 1048576):
+        sw = tokens // 2
+        assert dispatch(dense_layer, "prefill", 64, sw) == (
+            "shortlist",
+            524288,
+            64,
+            "IndexerTopK",
+        )
+        assert dispatch(dense_layer, "decode", 8, sw) == (
+            "shortlist",
+            524288,
+            64,
+            "IndexerTopK",
+        )
+
+    # Source layer (layer 20) routing across 32K..1M
+    assert dispatch(source_layer, "prefill", 64, 32768) == (
+        "native",
+        1048576,
+        None,
