+def test_lsa_opt_in_kv_cache_spec_and_plan_registration(monkeypatch):
+    from vllm.models.deepseek_v4_1.attention import _Cache
+    from vllm.models.deepseek_v4_1.tilelang import attention as tl_attn
+    from vllm.models.deepseek_v4_1.tilelang.block_shortlist import (
+        STATE_BYTES,
+        summarize_blocks,
+    )
+    from vllm.models.deepseek_v4_1.tilelang.indexer import IndexerV41Plan, page_bytes
+    from vllm.models.deepseek_v4_1.tilelang.paged_shortlist import PageShortlistPlan
+    from vllm.models.deepseek_v4_1.tilelang.query_reuse import QueryReusePlan
+
+    monkeypatch.setenv("VLLM_DS41_LSA", "1")
+    tl_attn._index_plan.cache_clear()
+    tl_attn._source_short_plan.cache_clear()
+
+    assert tl_attn._lsa_enabled()
+    assert STATE_BYTES == 100
+    assert issubclass(QueryReusePlan, PageShortlistPlan)
+
+    dummy_index_cache = SimpleNamespace(
+        block_size=128,
+        kind="index",
+        ratio=2,
+        window=0,
+        draft=False,
+        prefix="model.layers.2.indexer",
+    )
+    index_spec = _Cache.get_kv_cache_spec(
+        dummy_index_cache, SimpleNamespace(model_config=None)
+    )
+    assert index_spec.state_content_bytes == 100
+
+    assert tl_attn._shortlist_options(4096, False, False) is None
+    assert tl_attn._shortlist_options(16384, False, False) == {
+        "candidate_blocks": False,
+        "budget": 64,
+        "row_cap": 256,
+    }
+    assert tl_attn._shortlist_options(524288, True, False) is None
+    assert tl_attn._shortlist_options(65536, False, True) is None
+    assert tl_attn._shortlist_options(1048576, False, True) == {
+        "candidate_blocks": True,
+        "budget": 1024,
+        "row_cap": 256,
+    }
+    assert tl_attn._source_short_options(1048576, False, True) == {
+        "candidate_blocks": True,
+        "budget": 512,
+        "row_cap": 256,
+    }
+
+    dense_calls = tl_attn._index_calls(524288, 128, False, False)
+    expected_dense = [
+        *QueryReusePlan.calls(
+            524288, 128, candidate_blocks=False, budget=64, row_cap=256
+        ),
+        *IndexerV41Plan.calls(524288, 128, candidates=False, candidate_blocks=False),
+    ]
+    assert dense_calls == expected_dense
+
+    source_calls = tl_attn._index_calls(1048576, 256, False, True)
+    expected_source = [
+        *QueryReusePlan.calls(
+            1048576, 256, candidate_blocks=True, budget=1024, row_cap=256
+        ),
+        *IndexerV41Plan.calls(1048576, 256, candidates=False, candidate_blocks=True),
+        *QueryReusePlan.calls(
+            1048576, 256, candidate_blocks=True, budget=512, row_cap=256
+        ),
+    ]
+    assert source_calls == expected_source
+
+    # Verify _check_cache_pages and _write_index_keys wiring on DeepseekV41TileLangAttention
+    layer = tl_attn.DeepseekV41TileLangAttention.__new__(
+        tl_attn.DeepseekV41TileLangAttention
+    )
+    torch.nn.Module.__init__(layer)
+    layer.prefix = "model.layers.2.attn"
+    layer.is_ced_decoder = False
+    layer._main_page = 64
+    layer.swa_cache_layer = SimpleNamespace(
+        kv_cache=torch.zeros(4, 64 * 528, dtype=torch.uint8), block_size=64
+    )
+    layer._owner = lambda: SimpleNamespace(
+        kv_cache=torch.zeros(4, 64 * 288, dtype=torch.uint8)
+    )
+    layer.compressor = SimpleNamespace()
+    layer._index_page = 128
+    layer.compress_ratio = 2
+    layer.rotary_emb = SimpleNamespace(cos_sin_cache=torch.zeros(16, 64))
+    layer.indexer = SimpleNamespace(
+        k_norm=SimpleNamespace(weight=torch.ones(128), variance_epsilon=1e-6),
+        k_cache=SimpleNamespace(
+            kv_cache=torch.zeros(4, 128 * 100, dtype=torch.uint8)
+        ),
+    )
+    layer._check_cache_pages()
+
+    monkeypatch.setenv("VLLM_DS41_LSA", "0")
+    layer.indexer.k_cache.kv_cache = torch.zeros(
+        4, page_bytes(128), dtype=torch.uint8
+    )
+    layer._check_cache_pages()
+
+    writes = []
+    summaries = []
+    monkeypatch.setattr(
+        tl_attn,
+        "norm_rope_write_index_keys",
+        lambda *args: writes.append(("norm_rope", len(args))),
+    )
+    monkeypatch.setattr(
+        tl_attn,
+        "write_index_keys",
+        lambda *args: writes.append(("direct", len(args))),
+    )
+    layer._page_summary = lambda pool, half, slots: summaries.append(
+        (pool.shape, half.dtype, tuple(slots.tolist()))
+    )
+    slots = torch.tensor([127, 255], dtype=torch.int64)
+    positions = torch.tensor([0, 1], dtype=torch.int64)
+    layer._write_index_keys(
+        torch.zeros(2, 128, dtype=torch.bfloat16), slots, positions=positions
+    )
+    layer._write_index_keys(
+        torch.zeros(2, 128, dtype=torch.bfloat16), slots, positions=None
+    )
+    assert writes == [("norm_rope", 9), ("direct", 4)]
+    assert len(summaries) == 2
+    assert all(
+        dtype == torch.bfloat16 and s == (127, 255) for _, dtype, s in summaries
+    )
+    assert summarize_blocks is not None
+
