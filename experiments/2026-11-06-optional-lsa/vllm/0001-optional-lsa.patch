+@pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA required")
+def test_lsa_gpu_summarize_blocks_and_freeze_registration():
+    import tilelang
+    from vllm.models.deepseek_v4_1.tilelang import prepare
+    from vllm.models.deepseek_v4_1.tilelang.block_shortlist import (
+        STATE_BYTES,
+        summarize_blocks,
+    )
+    from vllm.models.deepseek_v4_1.tilelang.query_reuse import QueryReusePlan
+
+    cases = [
+        (16384, 128, False, 64),
+        (65536, 256, True, 512),
+        (131072, 256, True, 1024),
+    ]
+    calls = [prepare.call(summarize_blocks, 128), prepare.call(summarize_blocks, 256)]
+    for width, page, source, budget in cases:
+        calls.extend(
+            QueryReusePlan.calls(width, page, candidate_blocks=source, budget=budget)
+        )
+    tilelang.prepare(calls, num_workers=4)
+
+    gen = torch.Generator(device="cuda").manual_seed(20261106)
+    for page in (128, 256):
+        num_pages = 6
+        pool = torch.zeros(
+            num_pages, page * STATE_BYTES + 128, dtype=torch.uint8, device="cuda"
+        )[:, : page * STATE_BYTES]
+        pool[:, : page * 64] = torch.randint(
+            0,
+            256,
+            (num_pages, page * 64),
+            generator=gen,
+            dtype=torch.int32,
+            device="cuda",
+        ).to(torch.uint8)
+        pool[:, page * 64 : page * 68] = torch.randint(
+            120,
+            132,
+            (num_pages, page * 4),
+            generator=gen,
+            dtype=torch.int32,
+            device="cuda",
+        ).to(torch.uint8)
+
+        # Complete pages 0, 2, 4; page 1 has non-terminal slot; page 3 is untouched.
+        slots = torch.tensor(
+            [page - 1, page + 5, 2 * page + page - 1, -1, 4 * page + page - 1],
+            dtype=torch.int64,
+            device="cuda",
+        )
+        summarize_blocks(page)(pool, pool.view(torch.bfloat16), slots)
+        ref = _decode_mxfp4_pages_reference(pool, page)
+        actual = pool.view(torch.bfloat16)[:, page * 68 // 2 : page * 100 // 2].view(
+            num_pages, page // 8, 128
+        )
+        for p_idx in (0, 2, 4):
+            assert torch.equal(actual[p_idx], ref[p_idx])
+        for p_idx in (1, 3, 5):
+            assert torch.count_nonzero(actual[p_idx]) == 0
