+@pytest.mark.parametrize("env_val", [None, "0"])
+def test_lsa_default_off_kv_cache_spec_and_plans(monkeypatch, env_val):
+    from vllm.models.deepseek_v4_1.attention import _Cache
+    from vllm.models.deepseek_v4_1.tilelang import attention as tl_attn
+    from vllm.models.deepseek_v4_1.tilelang.indexer import IndexerV41Plan
+    from vllm.models.deepseek_v4_1.tilelang.paged_shortlist import PageShortlistPlan
+
+    if env_val is None:
+        monkeypatch.delenv("VLLM_DS41_LSA", raising=False)
+    else:
+        monkeypatch.setenv("VLLM_DS41_LSA", env_val)
+    tl_attn._index_plan.cache_clear()
+    tl_attn._source_short_plan.cache_clear()
+
+    assert not tl_attn._lsa_enabled()
+
+    dummy_index_cache = SimpleNamespace(
+        block_size=128,
+        kind="index",
+        ratio=2,
+        window=0,
+        draft=False,
+        prefix="model.layers.2.indexer",
+    )
+    index_spec = _Cache.get_kv_cache_spec(
+        dummy_index_cache, SimpleNamespace(model_config=None)
+    )
+    assert index_spec.state_content_bytes == 68
+
+    dummy_swa_cache = SimpleNamespace(
+        block_size=64,
+        kind="swa",
+        ratio=1,
+        window=512,
+        draft=False,
+        prefix="model.layers.2.swa",
+    )
+    swa_spec = _Cache.get_kv_cache_spec(
+        dummy_swa_cache,
+        SimpleNamespace(
+            model_config=SimpleNamespace(
+                hf_config=SimpleNamespace(num_hidden_layers=61)
+            )
+        ),
+    )
+    assert swa_spec.state_content_bytes == 528
+
+    for args in (
+        (16384, 128, False, False),
+        (524288, 128, False, False),
+        (1048576, 256, False, True),
+    ):
+        assert tl_attn._shortlist_options(args[0], args[2], args[3]) is None
+        assert tl_attn._source_short_options(args[0], args[2], args[3]) is None
+        assert tl_attn._source_short_plan(*args) is None
+        assert tl_attn._index_calls(*args) == IndexerV41Plan.calls(
+            args[0], args[1], candidates=args[2], candidate_blocks=args[3]
+        )
+
+    monkeypatch.setattr(
+        tl_attn,
+        "IndexerV41Plan",
+        lambda width, page, *, candidates=False, candidate_blocks=False: SimpleNamespace(
+            kind="native",
+            width=width,
+            page=page,
+            candidates=candidates,
+            candidate_blocks=candidate_blocks,
+        ),
+    )
+    tl_attn._index_plan.cache_clear()
+    for args in (
+        (16384, 128, False, False),
+        (524288, 128, False, False),
+        (1048576, 256, False, True),
+    ):
+        plan = tl_attn._index_plan(*args)
+        assert not isinstance(plan, PageShortlistPlan)
+        assert plan.kind == "native"
+
