+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Unit and GPU tests for opt-in VLLM_DS41_LSA BF16 block8 shortlist indexing."""
+
+import ast
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+
+def _tilelang_dir() -> Path:
+    import vllm.models.deepseek_v4_1.tilelang.attention as tl_attn
+
+    return Path(tl_attn.__file__).resolve().parent
+
+
+def _has_pdl_chain(tree: ast.AST, fn_name: str) -> bool:
+    fn = next(
+        n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == fn_name
+    )
+    for call in ast.walk(fn):
+        if (
+            isinstance(call, ast.Call)
+            and isinstance(call.func, ast.Attribute)
+            and isinstance(call.func.value, ast.Name)
+            and call.func.value.id == "pdl"
+            and call.func.attr == "chain"
+        ):
+            return True
+    return False
+
+
+def test_lsa_module_cleanliness_and_pdl_invariants():
+    tl_dir = _tilelang_dir()
+    assert not (tl_dir / "direct_shortlist.py").exists()
+    assert not (tl_dir / "compact_shortlist.py").exists()
+
+    si_text = (tl_dir / "shortlist_indexer.py").read_text()
+    si_tree = ast.parse(si_text)
+    si_defs = {
+        n.name
+        for n in si_tree.body
+        if isinstance(n, (ast.FunctionDef, ast.ClassDef))
+    }
+    assert si_defs == {"decode", "remap_blocks"}
+    for removed in (
+        "ShortlistPlan",
+        "centroid_scores",
+        "shortlist_flags",
+        "shortlist_prefix",
+        "shortlist_scatter",
+    ):
+        assert removed not in si_text
+
+    ps_text = (tl_dir / "paged_shortlist.py").read_text()
+    ps_tree = ast.parse(ps_text)
+    ps_defs = {
+        n.name
+        for n in ps_tree.body
+        if isinstance(n, (ast.FunctionDef, ast.ClassDef))
+    }
+    assert ps_defs == {"PageShortlistPlan"}
+    for removed in ("summarize_pages", "page_scores", "page_flags"):
+        assert removed not in ps_text
+
+    bs_text = (tl_dir / "block_shortlist.py").read_text()
+    qr_text = (tl_dir / "query_reuse.py").read_text()
+    cm_text = (tl_dir / "coarse_merge.py").read_text()
+    rw_text = (tl_dir / "raw_wide_coarse.py").read_text()
+    wt_text = (tl_dir / "wide_topk_merge.py").read_text()
+
+    assert "summarize_blocks_reference" not in bs_text
+    for forbidden in (
+        "_e2m1_code",
+        "_mxfp4_byte",
+        "quantize_mxfp4",
+        "CompactShortlistPlan",
+        "summarize_compact",
+    ):
+        assert forbidden not in bs_text
+        assert forbidden not in qr_text
+
+    bs_tree = ast.parse(bs_text)
+    qr_tree = ast.parse(qr_text)
+    cm_tree = ast.parse(cm_text)
+    rw_tree = ast.parse(rw_text)
+    wt_tree = ast.parse(wt_text)
+
+    assert _has_pdl_chain(bs_tree, "summarize_blocks")
+    assert _has_pdl_chain(bs_tree, "block_scores")
+    assert _has_pdl_chain(bs_tree, "block_candidates")
+    assert _has_pdl_chain(qr_tree, "prepared_scores")
+    assert _has_pdl_chain(qr_tree, "prepare_queries")
+    assert _has_pdl_chain(si_tree, "remap_blocks")
+    assert _has_pdl_chain(cm_tree, "raw_pair")
+    assert _has_pdl_chain(rw_tree, "raw_wide_pair")
+    assert _has_pdl_chain(wt_tree, "wide_indexer_topk_merge")
+
+    sb_fn = next(
+        n
+        for n in bs_tree.body
+        if isinstance(n, ast.FunctionDef) and n.name == "summarize_blocks"
+    )
+    threads_vals = [
+        kw.value.value
+        for call in ast.walk(sb_fn)
+        if isinstance(call, ast.Call)
+        for kw in call.keywords
+        if kw.arg == "threads" and isinstance(kw.value, ast.Constant)
+    ]
+    assert threads_vals == [512]
+
