+            "decode",
+            rows,
+            output_indices=out_lsa,
+            q_mxfp4=q,
+            q_scales=s,
+            query_weights=w,
+            page_table=table,
+            cache_lengths=lengths,
+            score_width=None,
+            candidate_output=cand_lsa,
