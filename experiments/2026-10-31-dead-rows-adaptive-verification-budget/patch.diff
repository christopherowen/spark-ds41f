+def test_dead_rows_tau_trims_cpu_budget_below_survival_cut():
+    """Draft slots whose survival falls below ``dead_rows_tau`` are truncated to ``-1``
+    placeholders on device and cannot commit tokens, so CPU budgeting excludes them
+    from the selected graph shape while keeping the periodic exploration probe."""
+    # Survival is [0.8, 0.4, 0.2, 0.1]. At row_cost=0.02 without dead_rows_tau,
+    # all 4 drafts would be admitted; with dead_rows_tau=0.25, only the first 2
+    # survive the cut.
+    manager = make_manager(
+        np.array([[0.8, 0.5, 0.5, 0.5]], dtype=np.float32), row_cost=0.02
+    )
+    manager.dead_rows_tau = 0.0
+    assert manager.get_num_tokens({"low": 5}, {"low": [1, 2, 3, 4]}) == 5
+    assert manager._batch_budget[2] == 4
+
+    manager.dead_rows_tau = 0.25
+    assert manager.get_num_tokens({"low": 5}, {"low": [1, 2, 3, 4]}) == 3
+    assert manager._batch_budget[2] == 2
+
+    # When all slots fall below dead_rows_tau, the periodic exploration probe still
+    # fires after EXPLORE_AFTER_IDLE_STEPS empty budgets.
+    manager.dead_rows_tau = 0.9
+    idle = getattr(adaptive_module, "EXPLORE_AFTER_IDLE_STEPS", 32)
+    budgets = []
+    for _ in range(idle):
+        manager.get_num_tokens({"low": 5}, {"low": [1, 2, 3, 4]})
+        budgets.append(manager._batch_budget[2])
+    assert budgets == [0] * (idle - 1) + [1]
