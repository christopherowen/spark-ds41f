+@T.macro
+def _post_collapse_rows(
+    x,
+    residual,
+    post,
+    comb,
+    mix,
+    out,
+    ov,
+    token,
+    col,
+    tx,
+    reserve,
+):
+    """Fold ``x`` into ``residual`` in registers (``post_streams``' arithmetic) and
+    collapse those updated streams with ``mix`` into ``out`` (``collapse_streams``'
+    arithmetic). Leaves the updated BF16 streams in ``ov``."""
+    xv = T.alloc_local((VEC,), T.bfloat16)
+    rv = T.alloc_local((MULT * VEC,), T.bfloat16)
+    out_v = T.alloc_local((VEC,), T.bfloat16)
+    pm = T.alloc_local((MULT,), T.float32)
+    cm = T.alloc_local((MULT * MULT,), T.float32)
+    mv = T.alloc_local((MULT,), T.float32)
+    acc = T.alloc_var(T.float32)
+    if tx == 0:
+        reserve[0] = T.float32(0)
+    for n in T.vectorized(MULT):
+        pm[n] = post[token, n]
+    for m in T.unroll(MULT):
+        for n in T.vectorized(MULT):
+            cm[m * MULT + n] = comb[token, m, n]
+    for m in T.vectorized(MULT):
+        mv[m] = mix[token, m]
+    for v in T.vectorized(VEC):
+        xv[v] = x[token, col + v]
+    for m in T.unroll(MULT):
+        for v in T.vectorized(VEC):
+            rv[m * VEC + v] = residual[token, m, col + v]
+    for n in T.unroll(MULT):
+        for v in T.unroll(VEC):
+            acc = cm[n] * T.Cast(T.float32, rv[v])
+            acc = T.fma(pm[n], T.Cast(T.float32, xv[v]), acc)
+            for m in T.unroll(1, MULT):
+                acc = T.fma(
+                    cm[m * MULT + n], T.Cast(T.float32, rv[m * VEC + v]), acc
+                )
+            ov[n * VEC + v] = T.Cast(T.bfloat16, acc)
+    for v in T.unroll(VEC):
+        acc = T.float32(0)
+        for m in T.unroll(MULT):
+            acc = T.fma(mv[m], T.Cast(T.float32, ov[m * VEC + v]), acc)
+        out_v[v] = T.Cast(T.bfloat16, acc)
+    for v in T.vectorized(VEC):
+        out[token, col + v] = out_v[v]
+
+
+@T.macro
+def _collapse_mean_from_local(ov, aux_out, token, col):
+    """Collapse the register streams ``ov`` with the uniform 1/4 mean into
+    ``aux_out``, matching ``collapse_streams`` with ``_constant_mixes``' mean."""
+    aux_v = T.alloc_local((VEC,), T.bfloat16)
+    acc = T.alloc_var(T.float32)
+    for v in T.unroll(VEC):
+        acc = T.float32(0)
+        for m in T.unroll(MULT):
+            acc = T.fma(T.float32(0.25), T.Cast(T.float32, ov[m * VEC + v]), acc)
+        aux_v[v] = T.Cast(T.bfloat16, acc)
+    for v in T.vectorized(VEC):
+        aux_out[token, col + v] = aux_v[v]
+
+
+@tilelang.jit(pass_configs=_PASS_CONFIGS)
+def post_collapse_streams(
+    hidden_size: int,
+    threads: int = 128,
+    column: int = -1,
+    dual_out: bool = False,
+):
+    """Fused ``post_streams`` followed by ``collapse_streams`` in one launch without
+    materializing the intermediate ``[M, MULT, hidden_size]`` stream tensor in HBM.
+
+    When ``dual_out`` is True, also writes the uniform-mean collapse into ``aux_out``
+    from the same register streams (for the final decoder layer when it is also an
+    auxiliary hidden state layer). With ``column >= 0``, also writes each reconstructed
+    stream's ``column`` as FP32 to ``columns``."""
+    assert hidden_size % (threads * VEC) == 0
+    assert column < hidden_size
+    blocks = hidden_size // (threads * VEC)
+    M = T.dynamic("M")
+
+    if not dual_out and column < 0:
+
+        @T.prim_func
+        def mhc_post_collapse(
+            x: T.Tensor((M, hidden_size), T.bfloat16),
+            residual: T.Tensor((M, MULT, hidden_size), T.bfloat16),
+            post: T.Tensor((M, MULT), T.float32),
+            comb: T.Tensor((M, MULT, MULT), T.float32),
+            mix: T.Tensor((M, MULT), T.float32),
+            out: T.Tensor((M, hidden_size), T.bfloat16),
+        ):
+            with T.Kernel(M * blocks, threads=threads) as pid:
+                pdl.chain()
+                tx = T.get_thread_binding()
+                ov = T.alloc_local((MULT * VEC,), T.bfloat16)
+                reserve = T.alloc_shared((_COLLAPSE_RESERVE // 4,), T.float32)
+                _post_collapse_rows(
+                    x,
+                    residual,
+                    post,
+                    comb,
+                    mix,
+                    out,
+                    ov,
+                    pid // blocks,
+                    (pid % blocks * threads + tx) * VEC,
+                    tx,
+                    reserve,
+                )
+
+        return mhc_post_collapse
+
+    if dual_out and column < 0:
+
+        @T.prim_func
+        def mhc_post_collapse_dual(
+            x: T.Tensor((M, hidden_size), T.bfloat16),
+            residual: T.Tensor((M, MULT, hidden_size), T.bfloat16),
+            post: T.Tensor((M, MULT), T.float32),
+            comb: T.Tensor((M, MULT, MULT), T.float32),
+            mix: T.Tensor((M, MULT), T.float32),
+            out: T.Tensor((M, hidden_size), T.bfloat16),
+            aux_out: T.Tensor((M, hidden_size), T.bfloat16),
+        ):
+            with T.Kernel(M * blocks, threads=threads) as pid:
+                pdl.chain()
+                tx = T.get_thread_binding()
+                ov = T.alloc_local((MULT * VEC,), T.bfloat16)
+                reserve = T.alloc_shared((_COLLAPSE_RESERVE // 4,), T.float32)
+                token = pid // blocks
+                col = (pid % blocks * threads + tx) * VEC
+                _post_collapse_rows(
+                    x,
+                    residual,
+                    post,
+                    comb,
+                    mix,
+                    out,
+                    ov,
+                    token,
+                    col,
+                    tx,
+                    reserve,
+                )
+                _collapse_mean_from_local(ov, aux_out, token, col)
+
+        return mhc_post_collapse_dual
+
+    column_block = column // (threads * VEC)
+    column_thread = column % (threads * VEC) // VEC
+    column_element = column % VEC
+
+    if not dual_out:
+
+        @T.prim_func
+        def mhc_post_collapse_column(
+            x: T.Tensor((M, hidden_size), T.bfloat16),
+            residual: T.Tensor((M, MULT, hidden_size), T.bfloat16),
+            post: T.Tensor((M, MULT), T.float32),
+            comb: T.Tensor((M, MULT, MULT), T.float32),
+            mix: T.Tensor((M, MULT), T.float32),
+            out: T.Tensor((M, hidden_size), T.bfloat16),
+            columns: T.Tensor((M, MULT), T.float32),
+        ):
+            with T.Kernel(M * blocks, threads=threads) as pid:
+                pdl.chain()
+                tx = T.get_thread_binding()
+                ov = T.alloc_local((MULT * VEC,), T.bfloat16)
+                reserve = T.alloc_shared((_COLLAPSE_RESERVE // 4,), T.float32)
+                _post_collapse_rows(
+                    x,
+                    residual,
+                    post,
+                    comb,
+                    mix,
+                    out,
+                    ov,
+                    pid // blocks,
+                    (pid % blocks * threads + tx) * VEC,
+                    tx,
+                    reserve,
+                )
+                if (pid % blocks == column_block) & (tx == column_thread):
+                    for m in T.unroll(MULT):
+                        columns[pid // blocks, m] = T.Cast(
+                            T.float32, ov[m * VEC + column_element]
+                        )
+
+        return mhc_post_collapse_column
+
+    @T.prim_func
+    def mhc_post_collapse_dual_column(
+        x: T.Tensor((M, hidden_size), T.bfloat16),
+        residual: T.Tensor((M, MULT, hidden_size), T.bfloat16),
+        post: T.Tensor((M, MULT), T.float32),
+        comb: T.Tensor((M, MULT, MULT), T.float32),
+        mix: T.Tensor((M, MULT), T.float32),
+        out: T.Tensor((M, hidden_size), T.bfloat16),
+        aux_out: T.Tensor((M, hidden_size), T.bfloat16),
+        columns: T.Tensor((M, MULT), T.float32),
+    ):
+        with T.Kernel(M * blocks, threads=threads) as pid:
+            pdl.chain()
+            tx = T.get_thread_binding()
+            ov = T.alloc_local((MULT * VEC,), T.bfloat16)
+            reserve = T.alloc_shared((_COLLAPSE_RESERVE // 4,), T.float32)
+            token = pid // blocks
+            col = (pid % blocks * threads + tx) * VEC
+            _post_collapse_rows(
+                x,
+                residual,
+                post,
+                comb,
+                mix,
+                out,
+                ov,
+                token,
+                col,
+                tx,
+                reserve,
+            )
+            _collapse_mean_from_local(ov, aux_out, token, col)
+            if (pid % blocks == column_block) & (tx == column_thread):
+                for m in T.unroll(MULT):
+                    columns[token, m] = T.Cast(
+                        T.float32, ov[m * VEC + column_element]
+                    )
+
+    return mhc_post_collapse_dual_column
+
