diff --git a/tests/models/test_deepseek_v4_1_attention.py b/tests/models/test_deepseek_v4_1_attention.py
index 373bcc2e0..c138e82c7 100644
--- a/tests/models/test_deepseek_v4_1_attention.py
+++ b/tests/models/test_deepseek_v4_1_attention.py
@@ -180,3 +180,86 @@ def test_decode_front_is_one_kernel_at_decode_rows(monkeypatch):
     metadata = None
     assert module._front(torch.zeros(6, 1792), positions, None) is None
     assert len(launches) == 1
+
+
+def test_wo_l2_prefetch_issues_after_indexing_and_metadata(monkeypatch):
+    """The WO L2 prefetch window issues immediately before ``_attend`` (after
+    indexing and metadata preparation), so it neither evicts ``NEXT``'s indexer
+    weights nor contends with latency-bound sparse-MLA preparation kernels."""
+    from vllm.models.deepseek_v4_1 import attention, l2_prefetch
+    from vllm.models.deepseek_v4_1.tilelang import metadata as tl_metadata
+
+    monkeypatch.setattr(torch.cuda, "is_current_stream_capturing", lambda: False)
+    events = []
+    monkeypatch.setattr(
+        tl_metadata,
+        "pages",
+        lambda *args, **kwargs: events.append("index_pages"),
+    )
+    monkeypatch.setattr(
+        l2_prefetch,
+        "issue",
+        lambda plan, rows: events.append(("l2pf", plan, rows)),
+    )
+    monkeypatch.setattr(
+        attention,
+        "current_workspace_manager",
+        lambda: SimpleNamespace(
+            get_simultaneous=lambda *specs: [torch.zeros(s, dtype=dt) for s, dt in specs]
+        ),
+    )
+
+    layer = _tilelang_layer(layer_id=2)
+    layer.is_draft = False
+    layer._draft_replays = False
+    layer._draft_replay_start = None
+    layer.window_size = 128
+    layer.swa_cache_layer = SimpleNamespace(prefix="swa", block_size=64)
+    layer._owner = lambda: SimpleNamespace(prefix="main")
+    layer.index_source_layer_id = 2
+    layer.indexer = SimpleNamespace(heads=32, k_cache=SimpleNamespace(prefix="idx"))
+    layer._l2pf_wo = "wo_plan"
+    layer._attention_geometry()
+    layer._prepare("cpu")
+    layer._check_attention_rows = lambda mode, rows: None
+    layer._attention_scratch_specs = lambda mode, rows: (((rows, 4), torch.uint8),)
+    layer._index_chunk = lambda *args, **kwargs: events.append("index_chunk")
+    layer._write_decode_metadata = lambda *args, **kwargs: events.append("write_meta")
+    layer._attend = lambda *args, **kwargs: events.append("attend")
+    layer._context = {layer.prefix: layer}
+
+    swa_meta = SimpleNamespace(
+        is_decode=True, num_decode_tokens=0, swa_replay_start=None
+    )
+    main_meta = SimpleNamespace()
+    index_meta = SimpleNamespace(
+        req_id_per_token=torch.zeros(6, dtype=torch.int32),
+        cache_lengths=torch.ones(6, dtype=torch.int32),
+        block_table=torch.zeros((1, 4), dtype=torch.int32),
+        max_seq_len=128,
+    )
+    forward_ctx = SimpleNamespace(
+        attn_metadata={"swa": swa_meta, "main": main_meta, "idx": index_meta}
+    )
+    monkeypatch.setattr(attention, "get_forward_context", lambda: forward_ctx)
+
+    rows = 6
+    q = torch.zeros((rows, 4, 512))
+    kv = torch.zeros((rows, 512))
+    positions = torch.zeros(rows, dtype=torch.int64)
+    output = torch.zeros_like(q)
+    iq = (
+        torch.zeros((rows, 32, 64), dtype=torch.uint8),
+        torch.zeros((rows, 32, 4), dtype=torch.uint8),
+        torch.zeros((rows, 32), dtype=torch.float32),
+        None,
+        None,
+    )
+    layer.forward_mqa(q, kv, positions, output, index_query=iq)
+    assert events == [
+        "index_pages",
+        "index_chunk",
+        "write_meta",
+        ("l2pf", "wo_plan", rows),
+        "attend",
+    ]
