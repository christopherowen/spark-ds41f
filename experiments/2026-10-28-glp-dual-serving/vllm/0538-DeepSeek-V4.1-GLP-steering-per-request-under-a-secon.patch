 def _ulp(x: torch.Tensor) -> torch.Tensor:
     """BF16's spacing at ``|x|`` (eight significant bits)."""
     _, exponent = torch.frexp(x.abs().clamp_min(2.0**-126))
     return torch.ldexp(torch.ones_like(x), exponent - 8)
 
 
