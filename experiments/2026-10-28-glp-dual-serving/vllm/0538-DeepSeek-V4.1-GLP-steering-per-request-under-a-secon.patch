+def _host_marks(starts: list[int], idx: list[int], marks: list[int], rows: int):
+    out = [0] * rows
+    for r, state in enumerate(idx):
+        for t in range(starts[r], starts[r + 1]):
+            out[t] = marks[state]
+    return out
+
