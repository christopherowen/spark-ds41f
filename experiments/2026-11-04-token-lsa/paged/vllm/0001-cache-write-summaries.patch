+"""Physical-page summaries, written after native keys, with admitted storage.
+
+The native68-byte/key records precede4 bytes/key of BF16 centroids and one
+byte/key reserved for membership/alignment. Only complete visible pages use
+summaries. No reference, diagnostics, host transfers or proof passes here.
+"""
+import math
+
+import tilelang
+import tilelang.language as T
+import torch
+
+from . import prepare
+from .indexer import (IndexerV41Plan, IndexerTopK, INDEX_TOPK,
+                      CANDIDATE_BLOCKS, CANDIDATE_BLOCK, page_bytes)
+from .shortlist_indexer import (decode, shortlist_prefix, shortlist_scatter,
+                               remap_blocks, BUCKET, BLOCK, TILE)
+
+STATE_BYTES = 73
+ROW_CAP = 8
+
+
+@tilelang.jit
+def summarize_pages(page: int, slot_dtype: str = 'int64'):
+    """One active CTA per completed written page, never a query-side rebuild."""
+    rows, pool_pages, stride = T.dynamic('rows, pool_pages, stride')
+    blocks, buckets = page//BLOCK, page//BUCKET
+    levels = buckets.bit_length()-1
+
+    @T.prim_func
+    def update(Pool: T.StridedTensor([pool_pages,page*STATE_BYTES],[stride,1],T.uint8),
+               Half: T.StridedTensor([pool_pages,page*STATE_BYTES//2],[stride//2,1],T.bfloat16),
+               Slots: T.Tensor([rows],slot_dtype)):
+        with T.Kernel(rows,threads=128) as row:
+            point = T.alloc_fragment([blocks,128],T.float32)
+            feature = T.alloc_shared([blocks,128],T.float32)
+            norm_terms = T.alloc_fragment([blocks,128],T.float32)
+            norms = T.alloc_fragment([blocks],T.float32)
+            labels = T.alloc_shared([blocks],T.int32)
+            next_labels = T.alloc_fragment([blocks],T.int32)
+            ids = T.alloc_fragment([blocks],T.int32)
+            minimum = T.alloc_fragment([1],T.int32)
+            maximum = T.alloc_fragment([1],T.int32)
+            a = T.alloc_fragment([128],T.float32)
+            b = T.alloc_fragment([128],T.float32)
+            direction = T.alloc_shared([128],T.float32)
+            terms = T.alloc_fragment([blocks,128],T.float32)
+            projection = T.alloc_shared([blocks],T.float32)
+            projection_frag = T.alloc_fragment([blocks],T.float32)
+            pairs = T.alloc_fragment([blocks,blocks],T.int32)
+            ranks = T.alloc_shared([blocks],T.int32)
+            rank_frag = T.alloc_fragment([blocks],T.int32)
+            slot = Slots[row]
+            if (slot >= 0) & (slot % page == page-1) & (slot//page < pool_pages):
+                physical = slot//page
+                T.fill(point,0.)
+                for k in T.serial(BLOCK):
+                    for block,d in T.Parallel(blocks,128):
+                        token = block*BLOCK+k
+                        point[block,d] += decode(Pool[physical,token*64+d//2],
+                            Pool[physical,page*64+token*4+d//32],d)*.125
+                for block,d in T.Parallel(blocks,128):
+                    norm_terms[block,d] = point[block,d]*point[block,d]
+                T.reduce_sum(norm_terms,norms,dim=1)
+                for block,d in T.Parallel(blocks,128):
+                    feature[block,d] = point[block,d]*T.rsqrt(T.max(norms[block],1.e-30))
+                for block in T.Parallel(blocks):
+                    labels[block] = 0
+                T.sync_threads()
+                for level in T.unroll(levels):
+                    for group in T.serial(1 << level):
+                        for block in T.Parallel(blocks):
+                            ids[block] = T.if_then_else(labels[block] == group,block,blocks)
+                        T.reduce_min(ids,minimum,dim=0)
+                        for block in T.Parallel(blocks):
+                            ids[block] = T.if_then_else(labels[block] == group,block,-1)
+                        T.reduce_max(ids,maximum,dim=0)
+                        for d in T.Parallel(128):
+                            direction[d] = feature[minimum[0],d]-feature[maximum[0],d]
+                        T.sync_threads()
+                        for iteration in T.serial(4):
+                            for block,d in T.Parallel(blocks,128):
+                                terms[block,d] = feature[block,d]*direction[d]
+                            T.reduce_sum(terms,projection_frag,dim=1)
+                            T.copy(projection_frag,projection)
+                            T.sync_threads()
+                            for i,j in T.Parallel(blocks,blocks):
+                                pairs[i,j] = T.cast((labels[j] == group) &
+                                    ((projection[j] < projection[i]) |
+                                     ((projection[j] == projection[i]) & (j < i))),T.int32)
+                            T.reduce_sum(pairs,rank_frag,dim=1)
+                            T.copy(rank_frag,ranks)
+                            T.sync_threads()
+                            for block,d in T.Parallel(blocks,128):
+                                terms[block,d] = T.if_then_else((labels[block] == group) &
+                                    (ranks[block] < blocks//(2 << level)),feature[block,d],0.)
+                            T.reduce_sum(terms,a,dim=0)
+                            for block,d in T.Parallel(blocks,128):
+                                terms[block,d] = T.if_then_else((labels[block] == group) &
+                                    (ranks[block] >= blocks//(2 << level)),feature[block,d],0.)
+                            T.reduce_sum(terms,b,dim=0)
+                            for d in T.Parallel(128):
+                                direction[d] = (a[d]-b[d])/(blocks//(2 << level))
+                            T.sync_threads()
+                        for block in T.Parallel(blocks):
+                            if labels[block] == group:
+                                next_labels[block] = group*2+T.cast(ranks[block] >= blocks//(2 << level),T.int32)
+                    T.copy(next_labels,labels)
+                    T.sync_threads()
+                for bucket in T.serial(buckets):
+                    for block,d in T.Parallel(blocks,128):
+                        terms[block,d] = T.if_then_else(labels[block] == bucket,point[block,d],0.)
+                    T.reduce_sum(terms,a,dim=0)
+                    for d in T.Parallel(128):
+                        Half[physical,page*68//2+bucket*128+d] = T.cast(a[d]/8,T.bfloat16)
+                for block in T.Parallel(blocks):
+                    Pool[physical,page*72+block] = T.cast(labels[block],T.uint8)
+    return update
+
+
+@tilelang.jit
+def page_scores(width: int, page: int, block_c: int = 64):
+    rows, pool_pages, stride = T.dynamic('rows, pool_pages, stride')
+    buckets = width//BUCKET
+    ctas = min(tilelang.cdiv(buckets,block_c),128)
+
+    @T.prim_func
+    def score(Q: T.Tensor([rows,32,64],T.uint8), Scale: T.Tensor([rows,32,4],T.uint8),
+              Weight: T.Tensor([rows,32],T.bfloat16),
+              Pool: T.StridedTensor([pool_pages,page*STATE_BYTES//2],[stride,1],T.bfloat16),
+              Table: T.Tensor([rows,width//page],T.int32), Length: T.Tensor([rows],T.int32),
+              Active: T.Tensor([1],T.int32), Score: T.Tensor([rows,buckets],T.bfloat16),
+              Count: T.Tensor([rows],T.int32)):
+        with T.Kernel(ctas,rows,threads=128) as (cta,row):
+            a = T.alloc_shared([block_c,128],T.bfloat16)
+            b = T.alloc_shared([32,128],T.bfloat16)
+            acc = T.alloc_fragment([block_c,32],T.float32)
+            terms = T.alloc_shared([block_c,32],T.float32)
+            total = T.alloc_fragment([block_c],T.float32)
+            extent = T.min(T.max(Length[row],0),T.max(T.min(Active[0],width),0))
+            count = extent//page*(page//BUCKET)
+            if (cta == 0) & (T.get_thread_binding() == 0):
+                Count[row] = count
+            if cta*block_c < count:
+                for h,d in T.Parallel(32,128):
+                    b[h,d] = T.cast(decode(Q[row,h,d//2],Scale[row,h,d//32],d),T.bfloat16)
+                for iteration in T.serial(T.ceildiv(T.max(T.ceildiv(count,block_c)-cta,0),ctas)):
+                    start = (cta+iteration*ctas)*block_c
+                    for c,d in T.Parallel(block_c,128):
+                        a[c,d] = 0
+                        if start+c < count:
+                            a[c,d] = Pool[Table[row,(start+c)//(page//BUCKET)],
+                                page*68//2+((start+c)%(page//BUCKET))*128+d]
+                    T.gemm(a,b,acc,transpose_B=True,clear_accum=True)
+                    for c,h in T.Parallel(block_c,32):
+                        dot = T.max(T.cast(T.cast(acc[c,h],T.bfloat16),T.float32),0.)
+                        terms[c,h] = T.cast(T.cast(T.fmul(dot,T.cast(Weight[row,h],T.float32)),T.bfloat16),T.float32)
+                    T.sync_threads()
+                    T.fill(total,0.)
+                    for h in T.serial(32):
+                        for c in T.Parallel(block_c):
+                            total[c] += terms[c,h]
+                    for c in T.Parallel(block_c):
+                        if start+c < count:
+                            Score[row,start+c] = T.cast(total[c],T.bfloat16)
+    return score
+
+
+@tilelang.jit
+def page_flags(width: int, page: int, budget: int):
+    rows, pool_pages, stride = T.dynamic('rows, pool_pages, stride')
+    blocks, tiles = width//BLOCK, tilelang.cdiv(width//BLOCK,TILE)
+    ctas = min(tiles,128)
+
+    @T.prim_func
+    def flags(Selected: T.Tensor([rows,budget],T.int32),
+              Pool: T.StridedTensor([pool_pages,page*STATE_BYTES],[stride,1],T.uint8),
+              Table: T.Tensor([rows,width//page],T.int32), Length: T.Tensor([rows],T.int32),
+              Active: T.Tensor([1],T.int32), Local: T.Tensor([rows,blocks],T.int32),
+              Counts: T.Tensor([rows,tiles],T.int32)):
+        with T.Kernel(ctas,rows,threads=128) as (cta,row):
+            keep = T.alloc_fragment([TILE],T.int32)
+            prefix = T.alloc_fragment([TILE],T.int32)
+            low = T.alloc_fragment([TILE],T.int32)
+            high = T.alloc_fragment([TILE],T.int32)
+            member = T.alloc_fragment([TILE],T.int32)
+            extent = T.min(T.max(Length[row],0),T.max(T.min(Active[0],width),0))
+            visible = T.ceildiv(extent,BLOCK)
+            complete = extent//page*(page//BLOCK)
+            for iteration in T.serial(T.ceildiv(T.max(T.ceildiv(visible,TILE)-cta,0),ctas)):
+                tile = cta+iteration*ctas
+                for i in T.Parallel(TILE):
+                    low[i] = 0
+                    high[i] = budget
+                    member[i] = -1
+                    block = tile*TILE+i
+                    if block < complete:
+                        member[i] = (block//(page//BLOCK))*(page//BUCKET)+T.cast(
+                            Pool[Table[row,block//(page//BLOCK)],page*72+block%(page//BLOCK)],T.int32)
+                for step in T.serial(budget.bit_length()):
+                    for i in T.Parallel(TILE):
+                        if (tile*TILE+i < complete) & (low[i] < high[i]):
+                            middle = (low[i]+high[i])//2
+                            selected = Selected[row,T.min(middle,budget-1)]
+                            selected = T.if_then_else(selected < 0,2147483647,selected)
+                            if selected < member[i]:
+                                low[i] = middle+1
+                            else:
+                                high[i] = middle
+                for i in T.Parallel(TILE):
+                    block = tile*TILE+i
+                    keep[i] = 0
+                    if block < visible:
+                        keep[i] = T.cast((block >= complete) | (block == visible-1),T.int32)
+                        if block < complete:
+                            keep[i] = T.max(keep[i],T.cast((low[i] < budget) &
+                                (Selected[row,T.min(low[i],budget-1)] == member[i]),T.int32))
+                T.cumsum(keep,prefix,dim=0)
+                for i in T.Parallel(TILE):
+                    block = tile*TILE+i
+                    if block < visible:
+                        Local[row,block] = T.if_then_else(keep[i] > 0,prefix[i],0)
+                    if i == TILE-1:
+                        Counts[row,tile] = prefix[i]
+    return flags
+
+
+class PageShortlistPlan:
+    """Buffer-free serving plan. Cache owns metadata; caller owns all scratch."""
+    def __init__(self,width,page,*,candidate_blocks=False,budget=None):
+        self.width,self.page,self.source = width,page,candidate_blocks
+        self.budget = budget or (512 if candidate_blocks else 64)
+        self.capacity = (self.budget+8)*BUCKET
+        self.score = page_scores(width,page)
+        self.coarse = IndexerTopK(width//BUCKET,self.budget)
+        self.flags = page_flags(width,page,self.budget)
+        self.prefix = shortlist_prefix(width,self.budget)
+        self.scatter = shortlist_scatter(width,self.budget)
+        self.final = IndexerV41Plan(self.capacity,page,candidates=True)
+        if self.source:
+            self.select_blocks = IndexerTopK(self.capacity,CANDIDATE_BLOCKS,CANDIDATE_BLOCK)
+            self.remap = remap_blocks(self.capacity)
+
+    @staticmethod
+    def calls(width,page,*,candidate_blocks=False,budget=None):
+        budget = budget or (512 if candidate_blocks else 64)
+        capacity = (budget+8)*BUCKET
+        calls = [prepare.call(page_scores,width,page),*IndexerTopK.calls(width//BUCKET,budget),
+                 prepare.call(page_flags,width,page,budget),prepare.call(shortlist_prefix,width,budget),
+                 prepare.call(shortlist_scatter,width,budget),
+                 *IndexerV41Plan.calls(capacity,page,candidates=True)]
+        if candidate_blocks:
+            calls += [*IndexerTopK.calls(capacity,CANDIDATE_BLOCKS,CANDIDATE_BLOCK),
+                      prepare.call(remap_blocks,capacity)]
+        return calls
+
+    def _specs(self,rows):
+        r,b = min(rows,ROW_CAP),self.budget
+        tiles = tilelang.cdiv(self.width//BLOCK,TILE)
+        specs = {'scores':((r,self.width//BUCKET),torch.bfloat16),'counts':((r,),torch.int32),
+                 'selected':((r,b),torch.int32),'values':((r,b),torch.bfloat16),
+                 'local':((r,self.width//BLOCK),torch.int32),'tile_counts':((r,tiles),torch.int32),
+                 'bases':((r,tiles),torch.int32),'candidates':((r,self.capacity//BLOCK),torch.int32),
+                 'candidate_lengths':((r,),torch.int32)}
+        for name,plan in [('coarse',self.coarse),('final',self.final)]:
+            for i,spec in enumerate(plan.scratch_specs(r)):
+                specs[f'{name}_{i}'] = spec
+        if self.source:
+            specs.update(compact=((r,CANDIDATE_BLOCKS),torch.int32),
+                         block_values=((r,CANDIDATE_BLOCKS),torch.bfloat16))
+            for i,spec in enumerate(self.select_blocks.scratch_specs(r)):
+                specs[f'blocks_{i}'] = spec
+        return specs
+
+    def scratch_specs(self,rows):
+        return tuple(self._specs(rows).values())
+
+    def run(self,q,scales,weights,pool,table,lengths,active,candidates=None,candidate_lengths=None,
+            *,out=None,candidate_out=None,candidate_out_lengths=None,scratch=None):
+        if candidates is not None or candidate_lengths is not None:
+            raise ValueError('page shortlist cannot consume reindex candidates')
+        if out is None or scratch is None:
+            raise ValueError('serving must reserve outputs and workspace before profiling')
+        if self.source and (candidate_out is None or candidate_out_lengths is None):
+            raise ValueError('source shortlist requires handoff outputs')
+        rows = q.shape[0]
+        specs = self._specs(rows)
+        if len(scratch) != len(specs):
+            raise ValueError('shortlist workspace differs from admission reservation')
+        full = dict(zip(specs,scratch))
+        def buffers(name,plan,b):
+            return [b[f'{name}_{i}'] for i in range(len(plan.scratch_specs(1)))]
+        for start in range(0,rows,ROW_CAP):
+            end = min(start+ROW_CAP,rows)
+            r = end-start
+            current = self._specs(r)
+            b = {name:t.view(-1)[:math.prod(current[name][0])].view(current[name][0])
+                 for name,t in full.items()}
+            qr,sr,wr,tr,lr = q[start:end],scales[start:end],weights[start:end],table[start:end],lengths[start:end]
+            self.score(qr.view(torch.uint8),sr.view(torch.uint8).reshape(r,32,4),wr,
+                       pool.view(torch.bfloat16),tr,lr,active,b['scores'],b['counts'])
+            self.coarse.run(b['scores'],b['counts'],active,b['selected'],b['values'],
+                            scratch=buffers('coarse',self.coarse,b))
+            self.flags(b['selected'],pool,tr,lr,active,b['local'],b['tile_counts'])
+            self.prefix(b['tile_counts'],lr,active,b['bases'],b['candidates'],b['candidate_lengths'])
+            self.scatter(b['local'],b['bases'],lr,active,b['candidates'])
+            _,scores = self.final.run(qr,sr,wr,pool,tr,lr,active,b['candidates'],b['candidate_lengths'],
+                                     out=out[start:end],scratch=buffers('final',self.final,b))
+            if self.source:
+                self.select_blocks.run(scores,b['candidate_lengths'],active,b['compact'],b['block_values'],
+                    counts=candidate_out_lengths[start:end],scratch=buffers('blocks',self.select_blocks,b))
+                self.remap(b['compact'],b['candidates'],candidate_out[start:end])
+        return out,None
