+class MidDeadRows(NamedTuple):
+    """Mid-network (e.g. Layer 20) dead-row pruning state, decided on device.
+
+    draft_row_base: [max_num_reqs] per-request first draft row in batch
+        (-1 when inactive; self-clearing to -1 when the mid-layer kernel runs).
+    log_survival: [max_num_reqs, num_steps] per-request log survival.
+    cut: [max_num_reqs] per-request live draft count, updated in place.
+    mid_log_tau: log of the mid-layer survival threshold.
+    cos_weight: weight on step-to-step mid-layer hidden-state cosine drop.
+    cos_floor: cosine similarity floor below which penalty accrues.
+    layer: 1-based layer index at which mid-network pruning runs (default 20).
+    """
+
+    draft_row_base: torch.Tensor
+    log_survival: torch.Tensor
+    cut: torch.Tensor
+    mid_log_tau: float
+    cos_weight: float = 0.5
+    cos_floor: float = 0.85
+    layer: int = 20
+
+
+_MID_DEAD_ROWS_BY_PADDING: dict[int, MidDeadRows] = {}
+
+
+def register_mid_dead_rows(
+    is_padding: torch.Tensor | None, mid: MidDeadRows | None
+) -> None:
+    """Bind or clear ``mid`` for ``is_padding``'s underlying device address."""
+    if is_padding is None:
+        return
+    ptr = int(is_padding.data_ptr())
+    if mid is None:
+        _MID_DEAD_ROWS_BY_PADDING.pop(ptr, None)
+    else:
+        _MID_DEAD_ROWS_BY_PADDING[ptr] = mid
+
+
+def get_mid_dead_rows(is_padding: torch.Tensor | None) -> MidDeadRows | None:
+    """Return the ``MidDeadRows`` bound to ``is_padding``'s base address, if any."""
+    if is_padding is None:
+        return None
+    return _MID_DEAD_ROWS_BY_PADDING.get(int(is_padding.data_ptr()))
+
+
