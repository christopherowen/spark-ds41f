+@torch.no_grad()
+def test_mid_layer_dead_rows_prunes_diverging_tail_and_updates_routed_mask():
+    if not torch.cuda.is_available() or torch.cuda.get_device_capability()[0] != 12:
+        pytest.skip("SM12x required for TileLang mid-layer dead-row test")
+    from vllm.config import VllmConfig, set_current_vllm_config
+    from vllm.forward_context import set_forward_context
+    from vllm.models.deepseek_v4_1.nvidia.model import DeepseekV4Model
+    from vllm.models.deepseek_v4_1.tilelang.router import _routing_masks
+    from vllm.v1.worker.gpu.input_batch import (
+        DeadRows,
+        MidDeadRows,
+        combine_sampled_and_draft_tokens,
+        get_mid_dead_rows,
+        register_mid_dead_rows,
+    )
+
+    device = torch.device("cuda", torch.cuda.current_device())
+    num_reqs = 1
+    drafts = 5
+    num_tokens = 1 + drafts  # 1 anchor + 5 drafts = 6 rows
+    hidden_size = 5120
+
+    input_ids = torch.zeros(16, dtype=torch.int32, device=device)
+    is_padding = torch.zeros(16, dtype=torch.bool, device=device)
+    idx_mapping = torch.tensor([0], dtype=torch.int64, device=device)
+    last_sampled = torch.tensor([101], dtype=torch.int64, device=device)
+    query_start_loc = torch.tensor([0, num_tokens], dtype=torch.int32, device=device)
+    seq_lens = torch.tensor([20], dtype=torch.int32, device=device)
+    prefill_len = torch.tensor([10], dtype=torch.int32, device=device)
+    draft_tokens = torch.tensor(
+        [[201, 202, 203, 204, 205]], dtype=torch.int64, device=device
+    )
+    cu_num_logits = torch.tensor([0, num_tokens], dtype=torch.int32, device=device)
+
+    # Confidences: [0.9, 0.85, 0.60, 0.50, 0.20]
+    # Cumulative survival: [0.90, 0.765, 0.459, 0.2295, 0.0459]
+    # Layer-0 tau = 0.05 -> cut_0 = 4 (row 5, draft j=4, is pruned at Layer 0).
+    confidence = torch.tensor(
+        [[0.90, 0.85, 0.60, 0.50, 0.20]], dtype=torch.float32, device=device
+    )
+    dead_cut = torch.zeros(4, dtype=torch.int32, device=device)
+    draft_row_base = torch.full((4,), -1, dtype=torch.int32, device=device)
+    log_survival = torch.zeros((4, drafts), dtype=torch.float32, device=device)
+
+    # Mid-layer tau = 0.35, cos_weight = 1.0, cos_floor = 0.85, layer = 20
+    mid = MidDeadRows(
+        draft_row_base=draft_row_base,
+        log_survival=log_survival,
+        cut=dead_cut,
+        mid_log_tau=float(np.log(0.35)),
+        cos_weight=1.0,
+        cos_floor=0.85,
+        layer=20,
+    )
+    register_mid_dead_rows(is_padding, mid)
+    try:
+        assert get_mid_dead_rows(is_padding[:num_tokens]) is mid
+        dead_rows = DeadRows(
+            confidence=confidence,
+            is_padding=is_padding,
+            cut=dead_cut[:num_reqs],
+            log_tau=float(np.log(0.05)),
+            mid=mid,
+        )
+        combine_sampled_and_draft_tokens(
+            input_ids,
+            idx_mapping,
+            last_sampled,
+            query_start_loc,
+            seq_lens,
+            prefill_len,
+            draft_tokens,
+            cu_num_logits,
+            num_tokens,
+            1,
+            dead_rows=dead_rows,
+        )
+        assert int(dead_cut[0].item()) == 4
+        assert int(draft_row_base[0].item()) == 1
+        assert is_padding[:num_tokens].tolist() == [
+            False,
+            False,
+            False,
+            False,
+            False,
+            True,
+        ]
+
+        # Build Layer-20 aux_hidden_state where rows 0, 1, 2 (anchor + draft 0, 1)
+        # are aligned (cos ~ 1.0), while row 3 (draft 2) flips direction (cos = -1.0),
+        # causing effective survival at j=2 to drop below mid_log_tau.
+        base_vec = torch.randn(hidden_size, dtype=torch.bfloat16, device=device)
+        aux_hidden = torch.stack(
+            [
+                base_vec,
+                base_vec,
+                base_vec,
+                -base_vec,
+                base_vec,
+                base_vec,
+            ],
+            dim=0,
+        )
+
+        vllm_config = VllmConfig()
+        with (
+            set_current_vllm_config(vllm_config),
+            set_forward_context(
+                None,
+                vllm_config,
+                num_tokens=num_tokens,
+                is_padding=is_padding[:num_tokens],
+            ),
+        ):
+            _, routed = _routing_masks(num_tokens, None, 0, 0)
+            assert routed is not None
+            assert routed.tolist() == [True, True, True, True, True, False]
+
+            # Layer 2 returns without pruning (mid.layer == 20).
+            DeepseekV4Model._maybe_prune_mid_layer_dead_rows(2, aux_hidden)
+            assert int(dead_cut[0].item()) == 4
+            assert int(draft_row_base[0].item()) == 1
+
+            # Layer 20 prunes j=2, 3 (rows 3, 4), updating dead_cut[0] -> 2,
+            # is_padding[3:5] -> True, routed[3:5] -> False, and self-clears
+            # draft_row_base[0] -> -1.
+            DeepseekV4Model._maybe_prune_mid_layer_dead_rows(20, aux_hidden)
+            assert int(dead_cut[0].item()) == 2
+            assert int(draft_row_base[0].item()) == -1
+            assert is_padding[:num_tokens].tolist() == [
+                False,
+                False,
+                False,
+                True,
+                True,
+                True,
+            ]
+            assert routed.tolist() == [True, True, True, False, False, False]
+
+            # Subsequent call without re-arming draft_row_base is a clean no-op.
+            is_padding[1] = False
+            DeepseekV4Model._maybe_prune_mid_layer_dead_rows(20, aux_hidden)
+            assert not bool(is_padding[1].item())
+
+            # Verify full CUDA graph capture & replay with route_partials:
+            # 1) Capture with draft_row_base == -1 (no-op).
+            # 2) Replay after combine_sampled_and_draft_tokens arms draft_row_base,
+            #    verifying that live rows [0..2] receive bit-identical router
+            #    topk_ids and topk_weights while newly-pruned rows [3..4] are
+            #    skipped (topk_ids == -1, topk_weights == 0).
+            from vllm.models.deepseek_v4_1.tilelang.router import route_partials
+
+            router_kernel = route_partials(8, 256, 2, False, True, padding=True)
+            router_partials = torch.randn(
+                2, num_tokens, 256, dtype=torch.float32, device=device
+            )
+            router_bias = torch.randn(256, dtype=torch.float32, device=device)
+            no_image = torch.zeros(num_tokens, dtype=torch.bool, device=device)
+            ref_ids = torch.empty(num_tokens, 8, dtype=torch.int64, device=device)
+            ref_weights = torch.empty(num_tokens, 8, dtype=torch.float32, device=device)
+            g_ids = torch.empty(num_tokens, 8, dtype=torch.int64, device=device)
+            g_weights = torch.empty(num_tokens, 8, dtype=torch.float32, device=device)
+
+            # Reference without mid-layer pruning for live rows [0..2]:
+            is_padding[:num_tokens].copy_(
+                torch.tensor([False, False, False, False, False, True], device=device)
+            )
+            routed.copy_(
+                torch.tensor([True, True, True, True, True, False], device=device)
+            )
+            router_kernel(
+                router_partials,
+                router_bias,
+                router_bias,
+                no_image,
+                is_padding[:num_tokens],
+                ref_ids,
+                ref_weights,
+                2.5,
+            )
+
+            # Capture CUDA graph of Layer 20 mid-layer prune + Layer 20 router:
+            draft_row_base.fill_(-1)
+            g = torch.cuda.CUDAGraph()
+            torch.cuda.synchronize(device)
+            with torch.cuda.graph(g):
+                DeepseekV4Model._maybe_prune_mid_layer_dead_rows(20, aux_hidden)
+                router_kernel(
+                    router_partials,
+                    router_bias,
+                    router_bias,
+                    no_image,
+                    is_padding[:num_tokens],
+                    g_ids,
+                    g_weights,
+                    2.5,
+                )
+
+            # Arm via combine_sampled_and_draft_tokens and replay graph:
+            is_padding.zero_()
+            routed.copy_(
+                torch.tensor([True, True, True, True, True, False], device=device)
+            )
+            combine_sampled_and_draft_tokens(
+                input_ids,
+                idx_mapping,
+                last_sampled,
+                query_start_loc,
+                seq_lens,
+                prefill_len,
+                draft_tokens,
+                cu_num_logits,
+                num_tokens,
+                1,
+                dead_rows=dead_rows,
+            )
+            g.replay()
+            torch.cuda.synchronize(device)
+
+            assert int(dead_cut[0].item()) == 2
+            assert int(draft_row_base[0].item()) == -1
+            assert torch.equal(g_ids[:3], ref_ids[:3])
+            assert torch.equal(g_weights[:3], ref_weights[:3])
+            assert (g_ids[3:] == -1).all()
+            assert (g_weights[3:] == 0).all()
+    finally:
+        register_mid_dead_rows(is_padding, None)
