+    def test_known_trigger_single_token_attractor_in_answer(self):
+        """The 2026-11-01 production collapse (#787): a 736-token run of ' Vila'
+        in the visible answer after normal output. It stops once the run
+        dominates the answer's last 512 tokens, long before the 736 tokens."""
+        vila = 125221
+        req = self._answer_request("vila-736")
+        assert self._feed(req, self._varied(1500, 1)) is None
+        run_start = req.num_output_tokens
+        fed = self._feed(req, [vila] * 736)
+        assert fed is not None
+        assert req.status == RequestStatus.FINISHED_REPETITION
+        assert OUTPUT_LOOP_PERSIST < fed <= 512
