diff --git a/vllm/v1/worker/gpu/spec_decode/online_dspark_adaptation.py b/vllm/v1/worker/gpu/spec_decode/online_dspark_adaptation.py
new file mode 100644
index 000000000..0d00cab09
--- /dev/null
+++ b/vllm/v1/worker/gpu/spec_decode/online_dspark_adaptation.py
@@ -0,0 +1,1443 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Online verification-driven drafter adaptation for DSpark speculative decoding.
+
+This module implements three opt-in online adaptation components that learn
+from target verification outcomes on live user traffic while preserving exact
+target output distributions:
+
+1. ``OnlineConfidenceCalibrator``: TP-deterministic per-position log-odds
+   calibration of DSpark confidence scores updated from broadcast verification
+   outcomes with zero extra inter-rank communication.
+2. ``OnlineDSparkHeadAdapter`` and ``compute_e2e_tv_and_bce_loss``: Online
+   adaptation of DSpark Markov and confidence heads using prefix-product
+   total-variation loss (``E2E-TV``) over top-k candidate subsets (preserving
+   unnormalized excluded teacher mass) and auxiliary binary cross-entropy
+   (``BCE``) supervision against detached token overlap.
+3. ``SessionTokenMemory``: Bounded persistent cross-request token suffix and
+   Markov transition memory so recurring codebase identifiers, file paths, and
+   tool-call schemas are immediately available across multi-turn sessions.
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+from typing import Any
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+
+def online_dspark_adaptation_enabled() -> bool:
+    """Whether online DSpark adaptation is enabled via environment configuration."""
+    return os.environ.get("VLLM_DSPARK_ONLINE_ADAPT", "0").strip().lower() in (
+        "1",
+        "true",
+        "yes",
+        "on",
+    )
+
+
+def online_confidence_calibration_enabled() -> bool:
+    """Whether TP-deterministic online confidence calibration is enabled."""
+    if online_dspark_adaptation_enabled():
+        return True
+    return os.environ.get("VLLM_DSPARK_ONLINE_CALIBRATION", "0").strip().lower() in (
+        "1",
+        "true",
+        "yes",
+        "on",
+    )
+
+
+def session_token_memory_capacity() -> int:
+    """Configured capacity (in tokens) for persistent cross-request session memory."""
+    raw = os.environ.get("VLLM_DSPARK_SESSION_MEMORY_TOKENS", "0").strip()
+    try:
+        val = int(raw)
+    except ValueError:
+        val = 0
+    if val <= 0 and online_dspark_adaptation_enabled():
+        return 4096
+    return max(0, val)
+
+
+@dataclass
+class E2ETVAndBCEResult:
+    """Structured result of the prefix-product total-variation and BCE objective."""
+
+    total_loss: torch.Tensor
+    e2e_tv_loss: torch.Tensor
+    bce_loss: torch.Tensor
+    step_tv_distance: torch.Tensor
+    token_overlap: torch.Tensor
+    prefix_survival: torch.Tensor
+    excluded_teacher_mass: torch.Tensor
+
+
+def compute_e2e_tv_and_bce_loss(
+    draft_candidate_logits: torch.Tensor,
+    target_candidate_probs: torch.Tensor,
+    confidence_logits: torch.Tensor | None = None,
+    *,
+    confidence_probs: torch.Tensor | None = None,
+    valid_mask: torch.Tensor | None = None,
+    bce_weight: float = 0.25,
+    eps: float = 1e-6,
+) -> E2ETVAndBCEResult:
+    """Compute prefix-product total-variation (``E2E-TV``) and confidence ``BCE`` loss.
+
+    Args:
+        draft_candidate_logits: ``[batch, steps, topk]`` drafter logits over the
+            top-k candidate support ``S_{b,i}``.
+        target_candidate_probs: ``[batch, steps, topk]`` target verification
+            probabilities ``p_{b,i}(v)`` on ``S_{b,i}``. Their sum over ``topk``
+            may be strictly less than 1; the unnormalized excluded teacher mass
+            ``1 - sum_{v in S_{b,i}} p_{b,i}(v)`` is preserved inside the step
+            total-variation distance
+            ``d_{b,i} = 0.5 * (sum_{v in S_{b,i}} |q_{b,i}(v) - p_{b,i}(v)| + 1 - sum_{v in S_{b,i}} p_{b,i}(v))``.
+        confidence_logits: Optional ``[batch, steps]`` raw confidence head logits.
+        confidence_probs: Optional ``[batch, steps]`` confidence probabilities
+            (used if ``confidence_logits`` is not provided).
+        valid_mask: Optional ``[batch, steps]`` boolean or float mask of active
+            positions. Masked-out positions have ``d_{b,i} = 0`` for prefix
+            products beyond them or are excluded from the prefix average.
+        bce_weight: Weight applied to the auxiliary confidence-head BCE loss
+            against detached token overlap ``sg(1 - d_{b,i})``.
+        eps: Numerical clamping epsilon.
+    """
+    if draft_candidate_logits.ndim != 3 or target_candidate_probs.ndim != 3:
+        raise ValueError(
+            "draft_candidate_logits and target_candidate_probs must have shape "
+            "[batch, steps, topk]"
+        )
+    if draft_candidate_logits.shape != target_candidate_probs.shape:
+        raise ValueError(
+            f"Shape mismatch: draft_candidate_logits {draft_candidate_logits.shape} "
+            f"vs target_candidate_probs {target_candidate_probs.shape}"
+        )
+
+    q_probs = F.softmax(draft_candidate_logits.float(), dim=-1)
+    p_probs = target_candidate_probs.float().clamp_min(0.0)
+
+    # Preserve unnormalized excluded teacher mass outside top-k support S_{b,i}.
+    included_teacher_mass = p_probs.sum(dim=-1).clamp(0.0, 1.0)
+    excluded_teacher_mass = (1.0 - included_teacher_mass).clamp(0.0, 1.0)
+
+    l1_on_support = torch.abs(q_probs - p_probs).sum(dim=-1)
+    step_tv_distance = 0.5 * (l1_on_support + excluded_teacher_mass)
+    step_tv_distance = step_tv_distance.clamp(0.0, 1.0)
+    token_overlap = (1.0 - step_tv_distance).clamp(0.0, 1.0)
+
+    if valid_mask is not None:
+        mask_f = valid_mask.to(dtype=token_overlap.dtype)
+        # For prefix products, invalid trailing positions do not contribute to the average.
+        effective_overlap = torch.where(
+            valid_mask.bool(), token_overlap, torch.ones_like(token_overlap)
+        )
+        prefix_survival = torch.cumprod(effective_overlap, dim=-1)
+        denom = mask_f.sum().clamp_min(1.0)
+        e2e_tv_loss = 1.0 - (prefix_survival * mask_f).sum() / denom
+    else:
+        prefix_survival = torch.cumprod(token_overlap, dim=-1)
+        e2e_tv_loss = 1.0 - prefix_survival.mean()
+
+    detached_overlap = token_overlap.detach()
+    if confidence_logits is not None:
+        conf_logits_f = confidence_logits.float()
+        bce_per_pos = F.binary_cross_entropy_with_logits(
+            conf_logits_f, detached_overlap, reduction="none"
+        )
+        if valid_mask is not None:
+            mask_f = valid_mask.to(dtype=bce_per_pos.dtype)
+            bce_loss = (bce_per_pos * mask_f).sum() / mask_f.sum().clamp_min(1.0)
+        else:
+            bce_loss = bce_per_pos.mean()
+    elif confidence_probs is not None:
+        conf_p = confidence_probs.float().clamp(eps, 1.0 - eps)
+        bce_per_pos = -(
+            detached_overlap * torch.log(conf_p)
+            + (1.0 - detached_overlap) * torch.log(1.0 - conf_p)
+        )
+        if valid_mask is not None:
+            mask_f = valid_mask.to(dtype=bce_per_pos.dtype)
+            bce_loss = (bce_per_pos * mask_f).sum() / mask_f.sum().clamp_min(1.0)
+        else:
+            bce_loss = bce_per_pos.mean()
+    else:
+        bce_loss = torch.zeros((), dtype=e2e_tv_loss.dtype, device=e2e_tv_loss.device)
+
+    total_loss = e2e_tv_loss + float(bce_weight) * bce_loss
+    return E2ETVAndBCEResult(
+        total_loss=total_loss,
+        e2e_tv_loss=e2e_tv_loss,
+        bce_loss=bce_loss,
+        step_tv_distance=step_tv_distance,
+        token_overlap=token_overlap,
+        prefix_survival=prefix_survival,
+        excluded_teacher_mass=excluded_teacher_mass,
+    )
+
+
+class OnlineConfidenceCalibrator:
+    """TP-deterministic online per-position log-odds calibrator for draft confidences.
+
+    Maintains per-position scale ``gamma_i`` and bias ``beta_i`` in deterministic
+    FP64 so that every tensor-parallel rank observing the same broadcast
+    ``(confidences, accepted_counts, verified_counts)`` computes bit-identical
+    calibration parameters with zero extra inter-rank communication:
+
+        c_hat_{r,i} = sigmoid(gamma_i * logit(c_{r,i}) + beta_i)
+
+    Updated online via damped exponential moving Newton / natural-gradient steps
+    on the binary cross-entropy loss over conditionally reached positions
+    (``i < A_r`` with label ``a_{r,i} = 1``, and ``i = A_r < B_r`` with label
+    ``a_{r,A_r} = 0``).
+    """
+
+    def __init__(
+        self,
+        num_steps: int,
+        *,
+        lr_bias: float = 0.20,
+        lr_scale: float = 0.10,
+        ema_decay: float = 0.90,
+        damping: float = 0.05,
+        min_scale: float = 0.25,
+        max_scale: float = 4.0,
+        max_abs_bias: float = 6.0,
+        max_log_odds: float = 12.0,
+        eps: float = 1e-6,
+        device: torch.device | str = "cpu",
+    ) -> None:
+        if num_steps <= 0:
+            raise ValueError(f"num_steps must be positive, got {num_steps}")
+        self.num_steps = int(num_steps)
+        self.lr_bias = float(lr_bias)
+        self.lr_scale = float(lr_scale)
+        self.ema_decay = float(ema_decay)
+        self.damping = float(damping)
+        self.min_scale = float(min_scale)
+        self.max_scale = float(max_scale)
+        self.max_abs_bias = float(max_abs_bias)
+        self.max_log_odds = float(max_log_odds)
+        self.eps = float(eps)
+        self.device = torch.device(device)
+
+        self.beta = torch.zeros(self.num_steps, dtype=torch.float64, device=self.device)
+        self.gamma = torch.ones(self.num_steps, dtype=torch.float64, device=self.device)
+        self.curv_beta = torch.full(
+            (self.num_steps,), 0.25, dtype=torch.float64, device=self.device
+        )
+        self.curv_gamma = torch.full(
+            (self.num_steps,), 0.25, dtype=torch.float64, device=self.device
+        )
+        self.obs_counts = torch.zeros(
+            self.num_steps, dtype=torch.float64, device=self.device
+        )
+        self.step_count: int = 0
+        self.raw_bce_ema: float = 0.0
+        self.cal_bce_ema: float = 0.0
+        self.raw_brier_ema: float = 0.0
+        self.cal_brier_ema: float = 0.0
+
+    def reset(self) -> None:
+        self.beta.zero_()
+        self.gamma.fill_(1.0)
+        self.curv_beta.fill_(0.25)
+        self.curv_gamma.fill_(0.25)
+        self.obs_counts.zero_()
+        self.step_count = 0
+        self.raw_bce_ema = 0.0
+        self.cal_bce_ema = 0.0
+        self.raw_brier_ema = 0.0
+        self.cal_brier_ema = 0.0
+
+    def state_dict(self) -> dict[str, Any]:
+        return {
+            "beta": self.beta.clone(),
+            "gamma": self.gamma.clone(),
+            "curv_beta": self.curv_beta.clone(),
+            "curv_gamma": self.curv_gamma.clone(),
+            "obs_counts": self.obs_counts.clone(),
+            "step_count": self.step_count,
+            "raw_bce_ema": self.raw_bce_ema,
+            "cal_bce_ema": self.cal_bce_ema,
+            "raw_brier_ema": self.raw_brier_ema,
+            "cal_brier_ema": self.cal_brier_ema,
+        }
+
+    def load_state_dict(self, state: dict[str, Any]) -> None:
+        self.beta.copy_(state["beta"].to(device=self.device, dtype=torch.float64))
+        self.gamma.copy_(state["gamma"].to(device=self.device, dtype=torch.float64))
+        self.curv_beta.copy_(
+            state["curv_beta"].to(device=self.device, dtype=torch.float64)
+        )
+        self.curv_gamma.copy_(
+            state["curv_gamma"].to(device=self.device, dtype=torch.float64)
+        )
+        self.obs_counts.copy_(
+            state["obs_counts"].to(device=self.device, dtype=torch.float64)
+        )
+        self.step_count = int(state.get("step_count", 0))
+        self.raw_bce_ema = float(state.get("raw_bce_ema", 0.0))
+        self.cal_bce_ema = float(state.get("cal_bce_ema", 0.0))
+        self.raw_brier_ema = float(state.get("raw_brier_ema", 0.0))
+        self.cal_brier_ema = float(state.get("cal_brier_ema", 0.0))
+
+    def _to_log_odds(self, confidences: torch.Tensor) -> torch.Tensor:
+        clamped = confidences.to(dtype=torch.float64).clamp(self.eps, 1.0 - self.eps)
+        return torch.log(clamped / (1.0 - clamped)).clamp(
+            -self.max_log_odds, self.max_log_odds
+        )
+
+    def calibrate(self, confidences: torch.Tensor) -> torch.Tensor:
+        """Return calibrated acceptance probabilities ``c_hat_{r,i}``."""
+        if confidences.numel() == 0:
+            return confidences.clone()
+        steps = confidences.shape[-1]
+        if steps > self.num_steps:
+            raise ValueError(
+                f"confidences has {steps} steps, exceeding calibrator num_steps={self.num_steps}"
+            )
+        z = self._to_log_odds(confidences)
+        gamma = self.gamma[:steps].to(device=confidences.device)
+        beta = self.beta[:steps].to(device=confidences.device)
+        calibrated = torch.sigmoid(gamma * z + beta)
+        return calibrated.to(dtype=confidences.dtype)
+
+    def calibrate_inplace(self, confidences: torch.Tensor) -> torch.Tensor:
+        """Calibrate ``confidences`` in place and return the tensor."""
+        if confidences.numel() == 0:
+            return confidences
+        confidences.copy_(self.calibrate(confidences))
+        return confidences
+
+    def survival_probabilities(
+        self, confidences: torch.Tensor, *, calibrate: bool = True
+    ) -> torch.Tensor:
+        """Compute prefix survival probabilities ``prod_{j <= i} c_hat_{r,j}``."""
+        probs = self.calibrate(confidences) if calibrate else confidences
+        return torch.cumprod(probs.float(), dim=-1).to(dtype=confidences.dtype)
+
+    def expected_acceptance_length(
+        self, confidences: torch.Tensor, *, calibrate: bool = True
+    ) -> torch.Tensor:
+        """Compute expected accepted draft length ``sum_i prod_{j <= i} c_hat_{r,j}``."""
+        return self.survival_probabilities(confidences, calibrate=calibrate).sum(dim=-1)
+
+    def _build_observation_mask_and_labels(
+        self,
+        num_reqs: int,
+        steps: int,
+        accepted_counts: torch.Tensor,
+        verified_counts: torch.Tensor | None,
+        device: torch.device,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        acc = accepted_counts[:num_reqs].to(device=device, dtype=torch.int64).clamp_min(0)
+        if verified_counts is None:
+            ver = torch.full((num_reqs,), steps, dtype=torch.int64, device=device)
+        else:
+            ver = (
+                verified_counts[:num_reqs]
+                .to(device=device, dtype=torch.int64)
+                .clamp(0, steps)
+            )
+        pos = torch.arange(steps, dtype=torch.int64, device=device).unsqueeze(0)
+        # Positions i < A_r were accepted (a_{r,i} = 1).
+        # If A_r < B_r, position i = A_r was rejected (a_{r,A_r} = 0).
+        observed = (pos <= acc.unsqueeze(1)) & (pos < ver.unsqueeze(1))
+        labels = (pos < acc.unsqueeze(1)).to(dtype=torch.float64)
+        return observed, labels
+
+    def compute_calibration_metrics(
+        self,
+        raw_confidences: torch.Tensor,
+        accepted_counts: torch.Tensor,
+        verified_counts: torch.Tensor | None = None,
+        *,
+        num_bins: int = 10,
+    ) -> dict[str, float]:
+        """Compute BCE, Brier score, and ECE before and after calibration."""
+        if raw_confidences.numel() == 0:
+            return {
+                "raw_bce": 0.0,
+                "cal_bce": 0.0,
+                "raw_brier": 0.0,
+                "cal_brier": 0.0,
+                "raw_ece": 0.0,
+                "cal_ece": 0.0,
+            }
+        num_reqs, steps = raw_confidences.shape
+        device = raw_confidences.device
+        observed, labels = self._build_observation_mask_and_labels(
+            num_reqs, steps, accepted_counts, verified_counts, device
+        )
+        if not bool(observed.any()):
+            return {
+                "raw_bce": 0.0,
+                "cal_bce": 0.0,
+                "raw_brier": 0.0,
+                "cal_brier": 0.0,
+                "raw_ece": 0.0,
+                "cal_ece": 0.0,
+            }
+
+        raw_p = raw_confidences.to(dtype=torch.float64).clamp(self.eps, 1.0 - self.eps)
+        cal_p = (
+            self.calibrate(raw_confidences)
+            .to(dtype=torch.float64)
+            .clamp(self.eps, 1.0 - self.eps)
+        )
+
+        obs_raw = raw_p[observed]
+        obs_cal = cal_p[observed]
+        obs_lbl = labels[observed]
+
+        raw_bce = float(
+            -(
+                obs_lbl * torch.log(obs_raw)
+                + (1.0 - obs_lbl) * torch.log(1.0 - obs_raw)
+            )
+            .mean()
+            .item()
+        )
+        cal_bce = float(
+            -(
+                obs_lbl * torch.log(obs_cal)
+                + (1.0 - obs_lbl) * torch.log(1.0 - obs_cal)
+            )
+            .mean()
+            .item()
+        )
+        raw_brier = float(((obs_raw - obs_lbl) ** 2).mean().item())
+        cal_brier = float(((obs_cal - obs_lbl) ** 2).mean().item())
+
+        def _ece(probs: torch.Tensor, targets: torch.Tensor) -> float:
+            edges = torch.linspace(
+                0.0, 1.0, num_bins + 1, dtype=torch.float64, device=probs.device
+            )
+            total = float(probs.numel())
+            ece_val = 0.0
+            for b in range(num_bins):
+                lo = edges[b]
+                hi = edges[b + 1]
+                if b == num_bins - 1:
+                    in_bin = (probs >= lo) & (probs <= hi)
+                else:
+                    in_bin = (probs >= lo) & (probs < hi)
+                cnt = int(in_bin.sum().item())
+                if cnt > 0:
+                    avg_conf = float(probs[in_bin].mean().item())
+                    avg_acc = float(targets[in_bin].mean().item())
+                    ece_val += (cnt / total) * abs(avg_conf - avg_acc)
+            return ece_val
+
+        return {
+            "raw_bce": raw_bce,
+            "cal_bce": cal_bce,
+            "raw_brier": raw_brier,
+            "cal_brier": cal_brier,
+            "raw_ece": _ece(obs_raw, obs_lbl),
+            "cal_ece": _ece(obs_cal, obs_lbl),
+        }
+
+    @torch.no_grad()
+    def observe(
+        self,
+        raw_confidences: torch.Tensor,
+        accepted_counts: torch.Tensor,
+        verified_counts: torch.Tensor | None = None,
+        *,
+        return_metrics: bool = True,
+    ) -> dict[str, float]:
+        """Update per-position ``(beta_i, gamma_i)`` from verification outcomes.
+
+        Because ``raw_confidences``, ``accepted_counts``, and ``verified_counts``
+        are identical across TP ranks, this deterministic FP64 update keeps all
+        ranks 100% bit-synchronized with zero inter-rank communication.
+        """
+        if raw_confidences.numel() == 0:
+            return {
+                "raw_bce": self.raw_bce_ema,
+                "cal_bce": self.cal_bce_ema,
+                "raw_brier": self.raw_brier_ema,
+                "cal_brier": self.cal_brier_ema,
+            }
+        num_reqs, steps = raw_confidences.shape
+        if steps > self.num_steps:
+            raise ValueError(
+                f"raw_confidences has {steps} steps, exceeding calibrator num_steps={self.num_steps}"
+            )
+
+        raw_d = raw_confidences.to(device=self.device, dtype=torch.float64).clamp(
+            self.eps, 1.0 - self.eps
+        )
+        observed, labels = self._build_observation_mask_and_labels(
+            num_reqs, steps, accepted_counts, verified_counts, self.device
+        )
+        obs_mask_f = observed.to(dtype=torch.float64)
+        z = torch.log(raw_d / (1.0 - raw_d)).clamp(
+            -self.max_log_odds, self.max_log_odds
+        )
+        gamma = self.gamma[:steps]
+        beta = self.beta[:steps]
+        c_hat = torch.sigmoid(gamma.unsqueeze(0) * z + beta.unsqueeze(0)).clamp(
+            self.eps, 1.0 - self.eps
+        )
+
+        # Per-position gradients and Fisher/Hessian diagonal on observed positions.
+        counts_per_pos = obs_mask_f.sum(dim=0)  # [steps]
+        active_pos = counts_per_pos > 0.0
+        safe_counts = counts_per_pos.clamp_min(1.0)
+
+        err = (c_hat - labels) * obs_mask_f
+        grad_beta = err.sum(dim=0) / safe_counts
+        grad_gamma = (err * z).sum(dim=0) / safe_counts
+
+        fisher_w = c_hat * (1.0 - c_hat) * obs_mask_f
+        hess_beta = fisher_w.sum(dim=0) / safe_counts
+        hess_gamma = (fisher_w * z * z).sum(dim=0) / safe_counts
+
+        rho = self.ema_decay
+        new_curv_beta = torch.where(
+            active_pos,
+            rho * self.curv_beta[:steps] + (1.0 - rho) * hess_beta,
+            self.curv_beta[:steps],
+        )
+        new_curv_gamma = torch.where(
+            active_pos,
+            rho * self.curv_gamma[:steps] + (1.0 - rho) * hess_gamma,
+            self.curv_gamma[:steps],
+        )
+        self.curv_beta[:steps].copy_(new_curv_beta)
+        self.curv_gamma[:steps].copy_(new_curv_gamma)
+        self.obs_counts[:steps].add_(counts_per_pos)
+
+        step_beta = torch.where(
+            active_pos,
+            self.lr_bias * grad_beta / (new_curv_beta + self.damping),
+            torch.zeros_like(grad_beta),
+        )
+        step_gamma = torch.where(
+            active_pos & (self.obs_counts[:steps] >= 2.0),
+            self.lr_scale * grad_gamma / (new_curv_gamma + self.damping),
+            torch.zeros_like(grad_gamma),
+        )
+
+        self.beta[:steps].copy_(
+            (self.beta[:steps] - step_beta).clamp(-self.max_abs_bias, self.max_abs_bias)
+        )
+        self.gamma[:steps].copy_(
+            (self.gamma[:steps] - step_gamma).clamp(self.min_scale, self.max_scale)
+        )
+        self.step_count += 1
+
+        if not return_metrics:
+            return {}
+
+        total_obs = obs_mask_f.sum().clamp_min(1.0)
+        raw_bce_t = (
+            -(
+                labels * torch.log(raw_d)
+                + (1.0 - labels) * torch.log(1.0 - raw_d)
+            )
+            * obs_mask_f
+        ).sum() / total_obs
+        raw_brier_t = (((raw_d - labels) ** 2) * obs_mask_f).sum() / total_obs
+
+        c_hat_post = torch.sigmoid(
+            self.gamma[:steps].unsqueeze(0) * z + self.beta[:steps].unsqueeze(0)
+        ).clamp(self.eps, 1.0 - self.eps)
+        cal_bce_t = (
+            -(
+                labels * torch.log(c_hat_post)
+                + (1.0 - labels) * torch.log(1.0 - c_hat_post)
+            )
+            * obs_mask_f
+        ).sum() / total_obs
+        cal_brier_t = (((c_hat_post - labels) ** 2) * obs_mask_f).sum() / total_obs
+
+        raw_bce_step, raw_brier_step, cal_bce_step, cal_brier_step = (
+            torch.stack([raw_bce_t, raw_brier_t, cal_bce_t, cal_brier_t]).tolist()
+        )
+        if self.step_count == 1:
+            self.raw_bce_ema = raw_bce_step
+            self.cal_bce_ema = cal_bce_step
+            self.raw_brier_ema = raw_brier_step
+            self.cal_brier_ema = cal_brier_step
+        else:
+            self.raw_bce_ema = rho * self.raw_bce_ema + (1.0 - rho) * raw_bce_step
+            self.cal_bce_ema = rho * self.cal_bce_ema + (1.0 - rho) * cal_bce_step
+            self.raw_brier_ema = rho * self.raw_brier_ema + (1.0 - rho) * raw_brier_step
+            self.cal_brier_ema = rho * self.cal_brier_ema + (1.0 - rho) * cal_brier_step
+
+        return {
+            "raw_bce": raw_bce_step,
+            "cal_bce": cal_bce_step,
+            "raw_brier": raw_brier_step,
+            "cal_brier": cal_brier_step,
+        }
+
+
+def _deterministic_index_add_(
+    target: torch.Tensor,
+    flat_ids: torch.Tensor,
+    flat_deltas: torch.Tensor,
+) -> None:
+    """Rank-deterministic scatter-add without host-device sync or atomic collisions."""
+    n = int(flat_ids.numel())
+    if n == 0:
+        return
+    sorted_ids, perm = torch.sort(flat_ids, stable=True)
+    sorted_deltas = flat_deltas[perm].to(dtype=torch.float32)
+    same_id = sorted_ids.unsqueeze(1) == sorted_ids.unsqueeze(0)
+    first_mask = torch.ones_like(sorted_ids, dtype=torch.bool)
+    if n > 1:
+        first_mask[1:] = sorted_ids[1:] != sorted_ids[:-1]
+    weights = (same_id & first_mask.unsqueeze(1)).to(dtype=torch.float32)
+    grouped_deltas = torch.matmul(weights, sorted_deltas).to(dtype=target.dtype)
+    target.index_add_(0, sorted_ids, grouped_deltas)
+
+
+class OnlineDSparkHeadAdapter:
+    """Online verification-driven adapter for DSpark Markov and confidence heads.
+
+    Updates DSpark ``markov_w1`` conditioning embeddings (and optional unpacked
+    candidate ``markov_w2`` rows / low-rank residual adapter) together with
+    ``confidence_head.proj.weight`` using:
+      1. Prefix-product total variation (``E2E-TV``) loss over top-k candidate
+         subsets ``S_{b,i}``, preserving unnormalized excluded teacher mass
+         ``1 - sum_{v in S_{b,i}} p_{b,i}(v)``; and
+      2. Auxiliary binary cross-entropy (``BCE``) loss on the confidence head
+         against detached token overlap ``sg(1 - d_{b,i})``.
+
+    Works both inside ``@torch.inference_mode()`` using closed-form analytic
+    gradients (zero autograd graph overhead during live serving) and under
+    standard PyTorch autograd. Because ``markov_w1`` and ``confidence_head``
+    are replicated across TP ranks and receive identical broadcast conditioning
+    tokens and candidate distributions, all TP ranks stay 100% bit-synchronized
+    without extra inter-rank communication.
+    """
+
+    def __init__(
+        self,
+        markov_w1: nn.Embedding | torch.Tensor,
+        markov_w2: nn.Module | torch.Tensor,
+        confidence_head: nn.Module | torch.Tensor | None = None,
+        *,
+        hidden_to_markov_proj: nn.Module | torch.Tensor | None = None,
+        lr_markov_w1: float = 0.08,
+        lr_markov_w2: float = 0.04,
+        lr_hidden_to_markov: float | None = None,
+        lr_confidence: float = 0.05,
+        bce_weight: float = 0.25,
+        weight_decay: float = 0.0,
+        max_grad_norm: float = 2.0,
+        update_w2: bool = True,
+        precondition_by_row_norm: bool = True,
+        latent_noise_std: float = 0.0,
+        noise_seed: int = 1729,
+        calibrator: OnlineConfidenceCalibrator | None = None,
+    ) -> None:
+        self.markov_w1 = markov_w1
+        self.markov_w2 = markov_w2
+        self.confidence_head = confidence_head
+        self.hidden_to_markov_proj = hidden_to_markov_proj
+        self.lr_markov_w1 = float(lr_markov_w1)
+        self.lr_markov_w2 = float(lr_markov_w2)
+        self.lr_hidden_to_markov = (
+            float(lr_markov_w1)
+            if lr_hidden_to_markov is None
+            else float(lr_hidden_to_markov)
+        )
+        self.lr_confidence = float(lr_confidence)
+        self.bce_weight = float(bce_weight)
+        self.weight_decay = float(weight_decay)
+        self.max_grad_norm = float(max_grad_norm)
+        self.update_w2 = bool(update_w2)
+        self.precondition_by_row_norm = bool(precondition_by_row_norm)
+        self.latent_noise_std = float(latent_noise_std)
+        self.noise_seed = int(noise_seed)
+        self.calibrator = calibrator
+        self.step_count: int = 0
+        self.last_metrics: dict[str, float] = {}
+
+    @property
+    def w1_weight(self) -> torch.Tensor:
+        if isinstance(self.markov_w1, nn.Embedding):
+            return self.markov_w1.weight
+        if hasattr(self.markov_w1, "weight"):
+            return self.markov_w1.weight
+        return self.markov_w1
+
+    @property
+    def hidden_proj_weight(self) -> torch.Tensor | None:
+        if self.hidden_to_markov_proj is None:
+            return None
+        if isinstance(self.hidden_to_markov_proj, torch.Tensor):
+            return self.hidden_to_markov_proj
+        if hasattr(self.hidden_to_markov_proj, "weight"):
+            return self.hidden_to_markov_proj.weight
+        return None
+
+    def _project_hidden_to_markov(
+        self, hidden_f: torch.Tensor, markov_rank: int
+    ) -> torch.Tensor | None:
+        proj_w = self.hidden_proj_weight
+        if proj_w is None:
+            return None
+        steps = int(hidden_f.shape[1]) if hidden_f.ndim >= 2 else 1
+        if self.latent_noise_std > 0.0 and steps > 1:
+            denom_k = float(max(1, steps - 1))
+            pos_f = torch.arange(steps, dtype=torch.float32, device=hidden_f.device)
+            sigma_sched = (self.latent_noise_std * (pos_f / denom_k)).view(1, steps, 1)
+            hidden_f = hidden_f * (1.0 / (1.0 + 16.0 * sigma_sched.pow(2)))
+        pw = proj_w.float()
+        if pw.shape == (hidden_f.shape[-1], markov_rank):
+            return torch.matmul(hidden_f, pw)
+        if pw.shape == (markov_rank, hidden_f.shape[-1]):
+            return torch.matmul(hidden_f, pw.t())
+        raise ValueError(
+            f"hidden_to_markov_proj shape {tuple(pw.shape)} incompatible with "
+            f"(hidden_size={hidden_f.shape[-1]}, markov_rank={markov_rank})"
+        )
+
+    def apply_position_scaled_latent_noise(
+        self,
+        latents: torch.Tensor,
+        *,
+        noise_std: float | None = None,
+        generator: torch.Generator | None = None,
+        return_sigma_schedule: bool = False,
+    ) -> torch.Tensor | tuple[torch.Tensor, torch.Tensor]:
+        """Inject position-scaled Gaussian noise into continuous block latents.
+
+        For draft steps ``i = 0, ..., W - 1`` with ``K = max(1, W - 1)``, the noise
+        scale at step ``i`` is ``sigma_i = sigma_0 * (i / K)`` (zero at anchor step
+        ``i = 0`` and linearly increasing across 1-step block-predicted positions
+        ``i >= 1``):
+
+            z_tilde_{b,i} = z_{b,i} + sigma_i * eps_{b,i},   eps_{b,i} ~ N(0, I)
+        """
+        sigma_0 = self.latent_noise_std if noise_std is None else float(noise_std)
+        steps = int(latents.shape[1])
+        denom_k = float(max(1, steps - 1))
+        pos = torch.arange(steps, dtype=torch.float32, device=latents.device)
+        sigma_schedule = (sigma_0 * (pos / denom_k)).view(1, steps, 1)
+        if sigma_0 <= 0.0 or steps <= 1:
+            sigma_1d = sigma_schedule.view(steps)
+            if return_sigma_schedule:
+                return latents, sigma_1d
+            return latents
+
+        if generator is None:
+            generator = torch.Generator(device=latents.device)
+            generator.manual_seed(
+                int(self.noise_seed + self.step_count * 1009 + latents.shape[-1])
+            )
+        eps = torch.randn(
+            latents.shape,
+            dtype=torch.float32,
+            device=latents.device,
+            generator=generator,
+        )
+        rms = latents.float().pow(2).mean(dim=-1, keepdim=True).sqrt().clamp_min(1e-4)
+        perturbed = (latents.float() + sigma_schedule * rms * eps).to(
+            dtype=latents.dtype
+        )
+        if return_sigma_schedule:
+            return perturbed, sigma_schedule.view(steps)
+        return perturbed
+
+    @property
+    def conf_weight(self) -> torch.Tensor | None:
+        if self.confidence_head is None:
+            return None
+        if isinstance(self.confidence_head, torch.Tensor):
+            return self.confidence_head
+        if hasattr(self.confidence_head, "proj") and hasattr(
+            self.confidence_head.proj, "weight"
+        ):
+            return self.confidence_head.proj.weight
+        if hasattr(self.confidence_head, "weight"):
+            return self.confidence_head.weight
+        return None
+
+    def _gather_w2_candidate_rows(
+        self, candidate_ids: torch.Tensor
+    ) -> tuple[torch.Tensor, bool]:
+        """Return ``([batch, steps, topk, markov_rank], is_direct_weight_tensor)``."""
+        if isinstance(self.markov_w2, torch.Tensor):
+            return self.markov_w2[candidate_ids], True
+        if hasattr(self.markov_w2, "weight") and isinstance(
+            self.markov_w2.weight, torch.Tensor
+        ):
+            return self.markov_w2.weight[candidate_ids], True
+        # Packed 12-bit BF16 ParallelLMHead: unpack the candidate rows on the fly.
+        from vllm.model_executor.models.qwen3_dspark import unpack_markov_w2_rows
+
+        flat_ids = candidate_ids.reshape(-1)
+        unpacked = unpack_markov_w2_rows(self.markov_w2, flat_ids)
+        return unpacked.view(*candidate_ids.shape, -1), False
+
+    def compute_candidate_logits_and_confidences(
+        self,
+        conditioning_token_ids: torch.Tensor,
+        candidate_ids: torch.Tensor,
+        base_candidate_logits: torch.Tensor,
+        hidden_states: torch.Tensor | None = None,
+    ) -> tuple[torch.Tensor, torch.Tensor | None, torch.Tensor | None]:
+        """Compute drafter candidate logits on ``S_{b,i}`` and confidence predictions.
+
+        Args:
+            conditioning_token_ids: ``[batch, steps]`` preceding tokens ``y_{b,i-1}``.
+            candidate_ids: ``[batch, steps, topk]`` candidate token IDs ``S_{b,i}``.
+            base_candidate_logits: ``[batch, steps, topk]`` base LM head logits on ``S_{b,i}``.
+            hidden_states: Optional ``[batch, steps, hidden_size]`` drafter hidden states.
+
+        Returns:
+            ``(draft_candidate_logits, confidence_logits, confidence_probs)``
+        """
+        w1 = self.w1_weight
+        u = w1[conditioning_token_ids].float()  # [B, W, R]
+        hidden_f = hidden_states.float() if hidden_states is not None else None
+        if hidden_f is not None:
+            proj_delta = self._project_hidden_to_markov(hidden_f, int(u.shape[-1]))
+            if proj_delta is not None:
+                m_query = u + proj_delta
+            else:
+                m_query = u
+        else:
+            m_query = u
+
+        w2_rows, _ = self._gather_w2_candidate_rows(candidate_ids)
+        w2_f = w2_rows.float()  # [B, W, K, R]
+
+        markov_logits = torch.einsum("bwr,bwkr->bwk", m_query, w2_f)
+        draft_candidate_logits = base_candidate_logits.float() + markov_logits
+
+        conf_logits: torch.Tensor | None = None
+        conf_probs: torch.Tensor | None = None
+        conf_w = self.conf_weight
+        if conf_w is not None and hidden_f is not None:
+            feat = torch.cat([hidden_f, m_query], dim=-1)  # [B, W, H + R]
+            w_vec = conf_w.float().view(-1)
+            conf_logits = torch.mv(feat.reshape(-1, feat.shape[-1]), w_vec).view(
+                conditioning_token_ids.shape
+            )
+            conf_probs = torch.sigmoid(conf_logits)
+            if self.calibrator is not None:
+                conf_probs = self.calibrator.calibrate(conf_probs)
+
+        return draft_candidate_logits, conf_logits, conf_probs
+
+    @torch.no_grad()
+    def step_on_candidates(
+        self,
+        conditioning_token_ids: torch.Tensor,
+        candidate_ids: torch.Tensor,
+        base_candidate_logits: torch.Tensor,
+        target_candidate_probs: torch.Tensor,
+        *,
+        hidden_states: torch.Tensor | None = None,
+        valid_mask: torch.Tensor | None = None,
+        accepted_counts: torch.Tensor | None = None,
+        verified_counts: torch.Tensor | None = None,
+        return_metrics: bool = True,
+    ) -> dict[str, float]:
+        """Perform one online ``E2E-TV`` + ``BCE`` adaptation step on DSpark heads.
+
+        Executes entirely with closed-form tensor operations (compatible with
+        ``@torch.inference_mode()``) and updates ``markov_w1``, optional
+        ``hidden_to_markov_proj`` (256-dim Markov latent encoder projection),
+        optional unpacked ``markov_w2`` rows, ``confidence_head``, and optional
+        ``OnlineConfidenceCalibrator`` in place. When ``latent_noise_std > 0``,
+        applies position-scaled Gaussian noise ``sigma_i = sigma_0 * (i / K)``
+        for block-predicted positions ``i >= 1`` so the continuous latent and
+        confidence adapters generalize smoothly across noisy 1-step predictions.
+        """
+        bsz, steps, topk = candidate_ids.shape
+        if bsz == 0 or steps == 0 or topk == 0:
+            return self.last_metrics
+
+        w1 = self.w1_weight
+        u = w1[conditioning_token_ids].float()  # [B, W, R]
+        markov_rank = int(u.shape[-1])
+
+        denom_k = float(max(1, steps - 1))
+        pos_f = torch.arange(steps, dtype=torch.float32, device=candidate_ids.device)
+        sigma_schedule = (self.latent_noise_std * (pos_f / denom_k)).view(1, steps, 1)
+
+        hidden_f: torch.Tensor | None = None
+        if hidden_states is not None:
+            if self.latent_noise_std > 0.0 and steps > 1:
+                hidden_f = self.apply_position_scaled_latent_noise(
+                    hidden_states.float(),
+                    noise_std=0.15 * self.latent_noise_std,
+                )
+            else:
+                hidden_f = hidden_states.float()
+
+        proj_delta = (
+            self._project_hidden_to_markov(hidden_f, markov_rank)
+            if hidden_f is not None
+            else None
+        )
+        m_query = u + proj_delta if proj_delta is not None else u
+        if self.latent_noise_std > 0.0 and steps > 1 and proj_delta is None:
+            m_for_forward = self.apply_position_scaled_latent_noise(
+                m_query, noise_std=0.15 * self.latent_noise_std
+            )
+        else:
+            m_for_forward = m_query
+
+        w2_rows, w2_is_direct = self._gather_w2_candidate_rows(candidate_ids)
+        w2_f = w2_rows.float()  # [B, W, K, R]
+
+        markov_logits = torch.einsum("bwr,bwkr->bwk", m_for_forward, w2_f)
+        draft_logits = base_candidate_logits.float() + markov_logits
+
+        conf_w = self.conf_weight
+        conf_logits: torch.Tensor | None = None
+        feat: torch.Tensor | None = None
+        if conf_w is not None and hidden_f is not None:
+            feat = torch.cat([hidden_f, m_for_forward], dim=-1)  # [B, W, H + R]
+            conf_logits = torch.mv(
+                feat.reshape(-1, feat.shape[-1]), conf_w.float().view(-1)
+            ).view(bsz, steps)
+
+        loss_res = compute_e2e_tv_and_bce_loss(
+            draft_logits,
+            target_candidate_probs,
+            confidence_logits=conf_logits,
+            valid_mask=valid_mask,
+            bce_weight=self.bce_weight,
+        )
+
+        # Analytic gradient of E2E-TV with respect to draft_logits [B, W, K]:
+        # L_E2E-TV = 1 - (1 / N_valid) * sum_{b, j} prod_{i=0}^j alpha_{b,i}
+        # For each step i, d L_E2E-TV / d d_{b,i} = (1 / N_valid) * sum_{j=i}^{W-1} prod_{m != i, m <= j} alpha_{b,m}
+        alpha = loss_res.token_overlap  # [B, W]
+        if valid_mask is not None:
+            mask_b = valid_mask.bool()
+            mask_f = mask_b.to(dtype=alpha.dtype)
+            eff_alpha = torch.where(mask_b, alpha, torch.ones_like(alpha))
+            denom = mask_f.sum().clamp_min(1.0)
+        else:
+            mask_b = torch.ones_like(alpha, dtype=torch.bool)
+            mask_f = torch.ones_like(alpha)
+            eff_alpha = alpha
+            denom = float(bsz * steps)
+
+        # Vectorized prefix-product sensitivity omega_{b,i} = sum_{j=i}^{W-1} prod_{m=0, m != i}^j eff_alpha_{b,m}
+        # Build [B, W_i, W_j, W_m] where entry (b, i, j, m) is eff_alpha[b, m] if (m <= j and m != i) else 1.0
+        idx = torch.arange(steps, device=alpha.device)
+        cond_m = (idx.view(1, 1, -1) <= idx.view(1, -1, 1)) & (
+            idx.view(1, 1, -1) != idx.view(-1, 1, 1)
+        )  # [W_i, W_j, W_m]
+        factors = torch.where(
+            cond_m.unsqueeze(0),
+            eff_alpha[:, None, None, :],
+            torch.ones((1, 1, 1, 1), dtype=alpha.dtype, device=alpha.device),
+        )  # [B, W_i, W_j, W_m]
+        prod_ij = factors.prod(dim=-1)  # [B, W_i, W_j]
+        upper_mask = (idx.view(-1, 1) <= idx.view(1, -1)).to(dtype=alpha.dtype)  # [W_i, W_j]
+        omega = (prod_ij * upper_mask.unsqueeze(0) * mask_f.unsqueeze(1)).sum(
+            dim=-1
+        ) * mask_f  # [B, W_i]
+
+        # d d_{b,i} / d q_{b,i}(v) = 0.5 * sign(q_{b,i}(v) - p_{b,i}(v))
+        q_probs = F.softmax(draft_logits, dim=-1)
+        p_probs = target_candidate_probs.float().clamp_min(0.0)
+        sign_qp = 0.5 * torch.sign(q_probs - p_probs)
+        expected_sign = (q_probs * sign_qp).sum(dim=-1, keepdim=True)
+        d_dist_d_logit = q_probs * (sign_qp - expected_sign)  # [B, W, K]
+
+        if self.precondition_by_row_norm:
+            eff_omega = torch.maximum(omega, 0.65 * mask_f)
+            step_grad_logits = eff_omega.unsqueeze(-1) * d_dist_d_logit  # [B, W, K]
+            w2_row_energy = (
+                (w2_f * w2_f).sum(dim=-1).mean(dim=-1, keepdim=True).clamp_min(1e-3)
+            )  # [B, W, 1]
+            u_energy = (
+                (m_for_forward * m_for_forward)
+                .sum(dim=-1, keepdim=True)
+                .unsqueeze(-1)
+                .clamp_min(0.05)
+            )  # [B, W, 1, 1]
+            grad_m = (
+                torch.einsum("bwk,bwkr->bwr", step_grad_logits, w2_f) / w2_row_energy
+            )
+            grad_w2 = (
+                torch.einsum("bwk,bwr->bwkr", step_grad_logits, m_for_forward)
+                / u_energy
+            )
+        else:
+            grad_logits = (omega / denom).unsqueeze(-1) * d_dist_d_logit  # [B, W, K]
+            grad_m = torch.einsum("bwk,bwkr->bwr", grad_logits, w2_f)  # [B, W, R]
+            grad_w2 = torch.einsum(
+                "bwk,bwr->bwkr", grad_logits, m_for_forward
+            )  # [B, W, K, R]
+
+        grad_u = grad_m
+        grad_u_norm = grad_u.norm(dim=-1, keepdim=True).clamp_min(1e-8)
+        grad_u_scale = torch.clamp(self.max_grad_norm / grad_u_norm, max=1.0)
+        grad_u = grad_u * grad_u_scale
+
+        if self.weight_decay > 0.0:
+            grad_u = grad_u + self.weight_decay * u
+
+        flat_cond_ids = conditioning_token_ids.reshape(-1)
+        flat_delta_u = (-self.lr_markov_w1 * grad_u).reshape(-1, grad_u.shape[-1])
+        _deterministic_index_add_(w1, flat_cond_ids, flat_delta_u)
+
+        # Joint latent-encoder update on hidden_to_markov_proj (mapping hidden_states z_i -> Markov query m_i)
+        proj_w = self.hidden_proj_weight
+        if proj_w is not None and hidden_f is not None and self.lr_hidden_to_markov > 0.0:
+            # Expected position-scaled Gaussian noise smoothing & curvature damping on positions i >= 1:
+            step_precision = 1.0 / (1.0 + 16.0 * sigma_schedule.pow(2))  # [1, W, 1]
+            smoothed_hidden = hidden_f * step_precision
+            noise_var_weight = 3.5 * (sigma_schedule.pow(2) * mask_f.unsqueeze(-1)).mean()
+            grad_proj_hr = torch.einsum("bwh,bwr->hr", smoothed_hidden, grad_m) / float(
+                max(1, bsz * steps)
+            )
+            if self.precondition_by_row_norm:
+                h_energy = (
+                    (hidden_f * hidden_f).sum(dim=-1).mean().clamp_min(1e-2)
+                )
+                grad_proj_hr = grad_proj_hr / h_energy
+            pw_f = proj_w.float()
+            if pw_f.shape == grad_proj_hr.shape:
+                grad_proj = grad_proj_hr + noise_var_weight * pw_f
+            else:
+                grad_proj = grad_proj_hr.t() + noise_var_weight * pw_f
+            grad_proj_norm = grad_proj.norm().clamp_min(1e-8)
+            grad_proj = grad_proj * torch.clamp(
+                self.max_grad_norm / grad_proj_norm, max=1.0
+            )
+            proj_w.add_(
+                (-self.lr_hidden_to_markov * grad_proj).to(dtype=proj_w.dtype)
+            )
+
+        if self.update_w2 and w2_is_direct and self.lr_markov_w2 > 0.0:
+            w2_tensor = (
+                self.markov_w2
+                if isinstance(self.markov_w2, torch.Tensor)
+                else self.markov_w2.weight
+            )
+            grad_w2_norm = grad_w2.norm(dim=-1, keepdim=True).clamp_min(1e-8)
+            grad_w2_scale = torch.clamp(self.max_grad_norm / grad_w2_norm, max=1.0)
+            grad_w2 = grad_w2 * grad_w2_scale
+            flat_cand_ids = candidate_ids.reshape(-1)
+            flat_delta_w2 = (-self.lr_markov_w2 * grad_w2).reshape(
+                -1, grad_w2.shape[-1]
+            )
+            _deterministic_index_add_(w2_tensor, flat_cand_ids, flat_delta_w2)
+
+        # Update confidence_head via auxiliary BCE gradient against detached token overlap sg(1 - d_{b,i})
+        if conf_w is not None and conf_logits is not None and feat is not None:
+            conf_probs_raw = torch.sigmoid(conf_logits)
+            detached_overlap = alpha.detach()
+            grad_conf_logit = (
+                (conf_probs_raw - detached_overlap) * mask_f / denom
+            ) * self.bce_weight  # [B, W]
+            grad_conf_w = torch.einsum("bw,bwd->d", grad_conf_logit, feat)
+            if self.precondition_by_row_norm:
+                feat_energy = (feat * feat).sum(dim=-1).mean().clamp_min(1.0)
+                grad_conf_w = grad_conf_w / feat_energy
+            if self.latent_noise_std > 0.0 and hidden_f is not None and steps > 1:
+                h_dim = int(hidden_f.shape[-1])
+                noise_var_conf = 2.5 * (
+                    sigma_schedule.squeeze(-1).pow(2) * mask_f
+                ).mean()
+                grad_conf_w[:h_dim] = (
+                    grad_conf_w[:h_dim]
+                    + noise_var_conf * conf_w.float().view(-1)[:h_dim]
+                )
+            grad_conf_norm = grad_conf_w.norm().clamp_min(1e-8)
+            grad_conf_w = grad_conf_w * torch.clamp(
+                self.max_grad_norm / grad_conf_norm, max=1.0
+            )
+            conf_w.view(-1).add_(
+                (-self.lr_confidence * grad_conf_w).to(dtype=conf_w.dtype)
+            )
+
+            if self.calibrator is not None and accepted_counts is not None:
+                self.calibrator.observe(
+                    conf_probs_raw,
+                    accepted_counts,
+                    verified_counts=verified_counts,
+                    return_metrics=return_metrics,
+                )
+
+        self.step_count += 1
+        if not return_metrics:
+            return self.last_metrics
+
+        vals = torch.stack(
+            [
+                loss_res.total_loss,
+                loss_res.e2e_tv_loss,
+                loss_res.bce_loss,
+                loss_res.token_overlap.mean(),
+                loss_res.prefix_survival.sum(dim=-1).mean(),
+                loss_res.excluded_teacher_mass.mean(),
+            ]
+        ).tolist()
+        self.last_metrics = {
+            "total_loss": float(vals[0]),
+            "e2e_tv_loss": float(vals[1]),
+            "bce_loss": float(vals[2]),
+            "mean_overlap": float(vals[3]),
+            "mean_prefix_survival": float(vals[4]),
+            "excluded_teacher_mass": float(vals[5]),
+        }
+        return self.last_metrics
+
+    @torch.no_grad()
+    def step_from_verified_tokens(
+        self,
+        conditioning_token_ids: torch.Tensor,
+        draft_tokens: torch.Tensor,
+        verified_target_tokens: torch.Tensor,
+        accepted_counts: torch.Tensor,
+        *,
+        runner_up_tokens: torch.Tensor | None = None,
+        base_candidate_logits: torch.Tensor | None = None,
+        hidden_states: torch.Tensor | None = None,
+        verified_counts: torch.Tensor | None = None,
+        target_peak_prob: float = 0.92,
+        excluded_teacher_mass: float = 0.03,
+    ) -> dict[str, float]:
+        """Adapt DSpark heads from realized verification tokens on the draft branch.
+
+        Constructs a compact candidate support ``S_{b,i}`` at each conditionally
+        reached position ``i <= A_b`` containing ``[verified_target_token, draft_token, runner_up_token]``
+        (with distinct token IDs) and target probability mass ``1 - excluded_teacher_mass``
+        on ``S_{b,i}``, then runs ``step_on_candidates``.
+        """
+        bsz, steps = draft_tokens.shape
+        device = draft_tokens.device
+        vocab_size = int(self.w1_weight.shape[0])
+
+        acc = accepted_counts[:bsz].to(device=device, dtype=torch.int64).clamp_min(0)
+        if verified_counts is None:
+            ver = torch.full((bsz,), steps, dtype=torch.int64, device=device)
+        else:
+            ver = verified_counts[:bsz].to(device=device, dtype=torch.int64).clamp(0, steps)
+
+        pos = torch.arange(steps, dtype=torch.int64, device=device).unsqueeze(0)
+        valid_mask = (pos <= acc.unsqueeze(1)) & (pos < ver.unsqueeze(1))
+
+        # Build 3-candidate support S_{b,i} = [target_tok, alt_1, alt_2] with distinct IDs
+        tgt = verified_target_tokens[:, :steps].to(device=device, dtype=torch.int64).clamp(0, vocab_size - 1)
+        drf = draft_tokens[:, :steps].to(device=device, dtype=torch.int64).clamp(0, vocab_size - 1)
+        alt1 = torch.where(drf != tgt, drf, (tgt + 1) % vocab_size)
+        if runner_up_tokens is not None:
+            rup = runner_up_tokens[:, :steps].to(device=device, dtype=torch.int64).clamp(0, vocab_size - 1)
+            alt2 = torch.where((rup != tgt) & (rup != alt1), rup, (tgt + 2) % vocab_size)
+        else:
+            alt2 = (tgt + 2) % vocab_size
+        alt2 = torch.where(alt2 == alt1, (tgt + 3) % vocab_size, alt2)
+
+        candidate_ids = torch.stack([tgt, alt1, alt2], dim=-1)  # [B, W, 3]
+        if base_candidate_logits is None:
+            base_candidate_logits = torch.zeros(
+                (bsz, steps, 3), dtype=torch.float32, device=device
+            )
+
+        included_mass = max(0.0, min(1.0, 1.0 - float(excluded_teacher_mass)))
+        peak = min(included_mass, float(target_peak_prob))
+        rem = max(0.0, included_mass - peak) * 0.5
+        target_probs = torch.empty((bsz, steps, 3), dtype=torch.float32, device=device)
+        target_probs[..., 0] = peak
+        target_probs[..., 1] = rem
+        target_probs[..., 2] = rem
+
+        return self.step_on_candidates(
+            conditioning_token_ids[:, :steps].clamp(0, vocab_size - 1),
+            candidate_ids,
+            base_candidate_logits,
+            target_probs,
+            hidden_states=hidden_states,
+            valid_mask=valid_mask,
+            accepted_counts=accepted_counts,
+            verified_counts=verified_counts,
+        )
+
+
+class SessionTokenMemory:
+    """Bounded cross-request session suffix and Markov transition memory on GPU.
+
+    Retains verified user/assistant tokens across requests within a session so
+    recurring codebase identifiers, file paths, and tool-call schemas on Turn 2+
+    can be drafted immediately by ``CopyDrafter`` and ``DSpark`` even before
+    they appear in the current request prompt.
+    """
+
+    def __init__(
+        self,
+        capacity: int = 4096,
+        *,
+        min_match_len: int = 3,
+        max_match_len: int = 8,
+        base_confidence: float = 0.85,
+        confidence_decay: float = 0.92,
+        device: torch.device | str = "cpu",
+    ) -> None:
+        if capacity <= 0:
+            raise ValueError(f"capacity must be positive, got {capacity}")
+        self.capacity = int(capacity)
+        self.min_match_len = int(min_match_len)
+        self.max_match_len = int(max_match_len)
+        self.base_confidence = float(base_confidence)
+        self.confidence_decay = float(confidence_decay)
+        self.device = torch.device(device)
+
+        self.buffer = torch.full(
+            (self.capacity,), -1, dtype=torch.int64, device=self.device
+        )
+        self.size: int = 0
+        self.write_pos: int = 0
+        self.total_ingested: int = 0
+
+    def reset(self) -> None:
+        self.buffer.fill_(-1)
+        self.size = 0
+        self.write_pos = 0
+        self.total_ingested = 0
+
+    @torch.no_grad()
+    def record_verified_tokens(self, tokens: torch.Tensor) -> None:
+        """Append 1D or 2D verified token sequence(s) into the bounded ring buffer."""
+        flat = tokens.reshape(-1).to(device=self.device, dtype=torch.int64)
+        flat = flat[flat >= 0]
+        n = int(flat.numel())
+        if n == 0:
+            return
+        if n >= self.capacity:
+            self.buffer.copy_(flat[-self.capacity :])
+            self.size = self.capacity
+            self.write_pos = 0
+            self.total_ingested += n
+            return
+
+        if self.size < self.capacity and self.write_pos + n <= self.capacity:
+            self.buffer[self.write_pos : self.write_pos + n].copy_(flat)
+            self.write_pos = (self.write_pos + n) % self.capacity
+            self.size = min(self.capacity, self.size + n)
+        else:
+            ordered = self.get_chronological_tokens()
+            combined = torch.cat([ordered, flat], dim=0)[-self.capacity :]
+            self.buffer[: combined.numel()].copy_(combined)
+            self.size = int(combined.numel())
+            self.write_pos = self.size % self.capacity
+        self.total_ingested += n
+
+    def get_chronological_tokens(self) -> torch.Tensor:
+        """Return the valid session tokens in chronological order ``[size]``."""
+        if self.size == 0:
+            return self.buffer[:0]
+        return self.buffer[: self.size]
+
+    @torch.no_grad()
+    def propose_suffix_continuation(
+        self,
+        context_tokens: torch.Tensor,
+        num_draft_steps: int,
+        *,
+        seq_lens: torch.Tensor | None = None,
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        """Match request context suffixes against persistent session token memory.
+
+        Args:
+            context_tokens: ``[num_reqs, max_seq_len]`` token IDs.
+            num_draft_steps: Number of speculative draft tokens ``W`` to propose.
+            seq_lens: Optional ``[num_reqs]`` valid lengths in ``context_tokens``.
+
+        Returns:
+            ``(draft_tokens [num_reqs, W], match_lengths [num_reqs], confidences [num_reqs, W])``
+            where ``match_lengths[r] == 0`` when no suffix match of length
+            ``>= min_match_len`` was found in session memory.
+        """
+        if context_tokens.ndim == 1:
+            context_tokens = context_tokens.unsqueeze(0)
+        num_reqs, max_len = context_tokens.shape
+        device = context_tokens.device
+        out_tokens = torch.zeros(
+            (num_reqs, num_draft_steps), dtype=torch.int64, device=device
+        )
+        match_lengths = torch.zeros((num_reqs,), dtype=torch.int32, device=device)
+        confidences = torch.zeros(
+            (num_reqs, num_draft_steps), dtype=torch.float32, device=device
+        )
+
+        mem = self.get_chronological_tokens().to(device=device)
+        mem_len = int(mem.numel())
+        if mem_len < self.min_match_len + num_draft_steps or num_draft_steps <= 0:
+            return out_tokens, match_lengths, confidences
+
+        searchable_end = mem_len - num_draft_steps
+        step_decay = self.confidence_decay ** torch.arange(
+            num_draft_steps, dtype=torch.float32, device=device
+        )
+
+        for r in range(num_reqs):
+            cur_len = int(seq_lens[r].item()) if seq_lens is not None else max_len
+            if cur_len < self.min_match_len:
+                continue
+            row = context_tokens[r, :cur_len]
+            max_n = min(self.max_match_len, cur_len, searchable_end)
+            best_len = 0
+            best_pos = -1
+
+            # Search from longest suffix to shortest suffix, preferring the most recent match.
+            for n in range(max_n, self.min_match_len - 1, -1):
+                suffix = row[cur_len - n : cur_len]
+                windows = mem[: searchable_end + n - 1].unfold(0, n, 1)
+                matches = (windows == suffix.unsqueeze(0)).all(dim=-1)
+                if bool(matches.any()):
+                    match_indices = torch.nonzero(matches, as_tuple=False).view(-1)
+                    best_pos = int(match_indices[-1].item())
+                    best_len = n
+                    break
+
+            if best_len >= self.min_match_len and best_pos >= 0:
+                start = best_pos + best_len
+                out_tokens[r] = mem[start : start + num_draft_steps]
+                match_lengths[r] = best_len
+                len_bonus = min(1.0, best_len / float(self.max_match_len))
+                base_c = min(0.98, self.base_confidence + 0.10 * len_bonus)
+                confidences[r] = base_c * step_decay
+
+        return out_tokens, match_lengths, confidences
+
+    @torch.no_grad()
+    def extract_verified_transitions(
+        self, window_size: int
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """Extract contiguous ``(conditioning_tokens, next_tokens)`` windows of width ``window_size``."""
+        mem = self.get_chronological_tokens()
+        if int(mem.numel()) <= window_size:
+            empty = mem.new_empty((0, window_size))
+            return empty, empty
+        cond = mem[:-1].unfold(0, window_size, 1)
+        nxt = mem[1:].unfold(0, window_size, 1)
+        return cond, nxt
+
+
+@torch.no_grad()
+def verify_greedy_lossless(
+    draft_tokens: torch.Tensor,
+    target_logits: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Lossless greedy speculative verification.
+
+    Args:
+        draft_tokens: ``[batch, num_spec_steps]`` proposed draft token IDs.
+        target_logits: ``[batch, num_spec_steps + 1, vocab_size]`` target logits
+            evaluated on ``[anchor, draft_0, ..., draft_{W-1}]``.
+
+    Returns:
+        ``(emitted_tokens [batch, num_spec_steps + 1], num_accepted [batch], num_emitted [batch])``
+        where ``emitted_tokens[b, :num_emitted[b]]`` are 100% identical to
+        autoregressive greedy decoding of the target model.
+    """
+    bsz, steps = draft_tokens.shape
+    target_argmax = target_logits.argmax(dim=-1)  # [B, W + 1]
+    matches = draft_tokens == target_argmax[:, :steps]  # [B, W]
+    prefix_valid = torch.cumprod(matches.to(dtype=torch.int64), dim=-1)
+    num_accepted = prefix_valid.sum(dim=-1)  # [B]
+    num_emitted = num_accepted + 1
+
+    emitted = torch.full(
+        (bsz, steps + 1), -1, dtype=draft_tokens.dtype, device=draft_tokens.device
+    )
+    for b in range(bsz):
+        acc = int(num_accepted[b].item())
+        if acc > 0:
+            emitted[b, :acc] = draft_tokens[b, :acc]
+        emitted[b, acc] = target_argmax[b, acc]
+    return emitted, num_accepted, num_emitted
+
+
+@torch.no_grad()
+def verify_rejection_sampling_lossless(
+    draft_tokens: torch.Tensor,
+    draft_probs: torch.Tensor,
+    target_probs: torch.Tensor,
+    *,
+    uniform_samples: torch.Tensor | None = None,
+    residual_uniform_samples: torch.Tensor | None = None,
+    generator: torch.Generator | None = None,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Lossless speculative rejection sampling with exact residual resampling.
+
+    For any draft distribution ``q(v)`` and target distribution ``p(v)``, accepts
+    ``y ~ q`` with probability ``min(1, p(y) / q(y))`` and on rejection resamples
+    from ``norm(max(0, p(v) - q(v)))``, guaranteeing that every emitted token is
+    distributed identically to ``p(v)``.
+    """
+    bsz, steps = draft_tokens.shape
+    device = draft_tokens.device
+
+    if uniform_samples is None:
+        uniform_samples = torch.rand(
+            (bsz, steps), dtype=torch.float32, device=device, generator=generator
+        )
+    if residual_uniform_samples is None:
+        residual_uniform_samples = torch.rand(
+            (bsz, steps + 1), dtype=torch.float32, device=device, generator=generator
+        )
+
+    emitted = torch.full((bsz, steps + 1), -1, dtype=torch.int64, device=device)
+    num_accepted = torch.zeros((bsz,), dtype=torch.int64, device=device)
+
+    for b in range(bsz):
+        acc = 0
+        for i in range(steps):
+            tok = int(draft_tokens[b, i].item())
+            q_tok = float(draft_probs[b, i, tok].clamp_min(1e-12).item())
+            p_tok = float(target_probs[b, i, tok].item())
+            accept_prob = min(1.0, p_tok / q_tok)
+            if float(uniform_samples[b, i].item()) < accept_prob:
+                emitted[b, i] = tok
+                acc += 1
+            else:
+                resid = (
+                    target_probs[b, i].float() - draft_probs[b, i].float()
+                ).clamp_min(0.0)
+                resid_sum = resid.sum()
+                if float(resid_sum.item()) <= 1e-12:
+                    resid_probs = target_probs[b, i].float()
+                    resid_probs = resid_probs / resid_probs.sum().clamp_min(1e-12)
+                else:
+                    resid_probs = resid / resid_sum
+                cdf = torch.cumsum(resid_probs, dim=-1)
+                u_val = residual_uniform_samples[b, i].clamp(0.0, 1.0 - 1e-7)
+                sampled_tok = int(
+                    torch.searchsorted(cdf, u_val)
+                    .clamp_max(resid_probs.numel() - 1)
+                    .item()
+                )
+                emitted[b, i] = sampled_tok
+                break
+        else:
+            bonus_probs = target_probs[b, steps].float()
+            bonus_probs = bonus_probs / bonus_probs.sum().clamp_min(1e-12)
+            cdf = torch.cumsum(bonus_probs, dim=-1)
+            u_val = residual_uniform_samples[b, steps].clamp(0.0, 1.0 - 1e-7)
+            bonus_tok = int(
+                torch.searchsorted(cdf, u_val)
+                .clamp_max(bonus_probs.numel() - 1)
+                .item()
+            )
+            emitted[b, steps] = bonus_tok
+
+        num_accepted[b] = acc
+
+    num_emitted = num_accepted + 1
+    return emitted, num_accepted, num_emitted
