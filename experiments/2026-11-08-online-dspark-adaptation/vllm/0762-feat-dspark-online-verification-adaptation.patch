+def test_e2e_tv_preserves_excluded_teacher_mass_and_matches_autograd():
+    """compute_e2e_tv_and_bce_loss must preserve unnormalized excluded teacher mass
+    and OnlineDSparkHeadAdapter analytic updates must match autograd gradients."""
+    device = _default_device()
+    torch.manual_seed(505)
+    bsz, steps, topk = 4, 4, 6
+    vocab_size, markov_rank, hidden_size = 64, 16, 32
+
+    # Verify excluded teacher mass increases step TV distance by 0.5 * (1 - sum_{S_i} p)
+    logits = torch.zeros(bsz, steps, topk, device=device)
+    full_p = torch.full((bsz, steps, topk), 1.0 / topk, device=device)
+    sub_p = full_p * 0.70  # 0.30 excluded teacher mass outside top-k
+
+    res_full = compute_e2e_tv_and_bce_loss(logits, full_p)
+    res_sub = compute_e2e_tv_and_bce_loss(logits, sub_p)
+
+    torch.testing.assert_close(
+        res_full.step_tv_distance, torch.zeros_like(res_full.step_tv_distance), atol=1e-6, rtol=0
+    )
+    # When q is uniform (1/K) and p is 0.7/K on support, L1 = 0.3 and excluded = 0.3 -> d = 0.3
+    torch.testing.assert_close(
+        res_sub.excluded_teacher_mass,
+        torch.full_like(res_sub.excluded_teacher_mass, 0.30),
+        atol=1e-6,
+        rtol=0,
+    )
+    torch.testing.assert_close(
+        res_sub.step_tv_distance,
+        torch.full_like(res_sub.step_tv_distance, 0.30),
+        atol=1e-6,
+        rtol=0,
+    )
+
+    # Verify analytic gradients in OnlineDSparkHeadAdapter match PyTorch autograd
+    w1_auto = torch.randn(
+        vocab_size, markov_rank, dtype=torch.float32, device=device, requires_grad=True
+    )
+    w2_auto = torch.randn(
+        vocab_size, markov_rank, dtype=torch.float32, device=device, requires_grad=True
+    )
+    conf_auto = torch.randn(
+        1, hidden_size + markov_rank, dtype=torch.float32, device=device, requires_grad=True
+    )
+
+    cond_ids = torch.randint(0, vocab_size, (bsz, steps), device=device)
+    cand_ids = torch.randint(0, vocab_size, (bsz, steps, topk), device=device)
+    base_logits = torch.randn(bsz, steps, topk, dtype=torch.float32, device=device)
+    target_probs = F.softmax(torch.randn(bsz, steps, topk, device=device), dim=-1) * 0.88
+    hidden = torch.randn(bsz, steps, hidden_size, dtype=torch.float32, device=device)
+
+    u = w1_auto[cond_ids]
+    w2_rows = w2_auto[cand_ids]
+    draft_logits = base_logits + torch.einsum("bwr,bwkr->bwk", u, w2_rows)
+    feat = torch.cat([hidden, u.detach()], dim=-1)
+    conf_logits = torch.mv(feat.view(-1, feat.shape[-1]), conf_auto.view(-1)).view(
+        bsz, steps
+    )
+    loss_out = compute_e2e_tv_and_bce_loss(
+        draft_logits, target_probs, confidence_logits=conf_logits, bce_weight=0.25
+    )
+    loss_out.total_loss.backward()
+
+    w1_analytic = w1_auto.detach().clone()
+    w2_analytic = w2_auto.detach().clone()
+    conf_analytic = conf_auto.detach().clone()
+
+    lr = 0.05
+    adapter = OnlineDSparkHeadAdapter(
+        w1_analytic,
+        w2_analytic,
+        conf_analytic,
+        lr_markov_w1=lr,
+        lr_markov_w2=lr,
+        lr_confidence=lr,
+        bce_weight=0.25,
+        max_grad_norm=1000.0,
+        precondition_by_row_norm=False,
+    )
+    with torch.inference_mode():
+        adapter.step_on_candidates(
+            cond_ids,
+            cand_ids,
+            base_logits,
+            target_probs,
+            hidden_states=hidden,
+        )
+
+    torch.testing.assert_close(
+        w1_analytic, w1_auto.detach() - lr * w1_auto.grad, atol=1e-5, rtol=1e-4
+    )
+    torch.testing.assert_close(
+        w2_analytic, w2_auto.detach() - lr * w2_auto.grad, atol=1e-5, rtol=1e-4
+    )
+    torch.testing.assert_close(
+        conf_analytic, conf_auto.detach() - lr * conf_auto.grad, atol=1e-5, rtol=1e-4
+    )
+
+
+def test_monotonic_reduction_of_e2e_tv_and_calibration_error_and_al_gain():
+    """Online adaptation on recurring user coding/tool-call streams must
+    monotonically reduce E2E-TV loss and calibration error while increasing
+    mean acceptance length (AL) and net utility (tokens/ms)."""
+    device = _default_device()
+    torch.manual_seed(606)
+
+    vocab_size = 128
+    markov_rank = 32
+    hidden_size = 64
+    steps = 5
+    topk = 8
+    bsz = 8
+
+    # Construct a user coding/tool-call transition pattern:
+    # token y_{t-1} deterministically favors target token next_tok(y_{t-1})
+    cond_ids = torch.arange(bsz * steps, device=device).view(bsz, steps) % 32
+    true_next = (cond_ids * 3 + 7) % vocab_size
+
+    # Candidate support S_{b,i} contains true_next at index 0 plus 7 distractors
+    distractors = torch.stack(
+        [(true_next + k * 5 + 1) % vocab_size for k in range(1, topk)], dim=-1
+    )
+    cand_ids = torch.cat([true_next.unsqueeze(-1), distractors], dim=-1)  # [B, W, K]
+
+    # Unadapted base logits initially prefer distractor index 1 over true_next index 0
+    base_logits = torch.zeros((bsz, steps, topk), dtype=torch.float32, device=device)
+    base_logits[..., 0] = -0.4
+    base_logits[..., 1] = 1.1
+
+    # Teacher verification probabilities on S_{b,i} (with 0.04 unnormalized excluded mass)
+    target_probs = torch.full(
+        (bsz, steps, topk), 0.06 / (topk - 1), dtype=torch.float32, device=device
+    )
+    target_probs[..., 0] = 0.90
+
+    hidden = torch.randn(bsz, steps, hidden_size, dtype=torch.float32, device=device)
+    w1 = nn.Embedding(vocab_size, markov_rank, device=device, dtype=torch.float32)
+    nn.init.normal_(w1.weight, std=0.02)
+    w2 = torch.randn(vocab_size, markov_rank, dtype=torch.float32, device=device) * 0.15
+    # Make confidence head initially overconfident (~0.90) even when unadapted drafter is wrong
+    conf_w = torch.zeros(1, hidden_size + markov_rank, dtype=torch.float32, device=device)
+    hidden[:, :, 0] = 1.0
+    conf_w[0, 0] = 2.2
+
+    calibrator = OnlineConfidenceCalibrator(
+        num_steps=steps, lr_bias=0.35, lr_scale=0.15, device=device
+    )
+    adapter = OnlineDSparkHeadAdapter(
+        w1,
+        w2,
+        conf_w,
+        lr_markov_w1=0.35,
+        lr_markov_w2=0.25,
+        lr_confidence=0.15,
+        bce_weight=0.30,
+        calibrator=calibrator,
+    )
+
+    # Build full-vocab target logits for greedy verification of the top-k argmax proposals
+    target_full_logits = torch.full(
+        (bsz, steps + 1, vocab_size), -5.0, dtype=torch.float32, device=device
+    )
+    for b in range(bsz):
+        for i in range(steps):
+            target_full_logits[b, i, true_next[b, i]] = 10.0
+        target_full_logits[b, steps, 0] = 10.0
+
+    window_e2e_losses: list[float] = []
+    window_bce_losses: list[float] = []
+    window_als: list[float] = []
+
+    for window in range(4):
+        e2e_sum = 0.0
+        bce_sum = 0.0
+        al_sum = 0.0
+        iters = 8
+        for _ in range(iters):
+            draft_cand_logits, _, conf_probs = (
+                adapter.compute_candidate_logits_and_confidences(
+                    cond_ids, cand_ids, base_logits, hidden
+                )
+            )
+            chosen_k = draft_cand_logits.argmax(dim=-1, keepdim=True)
+            proposed_tokens = torch.gather(cand_ids, -1, chosen_k).squeeze(-1)
+            _, num_accepted, _ = verify_greedy_lossless(
+                proposed_tokens, target_full_logits
+            )
+            al_sum += float(num_accepted.float().mean().item())
+
+            metrics = adapter.step_on_candidates(
+                cond_ids,
+                cand_ids,
+                base_logits,
+                target_probs,
+                hidden_states=hidden,
+                accepted_counts=num_accepted,
+            )
+            e2e_sum += metrics["e2e_tv_loss"]
+            bce_sum += metrics["bce_loss"]
+
+        window_e2e_losses.append(e2e_sum / iters)
+        window_bce_losses.append(bce_sum / iters)
+        window_als.append(al_sum / iters)
+
+    # E2E-TV loss and BCE loss must decrease monotonically across windows
+    for w in range(len(window_e2e_losses) - 1):
+        assert window_e2e_losses[w + 1] < window_e2e_losses[w], (
+            f"Expected monotonic E2E-TV reduction, got {window_e2e_losses}"
+        )
+        assert window_bce_losses[w + 1] < window_bce_losses[w], (
+            f"Expected monotonic BCE reduction, got {window_bce_losses}"
+        )
+        assert window_als[w + 1] >= window_als[w], (
+            f"Expected non-decreasing AL across windows, got {window_als}"
+        )
+
+    assert window_als[0] < 1.0
+    assert window_als[-1] > 4.0
+
+    # Check calibrator ECE and Brier reduction on overconfident raw predictions
+    raw_overconfident = torch.tensor(
+        [[0.92, 0.89, 0.86, 0.83, 0.80]] * 16, dtype=torch.float32, device=device
+    )
+    realized_acc = torch.tensor(
+        [1, 2, 1, 0, 2, 1, 1, 2] * 2, dtype=torch.int64, device=device
+    )
+    cal = OnlineConfidenceCalibrator(
+        num_steps=steps, lr_bias=0.30, lr_scale=0.10, device=device
+    )
+    before_m = cal.compute_calibration_metrics(raw_overconfident, realized_acc)
+    cal_brier_history = [before_m["cal_brier"]]
+    for _ in range(12):
+        cal.observe(raw_overconfident, realized_acc)
+        m = cal.compute_calibration_metrics(raw_overconfident, realized_acc)
+        cal_brier_history.append(m["cal_brier"])
+
+    for t in range(len(cal_brier_history) - 1):
+        assert cal_brier_history[t + 1] <= cal_brier_history[t] + 1e-7
+    after_m = cal.compute_calibration_metrics(raw_overconfident, realized_acc)
+    assert after_m["cal_ece"] < before_m["raw_ece"] * 0.25
+    assert after_m["cal_brier"] < before_m["raw_brier"] * 0.50
+    assert after_m["cal_bce"] < before_m["raw_bce"] * 0.50
+
