+def test_greedy_verification_target_output_invariance():
+    """Greedy speculative verification must emit the exact target argmax sequence
+    regardless of drafter adaptation state."""
+    device = _default_device()
+    torch.manual_seed(101)
+    bsz, steps, vocab_size = 6, 5, 256
+
+    target_logits = torch.randn(bsz, steps + 1, vocab_size, device=device)
+    target_argmax = target_logits.argmax(dim=-1)
+
+    # Case 1: unadapted random draft tokens
+    random_drafts = torch.randint(0, vocab_size, (bsz, steps), device=device)
+    # Force partial prefix matches on some rows
+    random_drafts[0, :3] = target_argmax[0, :3]
+    random_drafts[1, :] = target_argmax[1, :steps]
+
+    emitted_rand, acc_rand, num_emit_rand = verify_greedy_lossless(
+        random_drafts, target_logits
+    )
+    for b in range(bsz):
+        n_em = int(num_emit_rand[b].item())
+        assert n_em == int(acc_rand[b].item()) + 1
+        torch.testing.assert_close(
+            emitted_rand[b, :n_em], target_argmax[b, :n_em], rtol=0, atol=0
+        )
+
+    # Case 2: multi-step autoregressive rollout invariance before vs after online adaptation
+    seq_len = 24
+    true_target_stream = torch.randint(0, vocab_size, (bsz, seq_len), device=device)
+
+    def _run_speculative_rollout(perfect_prefix: int) -> torch.Tensor:
+        cursors = torch.zeros(bsz, dtype=torch.int64, device=device)
+        collected = [torch.empty(0, dtype=torch.int64, device=device) for _ in range(bsz)]
+        while bool((cursors < seq_len).any()):
+            step_logits = torch.full(
+                (bsz, steps + 1, vocab_size), -10.0, dtype=torch.float32, device=device
+            )
+            draft_prop = torch.zeros((bsz, steps), dtype=torch.int64, device=device)
+            for b in range(bsz):
+                pos = int(cursors[b].item())
+                for s in range(steps + 1):
+                    t_idx = min(pos + s, seq_len - 1)
+                    tok = int(true_target_stream[b, t_idx].item())
+                    step_logits[b, s, tok] = 10.0
+                    if s < steps:
+                        if s < perfect_prefix:
+                            draft_prop[b, s] = tok
+                        else:
+                            draft_prop[b, s] = (tok + 17 + s) % vocab_size
+            emitted, _, num_emitted = verify_greedy_lossless(draft_prop, step_logits)
+            for b in range(bsz):
+                pos = int(cursors[b].item())
+                if pos >= seq_len:
+                    continue
+                take = min(int(num_emitted[b].item()), seq_len - pos)
+                collected[b] = torch.cat([collected[b], emitted[b, :take]], dim=0)
+                cursors[b] = pos + take
+        return torch.stack(collected, dim=0)
+
+    out_unadapted = _run_speculative_rollout(perfect_prefix=0)
+    out_partial = _run_speculative_rollout(perfect_prefix=2)
+    out_adapted = _run_speculative_rollout(perfect_prefix=steps)
+
+    assert torch.equal(out_unadapted, true_target_stream)
+    assert torch.equal(out_partial, true_target_stream)
+    assert torch.equal(out_adapted, true_target_stream)
+
