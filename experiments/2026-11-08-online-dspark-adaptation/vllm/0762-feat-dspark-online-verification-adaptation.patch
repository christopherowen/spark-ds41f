+def test_tp_rank_determinism_of_calibrator_and_head_adapter():
+    """All TP ranks observing broadcast confidences and verification outcomes must
+    stay 100% bit-identical with zero extra inter-rank communication."""
+    device = _default_device()
+    num_ranks = 4
+    num_steps = 5
+    vocab_size = 128
+    markov_rank = 32
+    hidden_size = 64
+
+    calibrators = [
+        OnlineConfidenceCalibrator(num_steps=num_steps, device=device)
+        for _ in range(num_ranks)
+    ]
+    estimators = [
+        OnlineAcceptanceEstimator.for_confidence_head(16, num_steps, device)
+        for _ in range(num_ranks)
+    ]
+
+    torch.manual_seed(404)
+    init_w1 = torch.randn(vocab_size, markov_rank, dtype=torch.bfloat16, device=device)
+    init_w2 = torch.randn(vocab_size, markov_rank, dtype=torch.bfloat16, device=device)
+    init_conf = torch.randn(1, hidden_size + markov_rank, dtype=torch.float32, device=device)
+
+    adapters: list[OnlineDSparkHeadAdapter] = []
+    for r in range(num_ranks):
+        w1 = nn.Embedding(vocab_size, markov_rank, device=device, dtype=torch.bfloat16)
+        w1.weight.data.copy_(init_w1)
+        w2 = init_w2.clone()
+        conf_w = init_conf.clone()
+        adapters.append(
+            OnlineDSparkHeadAdapter(
+                w1,
+                w2,
+                conf_w,
+                calibrator=calibrators[r],
+            )
+        )
+
+    for step_idx in range(32):
+        bsz = 6
+        cond_ids = torch.randint(0, vocab_size, (bsz, num_steps), device=device)
+        cand_ids = torch.randint(0, vocab_size, (bsz, num_steps, 8), device=device)
+        base_logits = torch.randn(bsz, num_steps, 8, dtype=torch.float32, device=device)
+        raw_p = F.softmax(torch.randn(bsz, num_steps, 8, device=device), dim=-1) * 0.91
+        hidden = torch.randn(
+            bsz, num_steps, hidden_size, dtype=torch.bfloat16, device=device
+        )
+        accepted = torch.randint(0, num_steps + 1, (bsz,), device=device)
+        verified = torch.full((bsz,), num_steps, dtype=torch.int64, device=device)
+        slots = torch.arange(bsz, dtype=torch.int32, device=device)
+        raw_conf = torch.sigmoid(torch.randn(bsz, num_steps, device=device))
+
+        for r in range(num_ranks):
+            adapters[r].step_on_candidates(
+                cond_ids,
+                cand_ids,
+                base_logits,
+                raw_p,
+                hidden_states=hidden,
+                accepted_counts=accepted,
+                verified_counts=verified,
+            )
+            probs_r = raw_conf.clone()
+            estimators[r].calibrate_confidence_probs(probs_r, slots)
+            num_sampled = accepted + 1
+            num_rejected = (verified - accepted).clamp_min(0)
+            estimators[r].step(slots, num_sampled, num_rejected)
+
+    for r in range(1, num_ranks):
+        assert torch.equal(calibrators[0].beta, calibrators[r].beta)
+        assert torch.equal(calibrators[0].gamma, calibrators[r].gamma)
+        assert torch.equal(calibrators[0].curv_beta, calibrators[r].curv_beta)
+        assert torch.equal(calibrators[0].curv_gamma, calibrators[r].curv_gamma)
+        assert torch.equal(adapters[0].w1_weight, adapters[r].w1_weight)
+        assert torch.equal(adapters[0].markov_w2, adapters[r].markov_w2)
+        assert torch.equal(adapters[0].conf_weight, adapters[r].conf_weight)
+        assert torch.equal(estimators[0].slope, estimators[r].slope)
+        assert torch.equal(estimators[0].intercepts, estimators[r].intercepts)
+
