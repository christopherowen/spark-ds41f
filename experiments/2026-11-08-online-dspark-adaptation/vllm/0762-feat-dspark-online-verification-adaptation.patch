+def test_joint_latent_encoder_with_frozen_w2_and_position_scaled_latent_noise():
+    """Joint 256-dim Markov latent encoder (markov_w1 + hidden_to_markov_proj)
+    must adapt with markov_w2 frozen (update_w2=False), and position-scaled
+    latent noise regularization (sigma_i = sigma_0 * (i / K) for i >= 1) must
+    preserve anchor step 0, remain TP-rank deterministic, and improve held-out
+    E2E-TV, BCE, and AL under noisy 1-step block hidden state predictions."""
+    device = _default_device()
+    torch.manual_seed(707)
+
+    bsz, steps, topk = 8, 5, 8
+    vocab_size, markov_rank, hidden_size = 128, 32, 64
+
+    # 1. Verify position-scaled noise schedule: sigma_0 = 0 at i = 0, sigma_i = sigma_0 * (i / K)
+    w1_dummy = nn.Embedding(vocab_size, markov_rank, device=device, dtype=torch.float32)
+    w2_dummy = torch.randn(vocab_size, markov_rank, device=device, dtype=torch.float32)
+    noise_adapter = OnlineDSparkHeadAdapter(
+        w1_dummy, w2_dummy, update_w2=False, latent_noise_std=0.20
+    )
+    latents = torch.ones((bsz, steps, hidden_size), dtype=torch.float32, device=device)
+    perturbed, sigma_sched = noise_adapter.apply_position_scaled_latent_noise(
+        latents, return_sigma_schedule=True
+    )
+    expected_sigma = torch.tensor(
+        [0.0, 0.05, 0.10, 0.15, 0.20], dtype=torch.float32, device=device
+    )
+    torch.testing.assert_close(sigma_sched, expected_sigma, atol=1e-6, rtol=0)
+    # Anchor position i = 0 has zero noise perturbation
+    assert torch.equal(perturbed[:, 0, :], latents[:, 0, :])
+    # Block-predicted positions i >= 1 have monotonically increasing empirical noise variance
+    pos_vars = [
+        float((perturbed[:, i, :] - latents[:, i, :]).pow(2).mean().item())
+        for i in range(1, steps)
+    ]
+    assert pos_vars[0] > 0.0
+    assert pos_vars[-1] > pos_vars[0]
+
+    # 2. Verify joint latent-encoder adaptation with frozen markov_w2 (update_w2=False)
+    # and position-scaled latent noise generalization under noisy 1-step block predictions.
+    cond_ids = torch.arange(bsz * steps, device=device).view(bsz, steps) % 16
+    true_next = (cond_ids * 5 + 11) % vocab_size
+    distractors = torch.stack(
+        [(true_next + k * 7 + 3) % vocab_size for k in range(1, topk)], dim=-1
+    )
+    cand_ids = torch.cat([true_next.unsqueeze(-1), distractors], dim=-1)
+
+    base_logits = torch.zeros((bsz, steps, topk), dtype=torch.float32, device=device)
+    base_logits[..., 0] = -0.35
+    base_logits[..., 1] = 1.05
+
+    target_probs = torch.full(
+        (bsz, steps, topk), 0.06 / (topk - 1), dtype=torch.float32, device=device
+    )
+    target_probs[..., 0] = 0.90
+
+    # Construct clean semantic signal in coordinates 0..7 of hidden_states,
+    # and high-norm spurious 1-step block-prediction error in coordinates 8..hidden_size
+    # at draft positions i >= 1 that flips sign on held-out verification steps.
+    clean_hidden = torch.zeros(
+        (bsz, steps, hidden_size), dtype=torch.float32, device=device
+    )
+    for s in range(steps):
+        clean_hidden[:, s, s % 8] = 0.40
+
+    spurious_block_err = torch.zeros_like(clean_hidden)
+    pos_scale = torch.linspace(0.0, 1.0, steps, device=device).view(1, steps, 1)
+    spurious_pattern = torch.randn(
+        bsz, steps, hidden_size - 8, dtype=torch.float32, device=device
+    )
+    spurious_block_err[:, :, 8:] = 2.5 * pos_scale * spurious_pattern
+
+    train_hidden = clean_hidden + spurious_block_err
+    heldout_hidden = clean_hidden - spurious_block_err
+
+    init_w1 = torch.randn(vocab_size, markov_rank, dtype=torch.float32, device=device) * 0.02
+    init_w2 = torch.randn(vocab_size, markov_rank, dtype=torch.float32, device=device) * 0.25
+    # Initialize hidden_to_markov_proj and conf_w with spurious-direction contamination
+    # (simulating an adapter that previously overfit to buffered 1-step block artifacts)
+    init_proj = torch.zeros(
+        (hidden_size, markov_rank), dtype=torch.float32, device=device
+    )
+    init_proj[8:, :] = torch.randn(
+        hidden_size - 8, markov_rank, dtype=torch.float32, device=device
+    ) * 0.35
+    init_conf = torch.zeros(
+        (1, hidden_size + markov_rank), dtype=torch.float32, device=device
+    )
+    init_conf[0, 8:hidden_size] = 0.65
+
+    def _train_and_eval(latent_noise_std: float) -> dict[str, Any]:
+        w1 = nn.Embedding(vocab_size, markov_rank, device=device, dtype=torch.float32)
+        w1.weight.data.copy_(init_w1)
+        w2 = init_w2.clone()
+        proj = init_proj.clone()
+        conf_w = init_conf.clone()
+        adapter = OnlineDSparkHeadAdapter(
+            w1,
+            w2,
+            conf_w,
+            hidden_to_markov_proj=proj,
+            lr_markov_w1=0.30,
+            lr_hidden_to_markov=0.45,
+            lr_confidence=0.35,
+            bce_weight=0.30,
+            update_w2=False,
+            latent_noise_std=latent_noise_std,
+        )
+        for _ in range(28):
+            adapter.step_on_candidates(
+                cond_ids,
+                cand_ids,
+                base_logits,
+                target_probs,
+                hidden_states=train_hidden,
+            )
+        # Verify markov_w2 remained 100% frozen
+        assert torch.equal(w2, init_w2)
+        # Verify both markov_w1 and hidden_to_markov_proj updated
+        assert not torch.equal(w1.weight, init_w1)
+        assert not torch.equal(proj, init_proj)
+
+        draft_logits, conf_logits, _ = adapter.compute_candidate_logits_and_confidences(
+            cond_ids, cand_ids, base_logits, heldout_hidden
+        )
+        eval_res = compute_e2e_tv_and_bce_loss(
+            draft_logits,
+            target_probs,
+            confidence_logits=conf_logits,
+            bce_weight=0.30,
+        )
+        chosen_k = draft_logits.argmax(dim=-1, keepdim=True)
+        proposed = torch.gather(cand_ids, -1, chosen_k).squeeze(-1)
+        matches = proposed == true_next
+        al = float(torch.cumprod(matches.to(torch.int64), dim=-1).sum(dim=-1).float().mean().item())
+        return {
+            "e2e_tv_loss": float(eval_res.e2e_tv_loss.item()),
+            "bce_loss": float(eval_res.bce_loss.item()),
+            "al": al,
+            "w1": w1.weight.clone(),
+            "proj": proj.clone(),
+            "conf_w": conf_w.clone(),
+        }
+
+    no_noise_res = _train_and_eval(latent_noise_std=0.0)
+    pos_noise_res = _train_and_eval(latent_noise_std=0.85)
+    pos_noise_rank2 = _train_and_eval(latent_noise_std=0.85)
+
+    # TP rank determinism with position-scaled latent noise enabled:
+    assert torch.equal(pos_noise_res["w1"], pos_noise_rank2["w1"])
+    assert torch.equal(pos_noise_res["proj"], pos_noise_rank2["proj"])
+    assert torch.equal(pos_noise_res["conf_w"], pos_noise_rank2["conf_w"])
+
+    # Position-scaled latent noise regularization must improve held-out E2E-TV, BCE, and AL
+    assert pos_noise_res["e2e_tv_loss"] < no_noise_res["e2e_tv_loss"]
+    assert pos_noise_res["bce_loss"] < no_noise_res["bce_loss"]
+    assert pos_noise_res["al"] >= no_noise_res["al"]
+    assert pos_noise_res["al"] > 4.0
