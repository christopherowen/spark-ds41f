+def test_session_token_memory_and_copy_drafter_multi_turn_gain():
+    """Persistent cross-request SessionTokenMemory must enable Turn 2+ suffix
+    drafting of recurring codebase/tool-call sequences before they repeat in Turn 2."""
+    device = _default_device()
+    mem = SessionTokenMemory(
+        capacity=256, min_match_len=3, max_match_len=8, device=device
+    )
+
+    # Turn 1 verified tool-call schema / file path tokens:
+    turn1_tokens = torch.tensor(
+        [10, 11, 12, 42, 43, 44, 101, 102, 103, 104, 105, 99],
+        dtype=torch.int64,
+        device=device,
+    )
+    mem.record_verified_tokens(turn1_tokens)
+
+    # Turn 2 prompt ends with [42, 43, 44], which has not appeared earlier in Turn 2!
+    turn2_context = torch.tensor(
+        [[7, 8, 42, 43, 44], [1, 2, 3, 4, 5]], dtype=torch.int64, device=device
+    )
+    drafts, match_lens, confs = mem.propose_suffix_continuation(
+        turn2_context, num_draft_steps=4
+    )
+    assert int(match_lens[0].item()) == 3
+    assert int(match_lens[1].item()) == 0
+    assert drafts[0].tolist() == [101, 102, 103, 104]
+    assert float(confs[0, 0].item()) > 0.80
+
+    # Test integration with CopyDrafter when intra-request copy has no match
+    if torch.cuda.is_available():
+        max_reqs = 4
+        max_len = 64
+        num_draft_steps = 4
+        cfg = CopyDraftsConfig(min_match=3, initial_drafts=4, max_drafts=8)
+        req_states = SimpleNamespace(
+            num_speculative_steps=8,
+            max_num_reqs=max_reqs,
+            device=device,
+            total_len=SimpleNamespace(
+                gpu=torch.tensor([5, 5, 0, 0], dtype=torch.int32, device=device)
+            ),
+            all_token_ids=SimpleNamespace(
+                gpu=torch.zeros((max_reqs, max_len), dtype=torch.int32, device=device)
+            ),
+        )
+        req_states.all_token_ids.gpu[0, :5] = turn2_context[0].to(torch.int32)
+        req_states.all_token_ids.gpu[1, :5] = turn2_context[1].to(torch.int32)
+
+        drafter = CopyDrafter(
+            cfg,
+            req_states,
+            num_draft_steps=num_draft_steps,
+            device=device,
+            session_memory=mem,
+        )
+        idx_mapping = torch.tensor([0, 1], dtype=torch.int32, device=device)
+        num_sampled = torch.tensor([1, 1], dtype=torch.int32, device=device)
+        drafter.prepare_alloc(idx_mapping, num_sampled, None, None)
+
+        dspark_drafts = torch.full(
+            (2, num_draft_steps), 77, dtype=torch.int64, device=device
+        )
+        dspark_confs = torch.full(
+            (2, num_draft_steps), 0.35, dtype=torch.float32, device=device
+        )
+        out_drafts, out_confs, _ = drafter.propose(
+            idx_mapping, dspark_drafts, dspark_confs
+        )
+        assert out_drafts[0, :num_draft_steps].tolist() == [101, 102, 103, 104]
+        assert out_drafts[1, :num_draft_steps].tolist() == [77, 77, 77, 77]
+        assert float(out_confs[0, 0].item()) > 0.80
