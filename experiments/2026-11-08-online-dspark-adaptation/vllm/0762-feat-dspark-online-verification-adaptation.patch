+def test_rejection_sampling_target_distribution_invariance():
+    """Speculative rejection sampling must preserve the exact target distribution
+    for any draft proposal distribution q(v)."""
+    device = _default_device()
+    torch.manual_seed(202)
+    vocab_size = 8
+    target_logits = torch.tensor(
+        [1.4, -0.5, 0.8, 2.1, -1.2, 0.3, 0.0, -0.7],
+        dtype=torch.float64,
+        device=device,
+    )
+    p = F.softmax(target_logits, dim=-1)
+
+    for draft_scale in (-1.5, 0.0, 0.7, 2.5):
+        draft_logits = draft_scale * target_logits + torch.linspace(
+            -0.8, 0.8, vocab_size, dtype=torch.float64, device=device
+        )
+        q = F.softmax(draft_logits, dim=-1)
+
+        # Exact mathematical marginal check:
+        # P(emit = v) = q(v) * min(1, p(v)/q(v)) + (1 - sum_u min(q(u), p(u))) * max(0, p(v) - q(v)) / sum_u max(0, p(u) - q(u))
+        accept_mass = torch.minimum(q, p)
+        reject_prob = 1.0 - accept_mass.sum()
+        residual = (p - q).clamp_min(0.0)
+        if float(residual.sum().item()) > 1e-12:
+            residual_norm = residual / residual.sum()
+        else:
+            residual_norm = torch.zeros_like(p)
+        marginal = accept_mass + reject_prob * residual_norm
+        torch.testing.assert_close(marginal, p, rtol=1e-12, atol=1e-12)
+
+    # Monte Carlo verification with verify_rejection_sampling_lossless
+    num_trials = 16000
+    p_f32 = p.float().view(1, 1, vocab_size).expand(num_trials, 2, vocab_size).contiguous()
+    q_skewed = F.softmax(
+        torch.tensor(
+            [-1.0, 2.0, -0.5, -1.2, 1.5, 0.2, 0.9, -0.3],
+            dtype=torch.float32,
+            device=device,
+        ),
+        dim=-1,
+    )
+    q_f32 = q_skewed.view(1, 1, vocab_size).expand(num_trials, 1, vocab_size).contiguous()
+
+    gen = torch.Generator(device=device)
+    gen.manual_seed(303)
+    draft_draws = torch.multinomial(
+        q_skewed.expand(num_trials, vocab_size), num_samples=1, generator=gen
+    )
+    emitted, _, _ = verify_rejection_sampling_lossless(
+        draft_draws, q_f32, p_f32, generator=gen
+    )
+    first_tokens = emitted[:, 0]
+    counts = torch.bincount(first_tokens, minlength=vocab_size).float() / float(num_trials)
+    torch.testing.assert_close(counts, p.float(), atol=0.015, rtol=0.10)
+
