+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Online DSpark adaptation (online_dspark_adaptation.py) on DS4.1's shapes.
+
+DS4.1's DSpark: vocabulary 129,280, Markov rank 256, head hidden 5,120, five
+drafts a step, up to 16 requests. The vocabulary-sharded tables (Markov W2 and
+the LM head) are sharded the way vLLM's ParallelLMHead shards them
+(``VocabParallelEmbedding._get_indices``). The tensor-parallel test runs four
+real processes over gloo, so the all-reduce, the shard ownership and the rank
+comparison are the serving ones, not a simulation. The packed-head test packs a
+real-shape shard with TileLang's 12-bit packer (GPU). With ``DS41F_SNAPSHOT``
+the checkpoint test loads the served checkpoint's own DSpark heads.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+import torch.distributed as dist
+import torch.multiprocessing as mp
+import torch.nn as nn
+
+from vllm.model_executor.layers.vocab_parallel_embedding import (
+    VocabParallelEmbedding,
+)
+from vllm.v1.worker.gpu.spec_decode.acceptance_estimator import (
+    OnlineAcceptanceEstimator,
+)
+from vllm.v1.worker.gpu.spec_decode.online_dspark_adaptation import (
+    DSparkOnlineAdaptation,
+    OnlineConfidenceCalibrator,
+    OnlineDSparkHeadAdapter,
+    SessionTokenMemory,
+    VocabRows,
+    _bits_digest,
+    _deterministic_index_add_,
+    compute_e2e_tv_and_bce_loss,
+    session_token_memory_capacity,
+    verification_outcomes,
+)
+
+VOCAB = 129280
+RANK = 256
+HIDDEN = 5120
+STEPS = 5
+MAX_REQS = 16
+TP = 4
+
+
+def _shard(rank: int, tp: int):
+    return VocabParallelEmbedding._get_indices(VOCAB, VOCAB, VOCAB, VOCAB, rank, tp)
+
+
+def _table(rows: int, width: int, seed: int, scale: float) -> torch.Tensor:
+    gen = torch.Generator().manual_seed(seed)
+    return (torch.randn(rows, width, generator=gen) * scale).to(torch.bfloat16)
+
+
+def _head(full: torch.Tensor, rank: int, tp: int) -> SimpleNamespace:
+    """A ParallelLMHead-like module: this rank's padded shard of ``full``."""
+    shard = _shard(rank, tp)
+    weight = torch.zeros(shard.num_elements_padded, full.shape[1], dtype=full.dtype)
+    rows = full[shard.org_vocab_start_index : shard.org_vocab_end_index]
+    weight[: shard.num_org_elements] = rows
+    return SimpleNamespace(
+        weight=weight, shard_indices=shard, tp_size=tp, disable_tp=tp == 1
+    )
+
+
+def _rms_norm(weight: torch.Tensor):
+    def norm(x: torch.Tensor) -> torch.Tensor:
+        xf = x.float()
+        out = xf * torch.rsqrt(xf.pow(2).mean(dim=-1, keepdim=True) + 1e-6)
+        return (out * weight.float()).to(x.dtype)
+
+    return norm
+
+
+def _weights(seed: int = 0) -> dict[str, torch.Tensor]:
+    gen = torch.Generator().manual_seed(seed + 4)
+    return {
+        "w1": _table(VOCAB, RANK, seed + 1, 0.05),
+        "w2": _table(VOCAB, RANK, seed + 2, 0.05),
+        "lm": _table(VOCAB, HIDDEN, seed + 3, 0.02),
+        "conf": torch.randn(1, HIDDEN + RANK, generator=gen) * 0.01,
+        "norm": torch.ones(HIDDEN, dtype=torch.bfloat16),
+    }
+
+
+def _batch(step: int, num_reqs: int = 4) -> dict[str, torch.Tensor]:
+    """One draft step's captured inputs and its verification, in a fixed pattern:
+    rows accept 0..W drafts, one row is a copy row, slots are permuted."""
+    gen = torch.Generator().manual_seed(1000 + step)
+    slots = torch.randperm(MAX_REQS, generator=gen)[:num_reqs]
+    drafts = torch.randint(0, VOCAB, (MAX_REQS, STEPS), generator=gen)
+    anchors = torch.randint(0, VOCAB, (MAX_REQS,), generator=gen)
+    hidden = torch.randn(MAX_REQS * STEPS, HIDDEN, generator=gen) * 0.5
+    accepted = torch.arange(num_reqs) % (STEPS + 1)
+    num_sampled = (accepted + 1).to(torch.int32)
+    num_rejected = (accepted < STEPS).to(torch.int32)
+    sampled = torch.full((num_reqs, STEPS + 1), -1, dtype=torch.int64)
+    for r in range(num_reqs):
+        a = int(accepted[r])
+        sampled[r, :a] = drafts[r, :a]
+        sampled[r, a] = (drafts[r, a] + 7) % VOCAB if a < STEPS else 11
+    # The current batch lists the draft rows in another order.
+    order = torch.randperm(num_reqs, generator=gen)
+    copy_state = torch.zeros(MAX_REQS, 4, dtype=torch.int32)
+    copy_state[slots[0], 1] = 3  # the copy drafter drafted this request
+    return {
+        "slots": slots,
+        "drafts": drafts,
+        "anchors": anchors,
+        "hidden": hidden.to(torch.bfloat16),
+        "idx_mapping": slots[order].to(torch.int32),
+        "num_sampled": num_sampled[order],
+        "num_rejected": num_rejected[order],
+        "sampled": sampled[order],
+        "copy_state": copy_state,
+    }
+
+
+def _adaptation(weights, rank: int, tp: int, all_reduce=None) -> DSparkOnlineAdaptation:
+    w1 = nn.Embedding(VOCAB, RANK, _weight=weights["w1"].clone())
+    conf = nn.Linear(HIDDEN + RANK, 1, bias=False)
+    conf.weight.data = weights["conf"].clone()
+    return DSparkOnlineAdaptation(
+        markov_w1=w1,
+        markov_w2=_head(weights["w2"], rank, tp),
+        lm_head=_head(weights["lm"], rank, tp),
+        norm=_rms_norm(weights["norm"]),
+        confidence_head=SimpleNamespace(proj=conf),
+        max_num_reqs=MAX_REQS,
+        num_steps=STEPS,
+        hidden_size=HIDDEN,
+        device=torch.device("cpu"),
+        all_reduce=all_reduce,
+        tp_rank=rank,
+    )
+
+
+def _observe(adaptation: DSparkOnlineAdaptation, b: dict[str, torch.Tensor]) -> None:
+    adaptation.observe(
+        b["idx_mapping"],
+        b["num_sampled"],
+        b["num_rejected"],
+        b["sampled"],
+        b["drafts"],
+        copy_int_state=b["copy_state"],
+    )
+
+
+def _run_steps(adaptation: DSparkOnlineAdaptation, steps: int, **batch) -> None:
+    for step in range(steps):
+        b = _batch(step, **batch)
+        b = {k: v.to(adaptation.device) for k, v in b.items()}
+        adaptation.capture(b["slots"].numel(), b["hidden"], b["anchors"], b["slots"])
+        adaptation.arm(True)
+        _observe(adaptation, b)
+
+
+def _tp_worker(rank: int, tp: int, port: int, steps: int, out: str) -> None:
+    os.environ["MASTER_ADDR"] = "127.0.0.1"
+    os.environ["MASTER_PORT"] = str(port)
+    dist.init_process_group("gloo", rank=rank, world_size=tp)
+    torch.set_num_threads(4)
+
+    def all_reduce(t: torch.Tensor) -> torch.Tensor:
+        t = t.clone()
+        dist.all_reduce(t)
+        return t
+
+    adaptation = _adaptation(_weights(), rank, tp, all_reduce)
+    w2_before = adaptation.w2_rows.weight.clone()
+    _run_steps(adaptation, steps)
+    torch.save(
+        {
+            "w1": adaptation.heads.w1_weight.clone(),
+            "conf": adaptation.heads.conf_weight.clone(),
+            "w2_unchanged": torch.equal(w2_before, adaptation.w2_rows.weight),
+            "digest": adaptation.state_digest(),
+        },
+        f"{out}/rank{rank}.pt",
+    )
+    dist.destroy_process_group()
+
+
+def test_vocab_rows_map_global_ids_to_the_owning_shard():
+    full = _table(VOCAB, RANK, 7, 0.05)
+    ids = torch.tensor([0, 1, 32319, 32320, 64639, 64640, 96959, 96960, VOCAB - 1])
+    total = torch.zeros(ids.numel(), RANK, dtype=torch.float32)
+    for rank in range(TP):
+        local = VocabRows(_head(full, rank, TP)).local(ids)
+        shard = _shard(rank, TP)
+        owned = (ids >= shard.org_vocab_start_index) & (
+            ids < shard.org_vocab_end_index
+        )
+        assert torch.equal(local[owned], full[ids[owned]])
+        assert not local[~owned].any()
+        total += local.float()
+    assert torch.equal(total.to(torch.bfloat16), full[ids])
+    # The bug the shard mapping fixes: rank 1's shard indexed by a global id
+    # reads another token's row (id 5 reads token 32,325), or past its end.
+    shard1 = _head(full, 1, TP).weight
+    assert torch.equal(shard1[5], full[32325]) and not torch.equal(shard1[5], full[5])
+    assert shard1.shape[0] < 40000
+
+
+def test_update_w2_is_refused_for_sharded_and_packed_w2():
+    full = _table(VOCAB, RANK, 8, 0.05)
+    w1 = nn.Embedding(VOCAB, RANK)
+    with pytest.raises(ValueError, match="vocabulary-sharded"):
+        OnlineDSparkHeadAdapter(w1, _head(full, 0, TP), update_w2=True)
+    packed = SimpleNamespace(
+        weight=torch.zeros(4, 6, dtype=torch.uint8),
+        packed_bf16_exponent_base=120,
+        packed_bf16_in_features=4,
+        shard_indices=_shard(0, 1),
+        tp_size=1,
+        disable_tp=True,
+    )
+    with pytest.raises(ValueError, match="packed"):
+        OnlineDSparkHeadAdapter(w1, packed, update_w2=True)
+    # The default leaves W2 alone on a single rank too.
+    assert OnlineDSparkHeadAdapter(w1, _head(full, 0, 1)).update_w2 is False
+
+
+def test_tp4_ranks_identical_and_equal_to_tp1(tmp_path):
+    """Four real ranks (gloo) on vocabulary-sharded W2 and LM heads: after the
+    updates every rank's W1 and confidence head are bit-identical, equal to a
+    single rank holding the full tables, and W2 is untouched."""
+    steps = 6
+    port = 29600 + (os.getpid() % 200)
+    ctx = mp.get_context("spawn")
+    procs = [
+        ctx.Process(target=_tp_worker, args=(rank, TP, port, steps, str(tmp_path)))
+        for rank in range(TP)
+    ]
+    for p in procs:
+        p.start()
+    for p in procs:
+        p.join(600)
+        assert p.exitcode == 0
+    ranks = [torch.load(tmp_path / f"rank{r}.pt") for r in range(TP)]
+
+    single = _adaptation(_weights(), 0, 1)
+    loaded_w1 = single.heads.w1_weight.clone()
+    _run_steps(single, steps)
+
+    assert not torch.equal(single.heads.w1_weight, loaded_w1), "no update happened"
+    for state in ranks:
+        assert state["w2_unchanged"]
+        assert torch.equal(state["w1"], ranks[0]["w1"])
+        assert torch.equal(state["conf"], ranks[0]["conf"])
+        assert state["digest"] == ranks[0]["digest"]
+        assert torch.equal(state["w1"], single.heads.w1_weight)
+        assert torch.equal(state["conf"], single.heads.conf_weight)
+
+
+def test_observe_grades_only_armed_observed_dspark_positions():
+    adaptation = _adaptation(_weights(3), 0, 1)
+    w1 = adaptation.heads.w1_weight
+    loaded = w1.clone()
+    b = _batch(0)
+    adaptation.capture(b["slots"].numel(), b["hidden"], b["anchors"], b["slots"])
+    # Not armed (a warmup or dummy draft): nothing moves.
+    _observe(adaptation, b)
+    assert torch.equal(w1, loaded)
+    adaptation.arm(True)
+    _observe(adaptation, b)
+    changed = (w1 != loaded).any(dim=1).nonzero().view(-1).tolist()
+    # Rows that may move: the conditioning tokens of observed positions of
+    # DSpark-drafted rows (anchor, then drafts), never the copy row's.
+    allowed = set()
+    observed, _ = verification_outcomes(STEPS, b["num_sampled"], b["num_rejected"])
+    row_of_slot = {int(s): r for r, s in enumerate(b["slots"])}
+    for i, slot in enumerate(b["idx_mapping"].tolist()):
+        if b["copy_state"][slot, 1] > 0:
+            continue
+        r = row_of_slot[slot]
+        cond = [int(b["anchors"][r])] + b["drafts"][r, : STEPS - 1].tolist()
+        allowed.update(cond[p] for p in range(STEPS) if observed[i, p])
+    assert changed and set(changed) <= allowed
+    # The armed draft is consumed: a second verification of it is ignored.
+    after = w1.clone()
+    _observe(adaptation, b)
+    assert torch.equal(w1, after)
+
+
+def test_drift_bound_and_reset_restore_the_loaded_heads():
+    weights = _weights(5)
+    adaptation = _adaptation(weights, 0, 1)
+    adaptation.heads.max_row_drift = 0.05
+    adaptation.heads.lr_markov_w1 = 5.0
+    _run_steps(adaptation, 8)
+    # The bound holds before the BF16 rounding of the written rows (about
+    # 2^-9 of a row's norm).
+    assert 0.0 < adaptation.drift() <= 0.05 + 0.01
+    adaptation.reset()
+    assert torch.equal(adaptation.heads.w1_weight, weights["w1"])
+    assert torch.equal(adaptation.heads.conf_weight, weights["conf"])
+
+
+def test_e2e_tv_gradient_matches_autograd_on_real_shapes():
+    """The closed-form W1 step (no preconditioning, no clipping) equals
+    autograd's gradient of the E2E-TV loss."""
+    gen = torch.Generator().manual_seed(11)
+    bsz = 3
+    w1 = torch.randn(VOCAB, RANK, generator=gen) * 0.05
+    w2 = torch.randn(VOCAB, RANK, generator=gen) * 0.05
+    cond = torch.randperm(VOCAB, generator=gen)[: bsz * STEPS].view(bsz, STEPS)
+    cand = torch.randint(0, VOCAB, (bsz, STEPS, 3), generator=gen)
+    base = torch.randn(bsz, STEPS, 3, generator=gen)
+    probs = torch.tensor([0.9, 0.04, 0.03]).expand(bsz, STEPS, 3).contiguous()
+    mask = torch.ones(bsz, STEPS, dtype=torch.bool)
+    mask[0, 3:] = False
+
+    u = w1[cond].clone().requires_grad_(True)
+    logits = base + (u.unsqueeze(2) * w2[cand]).sum(-1)
+    loss = compute_e2e_tv_and_bce_loss(logits, probs, valid_mask=mask).e2e_tv_loss
+    (grad_u,) = torch.autograd.grad(loss, u)
+
+    table = w1.clone()
+    adapter = OnlineDSparkHeadAdapter(
+        table,
+        w2,
+        None,
+        lr_markov_w1=1.0,
+        max_grad_norm=1e9,
+        precondition_by_row_norm=False,
+    )
+    adapter.step_on_candidates(
+        cond, cand, base, probs, valid_mask=mask, return_metrics=False
+    )
+    delta = (table[cond] - w1[cond]).float()
+    torch.testing.assert_close(delta, -grad_u, rtol=2e-3, atol=1e-7)
+
+
+def test_deterministic_index_add_sums_duplicates_once():
+    target = torch.zeros(8, 4, dtype=torch.bfloat16)
+    ids = torch.tensor([3, 1, 3, 3, 1, 6])
+    deltas = torch.arange(24, dtype=torch.float32).view(6, 4) * 0.25
+    _deterministic_index_add_(target, ids, deltas)
+    want = torch.zeros(8, 4, dtype=torch.float64)
+    want.index_add_(0, ids, deltas.double())
+    assert torch.equal(target, want.to(torch.bfloat16))
+
+
+def test_calibrator_drives_the_estimator_confidence_calibration():
+    cpu = torch.device("cpu")
+    est = OnlineAcceptanceEstimator.for_confidence_head(MAX_REQS, STEPS, cpu)
+    cal = OnlineConfidenceCalibrator(STEPS)
+    est.attach_calibrator(cal)
+    reference = OnlineConfidenceCalibrator(STEPS)
+    gen = torch.Generator().manual_seed(2)
+    num_reqs = 6
+    for _ in range(OnlineAcceptanceEstimator.REFIT_INTERVAL):
+        slots = torch.randperm(MAX_REQS, generator=gen)[:num_reqs].to(torch.int32)
+        probs = torch.rand(num_reqs, STEPS, generator=gen) * 0.98 + 0.01
+        raw = probs.clone()
+        est.calibrate_confidence_probs(probs, slots)
+        # Calibrated in place with the calibrator's per-position scale and bias.
+        want = cal.calibrate(raw.double()).float()
+        torch.testing.assert_close(probs, want, rtol=1e-5, atol=1e-6)
+        num_sampled = torch.randint(1, STEPS + 2, (num_reqs,), generator=gen)
+        num_sampled = num_sampled.to(torch.int32)
+        num_rejected = (num_sampled <= STEPS).to(torch.int32)
+        copy_state = torch.zeros(MAX_REQS, 4, dtype=torch.int32)
+        copy_state[slots[0], 1] = 2
+        est.step(slots, num_sampled, num_rejected, copy_int_state=copy_state)
+        observed, labels = verification_outcomes(STEPS, num_sampled, num_rejected)
+        observed[0] = False
+        reference.observe_log_odds(est.features[slots.long()], observed, labels)
+    assert torch.equal(cal.gamma, reference.gamma)
+    assert torch.equal(cal.beta, reference.beta)
+    assert not torch.equal(cal.beta, torch.zeros(STEPS, dtype=torch.float64))
+    assert est._refits == 1  # calibrated after one refit interval, as without it
+    torch.testing.assert_close(cal.gamma32, cal.gamma.float())
+
+
+def test_session_memory_is_per_request():
+    assert session_token_memory_capacity() == 0  # off unless set
+    mem = SessionTokenMemory(64, max_slots=4, min_match_len=3)
+    tokens = torch.tensor([[5, 6, 7, 8, 9], [1, 2, 3, -1, -1]])
+    mem.record_verified_tokens(torch.tensor([0, 2]), tokens, torch.tensor([5, 3]))
+    assert mem.get_chronological_tokens(0).tolist() == [5, 6, 7, 8, 9]
+    assert mem.get_chronological_tokens(2).tolist() == [1, 2, 3]
+    assert mem.get_chronological_tokens(1).numel() == 0
+    ctx = torch.tensor([[1, 5, 6, 7], [1, 5, 6, 7]])
+    drafts, match, _ = mem.propose_suffix_continuation(
+        ctx, 2, slots=torch.tensor([0, 1])
+    )
+    # Request 0's own ring continues "5 6 7" with "8 9"; request 1 sees nothing
+    # of it.
+    assert drafts[0].tolist() == [8, 9] and int(match[0]) == 3
+    assert int(match[1]) == 0
+    mem.reset_slots([0])
+    assert mem.get_chronological_tokens(0).numel() == 0
+    # The ring keeps the last ``capacity`` tokens in order.
+    small = SessionTokenMemory(4, max_slots=1)
+    for t in range(3):
+        row = torch.tensor([[3 * t, 3 * t + 1, 3 * t + 2]])
+        small.record_verified_tokens(torch.tensor([0]), row)
+    assert small.get_chronological_tokens(0).tolist() == [5, 6, 7, 8]
+
+
