+def test_checkpoint_heads_adapt_within_bounds():
+    """The served checkpoint's DSpark heads (mtp.2.markov_head.*,
+    mtp.2.confidence_head, mtp.2.norm, head): an update moves W1 and stays
+    finite and bounded, and reset restores the checkpoint's bits."""
+    from safetensors import safe_open
+
+    root = _snapshot()
+    index_file = root / "model.safetensors.index.json"
+    index = json.loads(index_file.read_text())["weight_map"]
+    names = {
+        "w1": "mtp.2.markov_head.embed.weight",
+        "w2": "mtp.2.markov_head.head.weight",
+        "conf": "mtp.2.confidence_head.proj.weight",
+        "norm": "mtp.2.norm.weight",
+        "lm": "head.weight",
+    }
+    weights = {}
+    for key, name in names.items():
+        with safe_open(str(root / index[name]), "pt") as f:
+            weights[key] = f.get_tensor(name)
+    assert weights["w1"].shape == (VOCAB, RANK)
+    assert weights["w2"].shape == (VOCAB, RANK)
+    assert weights["lm"].shape == (VOCAB, HIDDEN)
+    assert weights["conf"].numel() == HIDDEN + RANK
+    weights["conf"] = weights["conf"].float().view(1, -1)
+    adaptation = _adaptation(weights, 0, 1)
+    loaded_w1 = adaptation.heads.w1_weight.clone()
+    _run_steps(adaptation, 4)
+    w1 = adaptation.heads.w1_weight
+    assert torch.isfinite(w1.float()).all()
+    assert torch.isfinite(adaptation.heads.conf_weight).all()
+    assert not torch.equal(w1, loaded_w1)
+    assert adaptation.drift() <= 1.0 + 1e-3
+    adaptation.reset()
+    assert torch.equal(adaptation.heads.w1_weight, weights["w1"])
+    assert _bits_digest(adaptation.heads.w1_weight) == _bits_digest(weights["w1"])
