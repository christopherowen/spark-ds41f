+# Request "p": 58 prompt tokens; output position 7 (position 65) is `` can``.
+PREEMPT_PROMPT = list(range(2000, 2058))
+PREEMPT_SCRIPT = _script(11, 12, 13, 14, 15, 16, 17, CAN, I_, HELP)
+
+
+def _preempt_run(tmp_path, *, tier, async_scheduling, num_drafts, replay, budget):
+    """Request "p" is preempted while the request holds `` can`` as draft
+    zero. The GPU prefix cache is dropped before the resume, so the resume
+    loads from the tier (with the tier) or computes everything (without)."""
+    scheduler = _scheduler(
+        tmp_path,
+        tier=tier,
+        async_scheduling=async_scheduling,
+        num_drafts=num_drafts,
+        budget=budget,
+    )
+    if tier:
+        # The replay suffix of the DeepSeek-V4.1 layout, on the tier's
+        # lookup only: a hit stops ``replay`` tokens before the prompt's end.
+        _manager(scheduler).cpu_coordinator.prefill_replay_tokens = replay
+    worker = TierWorker(
+        scheduler, {"p": PREEMPT_SCRIPT}, num_drafts or 0, draft_errors={("p", 7): 999}
+    )
+    request = _request("p", PREEMPT_PROMPT, max_tokens=12)
+    scheduler.add_request(request)
+    state = {"preempted_at": None, "reset": False, "num_prefills": 0}
+    prefills: list[tuple[int, int]] = []
+    record_prefill = _prefills(request, prefills)
+
+    def on_output(so: SchedulerOutput, mro: ModelRunnerOutput) -> None:
+        if (
+            state["preempted_at"] is None
+            and request.sink_provisional == CAN
+            and request.sink_draft_zero
+            and request.status == RequestStatus.RUNNING
+        ):
+            state["preempted_at"] = len(worker.loads)
+            state["num_prefills"] = len(prefills)
+            scheduler.running.remove(request)
+            scheduler._preempt_request(request, 0.0)
+
+    def before_schedule() -> None:
+        if (
+            state["preempted_at"] is not None
+            and not state["reset"]
+            and scheduler.kv_cache_manager.reset_prefix_cache()
+        ):
+            state["reset"] = True
+
+    def on_schedule(so: SchedulerOutput) -> None:
+        if "p" in so.num_scheduled_tokens or request.status == (
+            RequestStatus.WAITING_FOR_REMOTE_KVS
+        ):
+            assert state["preempted_at"] is None or state["reset"], (
+                "resumed before the GPU prefix cache was dropped"
+            )
+        record_prefill(so)
+
+    run = drive(
+        scheduler,
+        worker,
+        async_scheduling=async_scheduling,
+        before_schedule=before_schedule,
+        on_schedule=on_schedule,
+        on_output=on_output,
+    )
+    assert state["preempted_at"] is not None and request.num_preemptions == 1
+    k = state["num_prefills"]
+    return run, scheduler, worker, prefills[:k], prefills[k:], state["preempted_at"]
+
+
+def _assert_chunks(chunks: list[tuple[int, int]], start: int, end: int) -> None:
+    """The steps cover positions start to end, one after the other."""
+    assert chunks and chunks[0][0] == start, chunks
+    for (first, n), (following, _) in zip(chunks, chunks[1:]):
+        assert first + n == following, chunks
+    assert chunks[-1][0] + chunks[-1][1] == end, chunks
+
+
+@pytest.mark.parametrize("async_scheduling", [False, True])
+@pytest.mark.parametrize("num_drafts", [None, 2])
+@pytest.mark.parametrize("replay", [0, 16])
+@pytest.mark.parametrize("budget", [None, 16])
+def test_preempted_with_draft_zero_resumes_with_a_tier_hit(
+    tmp_path, async_scheduling, num_drafts, replay, budget
+):
+    """Preempted while `` can`` is held as draft zero, the request resumes
+    with a tier hit. With no replay suffix the hit reaches into the committed
+    output and stops one token short of the end; with a suffix of 16 the hit
+    stops 16 tokens before the prompt's end (manager.py,
+    get_num_new_matched_tokens). The resumed request draws position 7 again,
+    holds `` can`` again, and rejects `` can``. Reply and counters equal the
+    run with no connector, whose resume computes everything. With a step
+    budget of 16 the prompt and the resume run in chunks: the request is a
+    running request again from the resume's second chunk on, and holds no
+    draft zero until the resume's last chunk samples."""
+    run, scheduler, worker, before, after, preempted_at = _preempt_run(
+        tmp_path,
+        tier=True,
+        async_scheduling=async_scheduling,
+        num_drafts=num_drafts,
+        replay=replay,
+        budget=budget,
+    )
+    ref, _, _, _, ref_after, _ = _preempt_run(
+        tmp_path / "ref",
+        tier=False,
+        async_scheduling=async_scheduling,
+        num_drafts=num_drafts,
+        replay=0,
+        budget=budget,
+    )
+    _assert_same_reply(run, ref, "p", PREEMPT_SCRIPT, 12)
+    assert run.finished["p"].sink_metrics == ONE_REJECTION
+    # The first admission found an empty tier.
+    assert preempted_at == 0
+    resume_loads = worker.loads[preempted_at:]
+    assert len(resume_loads) == 1 and resume_loads[0][1] == ["p"]
+    hit = resume_loads[0][2] * B
+    if replay:
+        assert hit == (len(PREEMPT_PROMPT) - replay) // B * B
+    else:
+        # Every committed token but the last of the request at preemption.
+        assert hit > len(PREEMPT_PROMPT) - B and hit % B == 0
+    # Seven output tokens were committed at the preemption.
+    num_tokens = len(PREEMPT_PROMPT) + 7
+    _assert_chunks(before, 0, len(PREEMPT_PROMPT))
+    _assert_chunks(after, hit, num_tokens)
+    _assert_chunks(ref_after, 0, num_tokens)
+    if budget:
+        assert len(before) > 1 and len(ref_after) > 1
+        assert len(after) == (1 if num_tokens - hit <= budget else 3)
+    # Every rejected draft zero was `` can`` at position 65.
+    assert set(worker.rejected) == {(len(PREEMPT_PROMPT) + 7, CAN)}
+
