+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Sink rejection beside the disk tier, through the core scheduler (CPU-only).
+
+The real v1 scheduler runs sink rejection (vllm.v1.sample.sink) and the
+scheduler side of SimpleCPUOffloadConnector: disk backend, kv_role kv_both,
+kv_load_failure_policy "recompute", one rank. The scripted worker of
+tests/v1/core/test_sink_draft_zero.py plays the runner's side of draft zero.
+TierWorker extends that worker with a KV cache of one (position, token) entry
+a slot. Each step checks that the slots before the step's first input hold the
+request's committed tokens, then writes the KV of the step's inputs into the
+slots of the request's block table. The connector's transfers run on that
+model: a store copies GPU slots into the tier and checks the slots against the
+tokens of the block's hash, and a load copies tier slots back. The worker
+reports each transfer as the worker side of the connector does. Each case
+compares the reply and the sink counters with the same script run without a
+connector.
+"""
+
+from __future__ import annotations
+
+import errno
+from collections import deque
+from collections.abc import Callable
+
+import pytest
+
+from tests.v1.core.test_sink_draft_zero import (
+    CAN,
+    HELP,
+    HOW,
+    I_,
+    QM,
+    TODAY,
+    YOU,
+    Run,
+    ScriptedWorker,
+    _model_dir,
+    _script,
+    expected_reply,
+)
+from tests.v1.core.utils import EOS_TOKEN_ID
+from tests.v1.simple_kv_offload.test_scheduler import (
+    _BYTES_PER_BLOCK,
+    BLOCK_SIZE,
+    _make_kv_cache_config,
+)
+from vllm.config import (
+    CacheConfig,
+    DeviceConfig,
+    KVTransferConfig,
+    ModelConfig,
+    SchedulerConfig,
+    SpeculativeConfig,
+    VllmConfig,
+)
+from vllm.sampling_params import SamplingParams
+from vllm.utils.hashing import sha256
+from vllm.v1.core.kv_cache_utils import (
+    get_block_hash,
+    get_request_block_hasher,
+    hash_block_tokens,
+    init_none_hash,
+    make_block_hash_with_group_id,
+)
+from vllm.v1.core.sched.async_scheduler import AsyncScheduler
+from vllm.v1.core.sched.output import SchedulerOutput
+from vllm.v1.core.sched.scheduler import Scheduler
+from vllm.v1.metrics.stats import RequestSinkMetrics
+from vllm.v1.outputs import DraftTokenIds, KVConnectorOutput, ModelRunnerOutput
+from vllm.v1.request import Request, RequestStatus
+from vllm.v1.sample.sink import SinkOutcome, kv_transfer_refusal
+from vllm.v1.simple_kv_offload.metadata import (
+    SimpleCPUOffloadMetadata,
+    SimpleCPUOffloadWorkerMetadata,
+)
+from vllm.v1.structured_output import StructuredOutputManager
+
+pytestmark = pytest.mark.skip_global_cleanup
+
+B = BLOCK_SIZE
+NUM_GPU_BLOCKS = 64
+# Four blocks: with no replay suffix, a hit takes the first three blocks and
+# leaves the fourth to compute.
+PROMPT = list(range(1000, 1064))
+SAY_HI = _script(HOW, CAN, I_, HELP, YOU, TODAY, QM)
+ONE_REJECTION = RequestSinkMetrics(
+    num_flagged_draft_zero=1, num_draft_zero_rejections=1
+)
+
+# (position, token) whose KV a slot holds.
+Slot = tuple[int, int]
+
+
+@pytest.fixture(autouse=True)
+def sink_rejection_env(monkeypatch: pytest.MonkeyPatch) -> None:
+    # The test model has no entry in SINK_CHANNELS: name the model's column
+    # and threshold, and switch rejection on.
+    monkeypatch.setenv("VLLM_SINK_DETECTOR_COLUMN", "2455")
+    monkeypatch.setenv("VLLM_SINK_DETECTOR_THRESHOLD", "85000")
+    monkeypatch.setenv("VLLM_SINK_REJECTION", "1")
+    monkeypatch.setenv("VLLM_SINK_REJECTION_MAX_RETRIES", "3")
+
+
+def _scheduler(
+    tmp_path,
+    *,
+    tier: bool,
+    async_scheduling: bool,
+    num_drafts: int | None,
+    lazy: bool = False,
+    budget: int | None = None,
+) -> Scheduler:
+    model_config = ModelConfig(
+        model=_model_dir(),
+        trust_remote_code=True,
+        dtype="float16",
+        seed=42,
+        skip_tokenizer_init=True,
+    )
+    scheduler_config = SchedulerConfig(
+        max_num_seqs=16,
+        max_num_batched_tokens=1024,
+        max_model_len=model_config.max_model_len,
+        enable_chunked_prefill=True,
+        async_scheduling=async_scheduling,
+        is_encoder_decoder=False,
+        watermark=0.0,
+    )
+    cache_config = CacheConfig(
+        block_size=B,
+        gpu_memory_utilization=0.9,
+        cache_dtype="auto",
+        enable_prefix_caching=True,
+    )
+    speculative_config = None
+    if num_drafts is not None:
+        speculative_config = SpeculativeConfig(
+            model="ngram",
+            method="ngram_gpu",
+            num_speculative_tokens=num_drafts,
+            prompt_lookup_max=num_drafts,
+            prompt_lookup_min=1,
+        )
+    kv_transfer_config = None
+    if tier:
+        kv_transfer_config = KVTransferConfig(
+            kv_connector="SimpleCPUOffloadConnector",
+            kv_role="kv_both",
+            kv_connector_extra_config={
+                "cpu_bytes_to_use": _BYTES_PER_BLOCK * 64,
+                "kv_offload_backend": "disk",
+                "disk_path": str(tmp_path / "tier"),
+                "disk_capacity_bytes": 256 * 4096,
+                "lazy_offload": lazy,
+            },
+            kv_load_failure_policy="recompute",
+        )
+    vllm_config = VllmConfig(
+        device_config=DeviceConfig(device="cpu"),
+        scheduler_config=scheduler_config,
+        model_config=model_config,
+        cache_config=cache_config,
+        kv_transfer_config=kv_transfer_config,
+        speculative_config=speculative_config,
+    )
+    cache_config.num_gpu_blocks = NUM_GPU_BLOCKS
+    scheduler_cls = AsyncScheduler if async_scheduling else Scheduler
+    scheduler = scheduler_cls(
+        vllm_config=vllm_config,
+        kv_cache_config=_make_kv_cache_config(NUM_GPU_BLOCKS),
+        block_size=B,
+        log_stats=True,
+        structured_output_manager=StructuredOutputManager(vllm_config),
+    )
+    scheduler.use_v2_model_runner = True
+    if budget is not None:
+        # The step's token budget: a prompt longer than the budget is computed
+        # in chunks.
+        scheduler.max_num_scheduled_tokens = budget
+    assert scheduler.sink_rejection
+    assert (scheduler.connector is not None) == tier
+    return scheduler
+
+
+def _request(
+    req_id: str,
+    prompt: list[int],
+    max_tokens: int,
+    stop_token_ids: list[int] | None = None,
+) -> Request:
+    init_none_hash(sha256)
+    params = SamplingParams(
+        max_tokens=max_tokens, temperature=0.0, stop_token_ids=stop_token_ids
+    )
+    params.update_from_generation_config({}, EOS_TOKEN_ID)
+    return Request(
+        request_id=req_id,
+        prompt_token_ids=list(prompt),
+        sampling_params=params,
+        pooling_params=None,
+        block_hasher=get_request_block_hasher(B, sha256),
+    )
+
+
+def _check_keys(pool, contents: dict[int, list[Slot | None]], where: str) -> None:
+    """Every block of ``pool`` with a key holds full slots whose hash, chained
+    on a keyed block of the position before, is the key."""
+    by_index: dict[int, list[tuple[bytes, list[int]]]] = {}
+    for block_id, content in contents.items():
+        key = pool.blocks[block_id].block_hash
+        if key is None:
+            continue
+        assert all(slot is not None for slot in content), (where, block_id)
+        index = content[0][0] // B
+        assert [q for q, _ in content] == list(range(index * B, (index + 1) * B))
+        tokens = [t for _, t in content]
+        by_index.setdefault(index, []).append((get_block_hash(key), tokens))
+    parents: list[bytes | None] = [None]
+    for index in range(max(by_index, default=-1) + 1):
+        chained = []
+        for key, tokens in by_index.get(index, []):
+            assert any(
+                hash_block_tokens(sha256, parent, tokens) == key for parent in parents
+            ), f"{where} block {index}: the key is not the hash of the slots {tokens}"
+            chained.append(key)
+        parents = chained
+
+
+class TierWorker(ScriptedWorker):
+    """The scripted worker with a KV cache of (position, token) slots and the
+    worker side of SimpleCPUOffloadConnector on one rank."""
+
+    def __init__(self, scheduler, scripts, num_drafts, **kwargs):
+        super().__init__(scheduler, scripts, num_drafts, **kwargs)
+        self.gpu: dict[int, list[Slot | None]] = {}
+        self.tier: dict[int, list[Slot]] = {}
+        # Requests whose next load fails (a read fault), overruns the total
+        # bound, or stays in flight until the test releases the load.
+        self.fail_loads: set[str] = set()
+        self.overrun_loads: set[str] = set()
+        self.held_loads: set[str] = set()
+        # Loads sent and not reported: (event, GPU blocks, tier blocks, reqs).
+        self.pending: list[tuple[int, list[int], list[int], list[str]]] = []
+        # Per load event sent: (event, the event's requests, the block count).
+        self.loads: list[tuple[int, list[str], int]] = []
+        # Per stored block: (request whose hash the block carries, block index).
+        self.stored: list[tuple[str, int]] = []
+        # (position, token) of each rejected draft zero.
+        self.rejected: list[Slot] = []
+        # Every request seen, kept after the finish for the finish-time store.
+        self.seen: dict[str, Request] = {}
+        self.tables: dict[str, list[int]] = {}
+        # Per request: the slots read by the request's first computing step.
+        self.first_reads: dict[str, int] = {}
+        self._draft_zero_at: dict[str, Slot] = {}
+
+    def execute(self, so: SchedulerOutput) -> ModelRunnerOutput:
+        self.seen.update(self.scheduler.requests)
+        self._compute(so)
+        # Stores are ordered after the step's forward (wait_for_save).
+        kv_output = self._transfer(so)
+        mro = super().execute(so)
+        for req_id, event in (mro.sink_events or {}).items():
+            if event.outcome == SinkOutcome.REJECTED:
+                self.rejected.append(self._draft_zero_at[req_id])
+        mro.kv_connector_output = kv_output
+        return mro
+
+    def _slot(self, table: list[int], q: int) -> Slot | None:
+        return self.gpu.get(table[q // B], [None] * B)[q % B]
+
+    def _compute(self, so: SchedulerOutput) -> None:
+        """Check the KV each scheduled request reads, then write the step's inputs."""
+        draft_zero = so.sink_draft_zero_req_ids or set()
+        for req_id, n in so.num_scheduled_tokens.items():
+            request = self.scheduler.requests[req_id]
+            table = list(self.scheduler.kv_cache_manager.get_block_ids(req_id)[0])
+            self.tables[req_id] = table
+            if req_id in draft_zero:
+                st = self.requests[req_id]
+                spec = so.scheduled_spec_decode_tokens[req_id]
+                assert request.prompt_token_ids is not None
+                committed = [*request.prompt_token_ids, *st.committed]
+                start = len(committed)
+                assert st.provisional is not None
+                inputs = [st.provisional, *st.drafts[: len(spec) - 1]]
+                self._draft_zero_at[req_id] = (start, st.provisional)
+            else:
+                start = request.num_computed_tokens - n
+                committed = list(request.all_token_ids)
+                # A request with one token left after the hits gets spec
+                # placeholders (pad_spec_decode): the placeholders roll back
+                # like rejected drafts, and hold no committed token.
+                num_pads = len(so.scheduled_spec_decode_tokens.get(req_id, ()))
+                assert start + n - num_pads <= len(committed), (req_id, start, n)
+                inputs = committed[start : start + n - num_pads] + [-1] * num_pads
+            for q in range(start):
+                assert self._slot(table, q) == (q, committed[q]), (
+                    f"{req_id} reads slot {q}: {self._slot(table, q)}, "
+                    f"committed {committed[q]}"
+                )
+            self.first_reads.setdefault(req_id, start)
+            for j, token in enumerate(inputs):
+                q = start + j
+                block = self.gpu.setdefault(table[q // B], [None] * B)
+                block[q % B] = (q, token)
+
+    def _block_of(self, block_hash) -> tuple[str, int]:
+        for req_id, request in self.seen.items():
+            for i, h in enumerate(request.block_hashes):
+                if make_block_hash_with_group_id(h, 0) == block_hash:
+                    return req_id, i
+        raise AssertionError(f"no request has the block hash {block_hash!r}")
+
+    def check_keys(self) -> None:
+        """The key of each hashed block, on the GPU and on the tier, is the hash
+        of the block's own slots, chained on a hashed block at the position
+        before; the block hashes of each request are the hashes of the request's
+        committed tokens. No key names a token that the slots or the request do
+        not hold."""
+        _check_keys(self.scheduler.kv_cache_manager.block_pool, self.gpu, "GPU")
+        if self.scheduler.connector is not None:
+            pool = self.scheduler.connector.scheduler_manager.cpu_block_pool
+            _check_keys(pool, self.tier, "tier")
+        for req_id, request in self.seen.items():
+            committed = _request("committed", request.all_token_ids, max_tokens=1)
+            assert request.block_hashes == committed.block_hashes, req_id
+
+    def _transfer(self, so: SchedulerOutput) -> KVConnectorOutput | None:
+        meta = so.kv_connector_metadata
+        if not isinstance(meta, SimpleCPUOffloadMetadata):
+            return None
+        worker_meta = SimpleCPUOffloadWorkerMetadata(completed_store_events={})
+        if meta.store_event >= 0:
+            pool = self.scheduler.kv_cache_manager.block_pool
+            for gpu_id, cpu_id in zip(meta.store_gpu_blocks, meta.store_cpu_blocks):
+                req_id, index = self._block_of(pool.blocks[gpu_id].block_hash)
+                tokens = self.seen[req_id].all_token_ids[index * B : (index + 1) * B]
+                content = list(self.gpu.get(gpu_id, [None] * B))
+                # A stored block holds the KV of the committed tokens of the
+                # block's hash, and of no other token.
+                assert content == [(index * B + j, t) for j, t in enumerate(tokens)], (
+                    f"stored block {index} of {req_id}: {content}"
+                )
+                self.tier[cpu_id] = content
+                self.stored.append((req_id, index))
+            worker_meta.completed_store_events[meta.store_event] = 1
+        if meta.load_event >= 0:
+            req_ids = list(meta.load_event_to_reqs[meta.load_event])
+            self.pending.append(
+                (
+                    meta.load_event,
+                    list(meta.load_gpu_blocks),
+                    list(meta.load_cpu_blocks),
+                    req_ids,
+                )
+            )
+            self.loads.append((meta.load_event, req_ids, len(meta.load_gpu_blocks)))
+        finished: set[str] = set()
+        failed: set[str] = set()
+        still: list[tuple[int, list[int], list[int], list[str]]] = []
+        for event, gpu_ids, cpu_ids, req_ids in self.pending:
+            reqs = set(req_ids)
+            if reqs & self.held_loads:
+                still.append((event, gpu_ids, cpu_ids, req_ids))
+                continue
+            if reqs & self.fail_loads:
+                self.fail_loads -= reqs
+                failed |= reqs
+                worker_meta.faults.append(
+                    (0, "read", cpu_ids[0], errno.EIO, "scripted read fault")
+                )
+            elif reqs & self.overrun_loads:
+                self.overrun_loads -= reqs
+                failed |= reqs
+                worker_meta.overrun_load_events.add(event)
+            else:
+                # The copy lands when the load is reported, at the latest.
+                for gpu_id, cpu_id in zip(gpu_ids, cpu_ids):
+                    self.gpu[gpu_id] = list(self.tier[cpu_id])
+            finished |= reqs
+        self.pending = still
+        return KVConnectorOutput(
+            finished_recving=finished,
+            failed_recving=failed,
+            kv_connector_worker_meta=worker_meta,
+        )
+
+
+def drive(
+    scheduler,
+    worker: TierWorker,
+    *,
+    async_scheduling: bool,
+    run: Run | None = None,
+    max_steps: int = 600,
+    before_schedule: Callable[[], None] | None = None,
+    on_schedule: Callable[[SchedulerOutput], None] | None = None,
+    on_output: Callable[[SchedulerOutput, ModelRunnerOutput], None] | None = None,
+) -> Run:
+    """The engine core loop, as test_sink_draft_zero.drive, except that every
+    step runs on the worker, one with no tokens too (EngineCore.step): the
+    connector's transfers report in such steps.
+
+    After each output, the computed tokens past the committed ones and the
+    output placeholders of a running request stay within the tokens in flight.
+    The store bounds read num_computed_tokens - num_output_placeholders, so an
+    asynchronous step whose rejections roll back neither counter leaves the
+    stores unchanged; this check is what sees such a step. At the end, the
+    keys of the hashed blocks and of the requests are checked against the slots
+    and the committed tokens (TierWorker.check_keys)."""
+    run = run if run is not None else Run()
+    queue: deque[tuple[SchedulerOutput, ModelRunnerOutput]] = deque()
+
+    def process(so: SchedulerOutput, mro: ModelRunnerOutput) -> None:
+        engine_outputs = scheduler.update_from_output(so, mro)
+        for eco in engine_outputs.values():
+            for out in eco.outputs:
+                run.emitted.setdefault(out.request_id, []).extend(out.new_token_ids)
+                run.outputs.setdefault(out.request_id, []).append(out)
+                if out.finish_reason is not None:
+                    run.finished[out.request_id] = out
+        if not async_scheduling and so.total_num_scheduled_tokens > 0:
+            req_ids = [r for r in mro.req_ids if r in worker.requests]
+            scheduler.update_draft_token_ids(
+                DraftTokenIds(
+                    req_ids, [list(worker.requests[r].drafts) for r in req_ids]
+                )
+            )
+        for request in scheduler.running:
+            assert request.num_output_placeholders >= 0
+            in_flight = request.num_in_flight_tokens
+            assert request.num_computed_tokens <= request.num_tokens + in_flight, (
+                request.request_id
+            )
+            assert request.num_output_placeholders <= in_flight, request.request_id
+            if not async_scheduling and not request.is_prefill_chunk:
+                # Every committed token is computed; the held one is not.
+                assert request.num_computed_tokens == request.num_tokens, (
+                    request.request_id
+                )
+        if on_output is not None:
+            on_output(so, mro)
+
+    steps = 0
+    while steps < max_steps:
+        if not scheduler.has_requests():
+            if not queue:
+                break
+            process(*queue.popleft())
+            continue
+        steps += 1
+        if before_schedule is not None:
+            before_schedule()
+        so = scheduler.schedule()
+        if on_schedule is not None:
+            on_schedule(so)
+        queue.append((so, worker.execute(so)))
+        if async_scheduling and len(queue) < 2:
+            continue
+        process(*queue.popleft())
+    assert not queue and not scheduler.has_requests(), "the run did not finish"
+    worker.check_keys()
+    run.steps += steps
+    return run
+
+
+def _seed(scheduler, worker: TierWorker, prompt: list[int], *, async_scheduling):
+    """A request computes ``prompt`` and finishes; with the tier, the request's
+    blocks are stored. The GPU prefix cache is then dropped: a later request
+    with the same prompt finds the prompt on the tier only."""
+    worker.scripts["seed"] = _script(HOW)
+    scheduler.add_request(_request("seed", prompt, max_tokens=1))
+    drive(scheduler, worker, async_scheduling=async_scheduling)
+    if scheduler.connector is not None:
+        assert len(prompt) // B >= 3
+        assert {i for r, i in worker.stored if r == "seed"} >= {0, 1, 2}
+    assert scheduler.kv_cache_manager.reset_prefix_cache()
+
+
+def _manager(scheduler):
+    return scheduler.connector.scheduler_manager
+
+
+def _prefills(request: Request, prefills: list[tuple[int, int]]):
+    """An on_schedule hook: (first position, committed tokens) of each step
+    of ``request`` that computes committed positions, spec placeholders of a
+    padded step (pad_spec_decode) left out."""
+
+    def record(so: SchedulerOutput) -> None:
+        req_id = request.request_id
+        n = so.num_scheduled_tokens.get(req_id)
+        if n and req_id not in (so.sink_draft_zero_req_ids or ()):
+            num_pads = len(so.scheduled_spec_decode_tokens.get(req_id, ()))
+            prefills.append((request.num_computed_tokens - n, n - num_pads))
+
+    return record
+
+
+def _tier_hit_run(tmp_path, *, tier, async_scheduling, num_drafts, load=None):
+    """Request "a" with PROMPT after the seed: a tier hit with the tier (the
+    load as ``load`` says), then the collapse sequence of SAY_HI, `` can``
+    held as draft zero and rejected."""
+    scheduler = _scheduler(
+        tmp_path, tier=tier, async_scheduling=async_scheduling, num_drafts=num_drafts
+    )
+    worker = TierWorker(scheduler, {}, num_drafts or 0, draft_errors={("a", 1): 999})
+    _seed(scheduler, worker, PROMPT, async_scheduling=async_scheduling)
+    worker.scripts["a"] = SAY_HI
+    if load == "fail":
+        worker.fail_loads.add("a")
+    elif load == "overrun":
+        worker.overrun_loads.add("a")
+    request = _request("a", PROMPT, max_tokens=12)
+    scheduler.add_request(request)
+    statuses: list[RequestStatus] = []
+    prefills: list[tuple[int, int]] = []
+    overrun_marks: list[bool] = []
+    record_prefill = _prefills(request, prefills)
+
+    def on_schedule(so: SchedulerOutput) -> None:
+        statuses.append(request.status)
+        record_prefill(so)
+        if tier and "a" in so.num_scheduled_tokens:
+            overrun_marks.append("a" in _manager(scheduler)._overrun_reqs)
+
+    run = drive(
+        scheduler, worker, async_scheduling=async_scheduling, on_schedule=on_schedule
+    )
+    return run, scheduler, worker, statuses, prefills, overrun_marks
+
+
+def _assert_same_reply(run: Run, ref: Run, req_id: str, script, length: int):
+    assert run.emitted[req_id] == expected_reply(script, length)
+    assert run.emitted[req_id] == ref.emitted[req_id]
+    assert run.finished[req_id].sink_metrics == ref.finished[req_id].sink_metrics
+
