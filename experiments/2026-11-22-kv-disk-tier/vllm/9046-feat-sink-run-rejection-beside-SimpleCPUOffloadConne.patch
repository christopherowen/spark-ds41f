+def _abort_run(tmp_path, *, tier, async_scheduling, num_drafts):
+    """Request "a" (SAY_HI, a separate prompt) holds `` can``; then request "b"
+    with the seeded PROMPT arrives and, with the tier, waits for a load that
+    the worker holds back. "b" is aborted while waiting, beside "a", which then
+    holds a draft zero; the load is reported afterwards."""
+    scheduler = _scheduler(
+        tmp_path, tier=tier, async_scheduling=async_scheduling, num_drafts=num_drafts
+    )
+    worker = TierWorker(scheduler, {}, num_drafts or 0, draft_errors={("a", 1): 999})
+    _seed(scheduler, worker, PROMPT, async_scheduling=async_scheduling)
+    worker.scripts.update(a=SAY_HI, b=_script(21, 22, 23))
+    a = _request("a", list(range(3000, 3030)), max_tokens=12)
+    b = _request("b", PROMPT, max_tokens=8)
+    scheduler.add_request(a)
+    state: dict = {"phase": "before", "targets": [], "refs": []}
+
+    def on_output(so: SchedulerOutput, mro: ModelRunnerOutput) -> None:
+        phase = state["phase"]
+        if phase == "before" and a.sink_provisional == CAN:
+            worker.held_loads.add("b")
+            scheduler.add_request(b)
+            state["phase"] = "added"
+        elif phase == "added" and b.status != RequestStatus.WAITING:
+            assert b.status == (
+                RequestStatus.WAITING_FOR_REMOTE_KVS if tier else RequestStatus.RUNNING
+            )
+            assert a.sink_draft_zero and a.sink_provisional is not None
+            if tier:
+                state["targets"] = [
+                    g
+                    for _, gpu_ids, _, reqs in worker.pending
+                    if "b" in reqs
+                    for g in gpu_ids
+                ]
+                assert state["targets"]
+            scheduler.finish_requests("b", RequestStatus.FINISHED_ABORTED)
+            pool = scheduler.kv_cache_manager.block_pool
+            # The load is still in flight: the load's GPU blocks stay pinned.
+            state["refs"] = [pool.blocks[g].ref_cnt for g in state["targets"]]
+            state["phase"] = "aborted"
+        elif phase == "aborted":
+            worker.held_loads.discard("b")
+            state["phase"] = "released"
+
+    run = drive(
+        scheduler, worker, async_scheduling=async_scheduling, on_output=on_output
+    )
+    assert state["phase"] == "released"
+    return run, scheduler, worker, state, b
+
+
+@pytest.mark.parametrize("async_scheduling", [False, True])
+@pytest.mark.parametrize("num_drafts", [None, 2])
+def test_abort_while_waiting_beside_a_draft_zero(
+    tmp_path, async_scheduling, num_drafts
+):
+    """An abort of a request in WAITING_FOR_REMOTE_KVS, beside a request that
+    holds a draft zero, changes nothing of the latter: the reply and counters
+    of "a" equal the run with no connector. The aborted load keeps the load's
+    GPU blocks pinned until the worker reports the load, and nothing of the
+    load stays afterwards."""
+    run, scheduler, worker, state, b = _abort_run(
+        tmp_path, tier=True, async_scheduling=async_scheduling, num_drafts=num_drafts
+    )
+    ref, *_ = _abort_run(
+        tmp_path / "ref",
+        tier=False,
+        async_scheduling=async_scheduling,
+        num_drafts=num_drafts,
+    )
+    _assert_same_reply(run, ref, "a", SAY_HI, 12)
+    assert run.finished["a"].sink_metrics == ONE_REJECTION
+    assert b.status == RequestStatus.FINISHED_ABORTED and "b" not in scheduler.requests
+    assert not run.emitted.get("b")
+    assert [(reqs, n) for _, reqs, n in worker.loads] == [(["b"], 3)]
+    assert state["refs"] and all(ref_cnt > 0 for ref_cnt in state["refs"])
+    mgr = _manager(scheduler)
+    assert not mgr._reqs_to_load and not mgr._load_event_to_reqs
+    assert not mgr.degraded and not worker.pending
+    pool = scheduler.kv_cache_manager.block_pool
+    assert pool.get_num_free_blocks() == pool.num_gpu_blocks - 1
+    cpu_pool = mgr.cpu_block_pool
+    assert cpu_pool.get_num_free_blocks() == cpu_pool.num_gpu_blocks - 1
+
