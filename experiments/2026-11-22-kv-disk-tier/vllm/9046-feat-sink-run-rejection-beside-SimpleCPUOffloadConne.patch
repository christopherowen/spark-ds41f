+# Request "s": 20 prompt tokens, so output position 11 is position 31, the last
+# slot of block 1. `` can`` is drawn there and rejected.
+STORE_PROMPT = list(range(4000, 4020))
+
+
+@pytest.mark.parametrize("async_scheduling", [False, True])
+@pytest.mark.parametrize("num_drafts", [None, 2])
+@pytest.mark.parametrize("lazy", [False, True])
+@pytest.mark.parametrize("ending", ["stop", "continue"])
+def test_stored_blocks_hold_committed_tokens_only(
+    tmp_path, async_scheduling, num_drafts, lazy, ending
+):
+    """Every block the tier stores holds the KV of the committed tokens of the
+    block's hash (checked slot by slot when the store runs), so no held or
+    rejected token. `` can`` is rejected at position 31, the last slot of
+    block 1, so the KV of `` can`` sits in that slot. "continue": the
+    replacement is computed there in the next step, and block 1 is stored with
+    the replacement. "stop": the replacement is EOS, committed unverified when
+    drawn, which completes block 1 after the block's last allocation: the block
+    has no hash and is not stored."""
+    script = _script(*range(30, 41), CAN)
+    script[11] = [CAN, EOS_TOKEN_ID if ending == "stop" else I_, 311]
+    length = 12 if ending == "stop" else 30
+    runs = {}
+    for tier in (True, False):
+        scheduler = _scheduler(
+            tmp_path / str(tier),
+            tier=tier,
+            async_scheduling=async_scheduling,
+            num_drafts=num_drafts,
+            lazy=lazy,
+        )
+        worker = TierWorker(
+            scheduler, {"s": script}, num_drafts or 0, draft_errors={("s", 11): 999}
+        )
+        scheduler.add_request(_request("s", STORE_PROMPT, max_tokens=30))
+        runs[tier] = (
+            drive(scheduler, worker, async_scheduling=async_scheduling),
+            worker,
+        )
+    (run, worker), (ref, _) = runs[True], runs[False]
+    _assert_same_reply(run, ref, "s", script, length)
+    assert run.finished["s"].sink_metrics == ONE_REJECTION
+    assert worker.rejected == [(31, CAN)]
+    block1 = worker.tables["s"][1]
+    stored = sorted(i for r, i in worker.stored if r == "s")
+    if ending == "stop":
+        assert run.emitted["s"][-1] == EOS_TOKEN_ID
+        # Synchronous: no step follows, so the slot keeps the KV of `` can``.
+        # Asynchronous: the step in flight computed EOS there; the output of
+        # dropped with the finished request. Either way the block's last token
+        # was committed after the last allocation, so the block has no hash.
+        assert worker.gpu[block1][15] == (31, EOS_TOKEN_ID if async_scheduling else CAN)
+        assert stored == [0]
+    else:
+        # Block 2 too, if a step ran after the block's last token was committed.
+        assert stored[:2] == [0, 1] and stored == sorted(set(stored))
+        assert worker.gpu[block1][15] == (31, I_)
+    for content in worker.tier.values():
+        for slot in content:
+            assert slot not in worker.rejected
+
