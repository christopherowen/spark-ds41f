@@ -0,0 +1,151 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""DeepSeek-V4.1-Flash KV cache layout, built without a GPU or a checkpoint.
+
+The per-layer specs repeat what the fork's model code returns:
+``vllm/models/deepseek_v4_1/attention.py`` (``_Cache.get_kv_cache_spec`` for the
+sliding windows and the indexer keys, ``DeepseekV41Attention.get_kv_cache_spec``
+for the compressed latents) and ``vllm/models/deepseek_v4_1/compressor.py``
+(``CompressorStateCache.get_kv_cache_spec``). The layer facts come from the
+checkpoint's ``config.json`` (``text_config``): 40 target layers plus 3 DSpark
+drafter layers, ``compress_ratios``, ``kv_source_layer_ids`` [2, 8, 14, 20], a
+128-token sliding window, and the CED decoder start at layer 20.
+
+The packing runs through the fork's own ``_get_packed_kv_cache_groups`` and
+``get_kv_cache_config_from_groups``. Spec registration order inside a layer is
+an assumption (main latent, window, compressor state, indexer key); it can move
+a layer between window groups but not change the block bytes, the number of
+groups or which group is full attention.
+"""
+
+from __future__ import annotations
+
+import os
+from unittest.mock import MagicMock
+
+import torch
+
+from vllm.config import CacheConfig
+from vllm.v1.core.kv_cache_utils import (
+    _get_packed_kv_cache_groups,
+    generate_scheduler_kv_cache_config,
+    get_kv_cache_config_from_groups,
+)
+from vllm.v1.core.single_type_kv_cache_manager import register_all_kvcache_specs
+from vllm.v1.kv_cache_interface import (
+    CircularBufferSpec,
+    KVCacheConfig,
+    KVCacheSpec,
+    MLAAttentionSpec,
+    SlidingWindowMLASpec,
+)
+from vllm.v1.kv_cache_layout import KVCacheLayout
+
+# text_config of deepseek-ai/DeepSeek-V4.1-Flash-1017 (recipe state/config.json)
+NUM_TARGET_LAYERS = 40
+NUM_DRAFT_LAYERS = 3
+COMPRESS_RATIOS = [0, 0] + [2] * 18 + [1] * 20 + [0, 0, 0]
+KV_SOURCE_LAYER_IDS = (2, 8, 14, 20)
+SLIDING_WINDOW = 128
+CED_DECODER_START = 20  # ced_decoder_start(): first ratio-1 kv source after ratio 2
+
+BLOCK_SIZE = 256  # --block-size 256 (DEFAULT_DS41_BLOCK_SIZE)
+SWA_BLOCK_SIZE = 128  # DEFAULT_DS41_SWA_BLOCK_SIZE
+NUM_SPECULATIVE_TOKENS = 5  # dspark, num_speculative_tokens 5
+RETENTION_INTERVAL = 512  # --prefix-cache-retention-interval 512
+
+# Live engine: --kv-cache-memory-bytes 3758096384 gives num_gpu_blocks 16494.
+LIVE_KV_CACHE_BYTES = 3758096384
+LIVE_NUM_GPU_BLOCKS = 16494
+LIVE_BLOCK_BYTES = 227840
+
+
+def _common(block_size: int, head_size: int, state_bytes: int, ratio: int) -> dict:
+    return dict(
+        block_size=block_size,
+        num_kv_heads=1,
+        head_size=head_size,
+        state_content_bytes=state_bytes,
+        dtype=torch.uint8,
+        tokens_per_state=ratio,
+        cache_dtype_str="dsv41",
+        alignment=None,
+        uses_only_written_slots=True,
+    )
+
+
+def layer_specs() -> dict[str, KVCacheSpec]:
+    """Per-layer KV cache specs in model registration order."""
+    lsa = os.environ.get("VLLM_DS41_LSA") == "1"
+    specs: dict[str, KVCacheSpec] = {}
+    for layer_id in range(NUM_TARGET_LAYERS + NUM_DRAFT_LAYERS):
+        prefix = f"model.layers.{layer_id}.self_attn"
+        ratio = COMPRESS_RATIOS[layer_id]
+        is_draft = layer_id >= NUM_TARGET_LAYERS
+        if layer_id in KV_SOURCE_LAYER_IDS:
+            specs[prefix] = MLAAttentionSpec(**_common(BLOCK_SIZE, 512, 288, ratio))
+        bounded_replay = is_draft or layer_id >= CED_DECODER_START
+        specs[f"{prefix}.swa_cache"] = SlidingWindowMLASpec(
+            **_common(SWA_BLOCK_SIZE, 512, 528, 1),
+            sliding_window=SLIDING_WINDOW,
+            extra_retained_tokens=int(is_draft),
+            prefix_cache_enabled=not bounded_replay,
+            prefill_replay_window=128 if bounded_replay else 0,
+        )
+        if layer_id in KV_SOURCE_LAYER_IDS:
+            state_block = max(8, 1 << (NUM_SPECULATIVE_TOKENS + 1).bit_length())
+            specs[f"{prefix}.compressor.state_cache"] = CircularBufferSpec(
+                block_size=state_block,
+                num_kv_heads=1,
+                head_size=1024,
+                head_size_v=0,
+                dtype=torch.float32,
+                uses_only_written_slots=True,
+            )
+            specs[f"{prefix}.indexer.k_cache"] = MLAAttentionSpec(
+                **_common(BLOCK_SIZE, 68, 84 if lsa else 68, ratio)
+            )
+    return specs
+
+
+def packing_vllm_config(layout: KVCacheLayout = KVCacheLayout.BLHNC) -> MagicMock:
+    """The few config fields the packing path reads."""
+    vllm_config = MagicMock()
+    vllm_config.cache_config = CacheConfig()
+    vllm_config.cache_config.block_size = BLOCK_SIZE
+    vllm_config.cache_config.kv_cache_layout = layout.name
+    vllm_config.cache_config.num_gpu_blocks_override = None
+    vllm_config.cache_config.prefix_cache_retention_interval = RETENTION_INTERVAL
+    vllm_config.parallel_config.decode_context_parallel_size = 1
+    vllm_config.attention_config.hisparse_config = None
+    vllm_config.kv_transfer_config = None
+    # dspark keeps its own drafter KV, so no EAGLE block drop.
+    vllm_config.speculative_config.use_eagle_block_drop.return_value = False
+    vllm_config.speculative_config.use_eagle.return_value = False
+    vllm_config.model_config.hf_config.model_type = "deepseek_v41"
+    return vllm_config
+
+
+def ds41_kv_cache_config(
+    kv_cache_memory_bytes: int = LIVE_KV_CACHE_BYTES,
+) -> KVCacheConfig:
+    """The packed KVCacheConfig of the live engine's pool."""
+    register_all_kvcache_specs(vllm_config=None)
+    vllm_config = packing_vllm_config()
+    groups = _get_packed_kv_cache_groups(vllm_config, layer_specs())
+    assert groups is not None, "DeepSeek-V4.1 must take the packed path"
+    return get_kv_cache_config_from_groups(vllm_config, groups, kv_cache_memory_bytes)
+
+
+def ds41_scheduler_kv_cache_config(
+    kv_cache_memory_bytes: int = LIVE_KV_CACHE_BYTES,
+) -> KVCacheConfig:
+    """The config the scheduler and its connector receive.
+
+    EngineCore._initialize_kv_caches passes the worker configs through
+    generate_scheduler_kv_cache_config, which replaces each
+    UniformTypeKVCacheSpecs group by its scheduler_spec.
+    """
+    return generate_scheduler_kv_cache_config(
+        [ds41_kv_cache_config(kv_cache_memory_bytes)]
+    )
