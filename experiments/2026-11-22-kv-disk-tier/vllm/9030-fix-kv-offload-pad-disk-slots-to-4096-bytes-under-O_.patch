+def test_padded_odirect_two_tensors_keep_file_layout(
+    tmp_path, host_disk_backend
+) -> None:
+    """Two regions of 1,536 and 2,048 bytes share one padded 4,096-byte slot,
+    back to back in tensor order, as the unpadded layout wrote them."""
+    gen = torch.Generator().manual_seed(7)
+    a = torch.randint(-128, 127, (4, 1536), dtype=torch.int8, generator=gen)
+    b = torch.randint(-128, 127, (4, 2048), dtype=torch.int8, generator=gen)
+    caches = {"a": a, "b": b}
+    want_a, want_b = a.clone(), b.clone()
+    disk_path = _odirect_dir(tmp_path) / "kv-two.bin"
+    stream = SimpleNamespace(wait_event=lambda event: None, cuda_stream=0)
+    backend = host_disk_backend()
+    backend.init(caches, torch.device("cpu"), stream, stream, str(disk_path), 8, 3584)
+    assert backend._slot_bytes == 4096
+    backend._do_store([0, 3], [5, 7], stream)
+    with open(disk_path, "rb") as raw:
+        raw.seek(5 * 4096)
+        slot = raw.read(4096)
+    assert slot[:1536] == want_a[0].numpy().tobytes()
+    assert slot[1536:3584] == want_b[0].numpy().tobytes()
+    a.zero_()
+    b.zero_()
+    backend._do_load([5, 7], [0, 3], stream)
+    assert torch.equal(a[[0, 3]], want_a[[0, 3]])
+    assert torch.equal(b[[0, 3]], want_b[[0, 3]])
+
+
+def test_disk_backend_io_threads_roundtrip(tmp_path, host_disk_backend) -> None:
+    """The launch_copy path (store and load threads) moves the same bytes."""
+    block = ds41_layout.LIVE_BLOCK_BYTES
+    gen = torch.Generator().manual_seed(99)
+    gpu = torch.randint(-128, 127, (3, block), dtype=torch.int8, generator=gen)
+    want = gpu.clone()
+    stream = SimpleNamespace(wait_event=lambda event: None, cuda_stream=0)
+    backend = host_disk_backend()
+    backend.init(
+        {"packed": gpu},
+        torch.device("cpu"),
+        stream,
+        stream,
+        str(_odirect_dir(tmp_path) / "kv-threads.bin"),
+        16,
+        block,
+    )
+    stored: list = []
+    backend.launch_copy([0, 1, 2], [15, 0, 8], True, 0, stored)
+    _wait_for(lambda: len(stored) == 1)
+    gpu.zero_()
+    loaded: list = []
+    backend.launch_copy([15, 0, 8], [0, 1, 2], False, 0, loaded)
+    _wait_for(lambda: len(loaded) == 1)
+    assert torch.equal(gpu, want)
+
+
+def _wait_for(predicate, timeout_s: float = 10.0) -> None:
+    done = threading.Event()
+    for _ in range(int(timeout_s / 0.01)):
+        if predicate():
+            return
+        done.wait(0.01)
+    raise AssertionError("IO thread did not finish")
