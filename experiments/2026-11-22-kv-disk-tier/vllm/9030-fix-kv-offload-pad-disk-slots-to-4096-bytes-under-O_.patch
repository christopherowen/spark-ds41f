+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""SimpleCPUOffloadConnector disk tier on the DeepSeek-V4.1-Flash layout.
+
+CPU-only tests for the changes the tier needs on this model: the padded
+O_DIRECT slot, the expandable_segments declaration and the bounded-replay cap
+on external hits. A fourth suspected change, the full-attention group lookup,
+is shown not to be needed: the scheduler-side connector receives unwrapped
+group specs.
+The layout comes from ``ds41_layout`` (the fork's own packing on the model's
+real per-layer specs). The O_DIRECT tests move real bytes through the real
+``DiskBackend`` file and staging code; only the CUDA batch copy is replaced by
+a host memmove.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import os
+import threading
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from tests.v1.simple_kv_offload import ds41_layout
+from tests.v1.simple_kv_offload.test_scheduler import _make_vllm_config
+from vllm.v1.kv_cache_interface import (
+    FullAttentionSpec,
+    MLAAttentionSpec,
+    is_full_attention_spec,
+    iter_layer_specs,
+)
+from vllm.v1.simple_kv_offload import disk_backend as disk_backend_mod
+from vllm.v1.simple_kv_offload.disk_backend import DiskBackend, disk_slot_bytes
+from vllm.v1.simple_kv_offload.manager import SimpleCPUOffloadScheduler
+
+pytestmark = pytest.mark.skip_global_cleanup
+
+GIB = 1024**3
+PADDED_BLOCK_BYTES = 229376  # 227,840 rounded up to a 4096 multiple
+SCHEDULER_BLOCK_SIZE = 256  # LCM of the 256-token latent and 128-token windows
+HASH_BLOCK_SIZE = 128  # the smallest prefix-cacheable group block
+
+
+@pytest.fixture(scope="module")
+def ds41_worker_config():
+    """The packed config each worker allocates (UniformTypeKVCacheSpecs)."""
+    return ds41_layout.ds41_kv_cache_config()
+
+
+@pytest.fixture(scope="module")
+def ds41_config():
+    """The config the scheduler, and so SimpleCPUOffloadScheduler, receives."""
+    return ds41_layout.ds41_scheduler_kv_cache_config()
+
+
+def _ds41_scheduler(kv_cache_config, disk_bytes: int, page_cache: bool = False):
+    return SimpleCPUOffloadScheduler(
+        vllm_config=_make_vllm_config(),
+        kv_cache_config=kv_cache_config,
+        cpu_capacity_bytes=0,
+        scheduler_block_size=SCHEDULER_BLOCK_SIZE,
+        hash_block_size=HASH_BLOCK_SIZE,
+        lazy_offload=False,
+        disk_capacity_bytes=disk_bytes,
+        disk_use_page_cache=page_cache,
+    )
+
+
+# ---------------------------------------------------------------------------
+# The layout the tests run on
+# ---------------------------------------------------------------------------
+
+
+def test_ds41_layout_matches_live_engine(ds41_worker_config) -> None:
+    """The desk layout reproduces the live pool: 16,494 blocks of 227,840 B."""
+    config = ds41_worker_config
+    assert config.num_blocks == ds41_layout.LIVE_NUM_GPU_BLOCKS
+    assert config.kv_cache_tensors[0].size // config.num_blocks == (
+        ds41_layout.LIVE_BLOCK_BYTES
+    )
+    groups = config.kv_cache_groups
+    # 15 window groups, one compressed latent group, one compressor-state group
+    assert len(groups) == 17
+    cacheable = config.prefix_cacheable_group_ids
+    # 7 encoder window groups (layers 0-19) and the compressed latents
+    assert len(cacheable) == 8
+    replay = {g.kv_cache_spec.prefill_replay_tokens for g in groups}
+    assert replay == {0, 128}
+    compressed = [g for g in groups if is_full_attention_spec(g.kv_cache_spec)]
+    assert len(compressed) == 1
+    layers = list(iter_layer_specs(compressed[0].kv_cache_spec))
+    assert all(isinstance(s, MLAAttentionSpec) for s in layers)
+    assert len(layers) == 8  # latents and indexer keys of layers 2, 8, 14, 20
+
+
+# ---------------------------------------------------------------------------
+# Suspected change 1: full-attention group lookup (not needed)
+# ---------------------------------------------------------------------------
+
+
+def test_worker_groups_hide_full_attention_from_isinstance(
+    ds41_worker_config,
+) -> None:
+    """The worker-side packed groups are all UniformTypeKVCacheSpecs, so an
+    isinstance(FullAttentionSpec) scan over them would find none."""
+    assert not any(
+        isinstance(g.kv_cache_spec, FullAttentionSpec)
+        for g in ds41_worker_config.kv_cache_groups
+    )
+
+
+def test_scheduler_config_unwraps_full_attention_group(ds41_config) -> None:
+    """generate_scheduler_kv_cache_config hands the scheduler each group's
+    scheduler_spec: the compressed group arrives as an MLAAttentionSpec, a
+    FullAttentionSpec subclass, and only that group is full attention."""
+    fa = [
+        i
+        for i, g in enumerate(ds41_config.kv_cache_groups)
+        if isinstance(g.kv_cache_spec, FullAttentionSpec)
+    ]
+    assert len(fa) == 1
+    assert isinstance(
+        ds41_config.kv_cache_groups[fa[0]].kv_cache_spec, MLAAttentionSpec
+    )
+
+
+def test_scheduler_boots_on_ds41_groups_unpatched_lookup(ds41_config) -> None:
+    """SimpleCPUOffloadScheduler builds on the engine's scheduler config with
+    the fork's own isinstance lookup (manager.py:173-178)."""
+    sched = _ds41_scheduler(ds41_config, disk_bytes=1 * GIB)
+    fa_group = ds41_config.kv_cache_groups[sched.fa_gidx]
+    assert is_full_attention_spec(fa_group.kv_cache_spec)
+    assert sched.fa_gidx in sched.prefix_cacheable_group_ids
+    assert sched.fa_block_size == ds41_layout.BLOCK_SIZE
+    assert sched.group_block_sizes.count(ds41_layout.SWA_BLOCK_SIZE) == 15
+    assert sched.cpu_coordinator.prefill_replay_tokens == 128
+
+
+# ---------------------------------------------------------------------------
+# 0831: padded O_DIRECT slots
+# ---------------------------------------------------------------------------
+
+
+def test_disk_slot_bytes() -> None:
+    assert disk_slot_bytes(227840) == PADDED_BLOCK_BYTES
+    assert disk_slot_bytes(227840, use_page_cache=True) == 227840
+    assert disk_slot_bytes(4096) == 4096
+    assert disk_slot_bytes(3 * 512) == 4096
+    # 1,536 bytes of padding a block: 0.67% of the tier
+    assert PADDED_BLOCK_BYTES - 227840 == 1536
+
+
+@pytest.mark.parametrize("gib", [100, 200, 400])
+def test_scheduler_counts_padded_disk_slots(ds41_config, gib: int) -> None:
+    """Scheduler and worker divide the capacity by the same padded slot."""
+    capacity = gib * GIB
+    sched = _ds41_scheduler(ds41_config, disk_bytes=capacity)
+    assert sched.num_cpu_blocks == capacity // PADDED_BLOCK_BYTES
+    # what SimpleCPUOffloadWorker._init_disk_mode computes for the same tier
+    worker_slots = capacity // disk_slot_bytes(227840, use_page_cache=False)
+    assert sched.num_cpu_blocks == worker_slots
+
+
+def test_scheduler_page_cache_slots_stay_unpadded(ds41_config) -> None:
+    capacity = 1 * GIB
+    sched = _ds41_scheduler(ds41_config, disk_bytes=capacity, page_cache=True)
+    assert sched.num_cpu_blocks == capacity // 227840
+
+
+class _HostEvent:
+    """torch.Event stand-in: the emulated copies finish before they return."""
+
+    def record(self, stream=None) -> None:
+        pass
+
+    def synchronize(self) -> None:
+        pass
+
+    def query(self) -> bool:
+        return True
+
+
+def _host_build_params(src_caches, dst_caches, stream, src_access_order=0):
+    assert list(src_caches) == list(dst_caches)
+    src = list(src_caches.values())
+    dst = list(dst_caches.values())
+    bpb = []
+    for s, d in zip(src, dst):
+        s_bpb = s.stride(0) * s.element_size()
+        assert s_bpb == d.stride(0) * d.element_size()
+        bpb.append(s_bpb)
+    return SimpleNamespace(
+        src_bases=[t.data_ptr() for t in src],
+        dst_bases=[t.data_ptr() for t in dst],
+        bpb=bpb,
+        num_layers=len(src),
+    )
+
+
+def _host_copy_blocks(src_ids, dst_ids, params) -> None:
+    """copy_blocks() semantics (base + block_id * bpb) with a host memmove."""
+    for layer in range(params.num_layers):
+        bpb = params.bpb[layer]
+        for s, d in zip(src_ids, dst_ids):
+            ctypes.memmove(
+                params.dst_bases[layer] + d * bpb,
+                params.src_bases[layer] + s * bpb,
+                bpb,
+            )
+
+
+@pytest.fixture
+def host_disk_backend(monkeypatch):
+    """DiskBackend with its CUDA calls replaced by host equivalents."""
+    monkeypatch.setattr(disk_backend_mod, "pin_tensor", lambda t: None)
+    monkeypatch.setattr(disk_backend_mod, "build_params", _host_build_params)
+    monkeypatch.setattr(disk_backend_mod, "copy_blocks", _host_copy_blocks)
+    monkeypatch.setattr(
+        disk_backend_mod,
+        "current_platform",
+        SimpleNamespace(set_device=lambda device: None),
+    )
+    monkeypatch.setattr(torch, "Event", _HostEvent)
+    backends: list[DiskBackend] = []
+
+    def make() -> DiskBackend:
+        backend = DiskBackend()
+        backends.append(backend)
+        return backend
+
+    yield make
+    for backend in backends:
+        backend.shutdown()
+
+
+def _odirect_dir(tmp_path):
+    """A directory on a filesystem that accepts O_DIRECT (tmpfs may not)."""
+    base = os.environ.get("DS41_ODIRECT_DIR")
+    path = tmp_path if base is None else type(tmp_path)(base) / f"t{os.getpid()}"
+    path.mkdir(parents=True, exist_ok=True)
+    probe = path / "probe"
+    try:
+        fd = os.open(probe, os.O_RDWR | os.O_CREAT | os.O_DIRECT, 0o600)
+    except OSError as e:
+        pytest.skip(f"O_DIRECT not supported under {path}: {e}")
+    os.close(fd)
+    probe.unlink()
+    return path
+
+
+@pytest.mark.parametrize("num_buffer_slots", [2, 4])
+def test_padded_odirect_roundtrip_227840_byte_blocks(
+    tmp_path, host_disk_backend, num_buffer_slots: int
+) -> None:
+    """Write 227,840-byte blocks to slots 0, middle and last through O_DIRECT,
+    read them back into a cleared pool and compare every byte."""
+    block = ds41_layout.LIVE_BLOCK_BYTES
+    num_gpu_blocks = 6
+    num_disk_slots = 64
+    gen = torch.Generator().manual_seed(1234)
+    gpu = torch.randint(
+        -128, 127, (num_gpu_blocks, block), dtype=torch.int8, generator=gen
+    )
+    original = gpu.clone()
+    caches = {"packed": gpu}
+    disk_path = _odirect_dir(tmp_path) / "kv-tier.bin"
+    stream = SimpleNamespace(wait_event=lambda event: None, cuda_stream=0)
+
+    backend = host_disk_backend()
+    backend.init(
+        caches,
+        torch.device("cpu"),
+        stream,
+        stream,
+        str(disk_path),
+        num_disk_slots,
+        block,
+        num_buffer_slots=num_buffer_slots,
+        use_page_cache=False,
+    )
+    flags = os.fstat(backend._fd)
+    assert flags.st_size == num_disk_slots * PADDED_BLOCK_BYTES
+    # every staging slot starts on a 4096-byte boundary
+    for slot in range(num_buffer_slots):
+        assert backend._store_buffer[slot].data_ptr() % 4096 == 0
+        assert backend._load_buffer[slot].data_ptr() % 4096 == 0
+        assert [len(v) for v in backend._store_slot_views[slot]] == [PADDED_BLOCK_BYTES]
+
+    gpu_ids = [0, 1, 2, 3, 4]
+    disk_ids = [0, 31, num_disk_slots - 1, 1, 30]  # first, middle, last, neighbours
+    backend._do_store(gpu_ids, disk_ids, stream)
+
+    # The file holds each block at slot * 229,376, followed by zero padding.
+    with open(disk_path, "rb") as raw:
+        for gpu_id, disk_id in zip(gpu_ids, disk_ids):
+            raw.seek(disk_id * PADDED_BLOCK_BYTES)
+            data = raw.read(PADDED_BLOCK_BYTES)
+            assert data[:block] == original[gpu_id].numpy().tobytes()
+            assert data[block:] == bytes(PADDED_BLOCK_BYTES - block)
+
+    gpu.zero_()
+    backend._do_load(disk_ids, gpu_ids, stream)
+    assert torch.equal(gpu[: len(gpu_ids)], original[: len(gpu_ids)])
+    assert torch.count_nonzero(gpu[len(gpu_ids) :]) == 0
+
