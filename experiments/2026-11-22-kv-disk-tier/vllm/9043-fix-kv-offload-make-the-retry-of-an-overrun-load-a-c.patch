diff --git a/vllm/v1/simple_kv_offload/manager.py b/vllm/v1/simple_kv_offload/manager.py
index ff28b7cd0..cfc9374c3 100644
--- a/vllm/v1/simple_kv_offload/manager.py
+++ b/vllm/v1/simple_kv_offload/manager.py
@@ -303,6 +303,12 @@ class SimpleCPUOffloadScheduler:
         # still made progress (an overrun, not a fault): their failed
         # requests do not degrade the tier. Forgotten with the event.
         self._overrun_load_events: set[int] = set()
+        # Requests whose load overran: the core scheduler retries such a
+        # request from 0 tokens, and the same lookup would find the same hit
+        # and start the same slow load, without end while the slow path
+        # lasts. Their later lookups miss, so the retry is a cold prefill and
+        # each request overruns at most once. Forgotten in request_finished.
+        self._overrun_reqs: set[str] = set()
 
     @staticmethod
     def _derive_cpu_config(
@@ -392,6 +398,9 @@ class SimpleCPUOffloadScheduler:
 
         if request.skip_reading_prefix_cache or self.degraded:
             return 0, False
+        if request.request_id in self._overrun_reqs:
+            # This request's load overran once: recompute, do not load again.
+            return 0, False
 
         if num_computed_tokens % self.block_size != 0:
             # Transfers are whole-block copies, so an external suffix cannot
@@ -1107,6 +1116,9 @@ class SimpleCPUOffloadScheduler:
         # A load abandoned at its total bound is a miss for its requests
         # only; any other failed load degrades the tier.
         unexplained = [r for r in failed_recving if not self._is_overrun(r)]
+        for req_id in failed_recving:
+            if self._is_overrun(req_id):
+                self._overrun_reqs.add(req_id)
         now = time.monotonic()
         for req_id in list(connector_output.finished_recving or []):
             if req_id in self._reqs_to_load:
@@ -1362,6 +1374,7 @@ class SimpleCPUOffloadScheduler:
         """Always returns (False, None). GPU blocks are protected by ref_cnt,
         so the scheduler can free blocks immediately."""
         req_id = request.request_id
+        self._overrun_reqs.discard(req_id)
 
         # Release any temp CPU hit pin from get_num_new_matched_tokens()
         # if request is canceled or preempted before update_state_after_alloc()
