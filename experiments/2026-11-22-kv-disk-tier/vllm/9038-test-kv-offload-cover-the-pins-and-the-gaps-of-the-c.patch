From 04caf710f11cf0cae455f6b176b688f7b8f7e88e Mon Sep 17 00:00:00 2001
From: nuk3s <44327449+nuk3s@users.noreply.github.com>
Date: Sun, 22 Nov 2026 23:43:35 +0000
Subject: [PATCH] test(kv-offload): cover the pins and the gaps of the chain
 refresh

Upstream base: the patch applies to local-inference-lab/vllm at
19f2c20ed4d64ae22bd009ceacadd85e2a81e354 after the 702 patches of
spark-ds41f-1120 (candidate-62, 0001 to 0829) and patches 9030 to 9037
of this series.

Rationale: two mutations of the code of 9037 passed all 170 tests. One
reinserted pinned blocks into the free queue, which would let a store
take a slot that a running load still reads, and the other walked on
past the first missing block. This patch adds two tests of _refresh_chain
on the real KVCacheManager and SimpleCPUOffloadScheduler with the DS41
layout. The first checks that a disk load in flight keeps its pins,
reference counts, and hashes through a refresh of the same chain and
through a fill past capacity after the refresh. The second checks that
a chain with a missing full-attention block moves only the run before
the gap, and that the blocks behind the gap keep their order and their
place ahead of it.

Quality implications: the patch adds tests only.

Tests: on the CPU path the offload suite passed 172 tests, with 2
CUDA-only modules skipped, and each of the two mutations fails exactly
one of the new tests. The pin test is adapted from a review probe.

Upstream status: the patch is proposed to spark-ds41f in
experiments/2026-11-22-kv-disk-tier and has not been submitted to
local-inference-lab/vllm.
---
 .../test_ds41_tier_eviction.py                | 71 +++++++++++++++++++
 1 file changed, 71 insertions(+)

diff --git a/tests/v1/simple_kv_offload/test_ds41_tier_eviction.py b/tests/v1/simple_kv_offload/test_ds41_tier_eviction.py
index a1d3738e4..775c02c07 100644
--- a/tests/v1/simple_kv_offload/test_ds41_tier_eviction.py
+++ b/tests/v1/simple_kv_offload/test_ds41_tier_eviction.py
@@ -312,3 +312,74 @@ def test_degraded_tier_releases_a_waiting_finished_request():
     assert conn._reqs_to_store == {}
     assert not conn._pending_finished_stores
     assert not conn._in_flight_store_gpu_blocks
+
+
+def test_refresh_keeps_the_pins_of_a_load_in_flight():
+    # From the review of 0837 (2026-11-22): a disk load in flight pins its
+    # tier blocks; a refresh of the same chain by another request's finish,
+    # and a fill past capacity after it, must leave the pins, the reference
+    # counts and the hashes alone. Without the pins a store could take a slot
+    # that the load still reads.
+    t = Tier(slots=440)
+    s = toks(8192)
+    t.session(s)
+    t.reset_gpu()
+    mgr, conn = t.mgr, t.conn
+    b = _req(s + toks(512), "Bdisk")
+    eblocks, n0, _ = mgr.get_computed_blocks(b)
+    assert n0 == 0
+    ext, _ = conn.get_num_new_matched_tokens(b, 0)
+    assert ext > 0
+    assert (
+        mgr.allocate_slots(
+            b,
+            0,
+            num_new_computed_tokens=0,
+            new_computed_blocks=eblocks,
+            num_external_computed_tokens=ext,
+            delay_cache_blocks=True,
+        )
+        is not None
+    )
+    conn.update_state_after_alloc(b, mgr.get_blocks("Bdisk"), ext)
+    pool = conn.cpu_block_pool
+    pinned = [pool.blocks[c] for c in conn._reqs_to_load["Bdisk"].transfer_meta.cpu_block_ids]
+    assert pinned and all(blk.ref_cnt > 0 for blk in pinned)
+    hashes = {blk.block_id: blk.block_hash for blk in pinned}
+    refs = {blk.block_id: blk.ref_cnt for blk in pinned}
+    assert conn._refresh_chain(_req(s, "other")) > 0
+    free_ids = {x.block_id for x in pool.free_block_queue.get_all_free_blocks()}
+    assert not free_ids & set(hashes)
+    assert {blk.block_id: blk.ref_cnt for blk in pinned} == refs
+    for _ in range(3):
+        t.session(toks(8192))
+    for blk in pinned:
+        assert blk.ref_cnt > 0 and blk.block_hash == hashes[blk.block_id]
+
+
+def test_blocks_behind_a_gap_keep_their_place():
+    # A chain with a missing full-attention block: only the run before the
+    # gap moves to the recent end; the blocks behind the gap keep their order
+    # and their place ahead of it, so they age out first.
+    t = Tier(slots=2048)
+    s = toks(8192)
+    t.session(s)
+    t.session(toks(4096))  # newer blocks behind S's chain in the queue
+    conn = t.conn
+    pool = conn.cpu_block_pool
+    r = _req(s, "probe")
+    fa = resolve_block_hashes(r.block_hashes, HB, conn.fa_block_size)
+    gap = len(fa) // 2
+    hole = pool.get_cached_block(fa[gap], [conn.fa_gidx])[0]
+    assert pool._maybe_evict_cached_block(hole)
+    behind = {
+        pool.get_cached_block(h, [conn.fa_gidx])[0].block_id for h in fa[gap + 1 :]
+    }
+    assert len(behind) == len(fa) - gap - 1
+    before = [b.block_id for b in pool.free_block_queue.get_all_free_blocks()]
+    moved = conn._refresh_chain(_req(s, "again"))
+    after = [b.block_id for b in pool.free_block_queue.get_all_free_blocks()]
+    assert 0 < moved < t.resident(s)
+    assert t.usable(s) == gap * conn.fa_block_size
+    assert not behind & set(after[-moved:])
+    assert [x for x in after if x in behind] == [x for x in before if x in behind]
