diff --git a/tests/v1/simple_kv_offload/test_ds41_tier_faults.py b/tests/v1/simple_kv_offload/test_ds41_tier_faults.py
index dc5bc95af..659156475 100644
--- a/tests/v1/simple_kv_offload/test_ds41_tier_faults.py
+++ b/tests/v1/simple_kv_offload/test_ds41_tier_faults.py
@@ -443,3 +443,136 @@ def test_prometheus_series_names() -> None:
     a = metrics.SimpleCPUOffloadStats(data={"loads": 2, "degraded": 0})
     b = metrics.SimpleCPUOffloadStats(data={"loads": 1, "io_errors": 1, "degraded": 1})
