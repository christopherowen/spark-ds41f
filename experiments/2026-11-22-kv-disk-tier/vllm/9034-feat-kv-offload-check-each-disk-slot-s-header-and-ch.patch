+# ---------------------------------------------------------------------------
+# 0834: slot header (slot id, generation, checksum) in the slot padding
+# ---------------------------------------------------------------------------
+
+
+@pytest.fixture
+def sealed(tmp_path, host_cuda):
+    """A worker whose backend writes and checks slot headers."""
+    made = []
+
+    def make(checksum: str = "crc32"):
+        gen = torch.Generator().manual_seed(7)
+        gpu = torch.randint(-128, 127, (6, BLOCK), dtype=torch.int8, generator=gen)
+        worker = SimpleCPUOffloadWorker(
+            vllm_config=MagicMock(),
+            kv_cache_config=None,
+            cpu_capacity_bytes=0,
+            kv_offload_backend="disk",
+            disk_path=str(tmp_path / "unused"),
+            disk_capacity_bytes=SLOTS * 229376,
+            disk_checksum=checksum,
+        )
+        stream = _HostStream()
+        backend = DiskBackend()
+        path = _odirect_dir(tmp_path) / f"sealed.rank_{len(made)}"
+        backend.init(
+            {"packed": gpu},
+            torch.device("cpu"),
+            stream,
+            stream,
+            str(path),
+            SLOTS,
+            BLOCK,
+            checksum=checksum,
+        )
+        worker._backend = backend
+        worker.load_stream = worker.store_stream = stream
+        made.append(worker)
+        return worker, gpu, path
+
+    yield make
+    for worker in made:
+        worker._backend.shutdown()
+
+
+def _flip(path, offset) -> None:
+    with open(path, "r+b") as f:
+        f.seek(offset)
+        byte = f.read(1)
+        f.seek(offset)
+        f.write(bytes([byte[0] ^ 0x01]))
+
+
+@pytest.mark.parametrize("checksum", ["crc32", "sum64"])
+def test_sealed_slot_roundtrip(sealed, checksum) -> None:
+    worker, gpu, path = sealed(checksum)
+    want = gpu[:2].clone()
+    _stored(worker, [0, 1], [3, 15])
+    with open(path, "rb") as f:
+        f.seek(3 * 229376 + BLOCK)
+        assert f.read(4) == b"KVT1"
+    gpu[:2].zero_()
+    _load(worker, [3, 15], [0, 1], event=0)
+    res = _poll(worker, lambda r: r.finished_recving)
+    assert res.finished_recving == {"r1"} and not res.failed_recving
+    assert torch.equal(gpu[:2], want)
+
+
+@pytest.mark.parametrize("where", ["data", "header"])
+def test_flipped_byte_is_a_fault_not_wrong_state(sealed, where) -> None:
+    worker, gpu, path = sealed()
+    _stored(worker, [0], [5])
+    _flip(path, 5 * 229376 + (BLOCK // 2 if where == "data" else BLOCK + 20))
+    gpu[4].zero_()
+    _load(worker, [5], [4], event=0)
+    res = _poll(worker, lambda r: r.finished_recving)
+    assert res.failed_recving == {"r1"}
+    fault = worker._backend.fault
+    assert (fault.op, fault.slot, fault.errno) == ("load", 5, errno.EBADMSG)
+    assert torch.count_nonzero(gpu[4]) == 0  # verified before any DMA
+
+
+def test_stale_slot_content_is_a_fault(sealed) -> None:
+    """A write that never reached the disk leaves the previous generation:
+    a valid checksum, the wrong generation."""
+    worker, gpu, path = sealed()
+    _stored(worker, [0], [8])
+    with open(path, "rb") as f:
+        f.seek(8 * 229376)
+        old = f.read(229376)
+    worker._pending_store_event_indices.clear()
+    _store(worker, [1], [8], event=1)
+    deadline = time.monotonic() + 5
+    while 1 in worker._pending_store_event_indices:
+        worker.get_transfer_results(set())
+        assert time.monotonic() < deadline
+    with open(path, "r+b") as f:
+        f.seek(8 * 229376)
+        f.write(old)  # the lost write
+    _load(worker, [8], [5], event=0)
+    res = _poll(worker, lambda r: r.finished_recving)
+    assert res.failed_recving == {"r1"}
+    assert "generation 1, expected 2" in worker._backend.fault.message
+
+
+def test_never_written_slot_is_a_fault(sealed) -> None:
+    worker, gpu, path = sealed()
+    _load(worker, [9], [5], event=0)
+    res = _poll(worker, lambda r: r.finished_recving)
+    assert res.failed_recving == {"r1"}
+    assert "no slot header" in worker._backend.fault.message
+
+
+def test_no_room_for_header_turns_checks_off(tmp_path, host_cuda) -> None:
+    gpu = torch.zeros((2, 4096), dtype=torch.int8)
+    stream = _HostStream()
+    backend = DiskBackend()
+    backend.init(
+        {"k": gpu},
+        torch.device("cpu"),
+        stream,
+        stream,
+        str(_odirect_dir(tmp_path) / "aligned"),
+        4,
+        4096,
+        checksum="crc32",
+    )
+    try:
+        assert backend._checksum_kind == 0
+    finally:
+        backend.shutdown()
