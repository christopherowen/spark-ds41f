+def test_overrun_on_one_rank_is_a_miss_and_keeps_the_tier() -> None:
+    """Rank 1 abandons r2's load at its total bound (no fault), ranks 0 and
+    2 load it: the aggregator releases r2 as failed when all three ranks have
+    reported, the scheduler counts a load failure and keeps the tier up. A
+    failed load with no overrun report still degrades it
+    (test_failed_load_without_fault_record_still_degrades)."""
+    from tests.v1.simple_kv_offload.test_ds41_tier_faults import (
+        _rank_output,
+        _scheduler_with_pending_load,
+    )
+    from vllm.distributed.kv_transfer.kv_connector.utils import KVOutputAggregator
+    from vllm.v1.request import Request
+
+    fix, req, req2 = _scheduler_with_pending_load()
+    sched = fix.scheduler
+    (event,) = sched._load_event_time
+    agg = KVOutputAggregator(expected_finished_count=3)
+    overrun = SimpleCPUOffloadWorkerMetadata(
+        completed_store_events={}, overrun_load_events={event}
+    )
+    step1 = agg.aggregate(
+        [_rank_output(["r2"]), _rank_output(["r2"], ["r2"], overrun), _rank_output()]
+    )
+    sched.update_connector_output(step1.kv_connector_output)
+    step2 = agg.aggregate([_rank_output(), _rank_output(), _rank_output(["r2"])])
+    out2 = step2.kv_connector_output
+    assert out2.finished_recving == {"r2"} and out2.failed_recving == {"r2"}
+    sched.update_connector_output(out2)
+    assert not sched.degraded
+    assert "r2" not in sched._reqs_to_load
+    assert sched._overrun_load_events == set()  # forgotten with the event
+    stats = sched.get_stats()
+    assert stats["load_failures"] == 1 and stats["degraded"] == 0
+    assert "io_errors" not in stats
+    req3 = Request(
+        request_id="r3",
+        prompt_token_ids=req.prompt_token_ids,
+        sampling_params=req.sampling_params,
+        pooling_params=None,
+        mm_features=None,
+        block_hasher=req._block_hasher,
+    )
+    hit, _ = sched.get_num_new_matched_tokens(req3, 0)
+    assert hit == 32  # the tier still answers
+
+
+def test_overrun_events_aggregate_over_ranks() -> None:
