+@pytest.mark.parametrize("key", ["disk_io_timeout_s", "disk_io_slot_budget_s"])
+@pytest.mark.parametrize("value", [math.nan, math.inf, 0.0, -1.0])
+def test_bounds_must_be_finite_and_positive(key, value) -> None:
+    """NaN and infinity would turn the bound off: NaN <= 0 is False, and so is
