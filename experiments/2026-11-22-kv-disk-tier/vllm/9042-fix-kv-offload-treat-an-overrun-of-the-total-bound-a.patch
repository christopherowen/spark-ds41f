+def _poll_all(worker, reqs, timeout_s=10.0, seen=None):
+    """Poll until every request finished; returns the failed ones. ``seen``,
+    when given, gets (time.monotonic(), the backend's fault) for each request
+    at the poll that finished it."""
     finished, failed = set(), set()
     deadline = time.monotonic() + timeout_s
     while finished != reqs:
         assert time.monotonic() < deadline, f"finished {finished} of {reqs}"
         res = worker.get_transfer_results(set())
+        if seen is not None:
+            for r in res.finished_recving - finished:
+                seen[r] = (time.monotonic(), worker._backend.fault)
         finished |= res.finished_recving
         failed |= res.failed_recving
