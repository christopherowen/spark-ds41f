+def test_hang_after_an_overrun_is_a_fault(tier, monkeypatch) -> None:
+    """A load of 4 slots: reads 1 and 2 take 0.1 s, read 3 hangs. The load
+    runs past its total bound (0.3 + 4 x 0.02 = 0.38 s) first and fails as a
+    miss with no fault; its thread is still blocked in read 3, so the load
+    queued behind it would wait for that read. The progress check covers the
+    abandoned load: 0.3 s after read 2 it is a fault, and the queued load
+    fails at once with no I/O."""
+    worker, gpu = tier(timeout_s=0.3, slot_budget_s=0.02)
+    _stored(worker, [0, 1, 2, 3], [0, 1, 2, 3])
+    real = os.preadv
+    calls = {"n": 0}
+    release = threading.Event()
+
+    def slow_then_hang(fd, bufs, offset):
+        calls["n"] += 1
+        if calls["n"] == 3:
+            release.wait(10)
+        else:
+            time.sleep(0.1)
+        return real(fd, bufs, offset)
+
+    monkeypatch.setattr(os, "preadv", slow_then_hang)
+    seen: dict = {}
+    start = time.monotonic()
+    reqs = _submit_loads(worker, [([0, 1, 2, 3], [0, 1, 2, 3]), ([0], [4])])
+    try:
+        failed = _poll_all(worker, reqs, timeout_s=5, seen=seen)
+    finally:
+        release.set()
     assert failed == reqs
-    assert 0.54 <= waited < 0.54 + 0.3
-    fault = worker._backend.fault
-    assert (fault.op, fault.errno) == ("load", errno.ETIMEDOUT)
-    assert "ran past its 0.54 s bound (0.3 s + 12 slots x 0.02 s)" in fault.message
+    at0, fault0 = seen["r0"]
+    at1, fault1 = seen["r1"]
+    assert 0.38 <= at0 - start < 0.5 and fault0 is None  # the overrun: a miss
+    assert 0.5 <= at1 - start < 0.5 + 0.3  # the hang: a fault
+    assert (fault1.op, fault1.slot, fault1.errno) == ("load", 2, errno.ETIMEDOUT)
+    assert "load event 0 made no progress for 0.3 s" in fault1.message
+    assert calls["n"] == 3  # the queued load did no I/O
     time.sleep(0.2)
-    assert calls["n"] < 12  # abandoned before its last read
     assert worker._backend.thread_alive(False)
 
 
