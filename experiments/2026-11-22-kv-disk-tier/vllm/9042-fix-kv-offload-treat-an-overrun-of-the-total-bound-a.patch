+def test_start_line_names_both_bounds(tmp_path, host_cuda, caplog_vllm) -> None:
+    """The worker's [DISK] start line names the timeout and the slot budget,
+    so a boot log shows that the total bound is active (window gate 1)."""
+    gpu = torch.zeros((6, BLOCK), dtype=torch.int8)
+    worker = SimpleCPUOffloadWorker(
+        vllm_config=MagicMock(),
+        kv_cache_config=None,
+        cpu_capacity_bytes=0,
+        kv_offload_backend="disk",
+        disk_path=str(_odirect_dir(tmp_path) / "start"),
+        disk_capacity_bytes=SLOTS * SLOT,
+        disk_io_timeout_s=15.0,
+        disk_io_slot_budget_s=0.02,
+    )
+    worker.load_stream = _HostStream()
+    worker.store_stream = _HostStream()
+    with caplog_vllm.at_level(logging.INFO):
+        worker._init_disk_mode({"packed": gpu}, BLOCK, torch.device("cpu"))
+    try:
+        assert (
+            "SimpleCPUOffloadWorker [DISK]: disk_io_timeout_s=15 (no progress: a "
+            "fault), disk_io_slot_budget_s=0.02 (past the total bound: a miss)"
+        ) in caplog_vllm.text
+    finally:
+        worker._backend.shutdown()
+
