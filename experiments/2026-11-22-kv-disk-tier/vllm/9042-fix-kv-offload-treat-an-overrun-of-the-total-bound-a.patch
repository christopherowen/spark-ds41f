+def test_overrun_drains_the_late_copies(tmp_path, monkeypatch) -> None:
+    """A load of 8 slots at 0.1 s a read, with copies that run 0.2 s late on
+    the load stream (2 staging slots). The load progresses (a slot at least
+    every 0.2 s, under the 0.3 s timeout) but runs past its total bound of
+    0.3 + 8 x 0.02 = 0.46 s with the copies of slots 2 and 3 in flight. The
+    overrun abandons it with no fault; the drain waits for those copies
+    before the request is released. The blocks then go to another request (a
+    sentinel); no later copy of the load may change them."""
+    monkeypatch.setattr(disk_backend_mod, "pin_tensor", lambda t: None)
+    monkeypatch.setattr(disk_backend_mod, "build_params", _deferred_build_params)
+    monkeypatch.setattr(disk_backend_mod, "copy_blocks", _deferred_copy_blocks)
+    monkeypatch.setattr(
+        disk_backend_mod,
+        "current_platform",
+        SimpleNamespace(set_device=lambda device: None),
+    )
+    monkeypatch.setattr(torch, "Event", _DeferredEvent)
+    monkeypatch.setattr(torch.cuda, "current_stream", lambda: _HostStream())
+    monkeypatch.delenv(DEBUG_READ_DELAY_ENV, raising=False)
+
+    gen = torch.Generator().manual_seed(9)
+    gpu = torch.randint(-128, 127, (16, BLOCK), dtype=torch.int8, generator=gen)
+    load_stream = _DeferredStream(delay_s=0.2)
+    store_stream = _HostStream()
+    worker = SimpleCPUOffloadWorker(
+        vllm_config=MagicMock(),
+        kv_cache_config=None,
+        cpu_capacity_bytes=0,
+        kv_offload_backend="disk",
+        disk_path=str(tmp_path / "unused"),
+        disk_capacity_bytes=SLOTS * SLOT,
+        disk_io_timeout_s=0.3,
+        disk_io_slot_budget_s=0.02,
+    )
+    backend = DiskBackend()
+    backend.init(
+        {"packed": gpu},
+        torch.device("cpu"),
+        load_stream,
+        store_stream,
+        str(_odirect_dir(tmp_path) / "overrun.rank_0"),
+        SLOTS,
+        BLOCK,
+        checksum="crc32",
+    )
+    worker._backend = backend
+    worker.load_stream = load_stream
+    worker.store_stream = store_stream
+    try:
+        _stored(worker, list(range(8)), list(range(8)))
+        calls = _slow_reads(monkeypatch, seconds=0.1)
+        seen: dict = {}
+        start = time.monotonic()
+        reqs = _submit_loads(worker, [(list(range(8)), list(range(8, 16)))])
+        assert _poll_all(worker, reqs, seen=seen) == reqs
+        released, fault = seen["r0"]
+        assert fault is None  # an overrun, not a fault
+        # released only after the copies in flight at the overrun landed
+        assert released - start >= 0.65
+        for i in range(3):
+            assert torch.equal(gpu[8 + i], gpu[i])
+        # the blocks now belong to another request
+        gpu[8:16].fill_(7)
+        deadline = time.monotonic() + 5
+        while backend.running(False) is not None:
+            assert time.monotonic() < deadline
+            time.sleep(0.01)
+        time.sleep(0.5)
+        assert torch.all(gpu[8:16] == 7)
+        assert calls["n"] < 8
+        assert backend.fault is None and backend.thread_alive(False)
+    finally:
+        backend.shutdown()
+        load_stream.close()
+
+
