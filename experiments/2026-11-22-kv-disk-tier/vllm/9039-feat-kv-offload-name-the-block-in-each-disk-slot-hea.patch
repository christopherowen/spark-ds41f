+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Each disk slot names the block it holds (CPU-only).
+
+Every store writes the block key (disk_backend.slot_key of the block hash)
+into the slot header, and every load sends the key that the scheduler took at
+its lookup. A slot rewritten for another block between the lookup and the load
+passes the generation check (the rank's latest store to the slot) but fails
+the key check: the load is a fault, a miss on all ranks, and the tier degrades.
+"""
+
+from __future__ import annotations
+
+import errno
+import time
+from unittest.mock import MagicMock
+
+import pytest
+import torch
+
+from tests.v1.simple_kv_offload import ds41_layout
+from tests.v1.simple_kv_offload.test_ds41_offload import _odirect_dir
+from tests.v1.simple_kv_offload.test_ds41_tier_faults import (  # noqa: F401
+    _HostStream,
+    _load,
+    _poll,
+    _rank_output,
+    host_cuda,
+    sealed,
+)
+from tests.v1.simple_kv_offload.test_scheduler import (
+    _BYTES_PER_BLOCK,
+    SchedulerFixture,
+    _alloc_and_register,
+    _make_kv_cache_config,
+    _make_vllm_config,
+    BLOCK_SIZE,
+    make_request,
+    make_scheduler_output,
+)
+from vllm.distributed.kv_transfer.kv_connector.utils import KVOutputAggregator
+from vllm.v1.core.block_pool import BlockPool
+from vllm.v1.core.kv_cache_manager import KVCacheBlocks
+from vllm.v1.outputs import KVConnectorOutput
+from vllm.v1.request import Request
+from vllm.v1.simple_kv_offload.disk_backend import DiskBackend, slot_key
+from vllm.v1.simple_kv_offload.manager import SimpleCPUOffloadScheduler
+from vllm.v1.simple_kv_offload.metadata import SimpleCPUOffloadWorkerMetadata
+from vllm.v1.simple_kv_offload.worker import SimpleCPUOffloadWorker
+
+pytestmark = pytest.mark.skip_global_cleanup
+
+BLOCK = ds41_layout.LIVE_BLOCK_BYTES
+SLOT = 229376
+SLOTS = 16
+GPU_BLOCKS = 16
+
+
+def _wait_store(worker, event) -> None:
+    deadline = time.monotonic() + 5
+    while event in worker._pending_store_event_indices:
+        worker.get_transfer_results(set())
+        assert time.monotonic() < deadline
+        time.sleep(0.01)
+
+
+def test_slot_key_separates_groups_and_blocks() -> None:
+    # A 256-token block's hash starts with the 128-token hash at the same
+    # position; the group id is the last 4 bytes. An 8-byte prefix would match.
+    h0 = bytes(range(32))
+    h1 = bytes(range(32, 64))
+    big = h0 + h1 + (7).to_bytes(4, "big")
+    small = h0 + (0).to_bytes(4, "big")
+    other_group = h0 + h1 + (6).to_bytes(4, "big")
+    assert big[:8] == small[:8]
+    keys = {slot_key(big), slot_key(small), slot_key(other_group)}
+    assert len(keys) == 3 and 0 not in keys
+    assert slot_key(None) == 0
+    assert slot_key(big) == slot_key(bytes(big))  # stable for equal hashes
+
+
+def test_slot_rewritten_for_another_block_is_a_fault(sealed) -> None:
+    """Block A stored, then block B into the same slot (the rank's latest
+    store, so the generation matches); a load that expects A fails before any
+    copy to the GPU."""
+    worker, gpu, path = sealed()
+    key_a, key_b = 0x1111, 0x2222
+    worker._backend.launch_copy([0], [8], True, 0, worker._store_events, keys=[key_a])
+    worker._pending_store_event_indices.add(0)
+    _wait_store(worker, 0)
+    worker._backend.launch_copy([1], [8], True, 1, worker._store_events, keys=[key_b])
+    worker._pending_store_event_indices.add(1)
+    _wait_store(worker, 1)
+    gpu[4].zero_()
+    worker.bind_connector_metadata(_load_meta(slots=[8], gpu_ids=[4], keys=[key_a]))
+    worker.start_load_kv()
+    res = _poll(worker, lambda r: r.finished_recving)
+    assert res.finished_recving == {"r1"} and res.failed_recving == {"r1"}
+    fault = worker._backend.fault
+    assert (fault.op, fault.slot, fault.errno) == ("load", 8, errno.EBADMSG)
+    assert f"block key {key_b:016x}, expected {key_a:016x}" in fault.message
+    assert torch.count_nonzero(gpu[4]) == 0  # checked before any DMA
+
+
+def test_matching_key_loads(sealed) -> None:
+    worker, gpu, path = sealed()
+    want = gpu[2].clone()
+    worker._backend.launch_copy([2], [11], True, 0, worker._store_events, keys=[77])
+    worker._pending_store_event_indices.add(0)
+    _wait_store(worker, 0)
+    gpu[2].zero_()
+    worker.bind_connector_metadata(_load_meta(slots=[11], gpu_ids=[2], keys=[77]))
+    worker.start_load_kv()
+    res = _poll(worker, lambda r: r.finished_recving)
+    assert res.finished_recving == {"r1"} and not res.failed_recving
+    assert torch.equal(gpu[2], want)
+
+
+def _load_meta(slots, gpu_ids, keys, event=0, req="r1"):
+    from vllm.v1.simple_kv_offload.metadata import SimpleCPUOffloadMetadata
+
+    return SimpleCPUOffloadMetadata(
+        load_event=event,
+        load_gpu_blocks=gpu_ids,
+        load_cpu_blocks=slots,
+        load_keys=keys,
+        load_event_to_reqs={event: [req]},
+    )
+
+
+# ---------------------------------------------------------------------------
+# The scheduler sends the keys: a disk-mode scheduler, one real worker as
+# rank 1, two simulated ranks, the fork's aggregator
+# ---------------------------------------------------------------------------
+
+
+def _disk_scheduler(num_cpu_blocks=8, num_gpu_blocks=GPU_BLOCKS) -> SchedulerFixture:
+    kv_cache_config = _make_kv_cache_config(num_gpu_blocks, 1)
+    vllm_config = _make_vllm_config()
+    sched = SimpleCPUOffloadScheduler(
+        vllm_config=vllm_config,
+        kv_cache_config=kv_cache_config,
+        cpu_capacity_bytes=0,
+        scheduler_block_size=BLOCK_SIZE,
+        hash_block_size=BLOCK_SIZE,
+        lazy_offload=False,
+        disk_capacity_bytes=_BYTES_PER_BLOCK * num_cpu_blocks,
+        disk_use_page_cache=True,  # the scheduler's slot count, unpadded
+    )
+    gpu_block_pool = BlockPool(
+        num_gpu_blocks=num_gpu_blocks, enable_caching=True, hash_block_size=BLOCK_SIZE
+    )
+    sched.bind_gpu_block_pool(gpu_block_pool)
+    return SchedulerFixture(
+        scheduler=sched,
+        gpu_block_pool=gpu_block_pool,
+        vllm_config=vllm_config,
+        kv_cache_config=kv_cache_config,
+        num_groups=1,
+    )
+
+
+@pytest.fixture
+def rank1(tmp_path, host_cuda):  # noqa: F811
+    """A worker on a sealed host-copy DiskBackend with 16 GPU blocks."""
+    gen = torch.Generator().manual_seed(11)
+    gpu = torch.randint(-128, 127, (GPU_BLOCKS, BLOCK), dtype=torch.int8, generator=gen)
+    worker = SimpleCPUOffloadWorker(
+        vllm_config=MagicMock(),
+        kv_cache_config=None,
+        cpu_capacity_bytes=0,
+        kv_offload_backend="disk",
+        disk_path=str(tmp_path / "unused"),
+        disk_capacity_bytes=SLOTS * SLOT,
+    )
+    stream = _HostStream()
+    backend = DiskBackend()
+    backend.init(
+        {"packed": gpu},
+        torch.device("cpu"),
+        stream,
+        stream,
+        str(_odirect_dir(tmp_path) / "keys.rank_1"),
+        SLOTS,
+        BLOCK,
+        checksum="crc32",
+    )
+    worker._backend = backend
+    worker.load_stream = worker.store_stream = stream
+    worker._rank = 1
+    yield worker, gpu
+    backend.shutdown()
+
+
+def _run_store(worker, meta) -> None:
+    worker.bind_connector_metadata(meta)
+    worker.wait_for_save()
+    worker._connector_metadata = None
+    _wait_store(worker, meta.store_event)
+    done = worker.build_connector_worker_meta()
+    assert done.completed_store_events == {meta.store_event: 1}
+    assert not done.failed_store_events
+
+
+def test_rewrite_between_lookup_and_load_is_a_miss_on_all_ranks(rank1) -> None:
+    worker, gpu = rank1
+    fix = _disk_scheduler()
+    sched = fix.scheduler
+    sched._expected_worker_count = 3
+
+    # Request A computes 2 blocks; the scheduler stores them with their keys.
+    req = make_request(num_blocks=2)
+    kv_blocks = _alloc_and_register(fix, req, 2)
+    sched.update_state_after_alloc(req, kv_blocks, num_external_tokens=0)
+    meta = sched.build_connector_meta(
+        make_scheduler_output(
+            {req.request_id: 32}, new_reqs={req.request_id: kv_blocks.get_block_ids()}
+        )
+    )
+    hashes = [fix.gpu_block_pool.blocks[b].block_hash for b in meta.store_gpu_blocks]
+    assert meta.store_keys == [slot_key(h) for h in hashes]
+    assert len(set(meta.store_keys)) == 2 and 0 not in meta.store_keys
+    _run_store(worker, meta)
+    sched.update_connector_output(
+        KVConnectorOutput(
+            kv_connector_worker_meta=SimpleCPUOffloadWorkerMetadata(
+                completed_store_events={meta.store_event: 3}
+            )
+        )
+    )
+    slots = list(meta.store_cpu_blocks)
+
+    # Request B, same prompt: the lookup hits both slots and takes their keys.
+    req2 = Request(
+        request_id="r2",
+        prompt_token_ids=req.prompt_token_ids,
+        sampling_params=req.sampling_params,
+        pooling_params=None,
+        mm_features=None,
+        block_hasher=req._block_hasher,
+    )
+    hit, is_async = sched.get_num_new_matched_tokens(req2, 0)
+    assert (hit, is_async) == (32, True)
+
+    # Between the lookup and the load the second slot is rewritten for
+    # another block (as a pin bug would let a store take it): a different
+    # GPU block, the key of another request's block hash, on rank 1.
+    other = make_request(num_blocks=1)
+    other_gpu = _alloc_and_register(fix, other, 1).get_block_ids()[0][0]
+    other_key = slot_key(fix.gpu_block_pool.blocks[other_gpu].block_hash)
+    assert other_key not in meta.store_keys
+    worker._backend.launch_copy(
+        [15], [slots[1]], True, 100, worker._store_events, keys=[other_key]
+    )
+    worker._pending_store_event_indices.add(100)
+    _wait_store(worker, 100)
+    worker._completed_store_events.clear()
+
+    blocks2 = KVCacheBlocks(blocks=(fix.gpu_block_pool.get_new_blocks(2),))
+    sched.update_state_after_alloc(req2, blocks2, num_external_tokens=hit)
+    load_meta = sched.build_connector_meta(
+        make_scheduler_output({"r2": 1}, new_reqs={"r2": blocks2.get_block_ids()})
+    )
+    assert load_meta.load_cpu_blocks == slots
+    assert load_meta.load_keys == meta.store_keys  # the keys of the lookup
+    dst = load_meta.load_gpu_blocks
+    for b in dst:
+        gpu[b].zero_()
+    worker.bind_connector_metadata(load_meta)
+    worker.start_load_kv()
+    res = _poll(worker, lambda r: r.finished_recving)
+    assert res.finished_recving == {"r2"} and res.failed_recving == {"r2"}
+    fault = worker._backend.fault
+    assert (fault.op, fault.slot, fault.errno) == ("load", slots[1], errno.EBADMSG)
+    assert "block key" in fault.message
+    assert torch.equal(gpu[dst[0]], gpu[meta.store_gpu_blocks[0]])  # slot 1 of 2
+    assert torch.count_nonzero(gpu[dst[1]]) == 0  # the rewritten slot: no DMA
+
+    # Ranks 0 and 2 loaded fine; rank 1 failed: a miss for the request.
+    agg = KVOutputAggregator(expected_finished_count=3)
+    out = agg.aggregate(
+        [
+            _rank_output(["r2"]),
+            _rank_output(["r2"], ["r2"], worker.build_connector_worker_meta()),
+            _rank_output(["r2"]),
+        ]
+    ).kv_connector_output
+    assert out.finished_recving == {"r2"} and out.failed_recving == {"r2"}
+    sched.update_connector_output(out)
+    assert sched.degraded
+    assert "r2" not in sched._reqs_to_load
+    assert sched.get_num_new_matched_tokens(req2, 0) == (0, False)
+    stats = sched.get_stats()
+    assert stats["load_failures"] == 1 and stats["io_errors"] == 1
+    assert stats["degraded"] == 1
+
+
+def test_cpu_mode_sends_no_keys() -> None:
+    from tests.v1.simple_kv_offload.test_scheduler import make_scheduler
+
+    fix = make_scheduler(num_cpu_blocks=8, num_gpu_blocks=16)
+    sched = fix.scheduler
+    req = make_request(num_blocks=2)
+    kv_blocks = _alloc_and_register(fix, req, 2)
+    sched.update_state_after_alloc(req, kv_blocks, num_external_tokens=0)
+    meta = sched.build_connector_meta(
+        make_scheduler_output(
+            {req.request_id: 32}, new_reqs={req.request_id: kv_blocks.get_block_ids()}
+        )
+    )
+    assert meta.store_gpu_blocks and meta.store_keys == []
