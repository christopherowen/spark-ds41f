+
+    def _maybe_cleanup_finished_store(self, req_id: str) -> None:
+        """Clean up a finished request whose queued finish-time store was
+        dropped (degraded tier) and that has no other store in flight."""
+        state = self._reqs_to_store.get(req_id)
+        if (
+            state is not None
+            and state.finished
+            and not state.store_events
+            and not any(t.req_id == req_id for t in self._pending_finished_stores)
+        ):
+            self._cleanup_store_request(req_id)
+
+    def _refresh_chain(self, request: "Request") -> int:
+        """Move a finished request's reachable chain to the recent end of the
+        offload LRU, tail first; return the number of blocks moved.
+
+        ``free_blocks`` evicts the first block it is given first, and stores
+        free their blocks in prefix order over many events, so without this a
+        full tier evicts the start of each session first and strands the rest
+        of it: no lookup can reach a block behind a missing one. Here the
+        chain's blocks are freed again ordered by their end position,
+        descending: eviction then takes a session from its tail, every
+        remaining prefix stays a hit, and a prefix shared by later requests
+        is refreshed by each of them. A request whose prefix hit in the GPU
+        pool refreshes the disk copy of that prefix too.
+
+        Only blocks that a lookup can reach are moved: the full-attention
+        group's run up to its first missing block, and in the other
+        prefix-cacheable groups the cached blocks that end at or before that
+        run. Blocks behind a gap stay where they are and age out first.
+        Blocks pinned by a load in flight keep their pin; they rejoin the
+        queue when the load releases them.
+        """
+        pool = self.cpu_block_pool
+        hashes = request.block_hashes
+        fa_size = self.fa_block_size
+        fa_hashes = resolve_block_hashes(hashes, self.hash_block_size, fa_size)
+        chain: list[tuple[int, KVCacheBlock]] = []
+        for i in range(len(fa_hashes)):
+            hit = pool.get_cached_block(fa_hashes[i], [self.fa_gidx])
+            if hit is None:
+                break
+            chain.append(((i + 1) * fa_size, hit[0]))
+        reach = len(chain) * fa_size
+        if reach == 0:
+            return 0
+        for g in sorted(self.prefix_cacheable_group_ids):
+            if g == self.fa_gidx:
+                continue
+            if not self.cpu_coordinator.single_type_managers[
+                g
+            ].has_positionally_stable_blocks:
+                continue
+            g_size = self.group_block_sizes[g]
+            g_hashes = resolve_block_hashes(hashes, self.hash_block_size, g_size)
+            for i in range(min(len(g_hashes), reach // g_size)):
+                hit = pool.get_cached_block(g_hashes[i], [g])
+                if hit is not None:
+                    chain.append(((i + 1) * g_size, hit[0]))
+        # Tail first: the first block freed is the first evicted.
+        chain.sort(key=lambda entry: entry[0], reverse=True)
+        seen: set[int] = set()
+        blocks: list[KVCacheBlock] = []
+        for _, blk in chain:
+            if blk.block_id not in seen:
+                seen.add(blk.block_id)
+                blocks.append(blk)
+        pool.touch(blocks)
+        pool.free_blocks(blocks)
+        return len(blocks)
 
     def take_events(self) -> Iterable[KVCacheEvent]:
         events = self.cpu_block_pool.take_events()
