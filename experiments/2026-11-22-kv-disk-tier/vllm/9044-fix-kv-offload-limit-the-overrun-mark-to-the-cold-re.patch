+def test_policy_fail_keeps_no_mark(tmp_path) -> None:
+    """Under kv_load_failure_policy "fail" (the vLLM default) the core
+    scheduler ends each failed request with an error before the connector
+    sees the failed load. Five overruns in a row leave no mark."""
+    sched, mgr = _sched(tmp_path, policy="fail")
+    agg = KVOutputAggregator(expected_finished_count=3)
+    _seed_tier(sched, mgr, agg)
+    for k in range(5):
+        rid = f"F{k}"
+        b, so, ev = _start_load(sched, rid)
+        _step(sched, agg, so, [_done(rid), _overrun(ev, rid), _done(rid)])
+        assert b.status == RequestStatus.FINISHED_ERROR
+        assert rid not in sched.requests
+    assert mgr._overrun_reqs == set()
+    assert not mgr.degraded
+
