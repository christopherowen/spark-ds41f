+def test_abort_before_any_rank_reports_keeps_no_mark(tmp_path) -> None:
+    """The abort comes before any rank reports; the overrun of rank 1 and the
+    loads of ranks 0 and 2 arrive in one step afterwards. No mark stays."""
+    sched, mgr = _sched(tmp_path)
+    agg = KVOutputAggregator(expected_finished_count=3)
+    _seed_tier(sched, mgr, agg)
+    b, so, ev = _start_load(sched, "B")
+    sched.finish_requests("B", RequestStatus.FINISHED_ABORTED)
+    _step(sched, agg, so, [_done("B"), _overrun(ev, "B"), _done("B")])
+    so = sched.schedule()
+    _step(sched, agg, so, _empty3())
