+def test_preempted_after_the_cold_retry_hits_the_tier_again(tmp_path) -> None:
+    """After the cold retry the request decodes; a preemption then frees the
+    blocks of the request and the GPU prefix goes. The resumed request hits
+    the tier again, as a new request with the same prompt does: the mark
+    covered the retry only."""
+    sched, mgr = _sched(tmp_path)
+    agg = KVOutputAggregator(expected_finished_count=3)
+    _seed_tier(sched, mgr, agg)
+    b, so, ev = _start_load(sched, "B", max_tokens=50)
+    _step(sched, agg, so, [_done("B"), _overrun(ev, "B"), _done("B")])
+    so = sched.schedule()
+    assert so.num_scheduled_tokens == {"B": NUM_TOKENS}
+    _step(sched, agg, so, _empty3())
+    for _ in range(3):
+        so = sched.schedule()
+        _step(sched, agg, so, _empty3())
+    assert b.status == RequestStatus.RUNNING
+    sched.running.remove(b)
+    sched._preempt_request(b, 0.0)
+    assert sched.kv_cache_manager.reset_prefix_cache()
+    c = _req("C")
+    hit_c = mgr.get_num_new_matched_tokens(c, 0)
+    mgr.request_finished(c, [])
+    hit_b = mgr.get_num_new_matched_tokens(b, 0)
+    # The tier holds the 4 prompt blocks. C recomputes the last prompt token,
+    # so C takes 3 blocks; B has decoded tokens after the prompt and takes 4.
+    assert hit_c == (48, True)
+    assert hit_b == (64, True)
