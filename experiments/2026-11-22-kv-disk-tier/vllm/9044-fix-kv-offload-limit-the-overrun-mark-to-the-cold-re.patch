+
+
+# ---------------------------------------------------------------------------
+# The life of the mark, and the reports of one rank
+# ---------------------------------------------------------------------------
+
+
+def test_request_finished_during_the_load_keeps_no_overrun_mark() -> None:
+    """r2 finishes (a client abort) while the load is in flight, so
+    request_finished defers the load cleanup; the load then overruns on rank
+    1. No mark stays: no request_finished call comes after the failed load,
+    and the request gets no retry."""
+    fix, req, req2 = _scheduler_with_pending_load()
+    sched = fix.scheduler
+    agg = KVOutputAggregator(expected_finished_count=3)
+    sched.request_finished(req2, [])
+    assert sched._reqs_to_load["r2"].finished
+    _overrun_on_rank_1(sched, agg, "r2")
+    assert "r2" not in sched._reqs_to_load
+    assert sched._overrun_reqs == set()
+    assert not sched.degraded
+    assert sched.get_stats()["load_failures"] == 1
+
+
+def test_request_finished_after_a_reset_keeps_no_overrun_mark() -> None:
+    """A reset moves the in-flight load of r2 to the abandoned loads; r2 then
+    finishes and the load overruns on rank 1. The abandoned state is marked
+    finished too, so no mark stays."""
+    fix, req, req2 = _scheduler_with_pending_load()
+    sched = fix.scheduler
+    agg = KVOutputAggregator(expected_finished_count=3)
+    sched.reset()
+    assert "r2" in sched._abandoned_reqs_to_load
+    sched.request_finished(req2, [])
+    assert sched._abandoned_reqs_to_load["r2"].finished
+    event = sched._abandoned_reqs_to_load["r2"].load_event
+    overrun = SimpleCPUOffloadWorkerMetadata(
+        completed_store_events={}, overrun_load_events={event}
+    )
+    out = agg.aggregate(
+        [
+            _rank_output(["r2"]),
+            _rank_output(["r2"], ["r2"], overrun),
+            _rank_output(["r2"]),
+        ]
+    ).kv_connector_output
+    assert out.failed_recving == {"r2"}
+    sched.update_connector_output(out)
+    assert "r2" not in sched._abandoned_reqs_to_load
+    assert sched._overrun_reqs == set()
+    assert not sched.degraded
+
+
+def test_two_requests_in_one_overrun_event_both_retry_cold(caplog) -> None:
+    """r4 and r5, admitted in one step, share one load event, which overruns
+    on rank 1. Both retries miss; the tier stays up; the head logs the
+    overrun once, as a cache miss for the requests of the event."""
+    fix, req, req2 = _scheduler_with_pending_load()
+    sched = fix.scheduler
+    agg = KVOutputAggregator(expected_finished_count=3)
+    _overrun_on_rank_1(sched, agg, "r2")
+    rs, blocks_by = [], {}
+    for rid in ("r4", "r5"):
+        r = _same_prompt(req, rid)
+        hit, _ = sched.get_num_new_matched_tokens(r, 0)
+        assert hit == 32
+        blocks = KVCacheBlocks(blocks=(fix.gpu_block_pool.get_new_blocks(2),))
+        sched.update_state_after_alloc(r, blocks, num_external_tokens=hit)
+        blocks_by[rid] = blocks
+        rs.append(r)
+    meta = sched.build_connector_meta(
+        make_scheduler_output(
+            {"r4": 1, "r5": 1},
+            new_reqs={rid: b.get_block_ids() for rid, b in blocks_by.items()},
+        )
+    )
+    event = meta.load_event
+    assert sched._load_event_to_reqs[event] == ["r4", "r5"]
+    overrun = SimpleCPUOffloadWorkerMetadata(
+        completed_store_events={}, overrun_load_events={event}
+    )
+    both = ["r4", "r5"]
+    out = agg.aggregate(
+        [_rank_output(both), _rank_output(both, both, overrun), _rank_output(both)]
+    ).kv_connector_output
+    with caplog.at_level(logging.WARNING):
+        caplog.clear()
+        sched.update_connector_output(out)
+    lines = [r.getMessage() for r in caplog.records if "ran past" in r.getMessage()]
+    want = (
+        f"SimpleCPUOffload disk load event {event} ran past the total bound on a "
+        "rank: a cache miss for the requests of the event; the tier stays up"
+    )
+    assert lines == [want]
+    assert not sched.degraded
+    assert sched._overrun_reqs == {"r2", "r4", "r5"}
+    for r in rs:
+        assert sched.get_num_new_matched_tokens(r, 0) == (0, False), r.request_id
+
+
+def test_retry_with_a_local_prefix_still_misses() -> None:
+    """The core scheduler passes the block-aligned local hit to the lookup,
+    which is above 0 when the retry finds a GPU prefix. A new request with 16
+    local tokens gets an external hit; the retry of an overrun request with
+    the same 16 local tokens gets none."""
+    fix, req, req2 = _scheduler_with_pending_load()
+    sched = fix.scheduler
+    agg = KVOutputAggregator(expected_finished_count=3)
+    fresh = _same_prompt(req, "r7")
+    hit, is_async = sched.get_num_new_matched_tokens(fresh, 16)
+    sched.request_finished(fresh, [])
+    assert hit and hit > 0 and is_async
+    _overrun_on_rank_1(sched, agg, "r2")
+    assert sched.get_num_new_matched_tokens(req2, 16) == (0, False)
+
+
+def test_admission_of_the_cold_retry_ends_the_mark() -> None:
+    """r2 overruns; the retry's lookup misses and the retry is admitted with
+    no external tokens, which ends the mark. After a preemption the request
+    hits the tier again, as a new request with the same prompt does."""
+    fix, req, req2 = _scheduler_with_pending_load()
+    sched = fix.scheduler
+    agg = KVOutputAggregator(expected_finished_count=3)
+    _overrun_on_rank_1(sched, agg, "r2")
+    assert sched.get_num_new_matched_tokens(req2, 0) == (0, False)
+    assert sched._overrun_reqs == {"r2"}  # a lookup alone keeps the mark
+    blocks = KVCacheBlocks(blocks=(fix.gpu_block_pool.get_new_blocks(2),))
+    sched.update_state_after_alloc(req2, blocks, num_external_tokens=0)
+    assert sched._overrun_reqs == set()
+    fix.gpu_block_pool.free_blocks(blocks.blocks[0])
+    assert sched.get_num_new_matched_tokens(req2, 0) == (32, True)
+
+
+def test_overrun_load_is_reported_once_per_rank(tier, monkeypatch) -> None:
+    """KVOutputAggregator counts reports, not ranks, so a second report of
+    one load by one rank would release the request while another rank still
+    copies. r0 (12 slots at 0.1 s a read) overruns at 0.3 + 12 x 0.02 =
+    0.54 s with r1 queued behind r0: the rank reports each load finished
+    once, also while the abandoned load is still under I/O."""
+    worker, gpu = tier(timeout_s=0.3, slot_budget_s=0.02)
+    _stored(worker, [0, 1, 2, 3], [0, 1, 2, 3])
+    _slow_reads(monkeypatch, seconds=0.1)
+    slots = [0, 1, 2, 3] * 3
+    reqs = _submit_loads(worker, [(slots, slots), ([0], [4])])
+    reports = {r: 0 for r in reqs}
+    deadline = time.monotonic() + 3
+    while time.monotonic() < deadline:
+        res = worker.get_transfer_results(set())
+        for r in res.finished_recving & reqs:
+            reports[r] += 1
+        time.sleep(0.01)
+    assert reports == {"r0": 1, "r1": 1}
+    assert worker._backend.fault is None
+
+
+def test_overrun_reaches_the_scheduler_in_the_step_of_the_failure(
+    tier, monkeypatch
+) -> None:
+    """The step that reports the overrun load failed builds worker metadata
+    that names the overrun event, also with no store completed in that step:
+    without the event, the scheduler would see a failed load with no
+    explanation and degrade the tier."""
+    worker, gpu = tier(timeout_s=0.3, slot_budget_s=0.02)
+    _stored(worker, [0, 1, 2, 3], [0, 1, 2, 3])
+    worker.build_connector_worker_meta()  # drop any record of the setup's store
+    _slow_reads(monkeypatch, seconds=0.1)
+    slots = [0, 1, 2, 3] * 3
+    reqs = _submit_loads(worker, [(slots, slots)])
+    deadline = time.monotonic() + 5
+    while True:
+        assert time.monotonic() < deadline
+        res = worker.get_transfer_results(set())
+        meta = worker.build_connector_worker_meta()
+        if res.finished_recving:
+            assert res.failed_recving == reqs
+            assert meta is not None and meta.overrun_load_events == {0}
+            assert meta.completed_store_events == {} and meta.faults == []
+            break
+        assert meta is None
+        time.sleep(0.01)
+
+
+def test_backend_forgets_an_abandoned_event(tier, monkeypatch) -> None:
+    """Two loads overrun one after the other (12 slots at 0.1 s a read, a
+    0.54 s bound each). The worker reports each one at the abandon; once the
+    IO thread is done with both events, the backend holds no abandon mark and
+    no failure mark of either."""
+    worker, gpu = tier(timeout_s=0.3, slot_budget_s=0.02)
+    _stored(worker, [0, 1, 2, 3], [0, 1, 2, 3])
+    _slow_reads(monkeypatch, seconds=0.1)
+    slots = [0, 1, 2, 3] * 3
+    reqs = _submit_loads(worker, [(slots, slots), (slots, slots)])
+    failed: set = set()
+    deadline = time.monotonic() + 10
+    while failed != reqs:
+        assert time.monotonic() < deadline
+        failed |= worker.get_transfer_results(set()).failed_recving
+        time.sleep(0.01)
+    backend = worker._backend
+    while backend.running(False) is not None:
+        assert time.monotonic() < deadline
+        time.sleep(0.01)
+    assert backend.fault is None
+    assert backend._abandoned[False] == set()
+    assert backend._failed_events[False] == set()
diff --git a/tests/v1/simple_kv_offload/test_ds41_tier_overrun_core.py b/tests/v1/simple_kv_offload/test_ds41_tier_overrun_core.py
new file mode 100644
index 000000000..17dfee88b
--- /dev/null
+++ b/tests/v1/simple_kv_offload/test_ds41_tier_overrun_core.py
@@ -0,0 +1,248 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""An overrun load through the core scheduler (CPU-only).
+
+A real v1 Scheduler drives a real SimpleCPUOffloadConnector in disk mode
+(scheduler side only); three ranks are simulated through KVOutputAggregator.
+The core scheduler decides when request_finished runs: at an abort while the
+load is in flight, or, under kv_load_failure_policy "fail", before the
+connector sees the failed load. In both orders no overrun mark may stay
+behind. The cold retry of an overrun request computes the whole prompt with
+no second load, and after the admission of that retry a preemption may hit
+the tier again.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from tests.v1.kv_connector.unit.utils import create_scheduler, create_vllm_config
+from tests.v1.simple_kv_offload.test_scheduler import (
+    _BYTES_PER_BLOCK,
+    BLOCK_SIZE,
+    _make_kv_cache_config,
+)
+from vllm import SamplingParams
+from vllm.distributed.kv_transfer.kv_connector.utils import KVOutputAggregator
+from vllm.utils.hashing import sha256
+from vllm.v1.core.kv_cache_utils import get_request_block_hasher
+from vllm.v1.outputs import KVConnectorOutput, ModelRunnerOutput
+from vllm.v1.request import Request, RequestStatus
+from vllm.v1.simple_kv_offload.metadata import SimpleCPUOffloadWorkerMetadata
+
+pytestmark = pytest.mark.skip_global_cleanup
+
+NUM_GPU_BLOCKS = 64
+NUM_TOKENS = 64  # 4 blocks of 16
+PROMPT = list(range(1000, 1000 + NUM_TOKENS))
+
+
+def _sched(tmp_path, policy="recompute"):
+    vllm_config = create_vllm_config(
+        kv_connector="SimpleCPUOffloadConnector",
+        kv_role="kv_both",
+        kv_connector_extra_config={
+            "cpu_bytes_to_use": _BYTES_PER_BLOCK * 32,
+            "kv_offload_backend": "disk",
+            "disk_path": str(tmp_path / "tier"),
+            "disk_capacity_bytes": 32 * 8192,
+        },
+        kv_load_failure_policy=policy,
+        block_size=BLOCK_SIZE,
+        max_num_batched_tokens=1024,
+    )
+    sched = create_scheduler(
+        vllm_config, NUM_GPU_BLOCKS, _make_kv_cache_config(NUM_GPU_BLOCKS)
+    )
+    mgr = sched.connector.scheduler_manager
+    assert mgr._slot_keys
+    mgr._expected_worker_count = 3
+    return sched, mgr
+
+
+def _req(rid, max_tokens=1):
+    sp = SamplingParams(max_tokens=max_tokens, ignore_eos=True)
+    sp.update_from_generation_config({}, 2)
+    return Request(
+        request_id=rid,
+        prompt_token_ids=list(PROMPT),
+        sampling_params=sp,
+        pooling_params=None,
+        mm_features=None,
+        block_hasher=get_request_block_hasher(BLOCK_SIZE, sha256),
+    )
+
+
+def _step(sched, agg, sched_out, per_rank):
+    """Feed one step's output; per_rank holds one KVConnectorOutput a rank."""
+    ids = list(sched_out.num_scheduled_tokens)
+    outs = [
+        ModelRunnerOutput(
+            req_ids=ids,
+            req_id_to_index={r: i for i, r in enumerate(ids)},
+            sampled_token_ids=[[7] for _ in ids],
+            logprobs=None,
+            prompt_logprobs_dict={},
+            pooler_output=None,
+            kv_connector_output=kv,
+        )
+        for kv in per_rank
+    ]
+    return sched.update_from_output(sched_out, agg.aggregate(outs))
+
+
+def _empty3():
+    return [KVConnectorOutput(), KVConnectorOutput(), KVConnectorOutput()]
+
+
+def _seed_tier(sched, mgr, agg):
+    """One request computes PROMPT and finishes, the finish-time store lands
+    on all three ranks, and the GPU prefix cache is dropped: the next request
+    with PROMPT can only hit on the disk tier."""
+    a = _req("seed")
+    sched.add_request(a)
+    so = sched.schedule()
+    assert so.num_scheduled_tokens == {"seed": NUM_TOKENS}
+    _step(sched, agg, so, _empty3())
+    assert a.is_finished()
+    for _ in range(3):
+        so = sched.schedule()
+        ev = so.kv_connector_metadata.store_event
+        if ev >= 0:
+            break
+    assert ev >= 0
+    done = SimpleCPUOffloadWorkerMetadata(completed_store_events={ev: 1})
+    _step(sched, agg, so, [KVConnectorOutput(kv_connector_worker_meta=done)] * 3)
+    assert not mgr._store_event_to_blocks
+    assert sched.kv_cache_manager.reset_prefix_cache()
+
+
+def _start_load(sched, rid, max_tokens=1):
+    """A request with PROMPT: a disk hit, so the request waits for the load."""
+    b = _req(rid, max_tokens=max_tokens)
+    sched.add_request(b)
+    so = sched.schedule()
+    assert b.status == RequestStatus.WAITING_FOR_REMOTE_KVS
+    meta = so.kv_connector_metadata
+    assert meta.load_event >= 0 and meta.load_event_to_reqs[meta.load_event] == [rid]
+    return b, so, meta.load_event
+
+
+def _overrun(event, rid):
+    """The report of rank 1 for a load past the total bound: finished and
+    failed, with the event in the worker metadata of the same step."""
+    return KVConnectorOutput(
+        finished_recving={rid},
+        failed_recving={rid},
+        kv_connector_worker_meta=SimpleCPUOffloadWorkerMetadata(
+            completed_store_events={}, overrun_load_events={event}
+        ),
+    )
+
+
+def _done(rid):
+    return KVConnectorOutput(finished_recving={rid})
+
+
+def test_retry_is_cold_through_the_core_scheduler(tmp_path) -> None:
+    """Rank 1 reports the overrun in one step, ranks 0 and 2 finish the load
+    in the next. The retry computes all 64 tokens with no second load, the
+    tier stays up, and nothing of the request stays after the finish."""
+    sched, mgr = _sched(tmp_path)
+    agg = KVOutputAggregator(expected_finished_count=3)
+    _seed_tier(sched, mgr, agg)
+    b, so, ev = _start_load(sched, "B")
+    _step(sched, agg, so, [KVConnectorOutput(), _overrun(ev, "B"), KVConnectorOutput()])
+    assert ev in mgr._overrun_load_events and "B" not in mgr._overrun_reqs
+    so = sched.schedule()
+    assert b.status == RequestStatus.WAITING_FOR_REMOTE_KVS
+    _step(sched, agg, so, [_done("B"), KVConnectorOutput(), _done("B")])
+    assert mgr._overrun_reqs == {"B"}
+    so = sched.schedule()
+    assert so.num_scheduled_tokens.get("B") == NUM_TOKENS
+    assert so.kv_connector_metadata.load_event == -1
+    assert mgr._overrun_reqs == set()  # the cold retry is admitted
+    _step(sched, agg, so, _empty3())
+    assert b.is_finished() and not mgr.degraded
+    assert mgr._overrun_reqs == set() and not mgr._reqs_to_load
+
+
+def test_abort_during_the_overrun_load_keeps_no_mark(tmp_path) -> None:
+    """Rank 1 reports the overrun; the client goes away before ranks 0 and 2
+    report. The core scheduler calls request_finished at the abort, before
+    the aggregated failure reaches the connector; no mark stays."""
