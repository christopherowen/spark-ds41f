+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Disk faults of the SimpleCPUOffloadConnector tier never hang a request and
+never serve wrong state (CPU-only).
+
+The worker runs on a real DiskBackend with a real O_DIRECT file; only the CUDA
+batch copy is replaced by a host memmove (test_ds41_offload's harness). Faults
+are injected into preadv/pwritev. The scheduler side runs the fork's
+KVOutputAggregator over three simulated ranks.
+"""
+
+from __future__ import annotations
+
+import copy
+import errno
+import logging
+import os
+import threading
+import time
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+import torch
+
+from tests.v1.simple_kv_offload import ds41_layout
+from tests.v1.simple_kv_offload.test_ds41_offload import (
+    _host_build_params,
+    _host_copy_blocks,
+    _HostEvent,
+    _odirect_dir,
+)
+from tests.v1.simple_kv_offload.test_scheduler import (
+    _alloc_and_register,
+    make_request,
+    make_scheduler,
+    make_scheduler_output,
+)
+from vllm.distributed.kv_transfer.kv_connector.utils import KVOutputAggregator
+from vllm.v1.core.kv_cache_manager import KVCacheBlocks
+from vllm.v1.outputs import EMPTY_MODEL_RUNNER_OUTPUT, KVConnectorOutput
+from vllm.v1.request import Request
+from vllm.v1.simple_kv_offload import disk_backend as disk_backend_mod
+from vllm.v1.simple_kv_offload.disk_backend import DiskBackend
+from vllm.v1.simple_kv_offload.metadata import (
+    SimpleCPUOffloadMetadata,
+    SimpleCPUOffloadWorkerMetadata,
+)
+from vllm.v1.simple_kv_offload.worker import SimpleCPUOffloadWorker
+
+pytestmark = pytest.mark.skip_global_cleanup
+
+BLOCK = ds41_layout.LIVE_BLOCK_BYTES
+SLOTS = 16
+
+
+class _HostStream:
+    cuda_stream = 0
+
+    def wait_event(self, event) -> None:
+        pass
+
+    def synchronize(self) -> None:
+        pass
+
+
+@pytest.fixture
+def host_cuda(monkeypatch):
+    monkeypatch.setattr(disk_backend_mod, "pin_tensor", lambda t: None)
+    monkeypatch.setattr(disk_backend_mod, "build_params", _host_build_params)
+    monkeypatch.setattr(disk_backend_mod, "copy_blocks", _host_copy_blocks)
+    monkeypatch.setattr(
+        disk_backend_mod,
+        "current_platform",
+        SimpleNamespace(set_device=lambda device: None),
+    )
+    monkeypatch.setattr(torch, "Event", _HostEvent)
+    monkeypatch.setattr(torch.cuda, "current_stream", lambda: _HostStream())
+
+
+@pytest.fixture
+def tier(tmp_path, host_cuda):
+    """A worker in disk mode on a host-copy DiskBackend; 6 GPU blocks."""
+    made = []
+
+    def make(timeout_s: float = 15.0):
+        gen = torch.Generator().manual_seed(42)
+        gpu = torch.randint(-128, 127, (6, BLOCK), dtype=torch.int8, generator=gen)
+        worker = SimpleCPUOffloadWorker(
+            vllm_config=MagicMock(),
+            kv_cache_config=None,
+            cpu_capacity_bytes=0,
+            kv_offload_backend="disk",
+            disk_path=str(_odirect_dir(tmp_path) / "tier"),
+            disk_capacity_bytes=SLOTS * 229376,
+            disk_io_timeout_s=timeout_s,
+        )
+        stream = _HostStream()
+        backend = DiskBackend()
+        backend.init(
+            {"packed": gpu},
+            torch.device("cpu"),
+            stream,
+            stream,
+            str(_odirect_dir(tmp_path) / f"tier.rank_{len(made)}"),
+            SLOTS,
+            BLOCK,
+        )
+        worker._backend = backend
+        worker.load_stream = stream
+        worker.store_stream = stream
+        worker._rank = 1
+        made.append(worker)
+        return worker, gpu
+
+    yield make
+    for worker in made:
+        worker._backend.shutdown()
+
+
+def _store(worker, gpu_ids, slots, event=0):
+    worker.bind_connector_metadata(
+        SimpleCPUOffloadMetadata(
+            store_event=event, store_gpu_blocks=gpu_ids, store_cpu_blocks=slots
+        )
+    )
+    worker.wait_for_save()
+    worker._connector_metadata = None
+
+
+def _load(worker, slots, gpu_ids, event, req="r1"):
+    worker.bind_connector_metadata(
+        SimpleCPUOffloadMetadata(
+            load_event=event,
+            load_gpu_blocks=gpu_ids,
+            load_cpu_blocks=slots,
+            load_event_to_reqs={event: [req]},
+        )
+    )
+    worker.start_load_kv()
+
+
+def _poll(worker, until, timeout_s=10.0):
+    """get_transfer_results every 10 ms (an engine step), with the metadata
+    of the in-flight load bound, until ``until(results)``; returns results."""
+    deadline = time.monotonic() + timeout_s
+    while time.monotonic() < deadline:
+        results = worker.get_transfer_results(set())
+        if until(results):
+            return results
+        time.sleep(0.01)
+    raise AssertionError("no result before the deadline")
+
+
+def _stored(worker, gpu_ids, slots):
+    _store(worker, gpu_ids, slots)
+    deadline = time.monotonic() + 5
+    while 0 in worker._pending_store_event_indices:
+        worker.get_transfer_results(set())
+        assert time.monotonic() < deadline
+        time.sleep(0.01)
+    meta = worker.build_connector_worker_meta()
+    assert meta.completed_store_events == {0: 1} and not meta.failed_store_events
+
+
+def _inject(monkeypatch, name, fault):
+    """Replace os.preadv or os.pwritev for the next call only."""
+    real = getattr(os, name)
+    calls = {"n": 0}
+
+    def wrapped(fd, bufs, offset):
+        calls["n"] += 1
+        if calls["n"] == 1:
+            return fault(real, fd, bufs, offset)
+        return real(fd, bufs, offset)
+
+    monkeypatch.setattr(os, name, wrapped)
+    return calls
+
+
+def _eio(real, fd, bufs, offset):
+    raise OSError(errno.EIO, "Input/output error (injected)")
+
+
+# ---------------------------------------------------------------------------
+# Worker: each fault fails the load or store, never hangs, degrades the rank
+# ---------------------------------------------------------------------------
+
+
+def test_read_eio_fails_load_as_miss_and_degrades(tier, monkeypatch) -> None:
+    worker, gpu = tier()
+    _stored(worker, [0, 1, 2], [3, 4, 5])
+    calls = _inject(monkeypatch, "preadv", _eio)
+    _load(worker, [3, 4, 5], [3, 4, 5], event=0)
+    res = _poll(worker, lambda r: r.finished_recving)
+    assert res.finished_recving == {"r1"} and res.failed_recving == {"r1"}
+    fault = worker._backend.fault
+    assert (fault.op, fault.slot, fault.errno) == ("load", 3, errno.EIO)
+    meta = worker.build_connector_worker_meta()
+    assert meta.faults == [(1, "load", 3, errno.EIO, fault.message)]
+    # reported once
+    assert worker.build_connector_worker_meta() is None
+    # degraded: the next load fails at once, with no I/O, on a live thread
+    _load(worker, [4], [4], event=1, req="r2")
+    res = _poll(worker, lambda r: r.finished_recving)
+    assert res.failed_recving == {"r2"}
+    assert calls["n"] == 1
+    assert worker._backend.thread_alive(False)
+
+
+def test_short_read_fails_load(tier, monkeypatch) -> None:
+    worker, gpu = tier()
+    _stored(worker, [0], [7])
+
+    def short(real, fd, bufs, offset):
+        return real(fd, bufs, offset) - 4096
+
+    _inject(monkeypatch, "preadv", short)
+    _load(worker, [7], [5], event=0)
+    res = _poll(worker, lambda r: r.finished_recving)
+    assert res.failed_recving == {"r1"}
+    fault = worker._backend.fault
+    assert fault.errno == errno.EIO and "short read of slot 7" in fault.message
+
+
+def test_write_eio_fails_store_and_drops_it(tier, monkeypatch) -> None:
+    worker, gpu = tier()
+    _inject(monkeypatch, "pwritev", _eio)
+    _store(worker, [0, 1], [2, 9])
+    deadline = time.monotonic() + 5
+    while 0 in worker._pending_store_event_indices:
+        worker.get_transfer_results(set())
+        assert time.monotonic() < deadline
+    meta = worker.build_connector_worker_meta()
+    assert meta.completed_store_events == {0: 1}
+    assert meta.failed_store_events == {0}
+    assert meta.faults[0][1:4] == ("store", 2, errno.EIO)
+
+
+def test_load_thread_killed_mid_load(tier, monkeypatch) -> None:
+    worker, gpu = tier()
+    _stored(worker, [0, 1], [0, 1])
+
+    def die(real, fd, bufs, offset):
+        raise SystemExit  # not an Exception: the load thread ends here
+
+    _inject(monkeypatch, "preadv", die)
+    _load(worker, [0, 1], [4, 5], event=0)
+    res = _poll(worker, lambda r: r.finished_recving)
+    assert not worker._backend.thread_alive(False)
+    assert res.failed_recving == {"r1"}
+    fault = worker._backend.fault
+    assert (fault.op, fault.errno) == ("load", errno.EPIPE)
+
+
+def test_hung_read_is_released_as_miss_within_the_bound(tier, monkeypatch) -> None:
+    """A read that never returns: the request is reported finished and failed
+    at the first poll after disk_io_timeout_s, and the late read copies
+    nothing into the GPU block it was loading."""
+    timeout_s = 0.3
+    worker, gpu = tier(timeout_s=timeout_s)
+    _stored(worker, [0], [6])
+    gpu[5].zero_()
+    release = threading.Event()
+
+    def hang(real, fd, bufs, offset):
+        release.wait(10)
+        return real(fd, bufs, offset)
+
+    _inject(monkeypatch, "preadv", hang)
+    start = time.monotonic()
+    _load(worker, [6], [5], event=0)
+    res = _poll(worker, lambda r: r.finished_recving)
+    waited = time.monotonic() - start
+    assert res.failed_recving == {"r1"}
+    assert timeout_s <= waited < timeout_s + 0.2
+    fault = worker._backend.fault
+    assert (fault.op, fault.slot, fault.errno) == ("load", 6, errno.ETIMEDOUT)
+    release.set()
+    time.sleep(0.2)
+    assert torch.count_nonzero(gpu[5]) == 0  # abandoned: no late copy
+    assert worker._backend.thread_alive(False)
+
+
+# ---------------------------------------------------------------------------
+# Scheduler: three ranks, the fork's aggregator, the degraded state
+# ---------------------------------------------------------------------------
+
+
+def _rank_output(finished=(), failed=(), meta=None):
+    out = copy.copy(EMPTY_MODEL_RUNNER_OUTPUT)
+    out.kv_connector_output = KVConnectorOutput(
+        finished_recving=set(finished) or None,
+        failed_recving=set(failed),
+        kv_connector_worker_meta=meta,
+    )
+    return out
+
+
+def _scheduler_with_pending_load():
+    """A cached request, then a second request whose CPU hit is loading."""
+    fix = make_scheduler(num_cpu_blocks=8, num_gpu_blocks=16)
+    sched = fix.scheduler
+    sched._expected_worker_count = 3
+    req = make_request(num_blocks=2)
+    kv_blocks = _alloc_and_register(fix, req, 2)
+    sched.update_state_after_alloc(req, kv_blocks, num_external_tokens=0)
+    meta = sched.build_connector_meta(
+        make_scheduler_output(
+            {req.request_id: 32}, new_reqs={req.request_id: kv_blocks.get_block_ids()}
+        )
+    )
+    done = SimpleCPUOffloadWorkerMetadata(completed_store_events={meta.store_event: 3})
+    sched.update_connector_output(KVConnectorOutput(kv_connector_worker_meta=done))
+    req2 = Request(
+        request_id="r2",
+        prompt_token_ids=req.prompt_token_ids,
+        sampling_params=req.sampling_params,
+        pooling_params=None,
+        mm_features=None,
+        block_hasher=req._block_hasher,
+    )
+    hit, _ = sched.get_num_new_matched_tokens(req2, 0)
+    assert hit == 32
+    blocks2 = KVCacheBlocks(blocks=(fix.gpu_block_pool.get_new_blocks(2),))
+    sched.update_state_after_alloc(req2, blocks2, num_external_tokens=hit)
+    load_meta = sched.build_connector_meta(
+        make_scheduler_output({"r2": 1}, new_reqs={"r2": blocks2.get_block_ids()})
+    )
+    assert load_meta.load_event >= 0
+    return fix, req, req2
+
+
+def test_degraded_reaches_scheduler_from_one_of_three_ranks(caplog) -> None:
+    fix, req, req2 = _scheduler_with_pending_load()
+    sched = fix.scheduler
+    agg = KVOutputAggregator(expected_finished_count=3)
+    fault = (1, "load", 4, errno.EIO, "OSError: read of slot 4")
+    meta1 = SimpleCPUOffloadWorkerMetadata(completed_store_events={}, faults=[fault])
+    # step 1: ranks 0 and 1 finish r2 (rank 1 failed it); rank 2 still loading
+    step1 = agg.aggregate(
+        [_rank_output(["r2"]), _rank_output(["r2"], ["r2"], meta1), _rank_output()]
+    )
+    out1 = step1.kv_connector_output
+    assert not out1.finished_recving and not out1.failed_recving
+    with caplog.at_level(logging.ERROR):
+        sched.update_connector_output(out1)
+    assert sched.degraded  # the fault record arrives before the request
+    # step 2: rank 2 finishes r2 (fine on that rank): released as failed
+    out2 = agg.aggregate([_rank_output(), _rank_output(), _rank_output(["r2"])])
+    out2 = out2.kv_connector_output
+    assert out2.finished_recving == {"r2"} and out2.failed_recving == {"r2"}
+    sched.update_connector_output(out2)
+    assert "r2" not in sched._reqs_to_load
+    lines = [r for r in caplog.records if "degraded" in r.getMessage()]
+    assert len(lines) == 1
+    assert "rank 1 load fault on slot 4, errno 5 (EIO)" in lines[0].getMessage()
+    # every lookup now misses, nothing is stored, and no more log lines
+    req3 = Request(
+        request_id="r3",
+        prompt_token_ids=req.prompt_token_ids,
+        sampling_params=req.sampling_params,
+        pooling_params=None,
+        mm_features=None,
+        block_hasher=req._block_hasher,
+    )
+    with caplog.at_level(logging.DEBUG):
+        caplog.clear()
+        assert sched.get_num_new_matched_tokens(req3, 0) == (0, False)
+        assert sched.prepare_store_specs(make_scheduler_output({}))[0] == []
+    assert not [r for r in caplog.records if r.levelno >= logging.WARNING]
+    stats = sched.get_stats()
+    # the setup's store of 2 blocks, then the fault
+    assert stats == {
+        "stored_blocks": 2,
+        "io_errors": 1,
+        "load_failures": 1,
+        "degraded": 1,
+    }
+    assert sched.get_stats() is None
+
+
+def test_failed_load_without_fault_record_still_degrades() -> None:
+    fix, req, req2 = _scheduler_with_pending_load()
+    sched = fix.scheduler
+    sched.update_connector_output(
+        KVConnectorOutput(finished_recving={"r2"}, failed_recving={"r2"})
+    )
+    assert sched.degraded
+
+
+def test_store_failed_on_one_rank_is_dropped_from_index() -> None:
+    fix = make_scheduler(num_cpu_blocks=8, num_gpu_blocks=16)
+    sched = fix.scheduler
+    sched._expected_worker_count = 3
+    req = make_request(num_blocks=2)
+    kv_blocks = _alloc_and_register(fix, req, 2)
+    sched.update_state_after_alloc(req, kv_blocks, num_external_tokens=0)
+    meta = sched.build_connector_meta(
+        make_scheduler_output(
+            {req.request_id: 32}, new_reqs={req.request_id: kv_blocks.get_block_ids()}
+        )
+    )
+    j = meta.store_event
+    gpu_refs = [fix.gpu_block_pool.blocks[b].ref_cnt for b in meta.store_gpu_blocks]
+    agg = KVOutputAggregator(expected_finished_count=3)
+    ok = SimpleCPUOffloadWorkerMetadata(completed_store_events={j: 1})
+    bad = SimpleCPUOffloadWorkerMetadata(
+        completed_store_events={j: 1},
+        failed_store_events={j},
+        faults=[(2, "store", meta.store_cpu_blocks[0], errno.ENOSPC, "no space")],
+    )
+    out = agg.aggregate(
+        [_rank_output(meta=ok), _rank_output(meta=ok), _rank_output(meta=bad)]
+    )
+    sched.update_connector_output(out.kv_connector_output)
+    assert sched.degraded
+    pool = sched.cpu_block_pool
+    assert all(
+        pool.blocks[b].block_hash is None for b in meta.store_cpu_blocks
+    )  # nothing published
+    assert [fix.gpu_block_pool.blocks[b].ref_cnt for b in meta.store_gpu_blocks] == [
+        r - 1 for r in gpu_refs
+    ]  # the store's GPU refs are released
+    req2 = make_request(num_blocks=2)
+    req2.prompt_token_ids[:] = req.prompt_token_ids
+    assert sched.get_num_new_matched_tokens(req, 0) == (0, False)
+    assert sched.get_stats()["store_failed_blocks"] == 2
+
+
+def test_prometheus_series_names() -> None:
+    from vllm.v1.simple_kv_offload import metrics
+
+    names = sorted(n for n, _ in metrics.COUNTERS.values()) + [metrics.DEGRADED[0]]
+    assert names == [
+        "vllm:kv_offload_disk_io_errors",
+        "vllm:kv_offload_disk_load_failures",
+        "vllm:kv_offload_disk_loads",
+        "vllm:kv_offload_disk_store_failed_blocks",
+        "vllm:kv_offload_disk_stored_blocks",
+        "vllm:kv_offload_disk_degraded",
+    ]
+    a = metrics.SimpleCPUOffloadStats(data={"loads": 2, "degraded": 0})
+    b = metrics.SimpleCPUOffloadStats(data={"loads": 1, "io_errors": 1, "degraded": 1})
+    assert a.aggregate(b).data == {"loads": 3, "io_errors": 1, "degraded": 1}
