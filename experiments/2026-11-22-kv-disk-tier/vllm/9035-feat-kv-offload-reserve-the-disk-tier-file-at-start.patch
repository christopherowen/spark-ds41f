diff --git a/tests/v1/simple_kv_offload/test_ds41_tier_prealloc.py b/tests/v1/simple_kv_offload/test_ds41_tier_prealloc.py
new file mode 100644
index 000000000..29fb71ae5
--- /dev/null
+++ b/tests/v1/simple_kv_offload/test_ds41_tier_prealloc.py
@@ -0,0 +1,105 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The disk tier file is reserved in full at start (posix_fallocate), and a start
+without the space fails at once with a clear error and no file left behind."""
+
+from __future__ import annotations
+
+import errno
+import os
+
+import pytest
+import torch
+
+from tests.v1.simple_kv_offload.test_ds41_offload import _odirect_dir
+from tests.v1.simple_kv_offload.test_ds41_tier_faults import _HostStream
+from vllm.v1.simple_kv_offload import disk_backend as disk_backend_mod
+from vllm.v1.simple_kv_offload.disk_backend import DiskBackend
+
+pytestmark = pytest.mark.skip_global_cleanup
+
+BLOCK = 227840
+SLOT = 229376
+
+
+@pytest.fixture(autouse=True)
+def host_cuda(request):
+    request.getfixturevalue("host_cuda_patch")
+
+
+@pytest.fixture
+def host_cuda_patch(monkeypatch):
+    from types import SimpleNamespace
+
+    from tests.v1.simple_kv_offload.test_ds41_offload import (
+        _host_build_params,
+        _host_copy_blocks,
+        _HostEvent,
+    )
+
+    monkeypatch.setattr(disk_backend_mod, "pin_tensor", lambda t: None)
+    monkeypatch.setattr(disk_backend_mod, "build_params", _host_build_params)
+    monkeypatch.setattr(disk_backend_mod, "copy_blocks", _host_copy_blocks)
+    monkeypatch.setattr(
+        disk_backend_mod,
+        "current_platform",
+        SimpleNamespace(set_device=lambda device: None),
+    )
+    monkeypatch.setattr(torch, "Event", _HostEvent)
+
+
+def _init(path, slots, preallocate):
+    gpu = torch.zeros((2, BLOCK), dtype=torch.int8)
+    backend = DiskBackend()
+    backend.init(
+        {"packed": gpu},
+        torch.device("cpu"),
+        _HostStream(),
+        _HostStream(),
+        str(path),
+        slots,
+        BLOCK,
+        preallocate=preallocate,
+    )
+    return backend
+
+
+@pytest.mark.parametrize("preallocate", [True, False])
+def test_tier_file_reserved_or_sparse(tmp_path, preallocate) -> None:
+    slots = 4096  # 0.88 GiB
+    path = _odirect_dir(tmp_path) / f"tier-{preallocate}"
+    backend = _init(path, slots, preallocate)
+    try:
+        st = os.stat(path)
+        assert st.st_size == slots * SLOT
+        allocated = st.st_blocks * 512
+        if preallocate:
+            assert allocated >= slots * SLOT
+        else:
+            assert allocated < SLOT  # sparse: nothing reserved
+    finally:
+        backend.shutdown()
+
+
+def test_start_without_space_fails_cleanly(tmp_path, monkeypatch) -> None:
+    def no_space(fd, offset, length):
+        raise OSError(errno.ENOSPC, os.strerror(errno.ENOSPC))
+
+    monkeypatch.setattr(os, "posix_fallocate", no_space)
+    path = _odirect_dir(tmp_path) / "tier-full"
+    backend = DiskBackend()
+    with pytest.raises(OSError) as info:
+        backend.init(
+            {"packed": torch.zeros((2, BLOCK), dtype=torch.int8)},
+            torch.device("cpu"),
+            _HostStream(),
+            _HostStream(),
+            str(path),
+            936228,
+            BLOCK,
+            preallocate=True,
+        )
+    assert info.value.errno == errno.ENOSPC
+    assert "cannot reserve 200.00 GiB" in str(info.value)
+    assert not path.exists()  # no partial file left
+    assert backend._fd == -1 and backend._load_thread is None  # no IO threads
