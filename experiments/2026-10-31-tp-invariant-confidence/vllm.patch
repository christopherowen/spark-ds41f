+++ b/tests/kernels/test_deepseek_v41_tilelang_confidence.py
@@ -188,14 +188,21 @@ def test_refuses_other_layouts():
 def test_the_head_runs_its_weight_row():
     """``TileLangConfidenceHead.probability`` reads its projection's [1, H + R]
     weight; its logit path is not available."""
+    from vllm.model_executor.models.qwen3_dspark import DSparkConfidenceHead
+
     head = confidence.TileLangConfidenceHead.__new__(confidence.TileLangConfidenceHead)
     torch.nn.Module.__init__(head)
     hidden, markov, weight = _inputs(5, seed=6)
     head.proj = SimpleNamespace(weight=weight.view(1, -1))
     head.hidden_size, head.markov_rank = HIDDEN, RANK
-    assert torch.equal(
-        head.probability(hidden, markov), _tilelang(hidden, markov, weight)
-    )
+    assert head.tp_invariant is True
+    assert DSparkConfidenceHead.tp_invariant is False
+    want = _tilelang(hidden, markov, weight)
+    assert torch.equal(head.probability(hidden, markov), want)
+    out = torch.empty(5, dtype=torch.float32, device="cuda")
+    returned = head.probability(hidden, markov, out=out)
+    assert returned is out
+    assert torch.equal(out, want)
     with pytest.raises(NotImplementedError):
         head(hidden, markov)
 
diff --git a/tests/v1/spec_decode/test_adaptive_verification.py b/tests/v1/spec_decode/test_adaptive_verification.py
index 110a956ff..d71b8430a 100644
--- a/tests/v1/spec_decode/test_adaptive_verification.py
+++ b/tests/v1/spec_decode/test_adaptive_verification.py
@@ -127,6 +127,73 @@ def test_confidence_snapshot_agrees_before_cpu_and_gpu_budgeting(
     assert local.item() < 0.5  # The caller's proposal confidence is not mutated.
 
 
+@pytest.mark.parametrize(
+    ("tp_invariant_confidence", "rank_order_reduce_scatter", "expected_broadcasts"),
+    [
+        (False, False, 1),
+        (False, True, 1),
+        (True, False, 1),
+        (True, True, 0),
+    ],
+)
+def test_tp_invariant_confidence_elides_broadcast_only_when_rank_ordered(
+    monkeypatch,
+    tp_invariant_confidence,
+    rank_order_reduce_scatter,
+    expected_broadcasts,
+):
+    local = torch.tensor([[0.75]], dtype=torch.float32)
+    manager = make_manager(local.numpy().copy(), row_cost=0.1)
+    manager.tp_invariant_confidence = tp_invariant_confidence
+    manager.req_states.device = torch.device("cpu")
+    manager._confidence_probs = torch.zeros_like(local)
+    manager._pending_resets = []
+    manager._stale_confidences = [
+        SimpleNamespace(
+            np=np.ones((1, 1), dtype=np.float32),
+            gpu=torch.empty_like(local),
+            copy_to_cpu=lambda: None,
+        )
+        for _ in range(2)
+    ]
+    manager._copy_events = [
+        SimpleNamespace(synchronize=lambda: None, record=lambda: None) for _ in range(2)
+    ]
+    manager._copy_stream = SimpleNamespace(wait_stream=lambda _stream: None)
+    calls = []
+
+    def broadcast(tensor, src):
+        assert src == 0
+        calls.append(tensor)
+
+    monkeypatch.setattr(
+        adaptive_module,
+        "get_tp_group",
+        lambda: SimpleNamespace(
+            world_size=2,
+            broadcast=broadcast,
+            device_communicator=SimpleNamespace(
+                rank_order_reduce_scatter=rank_order_reduce_scatter
+            ),
+        ),
+    )
+    monkeypatch.setattr(adaptive_module, "gpu_sync_allowed", nullcontext)
+    monkeypatch.setattr(adaptive_module.torch.cuda, "current_stream", lambda _: None)
+    monkeypatch.setattr(adaptive_module, "stream", lambda *_: nullcontext())
+    monkeypatch.setattr(
+        adaptive_module.tilelang_inputs,
+        "scatter_rows",
+        lambda idx_mapping, source, state, gather=False: state.__setitem__(
+            (idx_mapping, slice(0, source.shape[1])), source
+        ),
+    )
+    batch = SimpleNamespace(num_reqs=1, idx_mapping=torch.tensor([0]))
+    manager.record_confidences(local, batch)
+    assert len(calls) == expected_broadcasts
+    torch.testing.assert_close(manager._confidence_probs, local, rtol=0, atol=0)
+
+
+
 @pytest.mark.parametrize(
     "target_support,varlen_decode,allowed",
     [
