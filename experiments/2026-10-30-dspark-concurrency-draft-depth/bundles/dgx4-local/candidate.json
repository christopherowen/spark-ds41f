{
  "name": "dspark-concurrency-draft-depth",
  "image": "spark-ds41f:1030",
  "workdir": "vllm",
  "verdict": "exit",
  "env": {
    "PYTHONPATH": "/b:/opt/spark-ds41f/candidate/vllm:/opt/spark-ds41f/candidate/b12x"
  },
  "mounts": [
    [
      "tblib_stub.py",
      "/b/tblib_stub.py"
    ],
    [
      "tests/v1/worker/test_dspark_greedy_markov.py",
      "/opt/spark-ds41f/candidate/vllm/tests/v1/worker/test_dspark_greedy_markov.py"
    ],
    [
      "tests/v1/spec_decode/test_dspark_vocab_parallel.py",
      "/opt/spark-ds41f/candidate/vllm/tests/v1/spec_decode/test_dspark_vocab_parallel.py"
    ]
  ],
  "argv": [
    "-m",
    "pytest",
    "-p",
    "no:cacheprovider",
    "-p",
    "tblib_stub",
    "-v",
    "tests/v1/worker/test_dspark_greedy_markov.py",
    "tests/v1/spec_decode/test_dspark_vocab_parallel.py"
  ]
}
