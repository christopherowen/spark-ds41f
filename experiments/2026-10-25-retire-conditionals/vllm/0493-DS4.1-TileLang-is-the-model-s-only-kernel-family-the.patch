-# Student's t (two-sided 95%) by degrees of freedom.
-_T95 = {1: 12.706, 2: 4.303, 3: 3.182, 4: 2.776, 5: 2.571, 6: 2.447, 7: 2.365}
-_T95.update({8: 2.306, 9: 2.262, 11: 2.201, 15: 2.131, 19: 2.093})
