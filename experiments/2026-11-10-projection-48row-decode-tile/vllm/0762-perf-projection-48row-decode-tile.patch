+
+
+def test_decode_48row_tile_selection_and_bit_identity():
+    """Rows 33..48 dispatch to the 48-row decode tile across FP8 decode GEMMs,
+    split-K FP8 partials, and BF16 split-K partials while matching the 64-row
+    tile bit for bit."""
+    from vllm.models.deepseek_v4_1.tilelang.gemm import (
+        decode_tile_rows,
+        split_bucket,
+        split_row_tile,
+    )
+    from vllm.models.deepseek_v4_1.tilelang.linear import PARTIAL_ROW_TILES
+
+    assert DECODE_TILE_ROWS == (16, 32, 48, 64)
+    assert PARTIAL_ROW_TILES == (16, 32, 48, 64)
+    for rows in (33, 36, 42, 48):
+        assert decode_tile_rows(rows) == 48
+        assert split_bucket(rows) == 48
+        assert split_row_tile(rows) == 48
+    for rows in (49, 64):
+        assert decode_tile_rows(rows) == 64
+        assert split_bucket(rows) == 64
+        assert split_row_tile(rows) == 64
