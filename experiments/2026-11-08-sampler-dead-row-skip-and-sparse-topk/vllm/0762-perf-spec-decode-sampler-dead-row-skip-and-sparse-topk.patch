+def test_mask_dead_rows_and_copy_logits_skip_dead_verification_rows():
+    from vllm.v1.worker.gpu import tilelang_inputs
+    from vllm.v1.worker.gpu.sample import tilelang_sampling
+
+    dev = torch.device("cuda")
+    # 3 requests: req 0 (slot 2) has 6 rows with cut=2 (rows 0,1,2 live; 3,4,5 dead)
+    # req 1 (slot 0) has 4 rows with cut=0 (row 6 live; 7,8,9 dead)
+    # req 2 (slot 3) has 6 rows with cut=5 (all 6 rows live: 10..15)
+    expanded_idx_mapping = torch.tensor(
+        [2, 2, 2, 2, 2, 2, 0, 0, 0, 0, 3, 3, 3, 3, 3, 3],
+        dtype=torch.int64,
+        device=dev,
+    )
+    cu_num_logits = torch.tensor([0, 6, 10, 16], dtype=torch.int32, device=dev)
+    dead_row_cut = torch.tensor([2, 0, 5], dtype=torch.int32, device=dev)
+    top_k_gpu = torch.tensor([10, 20, 30, 40], dtype=torch.int32, device=dev)
+    top_p_gpu = torch.tensor([0.5, 0.6, 0.7, 0.8], dtype=torch.float32, device=dev)
+    vocab_size = 256
+
+    live_idx, row_k, row_p = tilelang_inputs.mask_dead_rows(
+        expanded_idx_mapping,
+        cu_num_logits,
+        dead_row_cut,
+        top_k_gpu,
+        top_p_gpu,
+        vocab_size,
+    )
+    expected_live_idx = [2, 2, 2, -1, -1, -1, 0, -1, -1, -1, 3, 3, 3, 3, 3, 3]
+    assert live_idx.tolist() == expected_live_idx
+    assert row_k is not None and row_p is not None
+    expected_k = [
+        30 if m == 2 else (10 if m == 0 else (40 if m == 3 else vocab_size))
+        for m in expected_live_idx
+    ]
+    expected_p = [
+        0.7 if m == 2 else (0.5 if m == 0 else (0.8 if m == 3 else 1.0))
+        for m in expected_live_idx
+    ]
+    assert row_k.tolist() == expected_k
+    torch.testing.assert_close(
+        row_p, torch.tensor(expected_p, dtype=torch.float32, device=dev)
+    )
+
+    # Verify copy_logits with live_idx_mapping copies live rows and ignores NaNs on dead rows.
+    raw = torch.randn((16, vocab_size), dtype=torch.bfloat16, device=dev)
+    raw_with_dead_nans = raw.clone()
+    dead_mask = live_idx < 0
+    raw_with_dead_nans[dead_mask] = float("nan")
+
+    ref_copy = tilelang_sampling.copy_logits(raw)
+    masked_copy = tilelang_sampling.copy_logits(raw_with_dead_nans, live_idx)
+    assert torch.equal(masked_copy[~dead_mask], ref_copy[~dead_mask])
+
