+        markov_embed: torch.Tensor,
+        values: torch.Tensor,
+        index: torch.Tensor,
+    ) -> torch.Tensor:
+        return self.model.markov_head.apply_bias_topk(
+            markov_embed,
+            values,
+            index,
+            self.logits_processor.scale,
+        )
+
