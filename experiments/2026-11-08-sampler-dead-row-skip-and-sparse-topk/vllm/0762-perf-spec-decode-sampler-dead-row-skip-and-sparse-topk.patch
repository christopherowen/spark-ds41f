+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA")
+@pytest.mark.parametrize("topk", [64, 128, 256])
+def test_topk_greedy_and_gumbel_sample_match_dense_scatter(topk: int):
+    from vllm.v1.worker.gpu.sample import tilelang_sampling
+
+    torch.manual_seed(7)
+    device = torch.device("cuda")
+    batch = 8
+    n_spec = 5
+    vocab_size = 4096
+
+    base_logits = torch.randn(batch, vocab_size, dtype=torch.bfloat16, device=device)
+    cand_logits, cand_indices = base_logits.topk(topk, dim=-1)
+
+    dense_logits = torch.full_like(base_logits, float("-inf"))
+    dense_logits.scatter_(1, cand_indices, cand_logits)
+
+    # 1. Greedy argmax bit-exactness (including ties and all -inf).
+    sparse_greedy = tilelang_sampling.topk_greedy_sample(
+        cand_logits, cand_indices, vocab_size
+    )
+    dense_greedy = dense_logits.argmax(dim=-1)
+    assert torch.equal(sparse_greedy, dense_greedy)
+
+    all_neg_inf = torch.full_like(cand_logits, float("-inf"))
+    assert torch.equal(
+        tilelang_sampling.topk_greedy_sample(all_neg_inf, cand_indices, vocab_size),
+        torch.zeros(batch, dtype=torch.int64, device=device),
+    )
+
+    # 2. Gumbel-max sampling bit-exactness and cached draft_logits bit-exactness
+    # across two consecutive steps (verifying old top-k indices are cleared to -inf).
+    idx_mapping = torch.arange(batch, dtype=torch.int64, device=device)
+    temperature = torch.linspace(0.4, 1.3, batch, dtype=torch.float32, device=device)
+    temperature[batch // 2] = 0.0  # Include a greedy row inside the batch.
+    seeds = torch.arange(100, 100 + batch, dtype=torch.int64, device=device)
+    pos = torch.arange(30, 30 + batch, dtype=torch.int64, device=device)
+    step_col = torch.tensor([2], dtype=torch.int32, device=device)
+
+    dense_cache = torch.full(
+        (batch, n_spec, vocab_size), float("-inf"), dtype=torch.bfloat16, device=device
+    )
+    sparse_cache = torch.full(
+        (batch, n_spec, vocab_size), float("-inf"), dtype=torch.bfloat16, device=device
+    )
+    cached_indices = torch.zeros(
+        (batch, n_spec, topk), dtype=torch.int64, device=device
+    )
+
+    for round_idx in range(2):
+        step_base = torch.randn(batch, vocab_size, dtype=torch.bfloat16, device=device)
+        c_logits, c_indices = step_base.topk(topk, dim=-1)
+        d_logits = torch.full_like(step_base, float("-inf")).scatter_(
+            1, c_indices, c_logits
+        )
+        cur_pos = pos + round_idx
+        ref_sampled = gumbel_sample(
+            d_logits,
+            idx_mapping,
+            temperature,
+            seeds,
+            cur_pos,
+            apply_temperature=True,
+            is_drafting=True,
+            logits_cache=dense_cache,
+            logits_cache_col=step_col[0],
+            use_fp64=False,
+        )
+        got_sampled = tilelang_sampling.topk_gumbel_sample(
+            c_logits,
+            c_indices,
+            idx_mapping,
+            temperature,
+            seeds,
+            cur_pos,
+            True,
+            vocab_size,
+            is_drafting=True,
+            logits_cache=sparse_cache,
+            logits_cache_col=step_col[0],
+            cached_indices=cached_indices,
+        )
+        assert torch.equal(got_sampled, ref_sampled)
+        assert torch.equal(
+            sparse_cache[:, 2].view(torch.int16),
+            dense_cache[:, 2].view(torch.int16),
+        )
