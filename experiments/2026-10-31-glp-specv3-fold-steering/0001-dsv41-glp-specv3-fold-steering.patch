+@pytest.mark.parametrize("tokens", [1, 7, 96, 384])
+@pytest.mark.parametrize("alpha", [0.75, 1.0, 3.5])
+def test_a_marked_row_with_mean_streams_projects_by_the_stream_mean(tokens, alpha):
+    parts, residual, post, comb, direction = _inputs(tokens, seed=tokens + 100)
+    rows = torch.ones(tokens, dtype=torch.int32, device="cuda")
+    steered, _, _ = _steer(
+        parts, residual, post, comb, rows, direction, alpha, mean_streams=True
+    )
+    folded = _fold(parts, residual, post, comb)
+    exact = _fp64_mean(folded, direction, alpha)
+    assert ((steered.double() - exact).abs() <= _ulp(exact) + 2.0**-24).all()
+    assert not torch.allclose(exact, _fp64(folded, direction, alpha))
+
+
+@pytest.mark.parametrize("world", [1, 2, 3, 4])
+def test_mean_streams_next_fold_and_unmarked_rows(world):
+    parts, residual, post, comb, direction = _inputs(130, world=world, seed=world + 20)
+    rows = _marks(130, seed=world + 20)
+    steered, post2, comb2 = _steer(
+        parts, residual, post, comb, rows, direction, 3.5, mean_streams=True
+    )
+    marked = rows.bool()
+    eye = torch.eye(STREAMS, device="cuda").expand(int(marked.sum()), -1, -1)
+    assert torch.equal(comb2[marked], eye)
+    assert torch.equal(post2[marked], torch.zeros_like(post2[marked]))
+    assert torch.equal(_fold(parts, steered, post2, comb2)[marked], steered[marked])
+    kept = ~marked
+    for before, after in ((residual, steered), (post, post2), (comb, comb2)):
+        assert torch.equal(_bits(after)[kept], _bits(before)[kept])
+
+
+@pytest.mark.parametrize("tokens", [1, 7, 96, 384])
+@pytest.mark.parametrize("alpha", [0.75, 1.0, 3.5])
+def test_a_marked_write_is_projected_within_one_rounding(tokens, alpha):
+    parts, _, _, _, direction = _inputs(tokens, seed=tokens + 200)
+    rows = torch.ones(tokens, dtype=torch.int32, device="cuda")
+    steered = _steer_write(parts, rows, direction, alpha)
+    exact = _fp64(_write(parts), direction, alpha)
+    assert ((steered[0].double() - exact).abs() <= _ulp(exact) + 2.0**-24).all()
+
+
+@pytest.mark.parametrize("world", [1, 2, 3, 4])
+def test_unreduced_write_sums_in_rank_order_and_zeroes_other_parts(world):
+    parts, _, _, _, direction = _inputs(130, world=world, seed=world + 40)
+    rows = _marks(130, seed=world + 40)
+    steered = _steer_write(parts, rows, direction, 3.5)
+    marked = rows.bool()
+    exact = _fp64(_write(parts), direction, 3.5)[marked]
+    reduced = _write(steered)[marked]
+    assert ((reduced.double() - exact).abs() <= _ulp(exact) + 2.0**-24).all()
+    if world > 1:
+        assert torch.equal(
+            steered[1:, marked], torch.zeros_like(steered[1:, marked])
+        )
+    kept = ~marked
+    assert torch.equal(_bits(steered[:, kept]), _bits(parts[:, kept]))
 
 
