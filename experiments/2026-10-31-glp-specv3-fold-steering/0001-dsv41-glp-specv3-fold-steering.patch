+def test_fold_hook_steers_both_attention_write_and_stream_mean_fold(
+    monkeypatch, launches
+):
+    from vllm.models.deepseek_v4_1.tilelang.collectives import RankOrderParts
+
+    write_calls = []
+    monkeypatch.setattr(
+        glp.tilelang_glp, "glp_steer_write", lambda *args: write_calls.append(args)
+    )
+    x, residual, post_mix, res_mix = _layer_outputs()
+    rows = torch.tensor([0, 1, 0], dtype=torch.int32)
+
+    # Spec v1 (residual_stream_post_layer) never steers the attention write.
+    steering().steer_attn(5, x, rows)
+    assert write_calls == []
+
+    # Spec v3 (hc_fold_pre_engram) steers both the attention write and the
+    # stream-mean fold on covered layers, and leaves uncovered layers alone.
+    fold_module = steering(hook_point=glp.FOLD_HOOK_POINT)
+    fold_module.steer_attn(3, x, rows)
+    assert write_calls == []
+
+    fold_module.steer_attn(5, x, rows)
+    ((parts, attn_rows, attn_dir, attn_alpha),) = write_calls
+    assert parts.shape == (1, 3, WIDE) and torch.equal(parts[0], x)
+    assert attn_rows is rows
+    assert torch.equal(attn_dir, fold_module.directions[5])
+    assert attn_alpha is fold_module.alpha
+
+    packed = torch.stack([x, x, x])
+    fold_module.steer_attn(1, RankOrderParts(packed), rows)
+    assert write_calls[-1][0] is packed
+
+    fold_module.steer(5, x, residual, post_mix, res_mix, rows)
+    assert launches[-1][-1] is True
