+def test_fold_hook_spec_v3_directions_and_content_sha256_are_read(tmp_path, monkeypatch):
+    digest = hashlib.sha256()
+    for layer in LAYERS:
+        digest.update(unit(layer).astype("<f4").tobytes())
+    path = glp_file(
+        tmp_path,
+        metadata={
+            "glp.spec_version": glp.FOLD_SPEC_VERSION,
+            "glp.hook_point": glp.FOLD_HOOK_POINT,
+            "glp.alpha_default": 3.5,
+            "glp.content_sha256": digest.hexdigest(),
+        },
+    )
+    directions, alpha = glp.read_glp(path, NUM_LAYERS, HIDDEN)
+    assert sorted(directions) == list(LAYERS)
+    assert alpha == pytest.approx(3.5)
+    steer(monkeypatch, path)
+    module = glp.glp_steering(NUM_LAYERS, HIDDEN, STREAMS, MAX_TOKENS)
+    assert module.hook_point == glp.FOLD_HOOK_POINT
+    assert module.mean_streams is True
+    assert module.alpha.item() == pytest.approx(3.5)
+
