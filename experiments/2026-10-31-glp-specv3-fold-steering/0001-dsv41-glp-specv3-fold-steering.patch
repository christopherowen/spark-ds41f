+    seen: list[tuple[str, int, int, int, list[int]]] = []
+    full_marks = torch.tensor([1, 0, 1, 0, 0, 1, 1, 0], dtype=torch.int32)
+
+    class _Tracker:
+        def step_rows(self, num_tokens: int) -> torch.Tensor:
+            return full_marks[:num_tokens]
+
+        def steer_attn(self, layer_idx: int, hidden_states, rows: torch.Tensor):
