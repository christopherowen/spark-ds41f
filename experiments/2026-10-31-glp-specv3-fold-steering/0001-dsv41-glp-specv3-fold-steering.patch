+def _steer(
+    parts,
+    residual,
+    post,
+    comb,
+    rows,
+    direction,
+    alpha: float,
+    *,
+    mean_streams: bool = False,
+):
     """The launch on copies: the steered residual, post and comb."""
     residual, post, comb = residual.clone(), post.clone(), comb.clone()
     glp.glp_steer(
@@ -65,15 +75,33 @@ def _steer(parts, residual, post, comb, rows, direction, alpha: float):
         rows,
         direction,
         torch.tensor([alpha], device="cuda"),
+        mean_streams,
     )
     return residual, post, comb
 
 
+def _steer_write(parts, rows, direction, alpha: float) -> torch.Tensor:
+    parts = parts.clone()
+    glp.glp_steer_write(
+        parts,
+        rows,
+        direction,
+        torch.tensor([alpha], device="cuda"),
+    )
+    return parts
+
+
 def _fp64(streams, direction, alpha: float) -> torch.Tensor:
     h, d = streams.double(), direction.double()
     return h - (alpha * (h @ d)).unsqueeze(-1) * d
 
 
+def _fp64_mean(streams, direction, alpha: float) -> torch.Tensor:
+    h, d = streams.double(), direction.double()
+    dot = h.mean(dim=-2, keepdim=True) @ d
+    return h - (alpha * dot).unsqueeze(-1) * d
+
+
 def _ulp(x: torch.Tensor) -> torch.Tensor:
     """BF16's spacing at ``|x|`` (eight significant bits)."""
     _, exponent = torch.frexp(x.abs().clamp_min(2.0**-126))
@@ -177,6 +205,66 @@ def test_no_tokens_launch_nothing():
     parts, residual, post, comb, direction = _inputs(0)
