 _FUSE_HEADER = r"""
+#include <math_constants.h>
 #include <tl_templates/cuda/common.h>
 #include <tl_templates/cuda/cuda_fp8.h>
 __device__ __forceinline__ void mhc_fence() { __threadfence(); }
+__device__ __forceinline__ int mhc_claim(int* counter, int splits, int live_m) {
+    int arrived = atomicAdd(counter, 1);
+    int rank = splits - 1 - arrived;
+    if (rank >= live_m) {
+        return -1;
+    }
+    if (live_m == 1) {
+#if __CUDA_ARCH__ >= 700
+        asm volatile("st.global.release.gpu.b32 [%0], 0;" :: "l"(counter));
+#else
+        *reinterpret_cast<volatile int*>(counter) = 0;
+#endif
+    }
+    return rank;
+}
+__device__ __forceinline__ void mhc_wait_splits(int* counter, int splits, int live_m, int rank) {
+    if (live_m <= 1) {
+        __threadfence();
+        return;
+    }
+    if (rank > 0) {
+        int val;
+#if __CUDA_ARCH__ >= 700
+        asm volatile("ld.global.acquire.gpu.b32 %0, [%1];" : "=r"(val) : "l"(counter));
+        while (val < splits) {
+            asm volatile("nanosleep.u32 32;");
+            asm volatile("ld.global.acquire.gpu.b32 %0, [%1];" : "=r"(val) : "l"(counter));
+        }
+#else
+        do {
+            val = *reinterpret_cast<const volatile int*>(counter);
+        } while (val < splits);
+#endif
+    }
+    __threadfence();
+    int done = atomicAdd(counter, 1);
+    if (done == splits + live_m - 1) {
+#if __CUDA_ARCH__ >= 700
+        asm volatile("st.global.release.gpu.b32 [%0], 0;" :: "l"(counter));
+#else
+        *reinterpret_cast<volatile int*>(counter) = 0;
+#endif
+    }
+}
 """
 
 
