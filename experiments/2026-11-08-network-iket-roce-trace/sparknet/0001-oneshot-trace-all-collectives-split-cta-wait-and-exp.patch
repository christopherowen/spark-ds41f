+def test_roce_trace_records_all_four_collectives(runtime):
+    """When SPARKNET_ROCE_TRACE=1 is enabled, all four collective families write complete trace records."""
+    from sparknet.oneshot import trace as roce_trace
+
+    if not runtime._trace_path:
+        pytest.skip("requires SPARKNET_ROCE_TRACE=1")
+    world = dist.get_world_size()
+    rank = dist.get_rank()
+    dev = runtime.device
+    t_ar = torch.ones(16384, dtype=torch.bfloat16, device=dev) * (rank + 1)
+    t_ag = torch.ones(64, 256, dtype=torch.bfloat16, device=dev) * (rank + 1)
+    t_rs = torch.ones(world * 32, 256, dtype=torch.bfloat16, device=dev) * (rank + 1)
+    t_ex = torch.ones(world, 32, 256, dtype=torch.bfloat16, device=dev) * (rank + 1)
+    runtime.all_reduce(t_ar)
+    runtime.all_gather(t_ag, dim=0)
+    runtime.reduce_scatter(t_rs, dim=0)
+    runtime.exchange(t_ex, copy_self=True)
+    torch.cuda.synchronize()
+    dist.barrier()
+    loaded = roce_trace.read(runtime._trace_path)
+    counts = roce_trace.op_counts(loaded)
+    for op_name in ("allreduce", "allgather", "reducescatter", "exchange"):
+        assert counts.get(op_name, 0) >= 1, (rank, counts)
+        picked = roce_trace.select(loaded, op=op_name)
+        last = picked.records[-1]
+        assert last[roce_trace.W_START] > 0
+        assert last[roce_trace.W_DOORBELL] >= last[roce_trace.W_START]
+        assert last[roce_trace.W_WAIT_DONE] >= last[roce_trace.W_DOORBELL]
+        assert last[roce_trace.W_END] >= last[roce_trace.W_WAIT_DONE]
+        for peer in range(world):
+            if peer != rank:
+                assert roce_trace.peer_arrival(last, loaded, peer) > 0
 
