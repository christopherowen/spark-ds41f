-    # In-flight event: sync_slot_draft_limits queries without synchronizing.
-    class InFlightEvent:
-        def query(self) -> bool:
-            return False
 
-        def synchronize(self) -> None:
-            raise AssertionError("sync_slot_draft_limits must not block on GPU")
+class _QueuedCopy:
+    """A D2H copy still in flight: query() is False until synchronize()."""
+
+    def __init__(self):
+        self.synchronized = False
+
+    def query(self) -> bool:
+        return self.synchronized
+
+    def synchronize(self) -> None:
+        self.synchronized = True
+
+
+def _limits_drafter(staged):
+    drafter = CopyDrafter.__new__(CopyDrafter)
+    drafter.lookahead = LOOKAHEAD
+    drafter.slot_draft_limits = SimpleNamespace(np=np.zeros(len(staged), dtype=np.int32))
+    drafter._limits_staging_np = np.array(staged, dtype=np.int32)
+    drafter._limits_event = _QueuedCopy()
+    drafter._new_rows = []
+    return drafter
+
+
+def test_sync_slot_draft_limits_waits_for_the_queued_copy():
+    """The host limits are the latest proposal's, never an earlier one's (#852).
 
-    drafter._limits_event = InFlightEvent()  # type: ignore[assignment]
+    attach_async_output queues a D2H copy of the limits and keeps its event; the
+    next budget waits for that copy rather than reading the previous values. A
+    stale, wider limit verified rows the proposal does not have, the scheduler's
+    -1 placeholders, and without dead-row marking they reached the MoE router.
+    """
+    drafter = _limits_drafter([7, 8])
+    event = drafter._limits_event
     limits = drafter.sync_slot_draft_limits()
-    assert limits.shape == (MAX_REQS,)
+    assert event.synchronized
+    assert limits.tolist() == [7, 8]
+    assert drafter._limits_event is None
+
+
+def test_add_request_resets_its_slot_after_the_queued_copy():
+    """A request added while a copy is in flight keeps its reset: the copy is
+    published first, then the new slot's limit is the full lookahead."""
+    drafter = _limits_drafter([3, 5])
+    drafter.add_request(1)
+    assert drafter.slot_draft_limits.np.tolist() == [3, LOOKAHEAD]
+    assert drafter._new_rows == [1]
+    assert drafter.sync_slot_draft_limits().tolist() == [3, LOOKAHEAD]
