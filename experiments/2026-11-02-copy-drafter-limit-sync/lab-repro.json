{
 "experiment": "experiments/2026-11-02-copy-drafter-limit-sync",
 "run": "limit-sync-repro-sp",
 "jobs": [
  {
   "kind": "sync"
  },
  {
   "kind": "measure",
   "profile": "lean",
   "bench": false,
   "arms": [
    {
     "config": "arm-c37-m8-nodead.json",
     "label": "c37-m8-nodead"
    },
    {
     "config": "arm-fix-m8-nodead.json",
     "label": "fix-m8-nodead"
    }
   ],
   "extras": [
    [
     "experiments/2026-10-23-next-release/acceptance/copy_probe.py",
     [
      "--prompts",
      "3"
     ],
     "copy-probe"
    ],
    [
     "suite_single_stream.py",
     [
      "{label}",
      "{run}"
     ],
     "single-stream"
    ],
    [
     "experiments/2026-11-01-dspark-default-copy-drafts/repro/census_logs.py",
     [
      "{label}"
     ],
     "census"
    ],
    [
     "scripts/distinct_streams.py",
     [
      "--streams",
      "8",
      "--samples",
      "3",
      "--tokens",
      "1024"
     ],
     "c8-distinct"
    ],
    [
     "experiments/2026-11-01-dspark-default-copy-drafts/repro/census_logs.py",
     [
      "{label}"
     ],
     "census-c8"
    ]
   ]
  }
 ]
}
