+def test_segment_split_and_cache_preserve_exact_token_ids_and_immutability():
+    from vllm.tokenizers.deepseek_v41 import _split_prompt_segments
+
+    tokenizer = byte_level_tokenizer()
+    if hasattr(tokenizer, "_segment_cache"):
+        tokenizer._segment_cache.clear()
+    if hasattr(tokenizer, "_plain_cache"):
+        tokenizer._plain_cache.clear()
+
+    messages_t1 = [
+        {"role": "system", "content": "Follow tool schemas."},
+        {"role": "user", "content": "Look up item A1 and B2."},
+        {
+            "role": "assistant",
+            "content": "",
+            "reasoning_content": "First check A1.",
+            "tool_calls": [
+                {
+                    "id": "call_1",
+                    "type": "function",
+                    "function": {"name": "lookup", "arguments": '{"q": "A1"}'},
+                }
+            ],
+        },
+        {"role": "tool", "tool_call_id": "call_1", "content": "A1 is available."},
+    ]
+    tools = [copy.deepcopy(LOOKUP)]
+    orig_t1 = copy.deepcopy(messages_t1)
+    orig_tools = copy.deepcopy(tools)
+
+    prompt_t1 = tokenizer.apply_chat_template(
+        messages_t1, tools=tools, tokenize=False, add_generation_prompt=True
+    )
+    segments = _split_prompt_segments(prompt_t1)
+    assert "".join(segments) == prompt_t1
+    assert len(segments) >= 4
+
+    ids_cold = tokenizer.apply_chat_template(
+        messages_t1, tools=tools, tokenize=True, add_generation_prompt=True
+    )
+    assert ids_cold == tokenizer.encode(prompt_t1, add_special_tokens=False)
+    assert messages_t1 == orig_t1
+    assert tools == orig_tools
+
+    # Ensure prior direct encode(truncation=True, max_length=...) does not leak
+    # truncation state into subsequent segment-cached apply_chat_template calls.
+    _ = tokenizer.encode("short text for truncation check", truncation=True, max_length=4)
+
+    messages_t2 = messages_t1 + [
+        {
+            "role": "assistant",
+            "content": "",
+            "reasoning_content": "Now check B2.",
+            "tool_calls": [
+                {
+                    "id": "call_2",
+                    "type": "function",
+                    "function": {"name": "lookup", "arguments": '{"q": "B2"}'},
+                }
+            ],
+        },
+        {"role": "tool", "tool_call_id": "call_2", "content": "B2 is backordered."},
+    ]
+    prompt_t2 = tokenizer.apply_chat_template(
+        messages_t2, tools=tools, tokenize=False, add_generation_prompt=True
+    )
+    ids_warm = tokenizer.apply_chat_template(
+        messages_t2, tools=tools, tokenize=True, add_generation_prompt=True
+    )
+    assert ids_warm == tokenizer.encode(prompt_t2, add_special_tokens=False)
