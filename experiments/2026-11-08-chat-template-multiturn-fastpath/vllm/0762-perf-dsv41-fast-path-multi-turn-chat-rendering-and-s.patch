+# Bounded per-tokenizer segment cache capacity (message/turn chunks -> token IDs).
+_MAX_SEGMENT_CACHE = 8192
+_SEGMENT_CACHES: dict[tuple[int, int], dict[str, tuple[int, ...]]] = {}
+_PLAIN_CACHES: dict[tuple[int, int], dict[str, tuple[int, ...]]] = {}
