+def test_trie_regex_matches_longest_first_and_overlapping_prefixes():
+    import re
+    from vllm.tokenizers.deepseek_v41 import _compile_trie_regex
+
+    words = ["<foo", "<foobar", "<foobaz", "<f", "｜DSML｜", "<think>", "</think>"]
+    ref_re = re.compile(
+        "|".join(re.escape(s) for s in sorted(words, key=len, reverse=True))
+    )
+    trie_re = _compile_trie_regex(words)
+    assert trie_re is not None
+    for sample in [
+        "a<foobaz!<foobar?<foo.<f><fo_x<int>",
+        "x｜DSML｜<think>code with i < n</think>",
+    ]:
+        ref_matches = [(m.start(), m.end(), m.group(0)) for m in ref_re.finditer(sample)]
+        trie_matches = [
+            (m.start(), m.end(), m.group(0)) for m in trie_re.finditer(sample)
+        ]
+        assert trie_matches == ref_matches
+
