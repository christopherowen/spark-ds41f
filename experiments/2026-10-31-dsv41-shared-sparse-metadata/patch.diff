+def test_forward_mqa_shares_index_pages_and_group_metadata(monkeypatch):
+    """Layers sharing a KV-cache group build single-chunk index page tables and
+    decode/short-extend/split attention metadata once per group."""
+    from vllm.models.deepseek_v4_1 import attention
+    from vllm.models.deepseek_v4_1.tilelang import metadata as tl_metadata
+
+    monkeypatch.setattr(torch.cuda, "is_current_stream_capturing", lambda: False)
+    page_calls = []
+    monkeypatch.setattr(
+        tl_metadata,
+        "pages",
+        lambda *args, **kwargs: page_calls.append((args[3], args[4], args[5])),
+    )
+    workspace_calls = []
+    monkeypatch.setattr(
+        attention,
+        "current_workspace_manager",
+        lambda: SimpleNamespace(
+            get_simultaneous=lambda *specs: (
+                workspace_calls.append(specs)
+                or [torch.zeros(s, dtype=dt) for s, dt in specs]
+            )
+        ),
+    )
+
+    context_dict = {}
+    swa_meta = SimpleNamespace(
+        is_decode=False,
+        num_decode_tokens=0,
+        swa_replay_start=None,
+    )
+    main_meta = SimpleNamespace()
+    index_meta = SimpleNamespace(
+        req_id_per_token=torch.zeros(8, dtype=torch.int32),
+        cache_lengths=torch.ones(8, dtype=torch.int32),
+        block_table=torch.zeros((2, 4), dtype=torch.int32),
+        max_seq_len=128,
+    )
+    attn_metadata = {"swa": swa_meta, "main": main_meta, "idx": index_meta}
+
+    layers = []
+    for layer_id in (1, 2):
+        layer = _tilelang_layer(layer_id=layer_id)
+        layer.is_draft = False
+        layer._draft_replays = False
+        layer._draft_replay_start = None
+        layer.window_size = 128
+        layer.swa_cache_layer = SimpleNamespace(prefix="swa", block_size=64)
+        layer._owner = lambda: SimpleNamespace(prefix="main")
+        layer.index_source_layer_id = layer_id
+        layer.indexer = SimpleNamespace(
+            heads=32, k_cache=SimpleNamespace(prefix="idx")
+        )
+        layer._attention_geometry()
+        layer._prepare("cpu")
+        layer._check_attention_rows = lambda mode, rows: None
+        layer._attention_scratch_specs = lambda mode, rows: (((rows, 4), torch.uint8),)
+        layer._index_chunk = lambda *args, **kwargs: None
+        layer._attend = lambda *args, **kwargs: None
+        layers.append(layer)
+    context_dict.update({layer.prefix: layer for layer in layers})
+    forward_ctx = SimpleNamespace(attn_metadata=attn_metadata)
+    monkeypatch.setattr(attention, "get_forward_context", lambda: forward_ctx)
+    monkeypatch.setattr(
+        attention.DeepseekV4Attention, "_context", context_dict, raising=False
+    )
+    for layer in layers:
+        layer._context = context_dict
+
+    meta_writes = []
+    monkeypatch.setattr(
+        attention.DeepseekV4Attention,
+        "_write_decode_metadata",
+        lambda self, buffers, swa, main, rows: meta_writes.append((self.layer_id, rows)),
+    )
+
+    rows = 8
+    q = torch.zeros((rows, 4, 512))
+    kv = torch.zeros((rows, 512))
+    positions = torch.zeros(rows, dtype=torch.int64)
+    output = torch.zeros_like(q)
+    iq = (
+        torch.zeros((rows, 32, 64), dtype=torch.uint8),
+        torch.zeros((rows, 32, 4), dtype=torch.uint8),
+        torch.zeros((rows, 32), dtype=torch.float32),
+        None,
+        None,
+    )
+
+    for layer in layers:
+        layer.forward_mqa(q, kv, positions, output, index_query=iq)
+
+    # Single-chunk index_pages built once for the shared idx cache group.
+    assert len(page_calls) == 1
+    assert page_calls[0][0] is layers[0]._short_index_pages
+    # Short-extend (rows <= _decode_capacity) builds metadata once and borrows only
+    # attention scratch from the workspace manager.
+    assert meta_writes == [(1, rows)]
+    assert all(len(specs) == 1 for specs in workspace_calls)
+
+    # Mixed-step (_attend_split) also builds metadata once per contiguous cache group.
+    meta_writes.clear()
+    swa_meta.num_decode_tokens = 2
+    for layer in layers:
+        layer._attend_split(q, output, positions, swa_meta, main_meta, layer, rows, 2)
+    assert meta_writes == [(1, rows)]
