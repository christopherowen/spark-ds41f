+                        "__tl_load_k_shared_candidates",
+                        T.address_of(KPool[0, 0]),
+                        T.address_of(KScale[0, 0]),
+                        T.address_of(PageTable[0, 0]),
+                        T.address_of(Candidates[0, 0]),
+                        T.address_of(K_shared[0, 0]),
+                        T.address_of(SFK_shared[0, 0]),
+                        row,
