+def test_indexer_score_vectorizes_kpool_loads_and_coschedules_dense_rows():
+    """Dense and candidate score kernels load 64-byte E2M1 key rows via 16-byte uint4
+    loads with a single PageTable lookup per position, and dense mode co-schedules
+    persistent CTA columns across rows in the grid."""
+    from vllm.models.deepseek_v4_1.tilelang.indexer import indexer_score_v41
