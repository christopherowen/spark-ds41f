+@pytest.mark.parametrize("n, k", [(384, 5120), (32, 5120)])
+def test_bf16_partials_edges_are_programmatic(n, k):
+    """Split-K BF16 partials (router and indexer weights_proj) wait on their
+    predecessor and trigger their consumer programmatically."""
+    from vllm.models.deepseek_v4_1.tilelang.gemm import (
+        bf16_gemm_partials,
+        bf16_shards,
+        splitk_reduce,
+    )
+
+    rows = 6
+    shards = bf16_shards(n, k)
+    x = torch.randn((rows, k), dtype=torch.bfloat16, device=DEVICE)
+    w = torch.randn((n, k), dtype=torch.bfloat16, device=DEVICE)
+    partials = torch.empty((shards, rows, n), dtype=torch.float32, device=DEVICE)
+    out = torch.empty((rows, n), dtype=torch.float32, device=DEVICE)
+    part_k = bf16_gemm_partials(n, k, shards, block_M=16)
+    red_k = splitk_reduce(n, shards, out_dtype="float32")
+    copy = slow_copy(rows)
+    src = torch.ones((rows,), dtype=torch.float32, device=DEVICE)
+    dst = torch.empty_like(src)
+
+    def run():
+        copy(src, dst)
+        part_k(x, w, partials)
+        red_k(partials, out)
+
+    edges = _edges(_graph(run, keep=True))
+    assert len(edges) == 2, edges
+    for s, d, kind in edges:
+        assert kind == PROGRAMMATIC, (s, d, kind)
