+def test_wq_b_fused_rope_matches_separate_rope(default_vllm_config):
+    """``wq_b`` (8192 x 1280, ``head_dim=512``, ``rope_dim=64``) with fused Query RoPE
+    in its epilogue matches ``wq_b`` followed by ``rope_`` bit for bit across all
+    decode tile heights and prefill."""
+    from types import SimpleNamespace
+    from torch import nn
+
+    from tests.kernels.deepseek_v41_contracts import rope_table
+    from vllm.models.deepseek_v4_1.tilelang.linear import (
+        TileLangFP8LinearMethod,
+        cast_mxfp8,
+        provide_mxfp8,
+    )
+    from vllm.models.deepseek_v4_1.tilelang.rope import rope_
+    from vllm.v1.worker.workspace import use_preallocated_workspace
+
+    n, k, head_dim = 8192, 1280, 512
+    heads = n // head_dim
+    weight, exps, _ = _block32_weight(n, k, 31)
+    cos_sin = rope_table(positions=4096, rope_dim=64)
+    qcfg = SimpleNamespace(weight_block_size=[32, 32])
+
+    plain = nn.Module()
+    plain.weight = nn.Parameter(weight.clone(), requires_grad=False)
+    plain.weight_scale_inv = nn.Parameter(exps.clone(), requires_grad=False)
+    plain.tilelang_mxfp8_input = True
+    plain_method = TileLangFP8LinearMethod(qcfg)
+    plain_method.process_weights_after_loading(plain)
+    plain_method.declare_layer_kernels(plain)
+
+    fused = nn.Module()
+    fused.weight = nn.Parameter(weight.clone(), requires_grad=False)
+    fused.weight_scale_inv = nn.Parameter(exps.clone(), requires_grad=False)
+    fused.tilelang_mxfp8_input = True
+    fused.tilelang_rope_head_dim = head_dim
+    fused.tilelang_cos_sin = cos_sin
+    fused_method = TileLangFP8LinearMethod(qcfg)
+    fused_method.process_weights_after_loading(fused)
+    fused_method.declare_layer_kernels(fused)
+
+    x = torch.randn((max(ROWS), k), generator=_gen(37), device=DEVICE).bfloat16()
+    positions = torch.randint(
+        0, 4096, (max(ROWS),), generator=_gen(41), device=DEVICE, dtype=torch.int64
+    )
+    scratch = torch.empty(16 << 20, dtype=torch.uint8, device=DEVICE)
+    with use_preallocated_workspace(scratch):
+        full_cast = cast_mxfp8(x)
+        with provide_mxfp8(full_cast):
+            full_ref = plain_method.apply(plain, x).view(max(ROWS), heads, head_dim)
+        rope_(full_ref, positions, cos_sin, ratio=1, inverse=False)
+        for rows in ROWS:
+            sub = x[:rows]
+            sub_pos = positions[:rows]
+            sub_cast = cast_mxfp8(sub)
+            with provide_mxfp8(sub_cast, positions=sub_pos):
+                got = fused_method.apply(fused, sub).view(rows, heads, head_dim)
+            assert torch.equal(got, full_ref[:rows]), f"rows={rows}"
+            with provide_mxfp8(sub_cast), pytest.raises(RuntimeError):
+                fused_method.apply(fused, sub)
