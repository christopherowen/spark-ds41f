{
  "experiment": "experiments/2026-11-05-verification-shapes",
  "run": "verification-shapes-release-tp3",
  "jobs": [
    {
      "kind": "measure",
      "reference": "manifests/suites/2026-10-30-spark-ds41f-1030-tp3",
      "suite": [
        "release-tp3",
        "single-stream",
        "sampled"
      ],
      "arms": [
        {
          "config": "experiments/2026-11-05-verification-shapes/tp3-dev.json",
          "label": "verification-shapes",
          "startup_memory": true
        },
        {
          "config": "experiments/2026-11-05-verification-shapes/tp3-dev.json",
          "label": "verification-shapes-repeat",
          "startup_memory": true
        }
      ],
      "extras": [
        [
          "experiments/2026-11-05-verification-shapes/boundary_grid.py",
          [
            "--out",
            "results/private/lab/{run}-boundaries-{label}.json",
            "--label",
            "{label}",
            "--cluster-config",
            "experiments/2026-11-05-verification-shapes/tp3-dev.json"
          ],
          "native-boundaries"
        ],
        [
          "bin/spark",
          [
            "--cluster-config",
            "experiments/2026-11-05-verification-shapes/tp3-dev.json",
            "bench",
            "--suites",
            "decode",
            "--concurrency",
            "1,8,16",
            "--min-samples",
            "6",
            "--max-samples",
            "40",
            "--precision",
            "2",
            "--output",
            "results/private/lab/{run}-clientload-{label}.json"
          ],
          "client-load"
        ]
      ]
    }
  ]
}
