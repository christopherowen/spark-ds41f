From d975a4438bd4be3ae3dde392651f18e56c56a2f1 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Thu, 5 Nov 2026 23:20:44 +0000
Subject: [PATCH] Capture native row totals for heterogeneous request counts

Base: 8dea43f62a149a3aef2be4b24fa1c68e9b33407d. Experimental capture-policy alternative: compare row padding, request padding, and graph memory without changing native arithmetic or the capture limit. Native-row descriptors are added through the shared shape generator, avoiding extra mixed graphs. Tests: 70 CPU graph, warmup and context checks passed; 18 unrelated fixture-dependent cases deselected. GPU batch invariance, memory and latency remain unmeasured. Upstream status: unpromoted experiment, not a selected implementation.
---
 tests/v1/cudagraph/test_cudagraph_manager.py |  9 ++++++++-
 vllm/v1/worker/gpu/cudagraph_utils.py        | 17 ++++++++++++-----
 2 files changed, 20 insertions(+), 6 deletions(-)

diff --git a/tests/v1/cudagraph/test_cudagraph_manager.py b/tests/v1/cudagraph/test_cudagraph_manager.py
index 28d685b38..c3d479ec7 100644
--- a/tests/v1/cudagraph/test_cudagraph_manager.py
+++ b/tests/v1/cudagraph/test_cudagraph_manager.py
@@ -622,11 +622,18 @@ def test_copy_verification_keeps_native_full_depth_captures(monkeypatch, max_num
                 continue
             desc = manager.dispatch(reqs, rows, None, 0, max_query_len=width)
             assert desc.cg_mode == CUDAGraphMode.FULL
-            assert (desc.num_reqs, desc.num_tokens) == (reqs, rows)
+            if width == 6:
+                assert desc.num_tokens == rows and desc.num_reqs >= reqs
+            else:
+                assert (desc.num_reqs, desc.num_tokens) == (reqs, rows)
     for reqs in (1, 2):
         for rows in range(reqs, reqs * 17 + 1):
             desc = manager.dispatch(reqs, rows, None, 0, max_query_len=17)
             assert (desc.num_reqs, desc.num_tokens) == (reqs, rows)
+    # Native row totals also serve more, shallower requests.
+    mixed_depth = manager.dispatch(7, 36, None, 0, max_query_len=17)
+    assert mixed_depth.cg_mode == CUDAGraphMode.FULL
+    assert mixed_depth.num_tokens == 36
     # Queries outside the verification limit still use the mixed path.
     mixed = manager.dispatch(3, 36, None, 0, max_query_len=18)
     assert mixed.cg_mode == CUDAGraphMode.PIECEWISE
diff --git a/vllm/v1/worker/gpu/cudagraph_utils.py b/vllm/v1/worker/gpu/cudagraph_utils.py
index e431baf00..409681dda 100644
--- a/vllm/v1/worker/gpu/cudagraph_utils.py
+++ b/vllm/v1/worker/gpu/cudagraph_utils.py
@@ -71,8 +71,8 @@ def dense_varlen_decode_shapes(
     ``_DENSE_VARLEN_DECODE_MAX_REQS`` requests, including odd heterogeneous and
     adaptively trimmed totals) and the full-depth speculative batch for each
     higher request count up to ``max_num_reqs``. When copy drafts widen the
-    verification limit, retain full-depth batches at the drafter's ordinary
-    ``uniform_query_len`` too.
+    verification limit, retain ordinary full-depth row totals with room for
+    any valid request count, using ``uniform_query_len``.
     """
     dense_reqs = min(_DENSE_VARLEN_DECODE_MAX_REQS, max_num_reqs)
     dense = (
@@ -82,15 +82,22 @@ def dense_varlen_decode_shapes(
         if num_tokens <= max_capture_tokens
     )
     widths = {decode_query_len}
-    if uniform_query_len is not None and 1 < uniform_query_len < decode_query_len:
-        widths.add(uniform_query_len)
     uniform = (
         (num_reqs, num_reqs * width)
         for num_reqs in range(dense_reqs + 1, max_num_reqs + 1)
         for width in sorted(widths)
         if width > 1 and num_reqs * width <= max_capture_tokens
     )
-    return (*dense, *uniform)
+    native_rows = ()
+    if uniform_query_len is not None and 1 < uniform_query_len < decode_query_len:
+        native_rows = (
+            (min(rows, max_num_reqs), rows)
+            for rows in range(
+                uniform_query_len, max_num_reqs * uniform_query_len + 1, uniform_query_len
+            )
+            if rows <= max_capture_tokens
+        )
+    return tuple(dict.fromkeys((*dense, *uniform, *native_rows)))
 
 
 _DEBUG_GRAPH_MEMORY_ACCOUNTING = (
