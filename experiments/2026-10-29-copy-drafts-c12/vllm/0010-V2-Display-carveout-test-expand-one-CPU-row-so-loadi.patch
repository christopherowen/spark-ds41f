From 230189bbdb32d6203c140270b5853810ec62b0cd Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Fri, 30 Oct 2026 03:21:10 +0100
Subject: [PATCH 10/10] [V2] Display carveout test: expand one CPU row so
 loading does not fault 64 MiB on unified memory

---
 tests/v1/worker/test_display_carveout.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tests/v1/worker/test_display_carveout.py b/tests/v1/worker/test_display_carveout.py
index f39445b32..c11849c98 100644
--- a/tests/v1/worker/test_display_carveout.py
+++ b/tests/v1/worker/test_display_carveout.py
@@ -26,7 +26,9 @@ class _Table(torch.nn.Module):
         data = display_carveout.allocate((rows, width), torch.bfloat16, device)
         if data is None:
             data = torch.empty(rows, width, dtype=torch.bfloat16, device=device)
-        data.copy_(torch.randn(rows, width, dtype=torch.bfloat16))  # "loading"
+        data.copy_(
+            torch.randn(width, dtype=torch.bfloat16).expand(rows, width)
+        )  # "loading"
         self.weight = torch.nn.Parameter(data, requires_grad=False)
 
 
