+        idx_mapping,
+        _idx_mapping_np,
+        _expanded_idx_mapping,
+        _expanded_local_pos,
+        _dead_row_cut=None,
+        chunk=None,
+        _kernel_steps=None,
     ):
-        # rest: the index mappings, the token cap and the sink chunk (last).
-        chunk = rest[-1]
         processed = logits.float() * 2
         num_reqs = idx_mapping.shape[0]
         sampled = torch.zeros(
