+template <int BN>
+__device__ __forceinline__ void vllm_vocab_tile_second_from_clocal(
+    const float* __restrict__ c_frag,
+    float* __restrict__ smem_v,
+    int* __restrict__ smem_i,
+    float* __restrict__ smem_v2,
