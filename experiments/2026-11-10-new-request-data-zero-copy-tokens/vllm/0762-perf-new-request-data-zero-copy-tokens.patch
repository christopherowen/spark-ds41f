+# Minimum token-sequence length packed into an int32 PickleBuffer for
+# zero-copy / single-memcpy IPC across EngineCore -> worker MessageQueue.
+INT32_TOKEN_IDS_MIN_LEN = 256
+_PROMPT_PREFIX_SENTINEL = "_PromptPrefixLen"
+
+
+def _rebuild_int32_token_ids(buf: Any) -> "Int32TokenIds":
+    # In-band PickleBuffer (< 1 MiB) arrives as a freshly allocated bytearray;
+    # ZMQ overflow frames own their message buffer independently. Both can be
+    # wrapped with zero copies. Shared-memory ring chunks arrive as memoryview
+    # and must be copied before the ring slot is released.
+    if isinstance(buf, (bytearray, bytes)) or type(buf).__name__ == "Frame":
+        try:
+            return Int32TokenIds(np.frombuffer(buf, dtype=np.int32))
+        except ValueError:
+            pass
+    return Int32TokenIds(np.frombuffer(buf, dtype=np.int32).copy())
+
+
+class Int32TokenIds(Sequence[int]):
+    """Compact 1D int32 token-ID sequence backed by a NumPy array.
+
+    Serializes through protocol-5 ``PickleBuffer`` so ``MessageQueue`` transfers
+    one contiguous 4-byte/token buffer instead of pickling and allocating one
+    ``PyLongObject`` per token on every worker rank, while exposing both
+    ``Sequence[int]`` operations and ``__array__`` for zero-copy NumPy/UVA
+    consumers.
+    """
+
+    __slots__ = ("_arr", "_list_cache")
+
+    def __init__(self, arr: np.ndarray) -> None:
+        self._arr = np.ascontiguousarray(arr, dtype=np.int32)
+        self._list_cache: list[int] | None = None
+
+    @classmethod
+    def from_sequence(
+        cls, tokens: Sequence[int] | np.ndarray | array.array
+    ) -> "Int32TokenIds | None":
+        if isinstance(tokens, Int32TokenIds):
+            return tokens
+        if isinstance(tokens, np.ndarray):
+            if tokens.dtype == np.int32 and tokens.ndim == 1:
+                return cls(tokens)
+            try:
+                return cls(tokens.astype(np.int32, copy=False))
+            except (OverflowError, TypeError, ValueError):
+                return None
+        if isinstance(tokens, array.array) and tokens.typecode == "i":
+            return cls(np.frombuffer(tokens, dtype=np.int32))
+        try:
+            arr = array.array("i", tokens)
+        except (OverflowError, TypeError):
+            return None
+        return cls(np.frombuffer(arr, dtype=np.int32))
+
+    def __len__(self) -> int:
+        return int(self._arr.shape[0])
+
+    def __bool__(self) -> bool:
+        return bool(self._arr.shape[0])
+
+    @overload
+    def __getitem__(self, idx: int) -> int: ...
+
+    @overload
+    def __getitem__(self, idx: slice) -> "Int32TokenIds": ...
+
+    def __getitem__(self, idx: int | slice) -> "int | Int32TokenIds":
+        if isinstance(idx, slice):
+            return Int32TokenIds(self._arr[idx])
+        return int(self._arr[idx])
+
+    def __iter__(self):
+        return iter(self.tolist())
+
+    def __array__(self, dtype: Any = None, copy: bool | None = None) -> np.ndarray:
+        if dtype is None and not copy:
+            return self._arr
+        return np.asarray(self._arr, dtype=dtype, copy=copy)
+
+    def tolist(self) -> list[int]:
+        if self._list_cache is None:
+            self._list_cache = self._arr.tolist()
+        return self._list_cache
+
+    def copy(self) -> "Int32TokenIds":
+        return Int32TokenIds(self._arr.copy())
+
+    def __eq__(self, other: object) -> bool:
+        if isinstance(other, Int32TokenIds):
+            return np.array_equal(self._arr, other._arr)
+        if isinstance(other, list):
+            return len(self._arr) == len(other) and self.tolist() == other
+        return NotImplemented
+
+    def __repr__(self) -> str:
+        return repr(self.tolist())
+
+    def __reduce_ex__(self, protocol: int):
+        if protocol >= 5:
+            return (
+                _rebuild_int32_token_ids,
+                (PickleBuffer(self._arr.view(np.uint8)),),
+            )
+        return (_rebuild_int32_token_ids, (self._arr.tobytes(),))
+
