+                packed_arr = get_packed() if get_packed is not None else None
+                prompt_packed = (
+                    Int32TokenIds.from_sequence(packed_arr)
+                    if packed_arr is not None
+                    else Int32TokenIds.from_sequence(prompt_token_ids)
+                )
+                if prompt_packed is not None:
+                    if prefill_token_ids is prompt_token_ids:
+                        prompt_token_ids = prompt_packed
+                        prefill_token_ids = prompt_packed
+                    elif prefill_token_ids is None:
+                        prompt_token_ids = prompt_packed
+                    elif is_request_all_tokens and output_tokens:
+                        tail_packed = Int32TokenIds.from_sequence(output_tokens)
+                        if tail_packed is not None:
+                            full_arr = np.empty(
+                                len(prompt_packed) + len(tail_packed), dtype=np.int32
+                            )
+                            full_arr[: len(prompt_packed)] = prompt_packed._arr
+                            full_arr[len(prompt_packed) :] = tail_packed._arr
+                            prefill_packed = Int32TokenIds(full_arr)
+                            prefill_token_ids = prefill_packed
+                            prompt_token_ids = prefill_packed[: len(prompt_packed)]
+                        else:
+                            prompt_token_ids = prompt_packed
+                    elif len(prefill_token_ids) >= INT32_TOKEN_IDS_MIN_LEN:
+                        prefill_packed = Int32TokenIds.from_sequence(prefill_token_ids)
+                        if prefill_packed is not None:
+                            prefill_token_ids = prefill_packed
+                        prompt_token_ids = prompt_packed
+
         return cls(
             req_id=request.request_id,
-            prompt_token_ids=request.prompt_token_ids,
+            prompt_token_ids=prompt_token_ids,
             mm_features=strip_covered_mm_data(
                 request.mm_features,
                 request.num_computed_tokens,
@@ -89,6 +246,75 @@ class NewRequestData:
             recurrent_prefill_tail_boundary=request.recurrent_prefill_tail_boundary,
         )
 
+    def __getstate__(self) -> dict[str, Any]:
+        state = self.__dict__.copy()
+        prompt_ids = state.get("prompt_token_ids")
+        prefill_ids = state.get("prefill_token_ids")
+        if self.prompt_is_token_ids is None:
+            if (
+                prompt_ids is not None
+                and prefill_ids is not None
+                and len(prefill_ids) >= INT32_TOKEN_IDS_MIN_LEN
+            ):
+                if prompt_ids is prefill_ids:
+                    packed = Int32TokenIds.from_sequence(prefill_ids)
+                    if packed is not None:
+                        state["prefill_token_ids"] = packed
+                        state["prompt_token_ids"] = (
+                            _PROMPT_PREFIX_SENTINEL,
+                            len(packed),
+                        )
+                        return state
+                packed_prefill = Int32TokenIds.from_sequence(prefill_ids)
+                packed_prompt = Int32TokenIds.from_sequence(prompt_ids)
+                if packed_prefill is not None and packed_prompt is not None:
+                    state["prefill_token_ids"] = packed_prefill
+                    prompt_len = len(packed_prompt)
+                    if prompt_len <= len(packed_prefill) and np.array_equal(
+                        packed_prefill._arr[:prompt_len], packed_prompt._arr
+                    ):
+                        state["prompt_token_ids"] = (
+                            _PROMPT_PREFIX_SENTINEL,
+                            prompt_len,
+                        )
+                    else:
+                        state["prompt_token_ids"] = packed_prompt
+                    return state
+
+            if (
+                prompt_ids is not None
+                and not isinstance(prompt_ids, Int32TokenIds)
+                and len(prompt_ids) >= INT32_TOKEN_IDS_MIN_LEN
+            ):
+                packed_prompt = Int32TokenIds.from_sequence(prompt_ids)
+                if packed_prompt is not None:
+                    state["prompt_token_ids"] = packed_prompt
+            if (
+                prefill_ids is not None
+                and not isinstance(prefill_ids, Int32TokenIds)
+                and len(prefill_ids) >= INT32_TOKEN_IDS_MIN_LEN
+            ):
+                packed_prefill = Int32TokenIds.from_sequence(prefill_ids)
+                if packed_prefill is not None:
+                    state["prefill_token_ids"] = packed_prefill
+        return state
+
+    def __setstate__(self, state: dict[str, Any]) -> None:
+        prompt_ids = state.get("prompt_token_ids")
+        if (
+            isinstance(prompt_ids, tuple)
+            and len(prompt_ids) == 2
+            and prompt_ids[0] == _PROMPT_PREFIX_SENTINEL
+        ):
+            prompt_len = int(prompt_ids[1])
+            prefill_ids = state.get("prefill_token_ids")
+            assert prefill_ids is not None
+            if prompt_len == len(prefill_ids):
+                state["prompt_token_ids"] = prefill_ids
+            else:
+                state["prompt_token_ids"] = prefill_ids[:prompt_len]
+        self.__dict__.update(state)
+
     @property
     def prompt_len(self) -> int:
         if self.prompt_token_ids is not None:
