+@pytest.mark.parametrize("num_reqs", [1, 2, 3, 7, 16, 32])
+@pytest.mark.parametrize("fraction", [0.1, 0.5, 0.9])
+def test_assign_draft_budget_with_continuation_value(num_reqs, fraction):
+    """Continuation-weighted draft budget against the torch reference, bit for bit,
+    plus bridge-preservation preference when two requests tie on prefix survival."""
+    from vllm.v1.worker.gpu.spec_decode.adaptive_verification import (
+        _assign_draft_token_budget,
+    )
+
+    gen = _gen(num_reqs * 19 + int(fraction * 10))
+    probs, idx, capacities = _budget_case(num_reqs, gen)
+    scheduled = int(capacities.sum())
+    budget = max(1, min(scheduled - 1, int(scheduled * fraction)))
+    if scheduled <= 1:
+        pytest.skip("no budget below the scheduled drafts")
+    alpha = 0.15
+    expected, actual = capacities.clone(), capacities.clone()
+    _assign_draft_token_budget(
+        probs, idx, expected, budget, DRAFTS, continuation_alpha=alpha
+    )
+    tli.assign_draft_budget(
+        probs, idx, actual, budget, DRAFTS, continuation_alpha=alpha
+    )
+    torch.accelerator.synchronize()
+    assert torch.equal(actual, expected)
+    assert int(actual.sum()) == budget
+
+    # Request 0 has slightly lower draft-1 survival (0.9 * 0.48 = 0.432) but strong
+    # continuation (0.95, 0.95, 0.95); Request 1 has higher draft-1 survival
+    # (0.9 * 0.50 = 0.450) but dead tail (0.05, 0.05, 0.05). At budget=3,
+    # continuation scoring awards the 3rd slot to Request 0's bridge draft.
+    pair_probs = torch.tensor(
+        [
+            [0.90, 0.48, 0.95, 0.95, 0.95],
+            [0.90, 0.50, 0.05, 0.05, 0.05],
+        ],
+        dtype=torch.float32,
+        device=DEVICE,
+    )
+    pair_idx = torch.tensor([0, 1], dtype=torch.int64, device=DEVICE)
+    myopic_caps = torch.tensor([5, 5], dtype=torch.int32, device=DEVICE)
+    cont_caps = torch.tensor([5, 5], dtype=torch.int32, device=DEVICE)
+    tli.assign_draft_budget(pair_probs, pair_idx, myopic_caps, 3, 5)
+    tli.assign_draft_budget(
+        pair_probs, pair_idx, cont_caps, 3, 5, continuation_alpha=0.15
+    )
+    torch.accelerator.synchronize()
+    assert myopic_caps.tolist() == [1, 2]
+    assert cont_caps.tolist() == [2, 1]
+
