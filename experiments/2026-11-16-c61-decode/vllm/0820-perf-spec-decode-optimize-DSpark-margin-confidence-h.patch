+def test_warm_start_irls_fisher_retention_damps_alternating_domain_swings():
+    """Alternating code and prose rounds must keep intercepts bounded without
+    erasing curvature, while stationary shifts still converge."""
+    device = torch.device("cuda")
+    torch.manual_seed(7)
+    est = OnlineAcceptanceEstimator.for_confidence_head(
+        8, 5, device, warm_start=True
+    )
+    est.reset_for_confidence_head(warm_start=True, with_margin=True)
+    est.REFIT_INTERVAL = 25
+    slots = torch.arange(8, device=device, dtype=torch.int32)
+    raw_probs = torch.full((8, 5), 0.75, dtype=torch.float32, device=device)
+    idx_mapping = slots.repeat_interleave(5)
+
+    # Alternate between high-acceptance code (p_0~0.75) and prose (p_0~0.55)
+    # rounds of 25 steps each; retained Fisher info damps per-round swing.
+    b0_history = []
+    for round_idx in range(8):
+        p_target = (
+            torch.tensor([0.75, 0.65, 0.58, 0.55, 0.52], device=device)
+            if round_idx % 2 == 0
+            else torch.tensor([0.55, 0.45, 0.40, 0.38, 0.35], device=device)
+        )
+        for _ in range(est.REFIT_INTERVAL):
+            probs = raw_probs.clone()
+            est.calibrate_confidence_probs(probs, idx_mapping)
+            draws = torch.rand(8, 5, device=device) < p_target
+            all_ok = draws.all(dim=1)
+            first_fail = (~draws).int().argmax(dim=1)
+            accepted = torch.where(all_ok, torch.full_like(first_fail, 5), first_fail)
+            num_sampled = (accepted + 1).to(torch.int32)
+            num_rejected = (5 - accepted).to(torch.int32)
+            est.step(slots, num_sampled, num_rejected)
+        b0_history.append(float(est.intercepts[0].item()))
+
+    max_swing = max(abs(b - a) for a, b in zip(b0_history, b0_history[1:]))
+    assert max_swing < 0.25, f"intercept swung by {max_swing:.3f}: {b0_history}"
+
+    # Under a sustained stationary regime, Fisher retention still adapts smoothly.
+    est_stat = OnlineAcceptanceEstimator.for_confidence_head(
+        8, 5, device, warm_start=True
+    )
+    est_stat.reset_for_confidence_head(warm_start=True, with_margin=True)
+    est_stat.REFIT_INTERVAL = 25
+    target_high = torch.tensor([0.85, 0.80, 0.75, 0.72, 0.70], device=device)
+    b0_start = float(est_stat.intercepts[0].item())
+    for _ in range(12 * est_stat.REFIT_INTERVAL):
+        probs = raw_probs.clone()
+        est_stat.calibrate_confidence_probs(probs, idx_mapping)
+        draws = torch.rand(8, 5, device=device) < target_high
+        all_ok = draws.all(dim=1)
+        first_fail = (~draws).int().argmax(dim=1)
+        accepted = torch.where(all_ok, torch.full_like(first_fail, 5), first_fail)
+        est_stat.step(
+            slots,
+            (accepted + 1).to(torch.int32),
+            (5 - accepted).to(torch.int32),
+        )
+    assert float(est_stat.intercepts[0].item()) > b0_start + 0.35
