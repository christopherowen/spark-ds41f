+    per_thread = max(-(-topk // _THREADS), 1)
+    return (
+        _DTYPES[logits_dtype],
+        _DTYPES[idx_dtype],
+        apply_temperature,
+        is_drafting,
+        None if cache_dtype is None else _DTYPES[cache_dtype],
+        None if cache_dtype is None or col_dtype is None else _DTYPES[col_dtype],
