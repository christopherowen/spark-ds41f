+++ b/tests/v1/spec_decode/test_acceptance_estimator.py
@@ -527,3 +527,64 @@ def test_confidence_head_online_irls_reduces_survival_mae():
     assert raw_mae > 0.15
     assert cal_mae < 0.03
     assert calibrated_survival[3].item() < 0.11
+
