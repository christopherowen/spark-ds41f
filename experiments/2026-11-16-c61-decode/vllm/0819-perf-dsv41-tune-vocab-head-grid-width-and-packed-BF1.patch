+    if hasattr(markov_layer, "packed_bf16_exponent_base"):
+        markov_screen_kernel(
+            markov_embed,
+            markov_layer.weight,
+            markov_layer.weight_exception_rows,
+            markov_layer.weight_exception_entries,
+            markov_layer.weight_row_offsets,
+            u_base_step,
+            row_bound,
+            x_norm_step,
+            bias_buf,
+            u_buf,
+            partial_vals,
+            partial_idxs,
+            tile_max_u,
+            active_count,
+            cut_cols,
+            vocab,
+        )
+    else:
+        markov_screen_kernel(
+            markov_embed,
+            markov_layer.weight,
+            u_base_step,
+            row_bound,
+            x_norm_step,
+            bias_buf,
+            u_buf,
+            partial_vals,
