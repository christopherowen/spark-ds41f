+def test_packed_head_screen_weights_clamps_extreme_outliers():
+    """Finite outlier exceptions are sign-clamped instead of zeroed in W_q,
+    while non-finite rows remain flagged with infinite residual bounds."""
+    from vllm.models.deepseek_v4_1.tilelang.vocab import (
+        build_screen_weights,
+        pack_bf16_weight,
+    )
+
+    n, k = 128, 512
+    weight = _head(n, k, seed=921)
+    weight[10, 0] = 2.5
+    weight[10, 1] = -0.5
+    weight[11, 0] = float("inf")
+    weight[12, 0] = float("nan")
+    packed = pack_bf16_weight(weight)
+    w_q, _, r_bound, _ = build_screen_weights(packed)
+    assert torch.isfinite(r_bound[:11]).all()
+    assert int(w_q[10, 0]) != 0
+    assert torch.isinf(r_bound[11]) and torch.isinf(r_bound[12])
+
