+            active_count,
+            cut_cols,
+            vocab,
+        )
+    top_k = 2 if top2 else 1
+    thresh_bias_kernel(
+        x_step,
+        head_layer.weight,
+        head_layer.weight_exception_entries,
+        head_layer.weight_row_offsets,
