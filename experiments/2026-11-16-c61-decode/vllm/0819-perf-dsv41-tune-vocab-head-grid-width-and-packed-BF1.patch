+@pytest.mark.parametrize("out_dtype", [torch.float32, torch.bfloat16])
+@pytest.mark.parametrize("markov_packed", [True, False])
+@pytest.mark.parametrize("top2", [False, True])
+def test_screened_markov_greedy_pairs_match_dense_and_replay(
+    out_dtype, markov_packed, top2
+):
+    n, k_head, k_markov = 1000, 512, 256
+    generator = torch.Generator(device=DEVICE).manual_seed(707 + int(markov_packed))
+    w_head = _head(n, k_head, seed=708)
+    w_head[77] = 0.0
+    w_head[100] = w_head[5]
+    w_head[301, 11] = 300.0
+    w_markov = (torch.randn(n, k_markov, generator=generator, device=DEVICE) * 0.05).bfloat16()
+    w_markov[100] = w_markov[5]
+    w_markov[301, 9] = -250.0 if markov_packed else -1.5
+
+    head_layer = _packed_layer(w_head)
+    prepare_packed_head(head_layer, out_dtype)
+    if markov_packed:
+        markov_layer = _packed_layer(w_markov)
+        markov_layer.tilelang_markov_head = True
+        prepare_packed_head(markov_layer, out_dtype)
+    else:
+        markov_layer = SimpleNamespace(weight=w_markov, tilelang_markov_head=True)
+        prepare_bf16_head(markov_layer, out_dtype)
+
+    x_head = (torch.randn(5, k_head, generator=generator, device=DEVICE) * 0.5).bfloat16()
+    x_head[0] = 0.0
+    x_head[1, 13] = float("nan")
+    x_head[2] = w_head[301]
+    me = (torch.randn(5, k_markov, generator=generator, device=DEVICE) * 0.5).bfloat16()
+
+    vocab, vocab_start = 963, 32320
+    base_logits = project_head(head_layer, x_head)
+    u_base, x_norm = screen_head_base(head_layer, x_head, vocab=vocab)
+    actual_steps = []
+    for i in range(5):
+        actual = project_head_screened_markov_greedy_pairs(
+            head_layer,
+            markov_layer,
+            x_head[i : i + 1],
+            u_base[i : i + 1],
+            x_norm[i : i + 1],
+            me[i : i + 1],
+            vocab=vocab,
+            vocab_start=vocab_start,
+            top2=top2,
+        )
+        expected = project_head_markov_greedy_pairs(
+            markov_layer,
+            me[i : i + 1],
+            base_logits[i : i + 1],
+            vocab=vocab,
+            vocab_start=vocab_start,
+            top2=top2,
+        )
+        assert torch.equal(
+            actual[:, :2].view(torch.int32), expected[:, :2].view(torch.int32)
+        ), (i, out_dtype, markov_packed, top2)
+        actual_steps.append(actual)
+
+    out_buf = torch.empty((1, 4), dtype=torch.float32, device=DEVICE)
+    graph = torch.cuda.CUDAGraph()
+    torch.cuda.synchronize()
+    with torch.cuda.graph(graph):
+        g_u, g_xn = screen_head_base(head_layer, x_head, vocab=vocab)
+        project_head_screened_markov_greedy_pairs(
+            head_layer,
+            markov_layer,
+            x_head[4:5],
+            g_u[4:5],
+            g_xn[4:5],
+            me[4:5],
+            vocab=vocab,
+            vocab_start=vocab_start,
+            out=out_buf,
+            top2=top2,
+        )
+    graph.replay()
+    assert torch.equal(
+        out_buf[:, :2].view(torch.int32), actual_steps[4][:, :2].view(torch.int32)
+    )
+    if top2:
+        assert torch.equal(
+            out_buf[:, 2:4].view(torch.int32), actual_steps[4][:, 2:4].view(torch.int32)
+        )
+
