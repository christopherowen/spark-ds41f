+def _open_fds_for(path: str) -> list[str]:
+    fds = pathlib.Path("/proc/self/fd")
+    out: list[str] = []
+    for fd in fds.iterdir():
+        try:
+            if os.path.realpath(fd) == path:
+                out.append(fd.name)
+        except OSError:
+            continue
+    return out
