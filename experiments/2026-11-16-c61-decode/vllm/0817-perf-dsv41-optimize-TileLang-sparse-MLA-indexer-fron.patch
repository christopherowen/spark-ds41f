+def test_decode_metadata_and_mask_lengths_skip_padding_rows():
+    """When ``is_padding`` marks dead/padding rows, ``mask_lengths``, ``chunk``,
+    and ``decode_metadata`` zero those rows' lengths and skip their page writes
+    while matching non-padded rows bit for bit."""
+    device = DEVICE
+    rows, width, page, window = 6, 128, 128, 128
+    pad = torch.tensor([0, 0, 1, 0, 1, 1], dtype=torch.bool, device=device)
+    lens = torch.tensor([1024, 512, 512, 256, 256, 256], dtype=torch.int32, device=device)
+    masked = metadata.mask_lengths(lens, pad, rows)
+    assert masked.tolist() == [1024, 512, 0, 256, 0, 0]
+
+    pos = torch.tensor([300, 301, 302, 303, 304, 305], dtype=torch.int64, device=device)
+    reqs = torch.zeros((rows,), dtype=torch.int32, device=device)
+    table = torch.arange(1, 33, dtype=torch.int32, device=device).unsqueeze(0).clone()
+    starts = torch.tensor([0, 6], dtype=torch.int32, device=device)
+    req_pos = torch.tensor([300], dtype=torch.int64, device=device)
+    vis = torch.tensor([512] * rows, dtype=torch.int32, device=device)
+    swa0 = torch.full((rows, width), -9, dtype=torch.int32, device=device)
+    l0 = torch.empty(rows, dtype=torch.int32, device=device)
+    top0 = torch.empty(rows, dtype=torch.int32, device=device)
+    swa1, l1, top1 = swa0.clone(), l0.clone(), top0.clone()
+    mp0 = torch.full((rows, 64), -9, dtype=torch.int32, device=device)
+    mp1 = mp0.clone()
+
+    metadata.decode_metadata(
+        pos, reqs, table, swa0, l0, top0, vis, starts, req_pos, reqs, table, mp0,
+        0, rows, 8, page=page, window=window, draft=False, main_page=128,
+    )
+    metadata.decode_metadata(
+        pos, reqs, table, swa1, l1, top1, vis, starts, req_pos, reqs, table, mp1,
+        0, rows, 8, page=page, window=window, draft=False, main_page=128,
+        is_padding=pad,
+    )
+    torch.accelerator.synchronize()
+    for r in (0, 1, 3):
+        assert l1[r] == l0[r] and top1[r] == top0[r]
+        assert torch.equal(swa1[r, : l1[r]], swa0[r, : l0[r]])
+        assert torch.equal(mp1[r, :4], mp0[r, :4])
+    for r in (2, 4, 5):
+        assert l1[r].item() == 0 and top1[r].item() == 0
+        assert bool((mp1[r] == -9).all())
+
+    metadata.chunk(
+        pos, reqs, table, swa0, l0, top0, vis, starts, req_pos,
+        0, rows, page=page, window=window, draft=False,
+    )
+    metadata.chunk(
+        pos, reqs, table, swa1, l1, top1, vis, starts, req_pos,
+        0, rows, page=page, window=window, draft=False, is_padding=pad,
+    )
+    torch.accelerator.synchronize()
+    for r in (0, 1, 3):
+        assert l1[r] == l0[r] and top1[r] == top0[r]
+        assert torch.equal(swa1[r, : l1[r]], swa0[r, : l0[r]])
+    for r in (2, 4, 5):
+        assert l1[r].item() == 0 and top1[r].item() == 0
+
+    # `pages` accepts a full-capacity `reqs` alongside a step-sized `masked` length
+    # tensor (e.g. CAP=1024 vs rows=6), matching live rows and leaving padded rows untouched.
+    reqs_long = torch.zeros((CAP,), dtype=torch.int32, device=device)
+    page_out0 = torch.full((rows, 16), -9, dtype=torch.int32, device=device)
+    page_out1 = page_out0.clone()
+    metadata.pages(reqs_long, lens, table, page_out0, 0, rows, 8, page=page)
+    metadata.pages(reqs_long, masked, table, page_out1, 0, rows, 8, page=page)
+    page_sub = torch.full((rows - 2, 16), -9, dtype=torch.int32, device=device)
+    metadata.pages(reqs_long, masked, table, page_sub, 2, rows - 2, 8, page=page)
+    torch.accelerator.synchronize()
+    live = _live_columns(reqs_long, masked, 0, rows, page, 8, 16)
+    _live_equal(page_out1, page_out0.cpu().long(), live, rows, sentinel=-9)
+    for r in (2, 4, 5):
+        assert bool((page_out1[r] == -9).all())
+    assert torch.equal(page_sub, page_out1[2:])
