+        and not getattr(roce_comm, "disabled", True)
+        and callable(should_rs)
+        and should_rs(buffer, 0)
+    ):
+        own = roce_comm.reduce_scatter(buffer, 0)
+    else:
+        own = reduce_scatter_rank_order(comm, buffer, rank, world)
+    should_ag = getattr(roce_comm, "should_all_gather", None)
+    if (
