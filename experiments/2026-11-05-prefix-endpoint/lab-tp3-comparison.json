        },
        {
          "config": "control-tp3-a.json",
          "label": "control-tp3-a",
          "startup_memory": true
        },
        {
          "config": "control-tp3-b.json",
          "label": "control-tp3-b",
          "startup_memory": true
        },
        {
          "config": "candidate-tp3-b.json",
          "label": "candidate-tp3-b",
          "startup_memory": true
        }
      ],
      "extras": [
        [
          "guarded_probe.py",
          [
            "--cluster-config",
            "experiments/2026-11-05-prefix-endpoint/{label}.json",
            "--out",
            "results/private/prefix-endpoint/{run}/{label}/rep-0",
            "--window-state",
            "results/private/prefix-endpoint/{run}/window.json"
