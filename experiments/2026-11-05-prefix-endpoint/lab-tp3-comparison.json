        [
          "guarded_probe.py",
          [
            "--cluster-config",
            "experiments/2026-11-05-prefix-endpoint/{label}.json",
            "--out",
            "results/private/prefix-endpoint/{run}/{label}/rep-1",
            "--window-state",
            "results/private/prefix-endpoint/{run}/window.json"
          ],
          "prefix-1"
        ],
        [
          "guarded_probe.py",
          [
            "--cluster-config",
            "experiments/2026-11-05-prefix-endpoint/{label}.json",
            "--out",
            "results/private/prefix-endpoint/{run}/{label}/rep-2",
            "--window-state",
            "results/private/prefix-endpoint/{run}/window.json"
          ],
          "prefix-2"
