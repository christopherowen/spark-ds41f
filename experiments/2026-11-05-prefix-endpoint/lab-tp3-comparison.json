{
  "experiment": "experiments/2026-11-05-prefix-endpoint",
  "run": "prefix-endpoint-tp3-controlled",
  "jobs": [
    {
      "kind": "measure",
      "bench": false,
      "bracket": false,
      "telemetry": true,
      "arms": [
        {
          "config": "candidate-tp3-a.json",
          "label": "candidate-tp3-a",
