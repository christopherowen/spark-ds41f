From 6c83ff0ea945bc67c4e0e8009428b4b0d152ab07 Mon Sep 17 00:00:00 2001
From: Christopher Owen <root@your.mom>
Date: Thu, 5 Nov 2026 14:50:28 +0100
Subject: [PATCH] Map tiny gather tails by rank and row

Upstream base: 613e76069b859c9ae3233f077a0f5c4b2fa8f7eb. Rationale: single-block tiny-tail screening does not establish an improvement. Map a warp directly to a rank/row instead, removing all division and distributing independent rows. Quality: wrapper validates every source/destination bound; each opaque word is copied exactly once. Larger-tail program and math are unchanged. Tests: existing payload matrix covers each unit and both regimes; two-boot performance and correctness pending. Upstream status: local experiment, not submitted.
---
 .../deepseek_v4_1/tilelang/collectives.py     | 40 ++++++++-----------
 1 file changed, 17 insertions(+), 23 deletions(-)

diff --git a/vllm/models/deepseek_v4_1/tilelang/collectives.py b/vllm/models/deepseek_v4_1/tilelang/collectives.py
index ea162f624b..20a8c9d8fe 100644
--- a/vllm/models/deepseek_v4_1/tilelang/collectives.py
+++ b/vllm/models/deepseek_v4_1/tilelang/collectives.py
@@ -461,7 +461,7 @@ def rank_rows_bytes_kernel(unit: int = 1):
     }
 )
 def rank_rows_small_kernel(unit: int):
-    """One 128-thread block for at most 128 opaque output words."""
+    """One warp per rank/row: tiny tails need no device integer division."""
     dtype = {1: T.uint8, 2: T.uint16, 4: T.uint32}[unit]
     source_units, output_units = T.dynamic("source_units, output_units")
 
@@ -472,21 +472,14 @@ def rank_rows_small_kernel(unit: int):
         world: T.int32,
         rows: T.int32,
         row_units: T.int32,
-        row_magic: T.uint32,
-        span_magic: T.uint32,
     ):
-        with T.Kernel(1, threads=128):
-            T.import_source(_TAIL_DIV)
-            index = T.get_thread_binding()
-            if index < output_units:
-                n = T.cast(index, T.uint32)
-                width = T.cast(row_units, T.uint32)
-                span = T.cast(world, T.uint32) * width
-                row = T.call_extern("uint32", "vllm_tail_div", n, span, span_magic)
-                col = n - row * span
-                rank = T.call_extern("uint32", "vllm_tail_div", col, width, row_magic)
-                local = col - rank * width
-                dst[index] = src[(rank * T.cast(rows, T.uint32) + row) * width + local]
+        with T.Kernel(world, rows, threads=32) as (rank, row):
+            for step in T.serial(T.ceildiv(row_units, 32)):
+                local = step * 32 + T.get_thread_binding()
+                if local < row_units:
+                    dst[(row * world + rank) * row_units + local] = src[
+                        (rank * rows + row) * row_units + local
+                    ]
 
     return collectives_rank_rows_small
 
@@ -496,20 +489,21 @@ def _rank_rows_tail(gathered, out, world, rows, row_bytes):
         n for n in (4, 2, 1) if row_bytes % n == 0 and gathered.data_ptr() % n == 0
     )
     dtype = {1: torch.uint8, 2: torch.uint16, 4: torch.uint32}[unit]
-    factory = (
-        rank_rows_small_kernel
-        if out.numel() * out.element_size() // unit <= 128
-        else rank_rows_bytes_kernel
-    )
-    factory(unit)(
+    args = (
         gathered.view(-1).view(dtype),
         out.view(-1).view(dtype),
         world,
         rows,
         row_bytes // unit,
-        _tail_div_magic(row_bytes // unit),
-        _tail_div_magic(world * (row_bytes // unit)),
     )
+    if out.numel() * out.element_size() // unit <= 128:
+        rank_rows_small_kernel(unit)(*args)
+    else:
+        rank_rows_bytes_kernel(unit)(
+            *args,
+            _tail_div_magic(row_bytes // unit),
+            _tail_div_magic(world * (row_bytes // unit)),
+        )
 
 
 def rank_rows_calls() -> list[prepare.TileLangCall]:
