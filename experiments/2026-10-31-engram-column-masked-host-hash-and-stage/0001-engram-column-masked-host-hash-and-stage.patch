diff --git a/tests/kernels/test_deepseek_v41_engram_host_placement.py b/tests/kernels/test_deepseek_v41_engram_host_placement.py
index 94ad78943..920091ff7 100644
--- a/tests/kernels/test_deepseek_v41_engram_host_placement.py
+++ b/tests/kernels/test_deepseek_v41_engram_host_placement.py
@@ -71,3 +71,33 @@ def test_dropped_rows_stay_unknown_in_the_step_ids():
     assert (ids[:6] == UNKNOWN).all()
     assert (ids[6:8] == 0).all()
     assert (ids[8:] == -1).all()
+
+
+def test_step_ids_layer_slices_are_contiguous_and_column_mask_matches_full_hash():
+    from vllm.models.deepseek_v4_1.engram_rows.host_hash import HostEngramHash
+
+    rng = np.random.default_rng(7)
+    token_map = rng.integers(0, 1000, size=256, dtype=np.int64)
+    multipliers = rng.integers(1, 1 << 30, size=(2, 4), dtype=np.int64)
+    primes = rng.integers(1000, 10000, size=(2, 24), dtype=np.int64)
+    offsets = rng.integers(0, 100000, size=(2, 24), dtype=np.int64)
+    host = HostEngramHash(token_map, multipliers, primes, offsets)
+
+    tokens = rng.integers(0, 256, size=32, dtype=np.int64)
+    reqs = [(0, 16, tokens, np.arange(16, dtype=np.int64))]
+    full = host.step_ids(20, reqs)
+    assert full.shape == (20, 2, 24)
+    for layer in range(2):
+        assert full[:, layer].flags.c_contiguous
+
+    for tp_size in (3, 4):
+        for tp_rank in range(tp_size):
+            owned = [c for c in range(24) if c % tp_size == tp_rank]
+            unowned = [c for c in range(24) if c % tp_size != tp_rank]
+            mask = sum(1 << c for c in owned)
+            masked = host.step_ids(20, reqs, columns=mask)
+            for layer in range(2):
+                assert masked[:, layer].flags.c_contiguous
+            assert np.array_equal(masked[:, :, owned], full[:, :, owned])
+            assert (masked[:16, :, unowned] == -1).all()
+            assert (masked[16:] == -1).all()
diff --git a/tests/kernels/test_deepseek_v41_engram_rows.py b/tests/kernels/test_deepseek_v41_engram_rows.py
index 4e358c4e8..872da4d08 100644
--- a/tests/kernels/test_deepseek_v41_engram_rows.py
+++ b/tests/kernels/test_deepseek_v41_engram_rows.py
@@ -525,3 +525,46 @@ def test_timeline_is_off_by_default():
     torch.cuda.synchronize()
     assert not rows.timeline_enabled and rows.timeline() == []
     rows.close()
+
+
+def test_column_masked_early_ids_skip_d2h_ids_copy_and_match_reference():
+    """When all early lookups are known (including column-masked host hashes where
+    unowned columns are -1) and check_early is False, stage() skips the D2H copy into
+    rows.ids while still gathering bit-identical BF16 rows."""
+    from vllm.models.deepseek_v4_1.engram_rows.host_hash import UNKNOWN
+
+    codes, scales, paths = _write_table(_table_dir(), seed=35)
+    rows = _rows(paths, tokens=8, columns=TP3_RANK1, check_early=False)
+    try:
+        rows.ids.fill_(-42)
+        gen = torch.Generator().manual_seed(36)
+        ids = torch.randint(0, TABLE_ROWS, (8, HEADS), generator=gen)
+        early = ids.clone().numpy()
+        unowned = [c for c in range(HEADS) if not ((TP3_RANK1 >> c) & 1)]
+        early[:, unowned] = -1
+
+        out = torch.full(
+            (8, 8 * 256), 7, dtype=torch.bfloat16, device="cuda"
+        )
+        num_tokens = torch.tensor([7], dtype=torch.int32, device="cuda")
+        stream = torch.cuda.current_stream()
+        rows.stage(stream, ids.cuda(), ids.numel(), early)
+        rows.gather(out, ids.cuda(), num_tokens)
+        torch.cuda.synchronize()
+
+        expected = _reference(codes, scales, ids, 7, 0, TABLE_ROWS, TP3_RANK1)
+        torch.testing.assert_close(out.cpu(), expected, rtol=0, atol=0, equal_nan=True)
+        # Because early had no UNKNOWN entries and check_early=False, rows.ids was not
+        # overwritten by a D2H copy.
+        assert (rows.ids == -42).all()
+
+        # When early contains an UNKNOWN entry, stage() copies the GPU IDs into rows.ids.
+        early_partial = early.copy()
+        early_partial[3, 1] = UNKNOWN
+        rows.stage(stream, ids.cuda(), ids.numel(), early_partial)
+        rows.gather(out, ids.cuda(), num_tokens)
+        torch.cuda.synchronize()
+        torch.testing.assert_close(out.cpu(), expected, rtol=0, atol=0, equal_nan=True)
+        assert torch.equal(rows.ids[: ids.numel()], ids.view(-1))
+    finally:
+        rows.close()
