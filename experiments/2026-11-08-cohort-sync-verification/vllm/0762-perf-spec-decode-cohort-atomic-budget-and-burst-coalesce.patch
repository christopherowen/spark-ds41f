+def test_high_row_cost_ceiling_bounds_c16_prose_without_penalizing_code():
+    """Above 40 rows, the second 32-row CTA / MXFP8 block slope prunes low-yield
+    2nd and 3rd prose drafts at c16 while still admitting high-confidence code drafts."""
+    req_ids = [f"r{i}" for i in range(16)]
+    num_tokens_per_req = {rid: 6 for rid in req_ids}
+    draft_tokens = {rid: [1, 2, 3, 4, 5] for rid in req_ids}
+
+    prose_med = np.tile(
+        np.array([[0.66, 0.48, 0.44, 0.42, 0.40]], dtype=np.float32), (16, 1)
+    )
+    manager = make_manager(prose_med, row_cost=0.035)
+    manager.req_states.req_id_to_index = {rid: i for i, rid in enumerate(req_ids)}
+    manager.dead_rows_tau = 0.20
+    manager.calibrated_confidence = True
+
+    manager.high_row_cost_ceiling = 1000
+    assert manager.get_num_tokens(num_tokens_per_req, draft_tokens) == 48
+
+    manager.high_row_cost_ceiling = 40
+    assert manager.get_num_tokens(num_tokens_per_req, draft_tokens) == 32
+
+    code_hi = np.tile(
+        np.array([[0.86, 0.78, 0.74, 0.65, 0.60]], dtype=np.float32), (16, 1)
+    )
+    manager._stale_confidences = [SimpleNamespace(np=code_hi)]
+    assert manager.get_num_tokens(num_tokens_per_req, draft_tokens) == 64
+
+
+def test_cohort_locking_preserves_synchronized_wave_and_catches_up_split_lead():
+    """A 1+15 split wave keeps the 15 trailing streams unified against 1-ULP
+    confidence noise and phase-locks all 16 streams onto the same token position."""
+    req_ids = [f"r{i}" for i in range(16)]
+    num_tokens_per_req = {rid: 6 for rid in req_ids}
+    draft_tokens = {rid: [1, 2, 3, 4, 5] for rid in req_ids}
+
+    conf = np.ones((16, 5), dtype=np.float32)
+    conf[0] = [0.66, 0.54, 0.45, 0.40, 0.38]
+    for i in range(1, 16):
+        eps = 0.0015 if (i % 2 == 0) else 0.0
+        conf[i] = [0.72 + eps, 0.58 + eps, 0.48 + eps, 0.42 + eps, 0.39 + eps]
+
+    manager = make_manager(conf, row_cost=0.035)
+    manager.req_states.req_id_to_index = {rid: i for i, rid in enumerate(req_ids)}
+    manager.req_states.num_computed_tokens_np = np.array(
+        [249] + [246] * 15, dtype=np.int32
+    )
+    manager.req_states.prefill_len.np = np.full(16, 246, dtype=np.int32)
+    manager.dead_rows_tau = 0.20
+    manager.calibrated_confidence = True
+
+    manager.get_num_tokens(num_tokens_per_req, draft_tokens)
+    caps = [manager._capacities_cpu_override[rid] for rid in req_ids]
+    assert caps[0] == 0
+    assert len(set(caps[1:])) == 1
+    assert 1 <= caps[1] <= 3
+    assert manager.dead_row_args(torch.zeros(48, dtype=torch.bool), 16) is None
diff --git a/vllm/v1/engine/core.py b/vllm/v1/engine/core.py
index 8c28414..888474e 100644
--- a/vllm/v1/engine/core.py
+++ b/vllm/v1/engine/core.py
@@ -1619,10 +1619,44 @@ class EngineCoreProc(EngineCore):
             )
             self.output_queue.put_nowait((-1, EngineCoreOutputs(scheduler_stats=stats)))
 
+    idle_wakeup_first_poll_s: float = 0.0003
+    idle_wakeup_burst_poll_s: float = 0.0005
+
+    def _coalesce_idle_burst(self) -> None:
+        """Coalesce a concurrent request burst waking an idle engine so all
+        streams of a burst wave enter the first prefill step together."""
+        self._admit_arrivals()
+        scheduler_config = getattr(
+            getattr(self, "vllm_config", None), "scheduler_config", None
+        )
+        max_num_seqs = int(getattr(scheduler_config, "max_num_seqs", 16) or 16)
+        if max_num_seqs <= 1:
+            return
+        first_poll_s = float(getattr(self, "idle_wakeup_first_poll_s", 0.0003))
+        burst_poll_s = float(getattr(self, "idle_wakeup_burst_poll_s", 0.0005))
+        if first_poll_s <= 0:
+            return
+        try:
+            req = self.input_queue.get(timeout=first_poll_s)
+        except queue.Empty:
+            return
+        self._handle_client_request(*req)
+        self._admit_arrivals()
+        for _ in range(max_num_seqs - 2):
+            if burst_poll_s <= 0:
+                break
+            try:
+                req = self.input_queue.get(timeout=burst_poll_s)
+            except queue.Empty:
+                break
+            self._handle_client_request(*req)
+            self._admit_arrivals()
+
     def _process_input_queue(self):
         """Exits when an engine step needs to be performed."""
 
         waited = False
+        blocked_from_idle = False
         while not self.has_work() and self.is_running():
             # Notify callbacks waiting for engine to become idle.
             self._notify_idle_state_callbacks()
@@ -1639,6 +1673,8 @@ class EngineCoreProc(EngineCore):
             try:
                 req = self.input_queue.get(block=block)
                 self._handle_client_request(*req)
+                if block:
+                    blocked_from_idle = True
             except queue.Empty:
                 break
             if not block:
@@ -1648,7 +1684,10 @@ class EngineCoreProc(EngineCore):
             logger.debug("EngineCore loop active.")
 
         # Handle any more client requests.
-        self._admit_arrivals()
+        if blocked_from_idle and self.has_work():
+            self._coalesce_idle_burst()
+        else:
+            self._admit_arrivals()
 
     def _admit_arrivals(self) -> None:
         """Handle every client request that has arrived, without blocking."""
