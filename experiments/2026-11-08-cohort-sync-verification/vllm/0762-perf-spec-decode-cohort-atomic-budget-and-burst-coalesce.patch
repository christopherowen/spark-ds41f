index e095f67..68f3b26 100644
--- a/tests/v1/engine/test_late_admission.py
+++ b/tests/v1/engine/test_late_admission.py
@@ -239,3 +239,37 @@ def test_the_engine_process_admits_every_queued_request_without_blocking():
     ]
     engine._admit_arrivals()  # an empty queue returns at once
     assert engine._handle_client_request.call_count == 2
+
+
+def test_idle_wakeup_coalesces_concurrent_arrival_burst():
+    import threading
+    import time
+
+    engine = object.__new__(EngineCoreProc)
+    engine.input_queue = queue.Queue()
+    engine.aborts_queue = queue.Queue()
+    engine._idle_state_callbacks = []
+    engine._loop_watchdog = None
+    engine.process_input_queue_block = True
+    engine.vllm_config = SimpleNamespace(
+        scheduler_config=SimpleNamespace(max_num_seqs=16)
+    )
+    admitted: list[int] = []
+    engine.has_work = lambda: len(admitted) > 0
+    engine.is_running = lambda: True
+
+    def handle(_kind, req_id):
+        admitted.append(req_id)
+
+    engine._handle_client_request = handle
+
+    def feed_burst():
+        for i in range(16):
+            engine.input_queue.put(("add", i))
+            time.sleep(0.0001)
+
+    feeder = threading.Thread(target=feed_burst, daemon=True)
+    feeder.start()
+    engine._process_input_queue()
+    feeder.join(timeout=1.0)
+    assert admitted == list(range(16))
