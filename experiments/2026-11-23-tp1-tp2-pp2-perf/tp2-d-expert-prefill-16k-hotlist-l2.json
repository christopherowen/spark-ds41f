{
  "notes": "tp2-direct 252/64 slots, decent 6.00 GiB KV (~24.6x 256K / ~6.1x 1M ctx), adaptive rc=0.15 tau=0.35, expert-centric prefill 8K, and empirical hotlist static placement",
  "extends": {
    "config": "config/cluster.json",
    "shape": "tp2-direct"
  },
  "set": {
    "deployment": {
      "branch": "tp1-tp2-pp2-perf"
    },
    "sizing": {
      "kv_cache_memory_bytes": 6442450944,
      "max_num_batched_tokens": 8192
    },
    "speculative": {
      "enable_adaptive_verification": true,
      "adaptive_verification_row_cost": 0.15
    },
    "container": {
      "mounts": [
        [
          "{checkout}/cache",
          "/cache",
          "rw"
        ],
        [
          "{checkout}/experiments/2026-11-23-tp1-tp2-pp2-perf/overlay/vllm/vllm/models/deepseek_v4_1/expert_slots/cache.py",
          "/opt/spark-ds41f/candidate/vllm/vllm/models/deepseek_v4_1/expert_slots/cache.py",
          "ro"
        ],
        [
          "{checkout}/experiments/2026-11-23-tp1-tp2-pp2-perf/overlay/vllm/vllm/models/deepseek_v4_1/nvidia/model.py",
          "/opt/spark-ds41f/candidate/vllm/vllm/models/deepseek_v4_1/nvidia/model.py",
          "ro"
        ]
      ]
    },
    "environment": {
      "VLLM_DS41_EXPERT_SLOTS": "252",
      "SPARK_DS41F_DSPARK_DEAD_ROWS_TAU": "0.35",
      "VLLM_DS41_EXPERT_PREFILL_MODE": "expert",
      "VLLM_DS41_EXPERT_HOTLIST_PATH": "/cache/ds41_expert_slots/hotlist-tp2"
    }
  },
  "serve_options": {
    "--kv-cache-memory-bytes": "6442450944",
    "--max-num-batched-tokens": "8192",
    "--long-prefill-token-threshold": "8000"
  }
}
