{
  "notes": "tp1 with 112/48 slots, 8.00 GiB KV, expert-centric prefill, 16K batched tokens, and empirical hotlist static placement",
  "extends": {
    "config": "config/cluster.json",
    "shape": "tp1"
  },
  "set": {
    "sizing": {
      "max_num_batched_tokens": 16384
    },
    "container": {
      "mounts": [
        [
          "{checkout}/cache",
          "/cache",
          "rw"
        ],
        [
          "{checkout}/experiments/2026-11-23-tp1-tp2-pp2-perf/overlay/vllm/vllm/models/deepseek_v4_1/expert_slots/cache.py",
          "/opt/spark-ds41f/candidate/vllm/vllm/models/deepseek_v4_1/expert_slots/cache.py",
          "ro"
        ],
        [
          "{checkout}/experiments/2026-11-23-tp1-tp2-pp2-perf/overlay/vllm/vllm/models/deepseek_v4_1/nvidia/model.py",
          "/opt/spark-ds41f/candidate/vllm/vllm/models/deepseek_v4_1/nvidia/model.py",
          "ro"
        ]
      ]
    },
    "environment": {
      "VLLM_DS41_EXPERT_SLOTS": "112",
      "VLLM_DS41_EXPERT_PREFILL_MODE": "expert",
      "VLLM_DS41_EXPERT_HOTLIST_PATH": "/cache/ds41_expert_slots/hotlist-tp1"
    },
    "deployment": {
      "branch": "tp1-tp2-pp2-perf"
    }
  }
}
