{
  "notes": "tp1 with 112/48 resident slots (+16 static slots) keeping full 8.00 GiB KV (~34x 256K / ~8.5x 1M ctx)",
  "extends": {
    "config": "config/cluster.json",
    "shape": "tp1"
  },
  "set": {
    "container": {
      "mounts": [
        [
          "{checkout}/cache",
          "/cache",
          "rw"
        ],
        [
          "{checkout}/experiments/2026-11-23-tp1-tp2-pp2-perf/overlay/vllm/vllm/models/deepseek_v4_1/expert_slots/cache.py",
          "/opt/spark-ds41f/candidate/vllm/vllm/models/deepseek_v4_1/expert_slots/cache.py",
          "ro"
        ]
      ]
    },
    "environment": {
      "VLLM_DS41_EXPERT_SLOTS": "112",
      "VLLM_DS41_EXPERT_HOTLIST_DUMP": "/cache/ds41_expert_slots/hotlist-tp1"
    },
    "deployment": {
      "branch": "tp1-tp2-pp2-perf"
    }
  }
}
