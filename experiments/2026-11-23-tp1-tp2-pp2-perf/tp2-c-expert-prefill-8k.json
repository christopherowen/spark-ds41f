{
  "notes": "tp2-direct 252/64 slots, 6.00 GiB KV, adaptive rc=0.25, expert-centric prefill streaming, 8K batched tokens",
  "extends": {
    "config": "config/cluster.json",
    "shape": "tp2-direct"
  },
  "set": {
    "sizing": {
      "kv_cache_memory_bytes": 6442450944,
      "max_num_batched_tokens": 8192
    },
    "speculative": {
      "enable_adaptive_verification": true,
      "adaptive_verification_row_cost": 0.25
    },
    "container": {
      "mounts": [
        [
          "{checkout}/cache",
          "/cache",
          "rw"
        ],
        [
          "{checkout}/experiments/2026-11-23-tp1-tp2-pp2-perf/overlay/vllm/vllm/models/deepseek_v4_1/expert_slots/cache.py",
          "/opt/spark-ds41f/candidate/vllm/vllm/models/deepseek_v4_1/expert_slots/cache.py",
          "ro"
        ]
      ]
    },
    "environment": {
      "VLLM_DS41_EXPERT_SLOTS": "252",
      "SPARK_DS41F_DSPARK_DEAD_ROWS_TAU": "0.45",
      "VLLM_DS41_EXPERT_PREFILL_MODE": "expert"
    },
    "deployment": {
      "branch": "tp1-tp2-pp2-perf"
    }
  }
}
