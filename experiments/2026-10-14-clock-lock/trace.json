{
  "experiment": "experiments/2026-10-14-clock-lock",
  "run": "clock-trace",
  "jobs": [
    {
      "kind": "sync"
    },
    {
      "kind": "measure",
      "bench": false,
      "bracket": false,
      "extras": [
        [
          "scripts/servebench_run.py",
          [
            "--mode",
            "closed",
            "--concurrency",
            "16",
            "--warmup",
            "60",
            "--duration",
            "300",
            "--extra-body",
            "{\"chat_template_kwargs\":{\"thinking\":false}}",
            "--label",
            "r6k-unlocked-c16",
            "--output",
            "results/private/clock-lock/r6k-unlocked-c16.json"
          ],
          "closed-c16"
        ],
        [
          "scripts/servebench_engine.py",
          [
            "--label",
            "r6k-unlocked-grid1",
            "--output",
            "results/private/clock-lock/r6k-unlocked-grid1.json"
          ],
          "engine-grid1"
        ]
      ],
      "arms": [
        {
          "config": "experiments/2026-10-14-servebench/engine-r6k.json",
          "label": "r6k-unlocked"
        }
      ]
    }
  ]
}
