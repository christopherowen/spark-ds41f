{
  "experiment": "experiments/2026-10-14-clock-lock",
  "run": "clock-locked",
  "jobs": [
    {
      "kind": "sync"
    },
    {
      "kind": "gpu_clocks",
      "lock_mhz": [
        2489,
        2489
      ]
    },
    {
      "kind": "measure",
      "suite": "screen",
      "arms": [
        {
          "config": "experiments/2026-10-14-servebench/engine-r6k.json",
          "label": "r6k"
        },
        {
          "config": "experiments/2026-10-14-servebench/engine-r6h.json",
          "label": "r6h"
        },
        {
          "config": "experiments/2026-10-14-servebench/engine-r6k.json",
          "label": "r6k-again"
        }
      ]
    },
    {
      "kind": "gpu_clocks",
      "reset": true
    }
  ]
}
