+"""Per-rank on-disk cache for post-load weight artifacts (12-bit BF16 packs and MoE scale codes).
+
+First start writes prepared buffers asynchronously on a single background thread
+into a PID-scoped staging file (``*.tmp.<pid>``) and publishes them atomically via
+``os.replace`` when free disk space is at least 8 GiB. ``loading_done()`` joins the
+background writer at the end of model post-load processing.
+
+Cached starts read the prepared buffer directly from disk and verify integrity
+without hashing the full tensor by recomputing the reference transform on four
+slices (``first``, ``first + 1``, ``last``, and one per-boot random index) from the
+loaded checkpoint tensor and comparing them byte-for-byte before mutating weights
+in place. Any mismatch or I/O error falls back to full post-load computation and
+replaces the cache entry.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Iterator, Sequence
+from concurrent.futures import Future, ThreadPoolExecutor
+from contextlib import contextmanager
+from dataclasses import dataclass
+import errno
+import hashlib
+import mmap
+import os
+from pathlib import Path
+import random
+import re
+import shutil
+import struct
+import threading
+from typing import Any
+
+import torch
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+FORMAT_VERSION = 1
+MIN_FREE_DISK_BYTES = 8 * (1 << 30)  # 8 GiB free disk space guard
+PACK12_MAGIC = b"DS41PK12"
+MOE_SCALE_MAGIC = b"DS41MOSC"
+_HEADER_STRUCT = struct.Struct("<8sIIIIIIQQ")
+_TMP_PID_RE = re.compile(r"^.+\.tmp\.(\d+)$")
+_SAFE_TAG_RE = re.compile(r"[^A-Za-z0-9_.-]+")
+
+# Seeded once per process boot so the random slice index is fixed within a boot
+# and varies across boots.
+_BOOT_RNG = random.Random(int.from_bytes(os.urandom(8), "little"))
+_BOOT_RANDOM_INDICES: dict[int, int] = {}
+_BOOT_RNG_LOCK = threading.Lock()
+
+
+@dataclass
+class PostloadCacheStats:
+    """Counters for observability and unit tests."""
+
+    hits: int = 0
+    misses: int = 0
+    corruptions: int = 0
+    writes_completed: int = 0
+    writes_skipped_low_disk: int = 0
+    dead_staging_cleaned: int = 0
+
+
+@dataclass
+class _CacheConfig:
+    cache_dir: Path | None = None
+    checkpoint_path: Path | None = None
+    tp_rank: int | None = None
+    tp_world_size: int | None = None
+    min_free_bytes: int = MIN_FREE_DISK_BYTES
+
+
+_STATE_LOCK = threading.Lock()
+_CONFIG = _CacheConfig()
+_STATS = PostloadCacheStats()
+_CleanedDirs: set[Path] = set()
+_MODULE_STACK: list[str] = []
+_CALL_COUNTERS: dict[str, int] = {}
+_CKPT_FP_CACHE: dict[str, list[tuple[str, int, int]]] = {}
+_WRITER_EXECUTOR: ThreadPoolExecutor | None = None
+_PENDING_FUTURES: list[Future[None]] = []
+_BG_COPY_STREAM: torch.cuda.Stream | None = None
+_READ_SCRATCH: torch.Tensor | None = None
+
+
+def get_postload_cache_stats() -> PostloadCacheStats:
+    return _STATS
+
+
+def reset_postload_cache_stats() -> None:
+    global _STATS
+    with _STATE_LOCK:
+        _STATS = PostloadCacheStats()
+
+
+def reset_postload_cache_counter() -> None:
+    with _STATE_LOCK:
+        _CALL_COUNTERS.clear()
+
+
+def _is_pid_alive(pid: int) -> bool:
+    if pid <= 0:
+        return False
+    if pid == os.getpid():
+        return True
+    try:
+        os.kill(pid, 0)
+    except ProcessLookupError:
+        return False
+    except PermissionError:
+        return True
+    except OSError as exc:
+        if exc.errno == errno.ESRCH:
+            return False
+        return True
+    return True
+
+
+def cleanup_dead_pid_staging_files(cache_dir: str | Path) -> list[Path]:
+    """Remove ``*.tmp.<pid>`` staging files left behind by dead processes."""
+    directory = Path(cache_dir)
+    if not directory.is_dir():
+        return []
+    removed: list[Path] = []
+    try:
+        entries = list(directory.iterdir())
+    except OSError:
+        return []
+    for entry in entries:
+        match = _TMP_PID_RE.match(entry.name)
+        if match is None:
+            continue
+        pid = int(match.group(1))
+        if not _is_pid_alive(pid):
+            try:
+                entry.unlink()
+                removed.append(entry)
+                with _STATE_LOCK:
+                    _STATS.dead_staging_cleaned += 1
+            except FileNotFoundError:
+                pass
+            except OSError as exc:
+                logger.debug("Failed to unlink dead staging file %s: %s", entry, exc)
+    return removed
+
+
+def has_sufficient_disk_space(
+    cache_dir: str | Path, min_free_bytes: int | None = None
+) -> bool:
+    """Return whether ``cache_dir`` has at least ``min_free_bytes`` (default 8 GiB) free."""
+    threshold = _CONFIG.min_free_bytes if min_free_bytes is None else min_free_bytes
+    directory = Path(cache_dir)
+    target = directory if directory.exists() else directory.parent
+    try:
+        usage = shutil.disk_usage(target)
+    except OSError:
+        return False
+    return int(usage.free) >= int(threshold)
+
+
+def spot_check_indices(n: int) -> tuple[int, int, int, int]:
+    """Return ``(first, first + 1, last, random_per_boot)`` slice indices in ``0..n - 1``."""
+    if n <= 0:
+        raise ValueError(f"spot_check_indices requires n >= 1, got {n}")
+    first = 0
+    second = min(1, n - 1)
+    last = n - 1
+    with _BOOT_RNG_LOCK:
+        rand_idx = _BOOT_RANDOM_INDICES.get(n)
+        if rand_idx is None:
+            if n > 3:
+                rand_idx = _BOOT_RNG.randrange(2, n - 1)
+            else:
+                rand_idx = _BOOT_RNG.randrange(0, n)
+            _BOOT_RANDOM_INDICES[n] = rand_idx
+    return (first, second, last, rand_idx)
+
+
+def configure_postload_cache(
+    cache_dir: str | Path | None,
+    *,
+    checkpoint_path: str | Path | None = None,
+    tp_rank: int | None = None,
+    tp_world_size: int | None = None,
+    min_free_bytes: int = MIN_FREE_DISK_BYTES,
+) -> None:
+    """Configure the per-rank on-disk post-load artifact cache."""
+    resolved_dir = Path(cache_dir) if cache_dir else None
+    resolved_ckpt = Path(checkpoint_path) if checkpoint_path else None
+    with _STATE_LOCK:
+        _CONFIG.cache_dir = resolved_dir
+        _CONFIG.checkpoint_path = resolved_ckpt
+        _CONFIG.tp_rank = tp_rank
+        _CONFIG.tp_world_size = tp_world_size
+        _CONFIG.min_free_bytes = min_free_bytes
+        _CALL_COUNTERS.clear()
+        _CKPT_FP_CACHE.clear()
+    if resolved_dir is not None:
+        resolved_dir.mkdir(parents=True, exist_ok=True)
+        cleanup_dead_pid_staging_files(resolved_dir)
+
+
+@contextmanager
+def postload_cache_context(
+    cache_dir: str | Path | None,
+    *,
+    checkpoint_path: str | Path | None = None,
+    tp_rank: int | None = None,
+    tp_world_size: int | None = None,
+    min_free_bytes: int = MIN_FREE_DISK_BYTES,
+) -> Iterator[None]:
+    prev = _CacheConfig(
+        cache_dir=_CONFIG.cache_dir,
+        checkpoint_path=_CONFIG.checkpoint_path,
+        tp_rank=_CONFIG.tp_rank,
+        tp_world_size=_CONFIG.tp_world_size,
+        min_free_bytes=_CONFIG.min_free_bytes,
+    )
+    configure_postload_cache(
+        cache_dir,
+        checkpoint_path=checkpoint_path,
+        tp_rank=tp_rank,
+        tp_world_size=tp_world_size,
+        min_free_bytes=min_free_bytes,
+    )
+    try:
+        yield
+    finally:
+        loading_done()
+        with _STATE_LOCK:
+            _CONFIG.cache_dir = prev.cache_dir
+            _CONFIG.checkpoint_path = prev.checkpoint_path
+            _CONFIG.tp_rank = prev.tp_rank
+            _CONFIG.tp_world_size = prev.tp_world_size
+            _CONFIG.min_free_bytes = prev.min_free_bytes
+            _CALL_COUNTERS.clear()
+            _CKPT_FP_CACHE.clear()
+
+
+@contextmanager
+def postload_model_scope(model_config: Any | None = None) -> Iterator[None]:
+    """Scope around ``process_weights_after_loading`` that sets checkpoint identity
+    and flushes background writes at exit."""
+    reset_postload_cache_counter()
+    prev_ckpt = _CONFIG.checkpoint_path
+    model_path = getattr(model_config, "model", None) if model_config is not None else None
+    if _CONFIG.checkpoint_path is None and model_path:
+        candidate = Path(str(model_path))
+        if candidate.exists():
+            with _STATE_LOCK:
+                _CONFIG.checkpoint_path = candidate
+                _CKPT_FP_CACHE.clear()
+    cache_dir = get_postload_cache_dir()
+    if cache_dir is not None and cache_dir not in _CleanedDirs:
+        cache_dir.mkdir(parents=True, exist_ok=True)
+        cleanup_dead_pid_staging_files(cache_dir)
+        _CleanedDirs.add(cache_dir)
+    try:
+        yield
+    finally:
+        loading_done()
+        with _STATE_LOCK:
+            _CONFIG.checkpoint_path = prev_ckpt
+            _CALL_COUNTERS.clear()
+            _CKPT_FP_CACHE.clear()
+
+
+@contextmanager
+def postload_module_scope(module_name: str) -> Iterator[None]:
+    """Bind the active module name for post-load cache key disambiguation."""
+    _MODULE_STACK.append(module_name)
+    try:
+        yield
+    finally:
+        _MODULE_STACK.pop()
+
+
+def get_postload_cache_dir() -> Path | None:
+    if _CONFIG.cache_dir is not None:
+        return _CONFIG.cache_dir
+    env_dir = os.environ.get("VLLM_POSTLOAD_CACHE_DIR") or os.environ.get(
+        "SPARK_DS41F_POSTLOAD_CACHE_DIR"
+    )
+    if not env_dir:
+        return None
+    return Path(env_dir)
+
+
+def _resolve_tp_identity() -> tuple[int, int]:
+    if _CONFIG.tp_rank is not None and _CONFIG.tp_world_size is not None:
+        return int(_CONFIG.tp_rank), int(_CONFIG.tp_world_size)
+    try:
+        from vllm.distributed import (
+            get_tensor_model_parallel_rank,
+            get_tensor_model_parallel_world_size,
+            model_parallel_is_initialized,
+        )
+
+        if model_parallel_is_initialized():
+            rank = (
+                int(_CONFIG.tp_rank)
+                if _CONFIG.tp_rank is not None
+                else int(get_tensor_model_parallel_rank())
+            )
+            world = (
+                int(_CONFIG.tp_world_size)
+                if _CONFIG.tp_world_size is not None
+                else int(get_tensor_model_parallel_world_size())
+            )
+            return rank, world
+    except Exception:
+        pass
+    return (
+        int(_CONFIG.tp_rank) if _CONFIG.tp_rank is not None else 0,
+        int(_CONFIG.tp_world_size) if _CONFIG.tp_world_size is not None else 1,
+    )
+
+
+def _checkpoint_fingerprint() -> list[tuple[str, int, int]]:
+    ckpt = _CONFIG.checkpoint_path
+    if ckpt is None:
+        env_ckpt = os.environ.get("VLLM_POSTLOAD_CHECKPOINT_PATH")
+        if env_ckpt:
+            ckpt = Path(env_ckpt)
+    if ckpt is None or not ckpt.exists():
+        return []
+    key = str(ckpt)
+    try:
+        dir_st = ckpt.stat()
+        cache_key = f"{key}:{dir_st.st_mtime_ns}:{dir_st.st_size}"
+    except OSError:
+        return []
+    cached = _CKPT_FP_CACHE.get(cache_key)
+    if cached is not None:
+        return cached
+    try:
+        if ckpt.is_file():
+            fp = [(ckpt.name, int(dir_st.st_size), int(dir_st.st_mtime_ns))]
+        elif ckpt.is_dir():
+            safetensors = sorted(ckpt.glob("*.safetensors"))
+            files = safetensors if safetensors else sorted(
+                p for p in ckpt.iterdir() if p.is_file()
+            )
+            fp = [
+                (p.name, int(st.st_size), int(st.st_mtime_ns))
+                for p in files
+                if (st := p.stat()) is not None
+            ]
+        else:
+            fp = []
+    except OSError:
+        return []
+    _CKPT_FP_CACHE[cache_key] = fp
+    return fp
+
+
+def _resolve_tag(kind: str, explicit_tag: str | None) -> str:
+    module_name = _MODULE_STACK[-1] if _MODULE_STACK else ""
+    if module_name and explicit_tag:
+        return f"{module_name}.{explicit_tag}"
+    if explicit_tag:
+        return explicit_tag
+    with _STATE_LOCK:
+        scope_key = f"{kind}:{module_name}"
+        idx = _CALL_COUNTERS.get(scope_key, 0)
+        _CALL_COUNTERS[scope_key] = idx + 1
+    if module_name:
+        return f"{module_name}.{idx}"
+    return f"{kind}.{idx}"
+
+
+def _cache_file_path(
+    cache_dir: Path,
+    kind: str,
+    shape_meta: tuple[int, ...],
+    resolved_tag: str,
+) -> Path:
+    tp_rank, tp_world = _resolve_tp_identity()
+    ckpt_fp = _checkpoint_fingerprint()
+    key_payload = repr(
+        (
+            FORMAT_VERSION,
+            kind,
+            tp_rank,
+            tp_world,
+            shape_meta,
+            resolved_tag,
+            ckpt_fp,
+        )
+    ).encode("utf-8")
+    digest = hashlib.sha256(key_payload).hexdigest()[:16]
+    safe_tag = _SAFE_TAG_RE.sub("_", resolved_tag).strip("._") or kind
+    if len(safe_tag) > 64:
+        safe_tag = safe_tag[-64:]
+    filename = (
+        f"{kind}_v{FORMAT_VERSION}_tp{tp_rank}of{tp_world}_{safe_tag}_{digest}.bin"
+    )
+    return cache_dir / filename
+
+
+def _read_file_u8(path: Path) -> tuple[bytes, torch.Tensor, mmap.mmap | None] | None:
+    """Read ``path`` header and map/read payload into a 1-D ``torch.uint8`` CPU tensor.
+
+    Uses ``O_DIRECT`` into a page-aligned ``mmap`` buffer when
+    ``VLLM_POSTLOAD_CACHE_ODIRECT=1`` and supported by the filesystem, otherwise
+    maps the file directly via ``torch.from_file`` without zero-filling a staging
+    ``bytearray``.
+    """
+    try:
+        st = path.stat()
+    except OSError:
+        return None
+    size = int(st.st_size)
+    if size < _HEADER_STRUCT.size:
+        return None
+    use_odirect = (
+        hasattr(os, "O_DIRECT")
+        and os.environ.get("VLLM_POSTLOAD_CACHE_ODIRECT", "0") == "1"
+    )
+    if use_odirect:
+        fd = -1
+        buf = None
+        view = None
+        try:
+            fd = os.open(str(path), os.O_RDONLY | getattr(os, "O_DIRECT", 0))
+            align = 4096
+            aligned_size = ((size + align - 1) // align) * align
+            buf = mmap.mmap(-1, aligned_size)
+            view = memoryview(buf)
+            total = 0
+            while total < size:
+                chunk = os.readv(fd, [view[total:aligned_size]])
+                if chunk <= 0:
+                    break
+                total += chunk
+            if total == size:
+                header = bytes(view[: _HEADER_STRUCT.size])
+                view.release()
+                view = None
+                t = torch.frombuffer(buf, dtype=torch.uint8, count=size)
+                out_mmap = buf
+                buf = None
+                return header, t, out_mmap
+        except OSError:
+            pass
+        finally:
+            if view is not None:
+                view.release()
+            if buf is not None:
+                buf.close()
+            if fd >= 0:
+                os.close(fd)
+    global _READ_SCRATCH
+    try:
+        if _READ_SCRATCH is None or int(_READ_SCRATCH.numel()) < size:
+            _READ_SCRATCH = torch.empty((size,), dtype=torch.uint8)
+        t = _READ_SCRATCH[:size]
+        with open(path, "rb", buffering=0) as f:
+            view = memoryview(t.numpy())
+            total = 0
+            while total < size:
+                n = f.readinto(view[total:])
+                if not n:
+                    break
+                total += n
+            view.release()
+            if total != size:
+                return None
+        header = bytes(t[: _HEADER_STRUCT.size].numpy())
+        return header, t, None
+    except OSError:
+        return None
+
+
+def _submit_atomic_write(
+    cache_dir: Path,
+    final_path: Path,
+    header: bytes,
+    tensors: Sequence[torch.Tensor],
+) -> None:
+    global _WRITER_EXECUTOR, _BG_COPY_STREAM
+
+    detached = [t.detach() for t in tensors]
+
+    def _write_task() -> None:
+        global _BG_COPY_STREAM
+        try:
+            cache_dir.mkdir(parents=True, exist_ok=True)
+        except OSError:
+            return
+        if not has_sufficient_disk_space(cache_dir):
+            with _STATE_LOCK:
+                _STATS.writes_skipped_low_disk += 1
+            logger.debug(
+                "Skipping post-load cache write to %s: free disk space below %d bytes",
+                final_path,
+                _CONFIG.min_free_bytes,
+            )
+            return
+        pid = os.getpid()
+        tmp_path = final_path.with_name(f"{final_path.name}.tmp.{pid}")
+        try:
+            cpu_tensors: list[torch.Tensor] = []
+            for t in detached:
+                if t.is_cuda:
+                    if _BG_COPY_STREAM is None:
+                        _BG_COPY_STREAM = torch.cuda.Stream(device=t.device)
+                    with torch.cuda.stream(_BG_COPY_STREAM):
+                        t_cpu = t.contiguous().to("cpu", non_blocking=True)
+                    _BG_COPY_STREAM.synchronize()
+                    cpu_tensors.append(t_cpu)
+                else:
+                    cpu_tensors.append(t.contiguous())
+            with open(tmp_path, "wb", buffering=0) as f:
+                f.write(header)
+                for t_cpu in cpu_tensors:
+                    arr_view = memoryview(t_cpu.view(torch.uint8).numpy())
+                    try:
+                        f.write(arr_view)
+                    finally:
+                        arr_view.release()
+                if os.environ.get("VLLM_POSTLOAD_CACHE_FSYNC", "0") == "1":
+                    os.fsync(f.fileno())
+            os.replace(tmp_path, final_path)
+            with _STATE_LOCK:
+                _STATS.writes_completed += 1
+        except OSError as exc:
+            logger.debug("Post-load cache write failed for %s: %s", final_path, exc)
+            try:
+                tmp_path.unlink()
+            except OSError:
+                pass
+
+    with _STATE_LOCK:
+        if _WRITER_EXECUTOR is None:
+            _WRITER_EXECUTOR = ThreadPoolExecutor(
+                max_workers=1, thread_name_prefix="postload-cache-writer"
+            )
+        fut = _WRITER_EXECUTOR.submit(_write_task)
+        _PENDING_FUTURES.append(fut)
+
+
+def loading_done(timeout: float | None = None) -> None:
+    """Wait for all queued background post-load cache writes to finish."""
+    global _READ_SCRATCH
+    with _STATE_LOCK:
+        _READ_SCRATCH = None
+        pending = list(_PENDING_FUTURES)
+        _PENDING_FUTURES.clear()
+        _CALL_COUNTERS.clear()
+    for fut in pending:
+        try:
+            fut.result(timeout=timeout)
+        except Exception as exc:
+            logger.debug("Post-load cache background writer error: %s", exc)
+
+
+def pack_bf16_rows_reference(
+    sample_weight: torch.Tensor,
+    exponent_base: int,
+    row_indices: Sequence[int],
+    *,
+    group: int = 128,
+    window: int = 15,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Reference 12-bit BF16 pack on a small slice of rows for spot verification."""
+    m, k = map(int, sample_weight.shape)
+    bits = sample_weight.view(torch.int16).to(torch.int32) & 0xFFFF
+    exp = (bits >> 7) & 0xFF
+    out = (exp != 0) & ((exp < exponent_base) | (exp >= exponent_base + window))
+    code = torch.where(
+        (exp != 0) & (~out), exp - exponent_base + 1, torch.zeros_like(exp)
+    )
+    low = torch.where(
+        out, torch.zeros_like(bits), ((bits >> 8) & 0x80) | (bits & 0x7F)
+    )
+    dec = (
+        ((low & 0x80) << 8)
+        | (
+            torch.where(
+                code == 0, torch.zeros_like(code), code + exponent_base - 1
+            )
+            << 7
+        )
+        | (low & 0x7F)
+    )
+    if bool(((~out) & (dec != bits)).any().item()):
+        raise ValueError("Sampled BF16 rows do not round-trip under cached exponent_base")
+    cg = code.view(m, k // group, 2, group // 2)
+    code_bytes = (
+        (cg[:, :, 0, :] | (cg[:, :, 1, :] << 4)).reshape(m, k // 2).to(torch.uint8)
+    )
+    values = torch.cat((low.to(torch.uint8), code_bytes), dim=1).contiguous()
+    counts = out.sum(dim=1, dtype=torch.int32)
+    row_idx_t = torch.tensor(
+        list(row_indices), dtype=torch.int32, device=sample_weight.device
+    )
+    exc_r_local, exc_c = torch.nonzero(out, as_tuple=True)
+    exc_rows = row_idx_t[exc_r_local].contiguous()
+    exc_entries = (
+        (exc_c.to(torch.int32) << 16) | bits[exc_r_local, exc_c]
+    ).to(torch.int32).contiguous()
+    return values, counts, exc_rows, exc_entries
+
+
+def try_load_cached_pack12(
+    weight: torch.Tensor,
+    *,
+    in_place: bool,
+    cache_tag: str | None = None,
+    group: int = 128,
+    window: int = 15,
+) -> tuple[Path | None, str, Any | None]:
+    """Try to load and 4-row spot-verify a cached ``PackedBf16Weight``."""
+    cache_dir = get_postload_cache_dir()
+    if cache_dir is None:
+        return None, "", None
+    out_features, in_features = map(int, weight.shape)
+    resolved_tag = _resolve_tag("pack12", cache_tag)
+    path = _cache_file_path(
+        cache_dir, "pack12", (out_features, in_features), resolved_tag
+    )
+    loaded = _read_file_u8(path)
+    if loaded is None:
+        with _STATE_LOCK:
+            _STATS.misses += 1
+        return path, resolved_tag, None
+    header_bytes, raw_u8, raw = loaded
+
+    try:
+        (
+            magic,
+            version,
+            cached_out,
+            cached_in,
+            exponent_base,
+            exceptions,
+            rows_len,
+            values_nbytes,
+            meta_nbytes,
+        ) = _HEADER_STRUCT.unpack_from(header_bytes, 0)
+        width = in_features + in_features // 2
+        expected_rows_len = max(int(exceptions), 1)
+        expected_values_nbytes = out_features * width
+        expected_meta_nbytes = (out_features + 1) * 4 + 2 * expected_rows_len * 4
+        total_expected = (
+            _HEADER_STRUCT.size + expected_values_nbytes + expected_meta_nbytes
+        )
+        if (
+            magic != PACK12_MAGIC
