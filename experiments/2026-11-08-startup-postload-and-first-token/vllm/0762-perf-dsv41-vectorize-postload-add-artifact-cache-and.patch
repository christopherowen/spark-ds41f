+def test_postload_cache_8gib_free_space_guard_and_dead_pid_cleanup(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+):
+    cache_dir = tmp_path / "guard_cache"
+    cache_dir.mkdir(parents=True)
+
+    # Create a dead-PID staging file and a live-PID staging file
+    dead_tmp = cache_dir / "pack12_v1_tp0of1_lm_head.bin.tmp.99999999"
+    live_tmp = cache_dir / f"pack12_v1_tp0of1_lm_head.bin.tmp.{os.getpid()}"
+    valid_bin = cache_dir / "keep.bin"
+    dead_tmp.write_bytes(b"partial-dead")
+    live_tmp.write_bytes(b"partial-live")
+    valid_bin.write_bytes(b"valid")
+
+    removed = cleanup_dead_pid_staging_files(cache_dir)
+    assert removed == [dead_tmp]
+    assert not dead_tmp.exists()
+    assert live_tmp.exists()
+    assert valid_bin.exists()
+    live_tmp.unlink()
+
+    # Simulate free disk space just below 8 GiB
+    DiskUsage = namedtuple("usage", ["total", "used", "free"])
+    monkeypatch.setattr(
+        "shutil.disk_usage",
+        lambda _: DiskUsage(
+            total=100 * (1 << 30),
+            used=93 * (1 << 30),
+            free=MIN_FREE_DISK_BYTES - 1,
+        ),
+    )
+
+    reset_postload_cache_stats()
+    device = "cuda" if torch.cuda.is_available() else "cpu"
+    scales = torch.randint(118, 122, (16, 256, 56), dtype=torch.uint8, device=device)
+    with postload_cache_context(
+        cache_dir,
+        tp_rank=0,
+        tp_world_size=1,
+        min_free_bytes=MIN_FREE_DISK_BYTES,
+    ):
+        encode_expert_scale_codes(scales, 128, cache_tag="low_disk_test")
+        loading_done()
+
+    stats = get_postload_cache_stats()
+    assert stats.writes_skipped_low_disk == 1
+    assert stats.writes_completed == 0
+    assert list(cache_dir.glob("moe_scale_*.bin")) == []
+
+
+def test_lazy_deepseek_v41_resolution_avoids_eager_dspark_and_model_import():
+    code = """
+import sys
+import vllm.models.deepseek_v41 as ds41
+cls = ds41.DeepseekV41ForCausalLM
+assert "vllm.models.deepseek_v4_1.nvidia.dspark" not in sys.modules
+assert "vllm.models.deepseek_v4_1.nvidia.model" not in sys.modules
+assert "vllm.models.deepseek_v41.nvidia.model" not in sys.modules
+"""
+    res = subprocess.run(
+        [sys.executable, "-c", code],
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    assert res.returncode == 0, res.stderr
