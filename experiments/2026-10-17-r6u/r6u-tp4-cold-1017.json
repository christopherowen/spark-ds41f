{
 "notes": "r6u on the ring serving 1017 with an empty TileLang cache on every rank; every JIT compile traced.",
 "extends": {
  "config": "experiments/2026-10-17-r6u/r6u-tp4-1017.json"
 },
 "set": {
  "model": "v41-flash-1017",
  "container": {
   "mounts": [
    [
     "{home}/projects/spark-ds41f/cache",
     "/cache",
     "rw"
    ],
    [
     "{home}/projects/spark-ds41f/experiments/2026-10-17-kernel-prepare/jittrace",
     "/opt/spark3/jittrace",
     "ro"
    ]
   ]
  },
  "environment": {
   "PYTHONPATH": "/opt/spark3/jittrace:/opt/spark3/candidate/vllm:/opt/spark3/candidate/b12x",
   "JITTRACE_DIR": "/cache/kkref/jittrace/r6u-tp4-1017-cold",
   "TILELANG_CACHE_DIR": "/cache/kkref/jit-r6u/image-tp4-1017-cold"
  }
 }
}
