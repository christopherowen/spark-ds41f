{
 "notes": "r6u on TP3 with a TileLang cache seeded on dgx1 and dgx3 (copies of production's) and empty on dgx2; every JIT compile traced (kernel-prepare/jittrace).",
 "extends": {
  "config": "experiments/2026-10-17-r6u/r6u-tp3.json"
 },
 "set": {
  "container": {
   "mounts": [
