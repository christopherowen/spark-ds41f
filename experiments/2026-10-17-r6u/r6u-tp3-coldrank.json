     "{home}/.cache/huggingface/hub/models--deepseek-ai--DeepSeek-V4.1-Flash/snapshots/dba1be0a40aa45a94ad051997016db3960a90277",
     "/models",
     "ro"
    ],
    [
     "{home}/.cache/huggingface/hub/models--deepseek-ai--DeepSeek-V4.1-Flash/blobs",
     "/blobs",
     "ro"
    ],
    [
     "{home}/projects/spark-ds41f/cache",
     "/cache",
     "rw"
    ],
    [
     "{home}/projects/spark-ds41f/experiments/2026-10-17-kernel-prepare/jittrace",
     "/opt/spark3/jittrace",
     "ro"
    ]
   ]
  },
  "environment": {
