#!/usr/bin/env bash
# Install dgx-spark-fan-control v0.1.4 and build its DKMS module for installed kernels.
set -euo pipefail

version=v0.1.4
repo="https://github.com/christopherowen/dgx-spark-fan-control.git"
source_dir="$HOME/projects/dgx-spark-fan-control"

if [ ! -e "$source_dir" ]; then
  git clone --branch "$version" "$repo" "$source_dir"
else
  git -C "$source_dir" fetch --tags origin
  git -C "$source_dir" checkout --detach "$version"
fi

cd "$source_dir"
sudo ./install.sh
for mod_dir in /lib/modules/*; do
  k=$(basename "$mod_dir")
  if [ -d "$mod_dir/build" ]; then
    sudo dkms autoinstall -k "$k"
  fi
done
