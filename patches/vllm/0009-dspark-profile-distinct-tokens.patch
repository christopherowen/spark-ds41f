 tests/v1/worker/test_dummy_input_ids.py | 22 +++++++++++
 vllm/v1/worker/gpu/input_batch.py       | 16 +++++++-
 vllm/v1/worker/gpu/model_runner.py      | 52 ++++++++++++++++++++++---
 3 files changed, 82 insertions(+), 8 deletions(-)
