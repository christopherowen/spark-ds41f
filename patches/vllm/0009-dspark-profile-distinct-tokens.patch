 tests/v1/worker/test_dummy_input_ids.py | 20 ++++++++++
 vllm/v1/worker/gpu/input_batch.py       |  9 ++++-
 vllm/v1/worker/gpu/model_runner.py      | 51 ++++++++++++++++++++++---
 3 files changed, 73 insertions(+), 7 deletions(-)
