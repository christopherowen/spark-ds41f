+def median_curve(points: Iterable[tuple[int, float]]) -> list[tuple[int, float]]:
+    grouped: defaultdict[int, list[float]] = defaultdict(list)
+    for key, value in points:
+        grouped[key].append(value)
+    return [(k, float(np.median(v))) for k, v in sorted(grouped.items())]
+
+
+def verify_curves_by_num_reqs_from(
+    samples: Iterable[StepTimingSample],
+) -> dict[int, list[tuple[int, float]]]:
+    samples = [s for s in samples if s.full_cudagraph]
+    return {
+        num_reqs: median_curve(
+            (s.num_target_tokens, s.forward_ms)
+            for s in samples
+            if s.num_reqs == num_reqs
+        )
+        for num_reqs in sorted({s.num_reqs for s in samples})
+    }
+
+
+def build_tables_by_num_reqs(
+    verify_curves_by_num_reqs: Mapping[int, list[tuple[int, float]]],
+    max_num_reqs: int,
+    max_batch_tokens: int,
+    beyond: np.ndarray,
+) -> dict[int, np.ndarray]:
+    """Per-request-count verify tables from FULL graph shape curves.
+
+    FULL replay pads both tokens and requests. A request count may have only
+    one exact shape; extending that point prices all larger graphs as free
+    verification, so each count follows the smallest compatible padded shape.
+    Token counts beyond the captured shapes take ``beyond``.
+    """
+    full_shapes = sorted(
+        (num_tokens, padded_reqs, cost)
+        for padded_reqs, curve in verify_curves_by_num_reqs.items()
+        for num_tokens, cost in curve
+    )
+    tables = {}
+    for num_reqs in range(1, max_num_reqs + 1):
+        curve: dict[int, float] = {}
+        for num_tokens, padded_reqs, cost in full_shapes:
+            if padded_reqs >= num_reqs:
+                curve.setdefault(num_tokens, cost)
