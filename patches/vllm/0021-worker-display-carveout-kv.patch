--- /dev/null
+++ b/vllm/v1/worker/display_carveout.py
@@ -0,0 +1,182 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""KV cache backing in the GB10 display carve-out.
+
+DGX Spark firmware reserves about 2 GiB at the top of physical memory for
+display scanout surfaces (the DISPLAY_FRM carve-out). Linux and ordinary CUDA
+allocations never use it, so on a headless node it sits idle; a text console
+takes only its framebuffer (8 MiB at 1920x1080). nvidia-drm serves DRM dumb
+buffers from that carve-out. Exporting one as a dma-buf and importing it with
+``cuImportExternalMemory`` gives a device mapping that streams at about 95% of
+ordinary device memory. Registering the CPU mapping as I/O memory instead
+(``cuMemHostRegister`` with ``CU_MEMHOSTREGISTER_IOMEMORY``) reads at about
+65%, so this module does not do that.
+
+With ``SPARK3_KV_DISPLAY_CARVEOUT=1`` the KV cache backing must come from the
+carve-out: the worker refuses to start when the DRM node is missing or the
+carve-out cannot hold the whole backing, so the cache never moves back into
+ordinary memory, where it would eat the host headroom it was meant to spare.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import fcntl
+import os
+import struct
+
+import torch
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+_REQUIRED = os.environ.get("SPARK3_KV_DISPLAY_CARVEOUT", "0") == "1"
+_DRM_NODE = "/dev/dri/card0"
+
+_DRM_IOCTL_MODE_CREATE_DUMB = 0xC02064B2
+_DRM_IOCTL_PRIME_HANDLE_TO_FD = 0xC00C642D
+_DUMB_WIDTH = 4096
+_DUMB_BPP = 32
+_ROW_BYTES = _DUMB_WIDTH * _DUMB_BPP // 8
+_GRANULE = 16 << 20
+# Temporary startup KV caches are a few MiB; serving caches are GiB-scale.
+_SERVING_MIN_BYTES = 256 << 20
+_CU_EXTERNAL_MEMORY_HANDLE_TYPE_DMABUF_FD = 9
+
+
+class _Win32Handle(ctypes.Structure):
+    _fields_ = [("handle", ctypes.c_void_p), ("name", ctypes.c_void_p)]
+
+
+class _HandleUnion(ctypes.Union):
+    _fields_ = [
+        ("fd", ctypes.c_int),
+        ("win32", _Win32Handle),
+        ("nvSciBufObject", ctypes.c_void_p),
+    ]
+
+
+class _ExternalMemoryHandleDesc(ctypes.Structure):
+    _fields_ = [
+        ("type", ctypes.c_int),
+        ("handle", _HandleUnion),
+        ("size", ctypes.c_ulonglong),
+        ("flags", ctypes.c_uint),
+        ("reserved", ctypes.c_uint * 16),
+    ]
+
+
+class _ExternalMemoryBufferDesc(ctypes.Structure):
+    _fields_ = [
+        ("offset", ctypes.c_ulonglong),
+        ("size", ctypes.c_ulonglong),
+        ("flags", ctypes.c_uint),
+        ("reserved", ctypes.c_uint * 16),
+    ]
+
+
+class _Carveout:
+    """One dumb buffer imported into CUDA; alive for the whole process."""
+
+    def __init__(self, nbytes: int):
+        self.nbytes = nbytes
+        self.drm_fd = os.open(_DRM_NODE, os.O_RDWR | os.O_CLOEXEC)
+        request = bytearray(
+            struct.pack(
+                "IIIIIIQ", nbytes // _ROW_BYTES, _DUMB_WIDTH, _DUMB_BPP, 0, 0, 0, 0
+            )
+        )
+        fcntl.ioctl(self.drm_fd, _DRM_IOCTL_MODE_CREATE_DUMB, request)
+        _, _, _, _, self.handle, _, size = struct.unpack("IIIIIIQ", request)
+        if size != nbytes:
+            raise RuntimeError(
+                f"display carve-out returned {size} bytes, asked for {nbytes}"
+            )
+        prime = bytearray(struct.pack("IIi", self.handle, os.O_CLOEXEC | os.O_RDWR, -1))
+        fcntl.ioctl(self.drm_fd, _DRM_IOCTL_PRIME_HANDLE_TO_FD, prime)
+        self.dmabuf_fd = struct.unpack("IIi", prime)[2]
+
+        cuda = ctypes.CDLL("libcuda.so.1")
+        desc = _ExternalMemoryHandleDesc()
+        desc.type = _CU_EXTERNAL_MEMORY_HANDLE_TYPE_DMABUF_FD
+        desc.handle.fd = self.dmabuf_fd
+        desc.size = nbytes
+        self.external = ctypes.c_void_p()
+        _check(
+            cuda,
+            cuda.cuImportExternalMemory(
+                ctypes.byref(self.external), ctypes.byref(desc)
+            ),
+            "cuImportExternalMemory",
+        )
+        buffer = _ExternalMemoryBufferDesc()
+        buffer.size = nbytes
+        self.pointer = ctypes.c_ulonglong()
+        _check(
+            cuda,
+            cuda.cuExternalMemoryGetMappedBuffer(
+                ctypes.byref(self.pointer), self.external, ctypes.byref(buffer)
+            ),
+            "cuExternalMemoryGetMappedBuffer",
+        )
+
+    @property
+    def __cuda_array_interface__(self):
+        return {
+            "shape": (self.nbytes,),
+            "typestr": "|i1",
+            "data": (self.pointer.value, False),
+            "version": 3,
+            "strides": None,
+        }
+
+
+def _check(cuda, status: int, what: str) -> None:
+    if status:
+        text = ctypes.c_char_p()
+        cuda.cuGetErrorString(status, ctypes.byref(text))
+        raise RuntimeError(
+            f"{what} failed: {text.value.decode() if text.value else status}"
+        )
+
+
+_carveouts: list[_Carveout] = []
+
+
+def required() -> bool:
+    return _REQUIRED
+
+
+def allocate(nbytes: int, device: torch.device) -> torch.Tensor:
+    """A zeroed int8 tensor of ``nbytes`` backed by the display carve-out.
+
+    Startup also allocates small temporary KV caches (the memory-profiling
+    pass, B12X preparation blocks); those stay in ordinary memory so they do
+    not strand carve-out space the serving cache needs.
+    """
+    if nbytes < _SERVING_MIN_BYTES:
+        return torch.zeros(nbytes, dtype=torch.int8, device=device)
+    assert ctypes.sizeof(_ExternalMemoryHandleDesc) == 104
+    assert ctypes.sizeof(_ExternalMemoryBufferDesc) == 88
+    rounded = -(-nbytes // _GRANULE) * _GRANULE
+    # Driver API calls use the thread's current context: bind the device's
+    # primary context the way torch does before importing.
+    torch.zeros(1, device=device)
+    try:
+        carveout = _Carveout(rounded)
+    except OSError as error:
+        raise RuntimeError(
+            f"SPARK3_KV_DISPLAY_CARVEOUT=1 but the display carve-out cannot hold "
+            f"{rounded >> 20} MiB of KV cache ({_DRM_NODE}: {error})"
+        ) from error
+    _carveouts.append(carveout)
+    backing = torch.as_tensor(carveout, device=device)
+    assert backing.data_ptr() == carveout.pointer.value
+    tensor = backing[:nbytes]
+    tensor.zero_()
+    logger.info(
+        "KV cache backing: %.1f MiB in the display carve-out (dma-buf import)",
+        nbytes / (1 << 20),
+    )
+    return tensor
