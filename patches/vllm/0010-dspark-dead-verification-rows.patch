diff --git a/tests/v1/worker/test_dead_rows.py b/tests/v1/worker/test_dead_rows.py
new file mode 100644
index 0000000000..d86a6aaaaa
--- /dev/null
+++ b/tests/v1/worker/test_dead_rows.py
@@ -0,0 +1,67 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import math
+
+import pytest
+import torch
+
+from vllm.v1.worker.gpu.input_batch import (
+    combine_sampled_and_draft_tokens,
+    get_num_sampled_and_rejected,
+)
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA")
+
+
+def _combine(dead_rows):
+    dev = "cuda"
+    # Two decode requests (slots 3 and 1) with 5 drafts each, one prefill.
+    idx_mapping = torch.tensor([3, 1, 0], dtype=torch.int32, device=dev)
+    query_start_loc = torch.tensor([0, 6, 12, 20], dtype=torch.int32, device=dev)
+    seq_lens = torch.tensor([106, 206, 8], dtype=torch.int32, device=dev)
+    prefill_len = torch.tensor([50, 100, 0, 100], dtype=torch.int32, device=dev)
+    last_sampled = torch.tensor([10, 11, 12, 13], dtype=torch.int32, device=dev)
+    draft_tokens = torch.arange(20, dtype=torch.int32, device=dev).view(4, 5) + 100
+    cu_num_logits = torch.tensor([0, 6, 12, 13], dtype=torch.int32, device=dev)
+    input_ids = torch.zeros(24, dtype=torch.int32, device=dev)
+    combine_sampled_and_draft_tokens(
+        input_ids, idx_mapping, last_sampled, query_start_loc, seq_lens,
+        prefill_len, draft_tokens, cu_num_logits, 13, 1, dead_rows=dead_rows,
+    )
+    return input_ids
+
+
+def test_dead_rows_mark_rows_past_the_survival_cut():
+    dev = "cuda"
+    confidence = torch.ones(4, 5, dtype=torch.float32, device=dev)
+    # Slot 3: survival 0.9, 0.72, 0.36, ... -> cut 2 at tau 0.5.
+    confidence[3] = torch.tensor([0.9, 0.8, 0.5, 0.9, 0.9])
+    # Slot 1: first draft already below tau -> cut 0.
+    confidence[1] = torch.tensor([0.4, 0.9, 0.9, 0.9, 0.9])
+    is_padding = torch.zeros(24, dtype=torch.bool, device=dev)
+    cut = torch.empty(3, dtype=torch.int32, device=dev)
+    ids_dead = _combine((confidence, is_padding, cut, math.log(0.5)))
+    ids_plain = _combine(None)
+    assert torch.equal(ids_dead, ids_plain)
+    assert cut.tolist() == [2, 0, 9]  # the prefill request is never clamped
+    expected = torch.zeros(24, dtype=torch.bool)
+    expected[3:6] = True    # request 0: rows of drafts 3-5
+    expected[7:12] = True   # request 1: rows of drafts 1-5
+    assert torch.equal(is_padding.cpu(), expected)
+
+
+def test_dead_row_cut_clamps_committed_tokens():
+    dev = "cuda"
+    num_sampled = torch.tensor([6, 1, 4], dtype=torch.int32, device=dev)
+    seq_lens = torch.tensor([106, 206, 306], dtype=torch.int32, device=dev)
+    cu_num_logits = torch.tensor([0, 6, 12, 18], dtype=torch.int32, device=dev)
+    idx_mapping = torch.tensor([0, 1, 2], dtype=torch.int32, device=dev)
+    prefill_len = torch.tensor([10, 10, 10], dtype=torch.int32, device=dev)
+    cut = torch.tensor([2, 0, 6], dtype=torch.int32, device=dev)
+    sampled, rejected = get_num_sampled_and_rejected(
+        num_sampled, seq_lens, cu_num_logits, idx_mapping, prefill_len,
+        dead_row_cut=cut,
+    )
+    assert sampled.tolist() == [3, 1, 4]
+    assert rejected.tolist() == [3, 5, 2]
diff --git a/vllm/v1/worker/gpu/input_batch.py b/vllm/v1/worker/gpu/input_batch.py
index 96994eb773..ee83039f68 100644
--- a/vllm/v1/worker/gpu/input_batch.py
+++ b/vllm/v1/worker/gpu/input_batch.py
@@ -431,11 +431,20 @@ def _combine_sampled_and_draft_tokens_kernel(
     draft_tokens_stride,
     cu_num_logits_ptr,
     logits_indices_ptr,
+    confidence_ptr,
+    confidence_stride,
+    is_padding_ptr,
+    dead_cut_ptr,
+    log_tau,
     BLOCK_SIZE: tl.constexpr,
     NUM_NEW_SAMPLED_TOKENS: tl.constexpr = 1,
+    DEAD_ROWS: tl.constexpr = False,
 ):
     batch_idx = tl.program_id(0)
     req_state_idx = tl.load(idx_mapping_ptr + batch_idx)
+    if DEAD_ROWS:
+        # Requests without drafts are never clamped.
+        tl.store(dead_cut_ptr + batch_idx, BLOCK_SIZE + 1)
 
     # Get the number of logits and draft tokens.
     cu_num_logits_start = tl.load(cu_num_logits_ptr + batch_idx)
@@ -478,6 +487,24 @@ def _combine_sampled_and_draft_tokens_kernel(
             draft_tokens,
             mask=mask,
         )
+        if DEAD_ROWS:
+            # Dead rows: the drafts' survival is the running product of this
+            # step's confidences. Rows past the first draft below the
+            # threshold become padding, which routed MoE skips; the sampled
+            # fix-up then commits at most one token past the last live row.
+            confidence = tl.load(
+                confidence_ptr + req_state_idx * confidence_stride + block,
+                mask=mask,
+                other=1.0,
+            )
+            log_survival = tl.cumsum(tl.log(confidence), axis=0)
+            cut = tl.sum(((log_survival >= log_tau) & mask).to(tl.int32), axis=0)
+            tl.store(dead_cut_ptr + batch_idx, cut)
+            tl.store(
+                is_padding_ptr + query_end - num_draft_tokens + block,
+                tl.full([BLOCK_SIZE], 1, tl.uint8),
+                mask=mask & (block >= cut),
+            )
 
 
 def combine_sampled_and_draft_tokens(
@@ -491,7 +518,10 @@ def combine_sampled_and_draft_tokens(
     cu_num_logits: torch.Tensor,
     num_logits: int,
     num_new_sampled_tokens: int = 1,  # excl accepted draft tokens, a.k.a bonus tokens
+    dead_rows: tuple[torch.Tensor, torch.Tensor, torch.Tensor, float] | None = None,
 ) -> torch.Tensor:
+    """``dead_rows`` = (per-slot draft confidences, is_padding, per-request cut
+    output, log of the survival threshold) marks low-survival draft rows."""
     assert num_new_sampled_tokens in (0, 1), (
         f"num_new_sampled_tokens must be 0 or 1, got {num_new_sampled_tokens}"
     )
@@ -515,7 +545,14 @@ def combine_sampled_and_draft_tokens(
         draft_tokens.stride(0),
         cu_num_logits,
         logits_indices,
+        *(
+            (dead_rows[0], dead_rows[0].stride(0), dead_rows[1].view(torch.uint8),
+             dead_rows[2], dead_rows[3])
+            if dead_rows is not None
+            else (input_ids, 0, input_ids, input_ids, 0.0)
+        ),
         NUM_NEW_SAMPLED_TOKENS=num_new_sampled_tokens,
+        DEAD_ROWS=dead_rows is not None,
         # NOTE(woosuk): Add num_new_sampled_tokens to ensure the block covers the
         # last sampled token in addition to all draft tokens.
         BLOCK_SIZE=triton.next_power_of_2(
@@ -533,6 +570,8 @@ def _get_num_sampled_and_rejected_kernel(
     cu_num_logits_ptr,
     idx_mapping_ptr,
     prefill_len_ptr,
+    dead_cut_ptr,
+    DEAD_ROWS: tl.constexpr = False,
 ):
     batch_idx = tl.program_id(0)
     req_state_idx = tl.load(idx_mapping_ptr + batch_idx)
@@ -542,6 +581,9 @@ def _get_num_sampled_and_rejected_kernel(
     is_chunked_prefilling = seq_len < prefill_len
 
     num_sampled = tl.load(num_sampled_ptr + batch_idx)
+    if DEAD_ROWS:
+        # Commit only tokens predicted by live rows.
+        num_sampled = tl.minimum(num_sampled, tl.load(dead_cut_ptr + batch_idx) + 1)
     num_sampled = tl.where(is_chunked_prefilling, 0, num_sampled)
     tl.store(num_sampled_ptr + batch_idx, num_sampled)
 
@@ -560,6 +602,7 @@ def get_num_sampled_and_rejected(
     cu_num_logits: torch.Tensor,
     idx_mapping: torch.Tensor,
     prefill_len: torch.Tensor,
+    dead_row_cut: torch.Tensor | None = None,
 ) -> tuple[torch.Tensor, torch.Tensor]:
     num_reqs = idx_mapping.shape[0]
     num_rejected = torch.empty_like(num_sampled)
@@ -570,6 +613,8 @@ def get_num_sampled_and_rejected(
         cu_num_logits,
         idx_mapping,
         prefill_len,
+        dead_row_cut if dead_row_cut is not None else num_sampled,
+        DEAD_ROWS=dead_row_cut is not None,
     )
     return num_sampled, num_rejected
 
