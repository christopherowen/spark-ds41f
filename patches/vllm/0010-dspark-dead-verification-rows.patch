@@ -36,6 +36,12 @@ _COST_DIR = os.environ.get("SPARK3_DSPARK_COST_DIR") or None
 # maximizes expected tokens minus the achieved rate times cost, the rule that
 # maximizes long-run tokens per millisecond when step confidence varies.
 _VERIFY_RULE = os.environ.get("SPARK3_DSPARK_VERIFY_RULE", "ratio")
+# Dead rows: verification rows past the first draft whose survival (running
+# product of this step's confidences) falls below this threshold are marked
+# as padding, so routed MoE skips them, and the request commits at most one
+# token past its last live row. Decided on device, inside the draft combine,
+# from the current drafts' confidences; the batch shape is unchanged. 0 = off.
+_DEAD_ROWS_TAU = float(os.environ.get("SPARK3_DSPARK_DEAD_ROWS_TAU", "0"))
 _RATE_ALPHA = float(os.environ.get("SPARK3_DSPARK_RATE_ALPHA", "0.1"))
 
 if TYPE_CHECKING:
@@ -179,11 +185,20 @@ class AdaptiveVerificationManager:
         # address the compacted layout, so the budget must fit one chunk.
         self._max_total_logits = max_total_logits
         self.cost_scale = cost_scale
-        if _VERIFY_RULE not in ("ratio", "marginal"):
+        if _VERIFY_RULE not in ("ratio", "marginal", "all"):
             raise ValueError(
-                f"SPARK3_DSPARK_VERIFY_RULE must be ratio or marginal, got {_VERIFY_RULE!r}"
+                "SPARK3_DSPARK_VERIFY_RULE must be ratio, marginal or all, got "
+                f"{_VERIFY_RULE!r}"
             )
         self._verify_rule = _VERIFY_RULE
+        self.dead_rows_tau = _DEAD_ROWS_TAU
+        self._dead_row_cut = torch.empty(
+            req_states.max_num_reqs, dtype=torch.int32, device=device
+        )
+        if self.dead_rows_tau > 0:
+            logger.info(
+                "DSpark dead verification rows below survival %.3g", self.dead_rows_tau
+            )
         # Achieved expected tokens per millisecond, per request count. Every
         # rank derives it from the same broadcast confidences and cost tables.
         self._rates: dict[int, float] = {}
@@ -565,7 +580,11 @@ class AdaptiveVerificationManager:
             req_id: int(num_tokens)
             for req_id, num_tokens in zip(req_ids, num_non_draft_tokens, strict=True)
         }
-        if self._verify_rule == "marginal":
+        if self._verify_rule == "all":
+            # Schedule every draft; dead rows (if enabled) prune on device.
+            utilities = num_tokens_to_estimated_accepted_tokens / costs
+            draft_budget = max_draft_budget
+        elif self._verify_rule == "marginal":
             # Maximize tokens - rate * cost with rate the achieved expected
             # tokens per ms (Dinkelbach's fixed point for tokens / time). A
             # confident step then verifies every draft that beats the average
@@ -654,6 +673,23 @@ class AdaptiveVerificationManager:
         draft_lens_cpu[: draft_budget % num_verification_reqs] += 1
         return num_non_draft_tokens + draft_lens_cpu, cu_num_logits_np
 
+    def dead_row_args(
+        self, is_padding: torch.Tensor, num_reqs: int
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, float] | None:
+        """Arguments for the fused dead-row marking, or None when disabled.
+
+        The confidences are the current drafts', broadcast from rank 0, so
+        every rank marks the same rows.
+        """
+        if self.dead_rows_tau <= 0:
+            return None
+        return (
+            self._confidence_probs,
+            is_padding,
+            self._dead_row_cut[:num_reqs],
+            float(np.log(self.dead_rows_tau)),
+        )
+
     def get_verified_draft_counts(self, num_reqs: int) -> torch.Tensor:
         """Return the device-selected draft count for each request."""
         return self._batch_draft_capacity[:num_reqs]
