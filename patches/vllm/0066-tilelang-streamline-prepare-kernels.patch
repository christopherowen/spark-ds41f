-    def get_warmup_keys(
+    def __init__(self) -> None:
+        super().__init__()
+        self._prepared_calls: weakref.WeakSet[Calls] = weakref.WeakSet()
+
+    def declared_keys(
         self, calls: Calls | None, bind=None, warm=None
     ) -> list[_CallKey]:
