From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Owen <christopherowen@users.noreply.github.com>
Date: Fri, 30 Oct 2026 17:50:00 +0100
Subject: [PATCH] perf(tilelang): streamline _prepare_kernels registration,
 warm_declared, and bind_declared

- Deduplicate `JitWarmupRegistry._add` registrations in O(1) for
  hashable/callable arguments instead of scanning all prior
  registrations in O(N^2).
- Track `calls` callables already compiled by `prepare_declared` in
  `TileLangKernels` so the subsequent `registry.warmup()` pass only
  compiles newly registered step kernels instead of re-evaluating and
  re-preparing all ~1,200 module registrations a second time.
- Deduplicate `warm_declared` closures with identical bytecode and
  captured values across homogeneous layers, and bind primitive layer
  attributes (`q_lora_rank`, `hidden_size`, router shape) instead of
  `self` in `warm` closures.
- Cache resolved `TileLangCall` kernels across layers within
  `bind_declared` via `prepare.launch`.
---
diff --git a/tests/models/test_deepseek_v4_1_prepare.py b/tests/models/test_deepseek_v4_1_prepare.py
index 6919a376f..d998c82e6 100644
--- a/tests/models/test_deepseek_v4_1_prepare.py
+++ b/tests/models/test_deepseek_v4_1_prepare.py
@@ -61,3 +61,75 @@ def test_standalone_declaration_prepares_and_binds_now(monkeypatch):
     bound = []
     prepare.declare(lambda: [prepare.call(_rope, 2, 64)], bind=lambda: bound.append(1))
     assert prepared == [(_rope, (2, 64), {})] and bound == [1]
+
+
+def test_prepare_declared_skips_recompilation_in_registry_warmup(monkeypatch):
+    batches = []
+    monkeypatch.setattr(
+        tilelang, "prepare", lambda calls, **kw: batches.append(list(calls))
+    )
+    registry = JitWarmupRegistry(vllm_config=None)
+    calls_invocations = 0
+
+    def first_calls():
+        nonlocal calls_invocations
+        calls_invocations += 1
+        return [prepare.call(_gemm, 1024, 512, block_M=16)]
+
+    with registry.activate():
+        prepare.declare(first_calls)
+    assert prepare.prepare_declared(registry) == 1
+    assert calls_invocations == 1
+    assert batches == [[(_gemm, (1024, 512), {"block_M": 16})]]
+
+    # Registering step kernels after prepare_declared and calling registry.warmup()
+    # must only compile the newly registered step kernels.
+    with registry.activate():
+        prepare.declare(lambda: [prepare.call(_rope, 8, 128)])
+    registry.warmup()
+    assert calls_invocations == 1
+    assert batches == [
+        [(_gemm, (1024, 512), {"block_M": 16})],
+        [(_rope, (8, 128), {})],
+    ]
+
+
+def test_warm_declared_deduplicates_equivalent_closures():
+    registry = JitWarmupRegistry(vllm_config=None)
+    warmed = []
+
+    def make_layer_warm(hidden: int):
+        return lambda: warmed.append(hidden)
+
+    with registry.activate():
+        for _ in range(8):
+            prepare.declare(warm=make_layer_warm(3072))
+        for _ in range(4):
+            prepare.declare(warm=make_layer_warm(1536))
+
+    assert prepare.warm_declared(registry) == 2
+    assert warmed == [3072, 1536]
+
+
+def test_bind_declared_reuses_launched_kernels():
+    registry = JitWarmupRegistry(vllm_config=None)
+    invocations = 0
+
+    def fake_jit(n, k, block_M=16):
+        nonlocal invocations
+        invocations += 1
+        return ("kernel", n, k, block_M)
+
+    bound = []
+    with registry.activate():
+        for _ in range(6):
+            entry = prepare.call(fake_jit, 1024, 512, block_M=32)
+            prepare.declare(
+                lambda e=entry: [e],
+                bind=lambda e=entry: bound.append(prepare.launch(e)),
+            )
+
+    prepare.bind_declared(registry)
+    assert invocations == 1
+    assert len(bound) == 6
+    assert all(k == ("kernel", 1024, 512, 32) for k in bound)
diff --git a/vllm/model_executor/warmup/jit_warmup.py b/vllm/model_executor/warmup/jit_warmup.py
index 749e8ab3a..0f54c22e8 100644
--- a/vllm/model_executor/warmup/jit_warmup.py
+++ b/vllm/model_executor/warmup/jit_warmup.py
@@ -1005,6 +1005,24 @@ def _same_registration(
     ) and all(_same_value(left_kwargs[k], right_kwargs[k]) for k in left_kwargs)
 
 
+_FAST_KEY_ATOMS = (int, float, str, bytes, bool, type(None), type)
+
+
+def _fast_registration_key(value: Any) -> Any:
+    if isinstance(value, _FAST_KEY_ATOMS):
+        return (type(value), value)
+    if callable(value):
+        return (id, id(value))
+    if isinstance(value, tuple):
+        return (tuple, tuple(_fast_registration_key(x) for x in value))
+    if isinstance(value, dict) and all(isinstance(k, str) for k in value):
+        return (
+            dict,
+            tuple((k, _fast_registration_key(value[k])) for k in sorted(value)),
+        )
+    raise TypeError
+
+
 class JitWarmupRegistry:
     """Collect and compile JIT kernels selected during runner setup."""
 
@@ -1019,6 +1037,11 @@ class JitWarmupRegistry:
             VllmJitKernel[Any],
             list[tuple[tuple[Any, ...], dict[str, Any]]],
         ] = {}
+        self._fast_registration_keys: dict[VllmJitKernel[Any], set[Any]] = {}
+        self._slow_registrations: dict[
+            VllmJitKernel[Any],
+            list[tuple[tuple[Any, ...], dict[str, Any]]],
+        ] = {}
 
     @classmethod
     def capture(cls, init_fn: Callable[..., None]) -> Callable[..., None]:
@@ -1072,11 +1095,21 @@ class JitWarmupRegistry:
         # get_warmup_keys once per distinct registration is sufficient. Dedup on
         # identity-or-equality -- identity short-circuits shared singletons like
         # vllm_config before any deep __eq__.
-        if any(
-            _same_registration(registered, (args, kwargs))
-            for registered in registrations
-        ):
-            return
+        try:
+            fast_key = _fast_registration_key((args, kwargs))
+        except TypeError:
+            slow = self._slow_registrations.setdefault(kernel, [])
+            if any(
+                _same_registration(registered, (args, kwargs))
+                for registered in slow
+            ):
+                return
+            slow.append((args, kwargs))
+        else:
+            fast_keys = self._fast_registration_keys.setdefault(kernel, set())
+            if fast_key in fast_keys:
+                return
+            fast_keys.add(fast_key)
         registrations.append((args, kwargs))
 
     def __len__(self) -> int:
