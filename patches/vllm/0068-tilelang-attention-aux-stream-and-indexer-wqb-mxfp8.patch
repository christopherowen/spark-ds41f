From 43d0b53c84d00f853447f881b4720a887c81575e Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Fri, 30 Oct 2026 23:33:08 +0100
Subject: [PATCH] [DS4.1] Attention: hand q_cast to indexer.wq_b and overlap
 decode aux_stream

---
 tests/models/test_deepseek_v4_1_attention.py | 144 +++++++++++++++++++
 vllm/models/deepseek_v4_1/attention.py       | 138 +++++++++++++++---
 2 files changed, 259 insertions(+), 23 deletions(-)

diff --git a/tests/models/test_deepseek_v4_1_attention.py b/tests/models/test_deepseek_v4_1_attention.py
index 373bcc2e0..387e1fead 100644
--- a/tests/models/test_deepseek_v4_1_attention.py
+++ b/tests/models/test_deepseek_v4_1_attention.py
@@ -180,3 +180,147 @@ def test_decode_front_is_one_kernel_at_decode_rows(monkeypatch):
     metadata = None
     assert module._front(torch.zeros(6, 1792), positions, None) is None
     assert len(launches) == 1
+
+
+def test_index_query_hands_over_q_cast_and_overlaps_weights_proj(monkeypatch):
+    """At decode row counts, ``_index_query`` hands ``q_cast`` to ``indexer.wq_b``
+    without re-casting ``qr`` and overlaps ``weights_proj`` via
+    ``maybe_execute_in_parallel``."""
+    from vllm.models.deepseek_v4_1 import attention, kernels
+    from vllm.models.deepseek_v4_1.tilelang.linear import MXFP8Rows, provided_mxfp8
+
+    module = _tilelang_layer(layer_id=3)
+    seen_casts = []
+
+    def fake_wq_b(x):
+        seen_casts.append(provided_mxfp8(x))
+        return torch.zeros(x.shape[0], 32 * 128, dtype=x.dtype, device=x.device)
+
+    fake_wq_b.tilelang_mxfp8_input = True
+    module.indexer = SimpleNamespace(
+        heads=32,
+        wq_b=fake_wq_b,
+        weights_proj=lambda h: torch.ones(h.shape[0], 32, dtype=h.dtype, device=h.device),
+    )
+    module._rope = lambda x, pos, role: x
+    module._quantize_index_query = lambda mode, iq, data, scale: (
+        data.fill_(7),
+        scale.fill_(3),
+    )
+
+    parallel_calls = []
+
+    def fake_parallel(fn0, fn1, ev0, ev1, stream=None):
+        parallel_calls.append(stream)
+        return fn0(), fn1()
+
+    monkeypatch.setattr(attention, "maybe_execute_in_parallel", fake_parallel)
+    monkeypatch.setattr(attention, "aux_stream", lambda: "aux")
+    monkeypatch.setattr(attention, "_aux_events", lambda: ("ev0", "ev1"))
+
+    qr = torch.zeros(4, 1280)
+    hidden = torch.zeros(4, 5120)
+    positions = torch.arange(4, dtype=torch.int64)
+    q_cast = MXFP8Rows(
+        qr,
+        torch.ones(64, 1280, dtype=torch.float8_e4m3fn),
+        torch.ones(64, 160, dtype=torch.uint8),
+    )
+    swa = SimpleNamespace(is_decode=True)
+
+    iq_data, iq_scale, weights = module._index_query(
+        qr, positions, hidden, None, 0, 4, swa, q_cast=q_cast
+    )
+    assert seen_casts == [q_cast]
+    assert iq_data.shape == (4, 32, 64) and torch.all(iq_data == 7)
+    assert iq_scale.shape == (4, 32, 4) and torch.all(iq_scale == 3)
+    assert weights.shape == (4, 32) and torch.all(weights == 1)
+    assert len(parallel_calls) == 1
+
+    # When a sequence-parallel split selects a strict row subset, _index_query
+    # casts that slice rather than reusing full-row q_cast.
+    slice_casts = []
+    monkeypatch.setattr(
+        kernels,
+        "cast_mxfp8",
+        lambda x: (
+            slice_casts.append(x.shape),
+            MXFP8Rows(
+                x,
+                torch.ones(64, 1280, dtype=torch.float8_e4m3fn),
+                torch.ones(64, 160, dtype=torch.uint8),
+            ),
+        )[1],
+    )
+    _, _, split_weights = module._index_query(
+        qr, positions, hidden, None, 1, 3, SimpleNamespace(is_decode=False), q_cast=q_cast
+    )
+    assert slice_casts == [torch.Size([2, 1280])]
+    assert split_weights.shape == (2, 32)
+
+
+def test_prepare_global_kv_overlaps_index_key_and_latent_writes(monkeypatch):
+    """``_prepare_global_kv`` rotates and writes the index key and compressed
+    latent cache entries through ``maybe_execute_in_parallel`` after ``wk``
+    reads the unrotated latent."""
+    from vllm.models.deepseek_v4_1 import attention
+
+    module = _tilelang_layer(layer_id=3)
+    module._ready = True
+    module._owner = lambda: SimpleNamespace(prefix="main")
+    module.kv_cache = torch.empty(2, 8, dtype=torch.uint8)
+    order = []
+
+    module.compressor = SimpleNamespace(
+        state_cache=None,
+        __call__=lambda hidden, main, state: (
+            order.append("compress"),
+            (torch.zeros(4, 512), torch.arange(4, dtype=torch.int64)),
+        )[1],
+    )
+    module.compressor = lambda hidden, main, state: (
+        order.append("compress") or torch.zeros(4, 512),
+        torch.arange(4, dtype=torch.int64),
+    )
+    module.compressor.state_cache = None
+    module.indexer = SimpleNamespace(
+        k_cache=SimpleNamespace(prefix="idx_k"),
+        wk=lambda latent: order.append("wk") or torch.zeros(4, 128),
+        k_norm=lambda key: order.append("k_norm") or key,
+    )
+    module._rope = lambda x, pos, role: order.append(f"rope:{role}") or x
+    module._write_index_keys = lambda key, slots: order.append("write_index_keys")
+    module._write_v41_cache = lambda latent, cache, slots, **kw: order.append(
+        f"write_cache:{kw['cache_kind']}"
+    )
+
+    metadata = {
+        "main": SimpleNamespace(),
+        "idx_k": SimpleNamespace(slot_mapping=torch.arange(8, dtype=torch.int64)),
+    }
+    monkeypatch.setattr(
+        attention,
+        "get_forward_context",
+        lambda: SimpleNamespace(attn_metadata=metadata),
+    )
+    parallel_calls = []
+    monkeypatch.setattr(
+        attention,
+        "maybe_execute_in_parallel",
+        lambda fn0, fn1, ev0, ev1, stream=None: (
+            parallel_calls.append(stream),
+            fn0(),
+            fn1(),
+        )[1:],
+    )
+    module._prepare_global_kv(torch.arange(4, dtype=torch.int64), torch.zeros(4, 5120))
+    assert order == [
+        "compress",
+        "wk",
+        "k_norm",
+        "rope:index_key",
+        "write_index_keys",
+        "rope:latent",
+        "write_cache:indexed",
+    ]
+    assert len(parallel_calls) == 1
diff --git a/vllm/models/deepseek_v4_1/attention.py b/vllm/models/deepseek_v4_1/attention.py
index d127ae810..cd23d6ae4 100644
--- a/vllm/models/deepseek_v4_1/attention.py
+++ b/vllm/models/deepseek_v4_1/attention.py
@@ -3,6 +3,7 @@
 """V4.1 Full/Reindex/Reuse topology: caches, metadata and ownership. The TileLang
 layer (``tilelang/attention.py``) runs the indexer and sparse MLA kernels."""
 
+import contextlib
 import os
 from typing import cast
 
@@ -43,6 +44,8 @@ from vllm.models.deepseek_v4_1.tilelang.gemm import DECODE_ROWS
 from vllm.models.deepseek_v4_1.tilelang.indexer import CANDIDATE_BLOCKS
 from vllm.models.deepseek_v41.common.rope import build_deepseek_v4_rope
 from vllm.utils.math_utils import cdiv
+from vllm.utils.multi_stream_utils import maybe_execute_in_parallel
+from vllm.utils.torch_utils import aux_stream
 from vllm.v1.kv_cache_interface import MLAAttentionSpec, SlidingWindowMLASpec
 from vllm.v1.worker.workspace import (
     current_workspace_manager,
@@ -54,6 +57,15 @@ logger = init_logger(__name__)
 # Validation only: under a sequence-parallel indexer split, every rank also runs
 # the full-row indexer twice and compares its own rows with the split result.
 _INDEX_SPLIT_CHECK = os.environ.get("SPARK_DS41F_INDEXER_SPLIT_CHECK") == "1"
+_AUX_EVENTS: tuple[torch.cuda.Event, torch.cuda.Event] | None = None
+
+
+def _aux_events() -> tuple[torch.cuda.Event, torch.cuda.Event]:
+    """Reusable CUDA event pair for fork/join onto ``aux_stream()``."""
+    global _AUX_EVENTS
+    if _AUX_EVENTS is None:
+        _AUX_EVENTS = (torch.cuda.Event(), torch.cuda.Event())
+    return _AUX_EVENTS
 
 
 def _source(prefix, layer):
@@ -170,6 +182,7 @@ class DeepseekV4Indexer(nn.Module):
             prefix=f"{prefix}.wq_b",
         )
         _native_linear(self.wq_b)
+        self.wq_b.tilelang_mxfp8_input = True
         self.weights_proj = ReplicatedLinear(
             hf.hidden_size,
             hf.index_n_heads,
@@ -752,16 +765,40 @@ class DeepseekV4Attention(nn.Module, AttentionLayerBase):
         latent, slots = self.compressor(hidden_states, main, state)
         # Index K consumes the ordinary-normalized PRE-RoPE latent.
         key = indexer.k_norm(indexer.wk(latent))
-        key = self._rope(key, positions, "index_key")
-        index_meta = cast(DeepseekV41B12xMetadata, metadata[indexer.k_cache.prefix])
-        self._write_index_keys(key, index_meta.slot_mapping[:rows])
-        latent = self._rope(latent, positions, "latent")
-        self._write_v41_cache(
-            latent,
-            self.kv_cache,
-            slots,
-            page_size=self._main_page,
-            cache_kind="indexed",
+        index_slots = cast(
+            DeepseekV41B12xMetadata, metadata[indexer.k_cache.prefix]
+        ).slot_mapping[:rows]
+
+        def write_index_key():
+            rotated_key = self._rope(key, positions, "index_key")
+            self._write_index_keys(rotated_key, index_slots)
+
+        def write_latent_kv():
+            rotated_latent = self._rope(latent, positions, "latent")
+            self._write_v41_cache(
+                rotated_latent,
+                self.kv_cache,
+                slots,
+                page_size=self._main_page,
+                cache_kind="indexed",
+            )
+
+        stream = (
+            aux_stream()
+            if hidden_states.is_cuda and rows <= DECODE_ROWS
+            else None
+        )
+        if stream is not None and not torch.cuda.is_current_stream_capturing():
+            for tensor in (latent, positions, self.kv_cache, slots):
+                if isinstance(tensor, torch.Tensor) and tensor.is_cuda:
+                    tensor.record_stream(stream)
+        ev0, ev1 = _aux_events() if stream is not None else (None, None)
+        maybe_execute_in_parallel(
+            write_index_key,
+            write_latent_kv,
+            ev0,
+            ev1,
+            stream,
         )
 
     def forward(
@@ -896,39 +933,94 @@ class DeepseekV4Attention(nn.Module, AttentionLayerBase):
                 first = split.start if split is not None else 0
                 last = first + split.real_rows if split is not None else rows
                 query = self._index_query(
-                    qr, positions, hidden_states, index_weights, first, last, swa
+                    qr,
+                    positions,
+                    hidden_states,
+                    index_weights,
+                    first,
+                    last,
+                    swa,
+                    q_cast=q_cast,
                 )
                 reference = None
                 if split is not None and _INDEX_SPLIT_CHECK:
                     reference = self._index_query(
-                        qr, positions, hidden_states, index_weights, 0, rows, swa
+                        qr,
+                        positions,
+                        hidden_states,
+                        index_weights,
+                        0,
+                        rows,
+                        swa,
+                        q_cast=q_cast,
                     )
                 index_query = (*query, split, reference)
             self.forward_mqa(q, kv, positions, output, index_query=index_query)
         return self._o_proj(output, sp_rows=sp_rows)
 
     def _index_query(
-        self, qr, positions, hidden_states, index_weights, first, last, swa
+        self,
+        qr,
+        positions,
+        hidden_states,
+        index_weights,
+        first,
+        last,
+        swa,
+        q_cast=None,
     ):
         """MXFP4 index queries and scaled head weights for rows [first, last)."""
         rows = last - first
         h = self.indexer.heads
-        iq = self.indexer.wq_b(qr[first:last]).view(rows, h, 128)
-        iq = self._rope(iq, positions[first:last], "index_query")
+        qr_slice = qr[first:last]
+        iq_cast = (
+            q_cast
+            if q_cast is not None and first == 0 and last == qr.shape[0]
+            else kernels.cast_mxfp8(qr_slice)
+            if getattr(self.indexer.wq_b, "tilelang_mxfp8_input", False)
+            else None
+        )
         iq_data = torch.empty((rows, h, 64), dtype=torch.uint8, device=qr.device)
         iq_scale = torch.empty((rows, h, 4), dtype=torch.uint8, device=qr.device)
-        self._quantize_index_query(
-            "decode" if swa.is_decode else "prefill", iq, iq_data, iq_scale
-        )
+        mode = "decode" if swa.is_decode else "prefill"
+
+        def run_query():
+            with (
+                kernels.mxfp8_inputs(iq_cast)
+                if iq_cast is not None
+                else contextlib.nullcontext()
+            ):
+                iq = self.indexer.wq_b(qr_slice).view(rows, h, 128)
+            iq = self._rope(iq, positions[first:last], "index_query")
+            self._quantize_index_query(mode, iq, iq_data, iq_scale)
+
+        if index_weights is not None:
+            run_query()
+            return iq_data, iq_scale, index_weights[first:last]
+
         # The BF16 head-weight projection runs on every row: its GEMV rounds
         # differently at another row count, which would move top-k selections.
         # The FP8 wq_b quantizes per row and does not depend on the row count.
-        weights = (
-            index_weights[first:last]
-            if index_weights is not None
-            else self.indexer.weights_proj(hidden_states)[first:last]
+        # At decode row counts, the query path uses no workspace when wq_b reads
+        # q_cast, so weights_proj can run concurrently on the auxiliary stream.
+        stream = (
+            aux_stream()
+            if qr.is_cuda
+            and iq_cast is not None
+            and hidden_states.shape[0] <= DECODE_ROWS
+            else None
+        )
+        if stream is not None and not torch.cuda.is_current_stream_capturing():
+            hidden_states.record_stream(stream)
+        ev0, ev1 = _aux_events() if stream is not None else (None, None)
+        _, full_weights = maybe_execute_in_parallel(
+            run_query,
+            lambda: self.indexer.weights_proj(hidden_states),
+            ev0,
+            ev1,
+            stream,
         )
-        return iq_data, iq_scale, weights  # the projection applied the scale
+        return iq_data, iq_scale, full_weights[first:last]
 
     @staticmethod
     def _selection_spread(actual, expected):
