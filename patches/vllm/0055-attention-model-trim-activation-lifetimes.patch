         else:
+            del x_q
             # SP: route every row; the TP partial sum is reduce-scattered.
             with sp_prefill.activate(sp_rows):
                 rows = sp_rows.gather(x)
-                with kernels.mxfp8_inputs(self.mhc.cast_rows(rows)):
