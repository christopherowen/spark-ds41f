+_CAST_BLOCK_MXFP8_HEADER = r"""
+#ifndef VLLM_CAST_BLOCK_MXFP8_H_
+#define VLLM_CAST_BLOCK_MXFP8_H_
+#include <cuda_bf16.h>
+#include <cuda_fp8.h>
+
+__device__ __forceinline__ __nv_fp8x2_storage_t vllm_cast_block_cvt_bf16x2_to_e4m3x2(
+    __nv_bfloat162 x) {
+  const unsigned int u = *reinterpret_cast<const unsigned int*>(&x);
+#if (__CUDACC_VER_MAJOR__ > 13) || (__CUDACC_VER_MAJOR__ == 13 && __CUDACC_VER_MINOR__ >= 1)
+  __nv_fp8x2_storage_t tmp;
+  asm("{cvt.rn.satfinite.e4m3x2.bf16x2 %0, %1;}\n" : "=h"(tmp) : "r"(u));
+  return tmp;
+#else
+  const float2 f2 = make_float2(
+      __uint_as_float(u << 16), __uint_as_float(u & 0xffff0000u));
+  return __nv_cvt_float2_to_fp8x2(f2, __NV_SATFINITE, __NV_E4M3);
+#endif
+}
+
+__device__ __forceinline__ unsigned char vllm_cast_block_mxfp8_8(
+    const void* src_bf16_ptr,
+    void* dst_fp8_ptr) {
+  const __nv_bfloat162* bf2 = reinterpret_cast<const __nv_bfloat162*>(src_bf16_ptr);
+  const __nv_bfloat162 a01 = __habs2(bf2[0]);
+  const __nv_bfloat162 a23 = __habs2(bf2[1]);
+  const __nv_bfloat162 a45 = __habs2(bf2[2]);
+  const __nv_bfloat162 a67 = __habs2(bf2[3]);
+  const __nv_bfloat162 amax2 = __hmax2(__hmax2(a01, a23), __hmax2(a45, a67));
+  float amax = __bfloat162float(__hmax(amax2.x, amax2.y));
+  amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, 1));
+  amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, 2));
+
+  const float scale_inv = fmaxf(amax, 1e-4f) * (1.0f / 448.0f);
+  const unsigned int bits = __float_as_uint(scale_inv);
+  const unsigned int ue8m0_byte = ((bits - 1u) >> 23) + 1u;
+  const unsigned int inv_bf16_bits = (254u - ue8m0_byte) << 7;
+  const unsigned int inv_bf16x2_bits = inv_bf16_bits | (inv_bf16_bits << 16);
+  const __nv_bfloat162 inv_bf2 =
+      *reinterpret_cast<const __nv_bfloat162*>(&inv_bf16x2_bits);
+
+  const __nv_fp8x2_storage_t p01 =
+      vllm_cast_block_cvt_bf16x2_to_e4m3x2(__hmul2(bf2[0], inv_bf2));
+  const __nv_fp8x2_storage_t p23 =
+      vllm_cast_block_cvt_bf16x2_to_e4m3x2(__hmul2(bf2[1], inv_bf2));
+  const __nv_fp8x2_storage_t p45 =
+      vllm_cast_block_cvt_bf16x2_to_e4m3x2(__hmul2(bf2[2], inv_bf2));
+  const __nv_fp8x2_storage_t p67 =
+      vllm_cast_block_cvt_bf16x2_to_e4m3x2(__hmul2(bf2[3], inv_bf2));
+  *reinterpret_cast<uint2*>(dst_fp8_ptr) = make_uint2(
+      (unsigned int)p01 | ((unsigned int)p23 << 16),
+      (unsigned int)p45 | ((unsigned int)p67 << 16));
+  return (unsigned char)ue8m0_byte;
+}
+#endif
+"""
+
+
 @T.macro
-def cast_block_mxfp8(values, quantized, count, amax, Q, S, row, col):
-    """One thread's share of a 32-value block in registers through ``_reference_cast``'s
-    arithmetic: ``values[0:count]`` (FP32 copies of BF16 values) are columns ``col`` on
-    of output row ``row``, ``amax`` the whole block's (the caller reduces it across the
-    block's threads). Their E4M3 bytes go through ``quantized`` (local, ``count``
-    long) to ``Q`` and, from the thread whose columns start the block, the UE8M0 byte
-    to ``S``: the bytes ``per_token_cast`` writes. A producer whose output is in
-    registers writes its consumers' MXFP8 input with it."""
-    bits = T.reinterpret(
-        T.max(amax, T.float32(_AMAX_FLOOR)) * T.float32(_FP8_MAX_INV), T.uint32
+def cast_block_mxfp8(values, quantized, count, Q, S, row, col):
+    """One thread's 8-element share of a 32-value BF16 block in registers through
+    ``_reference_cast``'s arithmetic: ``values[0:count]`` (BF16) are columns ``col``
+    on of output row ``row``. Their E4M3 bytes go through ``quantized`` (local,
+    ``count`` long) to ``Q`` and, from the thread whose columns start the block,
+    the UE8M0 byte to ``S``: the bytes ``per_token_cast`` writes."""
+    T.import_source(_CAST_BLOCK_MXFP8_HEADER)
+    ue8m0 = T.alloc_var(
+        T.uint8,
+        init=T.call_extern(
+            T.uint8,
+            "vllm_cast_block_mxfp8_8",
+            T.address_of(values[0]),
+            T.address_of(quantized[0]),
+        ),
     )
-    exponent = T.Cast(T.int32, ((bits - T.uint32(1)) >> 23) + T.uint32(1)) - 127
-    inv = T.reinterpret(T.Cast(T.uint32, 127 - exponent) << 23, T.float32)
     if col % 32 == 0:
-        S[row, col // 32] = T.Cast(T.uint8, exponent + 127)
-    for v in T.vectorized(count):
-        quantized[v] = T.Cast(T.float8_e4m3fn, values[v] * inv)
+        S[row, col // 32] = ue8m0
     for v in T.vectorized(count):
         Q[row, col + v] = quantized[v]
 
