From bbd69d1697ab49942aadc094670ad98b0fe9dbd2 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Mon, 28 Sep 2026 04:40:25 +0200
Subject: [PATCH] build: move to CUTLASS DSL 4.7.1

vLLM (and its quack-kernels 0.6.5, which imports cutlass.base_dsl.enums)
requires CuTe DSL 4.7.1. The 4.7.0 and 4.7.1 releases add features and
fix bugs without API removals, so B12X takes the newer version rather
than holding every other consumer at 4.6.2.
---
 pyproject.toml | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 76dd747f..781de5f4 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -10,11 +10,11 @@ license-files = ["LICENSE"]
 dependencies = [
   "torch>=2.12.0",
   "cuda-python",
-  "nvidia-cutlass-dsl==4.6.2",
-  "nvidia-cutlass-dsl-libs-base==4.6.2",
-  "nvidia-cutlass-dsl-libs-core==4.6.2",
-  "nvidia-cutlass-dsl-libs-cu12==4.6.2",
-  "nvidia-cutlass-dsl-libs-cu13==4.6.2",
+  "nvidia-cutlass-dsl==4.7.1",
+  "nvidia-cutlass-dsl-libs-base==4.7.1",
+  "nvidia-cutlass-dsl-libs-core==4.7.1",
+  "nvidia-cutlass-dsl-libs-cu12==4.7.1",
+  "nvidia-cutlass-dsl-libs-cu13==4.7.1",
   "apache-tvm-ffi>=0.1.6,!=0.1.8,!=0.1.8.post0,<0.2",
   "rich>=13",
   "transformers>=4.51",
-- 
