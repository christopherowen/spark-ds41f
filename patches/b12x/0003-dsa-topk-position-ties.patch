+"""The DSA radix top-k breaks exact score ties by lowest logical position."""
+
+import pytest
+import torch
+
+from b12x.attention.dsa_indexer.tiled_topk import run_row_topk
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="needs CUDA")
+
+TOPK = 512
+
+
+def _expected(
+    logits: torch.Tensor, lengths: torch.Tensor, topk: int
+) -> list[list[int]]:
+    """Descending score, ties by ascending position: a stable sort of -score."""
+    rows = []
+    for row, length in zip(logits.cpu(), lengths.tolist(), strict=True):
+        order = torch.sort(-row[:length], stable=True).indices[:topk]
+        rows.append(sorted(order.tolist()))
+    return rows
+
+
+def _selected(
+    logits: torch.Tensor, lengths: torch.Tensor, topk: int
+) -> list[list[int]]:
+    _, indices = run_row_topk(row_logits=logits, lengths=lengths, topk=topk)
+    torch.cuda.synchronize()
+    return [sorted(v for v in row if v >= 0) for row in indices.cpu().tolist()]
+
+
+def _tied_rows(rows: int, width: int, top: int, ties: int, seed: int) -> torch.Tensor:
+    """`top` distinct high scores, `ties` copies of 0.5 straddling the cut, low rest.
+
+    The high and low scores sit far from 0.5 so the tie group owns its coarse
+    radix bucket: with `ties` at most the candidate buffer (1,024 for top-k 512)
+    the buffered arm selects, above it the exact overflow fallback does.
+    """
+    generator = torch.Generator().manual_seed(seed)
+    logits = torch.empty(rows, width)
+    for r in range(rows):
+        values = -10.0 - 10.0 * torch.rand(width, generator=generator)
+        positions = torch.randperm(width, generator=generator)
+        values[positions[:top]] = 10.0 + 10.0 * torch.rand(top, generator=generator)
+        values[positions[top : top + ties]] = 0.5
+        logits[r] = values
+    return logits.cuda()
+
+
+@pytest.mark.parametrize("ties", [700, 5000], ids=["buffered", "overflow"])
+def test_ties_take_the_lowest_positions(ties):
+    logits = _tied_rows(rows=8, width=16384, top=300, ties=ties, seed=ties)
+    lengths = torch.full((8,), 16384, dtype=torch.int32, device="cuda")
+    assert _selected(logits, lengths, TOPK) == _expected(logits, lengths, TOPK)
+
+
+@pytest.mark.parametrize("ties", [700, 5000], ids=["buffered", "overflow"])
+def test_tied_selection_repeats(ties):
+    logits = _tied_rows(rows=32, width=16384, top=300, ties=ties, seed=7 + ties)
+    lengths = torch.full((32,), 16384, dtype=torch.int32, device="cuda")
+    first = _selected(logits, lengths, TOPK)
+    for _ in range(20):
+        assert _selected(logits, lengths, TOPK) == first
+
+
+def test_partial_rows_tie_by_position_within_their_length():
+    logits = _tied_rows(rows=4, width=8192, top=200, ties=900, seed=3)
+    lengths = torch.tensor([8192, 6000, 3000, 1500], dtype=torch.int32, device="cuda")
+    assert _selected(logits, lengths, TOPK) == _expected(logits, lengths, TOPK)
+
+
+def test_distinct_scores_match_torch_topk():
+    generator = torch.Generator().manual_seed(11)
+    logits = torch.randn(16, 65536, generator=generator).cuda()
+    lengths = torch.full((16,), 65536, dtype=torch.int32, device="cuda")
+    expected = [
+        sorted(row.tolist()) for row in torch.topk(logits, TOPK, dim=-1).indices.cpu()
+    ]
+    assert _selected(logits, lengths, TOPK) == expected
