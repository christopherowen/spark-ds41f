+@cute.jit
+def _position_key(
+    carry_indices,
+    row_start: Int32,
+    output_index_offset: Int32,
+    carry_base: Int32,
+    chunk_len: Int32,
+    vidx: Int32,
+    is_first: cutlass.Constexpr[bool],
+) -> Uint32:
+    """Descending-radix key of a candidate's logical K position (lower position, larger key).
+
+    Local candidates sit at row_start + vidx + output_index_offset; carried ones
+    keep the logical index their earlier chunk selected. Logical positions are
+    unique within a row, so the key totally orders tied candidates.
+    """
+    pos = Int32(0)
+    if cutlass.const_expr(is_first):
+        pos = row_start + vidx + output_index_offset
+    else:
+        if vidx < chunk_len:
+            pos = row_start + vidx + output_index_offset
+        else:
+            pos = Int32(carry_indices[carry_base + (vidx - chunk_len)])
+    return Uint32(0xFFFFFFFF) - Uint32(pos)
+
+
+@cute.jit
+def _select_lowest_position_ties(
+    tx: Int32,
+    count: Int32,
+    take: Int32,
+    out_slot_base: Int32,
+    pivot_key: Uint32,
+    from_buffer: cutlass.Constexpr[bool],
+    s_buf: cute.Tensor,
+    s_hist0: cute.Tensor,
+    s_hist1: cute.Tensor,
+    s_out: cute.Tensor,
+    h0: Int32,
+    ctr: Int32,
+    thr: Int32,
+    ni0: Int32,
+    ni1: Int32,
+    lr: Int32,
+    flat: cutlass.Constexpr[bool],
+    flat_values,
+    input_tensor,
+    carry_values,
+    carry_indices,
+    row_base: Int32,
+    row_start: Int32,
+    output_index_offset: Int32,
+    carry_base: Int32,
+    chunk_len: Int32,
+    block_q: cutlass.Constexpr[int],
+    block_k: cutlass.Constexpr[int],
+    is_tiled: cutlass.Constexpr[bool],
+    is_first: cutlass.Constexpr[bool],
+):
+    """Write the ``take`` tied candidates with the lowest logical positions.
+
+    Ties share the selection pivot's exact score key: the first ``count``
+    entries of ``s_buf`` (``from_buffer``), or every row candidate whose key
+    equals ``pivot_key``. An exact 4-round 8-bit radix over
+    ``_position_key`` finds the take-th lowest position, and the winners go to
+    ``s_out[out_slot_base : out_slot_base + take]``. The chosen set is then a
+    function of the scores alone, as with DeepSeek's reference ``torch.topk``,
+    instead of the order in which threads reached a shared counter. Clobbers
+    the histograms and the scalar slots. All 1024 threads must call this with
+    the same ``take``.
+    """
+    if take > Int32(0):
+        if tx == Int32(0):
+            _smem_st(ni0, Int32(0), Int32(0))
+            _smem_st(thr, Int32(0), take)
+        cute.arch.sync_threads()
+        for p_round in cutlass.range_constexpr(4):
+            p_shift = Uint32(24 - p_round * 8)
+            p_prefix = Uint32(_smem_ld(ni0, Int32(0)))
+            p_remaining = Int32(_smem_ld(thr, Int32(0)))
+            if tx < Int32(256):
+                s_hist0[tx] = Int32(0)
+            cute.arch.sync_threads()
+            e = Int32(tx)
+            while e < count:
+                if cutlass.const_expr(from_buffer):
+                    p_key = _position_key(
+                        carry_indices,
+                        row_start,
+                        output_index_offset,
+                        carry_base,
+                        chunk_len,
+                        Int32(s_buf[e]),
+                        is_first,
+                    )
+                    if cutlass.const_expr(p_round == 0):
+                        _smem_red_add(
+                            h0, Int32((p_key >> p_shift) & Uint32(0xFF)), Int32(1)
+                        )
+                    else:
+                        p_mask = Uint32(0xFFFFFFFF) << Uint32(32 - p_round * 8)
+                        if (p_key & p_mask) == p_prefix:
+                            _smem_red_add(
+                                h0, Int32((p_key >> p_shift) & Uint32(0xFF)), Int32(1)
+                            )
+                else:
+                    score_key = _convert_to_uint32(
+                        _fallback_load_value(
+                            flat,
+                            e,
+                            flat_values,
+                            input_tensor,
+                            carry_values,
+                            row_base,
+                            row_start,
+                            carry_base,
+                            chunk_len,
+                            block_q,
+                            block_k,
+                            is_tiled,
+                            is_first,
+                        )
+                    )
+                    if score_key == pivot_key:
+                        p_key = _position_key(
+                            carry_indices,
+                            row_start,
+                            output_index_offset,
+                            carry_base,
+                            chunk_len,
+                            e,
+                            is_first,
+                        )
+                        if cutlass.const_expr(p_round == 0):
+                            _smem_red_add(
+                                h0, Int32((p_key >> p_shift) & Uint32(0xFF)), Int32(1)
+                            )
+                        else:
+                            p_mask = Uint32(0xFFFFFFFF) << Uint32(32 - p_round * 8)
+                            if (p_key & p_mask) == p_prefix:
+                                _smem_red_add(
+                                    h0,
+                                    Int32((p_key >> p_shift) & Uint32(0xFF)),
+                                    Int32(1),
+                                )
+                e += Int32(_THREADS_PER_CTA)
+            cute.arch.sync_threads()
+            for p_stage in cutlass.range_constexpr(8):
+                p_j = Int32(1 << p_stage)
+                if tx < Int32(256):
+                    if (p_stage & 1) == 0:
+                        p_v = Int32(s_hist0[tx])
+                        if tx < Int32(256) - p_j:
+                            p_v = p_v + Int32(s_hist0[tx + p_j])
+                        s_hist1[tx] = p_v
+                    else:
+                        p_v = Int32(s_hist1[tx])
+                        if tx < Int32(256) - p_j:
+                            p_v = p_v + Int32(s_hist1[tx + p_j])
+                        s_hist0[tx] = p_v
+                cute.arch.sync_threads()
+            if tx == Int32(0):
+                _smem_st(ni1, Int32(0), Int32(0))
+                _smem_st(lr, Int32(0), p_remaining)
+            cute.arch.sync_threads()
+            if tx < Int32(256):
+                p_cge = Int32(s_hist0[tx])
+                p_cgt = Int32(0)
+                if tx + Int32(1) < Int32(256):
+                    p_cgt = Int32(s_hist0[tx + Int32(1)])
+                if (p_cge >= p_remaining) & (p_cgt < p_remaining):
+                    _smem_st(ni1, Int32(0), Int32(tx))
+                    _smem_st(lr, Int32(0), p_remaining - p_cgt)
+            cute.arch.sync_threads()
+            if tx == Int32(0):
+                p_bucket = Uint32(_smem_ld(ni1, Int32(0)))
+                _smem_st(ni0, Int32(0), Int32(p_prefix | (p_bucket << p_shift)))
+                _smem_st(thr, Int32(0), _smem_ld(lr, Int32(0)))
+            cute.arch.sync_threads()
+        # Positions are unique, so exactly ``take`` keys reach the pivot.
+        p_pivot = Uint32(_smem_ld(ni0, Int32(0)))
+        if tx == Int32(0):
+            _smem_st(ctr, Int32(0), Int32(0))
+        cute.arch.sync_threads()
+        e = Int32(tx)
+        while e < count:
+            if cutlass.const_expr(from_buffer):
+                c_idx = Int32(s_buf[e])
+                p_key = _position_key(
+                    carry_indices,
+                    row_start,
+                    output_index_offset,
+                    carry_base,
+                    chunk_len,
+                    c_idx,
+                    is_first,
+                )
+                if p_key >= p_pivot:
+                    slot = _smem_xadd(ctr, Int32(0), Int32(1))
+                    if slot < take:
+                        s_out[out_slot_base + slot] = c_idx
+            else:
+                score_key = _convert_to_uint32(
+                    _fallback_load_value(
+                        flat,
+                        e,
+                        flat_values,
+                        input_tensor,
+                        carry_values,
+                        row_base,
+                        row_start,
+                        carry_base,
+                        chunk_len,
+                        block_q,
+                        block_k,
+                        is_tiled,
+                        is_first,
+                    )
+                )
+                if score_key == pivot_key:
+                    p_key = _position_key(
+                        carry_indices,
+                        row_start,
+                        output_index_offset,
+                        carry_base,
+                        chunk_len,
+                        e,
+                        is_first,
+                    )
+                    if p_key >= p_pivot:
+                        slot = _smem_xadd(ctr, Int32(0), Int32(1))
+                        if slot < take:
+                            s_out[out_slot_base + slot] = e
+            e += Int32(_THREADS_PER_CTA)
+        cute.arch.sync_threads()
+
