{
 "name": "release",
 "version": 3,
 "description": "Release measurement, about 60 minutes a build: the screen with all 256 prompts, eight streams as well, Poisson arrivals at 0.7 requests/s (about 80% of sixteen streams' rate) with goodput under a 2 s time to first token and 100 ms per output token, decode stalls while a cold 131K prompt prefills at three depths of the sixteen slots (3 and 11 streams, with short probes sent 2-14 s into it, whose time to first token is what a new conversation waits; 15 streams, which fills every slot during the prefill), and real-text prefill from 32K to 1M. Its grid needs the dev-mode collective RPC.",
 "steps": [
  {
   "id": "model",
   "command": "model",
   "args": {
    "concurrency": 16,
    "max_tokens": 256,
    "top": 20
   }
  },
  {
   "id": "grid",
   "command": "engine",
   "args": {
    "replays": 100,
    "settle": 1
   }
  },
  {
   "id": "c16",
   "command": "run",
   "args": {
    "mode": "closed",
    "concurrency": 16,
    "warmup": 60,
    "duration": 300,
    "extra_body": {
     "chat_template_kwargs": {
      "thinking": false
     }
    }
   }
  },
  {
   "id": "c8",
   "command": "run",
   "args": {
    "mode": "closed",
    "concurrency": 8,
    "warmup": 60,
    "duration": 300,
    "extra_body": {
     "chat_template_kwargs": {
      "thinking": false
     }
    }
   }
  },
  {
   "id": "poisson",
   "command": "run",
   "args": {
    "mode": "poisson",
    "rate": 0.7,
    "warmup": 60,
    "duration": 300,
    "slo_ttft": 2,
    "slo_tpot": 100,
    "extra_body": {
     "chat_template_kwargs": {
      "thinking": false
     }
    }
   }
  },
  {
   "id": "stall-3",
   "command": "stall",
   "args": {
    "sizes": [
     131072
    ],
    "streams": 3,
    "max_tokens": 16384,
    "warmup": 20,
    "tail": 2,
    "repeats": 3,
    "probes": [
     2,
     5,
     8,
     11,
     14
    ],
    "probe_tokens": 500,
    "probe_max_tokens": 16
   }
  },
  {
   "id": "stall-11",
   "command": "stall",
   "args": {
    "sizes": [
     131072
    ],
    "streams": 11,
    "max_tokens": 16384,
    "warmup": 20,
    "tail": 2,
    "repeats": 3,
    "probes": [
     2,
     5,
     8,
     11,
     14
    ],
    "probe_tokens": 500,
    "probe_max_tokens": 16
   }
  },
  {
   "id": "stall-15",
   "command": "stall",
   "args": {
    "sizes": [
     131072
    ],
    "streams": 15,
    "max_tokens": 16384,
    "warmup": 20,
    "tail": 2,
    "repeats": 3
   }
  },
  {
   "id": "prefill",
   "command": "prefill",
   "args": {
    "sizes": [
     32768,
     131072,
     262144,
     524288,
     1000000
    ],
    "repeats": 3
   }
  }
 ]
}
