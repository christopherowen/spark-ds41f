{
 "name": "release-tp3",
 "version": 3,
 "description": "Release measurement for three nodes (8 streams, 1M context), about 70 minutes a build: model behaviour on all 256 prompts at eight streams, the engine grid up to eight requests, eight and four streams in a closed loop, Poisson arrivals at 0.42 requests/s (about 80% of eight streams' rate on r6h) with goodput under a 2 s time to first token and 100 ms per output token, decode stalls while a cold 131K prompt prefills at three depths of the eight slots (3 and 6 streams, with short probes sent 2-14 s into it; 7 streams, which fills every slot during the prefill), and real-text prefill from 32K to 1M. Its grid needs the dev-mode collective RPC.",
 "steps": [
  {
   "id": "model",
   "command": "model",
   "args": {
    "concurrency": 8,
    "max_tokens": 256,
    "top": 20
   }
  },
  {
   "id": "grid",
   "command": "engine",
   "args": {
    "replays": 100,
    "settle": 1,
    "max_requests": 8
   }
  },
  {
   "id": "c8",
   "command": "run",
   "args": {
    "mode": "closed",
    "concurrency": 8,
    "warmup": 60,
    "duration": 300,
    "extra_body": {
     "chat_template_kwargs": {
      "thinking": false
     }
    }
   }
  },
  {
   "id": "c4",
   "command": "run",
   "args": {
    "mode": "closed",
    "concurrency": 4,
    "warmup": 60,
    "duration": 300,
    "extra_body": {
     "chat_template_kwargs": {
      "thinking": false
     }
    }
   }
  },
  {
   "id": "poisson",
   "command": "run",
   "args": {
    "mode": "poisson",
    "rate": 0.42,
    "warmup": 60,
    "duration": 300,
    "slo_ttft": 2,
    "slo_tpot": 100,
    "extra_body": {
     "chat_template_kwargs": {
      "thinking": false
     }
    }
   }
  },
  {
   "id": "stall-3",
   "command": "stall",
   "args": {
    "sizes": [
     131072
    ],
    "streams": 3,
    "max_tokens": 16384,
    "warmup": 20,
    "tail": 2,
    "repeats": 3,
    "probes": [
     2,
     5,
     8,
     11,
     14
    ],
    "probe_tokens": 500,
    "probe_max_tokens": 16
   }
  },
  {
   "id": "stall-6",
   "command": "stall",
   "args": {
    "sizes": [
     131072
    ],
    "streams": 6,
    "max_tokens": 16384,
    "warmup": 20,
    "tail": 2,
    "repeats": 3,
    "probes": [
     2,
     5,
     8,
     11,
     14
    ],
    "probe_tokens": 500,
    "probe_max_tokens": 16
   }
  },
  {
   "id": "stall-7",
   "command": "stall",
   "args": {
    "sizes": [
     131072
    ],
    "streams": 7,
    "max_tokens": 16384,
    "warmup": 20,
    "tail": 2,
    "repeats": 3
   }
  },
  {
   "id": "prefill",
   "command": "prefill",
   "args": {
    "sizes": [
     32768,
     131072,
     262144,
     524288,
     1000000
    ],
    "repeats": 3
   }
  }
 ]
}
