From 1ac6f84356d65f37eb1872db688858599944cbdd Mon Sep 17 00:00:00 2001
From: Christopher Owen <christopherowen@users.noreply.github.com>
Date: Thu, 1 Oct 2026 09:48:48 +0200
Subject: [PATCH] feat(b12x): capacity-regime block-scaled linears in
 batch-invariant mode

Block-scaled linears (the DeepSeek V4.1 LM head among them) plan an exact
regime per graph size beside the capacity regime; the small ones split K
four ways and the others do not, so a row rounds differently with the
step's row count. With VLLM_DS41_BATCH_INVARIANT=1 only the capacity
regime is declared and every count runs it.
---
 vllm/model_executor/kernels/linear/b12x_blockscaled.py | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/vllm/model_executor/kernels/linear/b12x_blockscaled.py b/vllm/model_executor/kernels/linear/b12x_blockscaled.py
index f5e387dc8..d7b253879 100644
--- a/vllm/model_executor/kernels/linear/b12x_blockscaled.py
+++ b/vllm/model_executor/kernels/linear/b12x_blockscaled.py
@@ -13,6 +13,7 @@ workspace is locked.
 
 from __future__ import annotations
 
+import os
 import weakref
 
 import torch
@@ -27,6 +28,8 @@ from vllm.utils.b12x import (
 )
 
 COMPONENT = "gemm.blockscaled_precision"
+# Opt-in batch-invariant mode (DeepSeek V4.1): only the capacity regime.
+_BATCH_INVARIANT = os.environ.get("VLLM_DS41_BATCH_INVARIANT") == "1"
 logger = init_logger(__name__)
 
 
@@ -148,7 +151,12 @@ class B12xBlockscaledLinear:
             workspace_nbytes=envs.VLLM_B12X_BLOCKSCALED_WORKSPACE_MAX_BYTES,
             expected_m=None,
         )
-        self.plan = api.plan_regimes(query, exact_m=workload.fixed_token_counts)
+        # The exact-M regimes for the graph sizes split K differently from the
+        # capacity regime (the LM head: four slices up to 8 rows, one above),
+        # so a row would round differently with the step's row count. In
+        # batch-invariant mode every count runs the capacity regime.
+        exact_m = () if _BATCH_INVARIANT else workload.fixed_token_counts
+        self.plan = api.plan_regimes(query, exact_m=exact_m)
         self._plan_key = key
         return self.plan
 
