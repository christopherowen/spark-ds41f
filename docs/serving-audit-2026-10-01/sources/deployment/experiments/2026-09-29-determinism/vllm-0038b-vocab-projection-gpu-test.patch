From c06b027be607967fba048003a27d7d5016c04dc3 Mon Sep 17 00:00:00 2001
From: Christopher Owen <christopherowen@users.noreply.github.com>
Date: Thu, 1 Oct 2026 14:21:12 +0200
Subject: [PATCH] test(logits): GPU regression for the batch-invariant
 vocabulary projection

Runs the b12x BF16 vocabulary projection on DeepSeek V4.1's 43136x5120 rank-0
shape and checks that a row's logits are bit-identical alone and as the first
or last of 2-48 logit rows in batch-invariant mode. Skipped without a CUDA
device or the b12x projection.
---
 .../test_batch_invariant_vocab_projection.py  | 38 +++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/tests/v1/sample/test_batch_invariant_vocab_projection.py b/tests/v1/sample/test_batch_invariant_vocab_projection.py
index c13466c37..439f15394 100644
--- a/tests/v1/sample/test_batch_invariant_vocab_projection.py
+++ b/tests/v1/sample/test_batch_invariant_vocab_projection.py
@@ -61,3 +61,41 @@ def test_one_logit_row_projects_like_many(default_vllm_config, monkeypatch, inva
     assert alone.shape == (1, vocab)
     assert seen == ([2, 3] if invariant else [1, 3])
     assert torch.equal(alone[0], together[0]) == invariant
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="needs a CUDA device")
+def test_b12x_vocab_projection_rows_match_at_every_count(default_vllm_config, monkeypatch):
+    """The served projection on the GPU: a row's logits are bit-identical at 1-48 logit rows."""
+    from b12x.preparation import PreparationSession
+
+    from vllm.utils.b12x import B12xWorkload, get_b12x_bf16_vocab_projection
+
+    projection = get_b12x_bf16_vocab_projection()
+    if projection is None or not projection.is_supported():
+        pytest.skip("b12x BF16 vocabulary projection is unavailable")
+    monkeypatch.setattr(module, "_BATCH_INVARIANT", True)
+    torch.manual_seed(0)
+    vocab, hidden, most = 43136, 5120, 48  # DeepSeek V4.1's rank-0 shard at TP 3
+    device = torch.device("cuda")
+    processor = LogitsProcessor(vocab)
+    processor._gather_logits = lambda logits: logits
+    processor._b12x_vocab_projection = projection
+    processor.use_b12x_vocab_projection = True
+    processor.head_dtype = None
+    head = _Head(torch.randn(vocab, hidden, dtype=torch.bfloat16, device=device) * 0.02)
+    processor._b12x_vocab_heads[id(head)] = head
+    counts = (1, 2, 3, 4, 6, 8, 12, 16, 20, 24, 28, 32, 40, 48)
+    workload = B12xWorkload(stage="weights", token_counts=(*counts, 64), fixed_token_counts=counts,
+                            output_dtype=torch.bfloat16, max_tokens=64, max_seqs=8,
+                            max_model_len=64)
+    units = processor.get_b12x_preparation_units(processor, workload)
+    with PreparationSession(device=device, autotune=False, compile_workers=1) as session:
+        session.prepare(tuple(r for unit in units for r in unit.requests))
+        rows = torch.randn(most, hidden, dtype=torch.bfloat16, device=device)
+        target = rows[:1]
+        alone = processor._get_logits(target, head, None)[0]
+        for m in range(2, most + 1):
+            first = processor._get_logits(torch.cat([target, rows[1:m]]), head, None)[0]
+            last = processor._get_logits(torch.cat([rows[1:m], target]), head, None)[-1]
+            assert torch.equal(first, alone), f"first of {m} rows differs from the row alone"
+            assert torch.equal(last, alone), f"last of {m} rows differs from the row alone"
