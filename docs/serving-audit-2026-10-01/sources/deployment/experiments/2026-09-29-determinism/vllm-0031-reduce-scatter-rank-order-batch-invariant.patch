index 000000000..410283b54
--- /dev/null
+++ b/tests/distributed/test_reduce_scatter_rank_order.py
@@ -0,0 +1,81 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Host test of the batch-invariant reduce-scatter (three simulated ranks)."""
+
+import torch
+
+from vllm.distributed.device_communicators.cuda_communicator import CudaCommunicator
+
+
+class _Exchange:
+    """Stands in for one rank\x27s NCCL communicator: recv reads the peer\x27s chunk."""
+
+    def __init__(self, inputs, rank):
+        self.inputs, self.rank = inputs, rank
+
+    def group_start(self):
+        pass
+
+    def group_end(self):
+        pass
+
+    def send(self, tensor, peer):
+        pass
+
+    def recv(self, tensor, peer):
+        world = len(self.inputs)
+        tensor.copy_(self.inputs[peer].view(world, -1, *tensor.shape[1:])[self.rank])
+
+
+def _reduce_scatter(inputs, rank):
+    comm = object.__new__(CudaCommunicator)
+    comm.world_size, comm.rank_in_group = len(inputs), rank
+    comm.pynccl_comm = _Exchange(inputs, rank)
+    return comm._reduce_scatter_rank_order(inputs[rank])
+
+
+def _rank_order_sum(values):
+    """The RoCE one-shot all-reduce's arithmetic: float32, rank order, one rounding."""
+    total = values[0].float()
+    for value in values[1:]:
+        total += value.float()
+    return total.to(values[0].dtype)
+
+
+def test_rows_add_as_the_one_shot_all_reduce():
+    torch.manual_seed(0)
+    world, local, width = 3, 5, 64
+    inputs = [torch.randn(world * local, width).to(torch.bfloat16) for _ in range(world)]
+    for rank in range(world):
+        rows = slice(rank * local, (rank + 1) * local)
+        expected = _rank_order_sum([x[rows] for x in inputs])
+        assert torch.equal(_reduce_scatter(inputs, rank), expected)
+
+
+def test_row_bits_do_not_depend_on_owner_or_padding():
+    # One row\x27s partials placed at every position of batches of two sizes: the
+    # reduced row is bitwise the same wherever it lands and whichever rank owns it.
+    torch.manual_seed(1)
+    world, width = 3, 256
+    row = [torch.randn(width).to(torch.bfloat16) * 10 ** k for k in range(world)]
+    results = set()
+    for local in (4, 7):
+        for position in range(world * local):
+            inputs = [torch.randn(world * local, width).to(torch.bfloat16) for _ in range(world)]
+            for x, part in zip(inputs, row):
+                x[position] = part
+            owner, offset = divmod(position, local)
+            out = _reduce_scatter(inputs, owner)[offset]
+            results.add(out.view(torch.int16).numpy().tobytes())
+    assert len(results) == 1
+
+
+def test_one_rounding_differs_from_rounding_each_add():
+    # The float32 accumulation is observable: rounding after every BF16 add
+    # gives other bits for some rows, so the test above would catch it.
+    torch.manual_seed(2)
+    values = [torch.randn(4096).to(torch.bfloat16) * 10 ** k for k in range(3)]
+    each = values[0].clone()
+    for value in values[1:]:
+        each.add_(value)
+    assert not torch.equal(each, _rank_order_sum(values))
