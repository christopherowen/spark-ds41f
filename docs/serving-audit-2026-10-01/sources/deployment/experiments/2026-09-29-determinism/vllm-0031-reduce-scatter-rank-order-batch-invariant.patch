 .../device_communicators/cuda_communicator.py | 38 ++++++++-
 2 files changed, 118 insertions(+), 1 deletion(-)
 create mode 100644 tests/distributed/test_reduce_scatter_rank_order.py

diff --git a/tests/distributed/test_reduce_scatter_rank_order.py b/tests/distributed/test_reduce_scatter_rank_order.py
