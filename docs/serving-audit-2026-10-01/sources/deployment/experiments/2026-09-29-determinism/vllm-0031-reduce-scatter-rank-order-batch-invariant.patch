@@ -588,6 +596,34 @@ class CudaCommunicator(DeviceCommunicatorBase):
         # Reshape before returning
         return output.movedim(0, dim).contiguous()
 
+    def _reduce_scatter_rank_order(self, input_tensor: torch.Tensor) -> torch.Tensor:
+        """Reduce-scatter with the RoCE one-shot all-reduce's arithmetic.
+
+        NCCL's reduce-scatter adds the ranks' partials of a chunk in an order
+        that depends on the receiving rank and on the message size (ring
+        rotation, channel split), so a row's bits change with the row count of
+        the batch and the row's position in it. This exchanges the chunks (an
+        all-to-all over the same communicator, the same bytes) and adds them as
+        the one-shot all-reduce of smaller messages does: in float32, in rank
+        order, rounded once. A row then has the same bits whether its step was
+        reduce-scattered or all-reduced.
+        """
+        pynccl_comm = self.pynccl_comm
+        rank = self.rank_in_group
+        chunks = input_tensor.view(self.world_size, -1, *input_tensor.shape[1:])
+        parts = torch.empty_like(chunks)
+        pynccl_comm.group_start()
+        for peer in range(self.world_size):
+            if peer != rank:
+                pynccl_comm.send(chunks[peer], peer)
+                pynccl_comm.recv(parts[peer], peer)
+        pynccl_comm.group_end()
+        parts[rank].copy_(chunks[rank])
+        total = parts[0].float()
+        for part in parts[1:]:
+            total += part.float()
+        return total.to(input_tensor.dtype)
+
     def reduce_scatterv(
         self, input_: torch.Tensor, dim: int = -1, sizes: list[int] | None = None
     ):
