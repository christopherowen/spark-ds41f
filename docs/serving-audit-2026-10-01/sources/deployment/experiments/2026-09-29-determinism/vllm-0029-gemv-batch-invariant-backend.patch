 from __future__ import annotations
 
+import os
 from bisect import bisect_left
 from functools import cache
 from weakref import WeakValueDictionary
@@ -215,6 +216,29 @@ class B12xEmbeddingMethod(UnquantizedEmbeddingMethod):
         return out
 
 
+# Experimental: plan projections whose default backend picks its kernel by row
+# count (cuBLAS through the torch backend) on the SIMT GEMV instead, so a row
+# rounds the same whatever it is batched with. Off unless set.
+_BATCH_INVARIANT = os.environ.get("VLLM_DS41_BATCH_INVARIANT") == "1"
+
+
+def _gemv_override(query):
+    """The SIMT backend for a torch-backend capacity in batch-invariant mode.
+
+    Below 256 rows the FP32-output projections already run SIMT by default;
+    larger capacities keep their default (the prefill kernel where eligible).
+    """
+    from b12x.gemm.bf16_gemv._tuning import GemvConfig, default_config
+
+    if (
+        _BATCH_INVARIANT
+        and query.max_rows < 256
+        and default_config(query, None).backend == "torch"
+    ):
+        return GemvConfig(backend="simt")
+    return None
+
+
 def _smallest_capacity(capacities: tuple[int, ...], rows: int) -> int:
     """The smallest prepared row capacity that holds ``rows``.
 
@@ -284,7 +308,7 @@ class B12xLinearMethod(UnquantizedLinearMethod):
                         weight_contiguous=weight.is_contiguous(),
