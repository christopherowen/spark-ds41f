{
 "schema": "servebench-suite/1",
 "suite": {
  "name": "release",
  "version": 2,
  "description": "Release measurement, about 51 minutes a build: the screen with all 256 prompts, eight streams as well, Poisson arrivals at 0.7 requests/s (about 80% of sixteen streams' rate) with goodput under a 2 s time to first token and 100 ms per output token, and real-text prefill from 32K to 1M. Its grid needs the dev-mode collective RPC.",
  "steps": [
   {
    "id": "model",
    "command": "model",
    "args": {
     "concurrency": 16,
     "max_tokens": 256,
     "top": 20
    }
   },
   {
    "id": "grid",
    "command": "engine",
    "args": {
     "replays": 100,
     "settle": 1
    }
   },
   {
    "id": "c16",
    "command": "run",
    "args": {
     "mode": "closed",
     "concurrency": 16,
     "warmup": 60,
     "duration": 300,
     "extra_body": {
      "chat_template_kwargs": {
       "thinking": false
      }
     }
    }
   },
   {
    "id": "c8",
    "command": "run",
    "args": {
     "mode": "closed",
     "concurrency": 8,
     "warmup": 60,
     "duration": 300,
     "extra_body": {
      "chat_template_kwargs": {
       "thinking": false
      }
     }
    }
   },
   {
    "id": "poisson",
    "command": "run",
    "args": {
     "mode": "poisson",
     "rate": 0.7,
     "warmup": 60,
     "duration": 300,
     "slo_ttft": 2,
     "slo_tpot": 100,
     "extra_body": {
      "chat_template_kwargs": {
       "thinking": false
      }
     }
    }
   },
   {
    "id": "prefill",
    "command": "prefill",
    "args": {
     "sizes": [
      32768,
      131072,
      262144,
      524288,
      1000000
     ],
     "repeats": 3
    }
   }
  ]
 },
