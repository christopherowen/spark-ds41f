    "id": "model",
    "command": "model",
    "args": {
     "limit": 64,
     "concurrency": 16,
     "max_tokens": 256,
     "top": 20
    }
   },
   {
    "id": "grid",
    "command": "engine",
    "args": {
     "replays": 100,
     "settle": 1,
     "max_requests": 16
    }
   },
   {
    "id": "c16",
    "command": "run",
    "args": {
     "mode": "closed",
     "concurrency": 16,
     "warmup": 30,
     "duration": 180,
     "extra_body": {
      "chat_template_kwargs": {
       "thinking": false
      }
     }
    }
   },
   {
    "id": "c1",
