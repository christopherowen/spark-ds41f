   },
   {
    "id": "PR #1254 (TysAIs) + PR #1319 (msuiche)",
    "summary": "GLP-27 dose recalibration to alpha=2.0 (VLLM_DS41_GLP_ALPHA), canonical boot identity, deepseek-v4.1-flash-weightless per-model 0.3/0.95 safe sampling defaults, tool_gate"
   },
   {
    "id": "0866",
